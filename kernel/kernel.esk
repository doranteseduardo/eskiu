// kernel.esk: a bare-metal Eskiu kernel
//
// Entry point: kernel_main (called from boot.s once the stack is set up)
// Target: QEMU -M virt, ARM64, no libc

import <mem>;

import "uart.esk";
import "cpu.esk";
import "alloc.esk";
import "trap.esk";

// Bounds of .bss, defined by linker.ld.
extern uint8 __bss_start;
extern uint8 __bss_end;

// What the kernel reports on the console.
enum Event {
    Booted(int64),            // exception level
    Timer(int64),             // counter frequency in Hz
    Allocated(int64, int64),  // bytes, address
    OutOfMemory(int64),       // bytes requested
    Uptime(int64),            // microseconds since kernel_main started
    Halt,
}

void report(Event e) {
    match e {
        Booted(el)          -> { uart_puts("Running at: EL"); uart_putdec(el); }
        Timer(hz)           -> { uart_puts("Timer:      "); uart_putdec(hz); uart_puts(" Hz"); }
        Allocated(n, addr)  -> { uart_puts("alloc("); uart_putdec(n); uart_puts("): "); uart_puthex(addr); }
        OutOfMemory(n)      -> { uart_puts("alloc("); uart_putdec(n); uart_puts("): out of memory"); }
        Uptime(us)          -> { uart_puts("Uptime:     "); uart_putdec(us); uart_puts(" us"); }
        Halt                -> uart_puts("Powering off.");
    }
    uart_puts("\r\n");
}

// Globals without an initializer live in .bss. QEMU happens to load the kernel into
// zeroed RAM, but nothing promises that on real hardware, so clear it before any
// global is read.
void zero_bss() {
    *uint8 p = &__bss_start;
    while (p < &__bss_end) {
        *p = 0;
        p++;
    }
}

void alloc_test(int64 n) {
    *uint8 buf = alloc<uint8>(n);
    if (buf == null) {
        report(OutOfMemory(n));
        return;
    }
    defer free(buf);
    for (i in 0..n) {
        buf[i] = (uint8)i;
    }
    report(Allocated(n, (int64)buf));
}

void banner() {
    uart_puts("\r\n");
    uart_puts("  ___     _    _\r\n");
    uart_puts(" | __|___| | _(_)_  _\r\n");
    uart_puts(" | _|(_-< || / / || |\r\n");
    uart_puts(" |___/__/_|\\_/_/ \\_,_|\r\n");
    uart_puts("\r\n");
    uart_puts("Eskiu bare-metal kernel\r\n");
    uart_puts("Running on QEMU -M virt (ARM64)\r\n");
    uart_puts("boot.s set up the stack; the rest is Eskiu.\r\n");
    uart_puts("\r\n");
}

void kernel_main() {
    zero_bss();
    heap_init();
    trap_init();
    const int64 start = cpu_timer_count();

    // However kernel_main ends, the machine is switched off afterwards.
    defer {
        report(Halt);
        cpu_power_off();
    }

    banner();
    report(Booted(cpu_current_el()));
    report(Timer(cpu_timer_freq()));
    uart_puts("Testing a breakpoint (brk #42):\r\n");
    asm("brk #42");
    uart_puts("Back from the breakpoint.\r\n\r\n");

    uart_puts("UART base:  ");
    uart_puthex(UART0_BASE);
    uart_puts("\r\n");
    uart_puts("Heap:       ");
    uart_puthex((int64)&__heap_start);
    uart_puts(" - ");
    uart_puthex((int64)&__heap_end);
    uart_puts("\r\n\r\n");

    alloc_test(64);
    alloc_test(4096);
    alloc_test(4 * 1024 * 1024);
    uart_puts("Heap used:  ");
    uart_putdec(heap_used());
    uart_puts(" bytes\r\n\r\n");

    const int64 ticks = cpu_timer_count() - start;
    report(Uptime(ticks * 1000000 / cpu_timer_freq()));
}
