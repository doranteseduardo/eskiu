// uart.esk: PL011 UART driver for QEMU -M virt (arm64)
//
// The registers are memory-mapped at 0x09000000. Every access goes through a
// `volatile` pointer, so the compiler emits each load and store exactly once and in
// program order, which is what a device register needs.
//
//   UARTDR  base + 0x00  data register: writing transmits a byte, reading receives one
//   UARTFR  base + 0x18  flag register: TXFF (bit 5) is set while the TX FIFO is full,
//                        RXFE (bit 4) while there is nothing to read

const int64 UART0_BASE = 0x09000000;
const int64 UART_DR    = UART0_BASE + 0x00;
const int64 UART_FR    = UART0_BASE + 0x18;

// UARTFR as a bitfield struct, lowest bit first.
struct UartFlags {
    uint32 cts  : 1;
    uint32 dsr  : 1;
    uint32 dcd  : 1;
    uint32 busy : 1;
    uint32 rxfe : 1;
    uint32 txff : 1;
    uint32 rxff : 1;
    uint32 txfe : 1;
    uint32 ri   : 1;
    uint32      : 23;
}

void uart_putc(int c) {
    volatile let fr: *UartFlags = (*UartFlags)UART_FR;
    volatile let dr: *uint32 = (*uint32)UART_DR;
    while (fr.txff) {}        // wait for room in the TX FIFO
    *dr = (uint32)c;
}

bool uart_has_input() {
    volatile let fr: *UartFlags = (*UartFlags)UART_FR;
    return !fr.rxfe;
}

// Waits for a byte. The core sleeps between interrupts rather than spinning.
int uart_getc() {
    volatile let dr: *uint32 = (*uint32)UART_DR;
    while (!uart_has_input()) {
        cpu_wait();
    }
    return (int)(*dr & 0xFF);
}

void uart_puts(string s) {
    int i = 0;
    while (s[i] != 0) {
        uart_putc((int)s[i]);
        i++;
    }
}

void uart_puthex(int64 n) {
    uart_puthex_digits(n, 16);
}

// At least `digits` hex digits, more if n needs them.
void uart_puthex_digits(int64 n, int digits) {
    uart_puts("0x");
    while (digits < 16 && (n >> (digits * 4)) != 0) {
        digits++;
    }
    int shift = (digits - 1) * 4;
    while (shift >= 0) {
        int nibble = (int)((n >> shift) & 0xF);
        uart_putc(nibble < 10 ? nibble + '0' : nibble - 10 + 'A');
        shift -= 4;
    }
}

void uart_putdec(int64 n) {
    char[20] digits;
    int len = 0;
    do {
        digits[len] = (char)('0' + (int)(n % 10));
        n /= 10;
        len++;
    } while (n > 0);
    while (len > 0) {
        len--;
        uart_putc((int)digits[len]);
    }
}
