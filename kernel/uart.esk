// uart.esk — PL011 UART driver for QEMU -M virt (arm64)
//
// UART base address on QEMU virt: 0x09000000
// Data register (UARTDR):  base + 0x00  — write a byte to transmit
// Flag register (UARTFR):  base + 0x18  — bit 5 (TXFF): TX FIFO full
//
// We write directly to UARTDR without polling — QEMU's TX FIFO never
// fills for simple output.

int64 UART_DR = 0x09000000;

void uart_putc(int c) {
    asm("strb ${0:w}, [$1]" :: "r"(c), "r"(UART_DR) : "memory");
}

void uart_puts(string s) {
    int i = 0;
    while (s[i] != 0) {
        uart_putc((int) s[i]);
        i = i + 1;
    }
}

void uart_puthex(int64 n) {
    uart_puts("0x");
    int shift = 60;
    while (shift >= 0) {
        int nibble = (int)((n >> shift) & 0xF);
        if (nibble < 10) {
            uart_putc(nibble + 48);
        } else {
            uart_putc(nibble - 10 + 65);
        }
        shift = shift - 4;
    }
}
