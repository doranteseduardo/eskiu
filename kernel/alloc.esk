// alloc.esk — Bump allocator for --freestanding mode
//
// Satisfies the esk_alloc/esk_free symbols that <mem>'s alloc<T>/free target
// under --freestanding (selected via __ESKIU_FREESTANDING__).
//
// Layout (see linker.ld):
//   heap: 0x40300000 – 0x40400000  (1 MB)

import <alloc>;   // reuse the stdlib's alignment helper

// These live in .data (initialized), not .bss — boot.s does not zero .bss, so a
// global Bump struct can't be used directly here; we keep the bump state in
// plain initialized globals and borrow alloc_align8 from <alloc>.
int64 _heap_ptr = 0x40300000;
int64 _heap_end = 0x40400000;

*uint8 esk_alloc(int64 size) {
    int64 n = alloc_align8(size);   // 8-byte align each allocation
    if (_heap_ptr + n > _heap_end) {
        return null;
    }
    int64 ptr = _heap_ptr;
    _heap_ptr = _heap_ptr + n;
    // <mem>'s alloc<T> contract: return zeroed memory (fresh RAM here is not
    // guaranteed zero). A byte loop, not memset, since this is a -nostdlib target.
    *uint8 p = (*uint8) ptr;
    int64 i = 0;
    while (i < n) { p[i] = 0; i = i + 1; }
    return p;
}

void esk_free(*uint8 ptr) {
    // Bump allocator — free is a no-op.
    // A real kernel would use a slab or buddy allocator here.
}
