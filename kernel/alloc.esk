// alloc.esk: the kernel heap
//
// <mem>'s alloc<T>/free call esk_alloc/esk_free under --freestanding. They are built
// on `Bump` from <alloc>, which hands out 8-byte aligned pieces of the region
// [__heap_start, __heap_end) that linker.ld reserves.

import <alloc>;

extern uint8 __heap_start;
extern uint8 __heap_end;

Bump heap;   // in .bss: zeroed by kernel_main before heap_init runs

void heap_init() {
    Bump_init(&heap, &__heap_start, &__heap_end - &__heap_start);
}

int64 heap_used() {
    return heap.off;
}

int64 heap_size() {
    return heap.cap;
}

// <mem>'s contract is zeroed memory. A byte loop rather than memset, since no C
// library is linked.
*void esk_alloc(int64 size) {
    *uint8 p = (*uint8)Bump_alloc(&heap, size);
    if (p == null) {
        return null;
    }
    for (i in 0..size) {
        p[i] = 0;
    }
    return (*void)p;
}

// A bump allocator releases everything at once (Bump_reset), so one free is a no-op.
void esk_free(*void p) {}
