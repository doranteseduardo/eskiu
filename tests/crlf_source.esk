// CRLF line endings: a trailing backslash still continues a line, directives and
// __LINE__ see the right line numbers.
extern int printf(string fmt, ...);
#define ADD(a, b) \
    ((a) + \
     (b))
#ifdef ADD
#define N 5
#endif
int main() {
    int x = ADD(2, N);
    printf("%d\n", x);
    printf("%d\n", __LINE__);
    return 0;
}
