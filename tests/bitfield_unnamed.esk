// Unnamed bitfields: `T : N;` reserves N bits laid out like a named bitfield of type T,
// and `T : 0;` moves the next bitfield to a new unit of T. They are not members, so a
// positional literal skips them and their bits stay zero. Only the sizes every target's
// C layout agrees on are printed (tests/bitfield_unnamed_c.esk checks the rest against C).
extern int printf(string fmt, ...);

struct Flags { uint8 lo : 3; uint8 : 2; uint8 hi : 3; }
struct Split { uint8 a : 3; uint32 : 0; uint8 b : 2; }
struct Reg { uint32 en : 1; uint32 : 7; uint32 mode : 4; uint32 : 0; uint16 id; }
struct Edge { char c; uint32 : 0; char d; }
struct Tail { uint16 v; uint8 : 4; }
struct Box<T> { T val; uint16 : 3; uint16 tag : 5; }
union Wide { uint8 b; uint32 : 20; }
struct Outer { char k; Flags f; Split s; }

// The bits of `p` (n bytes) as a hex string, low byte first.
void dump(string name, *uint8 p, int n) {
    printf("%s:", name);
    int i = 0;
    while (i < n) { printf(" %02x", (int)p[i]); i = i + 1; }
    printf("\n");
}

int main() {
    let f: Flags = Flags{5, 6};              // positional: lo, hi (the unnamed bits are skipped)
    printf("Flags %d %d size %d\n", (int)f.lo, (int)f.hi, (int)sizeof(Flags));
    dump("Flags", (*uint8)&f, (int)sizeof(Flags));
    f.lo = 7; f.hi = 1;
    dump("Flags", (*uint8)&f, (int)sizeof(Flags));

    let s: Split = Split{b: 3, a: 6};
    printf("Split %d %d\n", (int)s.a, (int)s.b);
    let s0: Split = Split{};
    s0.b = 1;
    printf("Split zero %d\n", (int)s0.a);

    let r: Reg = Reg{1, 9, 4660};
    printf("Reg %d %d %d size %d\n", (int)r.en, (int)r.mode, (int)r.id, (int)sizeof(Reg));
    dump("Reg", (*uint8)&r, (int)sizeof(Reg));

    let e: Edge = Edge{'x', 'y'};
    printf("Edge %c %c\n", e.c, e.d);
    let t: Tail = Tail{65535};
    printf("Tail %d size %d\n", (int)t.v, (int)sizeof(Tail));

    let b: Box<int> = Box<int>{42, 17};
    printf("Box %d %d size %d\n", b.val, (int)b.tag, (int)sizeof(Box<int>));

    let w: Wide;
    w.b = (uint8)200;
    printf("Wide %d\n", (int)w.b);

    let o: Outer = Outer{'o', Flags{1, 2}, Split{3, 1}};
    printf("Outer %c %d %d %d %d\n", o.k, (int)o.f.lo, (int)o.f.hi, (int)o.s.a, (int)o.s.b);

    // sizeof folds in a constant array dimension with the same layout.
    int8[sizeof(Split)] buf;
    int8[sizeof(Edge) + sizeof(Wide)] buf2;
    int8[sizeof(Outer)] buf3;
    printf("dims %d %d %d\n", (int)(sizeof(buf) == sizeof(Split)), (int)(sizeof(buf2) == sizeof(Edge) + sizeof(Wide)),
           (int)(sizeof(buf3) == sizeof(Outer)));
    return 0;
}
