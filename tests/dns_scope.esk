// dns_resolve keeps the zone of a scoped IPv6 address (fe80::1%<loopback>): the
// result resolves to the same address again. It used to drop the "%zone".
import <dns>;
import <io>;

int main() {
#ifdef __APPLE__
    string host = "fe80::1%lo0";
#else
    string host = "fe80::1%lo";
#endif
    let out: List<string>;  List_init<string>(&out, 4);
    const int n = dns_resolve(host, &out);
    printf("n=%d same=%d\n", n, n == 1 && strcmp(List_get<string>(&out, 0), host) == 0 ? 1 : 0);
    let again: List<string>;  List_init<string>(&again, 4);
    printf("resolves again=%d\n", n == 1 && dns_resolve(List_get<string>(&out, 0), &again) == 1 ? 1 : 0);
    dns_free_list(&again);
    dns_free_list(&out);
    return 0;
}
