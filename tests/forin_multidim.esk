// for-in over a multidimensional array binds each row (an `int[3]` for `int[2][3]`).
extern int printf(string fmt, ...);

int main() {
    int[2][3] m = {{1, 2, 3}, {4, 5, 6}};
    int total = 0;
    for (row in m) {
        for (v in row) { total = total + v; }
        printf("%d %d %d\n", row[0], row[1], row[2]);
    }
    printf("%d\n", total);
    return 0;
}
