// dbg(e): prints `[dbg L:C] <source of e> = <value>` to stderr and yields e's value.
extern int printf(string fmt, ...);
struct P { int x; double y; string s; }
struct Q { P p; int[3] a; bool ok; char c; }
struct Box<T> { T v; int n; }
enum Color { Red, Green = 5 }
union U { int i; float f; }
type Meters = uint32;
int twice(int v) { return v * 2; }
int main() {
    int n = 20;
    int m = dbg(n + 1) * 2;
    P p = P{1, 2.5, "hi"};
    dbg(p);
    Q q = Q{p: p, a: {1, 2, 3}, ok: true, c: 'z'};
    dbg(q);
    *int ptr = null;
    dbg(ptr == null);
    float f = dbg((float)1.5);
    Color c = Green;
    dbg(c);
    Box<int> b = Box<int>{v: 7, n: 2};
    dbg(b);
    int[4] arr = {1, 2, 3, 4};
    int[] sl = arr[1..3];
    dbg(sl);
    Meters mt = 300;
    dbg(mt);
    uint64 big = 18446744073709551615;
    dbg(big);
    int8 neg = -3;
    dbg(neg);
    U u; u.i = 1;
    dbg(u);
    string z = null;
    dbg(z);
    dbg("100%");
    int[20] w;
    dbg(w);
    printf("%d %.1f %d\n", m, (double)f, twice(dbg(n)));
    return 0;
}
