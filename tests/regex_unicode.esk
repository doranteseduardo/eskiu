// <regex> over UTF-8, as Go's regexp: `.` and classes match whole code points
// (offsets stay byte offsets), \p{...} / \P{...} Unicode classes, (?i) by simple
// case folding (k, K and U+212A KELVIN SIGN are one orbit), the (?m) (?s) (?U)
// flags set for the rest of a group or scoped with (?flags:...), non-capturing
// and named groups, and literal text \Q...\E. Each result was checked against Go.
import <regex>;
import <string>;
extern int printf(string fmt, ...);

void show(string p, string s) {
    Regex re = regex_compile(p);
    if (re.ok == 0) { printf("%s: error %s\n", p, re.err); Regex_free(&re); return; }
    let m: Match;
    printf("%s:", p);
    if (Regex_search(&re, s, &m) == 1) {
        for (g in 0..m.ngroup + 1) { printf(" %d,%d", m.cap[2 * g], m.cap[2 * g + 1]); }
        printf("\n");
    } else { printf(" no\n"); }
    Match_free(&m);
    Regex_free(&re);
}

int main() {
    // code points, not bytes
    show("^.$", "é");
    show("^..$", "é");
    show("a.c", "a中c");
    show("[é-ë]+", "xéêë!");
    show("[^a]", "中");
    show(".", "\377");
    show("\\x{FFFD}", "a\377b");
    show("\\x{1F600}", "hi 😀");
    show("\\xE9", "é");
    // Unicode classes
    show("\\pL+", "12αβγ!");
    show("\\p{Lu}\\p{Ll}+", "hello World");
    show("\\PL+", "abc123def");
    show("\\p{^L}", "ab3");
    show("[\\p{Greek}\\d]+", "xα1β2y");
    show("\\p{Han}+", "abc中文def");
    show("\\pN+", "x٣4");
    show("\\p{Zs}", "a b");
    show("\\p{Foo}", "x");
    // (?i)
    show("(?i)hello", "HeLLo");
    show("(?i)k", "K");
    show("(?i)[a-z]+", "ABC");
    show("(?i)ſ", "S");
    show("(?i)σ+", "Σσς");
    show("(?i)\\W", "K");
    show("(?i)[^k]", "K");
    show("(?i)\\p{Lu}", "a");
    show("a(?i)b|c", "C");
    show("(a(?i)b)c", "aBC");
    show("(?i:A)a", "Aa");
    show("(?i)A(?-i)a", "aa");
    // (?m) (?s) (?U)
    show("^b$", "a\nb\nc");
    show("(?m)^b$", "a\nb\nc");
    show("a.b", "a\nb");
    show("(?s)a.b", "a\nb");
    show("(?U)a+", "aaa");
    show("(?U)a+?", "aaa");
    // groups
    show("(?:ab)+", "ababx");
    show("(?:a)(b)", "ab");
    show("(?P<first>\\w+) (?<last>\\w+)", "ada lovelace");
    show("(?P<>x)", "x");
    show("(?z)", "x");
    show("(?i-)", "x");
    // \Q...\E
    show("\\Qa.b*\\E", "xa.b*");
    show("\\Qa.b\\E+", "a.bbb");
    show("\\Q(x)", "(x)");
    show("a\\Q\\E*", "aaa");
    return 0;
}
