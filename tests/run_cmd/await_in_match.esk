// An await inside a `match` arm is an error located at that await (tests/run.sh,
// tests/selfhost/cg_parity.sh): line 8, column 29.
import <future>;
enum E { A(int), B }
Future<T>* rdy<T>(T v) { Future<T>* f = future_new<T>(); future_complete<T>(f, v); return f; }
async int w(E e) {
    int r = 0;
    match e { A(n) -> { r = await rdy<int>(n); } B -> { r = -1; } }
    return r;
}
int main() { Future<int>* f = w(A(4)); return f.value; }
