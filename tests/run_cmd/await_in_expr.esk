// An await the async lowering can't place (inside a larger expression) is a located
// error at that await (tests/run.sh, tests/selfhost/cg_parity.sh): line 7, column 10.
import <future>;
Future<T>* rdy<T>(T v) { Future<T>* f = future_new<T>(); future_complete<T>(f, v); return f; }
async int worker() {
    int r = 1;
    r += await rdy<int>(1);
    return r;
}
int main() { Future<int>* f = worker(); return f.value; }
