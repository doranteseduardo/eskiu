// Used by tests/run.sh to check `eskiuc run`: prints its arguments; "crash" as the
// first one dereferences null (the exit code must then be 128 + SIGSEGV).
extern int printf(string fmt, ...);
int main(int argc, string* argv) {
    int i = 1;
    while (i < argc) { printf("[%s]\n", argv[i]); i = i + 1; }
    if (argc > 1 && argv[1][0] == 99) { *int p = null; return *p; }
    return 3;
}
