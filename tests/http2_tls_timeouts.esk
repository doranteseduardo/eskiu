// Both h2-over-TLS servers apply the h2c server's deadlines (HttpLimits,
// shortened to 60-100 ms): the blocking http2_tls_serve_conn_with through
// a non-blocking socket and poll, the async http2_tls_conn_async_with through timers.
// A connection that sends nothing is closed after header_ms, and one idle after
// a request gets GOAWAY(NO_ERROR) after idle_ms. OpenSSL is replaced by the C
// companion (http2_tls_timeouts.c), whose "SSL" is the plain socket.
import <mem>;
import <future>;
import <eventloop>;
import <net>;
import <channel>;
import <hpack>;
import <http2>;
import <http>;
import <http2_server>;
import <tls>;
import <string>;
import <time>;
extern int printf(string fmt, ...);
extern int socketpair(int domain, int type, int protocol, *int sv);

EventLoop* g_lp;
HttpLimits g_lim;
*uint8 g_buf;
int g_len = 0;

void hello(HttpRequest* req, HttpResponse* res) { HttpResponse_set_body(res, "hi"); }

void frame(int type, int flags, int sid, *uint8 p, int n) {
    for (i in 0..n) { g_buf[g_len + 9 + i] = p[i]; }
    g_len += h2_frame_finish(g_buf + g_len, type, flags, sid, n);
}

void request() {
    g_len = 0;
    string p = h2_preface();
    for (i in 0..24) { g_buf[g_len++] = (uint8)p[i]; }
    frame(H2_SETTINGS, 0, 0, null, 0);
    uint8[64] blk;
    int off = hpack_encode_header(&blk[0], 0, (*uint8)":method", 7, (*uint8)"GET", 3);
    off = hpack_encode_header(&blk[0], off, (*uint8)":path", 5, (*uint8)"/", 1);
    off = hpack_encode_header(&blk[0], off, (*uint8)":scheme", 7, (*uint8)"https", 5);
    frame(H2_HEADERS, H2_FLAG_END_HEADERS | H2_FLAG_END_STREAM, 1, &blk[0], off);
}

// Serve the queued client bytes with the blocking (async_mode 0) or async TLS
// server, the client side kept open, and summarize what it sent before closing.
void run(string label, int async_mode, int64 lo) {
    *int sv = alloc<int>(2);
    socketpair(1, 1, 0, sv);
    net_send(sv[1], (*void)g_buf, (int64)g_len);
    *void ctx = tls_server_ctx("cert", "key");
    const int64 t0 = time_monotonic_ms();
    if (async_mode == 0) {
        http2_tls_serve_conn_with(tls_accept_with(ctx, sv[0], &g_lim), hello, g_lim);
        net_close(sv[0]);
    } else {
        Chan<int>* done = chan_new<int>(1);
        Future<uint8>* f = http2_tls_conn_async_with(g_lp, sv[0], ctx, hello, done, g_lim, null);
        if (future_poll<uint8>(f, void() { EventLoop_stop(g_lp); }) == 0) { EventLoop_run(g_lp); }
        free_future<uint8>(f);
        Chan_free<int>(done);
    }
    const int64 dt = time_monotonic_ms() - t0;
    SSL_CTX_free(ctx);

    *uint8 rb = alloc<uint8>(65536);
    int total = 0;
    int64 k = net_recv(sv[1], (*void)rb, (int64)65536);
    while (k > 0) { total += (int)k; k = net_recv(sv[1], (*void)(rb + total), (int64)(65536 - total)); }
    printf("%s:", label);
    int pos = 0;
    while (pos + 9 <= total) {
        let fr: H2Frame;  h2_read_header(rb + pos, &fr);
        *uint8 pl = rb + pos + 9;
        if (fr.type == H2_SETTINGS) { printf((fr.flags & 1) != 0 ? " ACK" : " SETTINGS"); }
        else if (fr.type == H2_HEADERS) { printf(" HEADERS"); }
        else if (fr.type == H2_DATA) { printf(" DATA[%.*s]", fr.length, (string)pl); }
        else if (fr.type == H2_GOAWAY) { printf(" GOAWAY(last=%lld,%lld)", h2_get_u32(pl, 0), h2_get_u32(pl, 4)); }
        else { printf(" type%d", fr.type); }
        pos += 9 + fr.length;
    }
    printf(" (timely=%d)\n", dt >= lo && dt < lo + 2000 ? 1 : 0);
    free((*void)rb);
    net_close(sv[1]);
    free((*void)sv);
}

int main() {
    g_lp = el_new(64);
    g_buf = alloc<uint8>(4096);
    g_lim.init();
    g_lim.header_ms = 60;
    g_lim.idle_ms = 100;
    for (mode in 0..2) {
        printf("== %s\n", mode == 0 ? "blocking" : "async");
        g_len = 0;
        run("silent", mode, 55);
        request();
        run("idle after a request", mode, 95);
    }
    free((*void)g_buf);
    EventLoop_free(g_lp);
    return 0;
}
