// allman_if
int x = 6;
if (x > 5)
{
  x = 1;
}
x
// gnu_if
int x = 6;
if (x > 5)
  {
    x = 2;
  }
x
// else_next
int x = 6;
if (x > 9) {
  x = 1;
}
else {
  x = 3;
}
x
// elseif_chain
int x = 6;
if (x > 9) { x = 1; }
else if (x > 7) { x = 2; }
else if (x > 5) { x = 3; }
else { x = 4; }
x
// if_unbraced
int x = 6;
if (x > 5)
  x = 8;
x
// else_unbraced
int x = 6;
if (x > 9)
  x = 1;
else
  x = 9;
x
// while_allman
int x = 0;
while (x < 3)
{
  x = x + 1;
}
x
// while_unbraced
int x = 0;
while (x < 3)
  x = x + 1;
x
// do_while
int x = 0;
do {
  x = x + 1;
} while (x < 3);
x
