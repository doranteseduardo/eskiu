// nested_if_else
int x = 4;
if (x > 1)
{
  if (x > 3)
  {
    x = 30;
  }
  else
  {
    x = 20;
  }
}
else
{
  x = 10;
}
x
// if_then_command
int x = 1;
if (x == 1) { x = 2; }
:type x
x
// if_then_blank
int x = 1;
if (x == 1) { x = 3; }

x
// ternary_split
int x = 5;
int y = x > 3
  ? 10
  : 20;
y
// typo_reported
int x = 1;
x +* 2;
x
// a trailing ?: and a loop label on its own line
int tz = 5 > 3 ?
  10 :
  20;
tz
int ls = 0;
outer:
for (i in 0..3) {
  for (j in 0..3) {
    if (j == 1) { continue outer; }
    ls = ls + 1;
  }
}
ls
