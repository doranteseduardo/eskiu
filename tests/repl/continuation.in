for (int i = 0; i < 4; i++)
{
  s = s + i;
}
s
// for_header_split
int s = 0;
for (int i = 0;
     i < 5;
     i++) {
  s = s + i;
}
s
// switch
int x = 2;
int y = 0;
switch (x) {
  case 1: y = 10; break;
  case 2:
    y = 20;
    break;
  default: y = 0;
}
y
// switch_allman
int x = 3;
int r = 0;
switch (x)
{
  case 3:
    r = 30;
    break;
  default:
    r = 1;
}
r
// match_allman
enum E { A, B }
E e = B;
int r = 0;
match e
{
  A -> { r = 1; }
  B -> { r = 2; }
}
r
