nothing() == null
// struct_allman
struct P
{
  int a;
  int b;
}
P{a: 1, b: 2}
// struct_methods_allman
struct C
{
  int n;
  int twice()
  {
    return self.n * 2;
  }
}
C c = C{n: 4};
c.twice()
// interface_allman
interface Shape
{
  int area();
}
struct Sq { int w; }
int Sq_area(Sq* self) { return self.w * self.w; }
Sq q = Sq{w: 3};
q.area()
