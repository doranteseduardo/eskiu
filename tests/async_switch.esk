// switch containing an await. The subject is dispatched in one state; each case
// is its own entry state with C-style fall-through to the next; `break` exits to
// the join state. Case 1 falls through into case 2. Case 2 holds a *suspending*
// await over the reactor (parks and resumes), proving switch states interleave
// with the park/resume protocol. Deterministic (pipe pre-filled then closed).
import <future>;
import <net_async>;
import <eventloop>;
extern int  printf(string fmt, ...);
extern int  pipe(*int fds);
extern int64 write(int fd, *void buf, int64 n);
extern int  close(int fd);
uint8[64] b;
EventLoop* g;

async int handle(EventLoop* lp, int mode, int fd) {
    int r = 0;
    switch (mode) {
        case 0: { r = 1000; break; }                 // no await; immediate
        case 1: { r = r + 7; }                        // falls through into case 2
        case 2: {
            int n = await net_read_async(lp, fd, &b[0], (int64)64);  // suspends
            r = r + n;                                 // +len("hello")=5
            break;
        }
        default: { r = -1; }
    }
    return r;
}

int drive(int mode, int withData) {
    int[2] fds; pipe(&fds[0]);
    if (withData == 1) { write(fds[1], (*void)"hello", (int64)5); }
    close(fds[1]);                                     // EOF if nothing written
    g = el_new(64);
    Future<int>* f = handle(g, mode, fds[0]);
    if (future_poll<int>(f, void() { el_stop(g); }) == 0) { el_run(g); }
    int v = f.value;
    free_future<int>(f);
    el_free(g);
    return v;
}

int main() {
    printf("%d\n", drive(0, 0));   // case 0: 1000 (no read)
    printf("%d\n", drive(1, 1));   // case 1 r=7 -> fall into case 2: +5 = 12
    printf("%d\n", drive(2, 1));   // case 2: read 5 -> 5
    printf("%d\n", drive(9, 0));   // default: -1
    return 0;
}
