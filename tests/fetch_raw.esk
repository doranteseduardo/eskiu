// <fetch> response framing against a raw local server that writes canned
// responses: chunked bodies (extensions, trailers), a body read until close, a
// Content-Length longer or shorter than what arrives, framed responses that
// complete while the server keeps the connection open, interim 1xx responses,
// malformed responses, the body size cap, and timeouts (a server that never
// answers, one that never accepts).
import <fetch>;
import <net>;
import <string>;
import <time>;
import <mem>;
extern int printf(string fmt, ...);
extern int64 strlen(string s);

const int PORT = 18432;
const int HANG_PORT = 18433;

void send_all(int fd, string s, int64 n) {
    int64 off = 0;
    while (off < n) {
        const int64 w = net_send(fd, (*void)((*uint8)s + off), n - off);
        if (w <= 0) { return; }
        off += w;
    }
}

void say(int fd, string s) { send_all(fd, s, strlen(s)); }

// Answer one connection according to the request path.
void serve_one(int c) {
    char[4096] buf;
    int64 n = 0;
    while (n < 4095) {
        const int64 got = net_recv(c, (*void)&buf[n], 4095 - n);
        if (got <= 0) { break; }
        n += got;
        buf[n] = 0;
        let s: String;  String_from(&s, (string)&buf[0]);
        const int64 e = String_find(&s, "\r\n\r\n", 0);
        s.free();
        if (e >= 0) { break; }
    }
    buf[n] = 0;
    let req: String;  String_from(&req, (string)&buf[0]);
    let path: String;  path.init(16);
    int64 i = String_find(&req, " ", 0) + 1;
    while (i > 0 && i < req.len && req.data[i] != ' ') { path.push(req.data[i]); i++; }
    if (path.eq_cstr("/chunked") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n7;ext=1\r\n, world\r\n0\r\nX-Trailer: 1\r\n\r\n");
        sleep_ms(1500);
    } else if (path.eq_cstr("/close") == 1) {
        say(c, "HTTP/1.0 200 OK\r\nX-Kind: close\r\n\r\nbody until ");
        sleep_ms(50);
        say(c, "close");
    } else if (path.eq_cstr("/short") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nonly ten b");
    } else if (path.eq_cstr("/long") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n12345EXTRA BYTES");
        sleep_ms(1500);
    } else if (path.eq_cstr("/204") == 1) {
        say(c, "HTTP/1.1 204 No Content\r\nContent-Length: 7\r\n\r\n");
        sleep_ms(1500);
    } else if (path.eq_cstr("/interim") == 1) {
        say(c, "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 103 Early Hints\r\nLink: </a>\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok");
    } else if (path.eq_cstr("/garbage") == 1) {
        say(c, "NOT HTTP AT ALL\r\n\r\n");
    } else if (path.eq_cstr("/badcl") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nContent-Length: 12abc\r\n\r\nhello");
    } else if (path.eq_cstr("/twocl") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Length: 3\r\n\r\nabc");
    } else if (path.eq_cstr("/barelf") == 1) {
        say(c, "HTTP/1.1 200 OK\nContent-Length: 2\r\n\r\nok");
    } else if (path.eq_cstr("/badchunk") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\nhello\r\n0\r\n\r\n");
    } else if (path.eq_cstr("/cutchunk") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel");
    } else if (path.eq_cstr("/upgrade") == 1) {
        say(c, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: x\r\n\r\n");
    } else if (path.eq_cstr("/empty") == 1) {
        // close without a byte
    } else if (path.eq_cstr("/big") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nContent-Length: 2000\r\n\r\n");
    } else if (path.eq_cstr("/bigclose") == 1) {
        say(c, "HTTP/1.1 200 OK\r\n\r\n");
        for (k in 0..50) { say(c, "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"); }
    } else if (path.eq_cstr("/bigchunk") == 1) {
        say(c, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n");
        for (k in 0..30) { say(c, "64\r\n0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789\r\n"); }
        say(c, "0\r\n\r\n");
    } else if (path.eq_cstr("/badloc") == 1) {
        say(c, "HTTP/1.1 302 Found\r\nLocation: http://[oops/\r\nContent-Length: 0\r\n\r\n");
    } else if (path.eq_cstr("/hang") == 1) {
        sleep_ms(1500);
    } else {
        say(c, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n");
    }
    path.free();
    req.free();
    net_close(c);
}

void serve(int lfd) {
    while (true) {
        const int c = net_accept(lfd);
        if (c < 0) { continue; }
        thread_create(void() { serve_one(c); });
    }
}

void get(string path) {
    let url: String;  String_from(&url, "http://127.0.0.1:18432");
    url.append(path);
    let o: FetchOptions;  FetchOptions_init(&o);
    o.timeout_ms = 1000;
    o.max_body = 1000;
    let r: Response;
    const int64 t0 = time_monotonic_ms();
    const int rc = fetch_with(url.cstr(), &o, &r);
    const int64 took = time_monotonic_ms() - t0;
    if (rc == 0) {
        let k: String;  k.init(8);
        Response_header(&r, "x-kind", &k);
        printf("%s: %d len=%lld body=[%s] kind=[%s] fast=%d\n", path, r.status, r.body.len, Response_text(&r),
               k.cstr(), took < 900 ? 1 : 0);
        k.free();
    } else {
        printf("%s: rc=%d (%s)\n", path, rc, fetch_last_error());
    }
    Response_free(&r);
    FetchOptions_free(&o);
    url.free();
}

int main() {
    const int lfd = net_tcp_listen((uint16)PORT);
    const int hang = net_tcp_listen((uint16)HANG_PORT);   // never accepted
    if (lfd < 0 || hang < 0) { printf("listen failed\n"); return 1; }
    thread_create(void() { serve(lfd); });
    get("/chunked");
    get("/close");
    get("/short");
    get("/long");
    get("/204");
    get("/interim");
    get("/garbage");
    get("/badcl");
    get("/twocl");
    get("/barelf");
    get("/badchunk");
    get("/cutchunk");
    get("/upgrade");
    get("/empty");
    get("/big");
    get("/bigclose");
    get("/bigchunk");
    get("/badloc");
    get("/hang");
    get("/nope");

    let o: FetchOptions;  FetchOptions_init(&o);
    o.timeout_ms = 300;
    let r: Response;
    const int64 t0 = time_monotonic_ms();
    const int rc = fetch_with("http://127.0.0.1:18433/", &o, &r);
    const int64 took = time_monotonic_ms() - t0;
    printf("never accepted: rc=%d (%s) in-time=%d\n", rc, fetch_last_error(), took >= 250 && took < 1500 ? 1 : 0);
    Response_free(&r);
    FetchOptions_free(&o);
    return 0;
}
