// <math> — libm wrappers. Verifies each function against known values. Needs -lm
// at link (the runner adds it; on macOS libm is part of libSystem).
import <math>;
extern int printf(string fmt, ...);

int main() {
    printf("%.0f %.0f %.0f %.0f %.0f %.0f %d\n",
           sqrt(144.0),          // 12
           fabs(-7.5) + 0.5,     // 8
           pow(2.0, 10.0),       // 1024
           floor(3.9),           // 3
           ceil(3.1),            // 4
           fmod(17.0, 5.0),      // 2
           abs(-42));            // 42
    return 0;
}
