// `for (i in A..B)` — half-open integer ranges [A, B). Desugars to a counted
// for, so it nests, takes variable bounds, and an empty range runs zero times.
extern int printf(string fmt, ...);

int main() {
    int s = 0;
    for (i in 0..5) { s = s + i; }                 // 0+1+2+3+4 = 10

    int c = 0;
    int lo = 2;  int hi = 6;
    for (j in lo..hi) { c = c + 1; }               // 2,3,4,5 -> 4 iterations

    int e = 0;
    for (k in 5..5) { e = e + 1; }                 // empty range -> 0

    int grid = 0;
    for (a in 0..3) { for (b in 0..3) { grid = grid + 1; } }   // 3*3 = 9

    printf("%d %d %d %d\n", s, c, e, grid);        // 10 4 0 9
    return 0;
}
