// A braced defer body run on an early exit opens its own cleanup frame; that must not
// invalidate the frame being unwound (the C++ back end crashed). Found by the C
// oracle in tests/fuzz/eskiu_fuzz.py.
extern int printf(string fmt, ...);

int f(int a) {
    int v = 1;
    defer v = v ^ 1;
    defer { a = a ^ 2; printf("a=%d\n", a); }
    return v;
}

int deep(int n) {
    defer { printf("d0\n"); }
    {
        defer { printf("d1\n"); }
        {
            defer { printf("d2\n"); }
            {
                defer { printf("d3\n"); }
                {
                    defer { printf("d4\n"); }
                    if (n > 0) { return n; }
                }
            }
        }
    }
    return 0;
}

int main() {
    printf("%d\n", f(3));
    printf("%d\n", deep(7));
    return 0;
}
