// The h2c server's deadlines (HttpLimits, shortened to 60-100 ms), one
// connection per case over a socketpair whose client side stays open: before,
// each of these connections was held until the peer went away.
//  - nothing sent, or the preface without SETTINGS: closed after header_ms (the
//    server's own SETTINGS is all it sent), no GOAWAY;
//  - a served request, then silence: GOAWAY(NO_ERROR, last stream 1) after
//    idle_ms; PINGs every 20 ms do not extend it;
//  - a header block left without its CONTINUATION: closed after header_ms;
//  - a response the peer never grants window for: closed after write_ms.
import <mem>;
import <future>;
import <eventloop>;
import <net>;
import <channel>;
import <hpack>;
import <http2>;
import <http>;
import <http2_server>;
import <string>;
import <time>;
import <atomic>;
extern int printf(string fmt, ...);
extern int usleep(uint32 usec);
extern int socketpair(int domain, int type, int protocol, *int sv);

EventLoop* g_lp;
HttpLimits g_lim;
*uint8 g_buf;
int g_len = 0;
int g_pinger_fd = -1;
int g_stop = 0;

void hello(HttpRequest* req, HttpResponse* res) { HttpResponse_set_body(res, "hi"); }

void frame(int type, int flags, int sid, *uint8 p, int n) {
    for (i in 0..n) { g_buf[g_len + 9 + i] = p[i]; }
    g_len += h2_frame_finish(g_buf + g_len, type, flags, sid, n);
}

void preface() {
    string p = h2_preface();
    for (i in 0..24) { g_buf[g_len++] = (uint8)p[i]; }
}

void begin() {
    g_len = 0;
    preface();
    frame(H2_SETTINGS, 0, 0, null, 0);
}

int req_block(*uint8 blk) {
    int off = hpack_encode_header(blk, 0, (*uint8)":method", 7, (*uint8)"GET", 3);
    off = hpack_encode_header(blk, off, (*uint8)":path", 5, (*uint8)"/", 1);
    off = hpack_encode_header(blk, off, (*uint8)":scheme", 7, (*uint8)"http", 4);
    return off;
}

void get(int sid, int flags) {
    uint8[64] blk;
    frame(H2_HEADERS, flags, sid, &blk[0], req_block(&blk[0]));
}

void pinger() {
    uint8[17] p;
    while (atomic_load(&g_stop) == 0) {
        usleep(20000);
        h2_frame_finish(&p[0], H2_PING, 0, 0, 8);
        net_send(g_pinger_fd, (*void)&p[0], (int64)17);
    }
}

// Serve the queued client bytes, keeping the client side open, and summarize
// what the server sent before it closed the connection.
void run(string label, int64 lo, bool ping) {
    *int sv = alloc<int>(2);
    socketpair(1, 1, 0, sv);
    net_send(sv[1], (*void)g_buf, (int64)g_len);
    let t: *void = null;
    if (ping) { g_pinger_fd = sv[1];  atomic_store(&g_stop, 0);  t = thread_create(pinger); }
    const int64 t0 = time_monotonic_ms();
    Chan<int>* done = chan_new<int>(1);
    Future<uint8>* f = http2_serve_conn_async_with(g_lp, sv[0], hello, done, g_lim, null);
    if (future_poll<uint8>(f, void() { EventLoop_stop(g_lp); }) == 0) { EventLoop_run(g_lp); }
    const int64 dt = time_monotonic_ms() - t0;
    free_future<uint8>(f);
    Chan_free<int>(done);
    if (ping) { atomic_store(&g_stop, 1);  thread_join(t); }

    *uint8 rb = alloc<uint8>(65536);
    int total = 0;
    int64 k = net_recv(sv[1], (*void)rb, (int64)65536);
    while (k > 0) { total += (int)k; k = net_recv(sv[1], (*void)(rb + total), (int64)(65536 - total)); }
    printf("%s:", label);
    int pos = 0;
    while (pos + 9 <= total) {
        let fr: H2Frame;  h2_read_header(rb + pos, &fr);
        *uint8 pl = rb + pos + 9;
        if (fr.type == H2_SETTINGS) { printf((fr.flags & 1) != 0 ? " ACK" : " SETTINGS"); }
        else if (fr.type == H2_HEADERS) { printf(" HEADERS"); }
        else if (fr.type == H2_DATA) { printf(" DATA[%.*s]", fr.length, (string)pl); }
        else if (fr.type == H2_GOAWAY) { printf(" GOAWAY(last=%lld,%lld)", h2_get_u32(pl, 0), h2_get_u32(pl, 4)); }
        else if (fr.type == H2_PING) { }                   // PING answers: their number varies
        else { printf(" type%d", fr.type); }
        pos += 9 + fr.length;
    }
    printf(" (timely=%d)\n", dt >= lo && dt < lo + 2000 ? 1 : 0);
    free((*void)rb);
    net_close(sv[1]);
    free((*void)sv);
}

int main() {
    g_lp = el_new(64);
    g_buf = alloc<uint8>(4096);
    g_lim.init();
    g_lim.header_ms = 60;
    g_lim.body_ms = 60;
    g_lim.idle_ms = 100;
    g_lim.write_ms = 60;

    g_len = 0;
    run("silent", 55, false);

    g_len = 0;  preface();
    run("preface only", 55, false);

    begin();  get(1, H2_FLAG_END_HEADERS | H2_FLAG_END_STREAM);
    run("idle after a request", 95, false);

    begin();
    run("pings while idle", 95, true);

    begin();  get(1, H2_FLAG_END_STREAM);                  // END_HEADERS missing
    run("unfinished header block", 55, false);

    begin();
    uint8[6] s;
    h2_put_setting(&s[0], 0, H2_SETTINGS_INITIAL_WINDOW_SIZE, 0);
    frame(H2_SETTINGS, 0, 0, &s[0], 6);
    get(1, H2_FLAG_END_HEADERS | H2_FLAG_END_STREAM);
    run("no window for the response", 55, false);

    free((*void)g_buf);
    EventLoop_free(g_lp);
    return 0;
}
