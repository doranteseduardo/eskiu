// fs_read_all on a stream that cannot seek (a pipe, like stdin) must read to
// end of file instead of trusting ftell (-1 there), growing past its first guess.
import <fs>;
import <mem>;
extern int printf(string fmt, ...);
extern int snprintf(*uint8 buf, int64 n, string fmt, ...);
extern int pipe(*int fds);
extern int64 write(int fd, *void buf, int64 n);
extern int close(int fd);

int main() {
    *int fds = alloc<int>(2);
    if (pipe(fds) != 0) { printf("pipe failed\n"); return 1; }
    int total = 10000;
    *uint8 data = alloc<uint8>(total);
    int i = 0;
    while (i < total) { data[i] = (uint8)(97 + i % 26); i = i + 1; }
    write(fds[1], (*void)data, (int64)total);
    close(fds[1]);

    *uint8 path = alloc<uint8>(32);
    snprintf(path, (int64)32, "/dev/fd/%d", fds[0]);
    let n: int64 = 0;
    *uint8 got = fs_read_all((string)path, &n);
    int same = 1;
    i = 0;
    while (got != null && i < total) { if (got[i] != data[i]) { same = 0; } i = i + 1; }
    printf("null=%d len=%lld same=%d end=%d\n", got == null, n, same, (int)got[n]);
    close(fds[0]);
    free((*void)got);
    free((*void)path);
    free((*void)data);
    free((*void)fds);
    return 0;
}
