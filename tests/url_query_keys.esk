// url_query_get decodes each query key ('+' as space, %XX) before comparing
// it, so an encoded key matches its decoded form, and a plain key still does.
import <url>;
import <string>;
extern int printf(string f, ...);

void q(string query, string key) {
    let out: String;  String_init(&out, 16);
    const int r = url_query_get(query, key, &out);
    printf("[%s] [%s] -> %d [%s]\n", query, key, r, r == 1 ? String_cstr(&out) : "");
    String_free(&out);
}

int main() {
    q("a%20b=1&c=2", "a b");
    q("a+b=hi+there", "a b");
    q("x=1&k%3Dv=2", "k=v");
    q("%61=A", "a");
    q("a%20b=1", "a%20b");
    q("plain=ok&other=no", "plain");
    q("flag&x=1", "flag");
    q("x=1", "y");
    return 0;
}
