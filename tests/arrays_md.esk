// Multidimensional array type lowering + nested initializer + per-dimension index.
int grid() {
    int[2][3] a = { {1, 2, 3}, {4, 5, 6} };
    return a[1][2];
}

int col() {
    int[3][2] b;
    b[0][0] = 7;
    b[2][1] = 9;
    return b[2][1] + b[0][0];
}

int main() {
    return grid() + col() - 22;   // 6 + 16 - 22 = 0 when correct
}
