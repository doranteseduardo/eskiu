// `await` in any expression position of an async function: a match arm, a switch
// subject, a for-in iterable and a range bound (each evaluated once, before the
// statement), a compound assignment (its target evaluated once, before the await), a
// larger expression (operands with side effects evaluated in source order around the
// await), a call argument, `&&`/`||` and `?:` (the await runs only when its operand
// does), and loop conditions and steps (re-evaluated on every pass).
import <future>;
import <list>;
extern int printf(string fmt, ...);

Future<T>* rdy<T>(T v) { Future<T>* f = future_new<T>(); future_complete<T>(f, v); return f; }
Future<int>* note(int v) { printf("await %d\n", v); return rdy<int>(v); }
int log(int v) { printf("log %d\n", v); return v; }
int idx_calls = 0;
int idx(int i) { idx_calls = idx_calls + 1; printf("idx %d\n", i); return i; }
List<int> g_list;
Future<List<int>>* mk_list(int n) {
    for (i in 0..n) { List_push<int>(&g_list, i * 10); }
    return rdy<List<int>>(g_list);
}
int add3(int a, int b, int c) { return a * 100 + b * 10 + c; }

enum Shape { Circle(int), Rect(int, int), Empty }

async int in_match(Shape s) {
    int r = 0;
    match s {
        Circle(rad) -> { int k = await note(rad); r = k * 3; }
        Rect(w, h) -> { r = await note(w) + h; }
        Empty -> { r = -1; }
    }
    return r;
}

async int positions() {
    int r = 0;
    switch (await note(2)) {
        case 1: r = 10; break;
        case 2: r = 20; break;
        default: r = 30;
    }
    printf("switch: %d\n", r);

    int sum = 0;
    for (x in await mk_list(3)) { sum = sum + x; }
    printf("for-in: %d\n", sum);

    int n = 0;
    for (i in 1..await note(4)) { n = n + i; }
    printf("range: %d\n", n);

    int[4] arr = {1, 2, 3, 4};
    arr[idx(2)] += await note(5);
    printf("compound: %d %d calls=%d\n", arr[2], arr[3], idx_calls);

    int t = log(1) + await note(2) * log(3);
    printf("expr: %d\n", t);

    int c = add3(log(4), await note(5), log(6));
    printf("call: %d\n", c);

    bool yes = log(0) == 1 && await note(7) == 7;
    bool no = log(1) == 1 || await note(8) == 8;
    bool both = log(1) == 1 && await note(9) == 9;
    printf("and/or: %d %d %d\n", yes, no, both);

    int q = n > 5 ? await note(11) : log(12);
    printf("ternary: %d\n", q);

    int w = 0;
    while (await note(w) < 2) { w = w + 1; }
    printf("while: %d\n", w);

    int d = 0;
    do { d = d + 1; } while (await note(d) < 2);
    printf("do: %d\n", d);

    int f = 0;
    for (int k = 0; k < await note(2); k = k + await note(1)) { f = f + 10; }
    printf("for: %d\n", f);

    r += await note(1);
    return r;
}

int main() {
    List_init<int>(&g_list, 4);
    Future<int>* a = in_match(Circle(4));
    printf("match circle: %d\n", a.value); free_future<int>(a);
    Future<int>* b = in_match(Rect(5, 2));
    printf("match rect: %d\n", b.value); free_future<int>(b);
    Future<int>* c = in_match(Empty);
    printf("match empty: %d\n", c.value); free_future<int>(c);
    Future<int>* p = positions();
    printf("positions: %d\n", p.value); free_future<int>(p);
    List_free<int>(&g_list);
    return 0;
}
