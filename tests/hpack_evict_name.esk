// RFC 7541 §4.4: a literal with incremental indexing may name a dynamic entry
// that its own insertion evicts. The name must be copied before the eviction
// frees it, and headers decoded earlier in the same block that point at an
// evicted entry must stay readable until the next block.
import <mem>;
import <hpack>;
extern int printf(string fmt, ...);

int main() {
    *HpackHeader out = alloc<HpackHeader>(8);
    *uint8 blk = alloc<uint8>(64);

    let d: HpackDecoder;  hpack_decoder_init(&d, (int64)64);
    int off = 0;
    blk[off] = (uint8)64; off = off + 1; blk[off] = (uint8)4; off = off + 1;
    int k = 0; while (k < 4) { blk[off] = (uint8)97; off = off + 1; k = k + 1; }
    blk[off] = (uint8)0; off = off + 1;
    off = hpack_encode_int(blk, off, 6, 64, (int64)62);
    blk[off] = (uint8)9; off = off + 1;
    k = 0; while (k < 9) { blk[off] = (uint8)98; off = off + 1; k = k + 1; }
    int c = hpack_decode(&d, blk, off, out, 8);
    printf("count=%d dyn=%d\n", c, d.dyn_count);
    printf("entry=%.*s:%.*s\n", d.dyn[0].nlen, (string)d.dyn[0].name, d.dyn[0].vlen, (string)d.dyn[0].value);
    printf("hdr0=%.*s hdr1=%.*s:%.*s\n", out[0].nlen, (string)out[0].name,
           out[1].nlen, (string)out[1].name, out[1].vlen, (string)out[1].value);

    off = 0;
    blk[off] = (uint8)190; off = off + 1;
    blk[off] = (uint8)64; off = off + 1; blk[off] = (uint8)2; off = off + 1;
    blk[off] = (uint8)120; off = off + 1; blk[off] = (uint8)120; off = off + 1;
    blk[off] = (uint8)20; off = off + 1;
    k = 0; while (k < 20) { blk[off] = (uint8)99; off = off + 1; k = k + 1; }
    c = hpack_decode(&d, blk, off, out, 8);
    printf("count=%d first=%.*s:%.*s\n", c, out[0].nlen, (string)out[0].name, out[0].vlen, (string)out[0].value);

    hpack_decoder_free(&d);
    free((*void)blk);
    free((*void)out);
    return 0;
}
