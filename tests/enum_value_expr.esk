// Enum member values may be integer constant expressions over literals, earlier
// members, `const` ints and `sizeof`, folded like any constant.
extern int printf(string fmt, ...);

const int BASE = 100;

struct Hdr { int32 kind; int64 len; *uint8 data; }

enum Flag { A = 1, B = A << 2, C, D = (B | C) * 2, E = -A - 1, F }
enum Lim { Lo = BASE, Hi = BASE * 2 + 1, Mid = (Lo + Hi) / 2 }
enum Size { HdrSize = sizeof(Hdr), PtrSize = sizeof(*int), Both = HdrSize + PtrSize, After }
enum Mix { M0 = 7, M1, M2 = M1 + 10, M3 = 40, M4 }

int main() {
    printf("%d %d %d %d %d %d\n", (int)A, (int)B, (int)C, (int)D, (int)E, (int)F);
    printf("%d %d %d\n", (int)Lo, (int)Hi, (int)Mid);
    printf("%d %d\n", (int)HdrSize == (int)sizeof(Hdr), (int)PtrSize == (int)sizeof(*int));
    printf("%d %d\n", (int)Both - (int)sizeof(Hdr) - (int)sizeof(*int), (int)After - (int)Both);
    printf("%d %d %d %d %d\n", (int)M0, (int)M1, (int)M2, (int)M3, (int)M4);
    int[C] arr;
    arr[C - 1] = 3;
    switch (9) {
        case C: printf("C\n"); break;
        case D: printf("D\n"); break;
        default: printf("other\n");
    }
    Flag f = D;
    match f {
        A -> printf("a\n");
        B -> printf("b\n");
        C -> printf("c\n");
        D -> printf("d %d\n", arr[C - 1]);
        _ -> printf("?\n");
    }
    return 0;
}
