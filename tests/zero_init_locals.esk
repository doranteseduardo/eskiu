// A local declared without a value starts at zero, like a global, a `static` and
// alloc<T>: every field of a struct (pointers and function values included), every
// element of an array, a union and a slice. (Reading a scalar local before assigning
// it stays a compile error.) Each declaration gets a fresh zero, so a loop iteration
// does not see the value the previous one left, in plain and in async functions.
import <io>;
import <future>;
import <timer>;
import <eventloop>;

struct Inner { int64 a; int64[3] xs; }
struct Opts { *void env; string cwd; int64 n; bool flag; Inner in_; fn(int)->int cb; }
union U { int64 i; double d; }

// Dirty the stack, so a missing zero would read leftovers.
void dirty() {
    int64[64] junk;
    for (i in 0..64) { junk[i] = (int64)0x4141414141414141; }
    if (junk[7] == 0) { printf("?\n"); }
}

int check_struct() {
    let o: Opts;
    return (o.env == null && o.cwd == null && o.n == 0 && !o.flag && o.in_.a == 0 &&
            o.in_.xs[2] == 0) ? 1 : 0;
}

int check_others() {
    int64[100] big;
    uint8[8000] huge;
    U u;
    int[] sl;
    return (big[99] == 0 && huge[7999] == 0 && u.i == 0 && sl.len == 0) ? 1 : 0;
}

T first<T>() {
    T[4] v;
    return v[3];
}

int in_loop() {
    int bad = 0;
    for (i in 0..4) {
        Inner x;
        int64[2] a;
        if (x.a != 0 || x.xs[1] != 0 || a[1] != 0) { bad = bad + 1; }
        x.a = 9; x.xs[1] = 9; a[1] = 9;
    }
    return bad;
}

int in_switch(int k) {
    switch (k) {
        case 1:
            Inner s;
            return (int)s.xs[0];
        default:
            return -1;
    }
    return -1;
}

EventLoop* g_lp;

async int in_async() {
    int bad = 0;
    for (i in 0..3) {
        let o: Opts;
        int64[2] a;
        if (o.env != null || o.n != 0 || a[0] != 0) { bad = bad + 1; }
        o.n = 7; a[0] = 9;
        await timer_after(g_lp, 1);
        if (o.n != 7 || a[0] != 9) { bad = bad + 10; }
    }
    return bad;
}

int main() {
    dirty();
    printf("struct: %d\n", check_struct());
    dirty();
    printf("others: %d\n", check_others());
    printf("generic: %lld %d\n", first<int64>(), (int)first<double>());
    printf("loop: %d\n", in_loop());
    printf("switch: %d\n", in_switch(1));
    fn()->int lam = int() { Inner z; return (int)(z.a + z.xs[0]); };
    printf("lambda: %d\n", lam());
    g_lp = el_new(8);
    Future<int>* f = in_async();
    if (Future_poll<int>(f, void() { EventLoop_stop(g_lp); }) == 0) { EventLoop_run(g_lp); }
    printf("async: %d\n", f.value);
    Future_free<int>(f);
    EventLoop_free(g_lp);
    return 0;
}
