// A `T[]` parameter infers `T` from a slice argument.
extern int printf(string fmt, ...);

T sum<T>(T[] s) {
    T acc = (T)0;
    for (int64 i = 0; i < s.len; i = i + 1) { acc = acc + s[i]; }
    return acc;
}

T first<T>(T[] s) { return s[0]; }

struct P { int x; int y; }

int64 count<T>(T[] s, T v) {
    int64 n = 0;
    for (int64 i = 0; i < s.len; i = i + 1) { if (s[i] == v) { n = n + 1; } }
    return n;
}

int main() {
    int[4] a = {1, 2, 3, 4};
    double[3] d = {0.5, 1.5, 2.0};
    P[2] ps = {P{x: 7, y: 8}, P{x: 9, y: 10}};
    int[] sa = a[0..4];
    printf("%d\n", sum(sa));
    printf("%d\n", sum(a[1..3]));
    printf("%.1f\n", sum(d[0..3]));
    P p = first(ps[1..2]);
    printf("%d %d\n", p.x, p.y);
    printf("%lld\n", count(a[0..4], 3));
    return 0;
}
