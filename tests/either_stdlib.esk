import <either>;
extern int printf(string fmt, ...);
int main() {
    Option<int> a = Some(7);
    Option<int> b = None<int>();
    printf("%d %d\n", Option_is_some<int>(&a), Option_is_some<int>(&b));   // 1 0
    printf("%d %d\n", Option_unwrap_or<int>(&a, -1), Option_unwrap_or<int>(&b, -1)); // 7 -1
    return 0;
}
