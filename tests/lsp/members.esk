import <string>;
import <list>;

struct Point {
    int x;
    int y;
    int sum() { return self.x + self.y; }
}

int Point_dist(const Point* self, int k) { return self.x * k; }

int add(int a, int b) { return a + b; }

int main() {
    let s: String; String_from(&s, "a-b");
    s.replace_all("-", "+");
    Point p = Point{x: 1, y: 2}; let l: List<int>; List_init<int>(&l, 4);
    int total = p.x + p.dist(2) + p.sum() + add(1, 2);
    l.push(total);
    String_free(&s);
    List_free<int>(&l);
    return total == 0 ? 1 : 0;
}
