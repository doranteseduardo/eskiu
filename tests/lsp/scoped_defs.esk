// Go-to-definition resolves by scope: each `n` use maps to the `n` visible there.
// DEF 17:12 15:9
// DEF 21:13 20:9
// DEF 22:12 20:9
// DEF 22:16 24:5
// DEF 22:39 12:5
// HOVER 17:12 int
// HOVER 21:13 int
// HOVER 22:12 int
// HOVER 22:39 int
extern int printf(string fmt, ...);
int total = 0;

int f() {
    int n = 1;
    int unrelated = 2;
    return n;
}
int main() {
    int n = 5;
    total = n;
    return n + unrelated_fn() + f() + total;
}
int unrelated_fn() { return 0; }
