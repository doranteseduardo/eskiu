// Leaf future: a hand-written coroutine awaits net_read_async over the reactor.
// Deterministic — data is pre-written to a pipe, so the read completes on the
// first loop dispatch (no threads, no timing). Validates the await/park/resume
// path the async transform will generate.
import <net_async>;
extern int  printf(string fmt, ...);
extern int  pipe(*int fds);
extern int64 write(int fd, *void buf, int64 n);

uint8[64] g_buf;
EventLoop* g_lp;
int g_result = -1;

int main() {
    int[2] fds; pipe(&fds[0]);
    write(fds[1], (*void)"hello", (int64)5);     // 5 bytes ready to read

    g_lp = el_new(64);
    Future<int>* f = net_read_async(g_lp, fds[0], &g_buf[0], (int64)64);

    // await f: park, resume when readable (resume runs on the loop thread)
    future_poll<int>(f, void() {
        g_result = f.value;
        free_future<int>(f);
        el_stop(g_lp);
    });
    el_run(g_lp);

    printf("read %d bytes, first=%c\n", g_result, (char)g_buf[0]);   // 5, 'h'
    el_free(g_lp);
    return 0;
}
