// EXPECT-ERROR: redefinition of 'y' in the same scope
// The switch body is one scope (C): two cases may not declare the same name.
int f(int x) {
    switch (x) {
        case 1:
            int y = 2;
            break;
        case 2:
            int y = 3;
            break;
    }
    return 0;
}
int main() { return f(1); }
