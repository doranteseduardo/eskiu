// `float` has no `cmp(float, ...)` free function, so it must NOT satisfy Ord.
extern int printf(string fmt, ...);
interface Ord { int cmp(Ord* o); }
int cmp(int a, int b) { if (a < b) { return -1; } return 1; }
T pick<T: Ord>(T a, T b) { if (a.cmp(b) < 0) { return a; } return b; }
int main() {
    pick<float>(1.0, 2.0);
    return 0;
}
// EXPECT-ERROR: does not satisfy constraint
