// EXPECT-ERROR: cannot access a member of a possibly-null pointer
// An overloaded `==` in the condition runs after the null test and may clear the global.
struct S { int v; }
?*S gp = null;
bool operator ==(S a, S b) { gp = null; return true; }
int main() {
    S s = S{v: 7};
    gp = &s;
    if (gp != null && s == s) { return gp.v; }
    return 0;
}
