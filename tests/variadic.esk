// User-defined variadic functions: a fixed param followed by `...`, read with
// va_list / va_start / va_arg<T> / va_end (C default promotions apply — float
// arguments arrive as double, so read them with va_arg<double>).
extern int printf(string fmt, ...);

int sumv(int n, ...) {
    va_list ap;
    va_start(ap);
    int total = 0;
    for (i in 0..n) { total = total + va_arg<int>(ap); }
    va_end(ap);
    return total;
}

double avg(int n, ...) {
    va_list ap;
    va_start(ap);
    double s = 0.0;
    for (i in 0..n) { s = s + va_arg<double>(ap); }
    va_end(ap);
    return s / (double)n;
}

int main() {
    printf("%d %d %d\n", sumv(3, 10, 20, 30), sumv(4, 1, 2, 3, 4), sumv(0));  // 60 10 0
    printf("%.1f\n", avg(4, 2.0, 4.0, 6.0, 8.0));                             // 5.0
    return 0;
}
