// `run` builds its program in the temp dir: argv[0] is that program, and it must
// sit under $TMPDIR (not a fixed /tmp). Prints "in-tmpdir" or the path it got.
extern string getenv(string name);
extern int printf(string fmt, ...);

int main(int argc, string* argv) {
    string dir = getenv("TMPDIR");
    if (dir == null) { printf("no TMPDIR\n"); return 1; }
    int i = 0;
    while (dir[i] != 0) {
        if (argv[0][i] != dir[i]) { printf("not in TMPDIR: %s\n", argv[0]); return 1; }
        i = i + 1;
    }
    printf("in-tmpdir\n");
    return 0;
}
