int simple() { defer free(p); return 0; }
int block() { defer { a(); b(); } return 1; }
int many() { defer x(); defer y(); defer z(); return 2; }
int inloop() { for (int i = 0; i < 3; i++) { defer d(i); work(i); } return 3; }
int intry() { try { defer c(); risky(); } finally { done(); } return 4; }
int errd() { errdefer rollback(); defer close(); return 5; }
