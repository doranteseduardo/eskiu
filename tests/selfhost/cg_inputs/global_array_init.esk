// Global array initializers must reach load time, including casts (regression: zeroed).
int[4] G = {2, 4, 6, 8};
int[3] P = {5};                 // partial -> {5,0,0}
int[2][2] M = {{1, 2}, {3, 4}};
float[2] FC = {(float)1.5, (float)2.5};   // cast + float hex constant form
uint8[2] UC = {(uint8)7, (uint8)9};
int main() {
    return G[0] + G[3] + P[0] + P[2] + M[0][1] + M[1][0]   // 2+8+5+0+2+3 = 20
         + (int)FC[0] + (int)FC[1] + (int)UC[0] + (int)UC[1];  // +1+2+7+9 = 39
}
