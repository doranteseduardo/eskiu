// Labeled break/continue across nested loops, with a defer that must run on the
// labeled break. Exit code encodes the visited path so cg_parity compares behavior.
extern int printf(string fmt, ...);

int main() {
    int n = 0;
    outer: for (int i = 0; i < 4; i = i + 1) {
        for (int j = 0; j < 4; j = j + 1) {
            defer { n = n + 1; }          // runs on every inner-iteration exit, break included
            if (j == 2) { continue outer; }
            if (i == 3) { break outer; }
            n = n + 10;
        }
    }
    return n;
}
