// Global constant folding across forms (regressions): 64-bit literals, struct globals,
// const/enum/sizeof, ~/!, hex. Exit code encodes the sum so cg_parity compares behavior.
struct Point { int x; int y; }
const int N = 5;
enum Color { RED, GREEN, BLUE }
Point p = Point{ x: 3, y: 7 };
int fc = N; int fe = GREEN; int inv = ~0; int hx = 0x0A;
int[2] ha = {0x10, 3};
int main() {
    return p.x + p.y + fc + fe + inv + hx + ha[0] + ha[1];  // 3+7+5+1+(-1)+10+16+3 = 44
}
