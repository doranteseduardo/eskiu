extern int printf(string fmt, ...);
int main() {
    int[2][3] a = { {1,2,3}, {4,5,6} };
    int[2][2] b = { {7,8} };            // second row zero-filled
    b[1][0] = 9;
    int s = 0;
    for (i in 0..2) { for (j in 0..3) { s = s + a[i][j]; } }
    printf("%d %d %d %d %d\n", a[0][0], a[1][2], b[0][1], b[1][0], s);
    return 0;
}
