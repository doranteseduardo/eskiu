extern int printf(*int8 fmt, ...);

let doble: fn(int)->int = int(int x) { return x * 2; };
let inc: fn(int)->int = int(int x) { return x + 1; };

int apply(fn(int)->int f, int v) { return f(v); }

int main() {
    printf("%d\n", doble(6));
    printf("%d\n", inc(41));
    printf("%d\n", apply(doble, 10));
    return 0;
}
