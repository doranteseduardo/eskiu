// Floating point: double arithmetic (fadd/fsub/fmul/fdiv), fneg, fcmp, int↔float casts
// (sitofp/fptosi), and mixed int/float promotion.
int main() {
    let a: double = 3.5;
    let b: double = 2.0;
    let sum: double = a + b;
    let prod: double = a * b;
    let neg: double = -a;
    let cmp: int = 0;
    if (sum > prod - 2.0) { cmp = 10; }
    let asint: int = (int)(sum * 2.0);
    let frommix: double = a + 1;
    return asint + cmp + (int)frommix + (int)neg;
}
