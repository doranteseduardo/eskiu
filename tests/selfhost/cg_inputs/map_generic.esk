// HashMap<K,V>: generic key via fn-pointer hash/eq. int keys (with grow) + struct keys.
import <mem>;
import <map>;
extern int printf(string fmt, ...);

struct Pt { int x; int y; }
uint64 pt_hash(*Pt p) { return (uint64)(p.x * 31 + p.y); }
int    pt_eq(*Pt a, *Pt b) { if (a.x == b.x && a.y == b.y) { return 1; } return 0; }

int main() {
    // int keys, 10 distinct over 50 inserts → forces grows
    let m: HashMap<int, int>;  HashMap_init<int, int>(&m, 8, int_hash, int_eq);
    int i = 0;
    while (i < 50) {
        int k = i % 10;  int c = 0;
        *int s = HashMap_at<int, int>(&m, k, &c);
        if (c == 1) { s[0] = 0; }
        s[0] = s[0] + 1;
        i = i + 1;
    }
    int v = 0;  HashMap_get<int, int>(&m, 3, &v);
    printf("%d %d\n", v, m.count);

    // struct keys
    let pm: HashMap<Pt, int>;  HashMap_init<Pt, int>(&pm, 8, pt_hash, pt_eq);
    let p1: Pt;  p1.x = 1;  p1.y = 2;
    let p2: Pt;  p2.x = 3;  p2.y = 4;
    int c = 0;
    *int s1 = HashMap_at<Pt, int>(&pm, p1, &c);  s1[0] = 100;
    *int s2 = HashMap_at<Pt, int>(&pm, p2, &c);  s2[0] = 200;
    let q: Pt;  q.x = 1;  q.y = 2;
    int got = 0;  HashMap_get<Pt, int>(&pm, q, &got);
    printf("%d %d\n", got, pm.count);

    HashMap_free<int, int>(&m);  HashMap_free<Pt, int>(&pm);
    return 0;
}
