// async/await transform: a suspending await over a real reactor read. fetch's
// params (lp, fd) live across the await; the coroutine parks, the loop dispatches
// the read, the resume completes the future. Deterministic (pipe pre-filled).
import <future>;
import <net_async>;
import <eventloop>;
extern int  printf(string fmt, ...);
extern int  pipe(*int fds);
extern int64 write(int fd, *void buf, int64 n);

uint8[64] g_buf;
EventLoop* g_lp;

async int fetch(EventLoop* lp, int fd) {
    int n = await net_read_async(lp, fd, &g_buf[0], (int64)64);
    return n + 100;
}

int main() {
    int[2] fds; pipe(&fds[0]);
    write(fds[1], (*void)"hello", (int64)5);
    g_lp = el_new(64);
    Future<int>* f = fetch(g_lp, fds[0]);
    if (future_poll<int>(f, void() { el_stop(g_lp); }) == 0) { el_run(g_lp); }
    printf("%d\n", f.value);                 // 105
    free_future<int>(f);
    el_free(g_lp);
    return 0;
}
