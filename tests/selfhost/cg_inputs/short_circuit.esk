// &&/|| with short-circuit: a guarded side-effecting call must not run, and logical
// results must be correct. The compiler relies on this for `i < n && a[i]==…` guards.
int side = 0;
int bump() { side = side + 1; return 5; }

int main() {
    let a: int = 0;
    if (a != 0 && bump() > 0) { }      // false && _  → bump NOT called
    if (a == 0 || bump() > 0) { }      // true  || _  → bump NOT called
    let r: int = 0;
    if (1 == 1 && 2 == 2) { r = r + 40; }
    if (0 == 1 || 3 == 3) { r = r + 2; }
    return r + side;                   // side stays 0 → 42
}
