// Regression: logical-not (!) and bitwise-not (~) must be real operations in
// both back-ends, not no-ops.
extern int printf(string fmt, ...);
int main() {
    bool done = false;
    if (!done) { printf("A\n"); } else { printf("B\n"); }
    printf("%d %d %d\n", !5, !0, ~5);   // 0 1 -6
    int n = 0;
    while (!(n >= 3)) { n = n + 1; }
    printf("%d\n", n);                  // 3
    return 0;
}
