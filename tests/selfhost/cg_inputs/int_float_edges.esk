// Regression: integer-literal width and unsigned->float conversion must agree
// between the C++ and self-host back-ends and be numerically correct.
extern int printf(string fmt, ...);

int main() {
    int64 wide = 3000000000;          // in [2^31, 2^32): must be i64, not truncated
    printf("%lld\n", wide);           // 3000000000

    uint32 u = 4000000000;            // high bit set
    float f = u;                      // must use uitofp, not sitofp
    printf("%.1f\n", f);              // 4000000000.0

    double d = u;                     // uint32 -> double, also uitofp
    printf("%.1f\n", d);              // 4000000000.0

    return 0;
}
