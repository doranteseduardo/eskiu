// select2: await whichever of two futures completes first; the loser is dropped.
// Two races — one where pipe A has data (A wins), one where B does (B wins).
// Deterministic; leak-free (winner freed by caller, loser dropped by select2).
// Uses the generic `select2(ra, rb)` — typed futures, no `(FutureHdr*)` cast.
import <future>;
import <net_async>;
import <eventloop>;
extern int  printf(string fmt, ...);
extern int  pipe(*int fds);
extern int64 write(int fd, *void buf, int64 n);
uint8[64] ba;  uint8[64] bb;
EventLoop* g_lp;

async int race(EventLoop* lp, int fa, int fb) {
    Future<int>* ra = net_read_async(lp, fa, &ba[0], (int64)64);
    Future<int>* rb = net_read_async(lp, fb, &bb[0], (int64)64);
    int w = await select2(ra, rb);
    if (w == 0) { int n = ra.value;  free_future<int>(ra); return n; }
    int n2 = rb.value;  free_future<int>(rb); return 100 + n2;
}

int run_race(int aBytes, int bBytes) {
    int[2] pa; pipe(&pa[0]);
    int[2] pb; pipe(&pb[0]);
    if (aBytes > 0) { write(pa[1], (*void)"aa", (int64)aBytes); }
    if (bBytes > 0) { write(pb[1], (*void)"bbb", (int64)bBytes); }
    g_lp = el_new(64);
    Future<int>* f = race(g_lp, pa[0], pb[0]);
    if (future_poll<int>(f, void() { el_stop(g_lp); }) == 0) { el_run(g_lp); }
    int r = f.value;
    free_future<int>(f);
    el_free(g_lp);
    return r;
}

int main() {
    int a = run_race(2, 0);    // only A has data -> A wins -> 2
    int b = run_race(0, 3);    // only B has data -> B wins -> 103
    printf("%d %d\n", a, b);
    return 0;
}
