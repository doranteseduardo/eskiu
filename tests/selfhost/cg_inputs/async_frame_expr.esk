// Frame-hoisted locals used inside compound expressions after an await must be
// renamed to `fr.<name>`. This guards the shared child-enumeration the async
// transform's `rewrite` uses: it previously hand-rolled the recursion and skipped
// `StructInitExpr` (and others), so `x` inside `P{ a: x }` after an await came out
// as a bare undefined local. Here both frame vars feed a struct literal, an index
// expression, and a nested call — all after suspending-capable awaits.
import <future>;
extern int printf(string fmt, ...);

struct P { int a; int b; }
Future<int>* produce(int v) { Future<int>* f = future_new<int>(); future_complete<int>(f, v); return f; }
int add(int a, int b) { return a + b; }

async int f() {
    int x = await produce(5);
    int y = await produce(7);
    P p = P{ a: x, b: y };           // frame vars in a struct literal
    int[3] arr;
    arr[x - 4] = y;                  // frame var in an index expression
    int s = add(p.a, arr[1]);        // frame vars through a call + index
    return p.a * 100 + p.b * 10 + s; // 5*100 + 7*10 + (5+7) = 582
}

int main() {
    Future<int>* fut = f();
    future_poll<int>(fut, void() {});
    printf("%d\n", fut.value);       // 582
    free_future<int>(fut);
    return 0;
}
