// Generic-argument inference: a generic fn called WITHOUT explicit <T> — the type args
// are solved by unifying each parameter pattern against the actual argument types.
struct Box<T> { T v; }
T unwrap<T>(Box<T>* b) { return b.v; }
int add<T>(T a, T b) { return a + b; }
int main() {
    let bi: Box<int> = Box<int> { v: 30 };
    return unwrap(&bi) + add(7, 5);   // 30 + 12 = 42 (both inferred: unwrap<int>, add<int>)
}
