// alloc_with over an allocator whose alloc is an inline method, through a pointer, with
// an alias-typed count; a string slices to char[].
extern int printf(string fmt, ...);
extern *void malloc(int64 n);
struct My { int calls; *void alloc(int64 n) { self.calls += 1; return malloc(n); } }
type Cnt = int64;
int main() {
  let m: My; m.calls = 0;
  *My pm = &m;
  Cnt k = 3;
  *int a = alloc_with(&m, int, 4);
  *int b = alloc_with(pm, int, k);
  a[0] = 1; b[2] = 2;
  printf("%d %d\n", m.calls, a[0] + b[2]);
  string s = "abcdef";
  char[] t = s[1..3];
  printf("%lld %c%c\n", t.len, t[0], t[1]);
  return 0;
}
