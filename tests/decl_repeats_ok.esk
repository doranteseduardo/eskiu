// Repeated top-level declarations that stay legal: a prototype before its definition,
// an `extern` declaration beside the variable's definition, and the same struct declared
// twice with identical fields (as when two merged files share a declaration).
extern int printf(string f, ...);
extern int printf(string fmt, ...);
struct P { int x; int y; }
struct P { int x; int y; }
int twice(int v);
extern int counter;
int counter = 4;
extern int counter;
int twice(int v) { return v * 2; }
int main() {
    let p: P = P{x: 1, y: 2};
    printf("%d %d\n", twice(p.x + p.y), counter);
    return 0;
}
