// Fields a struct literal omits are zero-initialized (C semantics), at -O0 and -O2.
extern int printf(string fmt, ...);

struct P { int x; int y; double z; *int q; int64 w; }

int dirty(int n) {
    // Leave garbage in the stack slots a later literal may reuse.
    int[16] junk;
    for (int i = 0; i < 16; i++) { junk[i] = n * 7 + i; }
    return junk[3];
}

P make(int x) { return P{ x: x }; }

int main() {
    dirty(99);
    P a = P{ y: 5 };
    printf("%d %d %.1f %d %lld\n", a.x, a.y, a.z, (int)(a.q == null), a.w);
    P b = make(3);
    printf("%d %d %.1f %d %lld\n", b.x, b.y, b.z, (int)(b.q == null), b.w);
    a = P{ w: 9 };
    printf("%d %d %lld\n", a.x, a.y, a.w);
    return 0;
}
