// fetch_async: two requests in flight at once on one event loop (a slow one
// does not hold up a fast one), a redirect, a POST body, a timeout against a
// server that never accepts, connection refused, a host name (looked up on a
// thread, not on the loop), a name that does not resolve, and a fetch dropped
// while its lookup may still run. The server is http_serve on its own threads.
import <fetch>;
import <http>;
import <future>;
import <eventloop>;
import <net>;
import <time>;
import <timer>;
import <string>;
extern int printf(string fmt, ...);

const int PORT = 18434;
const int HANG_PORT = 18435;
EventLoop* g_lp;

void handler(HttpRequest* req, HttpResponse* res) {
    if (req.path.eq_cstr("/slow") == 1) {
        time_sleep_ms(400);
        HttpResponse_set_body(res, "slow done");
    } else if (req.path.eq_cstr("/fast") == 1) {
        HttpResponse_set_body(res, "fast done");
    } else if (req.path.eq_cstr("/go") == 1) {
        res.status = 302;
        HttpResponse_header(res, "Location", "/fast");
    } else if (req.path.eq_cstr("/echo") == 1) {
        res.body.append(req.method.cstr());
        res.body.append(":");
        res.body.append(req.body.cstr());
    } else {
        res.status = 404;
    }
}

void show(string what, int rc, Response* r) {
    if (rc == 0) { printf("%s: %d [%s] redirects=%d\n", what, r.status, Response_text(r), r.redirects); }
    else { printf("%s: rc=%d (%s)\n", what, rc, fetch_last_error()); }
}

async int run(EventLoop* lp) {
    let o: FetchOptions;  FetchOptions_init(&o);
    let a: Response;
    let b: Response;
    const int64 t0 = time_monotonic_ms();
    Future<int>* fa = fetch_async(lp, "http://127.0.0.1:18434/slow", &o, &a);
    Future<int>* fb = fetch_async(lp, "http://127.0.0.1:18434/fast", &o, &b);
    int first = await select2(fb, fa);
    printf("first to finish: %s\n", first == 0 ? "fast" : "slow");
    // select2 dropped the loser; fetch the slow one again and wait for it.
    if (first == 0) { show("fast", fb.value, &b); Future_free<int>(fb); }
    Response_free(&a);
    Response_free(&b);
    int rc = await fetch_async(lp, "http://127.0.0.1:18434/slow", &o, &a);
    show("slow", rc, &a);
    Response_free(&a);
    printf("both within 2 s: %d\n", time_monotonic_ms() - t0 < 2000 ? 1 : 0);

    rc = await fetch_async(lp, "http://127.0.0.1:18434/go", &o, &a);
    show("redirect", rc, &a);
    Response_free(&a);

    FetchOptions_method(&o, "PUT");
    FetchOptions_body_text(&o, "payload");
    rc = await fetch_async(lp, "http://127.0.0.1:18434/echo", &o, &a);
    show("put", rc, &a);
    Response_free(&a);

    o.timeout_ms = 300;
    rc = await fetch_async(lp, "http://127.0.0.1:18435/", &o, &a);
    show("timeout", rc, &a);
    Response_free(&a);

    // Windows retries a refused connect for about 2 s before it reports it.
    o.timeout_ms = 10000;
    rc = await fetch_async(lp, "http://127.0.0.1:1/", &o, &a);
    printf("refused: rc=%d\n", rc);
    Response_free(&a);

    rc = await fetch_async(lp, "http://localhost:18434/fast", &o, &a);
    show("localhost", rc, &a);
    Response_free(&a);

    rc = await fetch_async(lp, "http://no-such-host.invalid/", &o, &a);
    printf("unresolvable: rc=%d\n", rc);
    Response_free(&a);

    // Whichever finishes first, the loser is dropped (a running lookup frees
    // itself when its thread ends).
    Future<int>* fl = fetch_async(lp, "http://localhost:18434/fast", &o, &a);
    Future<int>* ft = timer_after(lp, 0);
    if (await select2(fl, ft) == 0) { Future_free<int>(fl); } else { Future_free<int>(ft); }
    printf("dropped during lookup: ok\n");
    Response_free(&a);
    FetchOptions_free(&o);
    return 0;
}

int main() {
    const int hang = net_tcp_listen((uint16)HANG_PORT);   // never accepted
    thread_create(void() { http_serve(PORT, 4, handler); });
    // Wait for the server with a blocking fetch.
    let r: Response;
    int rc = -1;
    for (int i = 0; i < 100 && rc != 0; i++) {
        rc = fetch("http://127.0.0.1:18434/fast", &r);
        Response_free(&r);
        if (rc != 0) { time_sleep_ms(20); }
    }
    g_lp = el_new(64);
    Future<int>* f = run(g_lp);
    if (Future_poll<int>(f, void() { EventLoop_stop(g_lp); }) == 0) { EventLoop_run(g_lp); }
    printf("done %d\n", f.value);
    Future_free<int>(f);
    EventLoop_free(g_lp);
    net_close(hang);
    return 0;
}
