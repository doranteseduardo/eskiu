// Stack-stress: a long loop with several locals. With the old codegen bug
// (allocas emitted in the loop body, re-run every iteration), this overflowed
// the stack and crashed. Locks in the entry-block-alloca fix.
extern int printf(string fmt, ...);

int main() {
    int64 sum = 0;
    int i = 0;
    while (i < 1000000) {
        int a = i & 1;
        int b = i & 2;
        int c = i & 4;
        int d = i & 8;
        sum = sum + (int64)(a + b + c + d);
        i = i + 1;
    }
    printf("%lld\n", sum);     // 1e6 divisible by 16 → each bit set exactly half
    return 0;
}
