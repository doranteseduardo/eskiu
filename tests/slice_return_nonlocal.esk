// A slice parameter or slice field is not local storage: returning a slice of it, or
// the address of one of its elements, is valid in both compilers.
extern int printf(string fmt, ...);
struct S { int x; *int px; int[] sl; }
int[4] g = {1, 2, 3, 4};
*int a1(int[] s) { return &s[1]; }
*int a2() { static int[3] z = {5, 6, 7}; return &z[1]; }
*int a3(*int[2] ps) { return &ps[1][0]; }
*int a4(S s) { return &s.px[0]; }
*int a5(S s) { return &s.sl[2]; }
int[] a6(S s) { return s.sl; }
int[] tail(int[] s) { return s[1..s.len]; }
int[] mid(S s) { return s.sl[1..3]; }
int main() {
    int v = 9;
    S s; s.x = 0; s.px = &g[3]; s.sl = g[0..4];
    *int[2] ps = {&g[0], &v};
    printf("%d %d %d %d %d %d\n", *a1(g[0..4]), *a2(), *a3(ps), *a4(s), *a5(s), a6(s)[0]);
    int[] t = tail(g[0..4]); int[] m = mid(s);
    printf("%d %lld %d %lld\n", t[0], t.len, m[0], m.len);
    return 0;
}
