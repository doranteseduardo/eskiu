// A `let` in a nested block (or a for-init) shadows, not overwrites, an outer
// variable of the same name; the outer binding is visible again after the scope.
import <future>;
extern int printf(string fmt, ...);

int nested() { let x: int = 1; { let x: int = 10; x = x + 1; } return x; }

int loops() {
    int n = 0;
    for (int i = 0; i < 3; i++) { let i: int = 10; n = n + i; }
    int i = 7;
    for (int i = 0; i < 2; i++) { n = n + 1; }
    return n + i;
}

int siblings() {
    int s = 0;
    { let v: int = 2; s = s + v; }
    { let v: int = 3; s = s + v; }
    return s;
}

Future<int>* produce() { Future<int>* f = future_new<int>(); future_complete<int>(f, 41); return f; }
async int one(int a) {
    let x: int = 1;
    { let x: int = await produce(); x = x + 1; }
    { let x: int = 5; a = a + x; }
    return x + a;
}

int call(fn()->int f) { return f(); }
async int lam(int a) {
    let x: int = 1;
    { let x: int = await produce(); let g: fn()->int = int() { return x + 2; }; a = a + call(g); }
    let h: fn()->int = int() { return x; };
    return a + call(h);
}

int main() {
    printf("%d\n", nested());
    printf("%d\n", loops());
    printf("%d\n", siblings());
    Future<int>* r = one(1);
    printf("%d\n", r.value);
    Future<int>* q = lam(0);
    printf("%d\n", q.value);
    return 0;
}
