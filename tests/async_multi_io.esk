// Two suspending awaits over the reactor: each parks and resumes through the
// loop, threading its value into the frame. Deterministic (pipes pre-filled).
import <future>;
import <net_async>;
import <eventloop>;
extern int  printf(string fmt, ...);
extern int  pipe(*int fds);
extern int64 write(int fd, *void buf, int64 n);
uint8[64] b1;
uint8[64] b2;
EventLoop* g_lp;
async int twice(EventLoop* lp, int fd1, int fd2) {
    int a = await net_read_async(lp, fd1, &b1[0], (int64)64);
    int b = await net_read_async(lp, fd2, &b2[0], (int64)64);
    return a + b;
}
int main() {
    int[2] p1; pipe(&p1[0]);
    int[2] p2; pipe(&p2[0]);
    write(p1[1], (*void)"abc",  (int64)3);
    write(p2[1], (*void)"wxyz", (int64)4);
    g_lp = el_new(64);
    Future<int>* f = twice(g_lp, p1[0], p2[0]);
    if (future_poll<int>(f, void() { el_stop(g_lp); }) == 0) { el_run(g_lp); }
    printf("%d\n", f.value);
    free_future<int>(f);
    el_free(g_lp);
    return 0;
}
