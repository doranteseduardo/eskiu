// Expected-type variant inference reaches a nested variant payload, a struct-literal field,
// an array-literal element, an argument of an explicit generic call and `return None;` in
// a generic function (written `None<T>()` there, shared by every instance).
extern int printf(string fmt, ...);
enum Opt<T> { Some(T), None }
struct S { Opt<int64> o; int k; }
int64 get(Opt<int64> o) { match (o) { Some(v) -> { return v; } None -> { return -1; } } }
double getd(Opt<double> o) { match (o) { Some(v) -> { return v; } None -> { return -1.0; } } }
int64 get2(Opt<Opt<int64>> o) { match (o) { Some(v) -> { return get(v) * 10; } None -> { return -9; } } }
T getg<T>(Opt<T> o, T d) { match (o) { Some(v) -> { return v; } None -> { return d; } } }
Opt<T> wrap<T>(T v) { return Some(v); }
Opt<T> none<T>() { return None; }
int main(int argc, string* argv) {
    Opt<Opt<int64>> nn = Some(Some(5));
    printf("%lld\n", get2(nn));
    Opt<int64> t = argc > 0 ? Some(4) : None;
    printf("%lld\n", get(t));
    S s = S{ o: Some(3000000000), k: 1 };
    S s2 = S{ o: Some(3), k: 1 };
    printf("%lld %lld\n", get(s.o), get(s2.o));
    Opt<int64>[2] arr = { Some(1), None };
    printf("%lld %lld\n", get(arr[0]), get(arr[1]));
    Opt<double> d = Some(1);
    printf("%f\n", getd(d));
    printf("%lld\n", getg<int64>(Some(8), 0));
    printf("%d\n", getg(wrap(9), 0));
    printf("%d\n", getg(none<int>(), 3));
    let f: fn()->Opt<int64> = Opt<int64>() { return Some(6); };
    printf("%lld\n", get(f()));
    Opt<int64> x = None;
    x = argc > 5 ? None : Some(2);
    printf("%lld\n", get(x));
    return 0;
}
