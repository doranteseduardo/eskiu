boundary(multipart/form-data; boundary=abc) -> 1 [abc]
boundary(multipart/form-data; Boundary=abc) -> 1 [abc]
boundary(multipart/form-data; BOUNDARY="q q"; charset=x) -> 1 [q q]
boundary(multipart/form-data; notboundary=zz; boundary=real) -> 1 [real]
boundary(multipart/form-data; x="a;boundary=fake"; boundary=real) -> 1 [real]
boundary(multipart/form-data; boundary=) -> 0 []
boundary(boundary=nomediatype) -> 0 []
