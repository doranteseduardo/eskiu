// <regex> escapes follow RE2 (Go regexp): \b and \B are ASCII word
// boundaries, \A and \z the start and end of text, \xHH / \x{H..} and octal
// \0, \012, \101 give a byte, \a is BEL, and a backslash before punctuation is
// that character. Any other escaped letter or digit (\q, \1, \8, \Z, \e, \x4,
// [\b]) is a compile error; they all used to be silently the literal letter.
import <regex>;
extern int printf(string fmt, ...);

void text(string s) {
    printf("\"");
    for (int i = 0; s[i] != 0; i++) {
        if ((int)s[i] < 32) { printf("\\x%02x", (int)s[i]); } else { printf("%c", (int)s[i]); }
    }
    printf("\"");
}

void show(string p, string s) {
    Regex re = regex_compile(p);
    if (re.ok == 0) { printf("%s: error %s\n", p, re.err); Regex_free(&re); return; }
    let m: Match;
    printf("%s on ", p);
    text(s);
    if (Regex_search(&re, s, &m) == 1) { printf(": %d,%d\n", m.start, m.end); }
    else { printf(": no\n"); }
    Match_free(&m);
    Regex_free(&re);
}

int main() {
    show("\\bab\\b", "x ab y");
    show("\\bab\\b", "xab y");
    show("\\Bb", "ab");
    show("\\Bb", "b");
    show("\\b", "");
    show("\\B", "");
    show("a\\b", "a");
    show("\\b\\w+\\b", "  hi_1 !");
    show("\\Aab\\z", "ab");
    show("\\Aab\\z", "abc");
    show("\\x41\\x{42}", "zAB");
    show("[\\x61-\\x63]+", "zabcd");
    show("\\101\\102", "zAB");
    show("\\0101", "A1");
    char[4] bel = {'x', (char)7, '1', (char)0};
    show("\\07", (string)&bel[0]);
    show("\\a1", (string)&bel[0]);
    show("\\0", (string)&bel[0]);
    show("\\.\\-\\ \\_", ".- _");
    show("[\\d-z]+", "a1-z9");
    show("\\q", "q");
    show("\\1", "1");
    show("\\8", "8");
    show("\\Z", "Z");
    show("\\e", "e");
    show("\\x4", "x4");
    show("\\x{}", "x");
    show("\\x{100}", "x");
    show("[\\b]", "b");
    show("[\\q]", "q");
    return 0;
}
