// Case values fold to integer constants: literals, chars, enum members, casts and
// arithmetic over them. (A variable, even a `const`, is not a case constant.)
import <io>;

enum Col { Red, Green = 5, Blue }

int classify(int i) {
    switch (i) {
        case 1 + 2: return 30;
        case -1: return 10;
        case Green: return 50;
        case (4 * 2) - 1: return 70;
        case 'a' - 97: return 100;
        case 1 << 3: return 80;
        case ~(-5): return 40;
        case (int)Blue: return 60;
        default: return i;
    }
    return 0;
}

int main() {
    int i = -1;
    while (i < 10) {
        printf("%d ", classify(i));
        i++;
    }
    printf("\n");
    return 0;
}
