// A union takes the alignment of its most-aligned member, so it lands at the
// C offset inside a struct and the struct is padded like C (u at 8, size 24).
extern int printf(string fmt, ...);

union U { int64 l; int i; uint8 b; }
union F { float f; int16 s; }
struct HasU { int tag; U u; int after; }
struct HasF { char c; F f; char d; }

int main() {
    let h: HasU;
    h.tag = 1; h.u.l = 0x1122334455667788; h.after = 77;
    let base: int64 = (int64)&h;
    printf("sizeof U=%d HasU=%d F=%d HasF=%d\n", (int)sizeof(U), (int)sizeof(HasU), (int)sizeof(F), (int)sizeof(HasF));
    printf("off u=%d after=%d\n", (int)((int64)&h.u - base), (int)((int64)&h.after - base));
    printf("%x %x %d %d\n", h.u.i, (int)h.u.b, h.tag, h.after);
    let arr: HasU[3];
    arr[1].u.l = -1; arr[2].tag = 9; arr[0].after = 5;
    printf("%lld %d %d\n", arr[1].u.l, arr[2].tag, arr[0].after);
    let hf: HasF;
    hf.c = 'a'; hf.f.f = 1.5; hf.d = 'z';
    printf("%.1f %c %c\n", (double)hf.f.f, hf.c, hf.d);
    return 0;
}
