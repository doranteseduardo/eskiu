// HTTP/2 stage 6 — the h2c server, end to end over a socketpair. The "client"
// writes the preface, a SETTINGS frame, a HEADERS frame (GET /, END_STREAM) and
// a GOAWAY; the server runs over the event loop — handshake, dispatch, HPACK
// decode, handler, response encode — and the response (HEADERS + DATA) is read
// back and decoded.
import <mem>;
import <future>;
import <eventloop>;
import <net>;
import <channel>;
import <hpack>;
import <http2>;
import <http>;
import <http2_server>;
import <string>;
extern int printf(string fmt, ...);
extern int socketpair(int domain, int type, int protocol, *int sv);

EventLoop* g_lp;

void hello(HttpRequest* req, HttpResponse* res) {
    HttpResponse_header(res, "X-Test", "yes");
    HttpResponse_set_body(res, "hello h2");
}

int main() {
    *int sv = alloc<int>(2);
    if (socketpair(1, 1, 0, sv) != 0) { printf("socketpair failed\n"); return 1; }
    int srv = sv[0];  int cli = sv[1];

    *uint8 b = alloc<uint8>(512);
    net_send(cli, (*void)h2_preface(), (int64)24);
    let cs: H2Settings;  h2_settings_defaults(&cs);
    int sn = h2_write_settings(b, &cs);  net_send(cli, (*void)b, (int64)sn);

    // HEADERS: GET / on stream 1, END_STREAM | END_HEADERS.
    *uint8 blk = alloc<uint8>(256);  int off = 0;
    off = hpack_encode_header(blk, off, (*uint8)":method", 7, (*uint8)"GET", 3);
    off = hpack_encode_header(blk, off, (*uint8)":path", 5, (*uint8)"/", 1);
    off = hpack_encode_header(blk, off, (*uint8)":scheme", 7, (*uint8)"http", 4);
    off = hpack_encode_header(blk, off, (*uint8)":authority", 10, (*uint8)"localhost", 9);
    int hn = h2_write_headers(b, 1, blk, off, 1, 1);  net_send(cli, (*void)b, (int64)hn);

    int gn = h2_write_goaway(b, 1, H2_NO_ERROR, (*uint8)0, 0);  net_send(cli, (*void)b, (int64)gn);

    g_lp = el_new(16);
    Chan<int>* done = chan_new<int>(1);
    Future<uint8>* f = http2_serve_conn_async(g_lp, srv, hello, done);
    future_poll<uint8>(f, void() { el_stop(g_lp); });
    el_run(g_lp);

    // Read and walk the server's frames; decode the response HEADERS + DATA.
    *uint8 rb = alloc<uint8>(4096);
    int total = (int)net_recv(cli, (*void)rb, (int64)4096);
    let dec: HpackDecoder;  hpack_decoder_init(&dec, (int64)4096);
    *HpackHeader hs = alloc<HpackHeader>(32);
    int pos = 0;  int status = 0;  int blen = 0;  *uint8 body = (*uint8)0;  int clen = 0;
    while (pos + 9 <= total) {
        let fr: H2Frame;  h2_read_header(rb + pos, &fr);
        int payload = pos + 9;
        if (fr.type == H2_HEADERS) {
            int n = hpack_decode(&dec, rb + payload, fr.length, hs, 32);
            int i = 0;
            while (i < n) {
                if (h2_name_eq(&hs[i], ":status") != 0) {
                    int v = 0;  int j = 0;
                    while (j < hs[i].vlen) { v = v * 10 + ((int)hs[i].value[j] - 48); j = j + 1; }
                    status = v;
                } else if (h2_name_eq(&hs[i], "content-length") != 0) {
                    int v = 0;  int j = 0;
                    while (j < hs[i].vlen) { v = v * 10 + ((int)hs[i].value[j] - 48); j = j + 1; }
                    clen = v;
                }
                i = i + 1;
            }
        } else if (fr.type == H2_DATA) {
            body = rb + payload;  blen = fr.length;
        }
        pos = payload + fr.length;
    }
    printf("status=%d content_length=%d datalen=%d body=%.*s\n", status, clen, blen, blen, body);
    hpack_decoder_free(&dec);
    return 0;
}
