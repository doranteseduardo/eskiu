// http_reply with a null body sends an empty body (Content-Length: 0). It used
// to read body.len through the null pointer and crash.
import <mem>;
import <string>;
import <http>;
extern int printf(string fmt, ...);
extern int socketpair(int domain, int type, int proto, *int fds);
extern int64 read(int fd, *void buf, int64 n);
extern int close(int fd);

void show(int fd) {
    *char buf = alloc<char>(512);
    int64 total = 0;
    while (total < 511) {
        const int64 n = read(fd, (*void)(buf + total), 511 - total);
        if (n <= 0) { break; }
        total += n;
    }
    for (int64 i = 0; i < total; i++) {
        if (buf[i] == '\r') { printf("\\r"); } else { printf("%c", (int)buf[i]); }
    }
    printf("--\n");
    free((*void)buf);
}

int main() {
    int[2] sv;  socketpair(1, 1, 0, &sv[0]);
    http_reply(sv[0], 200, "text/plain", "", null);
    close(sv[0]);
    show(sv[1]);
    close(sv[1]);

    int[2] sw;  socketpair(1, 1, 0, &sw[0]);
    let b: String;  b.init(8);  b.append("ok");
    http_reply(sw[0], 200, "text/plain", "X-A: 1\r\n", &b);
    b.free();
    close(sw[0]);
    show(sw[1]);
    close(sw[1]);
    return 0;
}
