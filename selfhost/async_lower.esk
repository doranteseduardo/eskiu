// async_lower.esk — the async/await lowering pass (a port of sema/async_transform.cpp),
// run on the parsed Program between parse and codegen. Each `async T name()` function is
// rewritten into three ordinary decls:
//
//   struct __name_frame { Future<T> ret; int st; *FutureHdr awaiting; <params>; <locals>;
//                         *Future<Ti> __awI; }          // ret FIRST: &fr.ret == fr
//   void __name_resume(*__name_frame fr) { while (1) { if (fr.st==0){…} else if … } }
//   *Future<T> name(params) { fr = alloc; init; fr.st=0; __name_resume(fr); return &fr.ret; }
//
// A state machine: each `await` splits a state — evaluate the future, `future_poll` it,
// suspend (return) if pending, and resume in the next state reading `fr.__awI.value`. The
// waker is a closure `void(){ fr.st=<next>; __name_resume(fr); }` capturing the frame.
//
// Covers the full structure: sequential bodies, control flow around an await
// (if/while/for/for-in/switch with break/continue, lowered into the state graph), a
// desugar pass (`return await E` / `await E;` / `x = await E` → let-bound), and the
// constructor's waker + on_drop (cancellation) closures. for-in desugars to a counted
// for (array `T[N]` or a list-like struct with `data`/`size`). All 19 async tests pass.

import "ast.esk";
import "parser.esk";   // mk_ident/mk_lit/mk_bin/mk_cast, str_concat/str_eq/int_to_str, new_decl

// ── AST builders ─────────────────────────────────────────────────────────────
*ExprNode al_member(*ExprNode base, string field) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_MEMBER; e.a = base; e.sval = field;
    return e;
}
// Names the lowering synthesizes for the async function being lowered: the frame pointer
// and the frame's bookkeeping fields. al_transform picks each outside every name spelled
// in the function (mirrors the C++ FrameNames), so a user local, parameter, or field named
// `__fr` / `st` / `ret` / `awaiting` cannot collide with them.
string al_frp = "__fr";
string al_fst = "st";
string al_fret = "ret";
string al_fawt = "awaiting";
// The frame fields of the function being lowered (name + declared type), so a
// `sizeof(local)` can be rewritten to the local's type once the local is a frame field.
List<Param>* al_cur_fields = null;
*ExprNode al_fr(string field) { return al_member(mk_ident(al_frp), field); }
// The lowered function's type-parameter list spelled `<T, U>` ("" when it is not generic):
// a generic async function lowers to a generic frame, resume function, and constructor.
string al_tps = "";

*ExprNode al_call(string name, List<*ExprNode>* args) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_CALL; e.a = mk_ident(name);
    List_init<*ExprNode>(&e.kids, 4);
    int i = 0; while (i < List_len<*ExprNode>(args)) { List_push<*ExprNode>(&e.kids, List_get<*ExprNode>(args, i)); i = i + 1; }
    return e;
}
*ExprNode al_tcall(string spelling, List<*ExprNode>* args) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_TEMPLATECALL; e.sval = spelling;
    List_init<*ExprNode>(&e.kids, 4);
    int i = 0; while (i < List_len<*ExprNode>(args)) { List_push<*ExprNode>(&e.kids, List_get<*ExprNode>(args, i)); i = i + 1; }
    return e;
}
*ExprNode al_int(int n) { return mk_lit(LIT_INT, int_to_str(n)); }

*StmtNode al_exprstmt(*ExprNode e) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_EXPR; s.expr = e;
    return s;
}
*StmtNode al_assign(*ExprNode lhs, *ExprNode rhs) { return al_exprstmt(mk_bin("=", lhs, rhs)); }
*StmtNode al_return(*ExprNode v) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_RETURN; s.expr = v;
    return s;
}
*StmtNode al_block(List<*StmtNode>* items) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_BLOCK;
    List_init<*StmtNode>(&s.items, 4);
    int i = 0; while (i < List_len<*StmtNode>(items)) { List_push<*StmtNode>(&s.items, List_get<*StmtNode>(items, i)); i = i + 1; }
    return s;
}
*StmtNode al_if(*ExprNode cond, *StmtNode then_s, *StmtNode else_s) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_IF; s.expr = cond; s.s1 = then_s; s.s2 = else_s;
    return s;
}
*StmtNode al_while(*ExprNode cond, *StmtNode body) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_WHILE; s.expr = cond; s.s1 = body;
    return s;
}
*StmtNode al_for(*StmtNode init, *ExprNode cond, *ExprNode step, *StmtNode body) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_FOR; s.s1 = init; s.expr = cond; s.expr2 = step; s.s2 = body;
    return s;
}
*StmtNode al_dowhile(*StmtNode body, *ExprNode cond) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_DOWHILE; s.s1 = body; s.expr = cond;
    return s;
}
*StmtNode al_defer(*StmtNode body, int is_err) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_DEFER; s.s1 = body; s.is_err = is_err;
    return s;
}
string al_substr(string s, int a, int b) {
    *uint8 buf = alloc<uint8>(b - a + 1);
    int k = 0; while (k < b - a) { buf[k] = (uint8)s[a + k]; k = k + 1; }
    buf[b - a] = 0;
    return (string)buf;
}
*ExprNode al_index(*ExprNode base, *ExprNode idx) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_INDEX; e.a = base; e.b = idx;
    return e;
}
*StmtNode al_case(*ExprNode value, List<*StmtNode>* body) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_CASE; s.expr = value;
    List_init<*StmtNode>(&s.items, 4);
    int i = 0; while (i < List_len<*StmtNode>(body)) { List_push<*StmtNode>(&s.items, List_get<*StmtNode>(body, i)); i = i + 1; }
    return s;
}
*StmtNode al_switch(*ExprNode subject, List<*StmtNode>* cases) {
    *StmtNode s = alloc<StmtNode>(1);
    s.kind = SK_SWITCH; s.expr = subject;
    List_init<*StmtNode>(&s.items, 4);
    int i = 0; while (i < List_len<*StmtNode>(cases)) { List_push<*StmtNode>(&s.items, List_get<*StmtNode>(cases, i)); i = i + 1; }
    return s;
}

// `__name_resume(fr)`, or `__name_resume<T..>(fr)` for a generic async function.
*ExprNode al_resume_call(string resumeN) {
    List<*ExprNode> ra; List_init<*ExprNode>(&ra, 1); List_push<*ExprNode>(&ra, mk_ident(al_frp));
    if (al_tps[0] == 0) { return al_call(resumeN, &ra); }
    return al_tcall(str_concat(resumeN, al_tps), &ra);
}

// The waker closure `void() { fr.st = <state>; __name_resume(fr); }` (captures fr).
*ExprNode al_waker(string resumeN, int state) {
    List<*StmtNode> body; List_init<*StmtNode>(&body, 2);
    List_push<*StmtNode>(&body, al_assign(al_fr(al_fst), al_int(state)));
    List_push<*StmtNode>(&body, al_exprstmt(al_resume_call(resumeN)));
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_LAMBDA; e.sval = "void()"; e.stmt = al_block(&body);
    return e;
}

// ── Frame-variable rewrite: a local/param reference `x` becomes `fr.x` ─────────
int al_in(List<string>* vars, string nm) {
    int i = 0; while (i < List_len<string>(vars)) { if (str_eq(List_get<string>(vars, i), nm) == 1) { return 1; } i = i + 1; }
    return 0;
}
// The direct child expressions of `e`, in the same order as the C++ astwalk::
// forEachChildExpr (the single child enumeration al_rewrite / al_expr_has_await share).
// A lambda is a scope boundary and is not descended.
void al_children(*ExprNode e, List<*ExprNode>* out) {
    if (e == null) { return; }
    int k = e.kind;
    if (k == EK_BINARY || k == EK_INDEX || k == EK_TERNARY || k == EK_ALLOCWITH) {
        List_push<*ExprNode>(out, e.a); List_push<*ExprNode>(out, e.b);
    } else if (k == EK_UNARY || k == EK_INCDEC || k == EK_MEMBER || k == EK_CAST || k == EK_QUESTION
               || k == EK_AWAIT || k == EK_CALL || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        List_push<*ExprNode>(out, e.a);
    }
    // kids: call args, template-call args, struct-literal field values, array-literal
    // elements, a slice's hi bound (EK_INDEX), a ternary's else arm (EK_TERNARY).
    if (k == EK_CALL || k == EK_TEMPLATECALL || k == EK_STRUCTINIT || k == EK_ARRAYLIT
        || k == EK_INDEX || k == EK_TERNARY) {
        int i = 0; while (i < List_len<*ExprNode>(&e.kids)) { List_push<*ExprNode>(out, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
    }
}
void al_rewrite(*ExprNode e, List<string>* vars) {
    if (e == null) { return; }
    if (e.kind == EK_IDENT) {
        if (al_in(vars, e.sval) == 1) { e.kind = EK_MEMBER; e.a = mk_ident(al_frp); }   // x -> fr.x
        return;
    }
    if (e.kind == EK_SIZEOF && e.a != null) { al_rewrite(e.a, vars); return; }   // sizeof(expr)
    if (e.kind == EK_SIZEOF) {                     // sizeof(x) of a frame local: x's declared type
        if (al_in(vars, e.sval) == 1 && al_cur_fields != null) {
            int fi = 0;
            while (fi < List_len<Param>(al_cur_fields)) {
                Param f = List_get<Param>(al_cur_fields, fi);
                if (str_eq(f.name, e.sval) == 1) { e.sval = f.ty; return; }
                fi = fi + 1;
            }
        }
        return;
    }
    List<*ExprNode> ch; List_init<*ExprNode>(&ch, 4); al_children(e, &ch);
    int i = 0; while (i < List_len<*ExprNode>(&ch)) { al_rewrite(List_get<*ExprNode>(&ch, i), vars); i = i + 1; }
}

// ── Resolve the awaited inner type Ti: `await produce()` where produce returns
//    `Future<int>*` → Ti = "int". Looks the callee up in the program. ───────────
string al_inner_of_future(string ty) {        // "Future<int>*" / "*Future<int>" → "int"
    int i = 0; int n = 0; while (ty[n] != 0) { n = n + 1; }
    while (i < n && (int)ty[i] != 60) { i = i + 1; }   // to '<'
    if (i >= n) { return "int"; }
    int start = i + 1; int depth = 1; i = start;
    while (i < n && depth > 0) {
        int c = (int)ty[i];
        if (c == 60) { depth = depth + 1; }
        else if (c == 62) { depth = depth - 1; if (depth == 0) { break; } }
        i = i + 1;
    }
    *uint8 buf = alloc<uint8>(i - start + 1);
    int k = 0; while (k < i - start) { buf[k] = (uint8)ty[start + k]; k = k + 1; }
    buf[i - start] = 0;
    return (string)buf;
}
// `t` with each identifier run equal to a type parameter in `tps` replaced by the
// matching entry of `args` ("*List<T>" with T=int -> "*List<int>").
string al_subst(string t, List<TypeParam>* tps, List<string>* args) {
    if (List_len<TypeParam>(tps) == 0) { return t; }
    int n = 0; while (t[n] != 0) { n = n + 1; }
    string out = "";
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95) {
            int s0 = i;
            while (i < n) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) { i = i + 1; } else { break; }
            }
            string id = al_substr(t, s0, i);
            int k = 0; int hit = 0 - 1;
            while (k < List_len<TypeParam>(tps) && k < List_len<string>(args)) {
                if (str_eq(List_get<TypeParam>(tps, k).name, id) == 1) { hit = k; }
                k = k + 1;
            }
            if (hit >= 0) { out = str_concat(out, List_get<string>(args, hit)); } else { out = str_concat(out, id); }
        } else {
            out = str_concat(out, al_substr(t, i, i + 1));
            i = i + 1;
        }
    }
    return out;
}
*DeclNode al_find_fn(*Program prog, string name) {
    int i = 0; int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION && str_eq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}
string al_var_type(*DeclNode curfn, string name);
*DeclNode al_find_struct(*Program prog, string name);
string al_deref(string t);
string al_call_rettype(*Program prog, *DeclNode curfn, *ExprNode e, int* is_async);

// The (source-form) type of expression `e` inside `curfn`, as far as this pass can tell
// without the type checker: literals, locals/params/globals, casts, `&`/`*`, fields, and
// calls. "" when unknown.
string al_expr_type(*Program prog, *DeclNode curfn, *ExprNode e) {
    if (e == null) { return ""; }
    int k = e.kind;
    if (k == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) { return "int"; }
        if (e.lit_kind == LIT_FLOAT) { return "double"; }
        if (e.lit_kind == LIT_STRING) { return "string"; }
        if (e.lit_kind == LIT_CHAR) { return "char"; }
        if (e.lit_kind == LIT_BOOL) { return "bool"; }
        return "";
    }
    if (k == EK_IDENT) {
        string t = al_var_type(curfn, e.sval);
        if (t[0] != 0) { return t; }
        int i = 0; int n = List_len<*DeclNode>(&prog.decls);
        while (i < n) {
            *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
            if (d.kind == DK_VARDECL && str_eq(d.name, e.sval) == 1) { return d.ret_type; }
            i = i + 1;
        }
        return "";
    }
    if (k == EK_CAST) { return e.sval; }
    if (k == EK_UNARY && str_eq(e.sval, "&") == 1) {
        string t = al_expr_type(prog, curfn, e.a);
        if (t[0] == 0) { return ""; }
        return str_concat("*", t);
    }
    if (k == EK_UNARY && str_eq(e.sval, "*") == 1) {
        string t = al_expr_type(prog, curfn, e.a);
        if (t[0] == 0) { return ""; }
        return al_deref(t);
    }
    if (k == EK_MEMBER) {
        string bt = al_expr_type(prog, curfn, e.a);
        if (bt[0] == 0) { return ""; }
        string sn = al_deref(bt);
        List<string> targs; List_init<string>(&targs, 2); ast_targs(sn, &targs);
        int lt = 0; while (sn[lt] != 0 && (int)sn[lt] != 60) { lt = lt + 1; }
        *DeclNode sd = al_find_struct(prog, al_substr(sn, 0, lt));
        if (sd == null) { return ""; }
        int i = 0;
        while (i < List_len<Param>(&sd.params)) {
            Param f = List_get<Param>(&sd.params, i);
            if (str_eq(f.name, e.sval) == 1) { return al_subst(f.ty, &sd.type_params, &targs); }
            i = i + 1;
        }
        return "";
    }
    if (k == EK_CALL || k == EK_TEMPLATECALL) {
        int isa = 0;
        string rt = al_call_rettype(prog, curfn, e, &isa);
        if (rt[0] == 0) { return ""; }
        if (isa == 1) {
            if (str_eq(rt, "void") == 1) { rt = "uint8"; }
            return str_concat("*Future<", str_concat(rt, ">"));
        }
        return rt;
    }
    return "";
}

// Bind the type parameters of generic `d` by unifying its parameter types (from index
// `p0`) against the argument types of `args` (from index `a0`); `pre` holds bindings
// already known (or "" per parameter).
void al_infer_targs(*Program prog, *DeclNode curfn, *DeclNode d, List<*ExprNode>* args, int p0, int a0, List<string>* out) {
    int ti = 0;
    while (ti < List_len<TypeParam>(&d.type_params)) {
        string tp = List_get<TypeParam>(&d.type_params, ti).name;
        // Structural parameters first; by-value `T a` deductions meet at their common
        // integer type (as sema decides).
        int pass = 0;
        while (pass < 2 && List_get<string>(out, ti)[0] == 0) {
            int pi = p0; int ai = a0;
            while (pi < List_len<Param>(&d.params) && ai < List_len<*ExprNode>(args)) {
                int bare = 0; if (ast_streq(ast_unify_canon(List_get<Param>(&d.params, pi).ty), tp) == 1) { bare = 1; }
                string at = "";
                if (bare == pass) { at = al_expr_type(prog, curfn, List_get<*ExprNode>(args, ai)); }
                if (at[0] != 0 && ast_streq(at, "null") == 0) {
                    string b = ast_unify_tparam(List_get<Param>(&d.params, pi).ty, at, tp);
                    string cur = List_get<string>(out, ti);
                    if (b[0] != 0 && cur[0] == 0) { List_set<string>(out, ti, b); if (pass == 0) { break; } }
                    else if (b[0] != 0 && pass == 1 && ast_streq(cur, b) == 0) {
                        string common = ast_range_var_type(cur, b);
                        if (common[0] != 0) { List_set<string>(out, ti, common); }
                    }
                }
                pi = pi + 1; ai = ai + 1;
            }
            pass = pass + 1;
        }
        ti = ti + 1;
    }
}

// The declared return type (type parameters substituted) of the function a call `e`
// targets: a named function (generic ones infer their type arguments from the call's
// arguments), an explicit `name<args>(...)`, or a method call `recv.m(...)` (an inline
// method of the receiver's struct, `S_m`, or a generic free `S_m<T..>`). `*is_async`
// tells whether that function is `async` (its call then yields `*Future<ret>`). "" when
// the target is not found.
string al_call_rettype(*Program prog, *DeclNode curfn, *ExprNode e, int* is_async) {
    *is_async = 0;
    if (e.kind == EK_TEMPLATECALL) {
        string sp = e.sval;
        int lt = 0; while (sp[lt] != 0 && (int)sp[lt] != 60) { lt = lt + 1; }
        *DeclNode d = al_find_fn(prog, al_substr(sp, 0, lt));
        if (d == null) { return ""; }
        List<string> targs; List_init<string>(&targs, 2); ast_targs(sp, &targs);
        *is_async = d.is_async;
        return al_subst(d.ret_type, &d.type_params, &targs);
    }
    if (e.kind != EK_CALL || e.a == null) { return ""; }
    if (e.a.kind == EK_IDENT) {
        *DeclNode d = al_find_fn(prog, e.a.sval);
        if (d == null) { return ""; }
        *is_async = d.is_async;
        if (List_len<TypeParam>(&d.type_params) == 0) { return d.ret_type; }
        List<string> targs; List_init<string>(&targs, 2);
        int ti = 0; while (ti < List_len<TypeParam>(&d.type_params)) { List_push<string>(&targs, ""); ti = ti + 1; }
        al_infer_targs(prog, curfn, d, &e.kids, 0, 0, &targs);
        return al_subst(d.ret_type, &d.type_params, &targs);
    }
    if (e.a.kind == EK_MEMBER) {
        string rt = al_expr_type(prog, curfn, e.a.a);
        if (rt[0] == 0) { return ""; }
        string sn = al_deref(rt);
        string m = e.a.sval;
        int lt = 0; while (sn[lt] != 0 && (int)sn[lt] != 60) { lt = lt + 1; }
        string base = al_substr(sn, 0, lt);
        List<string> sargs; List_init<string>(&sargs, 2); ast_targs(sn, &sargs);
        *DeclNode sd = al_find_struct(prog, base);
        if (sd != null) {
            int mi = 0;
            while (mi < List_len<*DeclNode>(&sd.methods)) {
                *DeclNode md = List_get<*DeclNode>(&sd.methods, mi);
                if (str_eq(md.name, m) == 1) { *is_async = md.is_async; return al_subst(md.ret_type, &sd.type_params, &sargs); }
                mi = mi + 1;
            }
        }
        *DeclNode d = al_find_fn(prog, str_concat(base, str_concat("_", m)));
        if (d == null) { return ""; }
        *is_async = d.is_async;
        if (List_len<TypeParam>(&d.type_params) == 0) { return d.ret_type; }
        List<string> targs; List_init<string>(&targs, 2);
        int ti = 0; while (ti < List_len<TypeParam>(&d.type_params)) { List_push<string>(&targs, ""); ti = ti + 1; }
        if (List_len<Param>(&d.params) > 0) {
            string selfp = List_get<Param>(&d.params, 0).ty;
            string recv = sn;
            if ((int)selfp[0] == 42) { recv = str_concat("*", sn); }
            ti = 0;
            while (ti < List_len<TypeParam>(&d.type_params)) {
                List_set<string>(&targs, ti, ast_unify_tparam(selfp, recv, List_get<TypeParam>(&d.type_params, ti).name));
                ti = ti + 1;
            }
        }
        al_infer_targs(prog, curfn, d, &e.kids, 1, 0, &targs);
        return al_subst(d.ret_type, &d.type_params, &targs);
    }
    return "";
}

// The awaited value type of `await E` (source form, so inside a generic async function it
// is spelled with the type parameters): the inner `T` of E's `*Future<T>` type, where E
// is a call (an `async` callee yields its declared return type), a future variable, or a
// future field. "" when it cannot be resolved.
string al_await_type_or(*Program prog, *DeclNode curfn, *ExprNode awaited) {
    if (awaited == null) { return ""; }
    if (awaited.kind == EK_CALL || awaited.kind == EK_TEMPLATECALL) {
        int isa = 0;
        string rt = al_call_rettype(prog, curfn, awaited, &isa);
        if (rt[0] != 0) {
            if (isa == 1) {
                if (str_eq(rt, "void") == 1) { return "uint8"; }
                return rt;
            }
            return al_inner_of_future(rt);
        }
        return "";
    }
    string t = al_expr_type(prog, curfn, awaited);
    if (t[0] != 0) { return al_inner_of_future(t); }
    return "";
}
// As al_await_type_or, defaulting to "int".
string al_await_type(*Program prog, *DeclNode curfn, *ExprNode awaited) {
    string t = al_await_type_or(prog, curfn, awaited);
    if (t[0] == 0) { return "int"; }
    return t;
}

// Declared type of a variable name (a param or a body local) in statement subtree `s`.
string al_find_vartype(*StmtNode s, string name) {
    if (s == null) { return ""; }
    if (s.kind == SK_VARDECL && str_eq(s.name, name) == 1) { return s.type; }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_DOWHILE || s.kind == SK_DEFER || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_TRY) {
        string t = al_find_vartype(s.s1, name); if (t[0] != 0) { return t; }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR || s.kind == SK_TRY) { string t = al_find_vartype(s.s2, name); if (t[0] != 0) { return t; } }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { string t = al_find_vartype(List_get<*StmtNode>(&s.items, i), name); if (t[0] != 0) { return t; } i = i + 1; }
    }
    return "";
}
string al_var_type(*DeclNode curfn, string name) {
    int i = 0; while (i < List_len<Param>(&curfn.params)) { Param p = List_get<Param>(&curfn.params, i); if (str_eq(p.name, name) == 1) { return p.ty; } i = i + 1; }
    return al_find_vartype(curfn.body, name);
}

// Strip a leading/trailing '*' from a type (pointee), e.g. "*int" / "int*" → "int".
string al_deref(string t) {
    int n = 0; while (t[n] != 0) { n = n + 1; }
    if (n > 0 && (int)t[n - 1] == 42) { *uint8 b = alloc<uint8>(n); int k=0; while(k<n-1){b[k]=(uint8)t[k];k=k+1;} b[n-1]=0; return (string)b; }
    if ((int)t[0] == 42) { *uint8 b = alloc<uint8>(n); int k=1; while(k<n){b[k-1]=(uint8)t[k];k=k+1;} b[n-1]=0; return (string)b; }
    return t;
}
// Find a struct decl by name in the program (for list-like for-in: its `data` field type).
*DeclNode al_find_struct(*Program prog, string name) {
    int i = 0; while (i < List_len<*DeclNode>(&prog.decls)) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_STRUCT && str_eq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

// For a generic container instantiation like "List<double>", resolve the element
// type of its `data` field (`*T`) by substituting the type argument for the
// template's type parameter. Returns "" when `sn` is not a resolvable generic.
// Without this, an async `for (v in xs)` over a `List<T>` (T != int) defaulted the
// element type to `int` and miscompiled the loop body.
string al_generic_data_elem(*Program prog, string sn) {
    int lt = 0; while (sn[lt] != 0 && (int)sn[lt] != 60) { lt = lt + 1; }   // find '<'
    if (sn[lt] == 0) { return ""; }                                        // not generic
    string base = al_substr(sn, 0, lt);
    List<string> args; List_init<string>(&args, 2);
    int i = lt + 1; int start = i; int depth = 1;
    while (sn[i] != 0 && depth > 0) {
        int ch = (int)sn[i];
        if (ch == 60 || ch == 40) { depth = depth + 1; }             // '<' or '(' (nested generic / fn params)
        else if (ch == 41) { if (depth > 0) { depth = depth - 1; } }   // ')'
        else if (ch == 62 && (i == 0 || (int)sn[i - 1] != 45)) {      // '>' closing a generic, NOT the "->" arrow
            depth = depth - 1; if (depth == 0) { List_push<string>(&args, al_substr(sn, start, i)); }
        }
        else if (ch == 44 && depth == 1) { List_push<string>(&args, al_substr(sn, start, i)); start = i + 1; }
        i = i + 1;
    }
    *DeclNode sd = al_find_struct(prog, base);
    if (sd == null) { return ""; }
    string dft = "";
    int k = 0; while (k < List_len<Param>(&sd.params)) {
        Param p = List_get<Param>(&sd.params, k);
        if (str_eq(p.name, "data") == 1) { dft = p.ty; }
        k = k + 1;
    }
    if (dft[0] == 0) { return ""; }
    string elem = al_deref(dft);                                           // "*T" -> "T"
    int tpi = 0; while (tpi < List_len<TypeParam>(&sd.type_params)) {
        TypeParam tp = List_get<TypeParam>(&sd.type_params, tpi);
        if (str_eq(tp.name, elem) == 1 && tpi < List_len<string>(&args)) {
            return List_get<string>(&args, tpi);
        }
        tpi = tpi + 1;
    }
    return elem;                                                           // concrete data element
}

// ── The transform ─────────────────────────────────────────────────────────────
// Shared state-graph context, threaded by pointer through the recursive lowering.
struct AlCtx {
    *Program prog;
    string resumeN;
    List<string> vars;             // frame variable names (locals → fr.<name>)
    List<Param> fields;            // frame fields (per-await __awI appended during lowering)
    List<List<*StmtNode>> states;  // one statement list per state
    List<int> brk;                 // break-target states (innermost last)
    List<int> cont;                // continue-target states
    // `defer` in a state-split block: the block no longer exists as a real scope, so its
    // (rewritten) defer bodies are kept here, one frame per split block (innermost last),
    // and emitted LIFO at each exit: fall-through (the block's frame), `return` (every
    // frame), `break`/`continue` (frames above the target's depth, parallel to brk/cont).
    // errdefer only runs on a `?` error exit, which async lowering never produces.
    List<List<*StmtNode>> dfr;
    List<int> brk_dd;
    List<int> cont_dd;
    int awcount;                   // await counter → __aw0, __aw1, …
    int tmpn;                      // desugar temp counter → __awt0, …
    *DeclNode curfn;                  // the async function being lowered (for iterable type lookup)
    List<string>* used;            // every name in the function: synthesized names avoid them
}
int al_lower_seq(*AlCtx c, List<*StmtNode>* items, int entry);
int al_lower_stmt(*AlCtx c, *StmtNode s, int cur);
int al_stmt_has_await_deep(*StmtNode s);
*StmtNode al_rewrite_plain(*AlCtx c, *StmtNode s);
*StmtNode al_desugar_stmt(*AlCtx c, *StmtNode s);
void al_desugar_items(*AlCtx c, List<*StmtNode>* inp, List<*StmtNode>* out);
*ExprNode al_call_on(*ExprNode callee, List<*ExprNode>* args);
*ExprNode al_waker_noop();
*ExprNode al_ondrop();

int al_newst(*AlCtx c) {
    List<*StmtNode> s; List_init<*StmtNode>(&s, 8);
    List_push<List<*StmtNode>>(&c.states, s);
    return List_len<List<*StmtNode>>(&c.states) - 1;
}
// Append to states[st] (List_get copies the inner List, so write it back).
void al_push(*AlCtx c, int st, *StmtNode s) {
    List<*StmtNode> body = List_get<List<*StmtNode>>(&c.states, st);
    List_push<*StmtNode>(&body, s);
    List_set<List<*StmtNode>>(&c.states, st, body);
}
void al_goto(*AlCtx c, int st, int target) { al_push(c, st, al_assign(al_fr(al_fst), al_int(target))); }

// A two-way state dispatch: `if (cond) fr.st = thenE; else fr.st = elseE;` as one stmt.
// Shared by the if/while/for lowerings, whose only difference is the target states.
*StmtNode al_dispatch2(*ExprNode cond, int thenE, int elseE) {
    List<*StmtNode> tb; List_init<*StmtNode>(&tb, 1); List_push<*StmtNode>(&tb, al_assign(al_fr(al_fst), al_int(thenE)));
    List<*StmtNode> eb; List_init<*StmtNode>(&eb, 1); List_push<*StmtNode>(&eb, al_assign(al_fr(al_fst), al_int(elseE)));
    return al_if(cond, al_block(&tb), al_block(&eb));
}

// Enter/leave a loop for break/continue lowering: push (pop) this loop's break and
// continue target states, kept in sync on the two parallel stacks.
void al_enter_loop(*AlCtx c, int brk, int cont) {
    List_push<int>(&c.brk, brk); List_push<int>(&c.cont, cont);
    int dd = List_len<List<*StmtNode>>(&c.dfr);
    List_push<int>(&c.brk_dd, dd); List_push<int>(&c.cont_dd, dd);
}
void al_leave_loop(*AlCtx c) {
    List_remove<int>(&c.brk, List_len<int>(&c.brk) - 1);
    List_remove<int>(&c.cont, List_len<int>(&c.cont) - 1);
    List_remove<int>(&c.brk_dd, List_len<int>(&c.brk_dd) - 1);
    List_remove<int>(&c.cont_dd, List_len<int>(&c.cont_dd) - 1);
}

// Append the pending split-block defer bodies of frames >= downTo to `out`, LIFO.
void al_emit_defers(*AlCtx c, List<*StmtNode>* out, int downTo) {
    int f = List_len<List<*StmtNode>>(&c.dfr) - 1;
    while (f >= downTo) {
        List<*StmtNode> fr = List_get<List<*StmtNode>>(&c.dfr, f);
        int k = List_len<*StmtNode>(&fr) - 1;
        while (k >= 0) { List_push<*StmtNode>(out, List_get<*StmtNode>(&fr, k)); k = k - 1; }
        f = f - 1;
    }
}
void al_emit_defers_st(*AlCtx c, int st, int downTo) {
    List<*StmtNode> items; List_init<*StmtNode>(&items, 4);
    al_emit_defers(c, &items, downTo);
    int i = 0; while (i < List_len<*StmtNode>(&items)) { al_push(c, st, List_get<*StmtNode>(&items, i)); i = i + 1; }
}

// The completion sequence (fr.ret.value = v; if(atomic_swap(&fr.ret.state,2)==1) fr.ret.waker(); return;)
void al_completion_items(*AlCtx c, *ExprNode v, List<*StmtNode>* out) {
    List_push<*StmtNode>(out, al_assign(al_member(al_fr(al_fret), "value"), v));
    al_emit_defers(c, out, 0);                       // pending defers, before publishing
    List<*ExprNode> sa; List_init<*ExprNode>(&sa, 2);
    List_push<*ExprNode>(&sa, mk_un("&", al_member(al_fr(al_fret), "state"))); List_push<*ExprNode>(&sa, al_int(2));
    *ExprNode swap = al_call("atomic_swap", &sa);
    List<*StmtNode> wk; List_init<*StmtNode>(&wk, 1);
    List<*ExprNode> wa; List_init<*ExprNode>(&wa, 1);
    List_push<*StmtNode>(&wk, al_exprstmt(al_call_on(al_member(al_fr(al_fret), "waker"), &wa)));
    List_push<*StmtNode>(out, al_if(mk_bin("==", swap, al_int(1)), al_block(&wk), null));
    List_push<*StmtNode>(out, al_return(null));
}
void al_complete(*AlCtx c, int st, *ExprNode v) {
    List<*StmtNode> items; List_init<*StmtNode>(&items, 3);
    al_completion_items(c, v, &items);
    int i = 0; while (i < List_len<*StmtNode>(&items)) { al_push(c, st, List_get<*StmtNode>(&items, i)); i = i + 1; }
}
*StmtNode al_complete_block(*AlCtx c, *ExprNode v) {
    List<*StmtNode> items; List_init<*StmtNode>(&items, 3);
    al_completion_items(c, v, &items);
    return al_block(&items);
}

// Does control definitely leave this statement (return on every path)?
int al_terminates(*StmtNode s) {
    if (s == null) { return 0; }
    if (s.kind == SK_RETURN || s.kind == SK_THROW) { return 1; }
    if (s.kind == SK_BLOCK) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { if (al_terminates(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    if (s.kind == SK_IF) { return s.s2 != null && al_terminates(s.s1) == 1 && al_terminates(s.s2) == 1; }
    return 0;
}
// A break/continue binding to an ENCLOSING loop (not shadowed by a nested loop/switch)?
int al_loop_escapes(*StmtNode s) {
    if (s == null) { return 0; }
    if (s.kind == SK_BREAK || s.kind == SK_CONTINUE) { return 1; }
    if (s.kind == SK_BLOCK) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { if (al_loop_escapes(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    if (s.kind == SK_IF) { return al_loop_escapes(s.s1) == 1 || al_loop_escapes(s.s2) == 1; }
    return 0;
}

// `let x = E` of a hoisted local: `fr.x = E`. An array literal `{...}` is only a
// variable initializer, so it fills a temporary that is then copied to the field.
*StmtNode al_init_field(*AlCtx c, *StmtNode vd) {
    al_rewrite(vd.expr, &c.vars);
    if (vd.expr.kind != EK_ARRAYLIT) { return al_assign(al_fr(vd.name), vd.expr); }
    string tn = fresh_name(str_concat("__init_t", int_to_str(c.tmpn)), c.used); c.tmpn = c.tmpn + 1;
    List<*StmtNode> blk; List_init<*StmtNode>(&blk, 2);
    List_push<*StmtNode>(&blk, mk_vardecl(tn, vd.type, vd.expr, 0));
    List_push<*StmtNode>(&blk, al_assign(al_fr(vd.name), mk_ident(tn)));
    return al_block(&blk);
}

// Rewrite a NO-await statement for inclusion in a state (locals→fr, return→completion).
*StmtNode al_rewrite_plain(*AlCtx c, *StmtNode s) {
    if (s == null) { return s; }
    if (s.kind == SK_BLOCK) {
        List<*StmtNode> out; List_init<*StmtNode>(&out, 8);
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            *StmtNode it = List_get<*StmtNode>(&s.items, i); i = i + 1;
            if (it.kind == SK_VARDECL) {
                if (it.expr != null) { List_push<*StmtNode>(&out, al_init_field(c, it)); }
            } else { List_push<*StmtNode>(&out, al_rewrite_plain(c, it)); }
        }
        return al_block(&out);
    }
    if (s.kind == SK_TRY || s.kind == SK_MATCH) {
        // try: s1 body, items = catch clauses (s1 each), s2 finally. match: expr subject,
        // items = arms (s1 each). Rewritten in place.
        al_rewrite(s.expr, &c.vars);
        s.s1 = al_rewrite_plain(c, s.s1); s.s2 = al_rewrite_plain(c, s.s2);
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cl = List_get<*StmtNode>(&s.items, k); k = k + 1;
            cl.s1 = al_rewrite_plain(c, cl.s1);
        }
        return s;
    }
    if (s.kind == SK_RETURN) {
        *ExprNode v = s.expr; if (v == null) { v = al_int(0); } al_rewrite(v, &c.vars);
        return al_complete_block(c, v);
    }
    if (s.kind == SK_EXPR) { al_rewrite(s.expr, &c.vars); return s; }
    if (s.kind == SK_IF) {
        al_rewrite(s.expr, &c.vars);
        return al_if(s.expr, al_rewrite_plain(c, s.s1), al_rewrite_plain(c, s.s2));
    }
    if (s.kind == SK_WHILE) { al_rewrite(s.expr, &c.vars); return al_while(s.expr, al_rewrite_plain(c, s.s1)); }
    if (s.kind == SK_DOWHILE) { al_rewrite(s.expr, &c.vars); return al_dowhile(al_rewrite_plain(c, s.s1), s.expr); }
    if (s.kind == SK_DEFER) { return al_defer(al_rewrite_plain(c, s.s1), s.is_err); }
    if (s.kind == SK_THROW) { al_rewrite(s.expr, &c.vars); return s; }
    if (s.kind == SK_FOR) {
        *StmtNode in2 = al_rewrite_plain(c, s.s1);
        al_rewrite(s.expr, &c.vars); al_rewrite(s.expr2, &c.vars);
        return al_for(in2, s.expr, s.expr2, al_rewrite_plain(c, s.s2));
    }
    if (s.kind == SK_SWITCH) {
        al_rewrite(s.expr, &c.vars);
        List<*StmtNode> ncases; List_init<*StmtNode>(&ncases, 4);
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k); k = k + 1;
            al_rewrite(cs.expr, &c.vars);
            List<*StmtNode> nb; List_init<*StmtNode>(&nb, 4);
            int j = 0;
            while (j < List_len<*StmtNode>(&cs.items)) {
                *StmtNode ci = List_get<*StmtNode>(&cs.items, j); j = j + 1;
                if (ci.kind == SK_VARDECL) {           // a case's declaration (C scoping)
                    if (ci.expr != null) { List_push<*StmtNode>(&nb, al_init_field(c, ci)); }
                } else { List_push<*StmtNode>(&nb, al_rewrite_plain(c, ci)); }
            }
            List_push<*StmtNode>(&ncases, al_case(cs.expr, &nb));
        }
        return al_switch(s.expr, &ncases);
    }
    return s;     // break/continue/etc.
}

// Lower a top-level item (a decl or stmt) at state `cur`; returns the continuation state.
int al_lower_item(*AlCtx c, *StmtNode s, int cur) {
    if (s.kind == SK_VARDECL) {
        if (s.expr == null) { return cur; }
        if (s.expr.kind == EK_AWAIT) {
            int idx = c.awcount; c.awcount = idx + 1;
            string awf = fresh_name(str_concat("__aw", int_to_str(idx)), c.used);
            // The future's value type, as the C++ transform uses it; when it cannot be
            // resolved, the declared type of the let variable (`let x: T = await E`).
            string Ti = al_await_type_or(c.prog, c.curfn, s.expr.a);
            if (Ti[0] == 0) { Ti = s.type; }
            if (Ti == null || Ti[0] == 0) { Ti = "int"; }
            let af: Param; af.name = awf; af.ty = str_concat("*Future<", str_concat(Ti, ">")); List_push<Param>(&c.fields, af);
            *ExprNode callE = s.expr.a; al_rewrite(callE, &c.vars);
            al_push(c, cur, al_assign(al_fr(awf), callE));
            int next = al_newst(c);
            List<*ExprNode> pa; List_init<*ExprNode>(&pa, 2);
            List_push<*ExprNode>(&pa, al_fr(awf)); List_push<*ExprNode>(&pa, al_waker(c.resumeN, next));
            *ExprNode poll = al_tcall(str_concat("future_poll<", str_concat(Ti, ">")), &pa);
            List<*StmtNode> pk; List_init<*StmtNode>(&pk, 2);
            List_push<*StmtNode>(&pk, al_assign(al_fr(al_fawt), mk_cast("*FutureHdr", al_fr(awf))));
            List_push<*StmtNode>(&pk, al_return(null));
            al_push(c, cur, al_if(mk_bin("==", poll, al_int(0)), al_block(&pk), null));
            al_goto(c, cur, next);
            al_push(c, next, al_assign(al_fr(al_fawt), mk_cast("*FutureHdr", al_int(0))));
            al_push(c, next, al_assign(al_fr(s.name), al_member(al_fr(awf), "value")));
            List<*ExprNode> fa; List_init<*ExprNode>(&fa, 1); List_push<*ExprNode>(&fa, al_fr(awf));
            al_push(c, next, al_exprstmt(al_tcall(str_concat("free_future<", str_concat(Ti, ">")), &fa)));
            return next;
        }
        al_push(c, cur, al_init_field(c, s));
        return cur;
    }
    return al_lower_stmt(c, s, cur);
}

int al_lower_seq(*AlCtx c, List<*StmtNode>* items, int entry) {
    int cur = entry;
    List<*StmtNode> frame; List_init<*StmtNode>(&frame, 2);
    List_push<List<*StmtNode>>(&c.dfr, frame);     // this split block's defers
    int top = List_len<List<*StmtNode>>(&c.dfr) - 1;
    int i = 0;
    while (i < List_len<*StmtNode>(items)) {
        if (cur == 0 - 1) { break; }             // rest unreachable
        *StmtNode it = List_get<*StmtNode>(items, i); i = i + 1;
        if (it.kind == SK_DEFER) {
            if (it.is_err == 0) {
                List<*StmtNode> fr = List_get<List<*StmtNode>>(&c.dfr, top);
                List_push<*StmtNode>(&fr, al_rewrite_plain(c, it.s1));
                List_set<List<*StmtNode>>(&c.dfr, top, fr);
            }
            continue;
        }
        cur = al_lower_item(c, it, cur);
    }
    if (cur != 0 - 1) { al_emit_defers_st(c, cur, top); }   // fall-through exit
    List_remove<List<*StmtNode>>(&c.dfr, top);
    return cur;
}

// Lower a statement that may contain an await into the state graph.
int al_lower_stmt(*AlCtx c, *StmtNode s, int cur) {
    if (s.kind == SK_RETURN) {
        *ExprNode v = s.expr; if (v == null) { v = al_int(0); } al_rewrite(v, &c.vars);
        al_complete(c, cur, v); return 0 - 1;
    }
    if (s.kind == SK_BREAK) {
        al_emit_defers_st(c, cur, List_get<int>(&c.brk_dd, List_len<int>(&c.brk_dd) - 1));
        al_goto(c, cur, List_get<int>(&c.brk, List_len<int>(&c.brk) - 1)); return 0 - 1;
    }
    if (s.kind == SK_CONTINUE) {
        al_emit_defers_st(c, cur, List_get<int>(&c.cont_dd, List_len<int>(&c.cont_dd) - 1));
        al_goto(c, cur, List_get<int>(&c.cont, List_len<int>(&c.cont) - 1)); return 0 - 1;
    }
    // No await and no escaping break/continue → emit verbatim in this state.
    if (al_stmt_has_await_deep(s) == 0 && al_loop_escapes(s) == 0) {
        al_push(c, cur, al_rewrite_plain(c, s));
        if (al_terminates(s) == 1) { return 0 - 1; }
        return cur;
    }
    if (s.kind == SK_IF) {
        al_rewrite(s.expr, &c.vars);
        int thenE = al_newst(c); int elseE = al_newst(c); int join = al_newst(c);
        al_push(c, cur, al_dispatch2(s.expr, thenE, elseE));
        int te = al_lower_stmt(c, s.s1, thenE);
        int ee = elseE; if (s.s2 != null) { ee = al_lower_stmt(c, s.s2, elseE); }
        if (te != 0 - 1) { al_goto(c, te, join); }
        if (ee != 0 - 1) { al_goto(c, ee, join); }
        if (te == 0 - 1 && ee == 0 - 1) { return 0 - 1; }
        return join;
    }
    if (s.kind == SK_WHILE) {
        al_rewrite(s.expr, &c.vars);
        int header = al_newst(c); int bodyE = al_newst(c); int after = al_newst(c);
        al_goto(c, cur, header);
        al_push(c, header, al_dispatch2(s.expr, bodyE, after));
        al_enter_loop(c, after, header);
        int be = al_lower_stmt(c, s.s1, bodyE);
        al_leave_loop(c);
        if (be != 0 - 1) { al_goto(c, be, header); }
        return after;
    }
    if (s.kind == SK_DOWHILE) {
        // do body while (cond): body first, then test(cond) → body | after. The test is
        // its own state so `continue` re-tests the condition (C semantics).
        al_rewrite(s.expr, &c.vars);
        int bodyE = al_newst(c); int test = al_newst(c); int after = al_newst(c);
        al_goto(c, cur, bodyE);
        al_push(c, test, al_dispatch2(s.expr, bodyE, after));
        al_enter_loop(c, after, test);
        int be = al_lower_stmt(c, s.s1, bodyE);
        al_leave_loop(c);
        if (be != 0 - 1) { al_goto(c, be, test); }
        return after;
    }
    if (s.kind == SK_FOR) {
        if (s.s1 != null) { al_push(c, cur, al_rewrite_plain(c, s.s1)); }    // init
        int header = al_newst(c); int bodyE = al_newst(c); int step = al_newst(c); int after = al_newst(c);
        al_goto(c, cur, header);
        if (s.expr != null) {
            al_rewrite(s.expr, &c.vars);
            al_push(c, header, al_dispatch2(s.expr, bodyE, after));
        } else { al_goto(c, header, bodyE); }
        if (s.expr2 != null) { al_rewrite(s.expr2, &c.vars); al_push(c, step, al_exprstmt(s.expr2)); }
        al_goto(c, step, header);
        al_enter_loop(c, after, step);
        int be = al_lower_stmt(c, s.s2, bodyE);
        al_leave_loop(c);
        if (be != 0 - 1) { al_goto(c, be, step); }
        return after;
    }
    if (s.kind == SK_SWITCH) {
        // Dispatch on the subject in `cur` (if subj==Vk → st=entry[k], else default), then
        // each case is a state with C-style fall-through; break → join.
        al_rewrite(s.expr, &c.vars);
        int nc = List_len<*StmtNode>(&s.items);
        List<int> entry; List_init<int>(&entry, nc);
        int k = 0; while (k < nc) { List_push<int>(&entry, al_newst(c)); k = k + 1; }
        int join = al_newst(c);
        int dflt = join;
        k = 0; while (k < nc) { if (List_get<*StmtNode>(&s.items, k).expr == null) { dflt = List_get<int>(&entry, k); } k = k + 1; }
        // Build the dispatch chain bottom-up: ...else { st = dflt }
        *StmtNode chain = al_assign(al_fr(al_fst), al_int(dflt));
        k = nc - 1;
        while (k >= 0) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k);
            if (cs.expr != null) {
                al_rewrite(cs.expr, &c.vars);
                List<*StmtNode> tb; List_init<*StmtNode>(&tb, 1); List_push<*StmtNode>(&tb, al_assign(al_fr(al_fst), al_int(List_get<int>(&entry, k))));
                List<*StmtNode> eb; List_init<*StmtNode>(&eb, 1); List_push<*StmtNode>(&eb, chain);
                chain = al_if(mk_bin("==", s.expr, cs.expr), al_block(&tb), al_block(&eb));
            }
            k = k - 1;
        }
        al_push(c, cur, chain);
        List_push<int>(&c.brk, join);
        List_push<int>(&c.brk_dd, List_len<List<*StmtNode>>(&c.dfr));
        k = 0;
        while (k < nc) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k);
            int e = al_lower_seq(c, &cs.items, List_get<int>(&entry, k));
            if (e != 0 - 1) {                            // fall through to the next case (or join)
                if (k + 1 < nc) { al_goto(c, e, List_get<int>(&entry, k + 1)); } else { al_goto(c, e, join); }
            }
            k = k + 1;
        }
        List_remove<int>(&c.brk, List_len<int>(&c.brk) - 1);
        List_remove<int>(&c.brk_dd, List_len<int>(&c.brk_dd) - 1);
        return join;
    }
    if (s.kind == SK_BLOCK) { return al_lower_seq(c, &s.items, cur); }
    return cur;     // unsupported await container — should be filtered by al_can_lower
}

// ── Desugar: make every await the whole initializer of a `let` ────────────────
//   return await E;  →  let __awtN = await E; return __awtN;
//   await E;         →  let __awtN = await E;                 (value discarded)
//   x = await E;     →  let __awtN = await E; x = __awtN;
// Recurses into if/while/for bodies so awaits in control flow are normalized too.
void al_desugar_items(*AlCtx c, List<*StmtNode>* inp, List<*StmtNode>* out) {
    int i = 0;
    while (i < List_len<*StmtNode>(inp)) {
        *StmtNode s = List_get<*StmtNode>(inp, i); i = i + 1;
        if (s.kind == SK_RETURN && s.expr != null && s.expr.kind == EK_AWAIT) {
            string tn = fresh_name(str_concat("__awt", int_to_str(c.tmpn)), c.used); c.tmpn = c.tmpn + 1;
            string Ti = al_await_type(c.prog, c.curfn, s.expr.a);
            List_push<*StmtNode>(out, mk_vardecl(tn, Ti, s.expr, 0));
            List_push<*StmtNode>(out, al_return(mk_ident(tn)));
        } else if (s.kind == SK_EXPR && s.expr != null && s.expr.kind == EK_AWAIT) {
            string tn = fresh_name(str_concat("__awt", int_to_str(c.tmpn)), c.used); c.tmpn = c.tmpn + 1;
            List_push<*StmtNode>(out, mk_vardecl(tn, al_await_type(c.prog, c.curfn, s.expr.a), s.expr, 0));
        } else if (s.kind == SK_EXPR && s.expr != null && s.expr.kind == EK_BINARY
                   && str_eq(s.expr.sval, "=") == 1 && s.expr.b != null && s.expr.b.kind == EK_AWAIT) {
            string tn = fresh_name(str_concat("__awt", int_to_str(c.tmpn)), c.used); c.tmpn = c.tmpn + 1;
            List_push<*StmtNode>(out, mk_vardecl(tn, al_await_type(c.prog, c.curfn, s.expr.b.a), s.expr.b, 0));
            List_push<*StmtNode>(out, al_exprstmt(mk_bin("=", s.expr.a, mk_ident(tn))));
        } else {
            List_push<*StmtNode>(out, al_desugar_stmt(c, s));
        }
    }
}
*StmtNode al_desugar_stmt(*AlCtx c, *StmtNode s) {
    if (s == null) { return s; }
    if (s.kind == SK_BLOCK) {
        List<*StmtNode> out; List_init<*StmtNode>(&out, 8);
        al_desugar_items(c, &s.items, &out);
        return al_block(&out);
    }
    if (s.kind == SK_IF) {
        *StmtNode e2 = null; if (s.s2 != null) { e2 = al_desugar_stmt(c, s.s2); }
        return al_if(s.expr, al_desugar_stmt(c, s.s1), e2);
    }
    if (s.kind == SK_WHILE) { return al_while(s.expr, al_desugar_stmt(c, s.s1)); }
    if (s.kind == SK_DOWHILE) { return al_dowhile(al_desugar_stmt(c, s.s1), s.expr); }
    if (s.kind == SK_FOR) { return al_for(s.s1, s.expr, s.expr2, al_desugar_stmt(c, s.s2)); }
    if (s.kind == SK_FORIN) {
        // Desugar `for (v in it)` into a counted C-for, then let the for-lowering handle the
        // await + break/continue. Array `T[N]`: `it[i]`, length N. List-like struct (with
        // `data`/`size`): `it.data[i]`, length `it.size`. The iterable is an ident here.
        string itname = ""; if (s.expr != null && s.expr.kind == EK_IDENT) { itname = s.expr.sval; }
        string ty = al_var_type(c.curfn, itname);
        string fi = fresh_name(str_concat("__fi", int_to_str(c.tmpn)), c.used); c.tmpn = c.tmpn + 1;
        List<*StmtNode> initb; List_init<*StmtNode>(&initb, 2);
        if (itname[0] == 0 && s.resolved_iter != null && s.resolved_iter[0] != 0) {
            // Any other iterable (a call) is evaluated once, into a local the loop reads.
            itname = fresh_name(str_concat(fi, "_v"), c.used);
            ty = s.resolved_iter;
            List_push<*StmtNode>(&initb, mk_vardecl(itname, ty, s.expr, 0));
        }
        string elemTy = "int"; *ExprNode lengthE = al_int(0); *ExprNode elemE = al_int(0);
        int br = 0; int tn2 = 0; while (ty[tn2] != 0) { if ((int)ty[tn2] == 91) { br = tn2; } tn2 = tn2 + 1; }   // '['
        if (br > 0) {                                  // array "T[N]"
            elemTy = al_substr(ty, 0, br);             // before '['
            int e2 = br + 1; int s2 = e2; while (ty[e2] != 0 && (int)ty[e2] != 93) { e2 = e2 + 1; }
            if (e2 == s2) { lengthE = al_member(mk_ident(itname), "len"); }   // a slice `T[]`
            else { lengthE = mk_lit(LIT_INT, al_substr(ty, s2, e2)); }
            elemE = al_index(mk_ident(itname), mk_ident(fi));
        } else {                                       // list-like struct (data/size)
            string sn = al_deref(ty);
            string gelem = al_generic_data_elem(c.prog, sn);   // generic List<T>: substitute T
            if (gelem[0] != 0) {
                elemTy = gelem;
            } else {
                *DeclNode sd = al_find_struct(c.prog, sn);
                if (sd != null) {
                    int k = 0; while (k < List_len<Param>(&sd.params)) { Param p = List_get<Param>(&sd.params, k); if (str_eq(p.name, "data") == 1) { elemTy = al_deref(p.ty); } k = k + 1; }
                }
            }
            lengthE = al_member(mk_ident(itname), "size");
            elemE = al_index(al_member(mk_ident(itname), "data"), mk_ident(fi));
        }
        List_push<*StmtNode>(&initb, mk_vardecl(fi, "int", al_int(0), 0));
        *ExprNode cond = mk_bin("<", mk_ident(fi), lengthE);
        *ExprNode step = mk_bin("=", mk_ident(fi), mk_bin("+", mk_ident(fi), al_int(1)));
        if (s.resolved_elem[0] != 0) { elemTy = s.resolved_elem; }   // prefer the sema-stamped type (R1)
        List<*StmtNode> body; List_init<*StmtNode>(&body, 2);
        List_push<*StmtNode>(&body, mk_vardecl(s.name, elemTy, elemE, 0));
        List_push<*StmtNode>(&body, al_desugar_stmt(c, s.s1));
        return al_for(al_block(&initb), cond, step, al_block(&body));
    }
    if (s.kind == SK_SWITCH) {
        List<*StmtNode> ncases; List_init<*StmtNode>(&ncases, 4);
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k); k = k + 1;
            List<*StmtNode> nb; List_init<*StmtNode>(&nb, 4);
            al_desugar_items(c, &cs.items, &nb);
            List_push<*StmtNode>(&ncases, al_case(cs.expr, &nb));
        }
        return al_switch(s.expr, &ncases);
    }
    return s;
}

// Recursively register body locals (vardecls anywhere) as frame fields.
void al_scan_locals(*AlCtx c, *StmtNode s) {
    if (s == null) { return; }
    if (s.kind == SK_VARDECL) {
        if (al_in(&c.vars, s.name) == 0) {
            List_push<string>(&c.vars, s.name);
            let lf: Param; lf.name = s.name; lf.ty = s.type; List_push<Param>(&c.fields, lf);
        }
        return;
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_DOWHILE
        || s.kind == SK_DEFER || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_TRY) { al_scan_locals(c, s.s1); }
    if (s.kind == SK_IF || s.kind == SK_FOR || s.kind == SK_TRY) { al_scan_locals(c, s.s2); }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { al_scan_locals(c, List_get<*StmtNode>(&s.items, i)); i = i + 1; }
    }
}

// ── Lambdas capturing a frame-hoisted local ────────────────────────────────────
// The resume function has no local of that name (it lives in `fr.<name>`, and al_rewrite
// stops at a lambda), so each statement whose own expressions create such a lambda is
// wrapped as `{ T x = fr.x; <stmt> }`: a by-value snapshot at the creation point, exactly
// what the closure's capture takes. Mirrors the C++ AsyncTransform wrapCaps pass.
void al_collect_idents_s(*StmtNode s, List<string>* out);
void al_collect_idents_e(*ExprNode e, List<string>* out) {
    if (e == null) { return; }
    if (e.kind == EK_IDENT) { List_push<string>(out, e.sval); return; }
    if (e.kind == EK_LAMBDA) { al_collect_idents_s(e.stmt, out); return; }
    List<*ExprNode> ch; List_init<*ExprNode>(&ch, 4); al_children(e, &ch);
    int i = 0; while (i < List_len<*ExprNode>(&ch)) { al_collect_idents_e(List_get<*ExprNode>(&ch, i), out); i = i + 1; }
}
void al_collect_idents_s(*StmtNode s, List<string>* out) {
    if (s == null) { return; }
    al_collect_idents_e(s.expr, out);
    al_collect_idents_e(s.expr2, out);
    al_collect_idents_s(s.s1, out);
    al_collect_idents_s(s.s2, out);
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { al_collect_idents_s(List_get<*StmtNode>(&s.items, i), out); i = i + 1; }
    }
}
// Parameter names of a lambda signature `int(int y, fn(int)->int g)` → ["y", "g"].
void al_lambda_params(string sig, List<string>* out) {
    int i = 0; while (sig[i] != 0 && (int)sig[i] != 40) { i = i + 1; }   // to '('
    if (sig[i] == 0) { return; }
    i = i + 1;
    int depth = 1; int start = i;
    while (sig[i] != 0 && depth > 0) {
        int ch = (int)sig[i];
        if (ch == 40) { depth = depth + 1; }
        else if (ch == 41) { depth = depth - 1; }
        if ((ch == 44 && depth == 1) || depth == 0) {
            int e = i; while (e > start && (int)sig[e - 1] == 32) { e = e - 1; }
            int b = e; while (b > start && (int)sig[b - 1] != 32) { b = b - 1; }
            if (e > b) { List_push<string>(out, al_substr(sig, b, e)); }
            start = i + 1;
        }
        i = i + 1;
    }
}
void al_lambda_caps(*AlCtx c, *ExprNode e, List<string>* caps) {
    if (e == null) { return; }
    if (e.kind == EK_LAMBDA) {
        List<string> ids; List_init<string>(&ids, 8); al_collect_idents_s(e.stmt, &ids);
        List<string> ps; List_init<string>(&ps, 2); al_lambda_params(e.sval, &ps);
        int i = 0;
        while (i < List_len<string>(&ids)) {
            string nm = List_get<string>(&ids, i); i = i + 1;
            if (al_in(&c.vars, nm) == 1 && al_in(&ps, nm) == 0 && al_in(caps, nm) == 0) { List_push<string>(caps, nm); }
        }
        return;
    }
    List<*ExprNode> ch; List_init<*ExprNode>(&ch, 4); al_children(e, &ch);
    int i = 0; while (i < List_len<*ExprNode>(&ch)) { al_lambda_caps(c, List_get<*ExprNode>(&ch, i), caps); i = i + 1; }
}
string al_field_type(*AlCtx c, string nm) {
    int i = 0; while (i < List_len<Param>(&c.fields)) { Param f = List_get<Param>(&c.fields, i); if (str_eq(f.name, nm) == 1) { return f.ty; } i = i + 1; }
    return "int";
}
*StmtNode al_wrap_caps(*AlCtx c, *StmtNode s) {
    if (s == null) { return s; }
    if (s.kind == SK_BLOCK) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { List_set<*StmtNode>(&s.items, i, al_wrap_caps(c, List_get<*StmtNode>(&s.items, i))); i = i + 1; }
        return s;
    }
    List<string> caps; List_init<string>(&caps, 2);
    if (s.kind == SK_SWITCH || s.kind == SK_MATCH) {
        al_lambda_caps(c, s.expr, &caps);
        int i = 0;
        while (i < List_len<*StmtNode>(&s.items)) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, i); i = i + 1;
            if (s.kind == SK_SWITCH) {
                al_lambda_caps(c, cs.expr, &caps);
                int j = 0; while (j < List_len<*StmtNode>(&cs.items)) { List_set<*StmtNode>(&cs.items, j, al_wrap_caps(c, List_get<*StmtNode>(&cs.items, j))); j = j + 1; }
            } else { cs.s1 = al_wrap_caps(c, cs.s1); }
        }
    } else {
        // Every other kind: its own expressions (cond / step / value / initializer) and
        // its nested statements (then/else, body, for-init, defer body).
        al_lambda_caps(c, s.expr, &caps);
        al_lambda_caps(c, s.expr2, &caps);
        s.s1 = al_wrap_caps(c, s.s1);
        s.s2 = al_wrap_caps(c, s.s2);
    }
    if (List_len<string>(&caps) == 0) { return s; }
    List<*StmtNode> blk; List_init<*StmtNode>(&blk, 4);
    int k = 0;
    while (k < List_len<string>(&caps)) {
        string nm = List_get<string>(&caps, k); k = k + 1;
        List_push<*StmtNode>(&blk, mk_vardecl(nm, al_field_type(c, nm), al_fr(nm), 0));
    }
    List_push<*StmtNode>(&blk, s);
    return al_block(&blk);
}

// Every local becomes a frame field keyed by its name, so two declarations of one name
// (a nested-block `let x` shadowing an outer `x`, or two sibling blocks each declaring
// `x`) would collapse into one field. Before hoisting, give every re-declaration a
// unique name (`x__sN`) and rewrite the references in its lexical scope (mirrors the
// C++ ShadowRenamer). keys/vals is a scope stack of name → current spelling.
// `static` locals of the async function itself (not of a lambda in it) are one cell for
// every call, not frame fields: each gets a fresh name and is taken out of the body
// (`statics`); the lowering declares them at the top of the resume function.
struct AlRen { List<string> keys; List<string> vals; List<string> seen; List<string>* used; List<*StmtNode> statics; int ldepth; }

string al_ren_lookup(AlRen* r, string n) {
    int i = List_len<string>(&r.keys) - 1;
    while (i >= 0) { if (str_eq(List_get<string>(&r.keys, i), n) == 1) { return List_get<string>(&r.vals, i); } i = i - 1; }
    return n;
}
void al_ren_bind(AlRen* r, string n, string v) { List_push<string>(&r.keys, n); List_push<string>(&r.vals, v); }
string al_ren_declare(AlRen* r, string n) {
    string nn = n;
    if (al_in(&r.seen, n) == 1) { nn = fresh_name(str_concat(n, "__s"), r.used); }
    else { List_push<string>(&r.seen, n); }
    al_ren_bind(r, n, nn);
    return nn;
}
void al_ren_pop(AlRen* r, int mark) {
    while (List_len<string>(&r.keys) > mark) {
        List_remove<string>(&r.keys, List_len<string>(&r.keys) - 1);
        List_remove<string>(&r.vals, List_len<string>(&r.vals) - 1);
    }
}
void al_ren_stmt(AlRen* r, *StmtNode s);
void al_ren_expr(AlRen* r, *ExprNode e) {
    if (e == null) { return; }
    if (e.kind == EK_SIZEOF && e.a != null) { al_ren_expr(r, e.a); return; }   // sizeof(expr)
    if (e.kind == EK_IDENT || e.kind == EK_SIZEOF) { e.sval = al_ren_lookup(r, e.sval); return; }
    if (e.kind == EK_LAMBDA) {                           // body follows renames; params shadow
        int lmark = List_len<string>(&r.keys);
        List<string> lps; List_init<string>(&lps, 2); al_lambda_params(e.sval, &lps);
        int li = 0; while (li < List_len<string>(&lps)) { al_ren_bind(r, List_get<string>(&lps, li), List_get<string>(&lps, li)); li = li + 1; }
        r.ldepth = r.ldepth + 1;
        al_ren_stmt(r, e.stmt);
        r.ldepth = r.ldepth - 1;
        al_ren_pop(r, lmark);
        return;
    }
    if (e.kind == EK_MEMBER) { al_ren_expr(r, e.a); return; }   // sval is the field name
    al_ren_expr(r, e.a); al_ren_expr(r, e.b);
    int i = 0; while (i < List_len<*ExprNode>(&e.kids)) { al_ren_expr(r, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
}
void al_ren_scoped(AlRen* r, *StmtNode s) {
    int mark = List_len<string>(&r.keys); al_ren_stmt(r, s); al_ren_pop(r, mark);
}
void al_ren_items(AlRen* r, List<*StmtNode>* items) {
    List<*StmtNode> kept; List_init<*StmtNode>(&kept, List_len<*StmtNode>(items) + 1);
    int i = 0;
    while (i < List_len<*StmtNode>(items)) {
        *StmtNode it = List_get<*StmtNode>(items, i); i = i + 1;
        if (it.kind == SK_VARDECL && it.is_static == 1 && r.ldepth == 0) {
            al_ren_expr(r, it.expr);
            string nn = fresh_name(str_concat(it.name, "__st"), r.used);
            if (al_in(&r.seen, it.name) == 0) { List_push<string>(&r.seen, it.name); }
            al_ren_bind(r, it.name, nn);
            it.name = nn;
            List_push<*StmtNode>(&r.statics, it);
            continue;
        }
        al_ren_stmt(r, it);
        List_push<*StmtNode>(&kept, it);
    }
    while (List_len<*StmtNode>(items) > 0) { List_remove<*StmtNode>(items, List_len<*StmtNode>(items) - 1); }
    i = 0; while (i < List_len<*StmtNode>(&kept)) { List_push<*StmtNode>(items, List_get<*StmtNode>(&kept, i)); i = i + 1; }
}
void al_ren_stmt(AlRen* r, *StmtNode s) {
    if (s == null) { return; }
    int mark = List_len<string>(&r.keys);
    if (s.kind == SK_VARDECL) {
        al_ren_expr(r, s.expr);                          // the initializer sees the outer binding
        s.name = al_ren_declare(r, s.name);
        return;
    }
    if (s.kind == SK_FOR) {
        if (s.s1 != null && s.s1.kind == SK_BLOCK) { al_ren_items(r, &s.s1.items); } else { al_ren_stmt(r, s.s1); }
        al_ren_expr(r, s.expr); al_ren_expr(r, s.expr2); al_ren_scoped(r, s.s2);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_FORIN) {
        al_ren_expr(r, s.expr);
        s.name = al_ren_declare(r, s.name);
        al_ren_scoped(r, s.s1);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_ARM) {                              // `V(a, b)`: the bindings shadow
        string lb = s.name; int n = 0; while (lb[n] != 0) { n = n + 1; }
        int i = 0; while (i < n && (int)lb[i] != 40) { i = i + 1; }
        i = i + 1;
        while (i < n) {
            while (i < n && ((int)lb[i] == 32 || (int)lb[i] == 44)) { i = i + 1; }
            int st = i;
            while (i < n && (int)lb[i] != 44 && (int)lb[i] != 41 && (int)lb[i] != 32) { i = i + 1; }
            if (i > st) {
                // A binding gets its own spelling too, so a hoisted local of the same name
                // is not substituted for it.
                string bn = al_substr(lb, st, i);
                string nb = bn;
                if (str_eq(bn, "_") == 0) { nb = al_ren_declare(r, bn); }
                if (str_eq(nb, bn) == 0) {
                    lb = str_concat(al_substr(lb, 0, st), str_concat(nb, al_substr(lb, i, n)));
                    i = st + cstr_len(nb);
                    n = cstr_len(lb);
                }
            }
            if (i < n && (int)lb[i] == 41) { i = n; }
        }
        s.name = lb;
        al_ren_scoped(r, s.s1);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_CATCH) {                            // "Type name": the name shadows
        string cn = s.name; int n = 0; while (cn[n] != 0) { n = n + 1; }
        int i = n; while (i > 0 && (int)cn[i - 1] != 32) { i = i - 1; }
        string bn = al_substr(cn, i, n);
        if (bn[0] != 0) {
            string nb = al_ren_declare(r, bn);
            if (str_eq(nb, bn) == 0) { s.name = str_concat(al_substr(cn, 0, i), nb); }
        }
        al_ren_scoped(r, s.s1);
        al_ren_pop(r, mark);
        return;
    }
    if (s.kind == SK_BLOCK) { al_ren_items(r, &s.items); al_ren_pop(r, mark); return; }
    if (s.kind == SK_SWITCH) {                           // the switch body is one scope (C)
        al_ren_expr(r, s.expr);
        int k = 0;
        while (k < List_len<*StmtNode>(&s.items)) {
            *StmtNode cs = List_get<*StmtNode>(&s.items, k); k = k + 1;
            al_ren_expr(r, cs.expr);
            al_ren_items(r, &cs.items);
        }
        al_ren_pop(r, mark);
        return;
    }
    al_ren_expr(r, s.expr); al_ren_expr(r, s.expr2);
    al_ren_scoped(r, s.s1); al_ren_scoped(r, s.s2);
    al_ren_items(r, &s.items);
    al_ren_pop(r, mark);
}

// Lower one async function into [frame struct, resume fn, ctor fn], appended to `out`.
void al_transform(*Program prog, *DeclNode d, List<*DeclNode>* out) {
    string name = d.name;
    // Every synthesized name avoids the names already spelled in the function (and the
    // program's top-level names, for the frame type and resume function).
    List<string> used; List_init<string>(&used, 32);
    int ti = 0;
    while (ti < List_len<*DeclNode>(&prog.decls)) { List_push<string>(&used, List_get<*DeclNode>(&prog.decls, ti).name); ti = ti + 1; }
    collect_names_s(d.body, &used);
    int ui = 0; while (ui < List_len<Param>(&d.params)) { List_push<string>(&used, List_get<Param>(&d.params, ui).name); ui = ui + 1; }
    string frameName = fresh_name(str_concat("__", str_concat(name, "_frame")), &used);
    al_tps = "";
    int tpi = 0;
    while (tpi < List_len<TypeParam>(&d.type_params)) {
        if (tpi == 0) { al_tps = "<"; } else { al_tps = str_concat(al_tps, ", "); }
        al_tps = str_concat(al_tps, List_get<TypeParam>(&d.type_params, tpi).name);
        tpi = tpi + 1;
    }
    if (al_tps[0] != 0) { al_tps = str_concat(al_tps, ">"); }
    string frameT = str_concat(frameName, al_tps);   // the frame type's spelling
    string resumeN = fresh_name(str_concat("__", str_concat(name, "_resume")), &used);
    al_frp = fresh_name("__fr", &used);
    al_fst = fresh_name("st", &used);
    al_fret = fresh_name("ret", &used);
    al_fawt = fresh_name("awaiting", &used);
    string Tret = d.ret_type;
    if (str_eq(Tret, "void") == 1) { Tret = "uint8"; }

    let c: AlCtx;
    c.prog = prog; c.resumeN = resumeN; c.awcount = 0; c.tmpn = 0; c.curfn = d;
    List_init<string>(&c.vars, 8);
    List_init<Param>(&c.fields, 8);
    al_cur_fields = &c.fields;
    List_init<List<*StmtNode>>(&c.states, 4);
    List_init<int>(&c.brk, 4);
    List_init<int>(&c.cont, 4);
    List_init<List<*StmtNode>>(&c.dfr, 4);
    List_init<int>(&c.brk_dd, 4);
    List_init<int>(&c.cont_dd, 4);
    c.used = &used;
    let fret: Param; fret.name = al_fret; fret.ty = str_concat("Future<", str_concat(Tret, ">")); List_push<Param>(&c.fields, fret);
    let fst: Param; fst.name = al_fst; fst.ty = "int"; List_push<Param>(&c.fields, fst);
    let faw: Param; faw.name = al_fawt; faw.ty = "*FutureHdr"; List_push<Param>(&c.fields, faw);
    int pi = 0;
    while (pi < List_len<Param>(&d.params)) {
        Param p = List_get<Param>(&d.params, pi);
        List_push<string>(&c.vars, p.name); List_push<Param>(&c.fields, p);
        pi = pi + 1;
    }
    let ren: AlRen;
    List_init<string>(&ren.keys, 8); List_init<string>(&ren.vals, 8); List_init<string>(&ren.seen, 8); ren.used = &used;
    List_init<*StmtNode>(&ren.statics, 2); ren.ldepth = 0;
    pi = 0;
    while (pi < List_len<Param>(&d.params)) {
        Param rp = List_get<Param>(&d.params, pi);
        List_push<string>(&ren.seen, rp.name); al_ren_bind(&ren, rp.name, rp.name);
        pi = pi + 1;
    }
    al_ren_items(&ren, &d.body.items);
    // Desugar awaits to let-bindings, then hoist all locals to frame fields.
    List<*StmtNode> dbody; List_init<*StmtNode>(&dbody, 8);
    al_desugar_items(&c, &d.body.items, &dbody);
    int bi = 0;
    while (bi < List_len<*StmtNode>(&dbody)) { al_scan_locals(&c, List_get<*StmtNode>(&dbody, bi)); bi = bi + 1; }

    int entry = al_newst(&c);                  // state 0
    int exit = al_lower_seq(&c, &dbody, entry);
    if (exit != 0 - 1) {
        al_complete(&c, exit, al_int(0));
    }
    int wi = 0;                                // lambdas capturing hoisted locals
    while (wi < List_len<List<*StmtNode>>(&c.states)) {
        List<*StmtNode> stl = List_get<List<*StmtNode>>(&c.states, wi);
        int wk = 0; while (wk < List_len<*StmtNode>(&stl)) { List_set<*StmtNode>(&stl, wk, al_wrap_caps(&c, List_get<*StmtNode>(&stl, wk))); wk = wk + 1; }
        List_set<List<*StmtNode>>(&c.states, wi, stl);
        wi = wi + 1;
    }

    // resume fn: while (1) { if (fr.st==0){…} else if (fr.st==1){…} … else return; }
    *StmtNode chain = al_return(null);
    int si = List_len<List<*StmtNode>>(&c.states) - 1;
    while (si >= 0) {
        List<*StmtNode> body = List_get<List<*StmtNode>>(&c.states, si);
        List<*StmtNode> blk; List_init<*StmtNode>(&blk, 8);
        int k = 0; while (k < List_len<*StmtNode>(&body)) { List_push<*StmtNode>(&blk, List_get<*StmtNode>(&body, k)); k = k + 1; }
        chain = al_if(mk_bin("==", al_fr(al_fst), al_int(si)), al_block(&blk), chain);
        si = si - 1;
    }
    *StmtNode wh = alloc<StmtNode>(1); wh.kind = SK_WHILE; wh.expr = mk_lit(LIT_BOOL, "true");
    List<*StmtNode> wb; List_init<*StmtNode>(&wb, 1); List_push<*StmtNode>(&wb, chain); wh.s1 = al_block(&wb);
    List<*StmtNode> rb; List_init<*StmtNode>(&rb, 1);
    int sti = 0; while (sti < List_len<*StmtNode>(&ren.statics)) { List_push<*StmtNode>(&rb, List_get<*StmtNode>(&ren.statics, sti)); sti = sti + 1; }
    List_push<*StmtNode>(&rb, wh);
    *DeclNode resumeFn = new_decl(DK_FUNCTION);
    resumeFn.name = resumeN; resumeFn.ret_type = "void"; resumeFn.body = al_block(&rb);
    List_init<Param>(&resumeFn.params, 1);
    let fp: Param; fp.name = al_frp; fp.ty = str_concat("*", frameT); List_push<Param>(&resumeFn.params, fp);
    resumeFn.type_params = d.type_params;

    // ctor: *Future<Tret> name(params) { fr = alloc<frameT>(1); init; resume(fr); return &fr.ret; }
    List<*StmtNode> ctor; List_init<*StmtNode>(&ctor, 8);
    List<*ExprNode> aa; List_init<*ExprNode>(&aa, 1); List_push<*ExprNode>(&aa, al_int(1));
    List_push<*StmtNode>(&ctor, mk_vardecl(al_frp, str_concat("*", frameT), al_tcall(str_concat("alloc<", str_concat(frameT, ">")), &aa), 0));
    List_push<*StmtNode>(&ctor, al_assign(al_fr(al_fst), al_int(0)));
    List_push<*StmtNode>(&ctor, al_assign(al_fr(al_fawt), mk_cast("*FutureHdr", al_int(0))));
    List_push<*StmtNode>(&ctor, al_assign(al_member(al_fr(al_fret), "state"), al_int(0)));
    List_push<*StmtNode>(&ctor, al_assign(al_member(al_fr(al_fret), "waker"), al_waker_noop()));
    List_push<*StmtNode>(&ctor, al_assign(al_member(al_fr(al_fret), "on_drop"), al_ondrop()));
    pi = 0;
    while (pi < List_len<Param>(&d.params)) {
        Param p = List_get<Param>(&d.params, pi);
        List_push<*StmtNode>(&ctor, al_assign(al_fr(p.name), mk_ident(p.name)));
        pi = pi + 1;
    }
    List_push<*StmtNode>(&ctor, al_exprstmt(al_resume_call(resumeN)));
    List_push<*StmtNode>(&ctor, al_return(mk_un("&", al_member(mk_ident(al_frp), al_fret))));
    *DeclNode ctorFn = new_decl(DK_FUNCTION);
    ctorFn.name = name; ctorFn.ret_type = str_concat("*Future<", str_concat(Tret, ">"));
    ctorFn.body = al_block(&ctor);
    List_init<Param>(&ctorFn.params, 2);
    pi = 0; while (pi < List_len<Param>(&d.params)) { List_push<Param>(&ctorFn.params, List_get<Param>(&d.params, pi)); pi = pi + 1; }
    ctorFn.type_params = d.type_params;

    // frame struct
    *DeclNode frameD = new_decl(DK_STRUCT);
    frameD.name = frameName;
    frameD.type_params = d.type_params;
    List_init<Param>(&frameD.params, List_len<Param>(&c.fields));
    int ff = 0; while (ff < List_len<Param>(&c.fields)) { List_push<Param>(&frameD.params, List_get<Param>(&c.fields, ff)); ff = ff + 1; }

    List_push<*DeclNode>(out, frameD);
    List_push<*DeclNode>(out, resumeFn);
    List_push<*DeclNode>(out, ctorFn);
}

// A no-op `void(){}` waker lambda.
*ExprNode al_waker_noop() {
    List<*StmtNode> empty; List_init<*StmtNode>(&empty, 1);
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_LAMBDA; e.sval = "void()"; e.stmt = al_block(&empty);
    return e;
}

// The cancellation closure: `void() { if (fr.awaiting != (*FutureHdr)0) future_drop(fr.awaiting); }`
// (captures fr). Run by future_drop when a suspended async function is cancelled — it cascade-drops
// the future being awaited; future_drop then frees the frame (== &fr.ret) and this env.
*ExprNode al_ondrop() {
    List<*ExprNode> da; List_init<*ExprNode>(&da, 1); List_push<*ExprNode>(&da, al_fr(al_fawt));
    List<*StmtNode> drop; List_init<*StmtNode>(&drop, 1);
    List_push<*StmtNode>(&drop, al_exprstmt(al_call("future_drop", &da)));
    List<*StmtNode> body; List_init<*StmtNode>(&body, 1);
    List_push<*StmtNode>(&body, al_if(mk_bin("!=", al_fr(al_fawt), mk_cast("*FutureHdr", al_int(0))), al_block(&drop), null));
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_LAMBDA; e.sval = "void()"; e.stmt = al_block(&body);
    return e;
}

// A call through an expression callee (e.g. `fr.ret.waker()`).
*ExprNode al_call_on(*ExprNode callee, List<*ExprNode>* args) {
    *ExprNode e = alloc<ExprNode>(1);
    e.kind = EK_CALL; e.a = callee;
    List_init<*ExprNode>(&e.kids, 1);
    int i = 0; while (i < List_len<*ExprNode>(args)) { List_push<*ExprNode>(&e.kids, List_get<*ExprNode>(args, i)); i = i + 1; }
    return e;
}

// Does an expression contain an `await` anywhere?
int al_expr_has_await(*ExprNode e) {
    if (e == null) { return 0; }
    if (e.kind == EK_AWAIT) { return 1; }
    List<*ExprNode> ch; List_init<*ExprNode>(&ch, 4); al_children(e, &ch);
    int i = 0; while (i < List_len<*ExprNode>(&ch)) { if (al_expr_has_await(List_get<*ExprNode>(&ch, i)) == 1) { return 1; } i = i + 1; }
    return 0;
}

// The first await in an expression / statement subtree (source order), or null: the
// position an unsupported await is reported at.
*ExprNode al_first_await_e(*ExprNode e) {
    if (e == null) { return null; }
    if (e.kind == EK_AWAIT) { return e; }
    List<*ExprNode> ch; List_init<*ExprNode>(&ch, 4); al_children(e, &ch);
    int i = 0; while (i < List_len<*ExprNode>(&ch)) { *ExprNode a = al_first_await_e(List_get<*ExprNode>(&ch, i)); if (a != null) { return a; } i = i + 1; }
    return null;
}
*ExprNode al_first_await_s(*StmtNode s) {
    if (s == null) { return null; }
    // The supported forms (`let x = await E`, `return await E`, `await E;`, `x = await E`)
    // are skipped: the reported await is one the lowering can't place.
    *ExprNode top = s.expr;
    if (top != null && (s.kind == SK_VARDECL || s.kind == SK_RETURN || s.kind == SK_EXPR)) {
        if (top.kind == EK_AWAIT) { top = top.a; }
        else if (s.kind == SK_EXPR && top.kind == EK_BINARY && str_eq(top.sval, "=") == 1
                 && top.b != null && top.b.kind == EK_AWAIT) { top = top.b.a; }
    }
    *ExprNode a = al_first_await_e(top); if (a != null) { return a; }
    a = al_first_await_e(s.expr2); if (a != null) { return a; }
    a = al_first_await_s(s.s1); if (a != null) { return a; }
    a = al_first_await_s(s.s2); if (a != null) { return a; }
    int i = 0; while (i < List_len<*StmtNode>(&s.items)) { a = al_first_await_s(List_get<*StmtNode>(&s.items, i)); if (a != null) { return a; } i = i + 1; }
    return null;
}

// The first await anywhere in a statement subtree.
*ExprNode al_any_await_s(*StmtNode s) {
    if (s == null) { return null; }
    *ExprNode a = al_first_await_e(s.expr); if (a != null) { return a; }
    a = al_first_await_e(s.expr2); if (a != null) { return a; }
    a = al_any_await_s(s.s1); if (a != null) { return a; }
    a = al_any_await_s(s.s2); if (a != null) { return a; }
    int i = 0; while (i < List_len<*StmtNode>(&s.items)) { a = al_any_await_s(List_get<*StmtNode>(&s.items, i)); if (a != null) { return a; } i = i + 1; }
    return null;
}
// The first await inside a `match` (the lowering cannot split a match into states).
*ExprNode al_await_in_match_s(*StmtNode s) {
    if (s == null) { return null; }
    if (s.kind == SK_MATCH) { return al_any_await_s(s); }
    *ExprNode a = al_await_in_match_s(s.s1); if (a != null) { return a; }
    a = al_await_in_match_s(s.s2); if (a != null) { return a; }
    int i = 0; while (i < List_len<*StmtNode>(&s.items)) { a = al_await_in_match_s(List_get<*StmtNode>(&s.items, i)); if (a != null) { return a; } i = i + 1; }
    return null;
}

// Does a statement subtree contain an await anywhere (recursing control flow)?
int al_stmt_has_await_deep(*StmtNode s) {
    if (s == null) { return 0; }
    if (al_expr_has_await(s.expr) == 1 || al_expr_has_await(s.expr2) == 1) { return 1; }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_DOWHILE || s.kind == SK_DEFER) {
        if (al_stmt_has_await_deep(s.s1) == 1) { return 1; }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR || s.kind == SK_TRY) { if (al_stmt_has_await_deep(s.s2) == 1) { return 1; } }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { if (al_stmt_has_await_deep(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
    }
    return 0;
}

// True if a statement contains a labeled `break`/`continue` anywhere. Async bodies are
// always state-split, and a labeled jump can't be threaded through the resume state
// machine, so we reject it (mirrors the C++ AsyncTransform guard).
int al_stmt_has_labeled_break(*StmtNode s) {
    if (s == null) { return 0; }
    if (s.kind == SK_BREAK || s.kind == SK_CONTINUE) {
        if (s.label != null && s.label[0] != 0) { return 1; }
        return 0;
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_DOWHILE) {
        if (al_stmt_has_labeled_break(s.s1) == 1) { return 1; }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR || s.kind == SK_TRY) {
        if (al_stmt_has_labeled_break(s.s2) == 1) { return 1; }
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { if (al_stmt_has_labeled_break(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
    }
    return 0;
}

// Does a statement subtree contain a `defer` whose body awaits?
int al_stmt_has_defer_await(*StmtNode s) {
    if (s == null) { return 0; }
    if (s.kind == SK_DEFER) { return al_stmt_has_await_deep(s.s1); }
    if (al_stmt_has_defer_await(s.s1) == 1 || al_stmt_has_defer_await(s.s2) == 1) { return 1; }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH || s.kind == SK_TRY) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { if (al_stmt_has_defer_await(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
    }
    return 0;
}

// Can we lower this body? Await is supported at the top level and inside if/while/for/
// block; NOT yet inside switch/for-in/match/try (those are left untransformed). Also
// requires await to be the whole initializer of a `let` (not nested in a larger expr).
int al_can_lower(*StmtNode s) {
    if (s == null) { return 1; }
    if (s.kind == SK_VARDECL) {
        if (s.expr != null && s.expr.kind == EK_AWAIT) { return 1; }   // a let-bound await: fine
        return al_expr_has_await(s.expr) == 0;                         // await in a larger expr: no
    }
    if (s.kind == SK_RETURN) {
        if (s.expr != null && s.expr.kind == EK_AWAIT) { return 1; }   // `return await E` (desugared)
        return al_expr_has_await(s.expr) == 0;
    }
    if (s.kind == SK_EXPR) {
        if (s.expr != null && s.expr.kind == EK_AWAIT) { return 1; }   // `await E;` (desugared)
        if (s.expr != null && s.expr.kind == EK_BINARY && str_eq(s.expr.sval, "=") == 1
            && s.expr.b != null && s.expr.b.kind == EK_AWAIT) { return 1; }   // `x = await E`
        return al_expr_has_await(s.expr) == 0;
    }
    // await in a condition / iterable / step is not state-split — reject (don't miscompile).
    if (s.kind == SK_IF) {
        return al_expr_has_await(s.expr) == 0 && al_can_lower(s.s1) == 1 && al_can_lower(s.s2) == 1;
    }
    if (s.kind == SK_WHILE || s.kind == SK_FORIN || s.kind == SK_DOWHILE) {
        return al_expr_has_await(s.expr) == 0 && al_can_lower(s.s1) == 1;
    }
    if (s.kind == SK_FOR) {
        return al_expr_has_await(s.expr) == 0 && al_expr_has_await(s.expr2) == 0
            && al_can_lower(s.s1) == 1 && al_can_lower(s.s2) == 1;
    }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE) {
        int i = 0; while (i < List_len<*StmtNode>(&s.items)) { if (al_can_lower(List_get<*StmtNode>(&s.items, i)) == 0) { return 0; } i = i + 1; }
        return 1;
    }
    // switch / for-in / match / try / etc.: only OK if they contain no await (yet).
    return al_stmt_has_await_deep(s) == 0;
}

// Rewrite every async function whose awaits are in supported positions (top-level, or
// inside if/while/for/block). Others are left untransformed (a clean boundary).
void async_lower(*Program prog) {
    List<*DeclNode> out; List_init<*DeclNode>(&out, List_len<*DeclNode>(&prog.decls));
    int i = 0; int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION && d.is_async == 1 && d.body != null
            && al_stmt_has_labeled_break(d.body) == 1) {
            dprintf(2, "error: async function '%s': labeled 'break'/'continue' is not supported inside an async function\n", d.name);
            exit(1);
        }
        if (d.kind == DK_FUNCTION && d.is_async == 1 && d.body != null
            && al_stmt_has_defer_await(d.body) == 1) {
            dprintf(2, "error: async function '%s': await is not supported inside a defer\n", d.name);
            exit(1);
        }
        // An await the transform can't place (in a condition, a larger expression, or an
        // unsupported construct) must be a clean error, not left untransformed — a raw
        // `await` reaching codegen crashes or silently miscompiles.
        if (d.kind == DK_FUNCTION && d.is_async == 1 && d.body != null
            && al_can_lower(d.body) == 0 && al_stmt_has_await_deep(d.body) == 1) {
            *ExprNode fa = al_first_await_s(d.body);
            string ff = d.file; if (ff == null) { ff = ""; }
            *ExprNode ma = al_await_in_match_s(d.body);
            if (ma != null) {
                dprintf(2, "error: %s:%d:%d: async function '%s': 'await' is not supported inside a 'match' (supported: if/else, while, do/while, for, for-in, switch)\n", ff, ma.line, ma.col, d.name);
            } else if (fa != null) {
                dprintf(2, "error: %s:%d:%d: async function '%s': 'await' is only supported as the whole initializer of a 'let', a 'return', or an assignment (not in a condition or a larger expression)\n", ff, fa.line, fa.col, d.name);
            } else {
                dprintf(2, "error: async function '%s': await is not supported inside this statement (supported: if/else, while, do/while, for, for-in, switch)\n", d.name);
            }
            exit(1);
        }
        if (d.kind == DK_FUNCTION && d.is_async == 1 && d.body != null && al_can_lower(d.body) == 1) {
            al_transform(prog, d, &out);
        } else {
            List_push<*DeclNode>(&out, d);
        }
        i = i + 1;
    }
    prog.decls = out;
}
