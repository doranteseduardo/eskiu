// Self-hosted code generation (Phase C of the back-end). Walks the typed AST and
// emits LLVM IR as TEXT — no LLVM library to bind. The oracle is behavioral: the
// emitted .ll, compiled with clang and run, must produce the same exit code/output
// as the C++-built binary (LLVM auto-numbers/folds, so the IR text itself can't be
// matched byte-for-byte). Named SSA temps (%tN) sidestep LLVM's strict 0,1,2,…
// numbering for unnamed values.
//
// S0: functions returning an integer constant.
// S1: scalar locals + params via alloca/load/store, integer arithmetic, comparisons,
//     bitwise ops, unary negate, assignment. Control flow, calls, structs follow.

import <io>;
import <string>;
import <list>;
import <mem>;
import "ast.esk";

// libc: parse a decimal string to double, for f32 constant-folding in global inits.
extern double atof(string s);
extern void exit(int code);

// An evaluated expression: LLVM operand text, LLVM type, and the Eskiu type spelling
// (needed to resolve struct layouts / pointer depth, which the LLVM type loses).
struct CgVal { string op; string ty; string ety; }
// A local binding: source name → its alloca slot + LLVM type + Eskiu type.
struct CgLocal { string name; string slot; string ty; string ety; }
// A function's LLVM return type + (for variadic externs) its call-type prefix.
struct CgFn { string name; string retty; string rety; int variadic; string fixedtypes; List<string> ptys; List<string> petys; }
// An interface: method order (names) + each method's Eskiu return type, parallel by index.
// An interface value is a fat pointer {data, vtable}; dispatch loads the method ptr from
// the vtable slot at the method's index.
struct CgIface { string name; List<string> mnames; List<string> mrets; List<List<string>> mparams; }
// A struct's field layout: parallel field names + Eskiu types (index = GEP index).
struct CgStruct { string name; List<string> fnames; List<string> fetys; }
// A plain (integer) enum constant: name → its integer value as a string.
struct CgEnumC { string name; string val; }
// A folded compile-time constant scalar (a global initializer): ok = foldable; isf =
// floating (value in dv, w = 32 or 64) vs integer (value in iv, sign- or zero-extended
// from its w bits by uns, so it is always the value its C type holds).
struct CgK { int ok; int isf; int64 iv; double dv; int w; int uns; }
// A folded top-level `const` that is not a signed int (uint32, int64, float, ...), by name,
// in its declared type, so a later constant initializer can use it (int consts live in
// econsts).
struct CgFK { string name; CgK k; }
// An ADT enum variant: its name, owning enum, integer tag, and payload field types.
struct CgVariant { string vname; string ename; int tag; List<string> ptys; }
// A bitfield slot: which struct/field, the LLVM word it lives in (field index), its bit
// offset + width within that word, whether the field is signed (→ sign-extend on read),
// the storage word's LLVM integer type (the field's declared type, e.g. "i8"), and the
// field's Eskiu type (so a read carries its signedness). Under the C (non-MS) layout a
// field is addressed by byte offset `boffs` (-1 = struct element `fidx`) and a bitfield's
// word is read as `aty` (its declared type, or the byte span in a packed struct) with
// alignment `aal` (0 = natural).
struct CgBF { string sname; string fname; int fidx; int boff; int bw; int sgn; string sty; string fety; int boffs; string aty; int aal; }
// C ABI lowering (see cg_abi_classify). A scalar leaf of a flattened aggregate: byte
// offset + LLVM type. A classified param/return: kind 0 direct, 1 coerce (one value of
// `ty`), 2 expand (two args `ty`, `ty2`), 3 indirect (pointer to a caller copy), 4 byval,
// 5 sret; `ty` is the aggregate's LLVM type for 3-5, `align` their alignment, `salign`
// an `alignstack` for a coerced arg (0 = none). A lowered extern: its classification plus
// the lowered return / fixed-param types (the declared C signature).
struct CgLeaf { int off; string ty; }
struct CgAbi { int kind; string ty; string ty2; int align; int salign; }
struct CgCabi { string name; CgAbi ret; List<CgAbi> params; string lowret; string lowfixed; }
// A queued lambda: its unique name, the AST node (signature in .sval, body in .stmt),
// and its captured outer variables (parallel name/Eskiu-type lists).
// One active type-parameter substitution (T → concrete) during instantiation.
struct CgSub { string param; string arg; }
struct CgLambda { string name; *ExprNode node; string rety; List<string> capn; List<string> capt; List<CgSub> sub; List<CgLocal> statics; }
// A pending monomorphization: the generic decl + concrete type args + mangled name.
// is_struct 2 = an inline method of a generic struct instance: `owner` is the generic
// struct (its type params bind `args`), `self_sp` the instance spelling ("Box<int>").
struct CgInst { *DeclNode decl; string mangled; int is_struct; List<string> args; *DeclNode owner; string self_sp; }

struct Codegen {
    String out;
    String globals;      // module-top: extern declares + string-literal constants
    int next;            // SSA temp / slot / label counter
    int strcount;        // string-literal global counter
    string cur_ret;      // current function's LLVM return type
    string cur_rety;     // current function's Eskiu return type (interface boxing on return)
    List<CgLocal> locals;
    int terminated;      // is the current basic block already terminated?
    List<string> loop_cont;  // continue targets (innermost last)
    List<string> loop_end;   // break targets
    List<*StmtNode> cleanups; // scope-exit cleanup bodies (defer + a try's finally), LIFO
    List<int> cl_err;        // parallel to cleanups: 1 = errdefer (error-path only), 0 = defer/finally
    List<int> cl_nloc;       // parallel to cleanups: how many locals were visible when it was registered
    List<int> loop_cldepth;  // cleanups-stack length at each loop entry (parallel to loop_end)
    // Loops-only frame stack for labeled break/continue (a `switch` never pushes here, unlike
    // loop_end above). The four lists are parallel: label / break block / continue block /
    // cleanup depth. `break label` / `continue label` scan loop_lbls top-down for the name.
    List<string> loop_lbls;    // label for each real loop ("" = unlabeled)
    List<string> loop_lbl_end;
    List<string> loop_lbl_cont;
    List<int> loop_lbl_cld;
    List<CgFn> fns;          // function → return type / variadic signature
    List<CgStruct> structs;  // struct name → field layout
    List<CgEnumC> econsts;   // plain-enum constants → value
    List<CgFK> fconsts;      // top-level non-i32 `const` values (for constant folding)
    List<string> enum_names; // enum type names (lower to i32)
    List<string> enum_uns;   // plain enums with no negative member (an unsigned bitfield, as in C)
    List<CgVariant> variants; // ADT enum variants (by name)
    List<string> adt_names;  // ADT enum type names (lower to %Name, a tagged union)
    List<string> union_names; // union type names (all members overlap at offset 0)
    List<CgIface> ifaces;    // interfaces (name → method order + return types)
    int uses_iface;          // any interface declared → emit the shared %iface_fat type once
    List<CgSub> aliases;     // type aliases (name → underlying type spelling)
    List<string> fnthunks;   // top-level fns used as closure values → emit a __fnptr_<name> thunk
    List<CgBF> bitfields;    // bitfield slots (struct.field → word/offset/width/signed) + pack(N≥2) phys-index slots
    List<CgLambda> lambdas;  // queued lambda bodies, emitted after the main decls
    int lam_seq;             // counter for unique lambda names
    string lam_expret;       // return type expected from a lambda's assignment context ("" = none)
    *ExprNode tern_node;     // a `?:` bound for an interface: each arm boxes into tern_iface
    string tern_iface;
    int uses_eh;             // program uses try/throw → declare the Itanium EH runtime
    int uses_threads;        // program calls thread_create → the driver links pthread
    int uses_heap_env;       // a closure heap-allocated its env → ensure malloc is declared
    int safe;                // --safe: emit runtime slice/array index bounds checks (opt-in)
    int uses_trap;           // a bounds check was emitted → declare @llvm.trap once
    string cur_unwind;       // active landingpad label inside a try body ("" = plain calls)
    string cur_lbl;          // label of the basic block being emitted (for phi incoming edges)
    // Defers on the exceptional path (mirrors CodeGen::emitDeferPad). In a program that
    // throws (prog_eh), each defer gets a landingpad for the calls after it. cl_unw is
    // parallel to cleanups: the landingpad active before that cleanup was registered. The
    // try_* lists are parallel, one entry per try body being emitted: its cleanup depth,
    // its catch-dispatch label, and the extra phi incoming edges from body defer pads.
    int prog_eh;
    List<string> cl_unw;
    List<int> try_cld;
    List<string> try_disp;
    List<string> try_phi;
    List<CgLocal> gvars;     // global variables (slot = "@name", a pointer to storage)
    List<*DeclNode> gstructs; // generic struct decls (by name, type_params non-empty)
    List<*DeclNode> genums;  // generic ADT enum decls (monomorphized on demand)
    List<CgVariant> gvariants; // generic variant patterns (ename = generic enum name; ptys carry type params)
    List<*DeclNode> gfns;     // generic function decls
    List<CgSub> cursub;      // active T→concrete substitution during instantiation
    List<string> inst_seen;  // mangled names already queued/emitted (dedup)
    List<CgInst> worklist;   // pending monomorphizations
    int wl_i;                // persistent drain cursors: worklist / lambdas / thunks
    int lam_i;
    int thk_i;
    String entry_buf;        // local allocas for the fn/lambda being emitted, hoisted to entry
    List<CgSub> tydefs;      // emitted named LLVM types: name (no '%') → body text ("{ i32, ptr }")
    List<*DeclNode> tydecls; // non-generic struct/union/ADT decls whose type line is emitted on demand
    int abi;                 // target C ABI: 0 none, 1 AArch64 Darwin, 2 AArch64 AAPCS64, 3 x86-64 SysV,
                             // 4 Windows x64, 5 32-bit ARM AAPCS (soft-float), 6 ARM AAPCS-VFP (hard-float)
    int ptrsz;               // pointer size in bytes (4 on 32-bit ARM and x86)
    int i64al;               // ABI alignment of i64 and double (4 on 32-bit x86 SysV, else 8)
    int msbf;                // 1: MS bitfield layout (Windows targets), else SysV/AAPCS
    int wintgt;              // 1: a Windows target (mingw SEH exception personality)
    List<CgCabi> cabis;      // externs declared with a C-ABI-lowered signature
}

int cg_streq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    if (a[i] == b[i]) { return 1; }
    return 0;
}

string cg_cat(string a, string b) {
    int la = 0; while (a[la] != 0) { la = la + 1; }
    int lb = 0; while (b[lb] != 0) { lb = lb + 1; }
    *uint8 buf = alloc<uint8>(la + lb + 1);
    int i = 0; while (i < la) { buf[i] = (uint8)a[i]; i = i + 1; }
    int j = 0; while (j < lb) { buf[la + j] = (uint8)b[j]; j = j + 1; }
    buf[la + lb] = 0;
    return (string)buf;
}

string cg_sub_str(string s, int a, int b) {
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0; while (k < len) { buf[k] = (uint8)s[a + k]; k = k + 1; }
    buf[len] = 0;
    return (string)buf;
}

string cg_itoa(int n) {
    if (n == 0) { return "0"; }
    int neg = 0;
    if (n < 0) { neg = 1; n = 0 - n; }
    *uint8 tmp = alloc<uint8>(16);
    int len = 0;
    while (n > 0) { tmp[len] = (uint8)(48 + (n % 10)); n = n / 10; len = len + 1; }
    int total = len; if (neg == 1) { total = total + 1; }
    *uint8 buf = alloc<uint8>(total + 1);
    int off = 0;
    if (neg == 1) { buf[0] = 45; off = 1; }
    int i = 0; while (i < len) { buf[off + i] = tmp[len - 1 - i]; i = i + 1; }
    buf[total] = 0;
    return (string)buf;
}

// Is `s` a non-empty run of decimal digits?
int cg_all_digits(string s) {
    if (s[0] == 0) { return 0; }
    int i = 0;
    while (s[i] != 0) { if ((int)s[i] < 48 || (int)s[i] > 57) { return 0; } i = i + 1; }
    return 1;
}

// Format a uint64 as a decimal string (cg_itoa is i32-only).
string cg_u64toa(uint64 n) {
    if (n == 0) { return "0"; }
    *uint8 tmp = alloc<uint8>(24);
    int len = 0;
    while (n > 0) { tmp[len] = (uint8)(48 + (int)(n % 10)); n = n / 10; len = len + 1; }
    *uint8 buf = alloc<uint8>(len + 1);
    int i = 0; while (i < len) { buf[i] = tmp[len - 1 - i]; i = i + 1; }
    buf[len] = 0;
    return (string)buf;
}

// Parse an integer literal (decimal, 0x/0X hex, or leading-0 octal) to its
// uint64 magnitude, ignoring any leading '-'. LLVM textual IR only accepts
// decimal integer constants, so callers re-render this via cg_u64toa.
uint64 cg_int_lit_mag(string s) {
    int k = 0;
    if (s[k] == 45) { k = 1; }                          // skip '-'
    let mag: uint64 = 0;
    if (s[k] == 48 && (s[k + 1] == 120 || s[k + 1] == 88)) {   // 0x / 0X hex
        k = k + 2;
        while (s[k] != 0) {
            int c = (int)s[k]; int d = 0;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else if (c >= 65 && c <= 70) { d = c - 65 + 10; }
            mag = mag * 16 + (uint64)d; k = k + 1;
        }
        return mag;
    }
    if (s[k] == 48 && s[k + 1] != 0) {                  // leading 0 -> octal
        k = k + 1;
        while (s[k] != 0) { mag = mag * 8 + (uint64)((int)s[k] - 48); k = k + 1; }
        return mag;
    }
    while (s[k] != 0) { mag = mag * 10 + (uint64)((int)s[k] - 48); k = k + 1; }   // decimal
    return mag;
}

void cg_init(Codegen* g) {
    String_init(&g.out, 1024);
    String_init(&g.globals, 256);
    g.next = 0;
    g.strcount = 0;
    g.cur_ret = "void";
    g.cur_rety = "void";
    List_init<CgLocal>(&g.locals, 8);
    g.terminated = 0;
    List_init<string>(&g.loop_cont, 4);
    List_init<string>(&g.loop_end, 4);
    List_init<*StmtNode>(&g.cleanups, 4);
    List_init<int>(&g.cl_err, 4);
    List_init<int>(&g.cl_nloc, 4);
    List_init<int>(&g.loop_cldepth, 4);
    List_init<string>(&g.loop_lbls, 4);
    List_init<string>(&g.loop_lbl_end, 4);
    List_init<string>(&g.loop_lbl_cont, 4);
    List_init<int>(&g.loop_lbl_cld, 4);
    List_init<CgFn>(&g.fns, 32);
    List_init<CgStruct>(&g.structs, 16);
    List_init<CgEnumC>(&g.econsts, 32);
    List_init<CgFK>(&g.fconsts, 4);
    List_init<string>(&g.enum_names, 16);
    List_init<string>(&g.enum_uns, 8);
    List_init<CgVariant>(&g.variants, 16);
    List_init<string>(&g.adt_names, 8);
    List_init<string>(&g.union_names, 4);
    List_init<CgIface>(&g.ifaces, 4);
    g.uses_iface = 0;
    List_init<CgSub>(&g.aliases, 4);
    List_init<string>(&g.fnthunks, 4);
    List_init<CgBF>(&g.bitfields, 8);
    List_init<CgLambda>(&g.lambdas, 8);
    g.lam_seq = 0;
    g.lam_expret = "";
    g.tern_node = null; g.tern_iface = "";
    g.uses_eh = 0;
    g.uses_threads = 0;
    g.uses_heap_env = 0;
    g.safe = 0;
    g.uses_trap = 0;
    g.cur_unwind = "";
    g.cur_lbl = "entry";
    g.prog_eh = 0;
    List_init<string>(&g.cl_unw, 4);
    List_init<int>(&g.try_cld, 4);
    List_init<string>(&g.try_disp, 4);
    List_init<string>(&g.try_phi, 4);
    List_init<CgLocal>(&g.gvars, 8);
    List_init<*DeclNode>(&g.gstructs, 8);
    List_init<*DeclNode>(&g.genums, 4);
    List_init<CgSub>(&g.tydefs, 16);
    List_init<*DeclNode>(&g.tydecls, 16);
    List_init<CgCabi>(&g.cabis, 4);
    // The host C ABI, fixed when this compiler was built (the build compiler predefines
    // the architecture macro); cg_set_target switches it for a --target triple.
    g.abi = 0;
#ifdef __aarch64__
    g.abi = 2;
#ifdef __APPLE__
    g.abi = 1;
#endif
#endif
#ifdef __x86_64__
    g.abi = 3;
#ifdef _WIN32
    g.abi = 4;
#endif
#endif
#ifdef __arm__
    g.abi = 5;
#endif
    g.ptrsz = 8;
#ifdef __arm__
    g.ptrsz = 4;
#endif
    g.i64al = 8;
    g.msbf = 0;
    g.wintgt = 0;
#ifdef _WIN32
    g.msbf = 1;
    g.wintgt = 1;
#endif
    List_init<CgVariant>(&g.gvariants, 8);
    List_init<*DeclNode>(&g.gfns, 16);
    List_init<CgSub>(&g.cursub, 4);
    List_init<string>(&g.inst_seen, 16);
    List_init<CgInst>(&g.worklist, 16);
    g.wl_i = 0; g.lam_i = 0; g.thk_i = 0;
    String_init(&g.entry_buf, 128);
}

int cg_has_sub(string s, string sub) {
    int i = 0;
    while (s[i] != 0) {
        int j = 0;
        while (sub[j] != 0 && s[i + j] == sub[j]) { j = j + 1; }
        if (sub[j] == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

int cg_has_prefix(string s, string pre) {
    int i = 0;
    while (pre[i] != 0) { if (s[i] != pre[i]) { return 0; } i = i + 1; }
    return 1;
}

// The C ABI of a --target `triple` (C++ CodeGen::cabiTarget): the architecture picks the
// convention, the OS picks Darwin vs AAPCS64 and Windows x64 vs SysV, and a 32-bit ARM
// triple ending in `hf` is hard-float. A Windows triple also selects the MS bitfield
// layout. "" keeps the build host's.
void cg_set_target(Codegen* g, string triple) {
    if (triple[0] == 0) { return; }
    g.abi = 0; g.ptrsz = 8; g.i64al = 8; g.msbf = 0;
    int apple = cg_has_sub(triple, "apple") | cg_has_sub(triple, "darwin") | cg_has_sub(triple, "macos") | cg_has_sub(triple, "ios");
    int win = cg_has_sub(triple, "windows") | cg_has_sub(triple, "win32") | cg_has_sub(triple, "mingw");
    g.msbf = win;
    g.wintgt = win;
    if (cg_has_prefix(triple, "aarch64") == 1 || cg_has_prefix(triple, "arm64") == 1) {
        g.abi = 2; if (apple == 1) { g.abi = 1; }
    } else if (cg_has_prefix(triple, "x86_64") == 1 || cg_has_prefix(triple, "amd64") == 1) {
        g.abi = 3; if (win == 1) { g.abi = 4; }
    } else if (cg_has_prefix(triple, "i386") == 1 || cg_has_prefix(triple, "i486") == 1
               || cg_has_prefix(triple, "i586") == 1 || cg_has_prefix(triple, "i686") == 1) {
        // 32-bit x86: 4-byte pointers; the SysV i386 ABI aligns i64 and double to 4
        // (LLVM's `f64:32:64`, no `i64:64`), Windows to 8. No C-ABI lowering (as C++).
        g.ptrsz = 4;
        if (win == 0) { g.i64al = 4; }
    } else if (cg_has_prefix(triple, "arm") == 1 || cg_has_prefix(triple, "thumb") == 1) {
        g.abi = 5; g.ptrsz = 4;
        int n = 0; while (triple[n] != 0) { n = n + 1; }
        if (n >= 2 && (int)triple[n - 2] == 104 && (int)triple[n - 1] == 102) { g.abi = 6; }   // "hf"
    }
}

// Reserve a local `alloca <ty>` in the entry block (not inline), so a variable declared in
// a loop body allocates ONCE, not every iteration (a long loop would otherwise overflow the
// stack). Returns the slot name. Mirrors the C++ back-end's entryAlloca.
string cg_entry_alloca(Codegen* g, string ty) {
    string slot = cg_tmp(g);
    String_append(&g.entry_buf, "  "); String_append(&g.entry_buf, slot);
    String_append(&g.entry_buf, " = alloca "); String_append(&g.entry_buf, ty);
    String_append(&g.entry_buf, "\n");
    return slot;
}

// Snapshot the active type-parameter substitution, so a deferred emission (a queued
// lambda body) can restore the exact substitution that was live where it was written.
List<CgSub> cg_copy_sub(List<CgSub>* src) {
    List<CgSub> r; List_init<CgSub>(&r, List_len<CgSub>(src) + 1);
    int i = 0; int n = List_len<CgSub>(src);
    while (i < n) { List_push<CgSub>(&r, List_get<CgSub>(src, i)); i = i + 1; }
    return r;
}

// Minimal AST constructors, used to desugar `for-in` into a counted for. Local copies of
// the parser/async_lower builders so codegen.esk stays self-contained (it compiles as a
// standalone module in cg_selfhost.sh, without those modules merged in).
// alloc zero-initializes, so the fields these builders leave unset read as zero: a null
// child, an empty `kids`/`names` list (`{null,0,0}`, which cg_etype's `List_len` reads as
// empty). Only the kind + the fields each node actually uses need setting.
*ExprNode cgb_ident(string nm) { *ExprNode e = alloc<ExprNode>(1); e.kind = EK_IDENT; e.sval = nm; return e; }
*ExprNode cgb_lit(int lk, string v) { *ExprNode e = alloc<ExprNode>(1); e.kind = EK_LITERAL; e.lit_kind = lk; e.sval = v; return e; }
*ExprNode cgb_bin(string op, *ExprNode l, *ExprNode r) { *ExprNode e = alloc<ExprNode>(1); e.kind = EK_BINARY; e.sval = op; e.a = l; e.b = r; return e; }
*ExprNode cgb_member(*ExprNode base, string field) { *ExprNode e = alloc<ExprNode>(1); e.kind = EK_MEMBER; e.a = base; e.sval = field; return e; }
*ExprNode cgb_index(*ExprNode base, *ExprNode idx) { *ExprNode e = alloc<ExprNode>(1); e.kind = EK_INDEX; e.a = base; e.b = idx; return e; }
*StmtNode cgb_vardecl(string nm, string ty, *ExprNode init) { *StmtNode s = alloc<StmtNode>(1); s.kind = SK_VARDECL; s.name = nm; s.type = ty; s.expr = init; s.is_const = 0; s.is_static = 0; return s; }

// Does `e` have an address (a list-like iterable is then held by a pointer to it)?
int cg_addressable(Codegen* g, *ExprNode e) {
    if (e == null) { return 0; }
    if (e.kind == EK_IDENT) { return 1; }
    int builtin = 1; if (e.op_fn != null && e.op_fn[0] != 0) { builtin = 0; }
    if (e.kind == EK_UNARY) { if (builtin == 1 && cg_streq(e.sval, "*") == 1) { return 1; } return 0; }
    if (e.kind == EK_INDEX) { if (builtin == 1 && List_len<*ExprNode>(&e.kids) == 0) { return 1; } return 0; }
    if (e.kind == EK_MEMBER) {
        string bt = cg_etype(g, e.a);
        if ((int)bt[0] == 42) { return 1; }
        return cg_addressable(g, e.a);
    }
    return 0;
}
*StmtNode cgb_for(*StmtNode init, *ExprNode cond, *ExprNode step, *StmtNode body) { *StmtNode s = alloc<StmtNode>(1); s.kind = SK_FOR; s.s1 = init; s.expr = cond; s.expr2 = step; s.s2 = body; return s; }
*StmtNode cgb_block2(*StmtNode a, *StmtNode b) {
    *StmtNode s = alloc<StmtNode>(1); s.kind = SK_BLOCK;
    List_init<*StmtNode>(&s.items, 2);
    List_push<*StmtNode>(&s.items, a);
    if (b != null) { List_push<*StmtNode>(&s.items, b); }
    return s;
}

// Mangle a generic type/call spelling into an LLVM-safe name: "Box<int>" -> "Box_int",
// "Map<string, int>" -> "Map_string__int", "List<*int>" -> "List_pint". Internally
// consistent (defs and refs agree), which is all clang needs.
string cg_mangle(string s) {
    int n = 0; while (s[n] != 0) { n = n + 1; }
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0;
    int i = 0;
    while (i < n) {
        int c = (int)s[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            buf[o] = (uint8)c; o = o + 1;
        } else if (c == 42) { buf[o] = 112; o = o + 1; }   // '*' -> 'p'
        else if (c == 62 || c == 32) { }                   // '>' / ' ' dropped
        else { buf[o] = 95; o = o + 1; }                   // '<' ',' etc. -> '_'
        i = i + 1;
    }
    buf[o] = 0;
    return (string)buf;
}

// Apply the active substitution to a type spelling: identifier runs equal to a type
// parameter are replaced by its concrete type. "*T" -> "*int", "List<T>" -> "List<int>".
string cg_apply_sub(Codegen* g, string t) {
    if (List_len<CgSub>(&g.cursub) == 0) { return t; }
    int n = 0; while (t[n] != 0) { n = n + 1; }
    String out; String_init(&out, n + 8);
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            int s = i;
            while (i < n) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) { i = i + 1; }
                else { break; }
            }
            string id = cg_sub_str(t, s, i);
            string rep = id;
            int k = 0; int m = List_len<CgSub>(&g.cursub);
            while (k < m) {
                CgSub sb = List_get<CgSub>(&g.cursub, k);
                if (cg_streq(sb.param, id) == 1) { rep = sb.arg; }
                k = k + 1;
            }
            String_append(&out, rep);
        } else {
            String_push(&out, (char)c);
            i = i + 1;
        }
    }
    return (string)String_cstr(&out);
}

// Resolve type aliases in a type spelling, token-wise (each identifier that names an
// alias is replaced by its underlying type, recursively up to `depth` for chained
// aliases). Always-on (unlike cg_apply_sub's generic substitution); a no-op when no
// aliases are registered. `type u8 = uint8` → "u8" becomes "uint8"; "*u8" → "*uint8".
string cg_dealias_d(Codegen* g, string t, int depth) {
    if (depth > 8) { return t; }
    if (List_len<CgSub>(&g.aliases) == 0) { return t; }
    int n = 0; while (t[n] != 0) { n = n + 1; }
    String out; String_init(&out, n + 8);
    int i = 0; int changed = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            int s = i;
            while (i < n) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) { i = i + 1; }
                else { break; }
            }
            string id = cg_sub_str(t, s, i);
            string rep = id;
            int k = 0; int m = List_len<CgSub>(&g.aliases);
            while (k < m) {
                CgSub sb = List_get<CgSub>(&g.aliases, k);
                if (cg_streq(sb.param, id) == 1) { rep = sb.arg; changed = 1; }
                k = k + 1;
            }
            // A pointer to an alias of an array (`*AI`, `type AI = int[3]`) is `int[3]*`: a
            // leading star would bind looser than the array suffix (an array of pointers).
            int rn = 0; while (rep[rn] != 0) { rn = rn + 1; }
            int stars = 0;
            if (rep != id && rn > 0 && (int)rep[rn - 1] == 93) {
                while (s - stars > 0 && (int)t[s - stars - 1] == 42) { stars = stars + 1; }
                out.len = out.len - (int64)stars;
                out.data[out.len] = (char)0;
                // An array of an array alias (`type Arr = int[3]; Arr[2]`) is 2 arrays of 3:
                // the outer dimensions go in front of the alias's (leftmost is outermost).
                if (stars == 0 && i < n && (int)t[i] == 91) {
                    int e = i;
                    while (e < n && (int)t[e] == 91) {
                        int dd = 0;
                        while (e < n) {
                            if ((int)t[e] == 91) { dd = dd + 1; }
                            else if ((int)t[e] == 93) { dd = dd - 1; if (dd == 0) { e = e + 1; break; } }
                            e = e + 1;
                        }
                    }
                    int rb = cg_arr_open(rep);
                    if (rb > 0) {
                        rep = cg_cat(cg_cat(cg_sub_str(rep, 0, rb), cg_sub_str(t, i, e)), cg_sub_str(rep, rb, rn));
                        i = e;
                    }
                }
            }
            String_append(&out, rep);
            while (stars > 0) { String_push(&out, '*'); stars = stars - 1; }
        } else {
            String_push(&out, (char)c);
            i = i + 1;
        }
    }
    if (changed == 1) { return cg_dealias_d(g, (string)String_cstr(&out), depth + 1); }
    return (string)String_cstr(&out);
}
string cg_dealias(Codegen* g, string t) { return cg_dealias_d(g, t, 0); }

// Does a type/call spelling carry generic args ("Name<...>")?
int cg_has_targs(string s) {
    int i = 0;
    while (s[i] != 0) { if ((int)s[i] == 60) { return 1; } i = i + 1; }   // '<'
    return 0;
}

// Base name of a generic spelling: "Box<int>" -> "Box", "List_init<int>" -> "List_init".
string cg_gen_base(string s) {
    int n = 0;
    while (s[n] != 0 && (int)s[n] != 60) { n = n + 1; }   // up to '<'
    *uint8 buf = alloc<uint8>(n + 1);
    int k = 0; while (k < n) { buf[k] = (uint8)s[k]; k = k + 1; }
    buf[n] = 0;
    return (string)buf;
}

// Parse the comma-separated args inside the outermost <...> of a generic spelling,
// honoring nesting ("Map<List<int>, int>" -> ["List<int>", "int"]).
void cg_gen_args(string s, List<string>* out) {
    int i = 0;
    while (s[i] != 0 && (int)s[i] != 60) { i = i + 1; }   // to '<'
    if (s[i] == 0) { return; }
    i = i + 1;                                            // past '<'
    int depth = 1;
    int start = i;
    while (s[i] != 0 && depth > 0) {
        int c = (int)s[i];
        if (c == 60 || c == 40) { depth = depth + 1; }             // '<' or '(' (nested generic / fn params)
        else if (c == 41) { if (depth > 0) { depth = depth - 1; } }   // ')'
        else if (c == 62 && (i == 0 || (int)s[i - 1] != 45)) {      // '>' closing a generic, NOT the "->" arrow
            depth = depth - 1; if (depth == 0) { break; }
        }
        else if (c == 44 && depth == 1) {                          // top-level ','
            string a = cg_sub_str(s, start, i);
            List_push<string>(out, cg_trim(a));
            i = i + 1; start = i; continue;
        }
        i = i + 1;
    }
    if (i > start) { List_push<string>(out, cg_trim(cg_sub_str(s, start, i))); }
}

// Trim leading/trailing spaces.
string cg_trim(string s) {
    int a = 0; while ((int)s[a] == 32) { a = a + 1; }
    int b = 0; while (s[b] != 0) { b = b + 1; }
    while (b > a && (int)s[b - 1] == 32) { b = b - 1; }
    return cg_sub_str(s, a, b);
}

int cg_in_strlist(List<string>* l, string s) {
    int i = 0; int n = List_len<string>(l);
    while (i < n) { if (cg_streq(List_get<string>(l, i), s) == 1) { return 1; } i = i + 1; }
    return 0;
}

int cg_seen_inst(Codegen* g, string mangled) {
    int i = 0; int n = List_len<string>(&g.inst_seen);
    while (i < n) { if (cg_streq(List_get<string>(&g.inst_seen, i), mangled) == 1) { return 1; } i = i + 1; }
    return 0;
}

*DeclNode cg_find_gstruct(Codegen* g, string name) {
    int i = 0; int n = List_len<*DeclNode>(&g.gstructs);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&g.gstructs, i);
        if (cg_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

// Monomorphize a generic struct spelling ("Box<int>") into a concrete named type
// `%Box_int = type {…}` with the type params substituted in its field types. Returns
// the mangled name. Idempotent (deduped via inst_seen).
string cg_ensure_struct_inst(Codegen* g, string spelling) {
    spelling = cg_apply_sub(g, spelling);                 // resolve T→concrete before mangling
    string mangled = cg_mangle(spelling);
    if (cg_seen_inst(g, mangled) == 1) { return mangled; }
    string base = cg_gen_base(spelling);
    *DeclNode gd = cg_find_gstruct(g, base);
    if (gd == null) { return mangled; }                   // unknown generic — leave as-is
    List_push<string>(&g.inst_seen, mangled);             // mark before building (recursion)

    List<string> args; List_init<string>(&args, 4);
    cg_gen_args(spelling, &args);

    List<CgSub> oldsub = g.cursub;                        // save/restore the active sub
    List_init<CgSub>(&g.cursub, 4);
    int tp = 0; int ntp = List_len<TypeParam>(&gd.type_params);
    while (tp < ntp && tp < List_len<string>(&args)) {
        let sb: CgSub;
        sb.param = List_get<TypeParam>(&gd.type_params, tp).name;
        sb.arg = List_get<string>(&args, tp);
        List_push<CgSub>(&g.cursub, sb);
        tp = tp + 1;
    }

    let s: CgStruct; s.name = mangled;
    List_init<string>(&s.fnames, 4); List_init<string>(&s.fetys, 4);
    // Assemble the field-type list into a local buffer first: a field whose type is
    // itself generic triggers a nested instantiation that appends to g.globals, so the
    // nested type must land BEFORE this one's line (not interleaved mid-line).
    String body; String_init(&body, 32);
    int fi = 0; int nf = List_len<Param>(&gd.params);
    while (fi < nf) {
        Param fp = List_get<Param>(&gd.params, fi);
        string fety = cg_apply_sub(g, fp.ty);             // T -> concrete spelling
        List_push<string>(&s.fnames, fp.name);
        List_push<string>(&s.fetys, fety);
        if (fi > 0) { String_append(&body, ", "); }
        String_append(&body, cg_lltype(g, fety));
        fi = fi + 1;
    }
    List_push<CgStruct>(&g.structs, s);                   // register before emitting the line
    cg_deftype(g, mangled, cg_cat("{ ", cg_cat((string)String_cstr(&body), " }")));

    g.cursub = oldsub;                                    // restore
    return mangled;
}

// A generic function by name: its definition, not a body-less prototype (`T f<T>(T x);`)
// that may precede it.
*DeclNode cg_find_gfn(Codegen* g, string name) {
    *DeclNode proto = null;
    int i = 0; int n = List_len<*DeclNode>(&g.gfns);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&g.gfns, i);
        if (cg_streq(d.name, name) == 1) {
            if (d.body != null) { return d; }
            if (proto == null) { proto = d; }
        }
        i = i + 1;
    }
    return proto;
}

// Build the active T→concrete substitution for a generic decl + its type args, saving
// and returning the previous one (restore by assigning it back to g.cursub).
List<CgSub> cg_push_sub(Codegen* g, *DeclNode gd, List<string>* args) {
    List<CgSub> old = g.cursub;
    List_init<CgSub>(&g.cursub, 4);
    int tp = 0; int ntp = List_len<TypeParam>(&gd.type_params);
    while (tp < ntp && tp < List_len<string>(args)) {
        let sb: CgSub;
        sb.param = List_get<TypeParam>(&gd.type_params, tp).name;
        sb.arg = List_get<string>(args, tp);
        List_push<CgSub>(&g.cursub, sb);
        tp = tp + 1;
    }
    return old;
}

// Monomorphize a generic function call spelling ("id<int>") — register its concrete
// signature now (so the call site is typed) and queue its body for emission. Returns
// the mangled name. Idempotent.
string cg_ensure_fn_inst(Codegen* g, string spelling) {
    // Resolve type args through the active substitution FIRST: a call like `alloc<T>`
    // inside a `List_push<T>` body has the literal param `T`, which must become the
    // concrete type (`alloc<Param>`) before mangling — else we'd emit a bogus `alloc_T`.
    spelling = cg_apply_sub(g, spelling);
    string mangled = cg_mangle(spelling);
    if (cg_seen_inst(g, mangled) == 1) { return mangled; }
    string base = cg_gen_base(spelling);
    *DeclNode gd = cg_find_gfn(g, base);
    if (gd == null) { return mangled; }                   // unknown generic — leave as-is
    List_push<string>(&g.inst_seen, mangled);

    List<string> args; List_init<string>(&args, 4);
    cg_gen_args(spelling, &args);

    let inst: CgInst; inst.decl = gd; inst.mangled = mangled; inst.is_struct = 0;
    List_init<string>(&inst.args, 4);
    int ai = 0; while (ai < List_len<string>(&args)) { List_push<string>(&inst.args, List_get<string>(&args, ai)); ai = ai + 1; }
    List_push<CgInst>(&g.worklist, inst);

    List<CgSub> oldsub = cg_push_sub(g, gd, &args);       // signature types under sub
    let f: CgFn; f.name = mangled; f.retty = cg_lltype(g, gd.ret_type);
    f.rety = cg_apply_sub(g, gd.ret_type); f.variadic = 0;
    string fixed = ""; int np = List_len<Param>(&gd.params); int pi = 0; int first = 1;
    List_init<string>(&f.ptys, np);
    List_init<string>(&f.petys, np);
    while (pi < np) {
        Param pm = List_get<Param>(&gd.params, pi);
        if (cg_streq(pm.ty, "...") == 1) { f.variadic = 1; pi = pi + 1; continue; }   // generic variadic
        string plt = cg_lltype(g, pm.ty);
        List_push<string>(&f.ptys, plt);
        List_push<string>(&f.petys, cg_apply_sub(g, pm.ty));
        if (first == 0) { fixed = cg_cat(fixed, ", "); }
        fixed = cg_cat(fixed, plt); first = 0;
        pi = pi + 1;
    }
    f.fixedtypes = fixed;
    List_push<CgFn>(&g.fns, f);
    g.cursub = oldsub;
    return mangled;
}

// An inline method of a generic struct instance (`Box<int>` + `get` → `Box_int_get`):
// register its concrete signature (self first) and queue its body, like a generic
// function instance. Returns the LLVM name, or "" when `sname` is not such an instance.
string cg_ensure_method_inst(Codegen* g, string sname, string method) {
    string sp = cg_apply_sub(g, sname);
    if (cg_has_targs(sp) == 0) { return ""; }
    *DeclNode gd = cg_find_gstruct(g, cg_gen_base(sp));
    if (gd == null) { return ""; }
    *DeclNode m = null;
    int mi = 0; int mn = List_len<*DeclNode>(&gd.methods);
    while (mi < mn) { *DeclNode c = List_get<*DeclNode>(&gd.methods, mi); if (cg_streq(c.name, method) == 1) { m = c; } mi = mi + 1; }
    if (m == null) { return ""; }
    string smangled = cg_ensure_struct_inst(g, sp);
    string llname = cg_cat(cg_cat(smangled, "_"), method);
    if (cg_seen_inst(g, llname) == 1) { return llname; }
    List_push<string>(&g.inst_seen, llname);

    List<string> args; List_init<string>(&args, 4);
    cg_gen_args(sp, &args);
    let inst: CgInst; inst.decl = m; inst.mangled = llname; inst.is_struct = 2;
    inst.owner = gd; inst.self_sp = sp;
    List_init<string>(&inst.args, 4);
    int ai = 0; while (ai < List_len<string>(&args)) { List_push<string>(&inst.args, List_get<string>(&args, ai)); ai = ai + 1; }
    List_push<CgInst>(&g.worklist, inst);

    List<CgSub> oldsub = cg_push_sub(g, gd, &args);
    let f: CgFn; f.name = llname; f.retty = cg_lltype(g, m.ret_type);
    f.rety = cg_apply_sub(g, m.ret_type); f.variadic = 0; f.fixedtypes = "";
    int np = List_len<Param>(&m.params);
    List_init<string>(&f.ptys, np + 1);
    List_init<string>(&f.petys, np + 1);
    List_push<string>(&f.ptys, "ptr");                    // implicit self
    List_push<string>(&f.petys, cg_cat("*", sp));
    int pi = 0;
    while (pi < np) {
        Param pm = List_get<Param>(&m.params, pi);
        List_push<string>(&f.ptys, cg_lltype(g, pm.ty));
        List_push<string>(&f.petys, cg_apply_sub(g, pm.ty));
        pi = pi + 1;
    }
    List_push<CgFn>(&g.fns, f);
    g.cursub = oldsub;
    return llname;
}

// The function a method call `recv.m(...)` targets, for a receiver of struct `sname`:
// a generic struct instance's method (instantiated on demand), else `Struct_m`.
string cg_method_fn(Codegen* g, string sname, string method) {
    string gm = cg_ensure_method_inst(g, sname, method);
    if (gm[0] != 0) { return gm; }
    return cg_cat(cg_cat(sname, "_"), method);
}

// Emit every queued generic-function instantiation. Bodies may queue further
// instantiations (transitive generics), so iterate until the worklist is exhausted.
void cg_drain_worklist(Codegen* g) {
    while (g.wl_i < List_len<CgInst>(&g.worklist)) {
        int wi = g.wl_i;
        CgInst inst = List_get<CgInst>(&g.worklist, wi);
        if (inst.is_struct == 0) {
            List<CgSub> oldsub = cg_push_sub(g, inst.decl, &inst.args);
            cg_emit_fn(g, inst.decl, inst.mangled, "");
            g.cursub = oldsub;
        } else if (inst.is_struct == 2) {
            List<CgSub> oldsub = cg_push_sub(g, inst.owner, &inst.args);
            cg_emit_fn(g, inst.decl, inst.mangled, inst.self_sp);
            g.cursub = oldsub;
        }
        g.wl_i = g.wl_i + 1;
    }
}

// Value of a plain-enum constant, or "" if `name` isn't one.
string cg_enum_val(Codegen* g, string name) {
    int i = 0; int n = List_len<CgEnumC>(&g.econsts);
    string rv = "";
    while (i < n) {                                        // scan all → LAST definition wins,
        CgEnumC c = List_get<CgEnumC>(&g.econsts, i);     // matching the C++ back-end (a later
        if (cg_streq(c.name, name) == 1) { rv = c.val; }  // `const int X` shadows an earlier one)
        i = i + 1;
    }
    return rv;
}

// How many top-level globals with base name `name` have already been registered — used to
// give a duplicate a unique emitted name (@X, @X.1, …) so clang does not reject a redefinition.
int cg_count_global(Codegen* g, string name) {
    int i = 0; int n = List_len<CgLocal>(&g.gvars); int c = 0;
    while (i < n) { if (cg_streq(List_get<CgLocal>(&g.gvars, i).name, name) == 1) { c = c + 1; } i = i + 1; }
    return c;
}

// Variant name of a match-arm label "Circle(r)" -> "Circle" (or the whole label if no '(').
string cg_arm_var(string label) {
    int n = 0;
    while (label[n] != 0 && (int)label[n] != 40) { n = n + 1; }   // up to '('
    return cg_sub_str(label, 0, n);
}

// Binding names inside a match-arm label: "Rect(w, h)" -> ["w","h"]; "Empty" -> [].
void cg_arm_binds(string label, List<string>* out) {
    int i = 0;
    while (label[i] != 0 && (int)label[i] != 40) { i = i + 1; }   // to '('
    if (label[i] == 0) { return; }
    i = i + 1;
    int start = i;
    while (label[i] != 0) {
        int c = (int)label[i];
        if (c == 41) { if (i > start) { List_push<string>(out, cg_trim(cg_sub_str(label, start, i))); } break; }   // ')'
        if (c == 44) { List_push<string>(out, cg_trim(cg_sub_str(label, start, i))); i = i + 1; start = i; continue; }
        i = i + 1;
    }
}

// Comma-separated items between the first '(' and its matching ')' (paren- and
// '<>'-depth aware, the '>' of a `->` not closing an angle, so a fn-type param
// `fn(int)->int f` and a template arg `Pair<int,double>` stay one item). Each trimmed.
void cg_paren_list(string s, List<string>* out) {
    int i = 0;
    while (s[i] != 0 && (int)s[i] != 40) { i = i + 1; }   // to '('
    if (s[i] == 0) { return; }
    i = i + 1;
    int depth = 1; int start = i; int angle = 0;
    while (s[i] != 0 && depth > 0) {
        int c = (int)s[i];
        if (c == 40) { depth = depth + 1; }
        else if (c == 41) { depth = depth - 1; if (depth == 0) { if (i > start) { List_push<string>(out, cg_trim(cg_sub_str(s, start, i))); } break; } }
        else if (c == 60) { angle = angle + 1; }
        else if (c == 62 && (int)s[i - 1] != 45) { if (angle > 0) { angle = angle - 1; } }
        else if (c == 44 && depth == 1 && angle == 0) { List_push<string>(out, cg_trim(cg_sub_str(s, start, i))); i = i + 1; start = i; continue; }
        i = i + 1;
    }
}

// Last whitespace-separated word of "int x" -> "x"; the rest -> "int" (the declared type).
string cg_last_word(string s) {
    int n = 0; while (s[n] != 0) { n = n + 1; }
    int i = n; while (i > 0 && (int)s[i - 1] != 32) { i = i - 1; }
    return cg_sub_str(s, i, n);
}
string cg_drop_last_word(string s) {
    int n = 0; while (s[n] != 0) { n = n + 1; }
    int i = n; while (i > 0 && (int)s[i - 1] != 32) { i = i - 1; }
    while (i > 0 && (int)s[i - 1] == 32) { i = i - 1; }
    return cg_sub_str(s, 0, i);
}

// Return type of a fn-type spelling: the text after the `->` that follows the
// parameter list's matching ')' ("fn(fn(int)->int)->int64" -> "int64").
string cg_fnty_ret(string t) {
    int n = 0; while (t[n] != 0) { n = n + 1; }
    int i = 0;
    while (i < n && (int)t[i] != 40) { i = i + 1; }
    int depth = 0;
    while (i < n) {
        int c = (int)t[i];
        if (c == 40) { depth = depth + 1; }
        else if (c == 41) {
            depth = depth - 1;
            if (depth == 0) {
                if (i + 2 < n && (int)t[i + 1] == 45 && (int)t[i + 2] == 62) { return cg_trim(cg_sub_str(t, i + 3, n)); }
                return "void";
            }
        }
        i = i + 1;
    }
    return "void";
}

int cg_is_adt(Codegen* g, string name) {
    int i = 0; int n = List_len<string>(&g.adt_names);
    while (i < n) { if (cg_streq(List_get<string>(&g.adt_names, i), name) == 1) { return 1; } i = i + 1; }
    return 0;
}

int cg_is_union(Codegen* g, string name) {
    int i = 0; int n = List_len<string>(&g.union_names);
    while (i < n) { if (cg_streq(List_get<string>(&g.union_names, i), name) == 1) { return 1; } i = i + 1; }
    return 0;
}

// ---- Type layout ----------------------------------------------------------------------
// Sizes and alignments are computed from the LLVM type text this codegen emits, with the
// DataLayout rules of the 64-bit hosts we target (iN/float/double/ptr naturally aligned,
// `{…}` padded per field and rounded to its max field align, `<{…}>` packed, `[N x T]`
// = N elements). Reading the emitted types (not re-deriving from Eskiu spellings) keeps
// `sizeof`, ADT payload slots and union/pack layouts equal to what LLVM (and the C++
// codegen, via DataLayout) sees for bitfield words, arrays, nested enums and unions.

// Emit a named type line `%name = type body` and record its body for the layout queries.
void cg_deftype(Codegen* g, string name, string body) {
    let d: CgSub; d.param = name; d.arg = body;
    List_push<CgSub>(&g.tydefs, d);
    String_append(&g.globals, "%"); String_append(&g.globals, name);
    String_append(&g.globals, " = type "); String_append(&g.globals, body); String_append(&g.globals, "\n");
}

// Body of an emitted named type ("" if not emitted yet).
string cg_tydef_body(Codegen* g, string name) {
    int i = 0; int n = List_len<CgSub>(&g.tydefs);
    while (i < n) {
        CgSub d = List_get<CgSub>(&g.tydefs, i);
        if (cg_streq(d.param, name) == 1) { return d.arg; }
        i = i + 1;
    }
    return "";
}

*DeclNode cg_find_tydecl(Codegen* g, string name) {
    int i = 0; int n = List_len<*DeclNode>(&g.tydecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&g.tydecls, i);
        if (cg_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

void cg_emit_tydecl(Codegen* g, *DeclNode d);                     // fwd: emits a type line on demand
int cg_ll_layout(Codegen* g, string s, int* pos, int* al);        // fwd: mutually recursive

void cg_ll_ws(string s, int* pos) { while ((int)s[pos[0]] == 32) { pos[0] = pos[0] + 1; } }

int cg_ll_num(string s, int* pos) {
    int v = 0;
    while ((int)s[pos[0]] >= 48 && (int)s[pos[0]] <= 57) { v = v * 10 + ((int)s[pos[0]] - 48); pos[0] = pos[0] + 1; }
    return v;
}

int cg_ll_kw(string s, int* pos, string kw) {                    // consume keyword `kw` if present
    int i = 0;
    while (kw[i] != 0) { if (s[pos[0] + i] != kw[i]) { return 0; } i = i + 1; }
    pos[0] = pos[0] + i;
    return 1;
}

// Fields of `{ … }` / `<{ … }>` after the opening brace, through the closing `}`.
int cg_ll_fields(Codegen* g, string s, int* pos, int* al, int pk) {
    int bytes = 0; int maxal = 1;
    cg_ll_ws(s, pos);
    while (s[pos[0]] != 0 && (int)s[pos[0]] != 125) {            // '}'
        int fal = 1;
        int fsz = cg_ll_layout(g, s, pos, &fal);
        if (pk == 1) { fal = 1; }
        if (fal > maxal) { maxal = fal; }
        bytes = cg_align_up(bytes, fal) + fsz;
        cg_ll_ws(s, pos);
        if ((int)s[pos[0]] == 44) { pos[0] = pos[0] + 1; }       // ','
        cg_ll_ws(s, pos);
    }
    if (s[pos[0]] != 0) { pos[0] = pos[0] + 1; }
    al[0] = maxal;
    return cg_align_up(bytes, maxal);
}

// Layout of the named type `%name`, emitting its (pending) declaration first if needed.
int cg_ll_named(Codegen* g, string name, int* al) {
    string body = cg_tydef_body(g, name);
    if (body[0] == 0) {
        *DeclNode d = cg_find_tydecl(g, name);
        if (d != null) { cg_emit_tydecl(g, d); body = cg_tydef_body(g, name); }
    }
    if (body[0] == 0) { al[0] = 8; return 8; }
    int p = 0;
    return cg_ll_layout(g, body, &p, al);
}

// Size of the LLVM type starting at s[*pos] (advancing past it); its ABI alignment → *al.
int cg_ll_layout(Codegen* g, string s, int* pos, int* al) {
    cg_ll_ws(s, pos);
    int c = (int)s[pos[0]];
    al[0] = 1;
    if (c == 123) { pos[0] = pos[0] + 1; return cg_ll_fields(g, s, pos, al, 0); }   // '{'
    if (c == 60) {                                                                  // '<'
        pos[0] = pos[0] + 1; cg_ll_ws(s, pos);
        if ((int)s[pos[0]] == 123) {                                                // packed `<{ … }>`
            pos[0] = pos[0] + 1;
            int psz = cg_ll_fields(g, s, pos, al, 1);
            cg_ll_ws(s, pos); if ((int)s[pos[0]] == 62) { pos[0] = pos[0] + 1; }
            al[0] = 1;
            return psz;
        }
        int vn = cg_ll_num(s, pos); cg_ll_ws(s, pos); cg_ll_kw(s, pos, "x");     // vector `<N x T>`
        int val = 1; int vsz = cg_ll_layout(g, s, pos, &val);
        cg_ll_ws(s, pos); if ((int)s[pos[0]] == 62) { pos[0] = pos[0] + 1; }
        al[0] = vn * vsz;
        return vn * vsz;
    }
    if (c == 91) {                                                                  // '[N x T]'
        pos[0] = pos[0] + 1; cg_ll_ws(s, pos);
        int an = cg_ll_num(s, pos); cg_ll_ws(s, pos); cg_ll_kw(s, pos, "x");
        int eal = 1; int esz = cg_ll_layout(g, s, pos, &eal);
        cg_ll_ws(s, pos); if ((int)s[pos[0]] == 93) { pos[0] = pos[0] + 1; }
        al[0] = eal;
        return an * esz;
    }
    if (c == 37) {                                                                  // '%name'
        pos[0] = pos[0] + 1;
        int st = pos[0];
        while (s[pos[0]] != 0) {
            int ch = (int)s[pos[0]];
            if ((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 95 || ch == 46) {
                pos[0] = pos[0] + 1;
            } else { break; }
        }
        return cg_ll_named(g, cg_sub_str(s, st, pos[0]), al);
    }
    if (c == 105) {                                                                 // 'iN'
        pos[0] = pos[0] + 1;
        int w = cg_ll_num(s, pos);
        int b = 1;
        while (b * 8 < w) { b = b * 2; }
        al[0] = b;
        if (b == 8 && g.i64al < 8) { al[0] = g.i64al; }
        return b;
    }
    if (cg_ll_kw(s, pos, "ptr") == 1) { al[0] = g.ptrsz; return g.ptrsz; }
    if (cg_ll_kw(s, pos, "double") == 1) { al[0] = g.i64al; return 8; }
    if (cg_ll_kw(s, pos, "float") == 1) { al[0] = 4; return 4; }
    if (cg_ll_kw(s, pos, "void") == 1) { return 0; }
    if (s[pos[0]] != 0) { pos[0] = pos[0] + 1; }                                    // unknown: skip
    return 0;
}

int cg_layout_size(Codegen* g, List<string>* fields);   // fwd: mutually recursive with cg_size

int cg_align_up(int x, int a) { return ((x + a - 1) / a) * a; }

// ABI alignment of an Eskiu type (of its LLVM lowering).
int cg_align(Codegen* g, string t) {
    int al = 1; int p = 0;
    cg_ll_layout(g, cg_lltype(g, t), &p, &al);
    return al;
}

// Allocation size of an Eskiu type (of its LLVM lowering), as LLVM's DataLayout gives it.
int cg_size(Codegen* g, string t) {
    int al = 1; int p = 0;
    return cg_ll_layout(g, cg_lltype(g, t), &p, &al);
}

// Natural LLVM size of the literal struct `{ fields }`: each field placed at its
// alignment, the total rounded up to the struct's own (max-field) alignment. This is
// exactly how LLVM lays out the `{ payload fields }` view used to read/write a variant,
// so an ADT enum's `[N x i64]` payload area must hold `cg_layout_size` bytes (the C++
// codegen sizes it the same way, via DataLayout, in makeAdtStruct).
int cg_layout_size(Codegen* g, List<string>* fields) {
    int bytes = 0; int maxal = 1;
    int i = 0; int n = List_len<string>(fields);
    while (i < n) {
        string ft = List_get<string>(fields, i);
        int al = cg_align(g, ft);
        if (al > maxal) { maxal = al; }
        bytes = cg_align_up(bytes, al) + cg_size(g, ft);
        i = i + 1;
    }
    return cg_align_up(bytes, maxal);
}

// The "not found" sentinel returned by the variant lookups below (.ename == "").
CgVariant cg_variant_none(string vname) {
    let none: CgVariant; none.vname = vname; none.ename = ""; none.tag = 0;
    List_init<string>(&none.ptys, 1);
    return none;
}

// Find an ADT variant by name; sentinel with .ename == "" if not a known variant.
CgVariant cg_find_variant(Codegen* g, string vname) {
    int i = 0; int n = List_len<CgVariant>(&g.variants);
    while (i < n) {
        CgVariant v = List_get<CgVariant>(&g.variants, i);
        if (cg_streq(v.vname, vname) == 1) { return v; }
        i = i + 1;
    }
    return cg_variant_none(vname);
}

// Find a variant by name WITHIN a specific (mangled) enum — disambiguates same-named
// variants across generic-enum instantiations (Option_int.Some vs Option_int64.Some).
CgVariant cg_find_variant_in(Codegen* g, string vname, string enumName) {
    int i = 0; int n = List_len<CgVariant>(&g.variants);
    while (i < n) {
        CgVariant v = List_get<CgVariant>(&g.variants, i);
        if (cg_streq(v.vname, vname) == 1 && cg_streq(v.ename, enumName) == 1) { return v; }
        i = i + 1;
    }
    return cg_variant_none(vname);
}

// A generic ADT variant pattern (e.g. Option's `Some(T)`), by variant name.
CgVariant cg_find_gvariant(Codegen* g, string vname) {
    int i = 0; int n = List_len<CgVariant>(&g.gvariants);
    while (i < n) {
        CgVariant v = List_get<CgVariant>(&g.gvariants, i);
        if (cg_streq(v.vname, vname) == 1) { return v; }
        i = i + 1;
    }
    return cg_variant_none(vname);
}

*DeclNode cg_find_genum(Codegen* g, string name) {
    int i = 0; int n = List_len<*DeclNode>(&g.genums);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&g.genums, i);
        if (cg_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

int cg_is_genum(Codegen* g, string name) {
    if (cg_find_genum(g, name) == null) { return 0; }
    return 1;
}

// Monomorphize a generic ADT enum spelling ("Option<int>") into `%Option_int = type
// { i32, [N x i64] }` (N sized by BYTES across variants, type params substituted) and
// register its concrete variants (ename = mangled). Mirrors cg_ensure_struct_inst.
string cg_ensure_enum_inst(Codegen* g, string spelling) {
    spelling = cg_apply_sub(g, spelling);
    string mangled = cg_mangle(spelling);
    if (cg_seen_inst(g, mangled) == 1) { return mangled; }
    string base = cg_gen_base(spelling);
    *DeclNode gd = cg_find_genum(g, base);
    if (gd == null) { return mangled; }
    List_push<string>(&g.inst_seen, mangled);

    List<string> targs; List_init<string>(&targs, 4); cg_gen_args(spelling, &targs);
    List<CgSub> oldsub = g.cursub;
    List_init<CgSub>(&g.cursub, 4);
    int tp = 0; int ntp = List_len<TypeParam>(&gd.type_params);
    while (tp < ntp && tp < List_len<string>(&targs)) {
        let sb: CgSub; sb.param = List_get<TypeParam>(&gd.type_params, tp).name; sb.arg = List_get<string>(&targs, tp);
        List_push<CgSub>(&g.cursub, sb); tp = tp + 1;
    }

    int m = List_len<Param>(&gd.params);
    int slots = 0; int j = 0;
    while (j < m) {
        List<string> pl = List_get<List<string>>(&gd.payloads, j);
        List<string> spl; List_init<string>(&spl, List_len<string>(&pl));
        int k = 0; while (k < List_len<string>(&pl)) { List_push<string>(&spl, cg_apply_sub(g, List_get<string>(&pl, k))); k = k + 1; }
        int isl = (cg_layout_size(g, &spl) + 7) / 8;
        if (isl > slots) { slots = isl; }
        j = j + 1;
    }
    if (slots < 1) { slots = 1; }
    List_push<string>(&g.adt_names, mangled);
    cg_deftype(g, mangled, cg_cat("{ i32, [", cg_cat(cg_itoa(slots), " x i64] }")));

    j = 0;
    while (j < m) {
        let var: CgVariant;
        var.vname = List_get<Param>(&gd.params, j).name;
        var.ename = mangled; var.tag = j;
        List<string> pl = List_get<List<string>>(&gd.payloads, j);
        List_init<string>(&var.ptys, List_len<string>(&pl));
        int k = 0; while (k < List_len<string>(&pl)) { List_push<string>(&var.ptys, cg_apply_sub(g, List_get<string>(&pl, k))); k = k + 1; }
        List_push<CgVariant>(&g.variants, var);
        j = j + 1;
    }
    g.cursub = oldsub;
    return mangled;
}

// LLVM literal struct type for a variant's payload fields, e.g. "{ i32, i32 }" — used to
// view the tagged union's [N x i64] storage as the variant's fields for load/store.
string cg_payload_lltype(Codegen* g, CgVariant* v) {
    String t; String_init(&t, 16);
    String_append(&t, "{ ");
    int i = 0; int n = List_len<string>(&v.ptys);
    while (i < n) {
        if (i > 0) { String_append(&t, ", "); }
        String_append(&t, cg_lltype(g, List_get<string>(&v.ptys, i)));
        i = i + 1;
    }
    String_append(&t, " }");
    return (string)String_cstr(&t);
}

int cg_is_unsigned(string t);   // fwd (defined later); for signedness-aware widening
int cg_is_fn(Codegen* g, string name);
string cg_fn_to_closure(Codegen* g, string fnname);   // fwd: decay a top-level fn to a {thunk,null} closure
string cg_cabi_callback(Codegen* g, string name);     // fwd: a top-level fn as a raw C callback address

// Coerce a value to a target LLVM type, emitting the conversion if needed; returns the
// operand to use. Mirrors the casts in EK_CAST — for ABI-correct call arguments (e.g. an
// i32 count passed to an `int64 n` parameter must be widened, not reinterpreted).
string cg_coerce(Codegen* g, CgVal val, string target) {
    // A bare top-level function used where a closure is expected (`apply2(add, …)`): decay
    // it to a fat pointer {__fnptr_<name>, null} (the thunk drops the closure env arg). A
    // function used as a raw pointer (`(*void)cmp`) is just `@name` (target "ptr" below).
    if (cg_streq(target, "%closure") == 1 && (int)val.op[0] == 64) {   // op is "@name"
        int ln = 0; while (val.op[ln] != 0) { ln = ln + 1; }
        string fnm = cg_sub_str(val.op, 1, ln);
        if (cg_is_fn(g, fnm) == 1) { return cg_fn_to_closure(g, fnm); }
    }
    if (cg_streq(val.ty, target) == 1) { return val.op; }
    int tptr = cg_streq(target, "ptr"); int sptr = cg_streq(val.ty, "ptr");
    if (tptr == 1 && sptr == 1) { return val.op; }
    int tf = cg_is_float(target); int sf = cg_is_float(val.ty);
    int tw = cg_int_w(target); int sw = cg_int_w(val.ty);
    if (tf == 0 && sf == 0 && tw == 0 && sw == 0) { return val.op; }   // non-scalar (struct)
    string t = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = ");
    if (tw == 1) {                                        // to bool: `!= 0`, never a truncation
        if (sf == 1) { cg_emit(g, "fcmp une "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, ", 0.0"); }
        else if (sptr == 1) { cg_emit(g, "icmp ne ptr "); cg_emit(g, val.op); cg_emit(g, ", null"); }
        else { cg_emit(g, "icmp ne "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, ", 0"); }
    }
    else if (tf == 1 && sw > 0) {                              // int→float: unsigned source uses uitofp
        if (cg_is_unsigned(val.ety) == 1) { cg_emit(g, "uitofp "); } else { cg_emit(g, "sitofp "); }
        cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, " to "); cg_emit(g, target);
    }
    else if (tw > 0 && sf == 1) { cg_emit(g, "fptosi "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, " to "); cg_emit(g, target); }
    else if (tf == 1 && sf == 1) {                        // float<->double
        if (cg_streq(target, "double") == 1) { cg_emit(g, "fpext "); } else { cg_emit(g, "fptrunc "); }
        cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, " to "); cg_emit(g, target);
    }
    else if (tptr == 1 && sw > 0) { cg_emit(g, "inttoptr "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, " to ptr"); }
    else if (sptr == 1 && tw > 0) { cg_emit(g, "ptrtoint ptr "); cg_emit(g, val.op); cg_emit(g, " to "); cg_emit(g, target); }
    else if (tw > 0 && sw > 0 && tw < sw) { cg_emit(g, "trunc "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, " to "); cg_emit(g, target); }
    else if (sw == 1 && tw > 1) { cg_emit(g, "zext "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, " to "); cg_emit(g, target); }  // bool→int is 0/1
    else if (tw > 0 && sw > 0 && tw > sw) {   // widen — honor the SOURCE's signedness (unsigned → zext)
        if (cg_is_unsigned(val.ety) == 1) { cg_emit(g, "zext "); } else { cg_emit(g, "sext "); }
        cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, " to "); cg_emit(g, target);
    }
    else { cg_emit(g, "bitcast "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, " to "); cg_emit(g, target); }
    cg_emit(g, "\n");
    return t;
}

// The declared LLVM type of parameter `i` (0-based) of `f`, or "" if out of range.
string cg_pty(CgFn* f, int i) {
    if (i < 0 || i >= List_len<string>(&f.ptys)) { return ""; }
    return List_get<string>(&f.ptys, i);
}

// The declared Eskiu type of parameter `i` (0-based) of `f`, or "" if out of range.
string cg_pety(CgFn* f, int i) {
    if (i < 0 || i >= List_len<string>(&f.petys)) { return ""; }
    return List_get<string>(&f.petys, i);
}

// Is `name` a declared interface type?
int cg_is_iface(Codegen* g, string name) {
    int i = 0; int n = List_len<CgIface>(&g.ifaces);
    while (i < n) { if (cg_streq(List_get<CgIface>(&g.ifaces, i).name, name) == 1) { return 1; } i = i + 1; }
    return 0;
}

CgIface cg_find_iface(Codegen* g, string name) {
    int i = 0; int n = List_len<CgIface>(&g.ifaces);
    while (i < n) {
        CgIface f = List_get<CgIface>(&g.ifaces, i);
        if (cg_streq(f.name, name) == 1) { return f; }
        i = i + 1;
    }
    let e: CgIface; e.name = ""; List_init<string>(&e.mnames, 1); List_init<string>(&e.mrets, 1);
    List_init<List<string>>(&e.mparams, 1);
    return e;
}

// Index of method `m` in interface `f`'s method order, or -1.
int cg_iface_midx(CgIface* f, string m) {
    int i = 0; int n = List_len<string>(&f.mnames);
    while (i < n) { if (cg_streq(List_get<string>(&f.mnames, i), m) == 1) { return i; } i = i + 1; }
    return -1;
}

CgFn cg_find_fn(Codegen* g, string name) {
    int i = 0; int n = List_len<CgFn>(&g.fns);
    while (i < n) {
        CgFn f = List_get<CgFn>(&g.fns, i);
        if (cg_streq(f.name, name) == 1) { return f; }
        i = i + 1;
    }
    let none: CgFn; none.name = name; none.retty = "i32"; none.rety = ""; none.variadic = 0; none.fixedtypes = "";
    List_init<string>(&none.ptys, 1);
    return none;
}

// Is `name` a registered top-level function (free fn or extern, not a struct method)?
int cg_is_fn(Codegen* g, string name) {
    int i = 0; int n = List_len<CgFn>(&g.fns);
    while (i < n) { if (cg_streq(List_get<CgFn>(&g.fns, i).name, name) == 1) { return 1; } i = i + 1; }
    return 0;
}

// Build a closure fat pointer {@__fnptr_<name>, null} for a top-level function used as a
// value where a `fn(...)->R` is expected. The thunk (queued, emitted once via
// cg_drain_thunks) drops the closure's leading env arg and forwards to the real function.
string cg_fn_to_closure(Codegen* g, string fnname) {
    if (cg_seen_inst(g, cg_cat("thunk:", fnname)) == 0) {
        List_push<string>(&g.inst_seen, cg_cat("thunk:", fnname));
        List_push<string>(&g.fnthunks, fnname);
    }
    string c1 = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, c1); cg_emit(g, " = insertvalue %closure undef, ptr @__fnptr_");
    cg_emit(g, fnname); cg_emit(g, ", 0\n");
    string c2 = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, c2); cg_emit(g, " = insertvalue %closure "); cg_emit(g, c1);
    cg_emit(g, ", ptr null, 1\n");
    return c2;
}

void cg_emit_cabi_thunk(Codegen* g, string name);   // fwd: a C-ABI callback thunk

// Emit one `__fnptr_<name>` thunk: `R __fnptr_f(ptr env, <params>) { return f(<params>); }`.
// A `cabi:<name>` entry is a C-ABI callback thunk instead (cg_cabi_callback).
void cg_emit_thunk(Codegen* g, string fnname) {
    int fl = 0; while (fnname[fl] != 0) { fl = fl + 1; }
    if (fl > 5 && cg_streq(cg_sub_str(fnname, 0, 5), "cabi:") == 1) {
        cg_emit_cabi_thunk(g, cg_sub_str(fnname, 5, fl));
        return;
    }
    CgFn f = cg_find_fn(g, fnname);
    int np = List_len<string>(&f.ptys);
    CgCabi cab = cg_find_cabi(g, fnname);
    if (cab.name[0] != 0) {                             // a C-ABI extern: lower inside the thunk
        cg_emit(g, "define "); cg_emit(g, f.retty); cg_emit(g, " @__fnptr_"); cg_emit(g, fnname); cg_emit(g, "(ptr %e");
        List<CgVal> targs; List_init<CgVal>(&targs, np);
        int ti = 0;
        while (ti < np) {
            let ta: CgVal; ta.ty = List_get<string>(&f.ptys, ti); ta.op = cg_cat("%a", cg_itoa(ti)); ta.ety = "";
            cg_emit(g, ", "); cg_emit(g, ta.ty); cg_emit(g, " "); cg_emit(g, ta.op);
            List_push<CgVal>(&targs, ta);
            ti = ti + 1;
        }
        cg_emit(g, ") {
");
        String_init(&g.entry_buf, 128);
        String saved = g.out;
        String_init(&g.out, 256);
        CgVal r = cg_cabi_call(g, &cab, &f, &targs);
        if (cg_streq(f.retty, "void") == 1) { cg_emit(g, "  ret void
"); }
        else { cg_emit(g, "  ret "); cg_emit(g, f.retty); cg_emit(g, " "); cg_emit(g, r.op); cg_emit(g, "
"); }
        string bodytext = (string)String_cstr(&g.out);
        g.out = saved;
        cg_emit(g, "entry:
");
        cg_emit(g, (string)String_cstr(&g.entry_buf));
        cg_emit(g, bodytext);
        cg_emit(g, "}

");
        return;
    }
    cg_emit(g, "define "); cg_emit(g, f.retty); cg_emit(g, " @__fnptr_"); cg_emit(g, fnname); cg_emit(g, "(ptr %e");
    string args = "";
    int i = 0;
    while (i < np) {
        string pt = List_get<string>(&f.ptys, i);
        cg_emit(g, ", "); cg_emit(g, pt); cg_emit(g, " %a"); cg_emit(g, cg_itoa(i));
        if (i > 0) { args = cg_cat(args, ", "); }
        args = cg_cat(args, cg_cat(pt, cg_cat(" %a", cg_itoa(i))));
        i = i + 1;
    }
    cg_emit(g, ") {\n");
    if (cg_streq(f.retty, "void") == 1) {
        cg_emit(g, "  call void @"); cg_emit(g, fnname); cg_emit(g, "("); cg_emit(g, args); cg_emit(g, ")\n");
        cg_emit(g, "  ret void\n}\n\n");
    } else {
        cg_emit(g, "  %r = call "); cg_emit(g, f.retty); cg_emit(g, " @"); cg_emit(g, fnname);
        cg_emit(g, "("); cg_emit(g, args); cg_emit(g, ")\n");
        cg_emit(g, "  ret "); cg_emit(g, f.retty); cg_emit(g, " %r\n}\n\n");
    }
}

void cg_drain_thunks(Codegen* g) {
    while (g.thk_i < List_len<string>(&g.fnthunks)) { cg_emit_thunk(g, List_get<string>(&g.fnthunks, g.thk_i)); g.thk_i = g.thk_i + 1; }
}

// Emit a runtime `declare` once for a libc/pthread symbol the codegen calls directly
// (pthread_create/join, free). Skips it if the symbol is already a declared extern.
void cg_ensure_extern(Codegen* g, string name, string decl) {
    if (cg_is_fn(g, name) == 1) { return; }
    if (cg_seen_inst(g, cg_cat("decl:", name)) == 1) { return; }
    List_push<string>(&g.inst_seen, cg_cat("decl:", name));
    String_append(&g.globals, decl);
}

void cg_emit(Codegen* g, string s) { String_append(&g.out, s); }

// Emit a `call` — or, inside a try body (cur_unwind set), an `invoke` that routes
// unwinding to the landingpad and continues in a fresh block. Returns the result temp
// ("" for a void call). `callty` is the call type (ret type, or a variadic fn type),
// `target` the callee (`@name` or `%fp`).
string cg_emit_callish(Codegen* g, string callty, string target, string args, int isvoid) {
    string t = "";
    cg_emit(g, "  ");
    if (isvoid == 0) { t = cg_tmp(g); cg_emit(g, t); cg_emit(g, " = "); }
    if (g.cur_unwind[0] != 0) {
        string cont = cg_lbl(g);
        cg_emit(g, "invoke "); cg_emit(g, callty); cg_emit(g, " "); cg_emit(g, target);
        cg_emit(g, "("); cg_emit(g, args); cg_emit(g, ") to label %"); cg_emit(g, cont);
        cg_emit(g, " unwind label %"); cg_emit(g, g.cur_unwind); cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, cont);
    } else {
        cg_emit(g, "call "); cg_emit(g, callty); cg_emit(g, " "); cg_emit(g, target);
        cg_emit(g, "("); cg_emit(g, args); cg_emit(g, ")\n");
    }
    return t;
}

// Collect every identifier referenced in an expr/stmt subtree (for a lambda's free-
// variable analysis — the captures are those that are enclosing locals).
void cg_collect_idents_e(*ExprNode e, List<string>* out) {
    if (e == null) { return; }
    if (e.kind == EK_IDENT) { List_push<string>(out, e.sval); return; }
    // Recurse only into the sub-expr fields each kind populates (an unset field is now null,
    // not garbage, but reading a child a kind never sets is still a wrong-subtree bug).
    if (e.kind == EK_BINARY || e.kind == EK_INDEX) { cg_collect_idents_e(e.a, out); cg_collect_idents_e(e.b, out); }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST
             || e.kind == EK_QUESTION || e.kind == EK_AWAIT || e.kind == EK_CALL
             || e.kind == EK_INCDEC) { cg_collect_idents_e(e.a, out); }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX) {   // EK_INDEX kids = a slice's hi bound
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { cg_collect_idents_e(List_get<*ExprNode>(&e.kids, i), out); i = i + 1; }
    }
    if (e.kind == EK_TERNARY) {                        // cond (a) + then (b) + else (kids[0])
        cg_collect_idents_e(e.a, out); cg_collect_idents_e(e.b, out);
        cg_collect_idents_e(List_get<*ExprNode>(&e.kids, 0), out);
    }
    if (e.kind == EK_LAMBDA) {
        // A lambda's identifiers are the same wherever it is walked from, so they are
        // collected once and replayed; otherwise each enclosing lambda would walk the
        // nested ones again (quadratic in the nesting depth).
        if (e.ids_done == 0) {
            List_init<string>(&e.ids_memo, 8);
            cg_collect_idents_s(e.stmt, &e.ids_memo);
            e.ids_done = 1;
        }
        int j = 0; int m = List_len<string>(&e.ids_memo);
        while (j < m) { List_push<string>(out, List_get<string>(&e.ids_memo, j)); j = j + 1; }
    }
}
void cg_collect_idents_s(*StmtNode s, List<string>* out) {
    if (s == null) { return; }
    if (s.kind == SK_RETURN || s.kind == SK_EXPR || s.kind == SK_THROW || s.kind == SK_VARDECL
        || s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH) {
        cg_collect_idents_e(s.expr, out);
    }
    if (s.kind == SK_FOR) { cg_collect_idents_e(s.expr2, out); }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH) { cg_collect_idents_s(s.s1, out); }
    if (s.kind == SK_IF || s.kind == SK_FOR) { cg_collect_idents_s(s.s2, out); }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH
        || s.kind == SK_TRY) {
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { cg_collect_idents_s(List_get<*StmtNode>(&s.items, i), out); i = i + 1; }
    }
    if (s.kind == SK_TRY) { cg_collect_idents_s(s.s1, out); cg_collect_idents_s(s.s2, out); }
    if (s.kind == SK_DEFER) { cg_collect_idents_s(s.s1, out); }
}

// The LLVM literal struct type holding a closure's captured variables, e.g. "{ i32, double }".
string cg_env_lltype(Codegen* g, List<string>* capt) {
    String t; String_init(&t, 16);
    String_append(&t, "{ ");
    int i = 0; int n = List_len<string>(capt);
    while (i < n) {
        if (i > 0) { String_append(&t, ", "); }
        String_append(&t, cg_lltype(g, List_get<string>(capt, i)));
        i = i + 1;
    }
    String_append(&t, " }");
    return (string)String_cstr(&t);
}

// Mutually-recursive: expr (rvalue) ↔ lval (address of an lvalue).
CgVal cg_expr(Codegen* g, *ExprNode e);
CgVal cg_binary_builtin(Codegen* g, *ExprNode e, CgVal l);
CgVal cg_unary_apply(Codegen* g, *ExprNode e, CgVal operand);
CgVal cg_cond_val(Codegen* g, CgVal c);
CgVal cg_lval(Codegen* g, *ExprNode e);
CgVal cg_addr(Codegen* g, *ExprNode e);   // fwd: address for a read (materializes an rvalue)
string cg_etype(Codegen* g, *ExprNode e);
string cg_ensure_struct_inst(Codegen* g, string spelling);   // monomorphize a generic struct
CgVal cg_build_variant(Codegen* g, CgVariant var, *ExprNode call);   // construct an ADT value
CgVal cg_emit_atomic(Codegen* g, string nm, *ExprNode e);            // atomic intrinsic
CgVal cg_indirect_call(Codegen* g, string cval, string fnty, *ExprNode e);  // call a closure value
CgVal cg_call_mangled(Codegen* g, string mangled, *ExprNode e);      // call a monomorphized fn
string cg_box_iface(Codegen* g, string ifaceName, string structName, string dataop);  // struct → interface fat ptr
CgVal cg_dispatch_iface(Codegen* g, string ifaceName, string fatop, string method, *ExprNode e);  // vtable dispatch
string cg_member_baseptr(Codegen* g, *ExprNode ea, *string out_sname);  // struct ptr + name
CgBF cg_bf(Codegen* g, string sname, string fname);
string cg_bf_read_ety(Codegen* g, CgBF slot);   // fwd
string cg_bf_wordptr(Codegen* g, string baseptr, string sname, CgBF slot);   // fwd
string cg_infer_generic(Codegen* g, *DeclNode gd, *ExprNode e);      // infer `name<args>` from arg types
void cg_collect_idents_e(*ExprNode e, List<string>* out);
void cg_collect_idents_s(*StmtNode s, List<string>* out);
string cg_ensure_fn_inst(Codegen* g, string spelling);       // monomorphize a generic function
void cg_emit_fn(Codegen* g, *DeclNode d, string llname, string self_struct);

int cg_strlen(string s) { int i = 0; while (s[i] != 0) { i = i + 1; } return i; }

int cg_hexd(int d) { if (d < 10) { return 48 + d; } return 55 + d; }   // 0-9, A-F

string cg_hex2(int b) {
    *uint8 buf = alloc<uint8>(3);
    buf[0] = (uint8)cg_hexd((b / 16) % 16);
    buf[1] = (uint8)cg_hexd(b % 16);
    buf[2] = 0;
    return (string)buf;
}

// Emit a private string-literal constant for `s` and return its global name (a `ptr`).
// Bytes are LLVM-escaped: printables verbatim, `"`/`\`/non-printables as \NN, + a NUL.
string cg_string_global(Codegen* g, string s) { return cg_string_global_n(g, s, cg_strlen(s)); }

// As cg_string_global, but with an explicit byte length so a literal with an embedded
// NUL (`"a\0b"`) emits all its bytes instead of truncating at the first zero.
string cg_string_global_n(Codegen* g, string s, int len) {
    string name = cg_cat("@.str", cg_itoa(g.strcount));
    g.strcount = g.strcount + 1;
    String_append(&g.globals, name);
    String_append(&g.globals, " = private unnamed_addr constant [");
    String_append(&g.globals, cg_itoa(len + 1));
    String_append(&g.globals, " x i8] c\"");
    int i = 0;
    while (i < len) {
        int b = (int)s[i];
        if (b < 0) { b = b + 256; }
        if (b >= 32 && b <= 126 && b != 34 && b != 92) {
            String_push(&g.globals, (char)b);
        } else {
            String_push(&g.globals, '\\');
            String_append(&g.globals, cg_hex2(b));
        }
        i = i + 1;
    }
    String_append(&g.globals, "\\00\"\n");
    return name;
}

// Variadic parameter list: "<fixed>, ..." (or just "..." when there are no fixed types).
string cg_va(string fixed) {
    if (fixed[0] == 0) { return "..."; }
    return cg_cat(fixed, ", ...");
}

string cg_tmp(Codegen* g) {
    string r = cg_cat("%t", cg_itoa(g.next));
    g.next = g.next + 1;
    return r;
}

string cg_lbl(Codegen* g) {
    string r = cg_cat("L", cg_itoa(g.next));
    g.next = g.next + 1;
    return r;
}

// Start a new basic block (resets the terminated flag).
void cg_label(Codegen* g, string name) {
    cg_emit(g, name); cg_emit(g, ":\n");
    g.terminated = 0;
    g.cur_lbl = name;
}

// Unconditional branch — skipped if the block is already terminated.
void cg_br(Codegen* g, string target) {
    if (g.terminated == 1) { return; }
    cg_emit(g, "  br label %"); cg_emit(g, target); cg_emit(g, "\n");
    g.terminated = 1;
}

void cg_stmt(Codegen* g, *StmtNode st);

// Emit each pending cleanup body in frames at index >= depth, LIFO. On a normal exit
// (error_path 0) errdefer bodies are skipped; the `?`-propagation error path passes 1
// so both run. Does not shrink the stack — the owning scope truncates when it ends.
void cg_run_cleanups(Codegen* g, int depth, int error_path) {
    int i = List_len<*StmtNode>(&g.cleanups) - 1;
    while (i >= depth) {
        if (g.terminated == 1) { return; }
        if (List_get<int>(&g.cl_err, i) == 1 && error_path == 0) { i = i - 1; }
        else {
            // A cleanup body sees the names that were visible where it was registered,
            // not a later shadowing declaration: re-bind those locals on top, emit, drop.
            int base = List_len<CgLocal>(&g.locals);
            int nvis = List_get<int>(&g.cl_nloc, i);
            int k = 0;
            while (k < nvis && k < base) { List_push<CgLocal>(&g.locals, List_get<CgLocal>(&g.locals, k)); k = k + 1; }
            string unw = g.cur_unwind;                   // the body runs under the landingpad
            g.cur_unwind = List_get<string>(&g.cl_unw, i);   // active before it was registered
            cg_stmt(g, List_get<*StmtNode>(&g.cleanups, i));
            g.cur_unwind = unw;
            cg_locals_trunc(g, base);
            i = i - 1;
        }
    }
}

// Register a cleanup (a defer/errdefer body or a `finally`) for the current scope.
void cg_push_cleanup(Codegen* g, *StmtNode body, int is_err) {
    List_push<*StmtNode>(&g.cleanups, body);
    List_push<int>(&g.cl_err, is_err);
    List_push<int>(&g.cl_nloc, List_len<CgLocal>(&g.locals));
    List_push<string>(&g.cl_unw, g.cur_unwind);
}

// Drop cleanup entries down to length `mark` (called on scope exit). Past the scope, calls
// unwind to the landingpad that was active before its first cleanup again.
void cg_cleanups_trunc(Codegen* g, int mark) {
    if (List_len<*StmtNode>(&g.cleanups) > mark) { g.cur_unwind = List_get<string>(&g.cl_unw, mark); }
    while (List_len<*StmtNode>(&g.cleanups) > mark) {
        List_remove<*StmtNode>(&g.cleanups, List_len<*StmtNode>(&g.cleanups) - 1);
        List_remove<int>(&g.cl_err, List_len<int>(&g.cl_err) - 1);
        List_remove<int>(&g.cl_nloc, List_len<int>(&g.cl_nloc) - 1);
        List_remove<string>(&g.cl_unw, List_len<string>(&g.cl_unw) - 1);
    }
}

// The landingpad for the calls after a defer (only in a program that throws). Inside a
// try body it catches everything, runs the pending cleanups down to that try and joins
// its catch dispatch with the exception pointer; outside any try it is a cleanup pad
// that runs the function's pending cleanups and resumes unwinding.
void cg_defer_pad(Codegen* g) {
    string cont = cg_lbl(g);
    string pad = cg_lbl(g);
    cg_br(g, cont);
    cg_label(g, pad);
    int nt = List_len<int>(&g.try_cld);
    string lp = cg_tmp(g);
    string ex = "";
    int depth = 0;
    if (nt > 0) {
        cg_emit(g, "  "); cg_emit(g, lp); cg_emit(g, " = landingpad { ptr, i32 } catch ptr null\n");
        ex = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, ex); cg_emit(g, " = extractvalue { ptr, i32 } "); cg_emit(g, lp); cg_emit(g, ", 0\n");
        depth = List_get<int>(&g.try_cld, nt - 1);
    } else {
        cg_emit(g, "  "); cg_emit(g, lp); cg_emit(g, " = landingpad { ptr, i32 } cleanup\n");
    }
    cg_run_cleanups(g, depth, 0);
    if (g.terminated == 0) {
        if (nt > 0) {
            string inc = cg_cat(", [ ", cg_cat(ex, cg_cat(", %", cg_cat(g.cur_lbl, " ]"))));
            List_set<string>(&g.try_phi, nt - 1, cg_cat(List_get<string>(&g.try_phi, nt - 1), inc));
            cg_emit(g, "  br label %"); cg_emit(g, List_get<string>(&g.try_disp, nt - 1)); cg_emit(g, "\n");
        } else {
            cg_emit(g, "  resume { ptr, i32 } "); cg_emit(g, lp); cg_emit(g, "\n");
        }
        g.terminated = 1;
    }
    cg_label(g, cont);
    g.cur_unwind = pad;
}

// Does a subtree contain a `throw` or a `try` (lambda bodies included)? Decides prog_eh.
int cg_has_eh_s(*StmtNode s);
int cg_has_eh_e(*ExprNode e) {
    if (e == null) { return 0; }
    if (e.kind == EK_LAMBDA) { return cg_has_eh_s(e.stmt); }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX) {
        if (cg_has_eh_e(e.a) == 1 || cg_has_eh_e(e.b) == 1) { return 1; }
    } else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST
               || e.kind == EK_QUESTION || e.kind == EK_AWAIT || e.kind == EK_CALL
               || e.kind == EK_INCDEC) {
        if (cg_has_eh_e(e.a) == 1) { return 1; }
    }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX) {
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { if (cg_has_eh_e(List_get<*ExprNode>(&e.kids, i)) == 1) { return 1; } i = i + 1; }
    }
    if (e.kind == EK_TERNARY) {
        if (cg_has_eh_e(e.a) == 1 || cg_has_eh_e(e.b) == 1) { return 1; }
        if (cg_has_eh_e(List_get<*ExprNode>(&e.kids, 0)) == 1) { return 1; }
    }
    return 0;
}
int cg_has_eh_s(*StmtNode s) {
    if (s == null) { return 0; }
    if (s.kind == SK_THROW || s.kind == SK_TRY) { return 1; }
    if (s.kind == SK_RETURN || s.kind == SK_EXPR || s.kind == SK_VARDECL
        || s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH) {
        if (cg_has_eh_e(s.expr) == 1) { return 1; }
    }
    if (s.kind == SK_FOR) { if (cg_has_eh_e(s.expr2) == 1) { return 1; } }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_DOWHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_DEFER) {
        if (cg_has_eh_s(s.s1) == 1) { return 1; }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR) { if (cg_has_eh_s(s.s2) == 1) { return 1; } }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE || s.kind == SK_MATCH) {
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (cg_has_eh_s(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
    }
    return 0;
}

// Drop local bindings down to length `mark` (a block/loop scope ends: an inner `let`
// that shadowed an outer one goes away and the outer binding is visible again).
void cg_locals_trunc(Codegen* g, int mark) {
    while (List_len<CgLocal>(&g.locals) > mark) { List_remove<CgLocal>(&g.locals, List_len<CgLocal>(&g.locals) - 1); }
}

// Emit a statement body as its own scope (locals + defer cleanups), even a single
// unbraced statement (`if (c) defer f();`, an unbraced loop body or match arm), so a
// `defer` in it runs when that body ends (mirrors CodeGen::emitScopedBody).
void cg_scoped_stmt(Codegen* g, *StmtNode st) {
    if (st == null) { return; }
    if (st.kind == SK_BLOCK) { cg_stmt(g, st); return; }
    int mark = List_len<*StmtNode>(&g.cleanups);
    int lmark = List_len<CgLocal>(&g.locals);
    cg_stmt(g, st);
    if (g.terminated == 0) { cg_run_cleanups(g, mark, 0); }
    cg_cleanups_trunc(g, mark);
    cg_locals_trunc(g, lmark);
}

// An expression with no side effects: evaluating it twice is the same as once.
int cg_is_pure(*ExprNode e) {
    if (e == null) { return 1; }
    if (e.kind == EK_IDENT || e.kind == EK_LITERAL || e.kind == EK_SIZEOF) { return 1; }
    if (e.kind == EK_MEMBER || e.kind == EK_UNARY || e.kind == EK_CAST) { return cg_is_pure(e.a); }
    if (e.kind == EK_INDEX) {
        if (cg_is_pure(e.a) == 0 || cg_is_pure(e.b) == 0) { return 0; }
        int i = 0; while (i < List_len<*ExprNode>(&e.kids)) { if (cg_is_pure(List_get<*ExprNode>(&e.kids, i)) == 0) { return 0; } i = i + 1; }
        return 1;
    }
    if (e.kind == EK_BINARY) {
        if (cg_streq(e.sval, "=") == 1) { return 0; }
        if (cg_is_pure(e.a) == 0) { return 0; }
        return cg_is_pure(e.b);
    }
    return 0;
}

int cg_is_struct(Codegen* g, string name) {
    int i = 0; int n = List_len<CgStruct>(&g.structs);
    while (i < n) { if (cg_streq(List_get<CgStruct>(&g.structs, i).name, name) == 1) { return 1; } i = i + 1; }
    return 0;
}

// Eskiu type spelling → LLVM type. Pointers (anything with `*`) lower to opaque `ptr`;
// a registered struct name → its named type `%Name`.
// Drop a leading `?` (the checked-nullable marker on `?*T`). It is a sema-only concept:
// `?*T` lowers exactly like `*T`, so every type-inspection entry normalizes it away.
string cg_strip_nullable(string t) {
    if ((int)t[0] == 63) { return cg_sub_str(t, 1, cg_strlen(t)); }   // '?'
    return t;
}

int cg_arr_open(string t);   // fwd
string cg_lltype(Codegen* g, string t) {
    t = cg_strip_nullable(t);            // `?*T` lowers as `*T`
    t = cg_apply_sub(g, t);               // T -> concrete during instantiation
    t = cg_dealias(g, t);                 // type alias -> underlying type
    // fn(...)->R first: its parameter / return spellings may hold `<`, `[` or `*`
    // (`fn(Box<int>)->int`), which are not the fn type's own shape.
    if (cg_is_fnty(t) == 1 && cg_arr_open(t) < 0) { return "%closure"; }   // fn(...)->R → fat pointer {fn,env}
    if (cg_is_slice(t) == 1) { return "{ ptr, i64 }"; }   // "T[]" -> fat pointer { data, len }
    if (cg_is_array(t) == 1) {            // "T[N]" -> [N x <T>]
        string cnt = cg_dim_val(g, cg_array_count(t));   // a named or folded dimension
        return cg_cat("[", cg_cat(cnt, cg_cat(" x ",
                       cg_cat(cg_lltype(g, cg_array_elem(t)), "]"))));
    }
    if (cg_is_fnty(t) == 1) { return "%closure"; }         // fn(...)->R → fat pointer {fn,env}
    if (cg_is_ptr_ty(t) == 1) { return "ptr"; }   // top-level '*' (not one inside <...>)
    if (cg_has_targs(t) == 1) {           // "Box<int>" / "Option<int>" -> monomorphize
        if (cg_is_genum(g, cg_gen_base(t)) == 1) { return cg_cat("%", cg_ensure_enum_inst(g, t)); }
        return cg_cat("%", cg_ensure_struct_inst(g, t));
    }
    if (cg_streq(t, "void") == 1) { return "void"; }
    if (cg_streq(t, "bool") == 1) { return "i1"; }
    if (cg_streq(t, "char") == 1 || cg_streq(t, "int8") == 1 || cg_streq(t, "uint8") == 1) { return "i8"; }
    if (cg_streq(t, "int16") == 1 || cg_streq(t, "uint16") == 1) { return "i16"; }
    if (cg_streq(t, "int64") == 1 || cg_streq(t, "uint64") == 1) { return "i64"; }
    if (cg_streq(t, "float") == 1) { return "float"; }
    if (cg_streq(t, "double") == 1) { return "double"; }
    if (cg_streq(t, "string") == 1) { return "ptr"; }
    if (cg_streq(t, "va_list") == 1) {                     // {ptr,ptr,ptr,i32,i32} (AArch64 layout, x86-64 superset)
        if (cg_seen_inst(g, "type:__va_list") == 0) {
            List_push<string>(&g.inst_seen, "type:__va_list");
            cg_deftype(g, "__va_list", "{ ptr, ptr, ptr, i32, i32 }");
        }
        return "%__va_list";
    }
    if (cg_is_iface(g, t) == 1) { return "%iface_fat"; }   // interface value = fat {data, vtable}, by value
    if (cg_is_struct(g, t) == 1) { return cg_cat("%", t); }
    if (cg_is_adt(g, t) == 1) { return cg_cat("%", t); }   // ADT enum → tagged-union type
    return "i32";   // int/int32/uint/... and the default
}

// The pointee/base name of a pointer type, stripping '*' and spaces from BOTH ends
// (Eskiu writes pointers either way: "*P" and "P*"). "*P"/"P*" -> "P".
string cg_strip_ptr(string t) {
    t = cg_strip_nullable(t);
    int a = 0;
    while ((int)t[a] == 42 || (int)t[a] == 32) { a = a + 1; }
    int b = 0; while (t[b] != 0) { b = b + 1; }
    while (b > a && ((int)t[b - 1] == 42 || (int)t[b - 1] == 32)) { b = b - 1; }
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0; while (k < len) { buf[k] = (uint8)t[a + k]; k = k + 1; }
    buf[len] = 0;
    return (string)buf;
}

// Bit width of an LLVM integer type string ("i32"->32), or 0 if not an integer.
int cg_int_w(string t) {
    if ((int)t[0] != 105) { return 0; }                  // not 'i...'
    int w = 0; int i = 1;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (c < 48 || c > 57) { return 0; }
        w = w * 10 + (c - 48); i = i + 1;
    }
    return w;
}

// Pointee of a pointer type — strips exactly ONE '*' (the outermost, either end). For
// indexing/deref: `**ExprNode`→`*ExprNode`, `*int`→`int`, `int*`→`int`. Distinct from
// cg_strip_ptr, which strips ALL '*' to recover a struct's base name.
string cg_deref_ty(string t) {
    t = cg_strip_nullable(t);                             // `?*T` derefs like `*T`
    if (cg_streq(t, "string") == 1) { return "char"; }    // string = *char → element is a char
    int b = 0; while (t[b] != 0) { b = b + 1; }
    if (b > 0 && (int)t[b - 1] == 42) { return cg_sub_str(t, 0, b - 1); }   // trailing '*'
    int a = 0; while ((int)t[a] == 32) { a = a + 1; }
    if ((int)t[a] == 42) {                                                  // leading '*'
        string r = cg_sub_str(t, a + 1, b);
        return cg_trim(r);
    }
    return t;
}

// Is `t` a pointer type? Only a '*' at the TOP level counts — a '*' nested inside generic
// args (`List<*ExprNode>`) belongs to a type argument, not the outer type, which is a
// generic struct (value), not a pointer.
int cg_is_ptr_ty(string t) {
    t = cg_strip_nullable(t);
    int depth = 0; int i = 0;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (c == 60 || c == 40) { depth = depth + 1; }       // '<' or '(' (generics / fn params)
        else if (c == 41) { if (depth > 0) { depth = depth - 1; } }   // ')'
        else if (c == 62 && (i == 0 || (int)t[i - 1] != 45)) { if (depth > 0) { depth = depth - 1; } }  // '>' but not "->"
        else if (c == 42 && depth == 0) { return 1; }        // top-level '*'
        i = i + 1;
    }
    return 0;
}

// A function type spelling: "fn(int)->int" (a closure value, lowered to a fat pointer).
int cg_is_fnty(string t) {
    return (int)t[0] == 102 && (int)t[1] == 110 && (int)t[2] == 40;   // "fn("
}

// Index of the first '[' that starts an array suffix (outside a fn type's '()' and a
// template's '<>', the '>' of a `->` not closing an angle), else -1. So
// "fn(int)->int[2]" is an array of 2 fns and "fn(int[3])->int" is not an array.
int cg_arr_open(string t) {
    int i = 0; int paren = 0; int angle = 0;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (c == 40) { paren = paren + 1; }
        else if (c == 41) { if (paren > 0) { paren = paren - 1; } }
        else if (c == 60) { angle = angle + 1; }
        else if (c == 62 && !(i > 0 && (int)t[i - 1] == 45)) { if (angle > 0) { angle = angle - 1; } }
        else if (c == 91 && paren == 0 && angle == 0) { return i; }
        i = i + 1;
    }
    return -1;
}

// The ']' matching the '[' at `open`.
int cg_arr_close(string t, int open) {
    int i = open; int depth = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 91) { depth = depth + 1; }
        else if ((int)t[i] == 93) { depth = depth - 1; if (depth == 0) { return i; } }
        i = i + 1;
    }
    return i;
}

int cg_is_array(string t) {
    int n = 0; while (t[n] != 0) { n = n + 1; }
    if (n > 0 && (int)t[n - 1] == 42) { return 0; }   // `T[N]*`: a pointer to an array
    if (cg_arr_open(t) >= 0) { return 1; }
    return 0;
}

// A slice type `T[]`: its outer array suffix has empty brackets (`[` immediately `]`).
int cg_is_slice(string t) {
    int n = 0; while (t[n] != 0) { n = n + 1; }
    if (n > 0 && (int)t[n - 1] == 42) { return 0; }   // `T[]*`: a pointer to a slice
    int open = cg_arr_open(t);
    if (open >= 0 && (int)t[open + 1] == 93) { return 1; }
    return 0;
}

// Peel the outer (leftmost) array dimension: "int[4]" -> "int", "int[2][3]" -> "int[3]".
string cg_array_elem(string t) {
    int open = cg_arr_open(t);
    if (open < 0) { return t; }
    int close = cg_arr_close(t, open);
    int tn = 0; while (t[tn] != 0) { tn = tn + 1; }
    // element = prefix before '[' + suffix after ']'
    int suflen = tn - (close + 1);
    if (suflen < 0) { suflen = 0; }
    *uint8 buf = alloc<uint8>(open + suflen + 1);
    int k = 0; while (k < open) { buf[k] = (uint8)t[k]; k = k + 1; }
    int j = 0; while (j < suflen) { buf[open + j] = (uint8)t[close + 1 + j]; j = j + 1; }
    buf[open + suflen] = 0;
    return (string)buf;
}

// The return type a lambda initializing a `t` value takes: a fn type's return, through
// any array dimensions (`fn(int)->int[2]` holds fns returning int), else "".
string cg_lam_ret_of(string t) {
    while (cg_is_array(t) == 1) { t = cg_array_elem(t); }
    if (cg_is_fnty(t) == 1) { return cg_fnty_ret(t); }
    return "";
}

// "int[4]" -> count "4".
// The decimal count of dimension spelling `cnt`: a number, a named const/enum, or an
// integer constant expression over them (`(uint8)258`, `N*2`, mirrors the C++
// resolveArrayDim); `cnt` itself when it is none of these.
int64 cg_parse_i64(string t) {
    int i = 0; int64 base = (int64)10; int64 sign = (int64)1;
    if (t[0] == '-') { sign = (int64)-1; i = 1; }
    if (t[i] == '0' && (t[i + 1] == 'x' || t[i + 1] == 'X')) { base = (int64)16; i = i + 2; }
    else if (t[i] == '0' && t[i + 1] != 0) { base = (int64)8; i = i + 1; }
    int64 v = (int64)0;
    while (t[i] != 0) {
        int ch = (int)t[i]; int64 d = (int64)0;
        if (ch >= 48 && ch <= 57) { d = (int64)(ch - 48); }
        else if (ch >= 97 && ch <= 102) { d = (int64)(ch - 87); }
        else if (ch >= 65 && ch <= 70) { d = (int64)(ch - 55); }
        else { return sign * v; }
        v = v * base + d;
        i = i + 1;
    }
    return sign * v;
}
string cg_dim_val(Codegen* g, string cnt) {
    if (cg_all_digits(cnt) == 1) { return cnt; }
    string rv = cg_enum_val(g, cnt);
    if (rv[0] != 0) { return rv; }
    int64 v = (int64)0;
    int folded = ast_fold_dim(cnt, int(string nm, *int64 out) {
        if (ast_has_prefix(nm, "sizeof(") == 1) {          // `sizeof(T)`, the type's allocation size
            int nl = 0; while (nm[nl] != 0) { nl = nl + 1; }
            *out = (int64)cg_size(g, cg_sub_str(nm, 7, nl - 1));
            return 1;
        }
        string ev = cg_enum_val(g, nm);
        if (ev[0] == 0) { return 0; }
        *out = cg_parse_i64(ev);
        return 1;
    }, &v);
    if (folded == 1 && v > (int64)0) { return cg_i64toa(v); }
    // The type checker leaves a `sizeof` dimension's value to codegen.
    if (folded == 1 && cg_has_sub(cnt, "sizeof(") == 1) {
        dprintf(2, "error: array size must be positive, got %lld ('%s')\n", v, cnt);
        exit(1);
    }
    return cnt;
}

string cg_array_count(string t) {
    int open = cg_arr_open(t);
    if (open < 0) { return "0"; }
    int s = open + 1;                                     // past '['
    int i = cg_arr_close(t, open);                        // its ']'
    *uint8 buf = alloc<uint8>(i - s + 1);
    int k = 0; while (k < i - s) { buf[k] = (uint8)t[s + k]; k = k + 1; }
    buf[i - s] = 0;
    return (string)buf;
}

CgStruct cg_find_struct(Codegen* g, string name) {
    if (cg_has_targs(name) == 1) { name = cg_ensure_struct_inst(g, name); }   // generic -> mangled
    int i = 0; int n = List_len<CgStruct>(&g.structs);
    while (i < n) {
        CgStruct s = List_get<CgStruct>(&g.structs, i);
        if (cg_streq(s.name, name) == 1) { return s; }
        i = i + 1;
    }
    let none: CgStruct; none.name = ""; List_init<string>(&none.fnames, 1); List_init<string>(&none.fetys, 1);
    return none;
}

int cg_field_idx(CgStruct* s, string fname) {
    int i = 0; int n = List_len<string>(&s.fnames);
    while (i < n) { if (cg_streq(List_get<string>(&s.fnames, i), fname) == 1) { return i; } i = i + 1; }
    return 0 - 1;
}

// Innermost local binding for `name` (slot == "" if none).
CgLocal cg_find_local(Codegen* g, string name) {
    int i = List_len<CgLocal>(&g.locals) - 1;
    while (i >= 0) {
        CgLocal l = List_get<CgLocal>(&g.locals, i);
        if (cg_streq(l.name, name) == 1) { return l; }
        i = i - 1;
    }
    let none: CgLocal; none.name = name; none.slot = ""; none.ty = "i32"; none.ety = "";
    return none;
}

// Drop a leading pointee "const " (`const P*` -> `P*`): const has no representation, and
// the type's consumers (member access, deref, method mangling) expect the bare spelling.
string cg_strip_lead_const(string t) {
    if (t[0] == 99 && t[1] == 111 && t[2] == 110 && t[3] == 115 && t[4] == 116 && t[5] == 32) {
        return (string)((*uint8)t + 6);
    }
    return t;
}

void cg_add_local(Codegen* g, string name, string slot, string ty, string ety) {
    let l: CgLocal; l.name = name; l.slot = slot; l.ty = ty; l.ety = cg_dealias(g, cg_strip_lead_const(ety));
    List_push<CgLocal>(&g.locals, l);
}

void cg_add_global(Codegen* g, string name, string slot, string ty, string ety) {
    let l: CgLocal; l.name = name; l.slot = slot; l.ty = ty; l.ety = cg_dealias(g, ety);
    List_push<CgLocal>(&g.gvars, l);
}

// A global variable by name, or a sentinel with empty .slot if not found.
CgLocal cg_find_global(Codegen* g, string name) {
    int i = 0; int n = List_len<CgLocal>(&g.gvars);
    while (i < n) {
        CgLocal l = List_get<CgLocal>(&g.gvars, i);
        if (cg_streq(l.name, name) == 1) { return l; }
        i = i + 1;
    }
    let none: CgLocal; none.name = name; none.slot = ""; none.ty = "i32"; none.ety = "";
    return none;
}

// `sizeof(x)` of a variable measures the variable's type (C semantics): the parser reads
// the operand as a type spelling, so a name bound to a local/global (and not a struct)
// resolves to that binding's type. Mirrors the C++ visit(SizeofExpr) rewrite.
string cg_sizeof_ty(Codegen* g, string t) {
    if (cg_is_struct(g, t) == 1) { return t; }
    CgLocal l = cg_find_local(g, t);
    if (l.slot[0] != 0 && l.ety[0] != 0) { return l.ety; }
    CgLocal gv = cg_find_global(g, t);
    if (gv.slot[0] != 0 && gv.ety[0] != 0) { return gv.ety; }
    return t;
}

// Constant initializer text for a global of LLVM type `llty`. Literal scalars fold to a
// constant; everything else (incl. a missing/non-constant init) is zeroinitializer —
// such a global must be set up at runtime (e.g. List_init in a session-init function).
// 64-bit value → "HHHHHHHHHHHHHHHH" (16 uppercase hex digits, MSB first).
string cg_hex16(uint64 bits) {
    *uint8 buf = alloc<uint8>(17);
    int i = 0;
    while (i < 16) {
        int shift = (15 - i) * 4;
        int nib = (int)((bits >> (uint64)shift) & (uint64)15);
        buf[i] = (uint8)cg_hexd(nib);
        i = i + 1;
    }
    buf[16] = 0;
    return (string)buf;
}

// LLVM constant text for a float (f32) slot: always the hex form `0x<double-bits>`
// of the value rounded to f32, since a plain decimal is rejected when it is not
// exactly representable in f32 (LLVM: "floating point constant invalid for type").
string cg_float_hex(string dec) {
    double d = atof(dec);
    float f = (float)d;             // round to f32
    double d2 = (double)f;          // widen back — LLVM's hex form is these double bits
    *uint64 pb = (*uint64)(&d2);
    return cg_cat("0x", cg_hex16(*pb));
}

// Does `s` already look like a floating literal (has '.', exponent, or hex marker)?
int cg_has_float_mark(string s) {
    int i = 0;
    while (s[i] != 0) {
        int c = (int)s[i];
        if (c == 46 || c == 101 || c == 69 || c == 120 || c == 88) { return 1; }   // . e E x X
        i = i + 1;
    }
    return 0;
}

// Emit `text` (a numeric literal) as a valid LLVM constant for slot type `llty`:
// float → hex form; double → ensure a decimal point (LLVM rejects `double 1`);
// integer types → as-is.
// Normalize a double literal for LLVM textual IR, which requires a decimal point:
// an exponent-only form like "1e6" becomes "1.0e6"; a bare "5" becomes "5.0".
string cg_double_lit(string text) {
    int i = 0; int has_dot = 0; int ei = 0 - 1;
    while (text[i] != 0) {
        int c = (int)text[i];
        if (c == 46) { has_dot = 1; }                            // '.'
        if ((c == 101 || c == 69) && ei == (0 - 1)) { ei = i; }  // first 'e'/'E'
        i = i + 1;
    }
    if (has_dot == 1) { return text; }
    if (ei == (0 - 1)) { return cg_cat(text, ".0"); }
    let out: String; String_init(&out, 16);
    int j = 0;
    while (j < ei) { String_push(&out, (char)text[j]); j = j + 1; }
    String_append(&out, ".0");
    while (text[j] != 0) { String_push(&out, (char)text[j]); j = j + 1; }
    return (string)String_cstr(&out);
}

string cg_num_const(string llty, string text) {
    if (cg_streq(llty, "float") == 1) { return cg_float_hex(text); }
    if (cg_streq(llty, "double") == 1) { return cg_double_lit(text); }
    // Integer slot: LLVM textual IR only accepts decimal, so always normalize the literal
    // (hex `0xFF` / octal `0NN` / decimal) to a decimal magnitude, preserving the sign.
    string dec = cg_u64toa(cg_int_lit_mag(text));
    if (text[0] == 45) { return cg_cat("-", dec); }
    return dec;
}

// The byte image of a constant bitfield-struct or union literal (little-endian), as
// CodeGen::constAggregateImage builds it: `op` marks bytes held by a constant with no
// byte form (an address), which only the element at that exact offset (a `dir` entry:
// offset + LLVM type, with its constant text in `dtx`) can carry.
struct CgImg { *uint8 b; *uint8 op; int n; List<CgLeaf> dir; List<string> dtx; }

string cg_global_init(Codegen* g, *ExprNode e, string llty);   // fwd
string cg_i64toa(int64 v);                                      // fwd
string cg_global_init_ty(Codegen* g, *ExprNode e, string ety);  // fwd
int64 cg_k_wrap(int64 v, int w, int uns);                       // fwd
int cg_is_bf_struct(Codegen* g, string sname);                  // fwd
int cg_ll_align_of(Codegen* g, string t);                       // fwd
int cg_ll_size_of(Codegen* g, string t);                        // fwd

// The value of an integer constant text ("-5", "true", "zeroinitializer") as 64 bits.
uint64 cg_img_ival(string t) {
    if (cg_streq(t, "true") == 1) { return (uint64)1; }
    if (cg_streq(t, "false") == 1 || cg_streq(t, "zeroinitializer") == 1 || cg_streq(t, "null") == 1) { return (uint64)0; }
    uint64 m = cg_int_lit_mag(t);
    if (t[0] == 45) { return (uint64)0 - m; }
    return m;
}

// The IEEE bits of a float/double constant text (hex `0x<double bits>` or decimal).
uint64 cg_img_fbits(string t, int isf) {
    double d = 0.0;
    if (t[0] == 48 && (t[1] == 120 || t[1] == 88)) {
        uint64 hb = cg_int_lit_mag(t);
        *uint64 ph = (*uint64)(&d); *ph = hb;
    } else if (cg_streq(t, "zeroinitializer") == 0) { d = atof(t); }
    if (isf == 1) {
        float f = (float)d;
        *uint32 pf = (*uint32)(&f);
        return (uint64)(*pf);
    }
    *uint64 pd = (*uint64)(&d);
    return *pd;
}

void cg_img_bytes(CgImg* im, int off, uint64 v, int nb) {
    int i = 0;
    while (i < nb && off + i < im.n) { im.b[off + i] = (uint8)((v >> (uint64)(i * 8)) & (uint64)255); i = i + 1; }
}

// Write the scalar constant `t` of LLVM type `llty` at `off`; a value with no byte form
// marks its bytes opaque.
// End of the constant value starting at `p` in `t`: its next top-level ',' or the
// bracket closing the enclosing aggregate (string literals skipped).
int cg_ll_val_end(string t, int p) {
    int depth = 0; int inq = 0;
    while (t[p] != 0) {
        int c = (int)t[p];
        if (inq == 1) { if (c == 34) { inq = 0; } }
        else if (c == 34) { inq = 1; }
        else if (c == 123 || c == 91 || c == 40) { depth = depth + 1; }
        else if (c == 125 || c == 93 || c == 41) { if (depth == 0) { return p; } depth = depth - 1; }
        else if (c == 44 && depth == 0) { return p; }
        p = p + 1;
    }
    return p;
}

void cg_img_put(Codegen* g, CgImg* im, int off, string llty, string t);   // fwd
void cg_ll_elem_offs(Codegen* g, string body, List<string>* tys, List<int>* offs);   // fwd

// Write an aggregate constant `t` of LLVM type `llty` (a struct `{ … }` / `<{ … }>` or an
// array `[N x T]`) into the image member by member, so a union holding a struct or an
// array member folds like one holding a scalar. 0 when `t` is not in that form.
int cg_img_put_agg(Codegen* g, CgImg* im, int off, string llty, string t) {
    string body = llty;
    if ((int)llty[0] == 37) {                                   // %name → its body
        body = cg_tydef_body(g, cg_sub_str(llty, 1, cg_strlen(llty)));
        if (body[0] == 0) { return 0; }
    }
    int b0 = (int)body[0];
    if (b0 != 123 && b0 != 60 && b0 != 91) { return 0; }
    List<string> tys; List_init<string>(&tys, 8);
    List<int> offs; List_init<int>(&offs, 8);
    if (b0 == 91) {
        int q = 1; cg_ll_ws(body, &q);
        int cnt = cg_ll_num(body, &q); cg_ll_ws(body, &q); cg_ll_kw(body, &q, "x"); cg_ll_ws(body, &q);
        string et = cg_sub_str(body, q, cg_strlen(body) - 1);
        int esz = cg_ll_size_of(g, et);
        int k = 0;
        while (k < cnt) { List_push<string>(&tys, et); List_push<int>(&offs, k * esz); k = k + 1; }
    } else { cg_ll_elem_offs(g, body, &tys, &offs); }
    int p = 0; cg_ll_ws(t, &p);
    if ((int)t[p] == 60) { p = p + 1; cg_ll_ws(t, &p); }     // `<{` packed
    if (b0 == 91 && (int)t[p] != 91) { return 0; }             // e.g. a `c"..."` byte string
    if (b0 != 91 && (int)t[p] != 123) { return 0; }
    p = p + 1;
    int i = 0;
    while (i < List_len<string>(&tys)) {
        cg_ll_ws(t, &p);
        if ((int)t[p] == 125 || (int)t[p] == 93 || t[p] == 0) { return 1; }
        int al = 1; cg_ll_layout(g, t, &p, &al);                // the element's type
        cg_ll_ws(t, &p);
        int e = cg_ll_val_end(t, p);
        string v = cg_trim(cg_sub_str(t, p, e));
        string et = List_get<string>(&tys, i);
        int eoff = off + List_get<int>(&offs, i);
        let dl: CgLeaf; dl.off = eoff; dl.ty = et;
        List_push<CgLeaf>(&im.dir, dl); List_push<string>(&im.dtx, v);
        cg_img_put(g, im, eoff, et, v);
        p = e;
        if ((int)t[p] == 44) { p = p + 1; }
        i = i + 1;
    }
    return 1;
}

void cg_img_put(Codegen* g, CgImg* im, int off, string llty, string t) {
    int sz = cg_ll_size_of(g, llty);
    int w = cg_int_w(llty);
    if (w > 0) { cg_img_bytes(im, off, cg_img_ival(t), sz); return; }
    if (cg_streq(llty, "double") == 1) { cg_img_bytes(im, off, cg_img_fbits(t, 0), 8); return; }
    if (cg_streq(llty, "float") == 1) { cg_img_bytes(im, off, cg_img_fbits(t, 1), 4); return; }
    if (cg_streq(t, "zeroinitializer") == 1 || cg_streq(t, "null") == 1) { return; }
    if (cg_img_put_agg(g, im, off, llty, t) == 1) { return; }
    int i = 0;
    while (i < sz && off + i < im.n) { im.op[off + i] = (uint8)1; i = i + 1; }
}

// The element types of an LLVM struct body `{ a, b }` / `<{ a, b }>` (*packed = 1 for `<{`).
void cg_ll_elems(Codegen* g, string s, List<string>* out, int* pk) {
    int pos = 0;
    cg_ll_ws(s, &pos);
    pk[0] = 0;
    if ((int)s[pos] == 60) { pk[0] = 1; pos = pos + 1; cg_ll_ws(s, &pos); }
    if ((int)s[pos] == 123) { pos = pos + 1; }
    cg_ll_ws(s, &pos);
    while (s[pos] != 0 && (int)s[pos] != 125) {
        int st = pos; int al = 1;
        cg_ll_layout(g, s, &pos, &al);
        List_push<string>(out, cg_sub_str(s, st, pos));
        cg_ll_ws(s, &pos);
        if ((int)s[pos] == 44) { pos = pos + 1; }
        cg_ll_ws(s, &pos);
    }
}

// Byte offsets of the elements of an LLVM struct body.
void cg_ll_elem_offs(Codegen* g, string body, List<string>* tys, List<int>* offs) {
    int pkd = 0;
    cg_ll_elems(g, body, tys, &pkd);
    int off = 0; int i = 0;
    while (i < List_len<string>(tys)) {
        string t = List_get<string>(tys, i);
        if (pkd == 0) { off = cg_align_up(off, cg_ll_align_of(g, t)); }
        List_push<int>(offs, off);
        off = off + cg_ll_size_of(g, t);
        i = i + 1;
    }
}

// Constant text of LLVM type `llty` at `off` read back from the image ("" = not representable).
string cg_img_render(Codegen* g, CgImg* im, string llty, int off) {
    int di = 0;
    while (di < List_len<CgLeaf>(&im.dir)) {
        CgLeaf dl = List_get<CgLeaf>(&im.dir, di);
        if (dl.off == off && cg_streq(dl.ty, llty) == 1) { return List_get<string>(&im.dtx, di); }
        // An address where the layout has a pointer-sized integer (a union laid out as int64).
        if (dl.off == off && cg_streq(dl.ty, "ptr") == 1 && cg_int_w(llty) > 0
            && cg_ll_size_of(g, llty) == cg_ll_size_of(g, "ptr")) {
            return cg_cat(cg_cat(cg_cat(cg_cat("ptrtoint (ptr ", List_get<string>(&im.dtx, di)), " to "), llty), ")");
        }
        di = di + 1;
    }
    int sz = cg_ll_size_of(g, llty);
    if (off + sz > im.n) { return ""; }
    string body = llty;
    if ((int)llty[0] == 37) {                                   // %name → its body
        body = cg_tydef_body(g, cg_sub_str(llty, 1, cg_strlen(llty)));
        if (body[0] == 0) { return ""; }
    }
    if ((int)body[0] == 123 || (int)body[0] == 60) {            // { … } / <{ … }>
        List<string> tys; List_init<string>(&tys, 8);
        List<int> offs; List_init<int>(&offs, 8);
        cg_ll_elem_offs(g, body, &tys, &offs);
        int pkd = 0; if ((int)body[0] == 60) { pkd = 1; }
        let out: String; String_init(&out, 64);
        if (pkd == 1) { String_append(&out, "<{ "); } else { String_append(&out, "{ "); }
        int i = 0;
        while (i < List_len<string>(&tys)) {
            string et = List_get<string>(&tys, i);
            string ev = cg_img_render(g, im, et, off + List_get<int>(&offs, i));
            if (ev[0] == 0) { return ""; }
            if (i > 0) { String_append(&out, ", "); }
            String_append(&out, et); String_push(&out, ' '); String_append(&out, ev);
            i = i + 1;
        }
        if (pkd == 1) { String_append(&out, " }>"); } else { String_append(&out, " }"); }
        return (string)String_cstr(&out);
    }
    int i = 0; int zero = 1;
    while (i < sz) {
        if (im.op[off + i] != 0) { return ""; }
        if (im.b[off + i] != 0) { zero = 0; }
        i = i + 1;
    }
    if ((int)body[0] == 91) {                                   // [N x T]
        int p = 1; cg_ll_ws(body, &p);
        int cnt = cg_ll_num(body, &p); cg_ll_ws(body, &p); cg_ll_kw(body, &p, "x"); cg_ll_ws(body, &p);
        string et = cg_sub_str(body, p, cg_strlen(body) - 1);
        if (zero == 1) { return "zeroinitializer"; }
        int esz = cg_ll_size_of(g, et);
        let out: String; String_init(&out, 64);
        String_push(&out, '[');
        int k = 0;
        while (k < cnt) {
            string ev = cg_img_render(g, im, et, off + k * esz);
            if (ev[0] == 0) { return ""; }
            if (k > 0) { String_append(&out, ", "); }
            String_append(&out, et); String_push(&out, ' '); String_append(&out, ev);
            k = k + 1;
        }
        String_push(&out, ']');
        return (string)String_cstr(&out);
    }
    uint64 v = (uint64)0;
    i = 0;
    while (i < sz && i < 8) { v = v | ((uint64)im.b[off + i] << (uint64)(i * 8)); i = i + 1; }
    int w = cg_int_w(body);
    if (w > 0) {
        if (w == 1) { if ((v & (uint64)1) != (uint64)0) { return "true"; } return "false"; }
        return cg_i64toa(cg_k_wrap((int64)v, w, 0));
    }
    if (cg_streq(body, "double") == 1) { return cg_cat("0x", cg_hex16(v)); }
    if (cg_streq(body, "float") == 1) {
        uint32 fb = (uint32)v; float f = (float)0.0;
        if ((fb & (uint32)0x7F800000) == (uint32)0x7F800000) {   // inf/NaN: widen the bits exactly
            uint64 db = ((uint64)(fb & (uint32)0x80000000) << (uint64)32) | (uint64)0x7FF0000000000000
                      | ((uint64)(fb & (uint32)0x007FFFFF) << (uint64)29);
            return cg_cat("0x", cg_hex16(db));
        }
        *uint32 pf = (*uint32)(&f); *pf = fb;
        double d = (double)f;
        *uint64 pd = (*uint64)(&d);
        return cg_cat("0x", cg_hex16(*pd));
    }
    if (zero == 1) {
        if (cg_streq(body, "ptr") == 1) { return "null"; }
        return "zeroinitializer";
    }
    if (cg_streq(body, "ptr") == 1) {                           // integer bytes where the layout has a pointer
        string it = "i64"; if (sz == 4) { it = "i32"; }
        return cg_cat(cg_cat(cg_cat(cg_cat("inttoptr (", it), " "), cg_i64toa((int64)v)), " to ptr)");
    }
    return "";
}

// Constant text of a bitfield-struct or union literal of `%sname`, folded through its
// byte image ("" if a member is not constant or has no byte form where one is needed).
string cg_const_image(Codegen* g, string sname, *ExprNode e) {
    CgStruct s = cg_find_struct(g, sname);
    string llty = cg_cat("%", sname);
    let im: CgImg;
    im.n = cg_ll_size_of(g, llty);
    im.b = alloc<uint8>(im.n + 1); im.op = alloc<uint8>(im.n + 1);
    List_init<CgLeaf>(&im.dir, 4); List_init<string>(&im.dtx, 4);
    List<string> etys; List_init<string>(&etys, 8);
    List<int> eoffs; List_init<int>(&eoffs, 8);
    cg_ll_elem_offs(g, cg_tydef_body(g, sname), &etys, &eoffs);
    int isu = cg_is_union(g, sname);
    int nk = List_len<*ExprNode>(&e.kids);
    int k = 0;
    while (k < nk) {
        string fname = List_get<string>(&e.names, k);
        int idx = k;
        if (fname[0] != 0) { idx = cg_field_idx(&s, fname); }
        *ExprNode fe = List_get<*ExprNode>(&e.kids, k);
        k = k + 1;
        if (idx < 0 || idx >= List_len<string>(&s.fnames)) { continue; }
        string fety = List_get<string>(&s.fetys, idx);
        string mll = cg_lltype(g, fety);
        int base = 0;
        CgBF bf = cg_bf(g, sname, List_get<string>(&s.fnames, idx));
        if (isu == 0) {
            if (bf.boffs >= 0) { base = bf.boffs; }
            else if (bf.fidx >= 0 && bf.fidx < List_len<int>(&eoffs)) { base = List_get<int>(&eoffs, bf.fidx); }
        }
        if (bf.bw > 0) {
            uint64 v = cg_img_ival(cg_global_init(g, fe, bf.sty));
            int bitpos = base * 8 + bf.boff;
            int b = 0;
            while (b < bf.bw && b < 64) {
                int p = bitpos + b;
                if (p / 8 < im.n) {
                    int m = 1 << (p % 8);
                    if (((v >> (uint64)b) & (uint64)1) != (uint64)0) { im.b[p / 8] = (uint8)((int)im.b[p / 8] | m); }
                    else { im.b[p / 8] = (uint8)((int)im.b[p / 8] & (255 - m)); }
                }
                b = b + 1;
            }
            continue;
        }
        string txt = cg_global_init(g, fe, mll);
        let dl: CgLeaf; dl.off = base; dl.ty = mll;
        List_push<CgLeaf>(&im.dir, dl); List_push<string>(&im.dtx, txt);
        cg_img_put(g, &im, base, mll, txt);
    }
    return cg_img_render(g, &im, llty, 0);
}

// Constant struct-literal text "{ ty v, ty v, ... }" for a global initializer (a
// bitfield struct or a union goes through its byte image, cg_const_image; "" when it
// cannot be folded). Named + positional fields; missing → zero.
string cg_const_struct(Codegen* g, string sname0, *ExprNode e) {
    string sname = cg_dealias(g, sname0);
    CgStruct s = cg_find_struct(g, sname);
    int nf = List_len<string>(&s.fnames);
    if (nf == 0) { return ""; }
    if (cg_is_union(g, sname) == 1 || cg_is_bf_struct(g, sname) == 1) {
        string img = cg_const_image(g, sname, e);
        if (img[0] == 0) {
            dprintf(2, "error: a '%s' literal initializer is not a compile-time constant\n", sname);
            exit(1);
        }
        return img;
    }
    // A `packed struct` is an LLVM packed type `<{ … }>`: its constant must be too.
    int pkd = 0;
    string sbody = cg_tydef_body(g, sname);
    if (sbody[0] == 0) { int pal = 1; cg_ll_named(g, sname, &pal); sbody = cg_tydef_body(g, sname); }
    if ((int)sbody[0] == 60) { pkd = 1; }
    let out: String; String_init(&out, 64);
    if (pkd == 1) { String_append(&out, "<{ "); } else { String_append(&out, "{ "); }
    int nk = List_len<*ExprNode>(&e.kids);
    int i = 0;
    while (i < nf) {
        if (i > 0) { String_append(&out, ", "); }
        string flty = cg_lltype(g, List_get<string>(&s.fetys, i));
        String_append(&out, flty); String_push(&out, ' ');
        *ExprNode fe = null;                              // the init provided for field i, if any
        int k = 0;
        while (k < nk) {
            string fname = List_get<string>(&e.names, k);
            int idx = k;                                  // positional by default
            if (fname[0] != 0) { idx = cg_field_idx(&s, fname); }
            if (idx == i) { fe = List_get<*ExprNode>(&e.kids, k); }
            k = k + 1;
        }
        if (fe != null) { String_append(&out, cg_global_init_ty(g, fe, List_get<string>(&s.fetys, i))); }
        else { String_append(&out, "zeroinitializer"); }
        i = i + 1;
    }
    if (pkd == 1) { String_append(&out, " }>"); } else { String_append(&out, " }"); }
    return (string)String_cstr(&out);
}

// Signed decimal text of a 64-bit value.
string cg_i64toa(int64 v) {
    if (v < (int64)0) { return cg_cat("-", cg_u64toa((uint64)0 - (uint64)v)); }
    return cg_u64toa((uint64)v);
}

// Truncate `v` to `w` bits and re-extend (sign- or zero-) to 64, C conversion semantics.
int64 cg_k_wrap(int64 v, int w, int uns) {
    if (w <= 0 || w >= 64) { return v; }
    uint64 m = ((uint64)1 << (uint64)w) - (uint64)1;
    uint64 u = (uint64)v & m;
    if (uns == 0 && (u >> (uint64)(w - 1)) != (uint64)0) { u = u | ~m; }
    return (int64)u;
}

// An integer constant of C type (w bits, uns): the value is converted to that type.
CgK cg_k_mk(int64 v, int w, int uns) {
    let k: CgK; k.ok = 1; k.isf = 0; k.dv = 0.0; k.w = w; k.uns = uns;
    if (w == 1) { if (v != (int64)0) { k.iv = (int64)1; } else { k.iv = (int64)0; } }
    else { k.iv = cg_k_wrap(v, w, uns); }
    return k;
}
CgK cg_k_int(int64 v) { return cg_k_mk(v, 64, 0); }
CgK cg_k_flt(double v) { let k: CgK; k.ok = 1; k.isf = 1; k.iv = (int64)0; k.dv = v; k.w = 64; k.uns = 0; return k; }
CgK cg_k_none() { let k: CgK; k.ok = 0; k.isf = 0; k.iv = (int64)0; k.dv = 0.0; k.w = 0; k.uns = 0; return k; }
int cg_k_true(CgK k) {
    if (k.isf == 1) { if (k.dv != 0.0) { return 1; } return 0; }
    if (k.iv != (int64)0) { return 1; }
    return 0;
}
// The value of `k` as a double (an integer converts by its own signedness).
double cg_k_dbl(CgK k) {
    if (k.isf == 1) { return k.dv; }
    if (k.uns == 1) { return (double)(uint64)k.iv; }
    return (double)k.iv;
}
// Convert `k` to the Eskiu type `t` (what an implicit conversion or a cast computes).
CgK cg_k_conv(Codegen* g, CgK k, string t) {
    if (k.ok == 0) { return k; }
    string d = cg_dealias(g, t);
    if (cg_is_float(d) == 1) {
        double x = cg_k_dbl(k);
        if (cg_streq(d, "float") == 1) { float f = (float)x; x = (double)f; }
        CgK r = cg_k_flt(x);
        if (cg_streq(d, "float") == 1) { r.w = 32; }
        return r;
    }
    int w = cg_int_w(cg_lltype(g, d));
    if (w == 0) { return cg_k_none(); }              // a pointer/aggregate: not folded here
    int uns = cg_is_unsigned(d);
    if (w == 1) { return cg_k_mk((int64)cg_k_true(k), 1, 1); }   // to bool: `!= 0`
    if (k.isf == 1) {
        if (uns == 1) { return cg_k_mk((int64)(uint64)k.dv, w, 1); }
        return cg_k_mk((int64)k.dv, w, 0);
    }
    return cg_k_mk(k.iv, w, uns);
}
// C integer promotion: an integer narrower than int is an int (its value is unchanged).
CgK cg_k_prom(CgK k) {
    if (k.isf == 0 && k.w < 32) { k.w = 32; k.uns = 0; }
    return k;
}

// Fold a constant scalar expression (a global/`static` initializer, a case label):
// literals, enum members and `const` globals, sizeof, casts, unary/binary operators,
// and `?:`. Every step follows the run-time codegen's C semantics (integer promotions,
// the usual arithmetic conversions, wrapping to the result width), so a constant
// initializer holds exactly what the same expression computes at run time. Mirrors
// the C++ back-end, which folds by running its expression codegen (foldViaCodegen).
// .ok == 0 when not foldable.
CgK cg_cfold(Codegen* g, *ExprNode e) {
    if (e == null) { return cg_k_none(); }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) {
            uint64 mag = cg_int_lit_mag(e.sval);
            int64 m = (int64)mag;
            if (e.sval[0] == 45) { m = (int64)0 - m; }
            int w = 32;                                  // int, or int64 when it does not fit
            if (e.sval[0] == 45) { if (mag > (uint64)2147483648) { w = 64; } }
            else if (mag > (uint64)2147483647) { w = 64; }
            if (e.sval[0] != 45 && mag > (uint64)9223372036854775807) { return cg_k_mk(m, 64, 1); }   // uint64
            return cg_k_mk(m, w, 0);
        }
        if (e.lit_kind == LIT_FLOAT) { return cg_k_flt(atof(e.sval)); }
        if (e.lit_kind == LIT_CHAR) { return cg_k_mk((int64)(uint8)e.sval[0], 8, 1); }
        if (e.lit_kind == LIT_BOOL) { if (cg_streq(e.sval, "true") == 1) { return cg_k_mk((int64)1, 1, 1); } return cg_k_mk((int64)0, 1, 1); }
        return cg_k_none();
    }
    if (e.kind == EK_IDENT) {
        string v = cg_enum_val(g, e.sval);
        if (v[0] != 0) {
            int64 m = (int64)cg_int_lit_mag(v);
            if (v[0] == 45) { m = (int64)0 - m; }
            return cg_k_mk(m, 32, 0);
        }
        int i = List_len<CgFK>(&g.fconsts) - 1;
        while (i >= 0) {
            CgFK f = List_get<CgFK>(&g.fconsts, i);
            if (cg_streq(f.name, e.sval) == 1) { return f.k; }
            i = i - 1;
        }
        return cg_k_none();
    }
    if (e.kind == EK_SIZEOF) { return cg_k_mk((int64)cg_size(g, cg_apply_sub(g, e.sval)), 64, 0); }
    if (e.kind == EK_CAST) {
        CgK k = cg_cfold(g, e.a);
        if (k.ok == 0) { return k; }
        return cg_k_conv(g, k, cg_apply_sub(g, e.sval));
    }
    if (e.kind == EK_UNARY) {
        CgK k = cg_cfold(g, e.a);
        if (k.ok == 0) { return k; }
        if (cg_streq(e.sval, "+") == 1) { return k; }
        if (cg_streq(e.sval, "!") == 1) { return cg_k_mk((int64)(1 - cg_k_true(k)), 1, 1); }
        if (k.isf == 1) {
            if (cg_streq(e.sval, "-") == 1) { CgK r = cg_k_flt(0.0 - k.dv); r.w = k.w; return r; }
            return cg_k_none();
        }
        k = cg_k_prom(k);
        if (cg_streq(e.sval, "-") == 1) { return cg_k_mk((int64)((uint64)0 - (uint64)k.iv), k.w, k.uns); }
        if (cg_streq(e.sval, "~") == 1) { return cg_k_mk(~k.iv, k.w, k.uns); }
        return cg_k_none();
    }
    if (e.kind == EK_TERNARY) {
        CgK c = cg_cfold(g, e.a);
        if (c.ok == 0) { return c; }
        CgK arm = cg_k_none();
        if (cg_k_true(c) == 1) { arm = cg_cfold(g, e.b); }
        else { arm = cg_cfold(g, List_get<*ExprNode>(&e.kids, 0)); }
        if (arm.ok == 0) { return arm; }
        string rt = cg_etype(g, e);                      // the arms' common type
        if (cg_is_num_ety(g, rt) == 1) { return cg_k_conv(g, arm, rt); }
        return arm;
    }
    if (e.kind == EK_BINARY) {
        string op = e.sval;
        CgK a = cg_cfold(g, e.a);
        if (a.ok == 0) { return a; }
        if (cg_streq(op, "&&") == 1 || cg_streq(op, "||") == 1) {
            int la = cg_k_true(a);                       // short-circuit, like the run time
            if (cg_streq(op, "&&") == 1 && la == 0) { return cg_k_mk((int64)0, 1, 1); }
            if (cg_streq(op, "||") == 1 && la == 1) { return cg_k_mk((int64)1, 1, 1); }
            CgK rb = cg_cfold(g, e.b);
            if (rb.ok == 0) { return rb; }
            return cg_k_mk((int64)cg_k_true(rb), 1, 1);
        }
        CgK b = cg_cfold(g, e.b);
        if (b.ok == 0) { return b; }
        int r = 0 - 1;
        if (a.isf == 1 || b.isf == 1) {
            double x = cg_k_dbl(a); double y = cg_k_dbl(b);
            int fw = 64;                                 // float only when no double is involved
            if ((a.isf == 0 || a.w == 32) && (b.isf == 0 || b.w == 32)) { fw = 32; }
            double z = 0.0; int arith = 1;
            if (cg_streq(op, "+") == 1) { z = x + y; }
            else if (cg_streq(op, "-") == 1) { z = x - y; }
            else if (cg_streq(op, "*") == 1) { z = x * y; }
            else if (cg_streq(op, "/") == 1) { z = x / y; }
            else { arith = 0; }
            if (arith == 1) {
                if (fw == 32) { float f = (float)z; z = (double)f; }
                CgK fr = cg_k_flt(z); fr.w = fw; return fr;
            }
            if (cg_streq(op, "==") == 1) { r = 0; if (x == y) { r = 1; } }
            if (cg_streq(op, "!=") == 1) { r = 0; if (x != y) { r = 1; } }
            if (cg_streq(op, "<") == 1)  { r = 0; if (x < y) { r = 1; } }
            if (cg_streq(op, ">") == 1)  { r = 0; if (x > y) { r = 1; } }
            if (cg_streq(op, "<=") == 1) { r = 0; if (x <= y) { r = 1; } }
            if (cg_streq(op, ">=") == 1) { r = 0; if (x >= y) { r = 1; } }
            if (r >= 0) { return cg_k_mk((int64)r, 1, 1); }
            return cg_k_none();
        }
        a = cg_k_prom(a); b = cg_k_prom(b);
        if (cg_streq(op, "<<") == 1 || cg_streq(op, ">>") == 1) {
            // The result has the promoted left operand's type; a count past its width
            // is undefined (folded to 0).
            uint64 cnt = (uint64)b.iv;
            if (cnt >= (uint64)a.w) { return cg_k_mk((int64)0, a.w, a.uns); }
            if (cg_streq(op, "<<") == 1) { return cg_k_mk((int64)((uint64)a.iv << cnt), a.w, a.uns); }
            if (a.uns == 1) { return cg_k_mk((int64)((uint64)a.iv >> cnt), a.w, 1); }
            return cg_k_mk(a.iv >> (int64)cnt, a.w, 0);
        }
        // The usual arithmetic conversions: a signed/unsigned pair is unsigned unless
        // the signed type is wider.
        int w = a.w; int uns = a.uns;
        if (a.uns == b.uns) { if (b.w > w) { w = b.w; } }
        else {
            int wu = a.w; int ws = b.w;
            if (b.uns == 1) { wu = b.w; ws = a.w; }
            if (wu >= ws) { w = wu; uns = 1; } else { w = ws; uns = 0; }
        }
        a = cg_k_mk(a.iv, w, uns); b = cg_k_mk(b.iv, w, uns);
        int64 x = a.iv; int64 y = b.iv;
        uint64 ux = (uint64)x; uint64 uy = (uint64)y;
        if (cg_streq(op, "+") == 1) { return cg_k_mk((int64)(ux + uy), w, uns); }
        if (cg_streq(op, "-") == 1) { return cg_k_mk((int64)(ux - uy), w, uns); }
        if (cg_streq(op, "*") == 1) { return cg_k_mk((int64)(ux * uy), w, uns); }
        if (cg_streq(op, "/") == 1 || cg_streq(op, "%") == 1) {
            if (y == (int64)0) { return cg_k_none(); }
            if (uns == 1) { if (cg_streq(op, "/") == 1) { return cg_k_mk((int64)(ux / uy), w, 1); } return cg_k_mk((int64)(ux % uy), w, 1); }
            if (y == (int64)(0 - 1)) { if (cg_streq(op, "/") == 1) { return cg_k_mk((int64)((uint64)0 - ux), w, 0); } return cg_k_mk((int64)0, w, 0); }
            if (cg_streq(op, "/") == 1) { return cg_k_mk(x / y, w, 0); }
            return cg_k_mk(x % y, w, 0);
        }
        if (cg_streq(op, "&") == 1) { return cg_k_mk((int64)(ux & uy), w, uns); }
        if (cg_streq(op, "|") == 1) { return cg_k_mk((int64)(ux | uy), w, uns); }
        if (cg_streq(op, "^") == 1) { return cg_k_mk((int64)(ux ^ uy), w, uns); }
        if (cg_streq(op, "==") == 1) { r = 0; if (x == y) { r = 1; } }
        if (cg_streq(op, "!=") == 1) { r = 0; if (x != y) { r = 1; } }
        if (uns == 1) {
            if (cg_streq(op, "<") == 1)  { r = 0; if (ux < uy) { r = 1; } }
            if (cg_streq(op, ">") == 1)  { r = 0; if (ux > uy) { r = 1; } }
            if (cg_streq(op, "<=") == 1) { r = 0; if (ux <= uy) { r = 1; } }
            if (cg_streq(op, ">=") == 1) { r = 0; if (ux >= uy) { r = 1; } }
        } else {
            if (cg_streq(op, "<") == 1)  { r = 0; if (x < y) { r = 1; } }
            if (cg_streq(op, ">") == 1)  { r = 0; if (x > y) { r = 1; } }
            if (cg_streq(op, "<=") == 1) { r = 0; if (x <= y) { r = 1; } }
            if (cg_streq(op, ">=") == 1) { r = 0; if (x >= y) { r = 1; } }
        }
        if (r >= 0) { return cg_k_mk((int64)r, 1, 1); }
        return cg_k_none();
    }
    return cg_k_none();
}

// Fold a top-level `const` declaration's initializer in its declared type and record
// it: a signed int goes to econsts (read as an int operand), anything else to fconsts.
void cg_fold_const_decl(Codegen* g, *DeclNode d) {
    string dt = cg_dealias(g, d.ret_type);
    string dll = cg_lltype(g, dt);
    CgK k = cg_k_conv(g, cg_cfold(g, d.init), dt);
    if (k.ok == 1 && cg_streq(dll, "i32") == 1 && cg_is_unsigned(dt) == 0) {
        let ec2: CgEnumC; ec2.name = d.name; ec2.val = cg_i64toa(k.iv);
        List_push<CgEnumC>(&g.econsts, ec2);
    } else if (k.ok == 1) {
        let ik: CgFK; ik.name = d.name; ik.k = k;
        List_push<CgFK>(&g.fconsts, ik);
    }
}

// Render a folded constant as LLVM constant text for slot type `llty` ("" if the slot
// is not a scalar numeric type). Integers are wrapped to the slot width (C conversion).
string cg_k_text(CgK k, string llty) {
    if (cg_streq(llty, "double") == 1 || cg_streq(llty, "float") == 1) {
        double d = cg_k_dbl(k);
        if (cg_streq(llty, "float") == 1) { float f = (float)d; d = (double)f; }
        *uint64 pb = (*uint64)(&d);
        return cg_cat("0x", cg_hex16(*pb));
    }
    int w = cg_int_w(llty);
    if (w == 0) { return ""; }
    if (w == 1) { if (cg_k_true(k) == 1) { return "true"; } return "false"; }
    int64 v = k.iv;
    if (k.isf == 1) { v = (int64)k.dv; }
    return cg_i64toa(cg_k_wrap(v, w, 0));
}

string cg_global_init(Codegen* g, *ExprNode e, string llty) {
    if (e == null) { return "zeroinitializer"; }
    // `&global`: a link-time constant address.
    if (e.kind == EK_UNARY && cg_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        CgLocal gl = cg_find_global(g, e.a.sval);
        if (gl.slot[0] != 0) { return gl.slot; }
    }
    // A foldable operator expression (`3 + 1`, `A * 2`, `1.0 / 4.0`, `c ? a : b`, a cast).
    if (e.kind == EK_BINARY || e.kind == EK_TERNARY || e.kind == EK_UNARY || e.kind == EK_CAST
        || e.kind == EK_IDENT) {
        CgK k = cg_cfold(g, e);
        if (k.ok == 1) {
            string kt = cg_k_text(k, llty);
            if (kt[0] != 0) { return kt; }
        }
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_NULL) { return "null"; }
        if (e.lit_kind == LIT_CHAR) { return cg_itoa((int)e.sval[0]); }
        if (e.lit_kind == LIT_BOOL) { return e.sval; }      // e.sval is "true"/"false"
        if (e.lit_kind == LIT_STRING) { return cg_string_global(g, e.sval); }   // ptr to a real constant
        return cg_num_const(llty, e.sval);                   // integer / float literal, slot-typed
    }
    if (e.kind == EK_CAST) {
        // Fold a numeric cast in a constant initializer: emit the operand as the cast's
        // LLVM target type (float → hex form, double → decimal, integer → as-is).
        string dll = cg_lltype(g, cg_apply_sub(g, e.sval));
        return cg_global_init(g, e.a, dll);
    }
    if (e.kind == EK_IDENT) {
        // An enum constant or a folded top-level `const int` (both live in econsts).
        string v = cg_enum_val(g, e.sval);
        if (v[0] != 0) { return cg_num_const(llty, v); }
        return "zeroinitializer";
    }
    if (e.kind == EK_SIZEOF) {
        return cg_itoa(cg_size(g, cg_apply_sub(g, cg_sizeof_ty(g, e.sval))));   // static byte size
    }
    if (e.kind == EK_UNARY) {
        // `-` reaches here rarely (negatives are single literal tokens); `~`/`!` need folding.
        if (cg_streq(e.sval, "!") == 1) {
            string inner = cg_global_init(g, e.a, "i64");
            if (cg_streq(inner, "0") == 1 || cg_streq(inner, "false") == 1) { return "true"; }
            return "false";
        }
        if (cg_streq(e.sval, "~") == 1) {
            // ~x == -x - 1. Fold the operand's magnitude and render the complement.
            string inner = cg_global_init(g, e.a, "i64");
            uint64 m = cg_int_lit_mag(inner);
            if (inner[0] == 45) { return cg_u64toa(m - (uint64)1); }        // ~(-m) = m-1
            return cg_cat("-", cg_u64toa(m + (uint64)1));                   // ~m = -(m+1)
        }
        if (cg_streq(e.sval, "-") == 1) {
            string inner = cg_global_init(g, e.a, llty);
            if (inner[0] == 45) { return cg_sub_str(inner, 1, cg_strlen(inner)); }   // -(-5) → 5
            return cg_cat("-", inner);
        }
        return "zeroinitializer";
    }
    if (e.kind == EK_STRUCTINIT) {
        string sname = cg_apply_sub(g, e.sval);
        string cs = cg_const_struct(g, sname, e);
        if (cs[0] != 0) { return cs; }
        return "zeroinitializer";                             // a struct with no fields
    }
    if (e.kind == EK_LAMBDA) {
        // A non-capturing lambda is a compile-time-constant closure { @lambdaN, null }:
        // queue its body for emission and fold to the constant fat pointer, so a global
        // (or static) initializer holds a real callable, not a null closure. A capturing
        // closure needs a live frame, so it can't be a global constant (rare; deferred).
        List<string> pp; List_init<string>(&pp, 4); cg_paren_list(e.sval, &pp);
        List<string> ids; List_init<string>(&ids, 16); cg_collect_idents_s(e.stmt, &ids);
        int ci = 0;
        while (ci < List_len<string>(&ids)) {
            string nm = List_get<string>(&ids, ci);
            ci = ci + 1;
            int isparam = 0; int pj = 0;
            while (pj < List_len<string>(&pp)) {
                if (cg_streq(cg_last_word(List_get<string>(&pp, pj)), nm) == 1) { isparam = 1; }
                pj = pj + 1;
            }
            if (isparam == 1) { continue; }
            CgLocal l = cg_find_local(g, nm);
            if (l.slot[0] != 0) { return "zeroinitializer"; }   // captures a local: can't fold
        }
        string lname = cg_cat("__lambda", cg_itoa(g.lam_seq));
        g.lam_seq = g.lam_seq + 1;
        List<string> capn; List_init<string>(&capn, 1);
        List<string> capt; List_init<string>(&capt, 1);
        let lam: CgLambda; lam.name = lname; lam.node = e; lam.capn = capn; lam.capt = capt;
        List_init<CgLocal>(&lam.statics, 1);
        lam.sub = cg_copy_sub(&g.cursub);   // freeze the generic substitution for deferred emission
        if (g.lam_expret[0] != 0) { lam.rety = g.lam_expret; } else { lam.rety = cg_arm_var(e.sval); }
        List_push<CgLambda>(&g.lambdas, lam);
        return cg_cat(cg_cat("{ ptr @", lname), ", ptr null }");
    }
    if (e.kind == EK_ARRAYLIT) {
        // Fixed-size array literal `{...}`: llty is "[N x T]". Emit an LLVM array constant
        // "[T v0, T v1, ...]", folding each element to T and zero-filling any tail (C
        // semantics: `int[3] = {7}` -> {7,0,0}), recursing for nested arrays.
        if ((int)llty[0] != 91) { return "zeroinitializer"; }    // 91 = '[' ; not an array type
        int L = cg_strlen(llty);
        int i = 1;                                               // past '['
        int cnt = 0;
        while (llty[i] != 0 && (int)llty[i] >= 48 && (int)llty[i] <= 57) {
            cnt = cnt * 10 + ((int)llty[i] - 48); i = i + 1;
        }
        int es = i + 3;                                          // skip " x " to the element type
        int ee = L - 1;                                          // drop the trailing ']'
        *uint8 buf = alloc<uint8>(ee - es + 1);
        int k = 0; while (k < ee - es) { buf[k] = (uint8)llty[es + k]; k = k + 1; }
        buf[ee - es] = 0;
        string elemty = (string)buf;
        let out: String; String_init(&out, 64);
        String_push(&out, '[');
        int nk = List_len<*ExprNode>(&e.kids);
        int idx = 0;
        while (idx < cnt) {
            if (idx > 0) { String_append(&out, ", "); }
            String_append(&out, elemty); String_push(&out, ' ');
            if (idx < nk) {
                String_append(&out, cg_global_init(g, List_get<*ExprNode>(&e.kids, idx), elemty));
            } else {
                String_append(&out, "zeroinitializer");
            }
            idx = idx + 1;
        }
        String_push(&out, ']');
        return (string)String_cstr(&out);
    }
    return "zeroinitializer";
}

int cg_is_float(string ty) {
    return cg_streq(ty, "double") == 1 || cg_streq(ty, "float") == 1;
}

// Floating-point arithmetic op → LLVM mnemonic ("" if not arithmetic). No bitwise/shift.
string cg_farith_op(string s) {
    if (cg_streq(s, "+") == 1) { return "fadd"; }
    if (cg_streq(s, "-") == 1) { return "fsub"; }
    if (cg_streq(s, "*") == 1) { return "fmul"; }
    if (cg_streq(s, "/") == 1) { return "fdiv"; }
    if (cg_streq(s, "%") == 1) { return "frem"; }
    return "";
}

// Floating-point comparison predicate (ordered) → LLVM mnemonic ("" if not a comparison).
string cg_fcmp_pred(string s) {
    if (cg_streq(s, "==") == 1) { return "oeq"; }
    if (cg_streq(s, "!=") == 1) { return "une"; }
    if (cg_streq(s, "<") == 1) { return "olt"; }
    if (cg_streq(s, ">") == 1) { return "ogt"; }
    if (cg_streq(s, "<=") == 1) { return "ole"; }
    if (cg_streq(s, ">=") == 1) { return "oge"; }
    return "";
}

// Integer arithmetic/bitwise op → LLVM mnemonic ("" if not such an op).
string cg_arith_op(string s) {
    if (cg_streq(s, "+") == 1) { return "add"; }
    if (cg_streq(s, "-") == 1) { return "sub"; }
    if (cg_streq(s, "*") == 1) { return "mul"; }
    if (cg_streq(s, "/") == 1) { return "sdiv"; }
    if (cg_streq(s, "%") == 1) { return "srem"; }
    if (cg_streq(s, "&") == 1) { return "and"; }
    if (cg_streq(s, "|") == 1) { return "or"; }
    if (cg_streq(s, "^") == 1) { return "xor"; }
    if (cg_streq(s, "<<") == 1) { return "shl"; }
    if (cg_streq(s, ">>") == 1) { return "ashr"; }
    return "";
}

// Comparison op → LLVM icmp predicate ("" if not a comparison).
string cg_cmp_pred(string s) {
    if (cg_streq(s, "==") == 1) { return "eq"; }
    if (cg_streq(s, "!=") == 1) { return "ne"; }
    if (cg_streq(s, "<") == 1) { return "slt"; }
    if (cg_streq(s, ">") == 1) { return "sgt"; }
    if (cg_streq(s, "<=") == 1) { return "sle"; }
    if (cg_streq(s, ">=") == 1) { return "sge"; }
    return "";
}

// Arithmetic op honoring signedness: unsigned operands use udiv/urem/lshr (logical) in
// place of the signed sdiv/srem/ashr. Other ops are signedness-agnostic.
string cg_arith_op_s(string s, int uns) {
    if (uns == 1) {
        if (cg_streq(s, "/") == 1) { return "udiv"; }
        if (cg_streq(s, "%") == 1) { return "urem"; }
        if (cg_streq(s, ">>") == 1) { return "lshr"; }
    }
    return cg_arith_op(s);
}

// Comparison predicate honoring signedness: unsigned operands use ult/ugt/ule/uge.
string cg_cmp_pred_s(string s, int uns) {
    if (uns == 1) {
        if (cg_streq(s, "<") == 1) { return "ult"; }
        if (cg_streq(s, ">") == 1) { return "ugt"; }
        if (cg_streq(s, "<=") == 1) { return "ule"; }
        if (cg_streq(s, ">=") == 1) { return "uge"; }
    }
    return cg_cmp_pred(s);
}

int cg_fn_exists(Codegen* g, string name) {
    int i = 0; int n = List_len<CgFn>(&g.fns);
    while (i < n) { if (cg_streq(List_get<CgFn>(&g.fns, i).name, name) == 1) { return 1; } i = i + 1; }
    return 0;
}
// Resolve a binary/index `op` over operand types to its overload fn name (exact mangled-name
// match), or "". Operand numeric coercion is not mirrored (a C++-only nicety): declare the
// operator with the operand's exact type.
int cg_is_num_ty(Codegen* g, string t) {
    string ll = cg_lltype(g, t);
    if (cg_is_float(ll) == 1) { return 1; }
    if (cg_int_w(ll) > 0) { return 1; }
    return 0;
}
// Is a binary `op` declared for the exact operand types (a, b)? Returns its fn name or "".
string cg_op_try(Codegen* g, string op, string a, string b) {
    let tys: List<string>; List_init<string>(&tys, 2);
    List_push<string>(&tys, a); List_push<string>(&tys, b);
    string nm = ast_op_name(op, &tys);
    if (nm[0] != 0 && cg_fn_exists(g, nm) == 1) { return nm; }
    return "";
}
string cg_op_resolve(Codegen* g, string op, string ta, string tb) {
    if (ta[0] == 0 || tb[0] == 0) { return ""; }
    string r = cg_op_try(g, op, ta, tb);              // exact operand types
    if (r[0] != 0) { return r; }
    // Numeric coercion (mirrors the C++ resolver's assignability): a numeric operand may
    // match an operator declared with another numeric param type, so `V3 * 2.0` (double)
    // finds `operator *(V3, float)`. Try the standard numeric param spellings.
    if (cg_is_num_ty(g, tb) == 1) {
        r = cg_op_try(g, op, ta, "double"); if (r[0] != 0) { return r; }
        r = cg_op_try(g, op, ta, "float");  if (r[0] != 0) { return r; }
        r = cg_op_try(g, op, ta, "int");    if (r[0] != 0) { return r; }
        r = cg_op_try(g, op, ta, "int64");  if (r[0] != 0) { return r; }
    }
    if (cg_is_num_ty(g, ta) == 1) {
        r = cg_op_try(g, op, "double", tb); if (r[0] != 0) { return r; }
        r = cg_op_try(g, op, "float", tb);  if (r[0] != 0) { return r; }
        r = cg_op_try(g, op, "int", tb);    if (r[0] != 0) { return r; }
        r = cg_op_try(g, op, "int64", tb);  if (r[0] != 0) { return r; }
    }
    return "";
}
string cg_op_resolve1(Codegen* g, string op, string ta) {
    if (ta[0] == 0) { return ""; }
    let tys: List<string>; List_init<string>(&tys, 1);
    List_push<string>(&tys, ta);
    string nm = ast_op_name(op, &tys);
    if (nm[0] != 0 && cg_fn_exists(g, nm) == 1) { return nm; }
    return "";
}
// Emit a call to a resolved operator function with 1 or 2 operand exprs (a2 null = unary),
// reusing the normal EK_CALL lowering (arg coercion + struct-by-value ABI).
CgVal cg_op_call(Codegen* g, string fnname, *ExprNode a1, *ExprNode a2) {
    *ExprNode c = alloc<ExprNode>(1);
    c.kind = EK_CALL;
    c.a = cgb_ident(fnname);
    List_init<*ExprNode>(&c.kids, 2);
    List_push<*ExprNode>(&c.kids, a1);
    if (a2 != null) { List_push<*ExprNode>(&c.kids, a2); }
    return cg_expr(g, c);
}

// Is `t` an integer / numeric Eskiu type (a plain enum counts as int)? Mirrors the C++
// type checker's isIntType / isNumericType.
int cg_is_int_ety(Codegen* g, string t) {
    if (cg_in_strlist(&g.enum_names, t) == 1) { return 1; }
    return cg_streq(t, "int") == 1 || cg_streq(t, "int8") == 1 || cg_streq(t, "int16") == 1
        || cg_streq(t, "int32") == 1 || cg_streq(t, "int64") == 1 || cg_streq(t, "uint") == 1
        || cg_streq(t, "uint8") == 1 || cg_streq(t, "uint16") == 1 || cg_streq(t, "uint32") == 1
        || cg_streq(t, "uint64") == 1 || cg_streq(t, "char") == 1 || cg_streq(t, "bool") == 1;
}
int cg_is_num_ety(Codegen* g, string t) {
    if (cg_streq(t, "float") == 1 || cg_streq(t, "double") == 1) { return 1; }
    return cg_is_int_ety(g, t);
}
int cg_is_ptr_ety(string t) { return cg_is_ptr_ty(t) == 1 || cg_streq(t, "string") == 1; }

// The integer width an Eskiu type ranks at for promotion: 64/32, 16 for any narrower
// integer (it promotes to int), 0 for a non-integer.
int cg_rank_w(Codegen* g, string t) {
    if (cg_streq(t, "int64") == 1 || cg_streq(t, "uint64") == 1) { return 64; }
    if (cg_streq(t, "int") == 1 || cg_streq(t, "int32") == 1 || cg_streq(t, "uint") == 1
        || cg_streq(t, "uint32") == 1) { return 32; }
    if (cg_is_int_ety(g, t) == 1) { return 16; }
    return 0;
}

// The common type of two numeric operands. Mirrors the C++ TypeChecker::promoteType
// exactly (including its rank order), so signedness and width decisions agree.
string cg_promote(Codegen* g, string a, string b) {
    if (cg_in_strlist(&g.enum_names, a) == 1) { a = "int"; }
    if (cg_in_strlist(&g.enum_names, b) == 1) { b = "int"; }
    if (cg_streq(a, b) == 1) { return a; }
    if (cg_streq(a, "double") == 1 || cg_streq(b, "double") == 1) { return "double"; }
    if (cg_streq(a, "float") == 1 || cg_streq(b, "float") == 1) { return "float"; }
    // C's usual arithmetic conversions once an operand is int-sized or wider (a narrow
    // operand counts as int): signed/unsigned is unsigned unless the signed type is wider.
    int wa = cg_rank_w(g, a); int wb = cg_rank_w(g, b);
    if (wa > 0 && wb > 0 && (wa >= 32 || wb >= 32)) {
        int ua = 0; if (wa >= 32 && cg_is_unsigned(a) == 1) { ua = 1; }
        int ub = 0; if (wb >= 32 && cg_is_unsigned(b) == 1) { ub = 1; }
        if (wa < 32) { wa = 32; }
        if (wb < 32) { wb = 32; }
        int w = wa; int u = ua;
        if (ua == ub) { if (wb > wa) { w = wb; } }
        else {
            int wu = wa; int ws = wb;
            if (ub == 1) { wu = wb; ws = wa; }
            if (wu >= ws) { w = wu; u = 1; } else { w = ws; u = 0; }
        }
        if (w == 64) { if (u == 1) { return "uint64"; } return "int64"; }
        if (u == 1) { return "uint32"; }
        return "int32";
    }
    if (cg_streq(a, "int64") == 1 || cg_streq(b, "int64") == 1) { return "int64"; }
    if (cg_streq(a, "uint64") == 1 || cg_streq(b, "uint64") == 1) { return "uint64"; }
    if (cg_streq(a, "int32") == 1 || cg_streq(b, "int32") == 1) { return "int32"; }
    if (cg_streq(a, "uint32") == 1 || cg_streq(b, "uint32") == 1) { return "uint32"; }
    if (cg_streq(a, "int16") == 1 || cg_streq(b, "int16") == 1) { return "int16"; }
    if (cg_streq(a, "uint16") == 1 || cg_streq(b, "uint16") == 1) { return "uint16"; }
    return a;
}

// The type of a built-in binary operator over operand types (l, r), "" if unknown.
// Mirrors the C++ TypeChecker::inferBinaryExprType.
string cg_binary_ety(Codegen* g, string op, string l, string r) {
    string cmp = cg_cmp_pred(op);
    if (cg_streq(op, "&&") == 1 || cg_streq(op, "||") == 1 || cmp[0] != 0) { return "bool"; }
    l = cg_strip_nullable(l); r = cg_strip_nullable(r);
    if (l[0] == 0 || r[0] == 0) { return ""; }
    if (cg_streq(op, "-") == 1 && cg_is_ptr_ety(l) == 1 && cg_is_ptr_ety(r) == 1) { return "int64"; }
    if (cg_streq(op, "+") == 1 || cg_streq(op, "-") == 1) {
        if (cg_is_ptr_ety(l) == 1 && cg_is_int_ety(g, r) == 1) { return l; }
        if (cg_streq(op, "+") == 1 && cg_is_ptr_ety(r) == 1 && cg_is_int_ety(g, l) == 1) { return r; }
    }
    // C integer promotion: a narrower-than-int operand is an int; a shift has the
    // (promoted) type of its left operand alone.
    if (cg_rank_w(g, l) == 16) { l = "int"; }
    if (cg_rank_w(g, r) == 16) { r = "int"; }
    if ((cg_streq(op, "<<") == 1 || cg_streq(op, ">>") == 1) && cg_is_int_ety(g, l) == 1) { return l; }
    if (cg_is_num_ety(g, l) == 1 && cg_is_num_ety(g, r) == 1) { return cg_promote(g, l, r); }
    return "";
}

// The fn-type spelling of a lambda: `int(int x, double y)` → "fn(int,double)->int".
string cg_lambda_ety(*ExprNode e) {
    List<string> pp; List_init<string>(&pp, 4); cg_paren_list(e.sval, &pp);
    String s; String_init(&s, 32);
    String_append(&s, "fn(");
    int i = 0;
    while (i < List_len<string>(&pp)) {
        if (i > 0) { String_append(&s, ","); }
        String_append(&s, cg_drop_last_word(List_get<string>(&pp, i)));
        i = i + 1;
    }
    String_append(&s, ")->"); String_append(&s, cg_arm_var(e.sval));
    return (string)String_cstr(&s);
}

// The return type of a generic function called without explicit type args, from the type
// args inferred off its arguments ("" if they can't be inferred). No instantiation.
string cg_infer_generic_ret(Codegen* g, *DeclNode gd, *ExprNode e) {
    string spelling = cg_infer_generic(g, gd, e);
    if (spelling[0] == 0) { return ""; }
    spelling = cg_apply_sub(g, spelling);
    List<string> args; List_init<string>(&args, 4); cg_gen_args(spelling, &args);
    List<CgSub> oldsub = cg_push_sub(g, gd, &args);
    string rt = cg_apply_sub(g, gd.ret_type);
    g.cursub = oldsub;
    return rt;
}

// A ternary arm's type: an integer literal that does not fit `int` is 64-bit (C: the
// first of int, long, unsigned long that holds it), so `c ? x : 10000000000` is an int64.
string cg_lit_arm_etype(Codegen* g, *ExprNode e) {
    if (e != null && e.kind == EK_LITERAL && e.lit_kind == LIT_INT) {
        uint64 m = cg_int_lit_mag(e.sval);
        if (e.sval[0] != 45 && m > (uint64)9223372036854775807) { return "uint64"; }   // -2^63 is an int64
        if (e.sval[0] == 45) { if (m > (uint64)2147483648) { return "int64"; } }
        else if (m > (uint64)2147483647) { return "int64"; }
        return "int";
    }
    // A named top-level function as an arm is a function value: its `fn(...)->R` type,
    // so the arm decays to a closure (`k > 0 ? inc : dbl`), as in the C++ type checker.
    if (e != null && e.kind == EK_IDENT && cg_find_local(g, e.sval).slot[0] == 0
        && cg_find_global(g, e.sval).slot[0] == 0 && cg_is_fn(g, e.sval) == 1) {
        CgFn f = cg_find_fn(g, e.sval);
        string ft = "fn(";
        int i = 0;
        while (i < List_len<string>(&f.petys)) {
            if (i > 0) { ft = cg_cat(ft, ", "); }
            ft = cg_cat(ft, List_get<string>(&f.petys, i));
            i = i + 1;
        }
        return cg_cat(ft, cg_cat(")->", f.rety));
    }
    return cg_etype(g, e);
}

// The common type of a ternary's two arm types (C++ rule).
string cg_arm_common(Codegen* g, string tt, string et) {
    if (cg_streq(tt, et) == 1) { return tt; }
    if (tt[0] == 0) { return et; }
    if (et[0] == 0) { return tt; }
    // A struct-pointer arm meets an interface arm as the interface.
    if (cg_is_iface(g, cg_dealias(g, et)) == 1 && cg_is_iface(g, cg_dealias(g, tt)) == 0) { return et; }
    if (cg_is_num_ety(g, tt) == 1 && cg_is_num_ety(g, et) == 1) {
        // Two different numeric types: C's usual arithmetic conversions (narrow arms meet as int).
        if (cg_rank_w(g, tt) == 16) { tt = "int"; }
        if (cg_rank_w(g, et) == 16) { et = "int"; }
        return cg_promote(g, tt, et);
    }
    return tt;
}

// A ternary whose else arm is itself a ternary (`c1 ? a : c2 ? b : ...`) nests as deep
// as the chain is long. Fills `chain` with its links (outermost first) and `etys` with
// each link's type, computed once, bottom-up, instead of once per link.
void cg_ternary_etys(Codegen* g, *ExprNode e, List<*ExprNode>* chain, List<string>* etys) {
    List<string> tts; List_init<string>(&tts, 4);
    *ExprNode n = e;
    while (true) {
        List_push<*ExprNode>(chain, n);
        List_push<string>(&tts, cg_lit_arm_etype(g, n.b));
        *ExprNode els = List_get<*ExprNode>(&n.kids, 0);
        if (els == null || els.kind != EK_TERNARY) { break; }
        n = els;
    }
    int k = List_len<*ExprNode>(chain);
    int i = 0;
    while (i < k) { List_push<string>(etys, ""); i = i + 1; }
    *ExprNode last = List_get<*ExprNode>(chain, k - 1);
    string et = cg_lit_arm_etype(g, List_get<*ExprNode>(&last.kids, 0));
    i = k - 1;
    while (i >= 0) {
        et = cg_arm_common(g, List_get<string>(&tts, i), et);
        List_set<string>(etys, i, et);
        i = i - 1;
    }
    List_free<string>(&tts);
}

// The type of prefix operator `e` over an operand of type `at`.
string cg_unary_ety(Codegen* g, *ExprNode e, string at) {
    if (cg_streq(e.sval, "*") == 1) { return cg_deref_ty(at); }
    if (cg_streq(e.sval, "&") == 1) { return cg_cat("*", at); }
    string uop = e.sval; if (cg_streq(uop, "-") == 1) { uop = "u-"; }
    string uopn = cg_op_resolve1(g, uop, at);
    if (uopn[0] != 0) { return cg_find_fn(g, uopn).rety; }
    if (cg_streq(e.sval, "!") == 1) { return "bool"; }
    if ((cg_streq(e.sval, "-") == 1 || cg_streq(e.sval, "~") == 1) && cg_rank_w(g, at) == 16) { return "int"; }
    return at;
}

// The Eskiu type of an expression ("" if unknown). Mirrors the type the C++ type checker
// assigns, so struct member access, pointer depth, and common/promoted types agree.
// `x.m(args)` where x is an instance `S<A..>` of a generic struct with no inline method
// `m` but a generic free function `S_m<T..>` taking it first (the `Type_method`
// convention, e.g. `List_push<T>(List<T>* self, T item)`): the equivalent explicit call
// `S_m<A..>(&x, args)` (`S_m<A..>(x, args)` for a pointer receiver). A type parameter
// named by the self parameter's type arguments takes the receiver's argument at that
// position; any other one is inferred from the arguments. null when `e` is not such a call.
*ExprNode cg_generic_method_call(Codegen* g, *ExprNode e) {
    if (e == null || e.a == null || e.a.kind != EK_MEMBER) { return null; }
    string recv = cg_apply_sub(g, cg_etype(g, e.a.a));
    int rptr = cg_is_ptr_ty(recv);
    string sname = recv;
    if (rptr == 1) { sname = cg_strip_ptr(recv); }
    if (cg_has_targs(sname) == 0) { return null; }
    string base = cg_gen_base(sname);
    *DeclNode sd = cg_find_gstruct(g, base);
    if (sd == null) { return null; }
    int mi = 0;
    while (mi < List_len<*DeclNode>(&sd.methods)) {
        if (cg_streq(List_get<*DeclNode>(&sd.methods, mi).name, e.a.sval) == 1) { return null; }
        mi = mi + 1;
    }
    *DeclNode gd = cg_find_gfn(g, cg_cat(cg_cat(base, "_"), e.a.sval));
    if (gd == null || List_len<Param>(&gd.params) == 0) { return null; }
    string selfty = List_get<Param>(&gd.params, 0).ty;
    List<string> sargs; List_init<string>(&sargs, 2); cg_gen_args(cg_strip_ptr(selfty), &sargs);
    List<string> rargs; List_init<string>(&rargs, 2); cg_gen_args(sname, &rargs);
    String sp; String_init(&sp, 16);
    String_append(&sp, gd.name); String_append(&sp, "<");
    int ti = 0; int ntp = List_len<TypeParam>(&gd.type_params);
    while (ti < ntp) {
        string tp = List_get<TypeParam>(&gd.type_params, ti).name;
        string binding = "";
        int k = 0;
        while (binding[0] == 0 && k < List_len<string>(&sargs) && k < List_len<string>(&rargs)) {
            if (cg_streq(List_get<string>(&sargs, k), tp) == 1) { binding = List_get<string>(&rargs, k); }
            k = k + 1;
        }
        int pi = 1; int np = List_len<Param>(&gd.params);
        while (binding[0] == 0 && pi < np && pi - 1 < List_len<*ExprNode>(&e.kids)) {
            string argty = cg_etype(g, List_get<*ExprNode>(&e.kids, pi - 1));
            if (argty[0] != 0) { binding = cg_infer_bind(List_get<Param>(&gd.params, pi).ty, tp, argty); }
            pi = pi + 1;
        }
        if (binding[0] == 0) { return null; }
        if (ti > 0) { String_append(&sp, ", "); }
        String_append(&sp, binding);
        ti = ti + 1;
    }
    String_append(&sp, ">");
    int sptr = cg_is_ptr_ty(selfty);
    *ExprNode r = e.a.a;
    if (sptr != rptr) {
        *ExprNode u = alloc<ExprNode>(1); u.kind = EK_UNARY; u.a = r; u.line = e.line; u.col = e.col;
        if (sptr == 1) { u.sval = "&"; } else { u.sval = "*"; }
        r = u;
    }
    *ExprNode c = alloc<ExprNode>(1);
    c.kind = EK_TEMPLATECALL; c.sval = (string)String_cstr(&sp); c.line = e.line; c.col = e.col;
    List_init<*ExprNode>(&c.kids, List_len<*ExprNode>(&e.kids) + 1);
    List_push<*ExprNode>(&c.kids, r);
    int ki = 0;
    while (ki < List_len<*ExprNode>(&e.kids)) { List_push<*ExprNode>(&c.kids, List_get<*ExprNode>(&e.kids, ki)); ki = ki + 1; }
    return c;
}

// The return type of a generic free-function call spelled `name<args>` (the instance's
// substituted return type; the instance itself need not be emitted yet).
string cg_generic_call_ret(Codegen* g, string spelling) {
    *DeclNode gd = cg_find_gfn(g, cg_gen_base(spelling));
    if (gd == null) { return ""; }
    List<string> args; List_init<string>(&args, 4); cg_gen_args(spelling, &args);
    List<CgSub> oldsub = cg_push_sub(g, gd, &args);
    string rt = cg_apply_sub(g, gd.ret_type);
    g.cursub = oldsub;
    return rt;
}

// The type of a `for (i in A..B)` bound: a bare integer literal by its value (the
// first of int, int64, uint64 that holds it, as sema types it), else its expression type.
string cg_range_bound_type(Codegen* g, *ExprNode e) {
    if (e != null && e.kind == EK_LITERAL && e.lit_kind == LIT_INT) { return ast_range_lit_type(e.sval); }
    return cg_dealias(g, cg_strip_lead_const(cg_etype(g, e)));
}

string cg_etype(Codegen* g, *ExprNode e) {
    if (e == null) { return ""; }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) { return cg_lit_arm_etype(g, e); }   // int, int64 or uint64 by value
        if (e.lit_kind == LIT_FLOAT) { return "double"; }
        if (e.lit_kind == LIT_BOOL) { return "bool"; }
        if (e.lit_kind == LIT_CHAR) { return "char"; }
        if (e.lit_kind == LIT_STRING) { return "string"; }
        return "";
    }
    if (e.kind == EK_IDENT) {
        CgLocal l = cg_find_local(g, e.sval);
        if (l.slot[0] != 0) { return l.ety; }
        CgLocal gl = cg_find_global(g, e.sval);
        if (gl.slot[0] != 0) { return gl.ety; }
        string ev = cg_enum_val(g, e.sval);                // a plain-enum / folded const-int constant
        if (ev[0] != 0) { return "int"; }
        CgVariant var = cg_find_variant(g, e.sval);        // a payload-less ADT variant (`None`)
        if (var.ename[0] != 0) { return var.ename; }
        return "";
    }
    if (e.kind == EK_MEMBER) {
        string bet = cg_etype(g, e.a);
        string sname = bet;
        if (cg_is_ptr_ty(bet) == 1) { sname = cg_strip_ptr(bet); }
        CgStruct s = cg_find_struct(g, sname);
        int idx = cg_field_idx(&s, e.sval);
        if (idx >= 0) {
            CgBF bslot = cg_bf(g, sname, e.sval);
            if (bslot.bw > 0) { return cg_bf_read_ety(g, bslot); }   // a narrow bitfield reads as int
            return List_get<string>(&s.fetys, idx);
        }
        return "";
    }
    if (e.kind == EK_INDEX) {
        string bet = cg_etype(g, e.a);
        string elem = "";
        if (cg_streq(bet, "string") == 1) { elem = "char"; }
        else if (cg_is_slice(bet) == 1) { elem = cg_array_elem(bet); }
        else if (cg_is_array(bet) == 1) { elem = cg_array_elem(bet); }
        else if (cg_is_ptr_ty(bet) == 1) { elem = cg_deref_ty(bet); }
        else {
            if (List_len<*ExprNode>(&e.kids) == 0) {       // overloaded subscript `base[i]`
                string opn = cg_op_resolve(g, "[]", bet, cg_etype(g, e.b));
                if (opn[0] != 0) { return cg_find_fn(g, opn).rety; }
            }
            return "";
        }
        // `base[lo..hi]` (kids has the hi bound) is a slice of the element type.
        if (List_len<*ExprNode>(&e.kids) > 0) { return cg_cat(elem, "[]"); }
        return elem;
    }
    if (e.kind == EK_UNARY) {
        // A chain of prefix operators (`- - x`, `!!p`, `**pp`) is typed along its operand
        // spine with a loop, each operand's type computed once.
        List<*ExprNode> spine; List_init<*ExprNode>(&spine, 4);
        *ExprNode u = e;
        while (u != null && u.kind == EK_UNARY) { List_push<*ExprNode>(&spine, u); u = u.a; }
        string ut = cg_etype(g, u);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) { ut = cg_unary_ety(g, List_get<*ExprNode>(&spine, i), ut); i = i - 1; }
        List_free<*ExprNode>(&spine);
        return ut;
    }
    if (e.kind == EK_BINARY) {
        if (cg_streq(e.sval, "=") == 1) { return cg_etype(g, e.a); }   // assignment yields the target's type
        // A left-leaning chain (`a + b + c ...`) is typed along its left spine with a loop:
        // the leftmost operand, then each operator bottom-up over the running type.
        List<*ExprNode> spine; List_init<*ExprNode>(&spine, 8);
        *ExprNode b = e;
        while (b != null && b.kind == EK_BINARY && cg_streq(b.sval, "=") == 0) {
            List_push<*ExprNode>(&spine, b);
            b = b.a;
        }
        string lt = cg_etype(g, b);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) {
            *ExprNode n = List_get<*ExprNode>(&spine, i);
            string rt = cg_etype(g, n.b);
            string bopn = cg_op_resolve(g, n.sval, lt, rt);   // overloaded binary → its ret type
            if (bopn[0] != 0) { lt = cg_find_fn(g, bopn).rety; }
            else { lt = cg_binary_ety(g, n.sval, lt, rt); }
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        return lt;
    }
    if (e.kind == EK_TEMPLATECALL) {
        List<string> ta; List_init<string>(&ta, 2); cg_gen_args(e.sval, &ta);
        string vb = cg_gen_base(e.sval);
        if (cg_streq(vb, "va_arg") == 1 && List_len<string>(&ta) > 0) { return cg_apply_sub(g, List_get<string>(&ta, 0)); }
        CgVariant gvar = cg_find_gvariant(g, vb);          // generic variant ctor `Some<int>(…)`
        if (gvar.ename[0] != 0) {
            String sp; String_init(&sp, 16);
            String_append(&sp, gvar.ename); String_append(&sp, "<");
            int ti = 0;
            while (ti < List_len<string>(&ta)) {
                if (ti > 0) { String_append(&sp, ", "); }
                String_append(&sp, List_get<string>(&ta, ti)); ti = ti + 1;
            }
            String_append(&sp, ">");
            return cg_ensure_enum_inst(g, (string)String_cstr(&sp));
        }
        string trt = cg_find_fn(g, cg_mangle(cg_apply_sub(g, e.sval))).rety;
        // Not instantiated yet (an argument typed for inference, `spawn(task<int>(3))`):
        // the template's substituted return type.
        if (trt[0] == 0) { trt = cg_generic_call_ret(g, cg_apply_sub(g, e.sval)); }
        return trt;
    }
    if (e.kind == EK_CALL) {
        if (e.a != null && e.a.kind == EK_MEMBER) {
            string cft = cg_etype(g, e.a);                 // a closure-typed field: `fr.waker()`
            if (cg_is_fnty(cft) == 1) { return cg_fnty_ret(cft); }
            string recv = cg_etype(g, e.a.a);
            if (cg_is_iface(g, recv) == 1) {               // interface dispatch → the method's ret
                CgIface f = cg_find_iface(g, recv);
                int mi = cg_iface_midx(&f, e.a.sval);
                if (mi >= 0) { return List_get<string>(&f.mrets, mi); }
                return "";
            }
            *ExprNode gmc = cg_generic_method_call(g, e);   // `l.push(x)` → `List_push<T>(&l, x)`
            if (gmc != null) { return cg_generic_call_ret(g, gmc.sval); }
            string sname = cg_strip_ptr(recv);            // method call → Struct_method
            string mname = cg_method_fn(g, sname, e.a.sval);
            if (cg_is_fn(g, mname) == 0 && cg_is_struct(g, sname) == 0 && cg_is_fn(g, e.a.sval) == 1) {
                return cg_find_fn(g, e.a.sval).rety;       // primitive receiver → free fn `m(recv, …)`
            }
            return cg_find_fn(g, mname).rety;
        }
        if (e.a != null && e.a.kind == EK_IDENT) {
            CgLocal lf = cg_find_local(g, e.a.sval);
            if (lf.slot[0] == 0) { lf = cg_find_global(g, e.a.sval); }
            if (lf.slot[0] != 0 && cg_is_fnty(lf.ety) == 1) { return cg_fnty_ret(lf.ety); }   // closure call
            if (cg_streq(e.a.sval, "va_start") == 1 || cg_streq(e.a.sval, "va_end") == 1) { return "void"; }
            CgVariant var = cg_find_variant(g, e.a.sval);  // ADT variant constructor `Circle(4)`
            if (var.ename[0] != 0) { return var.ename; }
            *DeclNode gd = cg_find_gfn(g, e.a.sval);        // generic fn, type args inferred
            if (gd != null) { return cg_infer_generic_ret(g, gd, e); }
            return cg_find_fn(g, e.a.sval).rety;
        }
        string ct = cg_etype(g, e.a);                      // any other callee yielding a closure
        if (cg_is_fnty(ct) == 1) { return cg_fnty_ret(ct); }
        return "";
    }
    if (e.kind == EK_CAST) { return cg_apply_sub(g, e.sval); }
    if (e.kind == EK_TERNARY) {                        // common type of the two arms (C++ rule)
        List<*ExprNode> chain; List_init<*ExprNode>(&chain, 4);
        List<string> etys; List_init<string>(&etys, 4);
        cg_ternary_etys(g, e, &chain, &etys);
        string tty = List_get<string>(&etys, 0);
        List_free<*ExprNode>(&chain); List_free<string>(&etys);
        return tty;
    }
    if (e.kind == EK_STRUCTINIT) { return cg_apply_sub(g, e.sval); }
    if (e.kind == EK_SIZEOF) { return "int64"; }
    if (e.kind == EK_INCDEC) {
        // `b.f++` of a bitfield: the old value in its declared type (as clang).
        if ((int)e.sval[1] != 114 && e.a != null && e.a.kind == EK_MEMBER) {
            string ibt = cg_etype(g, e.a.a);
            string isn = ibt; if (cg_is_ptr_ty(ibt) == 1) { isn = cg_strip_ptr(ibt); }
            CgBF islot = cg_bf(g, isn, e.a.sval);
            if (islot.bw > 0) { return islot.fety; }
        }
        return cg_etype(g, e.a);
    }
    if (e.kind == EK_LAMBDA) { return cg_lambda_ety(e); }
    if (e.kind == EK_ALLOCWITH) { return cg_cat("*", cg_apply_sub(g, e.sval)); }
    if (e.kind == EK_THREADCREATE) { return "*void"; }
    if (e.kind == EK_QUESTION) {                       // `r?` → the Result's `.value` type
        string rs = cg_etype(g, e.a);
        CgStruct s = cg_find_struct(g, rs);
        int vi = cg_field_idx(&s, "value");
        if (vi >= 0) { return List_get<string>(&s.fetys, vi); }
        return "";
    }
    return "";
}

// Address of an lvalue: returns a `ptr` operand + the lvalue's Eskiu type.
CgVal cg_lval(Codegen* g, *ExprNode e) {
    let v: CgVal; v.op = ""; v.ty = "ptr"; v.ety = "";
    if (e == null) { return v; }
    if (e.kind == EK_IDENT) {
        CgLocal l = cg_find_local(g, e.sval);
        if (l.slot[0] != 0) { v.op = l.slot; v.ety = l.ety; return v; }   // slot is a pointer
        CgLocal gv = cg_find_global(g, e.sval);        // global symbol IS its address
        v.op = gv.slot; v.ety = gv.ety; return v;
    }
    if (e.kind == EK_UNARY && cg_streq(e.sval, "*") == 1) {
        CgVal p = cg_expr(g, e.a);                      // value of the pointer = the address
        v.op = p.op; v.ety = cg_deref_ty(cg_etype(g, e.a)); return v;
    }
    if (e.kind == EK_INDEX) {
        string bet = cg_etype(g, e.a);
        CgVal idx = cg_expr(g, e.b);
        string t = cg_tmp(g);
        string ity = idx.ty;                            // index keeps its own width (i32/i64)
        if (cg_int_w(ity) == 0) { ity = "i32"; }         // non-int (shouldn't happen) → i32
        if (cg_is_slice(bet) == 1) {                    // slice: load .data, then GEP elem
            CgVal fat = cg_expr(g, e.a);
            string data = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, data); cg_emit(g, " = extractvalue { ptr, i64 } ");
            cg_emit(g, fat.op); cg_emit(g, ", 0\n");
            if (g.safe == 1) { cg_bounds_check(g, idx.op, ity, cg_slice_len(g, fat.op)); }
            string elem = cg_array_elem(bet);
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = getelementptr inbounds ");
            cg_emit(g, cg_lltype(g, elem)); cg_emit(g, ", ptr "); cg_emit(g, data);
            cg_emit(g, ", "); cg_emit(g, ity); cg_emit(g, " "); cg_emit(g, idx.op); cg_emit(g, "\n");
            v.op = t; v.ety = elem; return v;
        }
        if (cg_is_array(bet) == 1) {                    // array: GEP [N x T], ptr, 0, idx
            string slot = cg_addr(g, e.a).op;
            if (g.safe == 1) {
                string alen = cg_array_len_const(g, bet);
                if (cg_streq(alen, "") == 0) { cg_bounds_check(g, idx.op, ity, alen); }
            }
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = getelementptr inbounds ");
            cg_emit(g, cg_lltype(g, bet)); cg_emit(g, ", ptr "); cg_emit(g, slot);
            cg_emit(g, ", i32 0, "); cg_emit(g, ity); cg_emit(g, " "); cg_emit(g, idx.op); cg_emit(g, "\n");
            v.op = t; v.ety = cg_array_elem(bet); return v;
        }
        string pval = cg_expr(g, e.a).op;               // pointer: GEP T, ptr, idx
        string elem = cg_deref_ty(bet);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, cg_lltype(g, elem)); cg_emit(g, ", ptr "); cg_emit(g, pval);
        cg_emit(g, ", "); cg_emit(g, ity); cg_emit(g, " "); cg_emit(g, idx.op); cg_emit(g, "\n");
        v.op = t; v.ety = elem; return v;
    }
    if (e.kind == EK_MEMBER) {
        string bet = cg_etype(g, e.a);
        string sptr = "";
        string sname = bet;
        if (cg_is_ptr_ty(bet) == 1) { sptr = cg_expr(g, e.a).op; sname = cg_strip_ptr(bet); }
        else {
            CgVal base = cg_lval(g, e.a);
            if (base.op[0] != 0) { sptr = base.op; if (base.ety[0] != 0) { sname = base.ety; } }
            else {
                // The base is an rvalue with no address (e.g. a function call returning a
                // struct by value) — materialize it into a fresh alloca, then GEP into that.
                CgVal val = cg_expr(g, e.a);
                if (val.ety[0] != 0) { sname = val.ety; }
                string slot = cg_entry_alloca(g, val.ty);
                cg_emit(g, "  store "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op);
                cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
                sptr = slot;
            }
        }
        CgStruct s = cg_find_struct(g, sname);
        int idx = cg_field_idx(&s, e.sval);
        // A union's members all overlap at offset 0: GEP to the storage (field 0), and the
        // member's own type governs the later load/store. A struct uses the field index.
        int gepidx = idx;
        if (cg_is_union(g, s.name) == 1) { gepidx = 0; }
        else if (cg_is_bf_struct(g, s.name) == 1) {           // bitfield struct: its layout slot
            CgBF fs = cg_bf(g, s.name, e.sval);
            if (fs.boffs >= 0) {
                v.op = cg_bf_wordptr(g, sptr, s.name, fs);
                if (idx >= 0) { v.ety = List_get<string>(&s.fetys, idx); }
                return v;
            }
            gepidx = fs.fidx;
        }
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = getelementptr inbounds %");
        cg_emit(g, s.name); cg_emit(g, ", ptr "); cg_emit(g, sptr);
        cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(gepidx)); cg_emit(g, "\n");
        v.op = t;
        if (idx >= 0) { v.ety = List_get<string>(&s.fetys, idx); }
        return v;
    }
    return v;
}

// Address of `e` for a READ (a method receiver, an indexed array): its lvalue address, or,
// for an rvalue aggregate (a call result, `a + b`, a ternary), a temporary holding its
// value (mirrors CodeGen::evaluateAddress).
CgVal cg_addr(Codegen* g, *ExprNode e) {
    CgVal lv = cg_lval(g, e);
    if (lv.op[0] != 0) { return lv; }
    CgVal val = cg_expr(g, e);
    string slot = cg_entry_alloca(g, val.ty);
    cg_emit(g, "  store "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op);
    cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
    lv.op = slot; lv.ety = val.ety; if (lv.ety[0] == 0) { lv.ety = cg_etype(g, e); }
    return lv;
}

// --safe bounds check: trap when `idx_op` (type `ity`) is < 0 or >= `len_op` (an i64
// value or integer literal). Mirrors the C++ `emitBoundsCheck`: sext to i64, OR the two
// comparisons, cond-branch to a trap block (`@llvm.trap` + unreachable) or continue.
void cg_bounds_check(Codegen* g, string idx_op, string ity, string len_op) {
    g.uses_trap = 1;
    string idx64 = idx_op;
    if (cg_streq(ity, "i64") == 0) {                       // widen the index to i64 first
        idx64 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, idx64); cg_emit(g, " = sext "); cg_emit(g, ity);
        cg_emit(g, " "); cg_emit(g, idx_op); cg_emit(g, " to i64\n");
    }
    string lo = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, lo); cg_emit(g, " = icmp slt i64 "); cg_emit(g, idx64); cg_emit(g, ", 0\n");
    string hi = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, hi); cg_emit(g, " = icmp sge i64 "); cg_emit(g, idx64);
    cg_emit(g, ", "); cg_emit(g, len_op); cg_emit(g, "\n");
    string oob = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, oob); cg_emit(g, " = or i1 "); cg_emit(g, lo); cg_emit(g, ", "); cg_emit(g, hi); cg_emit(g, "\n");
    string fail = cg_lbl(g); string ok = cg_lbl(g);
    cg_emit(g, "  br i1 "); cg_emit(g, oob); cg_emit(g, ", label %"); cg_emit(g, fail);
    cg_emit(g, ", label %"); cg_emit(g, ok); cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, fail);
    cg_emit(g, "  call void @llvm.trap()\n");
    cg_emit(g, "  unreachable\n");
    g.terminated = 1;
    cg_label(g, ok);
}

// --safe check for a slice construction `base[lo..hi]`: trap unless 0 <= lo <= hi <= len.
// `lo`/`hi` are i64 operands; an empty len_op ("") skips the upper bound (unknown length,
// e.g. a raw-pointer base). `lo == len` is a valid empty end-slice (upper bound is hi>len).
void cg_slice_bounds_check(Codegen* g, string lo_op, string hi_op, string len_op) {
    g.uses_trap = 1;
    string c1 = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, c1); cg_emit(g, " = icmp slt i64 "); cg_emit(g, lo_op); cg_emit(g, ", 0\n");
    string c2 = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, c2); cg_emit(g, " = icmp slt i64 "); cg_emit(g, hi_op); cg_emit(g, ", "); cg_emit(g, lo_op); cg_emit(g, "\n");
    string bad = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, bad); cg_emit(g, " = or i1 "); cg_emit(g, c1); cg_emit(g, ", "); cg_emit(g, c2); cg_emit(g, "\n");
    if (cg_streq(len_op, "") == 0) {
        string c3 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, c3); cg_emit(g, " = icmp sgt i64 "); cg_emit(g, hi_op); cg_emit(g, ", "); cg_emit(g, len_op); cg_emit(g, "\n");
        string bad2 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, bad2); cg_emit(g, " = or i1 "); cg_emit(g, bad); cg_emit(g, ", "); cg_emit(g, c3); cg_emit(g, "\n");
        bad = bad2;
    }
    string fail = cg_lbl(g); string ok = cg_lbl(g);
    cg_emit(g, "  br i1 "); cg_emit(g, bad); cg_emit(g, ", label %"); cg_emit(g, fail);
    cg_emit(g, ", label %"); cg_emit(g, ok); cg_emit(g, "\n");
    g.terminated = 1;
    cg_label(g, fail);
    cg_emit(g, "  call void @llvm.trap()\n");
    cg_emit(g, "  unreachable\n");
    g.terminated = 1;
    cg_label(g, ok);
}

// Extract the length (field 1) of an already-evaluated slice fat pointer `fat_op`.
string cg_slice_len(Codegen* g, string fat_op) {
    string lenv = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, lenv); cg_emit(g, " = extractvalue { ptr, i64 } ");
    cg_emit(g, fat_op); cg_emit(g, ", 1\n");
    return lenv;
}

// The static element count of a fixed-array type, resolved through a named const/enum, or
// "" if it isn't a compile-time constant (then --safe skips the array check, as C++ does).
string cg_array_len_const(Codegen* g, string bet) {
    string rv = cg_dim_val(g, cg_array_count(bet));
    if (rv[0] != 0 && cg_all_digits(rv) == 1) { return rv; }
    return "";
}

// Address of element `idx_op` (already evaluated, type `ity`) of an indexable base
// (slice / fixed array / string / pointer). Used by slice construction so the low
// bound is evaluated exactly once (matching the C++ back-end).
string cg_slice_elem_addr(Codegen* g, *ExprNode base, string idx_op, string hi_op, string ity) {
    string bet = cg_etype(g, base);
    string t = cg_tmp(g);
    if (cg_is_slice(bet) == 1) {
        CgVal fat = cg_expr(g, base);
        string data = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, data); cg_emit(g, " = extractvalue { ptr, i64 } ");
        cg_emit(g, fat.op); cg_emit(g, ", 0\n");
        // 0 <= lo <= hi <= len (lo == len is a valid empty end-slice), not the element check.
        if (g.safe == 1) { cg_slice_bounds_check(g, idx_op, hi_op, cg_slice_len(g, fat.op)); }
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, cg_lltype(g, cg_array_elem(bet))); cg_emit(g, ", ptr "); cg_emit(g, data);
        cg_emit(g, ", "); cg_emit(g, ity); cg_emit(g, " "); cg_emit(g, idx_op); cg_emit(g, "\n");
        return t;
    }
    if (cg_is_array(bet) == 1) {
        string slot = cg_lval(g, base).op;
        if (g.safe == 1) { cg_slice_bounds_check(g, idx_op, hi_op, cg_array_len_const(g, bet)); }
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, cg_lltype(g, bet)); cg_emit(g, ", ptr "); cg_emit(g, slot);
        cg_emit(g, ", i32 0, "); cg_emit(g, ity); cg_emit(g, " "); cg_emit(g, idx_op); cg_emit(g, "\n");
        return t;
    }
    string elem = "i8";
    if (cg_streq(bet, "string") == 0) { elem = cg_lltype(g, cg_deref_ty(bet)); }
    string pval = cg_expr(g, base).op;
    if (g.safe == 1) { cg_slice_bounds_check(g, idx_op, hi_op, ""); }   // raw pointer/string: len unknown, only lo<=hi
    cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = getelementptr inbounds ");
    cg_emit(g, elem); cg_emit(g, ", ptr "); cg_emit(g, pval);
    cg_emit(g, ", "); cg_emit(g, ity); cg_emit(g, " "); cg_emit(g, idx_op); cg_emit(g, "\n");
    return t;
}

// Evaluate argument `ax` for parameter `i` of `f`. A C function pointer parameter (an
// extern's fn-typed one, declared `ptr`) takes a top-level function's C address.
// A `?:` whose value goes to interface `tety` boxes each arm with its own struct's vtable
// (mirrors the C++ ifaceTargetHint), so the arms may point at different conforming structs.
void cg_hint_iface(Codegen* g, *ExprNode x, string tety) {
    if (x != null && x.kind == EK_TERNARY && tety != null && tety[0] != 0 && cg_is_iface(g, cg_dealias(g, tety)) == 1) {
        g.tern_node = x; g.tern_iface = tety;
    }
}

CgVal cg_call_arg(Codegen* g, CgFn* f, int i, *ExprNode ax) {
    cg_hint_iface(g, ax, cg_pety(f, i));
    if (cg_streq(cg_pty(f, i), "ptr") == 1 && cg_is_fnty(cg_dealias(g, cg_pety(f, i))) == 1
        && ax.kind == EK_IDENT && cg_find_local(g, ax.sval).slot[0] == 0
        && cg_find_global(g, ax.sval).slot[0] == 0 && cg_is_fn(g, ax.sval) == 1) {
        let v: CgVal; v.op = cg_cabi_callback(g, ax.sval); v.ty = "ptr"; v.ety = "";
        return v;
    }
    return cg_expr(g, ax);
}

// A prefix `-`, `!` or `~`. A chain of them (`- - - x`) nests as deep as it is long, so
// it is emitted along its operand spine with a loop, each operand's type (for the
// operator-overload lookup) computed once, bottom-up. An overloaded operator ends the
// spine (it is evaluated as an ordinary operand, through its own call).
CgVal cg_unary_chain(Codegen* g, *ExprNode e) {
    List<*ExprNode> spine; List_init<*ExprNode>(&spine, 4);
    *ExprNode u = e;
    while (u != null && u.kind == EK_UNARY
           && (cg_streq(u.sval, "-") == 1 || cg_streq(u.sval, "!") == 1 || cg_streq(u.sval, "~") == 1)) {
        List_push<*ExprNode>(&spine, u);
        u = u.a;
    }
    int n = List_len<*ExprNode>(&spine);
    List<string> opns; List_init<string>(&opns, n);   // each node's overload fn ("" = built-in)
    int i = 0;
    while (i < n) { List_push<string>(&opns, ""); i = i + 1; }
    string at = cg_etype(g, u);
    i = n - 1;
    while (i >= 0) {
        *ExprNode sn = List_get<*ExprNode>(&spine, i);
        string uop = sn.sval; if (cg_streq(uop, "-") == 1) { uop = "u-"; }
        List_set<string>(&opns, i, cg_op_resolve1(g, uop, at));   // unary operator overload
        at = cg_unary_ety(g, sn, at);
        i = i - 1;
    }
    string topn = List_get<string>(&opns, 0);
    if (topn[0] != 0) { return cg_op_call(g, topn, e.a, null); }
    int m = 1;
    while (m < n) {
        string mopn = List_get<string>(&opns, m);
        if (mopn[0] != 0) { break; }
        m = m + 1;
    }
    *ExprNode last = List_get<*ExprNode>(&spine, m - 1);
    CgVal val = cg_expr(g, last.a);
    i = m - 1;
    while (i >= 0) {
        val = cg_unary_apply(g, List_get<*ExprNode>(&spine, i), val);
        i = i - 1;
    }
    List_free<*ExprNode>(&spine);
    List_free<string>(&opns);
    return val;
}

// A built-in prefix `-`, `!` or `~` applied to its already evaluated operand.
CgVal cg_unary_apply(Codegen* g, *ExprNode e, CgVal operand) {
    let v: CgVal;
    v.ety = "";
    if (cg_streq(e.sval, "-") == 1 || cg_streq(e.sval, "~") == 1) {
        int nw = cg_int_w(operand.ty);                   // C: a narrow operand becomes int first
        if (nw > 0 && nw < 32) { operand.op = cg_coerce(g, operand, "i32"); operand.ty = "i32"; operand.ety = "int"; }
    }
    if (cg_streq(e.sval, "-") == 1) {
        CgVal a = operand;
        string t = cg_tmp(g);
        if (cg_is_float(a.ty) == 1) {                  // floating-point negation
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = fneg "); cg_emit(g, a.ty);
            cg_emit(g, " "); cg_emit(g, a.op); cg_emit(g, "\n");
        } else {
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = sub "); cg_emit(g, a.ty);
            cg_emit(g, " 0, "); cg_emit(g, a.op); cg_emit(g, "\n");
        }
        v.op = t; v.ty = a.ty; v.ety = a.ety; return v;   // keeps the (promoted) signedness
    }
    if (cg_streq(e.sval, "!") == 1) {                // logical not: (x == 0) -> i1
        CgVal a = operand;
        string t = cg_tmp(g);
        if (cg_is_float(a.ty) == 1) {                  // !x on a float: x == 0.0
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = fcmp oeq "); cg_emit(g, a.ty);
            cg_emit(g, " "); cg_emit(g, a.op); cg_emit(g, ", 0.0\n");
        } else {
            string zero = "0";
            if (cg_streq(a.ty, "ptr") == 1) { zero = "null"; }   // !p on a pointer: p == null
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = icmp eq "); cg_emit(g, a.ty);
            cg_emit(g, " "); cg_emit(g, a.op); cg_emit(g, ", "); cg_emit(g, zero); cg_emit(g, "\n");
        }
        v.op = t; v.ty = "i1"; v.ety = "bool"; return v;
    }
    if (cg_streq(e.sval, "~") == 1) {                // bitwise not: xor with all-ones
        CgVal a = operand;
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = xor "); cg_emit(g, a.ty);
        cg_emit(g, " "); cg_emit(g, a.op); cg_emit(g, ", -1\n");
        v.op = t; v.ty = a.ty; v.ety = a.ety; return v;
    }
    return operand;
}

// A non-assignment binary expression. A left-leaning chain (`a + b + c ...`) is as deep
// as it is long, so it is emitted along its left spine with a loop (mirrors
// CodeGen::visit(BinaryExpr)): the operand types are derived bottom-up once (as cg_etype
// does), then the leftmost operand is evaluated and each built-in operator is applied to
// the running value. An overloaded operator ends the spine (it is evaluated as an
// ordinary operand, through its own call).
CgVal cg_binary_chain(Codegen* g, *ExprNode e) {
    List<*ExprNode> spine; List_init<*ExprNode>(&spine, 8);
    *ExprNode b = e;
    while (b != null && b.kind == EK_BINARY && cg_streq(b.sval, "=") == 0) {
        List_push<*ExprNode>(&spine, b);
        b = b.a;
    }
    int n = List_len<*ExprNode>(&spine);
    List<string> opns; List_init<string>(&opns, n);   // each node's overload fn ("" = built-in)
    int i = 0;
    while (i < n) { List_push<string>(&opns, ""); i = i + 1; }
    string lt = cg_etype(g, b);
    i = n - 1;
    while (i >= 0) {
        *ExprNode sn = List_get<*ExprNode>(&spine, i);
        string rt = cg_etype(g, sn.b);
        string bopn = cg_op_resolve(g, sn.sval, lt, rt);
        List_set<string>(&opns, i, bopn);
        if (bopn[0] != 0) { lt = cg_find_fn(g, bopn).rety; }
        else { lt = cg_binary_ety(g, sn.sval, lt, rt); }
        i = i - 1;
    }
    string topn = List_get<string>(&opns, 0);
    if (topn[0] != 0) { return cg_op_call(g, topn, e.a, e.b); }   // binary overload
    int m = 1;
    while (m < n) {
        string mopn = List_get<string>(&opns, m);
        if (mopn[0] != 0) { break; }
        m = m + 1;
    }
    *ExprNode last = List_get<*ExprNode>(&spine, m - 1);
    CgVal val = cg_expr(g, last.a);
    i = m - 1;
    while (i >= 0) {
        val = cg_binary_builtin(g, List_get<*ExprNode>(&spine, i), val);
        i = i - 1;
    }
    List_free<*ExprNode>(&spine);
    List_free<string>(&opns);
    return val;
}

// One built-in binary operator `e` applied to its already evaluated left operand `l`
// (the right operand is evaluated here).
CgVal cg_binary_builtin(Codegen* g, *ExprNode e, CgVal left) {
    CgVal l = left;
    let v: CgVal;
    v.ety = "";
    if (cg_streq(e.sval, "&&") == 1 || cg_streq(e.sval, "||") == 1) {
        // Short-circuit via a result slot: store the LHS, branch over the RHS when
        // the result is already decided (&& false / || true), else evaluate the RHS.
        int is_and = cg_streq(e.sval, "&&");
        string res = cg_entry_alloca(g, "i1");
        CgVal a = cg_cond_val(g, l);
        cg_emit(g, "  store i1 "); cg_emit(g, a.op); cg_emit(g, ", ptr "); cg_emit(g, res); cg_emit(g, "\n");
        string lrhs = cg_lbl(g);
        string lend = cg_lbl(g);
        cg_emit(g, "  br i1 "); cg_emit(g, a.op);
        if (is_and == 1) { cg_emit(g, ", label %"); cg_emit(g, lrhs); cg_emit(g, ", label %"); cg_emit(g, lend); }
        else { cg_emit(g, ", label %"); cg_emit(g, lend); cg_emit(g, ", label %"); cg_emit(g, lrhs); }
        cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, lrhs);
        CgVal b = cg_cond(g, e.b);
        cg_emit(g, "  store i1 "); cg_emit(g, b.op); cg_emit(g, ", ptr "); cg_emit(g, res); cg_emit(g, "\n");
        cg_br(g, lend);
        cg_label(g, lend);
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = load i1, ptr "); cg_emit(g, res); cg_emit(g, "\n");
        v.op = t; v.ty = "i1"; v.ety = "bool"; return v;
    }
    CgVal r = cg_expr(g, e.b);
    // C integer promotions: an integer operand narrower than `int` (bool, char, int8/16,
    // uint8/16) becomes a signed `int` (extended by its own signedness) before any
    // arithmetic, bitwise, shift, or comparison. Mirrors CodeGen::isIntPromotingOp.
    if (cg_arith_op(e.sval)[0] != 0 || cg_cmp_pred(e.sval)[0] != 0) {
        int plw = cg_int_w(l.ty);
        if (plw > 0 && plw < 32) { l.op = cg_coerce(g, l, "i32"); l.ty = "i32"; l.ety = "int"; }
        int prw = cg_int_w(r.ty);
        if (prw > 0 && prw < 32) { r.op = cg_coerce(g, r, "i32"); r.ty = "i32"; r.ety = "int"; }
    }
    // Floating-point: if either operand is float/double, promote both to the wider
    // and use fcmp/fadd/… (mixed int/float promotes the int via sitofp in cg_coerce).
    if (cg_is_float(l.ty) == 1 || cg_is_float(r.ty) == 1) {
        string fty = "float";
        if (cg_streq(l.ty, "double") == 1 || cg_streq(r.ty, "double") == 1) { fty = "double"; }
        string lop = cg_coerce(g, l, fty);
        string rop = cg_coerce(g, r, fty);
        string fpred = cg_fcmp_pred(e.sval);
        if (fpred[0] != 0) {
            string t = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = fcmp "); cg_emit(g, fpred);
            cg_emit(g, " "); cg_emit(g, fty); cg_emit(g, " "); cg_emit(g, lop);
            cg_emit(g, ", "); cg_emit(g, rop); cg_emit(g, "\n");
            v.op = t; v.ty = "i1"; v.ety = "bool"; return v;
        }
        string fop = cg_farith_op(e.sval);
        if (fop[0] != 0) {
            string t = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = "); cg_emit(g, fop);
            cg_emit(g, " "); cg_emit(g, fty); cg_emit(g, " "); cg_emit(g, lop);
            cg_emit(g, ", "); cg_emit(g, rop); cg_emit(g, "\n");
            v.op = t; v.ty = fty; v.ety = fty; return v;
        }
    }
    // Integer operand unification (C usual arithmetic conversions): widen the narrower
    // operand to the wider (signedness-aware via cg_coerce), and pick unsigned ops/
    // predicates when either operand is unsigned. Pointer operands skip this (handled
    // specially below); for them lw/rw are 0 so icty/ilop/irop stay the raw values.
    int lw = cg_int_w(l.ty); int rw = cg_int_w(r.ty);
    string icty = l.ty; string ilop = l.op; string irop = r.op; int uns = 0;
    if (lw > 0 && rw > 0) {
        if (rw > lw) { icty = r.ty; } else { icty = l.ty; }
        // A shift computes in the width of the value shifted; the count never widens it.
        if (cg_streq(e.sval, "<<") == 1 || cg_streq(e.sval, ">>") == 1) { icty = l.ty; }
        ilop = cg_coerce(g, l, icty);
        irop = cg_coerce(g, r, icty);
        // C usual arithmetic conversions: an op mixing signed and unsigned is unsigned
        // only when the unsigned operand's width is at least the signed one's; a wider
        // signed type represents every value of a narrower unsigned one (then signed).
        int lu = cg_is_unsigned(l.ety); int ru = cg_is_unsigned(r.ety);
        if (lu == ru) { uns = lu; }
        else if (lu == 1) { if (lw >= rw) { uns = 1; } }
        else { if (rw >= lw) { uns = 1; } }
    }
    string pred = cg_cmp_pred_s(e.sval, uns);
    if (pred[0] != 0) {
        // Pointer comparisons: use `ptr` as the icmp type and turn a literal `0` on
        // either side into `null` (Eskiu writes both `p != null` and `p != 0`).
        string cty = icty; string lop = ilop; string rop = irop;
        if (cg_streq(l.ty, "ptr") == 1 || cg_streq(r.ty, "ptr") == 1) {
            cty = "ptr"; lop = l.op; rop = r.op;
            if (cg_streq(lop, "0") == 1) { lop = "null"; }
            if (cg_streq(rop, "0") == 1) { rop = "null"; }
        }
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = icmp "); cg_emit(g, pred);
        cg_emit(g, " "); cg_emit(g, cty); cg_emit(g, " "); cg_emit(g, lop);
        cg_emit(g, ", "); cg_emit(g, rop); cg_emit(g, "\n");
        v.op = t; v.ty = "i1"; v.ety = "bool"; return v;
    }
    // Pointer difference: `p - q` (both pointers) → (ptrtoint p - ptrtoint q) / sizeof(elem),
    // a signed count of elements (an integer, not a `ptr`). Must precede the ptr±int case.
    if (cg_streq(e.sval, "-") == 1
        && cg_streq(l.ty, "ptr") == 1 && cg_streq(r.ty, "ptr") == 1) {
        string li = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, li); cg_emit(g, " = ptrtoint ptr "); cg_emit(g, l.op); cg_emit(g, " to i64\n");
        string ri = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, ri); cg_emit(g, " = ptrtoint ptr "); cg_emit(g, r.op); cg_emit(g, " to i64\n");
        string d = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, d); cg_emit(g, " = sub i64 "); cg_emit(g, li); cg_emit(g, ", "); cg_emit(g, ri); cg_emit(g, "\n");
        string elem = cg_deref_ty(l.ety);
        string ell = cg_lltype(g, elem);
        if (cg_streq(ell, "i8") == 1 || cg_streq(ell, "void") == 1) {   // element size 1: byte diff is the count
            v.op = d; v.ty = "i64"; v.ety = "int64"; return v;
        }
        string szg = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, szg); cg_emit(g, " = getelementptr "); cg_emit(g, ell); cg_emit(g, ", ptr null, i32 1\n");
        string szi = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, szi); cg_emit(g, " = ptrtoint ptr "); cg_emit(g, szg); cg_emit(g, " to i64\n");
        string res = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, res); cg_emit(g, " = sdiv i64 "); cg_emit(g, d); cg_emit(g, ", "); cg_emit(g, szi); cg_emit(g, "\n");
        v.op = res; v.ty = "i64"; v.ety = "int64"; return v;
    }
    // Pointer arithmetic: `p + n` / `n + p` / `p - n` lower to getelementptr over the
    // pointee, not an integer add on a `ptr` (which is invalid IR).
    if ((cg_streq(e.sval, "+") == 1 || cg_streq(e.sval, "-") == 1)
        && (cg_streq(l.ty, "ptr") == 1 || cg_streq(r.ty, "ptr") == 1)) {
        CgVal base = l; CgVal off = r;
        if (cg_streq(l.ty, "ptr") == 0) { base = r; off = l; }
        string offop = off.op;
        if (cg_streq(e.sval, "-") == 1) {              // p - n: index by -n
            string nt = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, nt); cg_emit(g, " = sub "); cg_emit(g, off.ty);
            cg_emit(g, " 0, "); cg_emit(g, off.op); cg_emit(g, "\n");
            offop = nt;
        }
        string elem = cg_deref_ty(base.ety);
        string ell = cg_lltype(g, elem);
        if (cg_streq(ell, "void") == 1) { ell = "i8"; }   // `*void` steps by bytes (as the C++ build does)
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = getelementptr inbounds ");
        cg_emit(g, ell); cg_emit(g, ", ptr "); cg_emit(g, base.op);
        cg_emit(g, ", "); cg_emit(g, off.ty); cg_emit(g, " "); cg_emit(g, offop); cg_emit(g, "\n");
        v.op = t; v.ty = "ptr"; v.ety = base.ety; return v;
    }
    // A right shift's kind (arithmetic vs logical) follows the value being shifted
    // (the left operand) only, independent of the count's signedness.
    int op_uns = uns;
    if (cg_streq(e.sval, ">>") == 1) { op_uns = cg_is_unsigned(l.ety); }
    string op = cg_arith_op_s(e.sval, op_uns);
    if (op[0] != 0) {
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = "); cg_emit(g, op);
        cg_emit(g, " "); cg_emit(g, icty); cg_emit(g, " "); cg_emit(g, ilop);
        cg_emit(g, ", "); cg_emit(g, irop); cg_emit(g, "\n");
        v.op = t; v.ty = icty; v.ety = cg_binary_ety(g, e.sval, l.ety, r.ety); if (v.ety[0] == 0) { v.ety = l.ety; } return v;
    }
    return l;                                       // unhandled binary (S1) → left
}

CgVal cg_expr(Codegen* g, *ExprNode e) {
    let v: CgVal;
    v.ety = "";
    if (e == null) { v.op = "0"; v.ty = "i32"; return v; }

    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_STRING) { v.op = cg_string_global_n(g, e.sval, e.slen); v.ty = "ptr"; return v; }
        // Literals carry their Eskiu type too, so an operation mixing one with an unsigned
        // operand gets C's conversions (`1 - u` is unsigned; a char literal is unsigned).
        if (e.lit_kind == LIT_CHAR) { v.op = cg_itoa((int)(uint8)e.sval[0]); v.ty = "i8"; v.ety = "char"; return v; }
        v.op = e.sval;
        if (e.lit_kind == LIT_BOOL) { v.ty = "i1"; v.ety = "bool"; }
        else if (e.lit_kind == LIT_NULL) { v.op = "null"; v.ty = "ptr"; }
        else if (e.lit_kind == LIT_FLOAT) { v.op = cg_double_lit(e.sval); v.ty = "double"; v.ety = "double"; }   // float literal defaults to double
        else {                            // integer literal: normalize base, i64 if it won't fit signed i32
            int neg = 0; if (e.sval[0] == 45) { neg = 1; }
            let mag: uint64 = cg_int_lit_mag(e.sval);
            string dec = cg_u64toa(mag);
            if (neg == 1) { v.op = cg_cat("-", dec); } else { v.op = dec; }
            v.ty = "i32"; v.ety = "int";
            let lim: uint64 = 2147483647;                 // INT32_MAX; INT32_MIN is one larger in magnitude
            if (neg == 1) { lim = 2147483648; }
            if (mag > lim) { v.ty = "i64"; v.ety = "int64"; }
            if (neg == 0 && mag > (uint64)9223372036854775807) { v.ety = "uint64"; }
        }
        return v;
    }

    if (e.kind == EK_IDENT) {
        CgLocal l = cg_find_local(g, e.sval);
        if (l.slot[0] != 0) {
            string t = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = load "); cg_emit(g, l.ty);
            cg_emit(g, ", ptr "); cg_emit(g, l.slot); cg_emit(g, "\n");
            v.op = t; v.ty = l.ty; v.ety = l.ety; return v;
        }
        string ev = cg_enum_val(g, e.sval);            // a plain-enum constant?
        if (ev[0] != 0) { v.op = ev; v.ty = "i32"; v.ety = "int"; return v; }
        CgLocal gv = cg_find_global(g, e.sval);        // a global variable?
        if (gv.slot[0] != 0) {
            string t = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = load "); cg_emit(g, gv.ty);
            cg_emit(g, ", ptr "); cg_emit(g, gv.slot); cg_emit(g, "\n");
            v.op = t; v.ty = gv.ty; v.ety = gv.ety; return v;
        }
        CgVariant var = cg_find_variant(g, e.sval);    // a payload-less ADT variant (e.g. None)?
        if (var.ename[0] != 0) { return cg_build_variant(g, var, null); }
        if (cg_is_fn(g, e.sval) == 1) {                // a top-level function used as a value
            v.op = cg_cat("@", e.sval); v.ty = "ptr"; v.ety = ""; return v;   // raw fn ptr; → closure via cg_coerce
        }
        v.op = e.sval; v.ty = "i32"; return v;         // fallback
    }

    if (e.kind == EK_INCDEC) {                          // ++x / x++ / --x / x--
        int L0 = cg_strlen(e.sval);
        if (e.a != null && e.a.kind == EK_MEMBER) {     // a bitfield: masked read-modify-write
            string bet = cg_etype(g, e.a.a);
            string bsn = bet; if (cg_is_ptr_ty(bet) == 1) { bsn = cg_strip_ptr(bet); }
            CgBF bslot = cg_bf(g, bsn, e.a.sval);
            if (bslot.bw > 0) {
                string bsn2 = "";
                string bbase = cg_member_baseptr(g, e.a.a, &bsn2);
                string wa = cg_bf_wordptr(g, bbase, bsn2, bslot);
                CgVal bold = cg_bf_load(g, wa, bslot);
                string bnw = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, bnw); cg_emit(g, " = ");
                if ((int)e.sval[L0 - 1] == 45) { cg_emit(g, "sub "); } else { cg_emit(g, "add "); }
                cg_emit(g, bslot.sty); cg_emit(g, " "); cg_emit(g, bold.op); cg_emit(g, ", 1\n");
                cg_bf_store(g, wa, bslot, bnw);
                if ((int)e.sval[1] == 114) { return cg_bf_promote(g, cg_bf_load(g, wa, bslot), bslot); }   // prefix: the stored (wrapped) value
                return bold;                              // postfix: the declared type, unpromoted (as clang)
            }
        }
        CgVal lv = cg_lval(g, e.a);
        string ety = lv.ety;
        string llty = cg_lltype(g, ety);
        string old = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, old); cg_emit(g, " = load "); cg_emit(g, llty);
        cg_emit(g, ", ptr "); cg_emit(g, lv.op); cg_emit(g, "\n");
        int L = cg_strlen(e.sval);
        int dec = 0; if ((int)e.sval[L - 1] == 45) { dec = 1; }   // last char '-'
        int pre = 0; if ((int)e.sval[1] == 114) { pre = 1; }      // "pre..." (index 1 is 'r')
        string nw = cg_tmp(g);
        if (cg_is_ptr_ty(ety) == 1 || cg_streq(llty, "ptr") == 1) {   // pointer / string: step one element
            string ellt = "i8";                         // a string (char pointer) or *void steps a byte
            if (cg_is_ptr_ty(ety) == 1) { ellt = cg_lltype(g, cg_strip_ptr(ety)); }
            if (cg_streq(ellt, "void") == 1) { ellt = "i8"; }
            cg_emit(g, "  "); cg_emit(g, nw); cg_emit(g, " = getelementptr ");
            cg_emit(g, ellt); cg_emit(g, ", ptr "); cg_emit(g, old);
            cg_emit(g, ", i64 "); if (dec == 1) { cg_emit(g, "-1"); } else { cg_emit(g, "1"); }
            cg_emit(g, "\n");
        } else {
            cg_emit(g, "  "); cg_emit(g, nw); cg_emit(g, " = ");
            if (dec == 1) { cg_emit(g, "sub "); } else { cg_emit(g, "add "); }
            cg_emit(g, llty); cg_emit(g, " "); cg_emit(g, old); cg_emit(g, ", 1\n");
        }
        cg_emit(g, "  store "); cg_emit(g, llty); cg_emit(g, " "); cg_emit(g, nw);
        cg_emit(g, ", ptr "); cg_emit(g, lv.op); cg_emit(g, "\n");
        if (pre == 1) { v.op = nw; } else { v.op = old; }
        v.ty = llty; v.ety = ety; return v;
    }

    if (e.kind == EK_MEMBER) {                          // a bitfield member read masks/shifts
        string bet = cg_etype(g, e.a);
        string sn = bet; if (cg_is_ptr_ty(bet) == 1) { sn = cg_strip_ptr(bet); }
        CgBF slot = cg_bf(g, sn, e.sval);
        if (slot.bw > 0) {
            string sn2 = "";
            string baseptr = cg_member_baseptr(g, e.a, &sn2);
            return cg_bf_read(g, baseptr, sn2, slot);
        }
    }
    // Slice construction: base[lo..hi] → a fat pointer { &base[lo], hi - lo }.
    if (e.kind == EK_INDEX && List_len<*ExprNode>(&e.kids) > 0) {
        string lo = cg_coerce(g, cg_expr(g, e.b), "i64");
        string hi = cg_coerce(g, cg_expr(g, List_get<*ExprNode>(&e.kids, 0)), "i64");
        string data = cg_slice_elem_addr(g, e.a, lo, hi, "i64");
        string len = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, len); cg_emit(g, " = sub i64 "); cg_emit(g, hi);
        cg_emit(g, ", "); cg_emit(g, lo); cg_emit(g, "\n");
        string s0 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, s0); cg_emit(g, " = insertvalue { ptr, i64 } undef, ptr ");
        cg_emit(g, data); cg_emit(g, ", 0\n");
        string s1 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, s1); cg_emit(g, " = insertvalue { ptr, i64 } ");
        cg_emit(g, s0); cg_emit(g, ", i64 "); cg_emit(g, len); cg_emit(g, ", 1\n");
        v.op = s1; v.ty = "{ ptr, i64 }"; v.ety = cg_etype(g, e); return v;
    }
    // Slice `.len` → the fat pointer's length field (i64).
    if (e.kind == EK_MEMBER && cg_streq(e.sval, "len") == 1 && cg_is_slice(cg_etype(g, e.a)) == 1) {
        CgVal fat = cg_expr(g, e.a);
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = extractvalue { ptr, i64 } ");
        cg_emit(g, fat.op); cg_emit(g, ", 1\n");
        v.op = t; v.ty = "i64"; v.ety = "int64"; return v;
    }
    if (e.kind == EK_INDEX && List_len<*ExprNode>(&e.kids) == 0) {   // overloaded subscript `base[i]`
        string iopn = cg_op_resolve(g, "[]", cg_etype(g, e.a), cg_etype(g, e.b));
        if (iopn[0] != 0) { return cg_op_call(g, iopn, e.a, e.b); }
    }
    if (e.kind == EK_MEMBER || e.kind == EK_INDEX) {    // field/element read: GEP + load
        CgVal lv = cg_lval(g, e);
        string llty = cg_lltype(g, lv.ety);
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = load "); cg_emit(g, llty);
        cg_emit(g, ", ptr "); cg_emit(g, lv.op); cg_emit(g, "\n");
        v.op = t; v.ty = llty; v.ety = lv.ety; return v;
    }

    if (e.kind == EK_UNARY) {
        if (cg_streq(e.sval, "&") == 1) {               // address-of
            CgVal lv = cg_lval(g, e.a);
            v.op = lv.op; v.ty = "ptr"; v.ety = cg_cat("*", lv.ety); return v;
        }
        if (cg_streq(e.sval, "*") == 1) {               // deref (rvalue)
            CgVal p = cg_expr(g, e.a);
            string ety = cg_deref_ty(cg_etype(g, e.a));
            string llty = cg_lltype(g, ety);
            string t = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = load "); cg_emit(g, llty);
            cg_emit(g, ", ptr "); cg_emit(g, p.op); cg_emit(g, "\n");
            v.op = t; v.ty = llty; v.ety = ety; return v;
        }
        if (cg_streq(e.sval, "-") == 1 || cg_streq(e.sval, "!") == 1 || cg_streq(e.sval, "~") == 1) {
            return cg_unary_chain(g, e);
        }
        return cg_expr(g, e.a);
    }

    if (e.kind == EK_BINARY) {
        if (cg_streq(e.sval, "=") == 1) {              // assignment
            int is_bf = 0;
            if (e.a != null && e.a.kind == EK_MEMBER) {
                string bet0 = cg_etype(g, e.a.a);
                string sn0 = bet0; if (cg_is_ptr_ty(bet0) == 1) { sn0 = cg_strip_ptr(bet0); }
                if (cg_bf(g, sn0, e.a.sval).bw > 0) { is_bf = 1; }
            }
            // `lv op= v` (parsed as `lv = lv op v` sharing the lvalue node) where evaluating
            // `lv` has side effects (`a[f()] += 1`, `a[i++] += 1`): compute its address ONCE
            // into a temporary pointer, then run the ordinary `*p = *p op v` (mirrors
            // CodeGen::emitCompoundAssign), so overloads/coercions/--safe checks still apply.
            if (e.b != null && e.b.kind == EK_BINARY && e.b.a == e.a && cg_is_pure(e.a) == 0) {
                string ctmp = cg_cat("__cmpd", cg_itoa(g.lam_seq)); g.lam_seq = g.lam_seq + 1;
                string cslot = cg_entry_alloca(g, "ptr");
                int clmark = List_len<CgLocal>(&g.locals);
                *ExprNode cder = alloc<ExprNode>(1); cder.kind = EK_UNARY; cder.sval = "*"; cder.a = cgb_ident(ctmp);
                *ExprNode ctarget = cder;
                if (is_bf == 1) {
                    // A bitfield has no address of its own: evaluate the struct's address
                    // once instead, and read-modify-write `(*p).field`.
                    string bbt = cg_etype(g, e.a.a);
                    string bop = "";
                    string bety = bbt;
                    if (cg_is_ptr_ty(bbt) == 1) { bop = cg_expr(g, e.a.a).op; }
                    else { bop = cg_addr(g, e.a.a).op; bety = cg_cat("*", bbt); }
                    cg_emit(g, "  store ptr "); cg_emit(g, bop); cg_emit(g, ", ptr "); cg_emit(g, cslot); cg_emit(g, "\n");
                    cg_add_local(g, ctmp, cslot, "ptr", bety);
                    ctarget = cgb_member(cder, e.a.sval);
                } else {
                    CgVal clv = cg_lval(g, e.a);
                    string clety = clv.ety; if (clety[0] == 0) { clety = cg_etype(g, e.a); }
                    cg_emit(g, "  store ptr "); cg_emit(g, clv.op); cg_emit(g, ", ptr "); cg_emit(g, cslot); cg_emit(g, "\n");
                    cg_add_local(g, ctmp, cslot, "ptr", cg_cat("*", clety));
                }
                CgVal crv = cg_expr(g, cgb_bin("=", ctarget, cgb_bin(e.b.sval, ctarget, e.b.b)));
                cg_locals_trunc(g, clmark);
                return crv;
            }
            // Assignment to a bitfield member → read-modify-write the storage word.
            if (e.a != null && e.a.kind == EK_MEMBER) {
                string bet = cg_etype(g, e.a.a);
                string sn = bet; if (cg_is_ptr_ty(bet) == 1) { sn = cg_strip_ptr(bet); }
                CgBF slot = cg_bf(g, sn, e.a.sval);
                if (slot.bw > 0) {
                    string sn2 = "";
                    string baseptr = cg_member_baseptr(g, e.a.a, &sn2);   // target first
                    CgVal rv = cg_expr(g, e.b);
                    string rop = cg_coerce(g, rv, slot.sty);
                    cg_bf_write(g, baseptr, sn2, slot, rop);
                    return rv;
                }
            }
            // Evaluation order (mirrors CodeGen::emitAssignment): the target's address
            // first, then the right-hand side, then the store.
            if (e.a != null && e.a.kind == EK_IDENT && cg_find_local(g, e.a.sval).slot[0] != 0) {
                cg_hint_iface(g, e.b, cg_find_local(g, e.a.sval).ety);
                CgVal rhs = cg_expr(g, e.b);
                CgLocal l = cg_find_local(g, e.a.sval);
                string rop = cg_coerce(g, rhs, l.ty);   // coerce RHS to the variable's type
                if (cg_is_iface(g, l.ety) == 1) { rop = cg_iface_conv(g, l.ety, rhs, e.b); }
                cg_emit(g, "  store "); cg_emit(g, l.ty); cg_emit(g, " "); cg_emit(g, rop);
                cg_emit(g, ", ptr "); cg_emit(g, l.slot); cg_emit(g, "\n");
                // The assignment's value is the stored (converted) one: `l = s = 200` with
                // an int8 `s` gives `l` -56, not 200.
                v.op = rop; v.ty = l.ty; v.ety = l.ety; return v;
            }
            CgVal lv = cg_lval(g, e.a);                 // member / deref / index lvalue
            cg_hint_iface(g, e.b, lv.ety);
            CgVal rhs = cg_expr(g, e.b);
            string lty = cg_lltype(g, lv.ety);
            string rop = cg_coerce(g, rhs, lty);        // coerce RHS to the field/element type
            if (cg_is_iface(g, cg_dealias(g, lv.ety)) == 1) { rop = cg_iface_conv(g, lv.ety, rhs, e.b); }
            cg_emit(g, "  store "); cg_emit(g, lty); cg_emit(g, " "); cg_emit(g, rop);
            cg_emit(g, ", ptr "); cg_emit(g, lv.op); cg_emit(g, "\n");
            v.op = rop; v.ty = lty; v.ety = lv.ety; return v;
        }
        return cg_binary_chain(g, e);
    }

    if (e.kind == EK_CALL) {
        // Atomic intrinsics → LLVM atomic instructions (cell is *int, values i32).
        if (e.a != null && e.a.kind == EK_IDENT && cg_is_atomic(e.a.sval) == 1) {
            return cg_emit_atomic(g, e.a.sval, e);
        }
        // Variadic access: va_start(ap)/va_end(ap) → the llvm.va_{start,end} intrinsic on the
        // va_list's address (its alloca). `ap` is a local va_list.
        if (e.a != null && e.a.kind == EK_IDENT
            && (cg_streq(e.a.sval, "va_start") == 1 || cg_streq(e.a.sval, "va_end") == 1)) {
            string ap = cg_lval(g, List_get<*ExprNode>(&e.kids, 0)).op;
            string intr = "llvm.va_start.p0"; if (cg_streq(e.a.sval, "va_end") == 1) { intr = "llvm.va_end.p0"; }
            cg_ensure_extern(g, intr, cg_cat(cg_cat("declare void @", intr), "(ptr)\n"));
            cg_emit(g, "  call void @"); cg_emit(g, intr); cg_emit(g, "(ptr "); cg_emit(g, ap); cg_emit(g, ")\n");
            v.op = ""; v.ty = "void"; return v;
        }
        // An ADT variant constructor `Circle(4)` parses as a call with a bare-ident callee.
        if (e.a != null && e.a.kind == EK_IDENT) {
            CgVariant var = cg_find_variant(g, e.a.sval);
            if (var.ename[0] != 0) { return cg_build_variant(g, var, e); }
        }
        // Indirect call through a closure value: the callee is a local/param of fn type
        // (a `%closure` fat pointer). Extract { fn, env } and call fn(env, args...).
        if (e.a != null && e.a.kind == EK_IDENT) {
            CgLocal lf = cg_find_local(g, e.a.sval);
            if (lf.slot[0] != 0 && cg_is_fnty(lf.ety) == 1) {
                string cval = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, cval); cg_emit(g, " = load %closure, ptr "); cg_emit(g, lf.slot); cg_emit(g, "\n");
                return cg_indirect_call(g, cval, lf.ety, e);
            }
        }
        // Same, but the callee is a GLOBAL variable of fn type (`let f: fn(int)->int = ...`
        // at module scope, then `f(x)`): load the %closure from the global's address.
        if (e.a != null && e.a.kind == EK_IDENT) {
            CgLocal gf = cg_find_global(g, e.a.sval);
            if (gf.slot[0] != 0 && cg_is_fnty(gf.ety) == 1) {
                string cval = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, cval); cg_emit(g, " = load %closure, ptr "); cg_emit(g, gf.slot); cg_emit(g, "\n");
                return cg_indirect_call(g, cval, gf.ety, e);
            }
        }
        // A call through a closure-typed FIELD (e.g. `fr.ret.waker()`): not a method.
        if (e.a != null && e.a.kind == EK_MEMBER && cg_is_fnty(cg_etype(g, e.a)) == 1) {
            CgVal cv = cg_expr(g, e.a);                 // load the %closure field value
            return cg_indirect_call(g, cv.op, cg_etype(g, e.a), e);
        }
        // Any other callee expression yielding a closure (a call returning a fn value,
        // `pick(0)(3, 4)`, or an indexed/derefed closure): evaluate it, then call through it.
        if (e.a != null && e.a.kind != EK_IDENT && e.a.kind != EK_MEMBER) {
            string cft = cg_etype(g, e.a);
            if (cg_is_fnty(cft) == 1) {
                CgVal cv = cg_expr(g, e.a);
                return cg_indirect_call(g, cg_coerce(g, cv, "%closure"), cft, e);
            }
        }
        // A generic free function called WITHOUT explicit type args (`chan_recv(ch)`):
        // infer `chan_recv<int>` from the argument types, then instantiate + call.
        if (e.a != null && e.a.kind == EK_IDENT) {
            *DeclNode gd = cg_find_gfn(g, e.a.sval);
            if (gd != null) {
                string spelling = cg_infer_generic(g, gd, e);
                if (spelling[0] != 0) { return cg_call_mangled(g, cg_ensure_fn_inst(g, spelling), e); }
                dprintf(2, "error: cannot infer the type arguments of generic function '%s' from the call; write them explicitly, e.g. %s<...>(...)\n", gd.name, gd.name);
                exit(1);
            }
        }
        // A method call whose receiver is an interface value → dynamic vtable dispatch.
        // The receiver's *value* is the fat pointer {data, vtable}.
        if (e.a != null && e.a.kind == EK_MEMBER && cg_is_iface(g, cg_etype(g, e.a.a)) == 1) {
            string ifn = cg_etype(g, e.a.a);
            string fatop = cg_expr(g, e.a.a).op;
            return cg_dispatch_iface(g, ifn, fatop, e.a.sval, e);
        }
        // Through a pointer to an interface value (`*I pi; pi.f()`): load the fat value.
        if (e.a != null && e.a.kind == EK_MEMBER) {
            string rty = cg_etype(g, e.a.a);
            if (cg_is_ptr_ty(rty) == 1 && cg_is_iface(g, cg_dealias(g, cg_deref_ty(rty))) == 1) {
                string ifn2 = cg_dealias(g, cg_deref_ty(rty));
                string pop = cg_expr(g, e.a.a).op;
                string fv = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, fv); cg_emit(g, " = load %iface_fat, ptr "); cg_emit(g, pop); cg_emit(g, "\n");
                return cg_dispatch_iface(g, ifn2, fv, e.a.sval, e);
            }
        }
        // `l.push(x)` on a generic struct instance whose `List_push<T>` is a generic free
        // function: emit it as that (type-inferred) call.
        *ExprNode gmc = cg_generic_method_call(g, e);
        if (gmc != null) { return cg_expr(g, gmc); }
        // Resolve the callee. A bare ident is a free function; a MemberExpr is a method
        // call `recv.m(...)` → `Struct_m(self, ...)` with `self` a pointer to the receiver.
        string fname = "";
        string args = "";
        int pbase = 0;                                  // 1 when an implicit self precedes args
        if (e.a != null && e.a.kind == EK_MEMBER) {
            string recv_ety = cg_etype(g, e.a.a);
            string sname = recv_ety;
            if (cg_is_ptr_ty(recv_ety) == 1) { sname = cg_strip_ptr(recv_ety); }
            // A primitive receiver satisfying a constraint via a free function: `a.cmp(b)`
            // where `a: int` lowers to `cmp(a, b)` (receiver passed BY VALUE as arg 0). The
            // struct-method path would index a non-existent struct's fields and crash.
            if (cg_is_struct(g, sname) == 0 && cg_is_adt(g, sname) == 0 && cg_is_fn(g, e.a.sval) == 1) {
                fname = e.a.sval;
                CgVal selfv = cg_expr(g, e.a.a);
                args = cg_cat(cg_cat(selfv.ty, " "), selfv.op);   // receiver by value
                pbase = 1;
            } else {
                string sptr = "";
                if (cg_is_ptr_ty(recv_ety) == 1) { sptr = cg_expr(g, e.a.a).op; }
                else { sptr = cg_addr(g, e.a.a).op; }
                fname = cg_method_fn(g, sname, e.a.sval);
                args = cg_cat("ptr ", sptr);                // self is the first argument
                pbase = 1;
            }
        } else if (e.a != null && e.a.kind == EK_IDENT) {
            fname = e.a.sval;
        }
        CgFn f = cg_find_fn(g, fname);
        if (pbase == 0 && List_len<CgCabi>(&g.cabis) > 0) {
            CgCabi cab = cg_find_cabi(g, fname);
            if (cab.name[0] != 0) {                     // a C-ABI-lowered extern
                List<CgVal> cargs; List_init<CgVal>(&cargs, 4);
                int ci = 0;
                while (ci < List_len<*ExprNode>(&e.kids)) {
                    CgVal a = cg_call_arg(g, &f, ci, List_get<*ExprNode>(&e.kids, ci));
                    string cpty = cg_pty(&f, ci);
                    let ca: CgVal; ca.op = a.op; ca.ty = a.ty; ca.ety = a.ety;
                    if (cpty[0] != 0) { ca.op = cg_coerce(g, a, cpty); ca.ty = cpty; }
                    else if (cg_streq(a.ty, "float") == 1) { ca.op = cg_coerce(g, a, "double"); ca.ty = "double"; }
                    else if (cg_int_w(a.ty) > 0 && cg_int_w(a.ty) < 32) { ca.op = cg_coerce(g, a, "i32"); ca.ty = "i32"; }
                    List_push<CgVal>(&cargs, ca);
                    ci = ci + 1;
                }
                return cg_cabi_call(g, &cab, &f, &cargs);
            }
        }
        // Evaluate the declared args (left to right), coercing each to the callee's
        // declared parameter type (so e.g. an i32 count widens to an `int64` parameter).
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            *ExprNode ax = List_get<*ExprNode>(&e.kids, i);
            CgVal a = cg_call_arg(g, &f, i + pbase, ax);
            string pety = cg_pety(&f, i + pbase);
            // Param expects an interface but we have a struct pointer → box it as a fat pointer.
            if (pety[0] != 0 && cg_is_iface(g, cg_dealias(g, pety)) == 1) {
                string boxed = cg_iface_conv(g, pety, a, ax);
                if (args[0] != 0) { args = cg_cat(args, ", "); }
                args = cg_cat(args, cg_cat("%iface_fat ", boxed));
                i = i + 1;
            } else {
                string pty = cg_pty(&f, i + pbase);
                string aop = a.op; string aty = a.ty;
                if (pty[0] != 0) { aop = cg_coerce(g, a, pty); aty = pty; }
                else if (cg_streq(a.ty, "float") == 1) {     // C vararg promotion: float → double
                    aop = cg_coerce(g, a, "double"); aty = "double";
                }
                else if (cg_int_w(a.ty) > 0 && cg_int_w(a.ty) < 32) {   // C default arg promotion: small int → i32 (signedness-aware)
                    aop = cg_coerce(g, a, "i32"); aty = "i32";
                }
                if (args[0] != 0) { args = cg_cat(args, ", "); }
                args = cg_cat(args, cg_cat(aty, cg_cat(" ", aop)));
                i = i + 1;
            }
        }
        // A variadic callee needs the explicit function type: `call i32 (ptr, ...) @printf`.
        string callty = f.retty;
        if (f.variadic == 1) { callty = cg_cat(f.retty, cg_cat(" (", cg_cat(cg_va(f.fixedtypes), ")"))); }
        int isvoid = cg_streq(f.retty, "void");
        string t = cg_emit_callish(g, callty, cg_cat("@", fname), args, isvoid);
        if (isvoid == 1) { v.op = ""; v.ty = "void"; return v; }
        v.op = t; v.ty = f.retty; v.ety = f.rety; return v;
    }

    if (e.kind == EK_TEMPLATECALL) {
        // Variadic access: va_arg<T>(ap) → the LLVM `va_arg` instruction reading the next
        // argument of type T from the va_list's address.
        if (cg_streq(cg_gen_base(e.sval), "va_arg") == 1) {
            List<string> ta; List_init<string>(&ta, 1); cg_gen_args(e.sval, &ta);
            string ety = cg_apply_sub(g, List_get<string>(&ta, 0));
            string llty = cg_lltype(g, ety);
            string ap = cg_lval(g, List_get<*ExprNode>(&e.kids, 0)).op;
            string r = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, r); cg_emit(g, " = va_arg ptr "); cg_emit(g, ap);
            cg_emit(g, ", "); cg_emit(g, llty); cg_emit(g, "\n");
            v.op = r; v.ty = llty; v.ety = ety; return v;
        }
        // A generic ADT variant constructor: `Some<int>(42)` / `None<int>()`. Resolve the
        // concrete enum from the variant's generic enum + the explicit type args, ensure the
        // instance, then build the value through its concrete (substituted) variant.
        string vb = cg_gen_base(e.sval);
        CgVariant gvar = cg_find_gvariant(g, vb);
        if (gvar.ename[0] != 0) {
            List<string> targs; List_init<string>(&targs, 4); cg_gen_args(e.sval, &targs);
            String sp; String_init(&sp, 16);
            String_append(&sp, gvar.ename); String_append(&sp, "<");
            int ti = 0;
            while (ti < List_len<string>(&targs)) {
                if (ti > 0) { String_append(&sp, ", "); }
                String_append(&sp, List_get<string>(&targs, ti)); ti = ti + 1;
            }
            String_append(&sp, ">");
            string menum = cg_ensure_enum_inst(g, (string)String_cstr(&sp));
            CgVariant cv = cg_find_variant_in(g, vb, menum);
            return cg_build_variant(g, cv, e);
        }
        string mangled = cg_ensure_fn_inst(g, e.sval);     // "id<int>" -> "id_int" (queued)
        return cg_call_mangled(g, mangled, e);
    }

    if (e.kind == EK_SIZEOF) {
        // sizeof(T) without hardcoded sizes: ptrtoint of `gep T, null, 1`.
        string llty = cg_lltype(g, cg_sizeof_ty(g, e.sval));   // applies the active sub
        string g1 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, g1); cg_emit(g, " = getelementptr ");
        cg_emit(g, llty); cg_emit(g, ", ptr null, i32 1\n");
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = ptrtoint ptr "); cg_emit(g, g1);
        cg_emit(g, " to i64\n");
        v.op = t; v.ty = "i64"; v.ety = "int64"; return v;
    }

    if (e.kind == EK_CAST) {
        string dstety = cg_apply_sub(g, e.sval);
        if (cg_streq(dstety, "void") == 1) {   // `(void)e`: evaluate for side effects, discard
            cg_expr(g, e.a);
            v.op = ""; v.ty = "void"; return v;
        }
        string dll = cg_lltype(g, dstety);
        // A top-level function cast to a pointer is the raw address C calls: through its
        // C-ABI thunk when it takes or returns a struct by value.
        if (cg_streq(dll, "ptr") == 1 && e.a != null && e.a.kind == EK_IDENT
            && cg_find_local(g, e.a.sval).slot[0] == 0 && cg_find_global(g, e.a.sval).slot[0] == 0
            && cg_is_fn(g, e.a.sval) == 1) {
            v.op = cg_cabi_callback(g, e.a.sval); v.ty = "ptr"; v.ety = dstety; return v;
        }
        CgVal src = cg_expr(g, e.a);
        // float → unsigned int needs fptoui; cg_coerce emits signed fptosi, which saturates
        // a value above the signed max (e.g. (uint32)3e9 → 2147483647 instead of 3e9).
        if (cg_is_float(src.ty) == 1 && cg_int_w(dll) > 1 && cg_is_unsigned(dstety) == 1) {
            string t = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = fptoui "); cg_emit(g, src.ty);
            cg_emit(g, " "); cg_emit(g, src.op); cg_emit(g, " to "); cg_emit(g, dll); cg_emit(g, "\n");
            v.op = t; v.ty = dll; v.ety = dstety; return v;
        }
        v.op = cg_coerce(g, src, dll);    // int/float/ptr conversions (sitofp/fptosi/…)
        v.ty = dll; v.ety = dstety; return v;
    }

    if (e.kind == EK_TERNARY) {
        // `cond ? then : else` — branch and evaluate exactly one arm into a result slot,
        // each arm coerced to the common type (mirrors the short-circuit && lowering).
        // A chain of ternaries in else position is emitted with a loop: each link's else
        // arm is the next link, whose value is stored into the link's slot on the way out.
        List<*ExprNode> chain; List_init<*ExprNode>(&chain, 4);
        List<string> etys; List_init<string>(&etys, 4);
        cg_ternary_etys(g, e, &chain, &etys);
        int k = List_len<*ExprNode>(&chain);
        string forced = "";                             // bound for an interface: box every arm
        if (g.tern_node == e) {
            forced = g.tern_iface; g.tern_node = null;
            int fi = 0; while (fi < k) { List_set<string>(&etys, fi, forced); fi = fi + 1; }
        }
        List<string> rtys; List_init<string>(&rtys, k);
        List<string> ress; List_init<string>(&ress, k);
        List<string> lends; List_init<string>(&lends, k);
        int i = 0;
        while (i < k) {
            *ExprNode n = List_get<*ExprNode>(&chain, i);
            string rty = cg_lltype(g, List_get<string>(&etys, i));
            string res = "";                               // void arms (a statement): no slot
            if (cg_streq(rty, "void") == 0) { res = cg_entry_alloca(g, rty); }
            CgVal c = cg_cond(g, n.a);
            string lthen = cg_lbl(g);
            string lelse = cg_lbl(g);
            string lend = cg_lbl(g);
            cg_emit(g, "  br i1 "); cg_emit(g, c.op); cg_emit(g, ", label %"); cg_emit(g, lthen);
            cg_emit(g, ", label %"); cg_emit(g, lelse); cg_emit(g, "\n");
            g.terminated = 1;
            cg_label(g, lthen);
            if (forced[0] != 0) { cg_hint_iface(g, n.b, forced); }
            CgVal tv = cg_expr(g, n.b);
            if (res[0] != 0) {
                string top = cg_coerce(g, tv, rty);
                if (cg_is_iface(g, cg_dealias(g, List_get<string>(&etys, i))) == 1) { top = cg_iface_conv(g, List_get<string>(&etys, i), tv, n.b); }
                cg_emit(g, "  store "); cg_emit(g, rty); cg_emit(g, " "); cg_emit(g, top); cg_emit(g, ", ptr "); cg_emit(g, res); cg_emit(g, "\n");
            }
            cg_br(g, lend);
            cg_label(g, lelse);
            List_push<string>(&rtys, rty); List_push<string>(&ress, res); List_push<string>(&lends, lend);
            i = i + 1;
        }
        *ExprNode last = List_get<*ExprNode>(&chain, k - 1);
        CgVal ev = cg_expr(g, List_get<*ExprNode>(&last.kids, 0));
        i = k - 1;
        while (i >= 0) {
            string rty = List_get<string>(&rtys, i);
            string res = List_get<string>(&ress, i);
            string lend = List_get<string>(&lends, i);
            if (res[0] == 0) {                             // void: nothing to merge
                cg_br(g, lend);
                cg_label(g, lend);
                ev.op = ""; ev.ty = "void"; ev.ety = "void";
                i = i - 1;
                continue;
            }
            string eop = cg_coerce(g, ev, rty);
            if (cg_is_iface(g, cg_dealias(g, List_get<string>(&etys, i))) == 1) {
                *ExprNode ex = List_get<*ExprNode>(&last.kids, 0);
                if (i < k - 1) { ex = List_get<*ExprNode>(&chain, i + 1); }
                eop = cg_iface_conv(g, List_get<string>(&etys, i), ev, ex);
            }
            cg_emit(g, "  store "); cg_emit(g, rty); cg_emit(g, " "); cg_emit(g, eop); cg_emit(g, ", ptr "); cg_emit(g, res); cg_emit(g, "\n");
            cg_br(g, lend);
            cg_label(g, lend);
            string t = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = load "); cg_emit(g, rty); cg_emit(g, ", ptr "); cg_emit(g, res); cg_emit(g, "\n");
            ev.op = t; ev.ty = rty; ev.ety = List_get<string>(&etys, i);
            i = i - 1;
        }
        List_free<*ExprNode>(&chain); List_free<string>(&etys);
        List_free<string>(&rtys); List_free<string>(&ress); List_free<string>(&lends);
        v.op = ev.op; v.ty = ev.ty; v.ety = ev.ety; return v;
    }

    if (e.kind == EK_QUESTION) {
        // `expr?` — if expr is an Err Result (`.ok == 0`), return it whole from the enclosing
        // function; otherwise the expression yields the unwrapped `.value` field.
        CgVal r = cg_expr(g, e.a);
        string llty = r.ty; string sname = llty;
        if ((int)llty[0] == 37) { int ll = 0; while (llty[ll] != 0) { ll = ll + 1; } sname = cg_sub_str(llty, 1, ll); }
        CgStruct s = cg_find_struct(g, sname);
        int okIdx = cg_field_idx(&s, "ok");
        int valIdx = cg_field_idx(&s, "value");
        string okllty = cg_lltype(g, List_get<string>(&s.fetys, okIdx));
        string valety = List_get<string>(&s.fetys, valIdx);
        string valllty = cg_lltype(g, valety);
        string tmp = cg_entry_alloca(g, llty);
        cg_emit(g, "  store "); cg_emit(g, llty); cg_emit(g, " "); cg_emit(g, r.op); cg_emit(g, ", ptr "); cg_emit(g, tmp); cg_emit(g, "\n");
        string okp = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, okp); cg_emit(g, " = getelementptr "); cg_emit(g, llty); cg_emit(g, ", ptr "); cg_emit(g, tmp);
        cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(okIdx)); cg_emit(g, "\n");
        string okv = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, okv); cg_emit(g, " = load "); cg_emit(g, okllty); cg_emit(g, ", ptr "); cg_emit(g, okp); cg_emit(g, "\n");
        string iserr = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, iserr); cg_emit(g, " = icmp eq "); cg_emit(g, okllty); cg_emit(g, " "); cg_emit(g, okv); cg_emit(g, ", 0\n");
        string errl = cg_lbl(g); string contl = cg_lbl(g);
        cg_emit(g, "  br i1 "); cg_emit(g, iserr); cg_emit(g, ", label %"); cg_emit(g, errl); cg_emit(g, ", label %"); cg_emit(g, contl); cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, errl);                               // propagate the Err out of the function
        string whole = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, whole); cg_emit(g, " = load "); cg_emit(g, llty); cg_emit(g, ", ptr "); cg_emit(g, tmp); cg_emit(g, "\n");
        cg_run_cleanups(g, 0, 1);                        // ? error exit: defers + errdefers
        cg_emit(g, "  ret "); cg_emit(g, g.cur_ret); cg_emit(g, " "); cg_emit(g, whole); cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, contl);                              // success: unwrap .value
        string valp = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, valp); cg_emit(g, " = getelementptr "); cg_emit(g, llty); cg_emit(g, ", ptr "); cg_emit(g, tmp);
        cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(valIdx)); cg_emit(g, "\n");
        string val = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, val); cg_emit(g, " = load "); cg_emit(g, valllty); cg_emit(g, ", ptr "); cg_emit(g, valp); cg_emit(g, "\n");
        v.op = val; v.ty = valllty; v.ety = valety; return v;
    }

    if (e.kind == EK_ALLOCWITH) {
        // alloc_with(&a, T, n) → (*T) <AllocType>_alloc(&a, n * sizeof(T)). The allocator's
        // static struct type names the alloc method; the result is a `*T`.
        string elemty = cg_apply_sub(g, e.sval);
        CgVal av = cg_expr(g, e.a);                       // allocator pointer
        string at = cg_strip_ptr(cg_etype(g, e.a));       // allocator struct name
        string fname = cg_cat(at, "_alloc");
        if (cg_has_targs(cg_apply_sub(g, at)) == 1) {     // a generic instance: its inline method or `G_int_alloc`
            string ml = cg_ensure_method_inst(g, at, "alloc");
            if (ml[0] != 0) { fname = ml; }
            else { fname = cg_cat(cg_ensure_struct_inst(g, cg_apply_sub(g, at)), "_alloc"); }
        }
        CgFn f = cg_find_fn(g, fname);
        CgVal cnt = cg_expr(g, e.b);
        string n64 = cg_coerce(g, cnt, "i64");
        // n * sizeof(T) as a signed 64-bit size: a count that overflows it, or is negative,
        // (or a size too wide for a narrower size parameter) yields null instead of a
        // wrapped, too-small allocation. Mirrors the C++ visit(AllocWithExpr).
        cg_ensure_extern(g, "llvm.smul.with.overflow.i64", "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\n");
        string prod = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, prod); cg_emit(g, " = call { i64, i1 } @llvm.smul.with.overflow.i64(i64 "); cg_emit(g, n64);
        cg_emit(g, ", i64 "); cg_emit(g, cg_itoa(cg_size(g, elemty))); cg_emit(g, ")\n");
        string total = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, total); cg_emit(g, " = extractvalue { i64, i1 } "); cg_emit(g, prod); cg_emit(g, ", 0\n");
        string ovf = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, ovf); cg_emit(g, " = extractvalue { i64, i1 } "); cg_emit(g, prod); cg_emit(g, ", 1\n");
        string neg = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, neg); cg_emit(g, " = icmp slt i64 "); cg_emit(g, total); cg_emit(g, ", 0\n");
        string bad = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, bad); cg_emit(g, " = or i1 "); cg_emit(g, ovf); cg_emit(g, ", "); cg_emit(g, neg); cg_emit(g, "\n");
        string p1 = cg_pty(&f, 1); string targ = total; string targty = "i64";
        if (p1[0] != 0 && cg_streq(p1, "i64") == 0) {
            int pw = cg_int_w(p1);
            if (pw > 1 && pw < 64) {
                string wide = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, wide); cg_emit(g, " = icmp sgt i64 "); cg_emit(g, total);
                cg_emit(g, ", "); cg_emit(g, cg_i64toa(((int64)1 << (int64)(pw - 1)) - (int64)1)); cg_emit(g, "\n");
                string bad2 = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, bad2); cg_emit(g, " = or i1 "); cg_emit(g, bad); cg_emit(g, ", "); cg_emit(g, wide); cg_emit(g, "\n");
                bad = bad2;
            }
        }
        if (p1[0] != 0) { let tv: CgVal; tv.op = total; tv.ty = "i64"; tv.ety = "int64"; targ = cg_coerce(g, tv, p1); targty = p1; }
        string lcall = cg_lbl(g); string lfail = cg_lbl(g); string ldone = cg_lbl(g);
        cg_emit(g, "  br i1 "); cg_emit(g, bad); cg_emit(g, ", label %"); cg_emit(g, lfail);
        cg_emit(g, ", label %"); cg_emit(g, lcall); cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, lcall);
        string r = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, r); cg_emit(g, " = call "); cg_emit(g, f.retty);
        cg_emit(g, " @"); cg_emit(g, fname); cg_emit(g, "(ptr "); cg_emit(g, av.op);
        cg_emit(g, ", "); cg_emit(g, targty); cg_emit(g, " "); cg_emit(g, targ); cg_emit(g, ")\n");
        cg_br(g, ldone);
        cg_label(g, lfail);
        cg_br(g, ldone);
        cg_label(g, ldone);
        string res = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, res); cg_emit(g, " = phi ptr [ "); cg_emit(g, r); cg_emit(g, ", %"); cg_emit(g, lcall);
        cg_emit(g, " ], [ null, %"); cg_emit(g, lfail); cg_emit(g, " ]\n");
        v.op = res; v.ty = "ptr"; v.ety = cg_cat("*", elemty); return v;
    }

    if (e.kind == EK_THREADCREATE) {
        // thread_create(worker) → pthread_create(&tid, null, fn, env); returns the tid.
        CgVal fat = cg_expr(g, e.a);                      // %closure {fn, env}
        string fatop = cg_coerce(g, fat, "%closure");     // decay a bare fn arg to {@__fnptr, null}
        string fnp = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, fnp); cg_emit(g, " = extractvalue %closure "); cg_emit(g, fatop); cg_emit(g, ", 0\n");
        string env = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, env); cg_emit(g, " = extractvalue %closure "); cg_emit(g, fatop); cg_emit(g, ", 1\n");
        string tid = cg_entry_alloca(g, "ptr");
        cg_ensure_extern(g, "pthread_create", "declare i32 @pthread_create(ptr, ptr, ptr, ptr)\n");
        g.uses_threads = 1;
        // A lambda written in the call has no other owner, so the thread owns it: start it
        // through a trampoline that frees its env once the body returns. A closure value
        // stays its owner's (the same closure may start several threads). Mirrors C++.
        if (e.a != null && e.a.kind == EK_LAMBDA) {
            g.uses_heap_env = 1;                          // declares malloc (as for a heap env)
            cg_ensure_extern(g, "free", "declare void @free(ptr)\n");
            if (cg_seen_inst(g, "fn:__eskiu_thread_owned") == 0) {
                List_push<string>(&g.inst_seen, "fn:__eskiu_thread_owned");
                String_append(&g.globals, "define internal ptr @__eskiu_thread_owned(ptr %pack) {\nentry:\n");
                String_append(&g.globals, "  %fn = load ptr, ptr %pack\n");
                String_append(&g.globals, "  %envp = getelementptr { ptr, ptr }, ptr %pack, i32 0, i32 1\n");
                String_append(&g.globals, "  %env = load ptr, ptr %envp\n");
                String_append(&g.globals, "  call void @free(ptr %pack)\n");
                String_append(&g.globals, "  call void %fn(ptr %env)\n");
                String_append(&g.globals, "  call void @free(ptr %env)\n");
                String_append(&g.globals, "  ret ptr null\n}\n");
            }
            string pack = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, pack); cg_emit(g, " = call ptr @malloc(i64 "); cg_emit(g, cg_itoa(2 * g.ptrsz)); cg_emit(g, ")\n");
            cg_emit(g, "  store ptr "); cg_emit(g, fnp); cg_emit(g, ", ptr "); cg_emit(g, pack); cg_emit(g, "\n");
            string pe = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, pe); cg_emit(g, " = getelementptr { ptr, ptr }, ptr "); cg_emit(g, pack); cg_emit(g, ", i32 0, i32 1\n");
            cg_emit(g, "  store ptr "); cg_emit(g, env); cg_emit(g, ", ptr "); cg_emit(g, pe); cg_emit(g, "\n");
            fnp = "@__eskiu_thread_owned";
            env = pack;
        }
        cg_emit(g, "  call i32 @pthread_create(ptr "); cg_emit(g, tid); cg_emit(g, ", ptr null, ptr ");
        cg_emit(g, fnp); cg_emit(g, ", ptr "); cg_emit(g, env); cg_emit(g, ")\n");
        string h = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, h); cg_emit(g, " = load ptr, ptr "); cg_emit(g, tid); cg_emit(g, "\n");
        v.op = h; v.ty = "ptr"; v.ety = "*void"; return v;
    }

    if (e.kind == EK_FREECLOSURE) {
        // free_closure(f) → free the closure's heap env (slot 1); free(null) is a safe no-op.
        CgVal fat = cg_expr(g, e.a);
        string fatop = cg_coerce(g, fat, "%closure");     // a bare fn decays to {@__fnptr, null} (env null)
        string env = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, env); cg_emit(g, " = extractvalue %closure "); cg_emit(g, fatop); cg_emit(g, ", 1\n");
        cg_ensure_extern(g, "free", "declare void @free(ptr)\n");
        cg_emit(g, "  call void @free(ptr "); cg_emit(g, env); cg_emit(g, ")\n");
        v.op = ""; v.ty = "void"; return v;
    }

    if (e.kind == EK_ARRAYLIT) {
        // Only a variable initializer takes `{...}` (cg_array_init / cg_global_init); as a
        // value anywhere else (a struct-literal field, an argument) it is an error, as in C++.
        dprintf(2, "error: an array literal '{...}' is only valid as a variable initializer\n");
        exit(1);
    }
    if (e.kind == EK_STRUCTINIT) {
        // A struct literal `P{ … }` used as an rvalue (e.g. `x = P{…}`): materialize into a
        // temp, fill its fields, and load the struct value. (Var-decls fill in place.)
        string sname = e.sval;
        string llty = cg_lltype(g, sname);
        string slot = cg_entry_alloca(g, llty);
        cg_struct_init(g, slot, sname, e);
        string r = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, r); cg_emit(g, " = load "); cg_emit(g, llty); cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
        v.op = r; v.ty = llty; v.ety = sname; return v;
    }

    if (e.kind == EK_LAMBDA) {
        // Free-variable analysis: capture the enclosing locals the body references (not its
        // own params). The env is stack-allocated here (valid for non-escaping closures —
        // the common apply/map case; an escaping closure's env would dangle). Build a fat
        // pointer { @lambdaN, env } and queue the body for emission.
        string lname = cg_cat("__lambda", cg_itoa(g.lam_seq));
        g.lam_seq = g.lam_seq + 1;
        List<string> pp; List_init<string>(&pp, 4); cg_paren_list(e.sval, &pp);
        List<string> ids; List_init<string>(&ids, 16); cg_collect_idents_s(e.stmt, &ids);
        List<string> capn; List_init<string>(&capn, 4);
        List<string> capt; List_init<string>(&capt, 4);
        List<CgLocal> statics; List_init<CgLocal>(&statics, 1);
        int ii = 0;
        while (ii < List_len<string>(&ids)) {
            string nm = List_get<string>(&ids, ii);
            ii = ii + 1;
            if (cg_in_strlist(&capn, nm) == 1) { continue; }      // already captured
            int isparam = 0; int pj = 0;
            while (pj < List_len<string>(&pp)) {
                if (cg_streq(cg_last_word(List_get<string>(&pp, pj)), nm) == 1) { isparam = 1; }
                pj = pj + 1;
            }
            if (isparam == 1) { continue; }
            CgLocal l = cg_find_local(g, nm);
            // A `static` local has static storage (its slot is a global, "@…"): the body
            // refers to that one cell, like a global, instead of capturing a copy.
            if (l.slot[0] == 64) { List_push<CgLocal>(&statics, l); continue; }
            if (l.slot[0] != 0) { List_push<string>(&capn, nm); List_push<string>(&capt, l.ety); }
        }
        let lam: CgLambda; lam.name = lname; lam.node = e; lam.capn = capn; lam.capt = capt; lam.statics = statics;
        lam.sub = cg_copy_sub(&g.cursub);   // freeze the generic substitution for deferred emission
        // Return type: the fn-type from the assignment context wins over the written one
        // (e.g. a lambda written `int(int x)` assigned to `fn(int)->float` returns float).
        if (g.lam_expret[0] != 0) { lam.rety = g.lam_expret; } else { lam.rety = cg_arm_var(e.sval); }
        List_push<CgLambda>(&g.lambdas, lam);

        string env = "null";
        int nc = List_len<string>(&capn);
        if (nc > 0) {
            string envty = cg_env_lltype(g, &capt);
            // Heap-allocate the env: a closure may escape (be stored/returned and called after
            // this frame returns — e.g. an event-loop callback), so the env must outlive the
            // frame. (Sound default; non-escaping closures leak the env — acceptable for now.)
            g.uses_heap_env = 1;
            string szg = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, szg); cg_emit(g, " = getelementptr "); cg_emit(g, envty); cg_emit(g, ", ptr null, i32 1\n");
            string szi = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, szi); cg_emit(g, " = ptrtoint ptr "); cg_emit(g, szg); cg_emit(g, " to i64\n");
            env = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, env); cg_emit(g, " = call ptr @malloc(i64 "); cg_emit(g, szi); cg_emit(g, ")\n");
            int j = 0;
            while (j < nc) {
                CgLocal l = cg_find_local(g, List_get<string>(&capn, j));
                string ld = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, ld); cg_emit(g, " = load "); cg_emit(g, l.ty); cg_emit(g, ", ptr "); cg_emit(g, l.slot); cg_emit(g, "\n");
                string fp = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, fp); cg_emit(g, " = getelementptr "); cg_emit(g, envty); cg_emit(g, ", ptr "); cg_emit(g, env); cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(j)); cg_emit(g, "\n");
                cg_emit(g, "  store "); cg_emit(g, l.ty); cg_emit(g, " "); cg_emit(g, ld); cg_emit(g, ", ptr "); cg_emit(g, fp); cg_emit(g, "\n");
                j = j + 1;
            }
        }
        string c = cg_entry_alloca(g, "%closure");
        string c0 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, c0); cg_emit(g, " = getelementptr %closure, ptr "); cg_emit(g, c); cg_emit(g, ", i32 0, i32 0\n");
        cg_emit(g, "  store ptr @"); cg_emit(g, lname); cg_emit(g, ", ptr "); cg_emit(g, c0); cg_emit(g, "\n");
        string c1 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, c1); cg_emit(g, " = getelementptr %closure, ptr "); cg_emit(g, c); cg_emit(g, ", i32 0, i32 1\n");
        cg_emit(g, "  store ptr "); cg_emit(g, env); cg_emit(g, ", ptr "); cg_emit(g, c1); cg_emit(g, "\n");
        string r = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, r); cg_emit(g, " = load %closure, ptr "); cg_emit(g, c); cg_emit(g, "\n");
        v.op = r; v.ty = "%closure"; v.ety = ""; return v;
    }

    v.op = "0"; v.ty = "i32"; return v;
}

// Construct an ADT enum value: alloca the `{ i32, [N x i64] }` tagged union, store the
// variant tag, then write each payload field by viewing the storage as the variant's
// field struct. `call` is the EK_CALL node carrying the argument exprs (null for a
// payload-less variant like `None`). Returns the loaded value (by value, like a struct).
CgVal cg_build_variant(Codegen* g, CgVariant var, *ExprNode call) {
    let v: CgVal; v.ety = "";
    string llty = cg_cat("%", var.ename);
    string slot = cg_entry_alloca(g, llty);
    string tp = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, tp); cg_emit(g, " = getelementptr "); cg_emit(g, llty);
    cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, ", i32 0, i32 0\n");
    cg_emit(g, "  store i32 "); cg_emit(g, cg_itoa(var.tag)); cg_emit(g, ", ptr "); cg_emit(g, tp); cg_emit(g, "\n");
    int np = List_len<string>(&var.ptys);
    if (np > 0 && call != null) {
        string pstruct = cg_payload_lltype(g, &var);   // "{ i32, i32 }"
        string pp = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, pp); cg_emit(g, " = getelementptr "); cg_emit(g, llty);
        cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, ", i32 0, i32 1\n");
        int i = 0;
        while (i < np && i < List_len<*ExprNode>(&call.kids)) {
            CgVal a = cg_expr(g, List_get<*ExprNode>(&call.kids, i));
            string fty = cg_lltype(g, List_get<string>(&var.ptys, i));
            string aop = cg_coerce(g, a, fty);
            string fp = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, fp); cg_emit(g, " = getelementptr "); cg_emit(g, pstruct);
            cg_emit(g, ", ptr "); cg_emit(g, pp); cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(i)); cg_emit(g, "\n");
            cg_emit(g, "  store "); cg_emit(g, fty); cg_emit(g, " "); cg_emit(g, aop);
            cg_emit(g, ", ptr "); cg_emit(g, fp); cg_emit(g, "\n");
            i = i + 1;
        }
    }
    string r = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, r); cg_emit(g, " = load "); cg_emit(g, llty); cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
    v.op = r; v.ty = llty; v.ety = var.ename; return v;
}

int cg_is_atomic(string nm) {
    return cg_streq(nm, "atomic_load") == 1 || cg_streq(nm, "atomic_store") == 1
        || cg_streq(nm, "atomic_swap") == 1 || cg_streq(nm, "atomic_cas") == 1;
}

// Lower an atomic intrinsic to the matching LLVM atomic instruction. The cell is a
// `*int` (i32 storage); orderings mirror the C++ (acquire/release/acq_rel).
CgVal cg_emit_atomic(Codegen* g, string nm, *ExprNode e) {
    let v: CgVal; v.ety = "";
    string cell = cg_expr(g, List_get<*ExprNode>(&e.kids, 0)).op;
    if (cg_streq(nm, "atomic_load") == 1) {
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = load atomic i32, ptr "); cg_emit(g, cell); cg_emit(g, " acquire, align 4\n");
        v.op = t; v.ty = "i32"; return v;
    }
    string a1 = cg_coerce(g, cg_expr(g, List_get<*ExprNode>(&e.kids, 1)), "i32");
    if (cg_streq(nm, "atomic_store") == 1) {
        cg_emit(g, "  store atomic i32 "); cg_emit(g, a1); cg_emit(g, ", ptr "); cg_emit(g, cell); cg_emit(g, " release, align 4\n");
        v.op = ""; v.ty = "void"; return v;
    }
    if (cg_streq(nm, "atomic_swap") == 1) {
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = atomicrmw xchg ptr "); cg_emit(g, cell); cg_emit(g, ", i32 "); cg_emit(g, a1); cg_emit(g, " acq_rel, align 4\n");
        v.op = t; v.ty = "i32"; return v;
    }
    // atomic_cas(cell, expected, desired) → bool (did the swap happen)
    string des = cg_coerce(g, cg_expr(g, List_get<*ExprNode>(&e.kids, 2)), "i32");
    string p = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, p); cg_emit(g, " = cmpxchg ptr "); cg_emit(g, cell);
    cg_emit(g, ", i32 "); cg_emit(g, a1); cg_emit(g, ", i32 "); cg_emit(g, des); cg_emit(g, " acq_rel acquire, align 4\n");
    string t = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = extractvalue { i32, i1 } "); cg_emit(g, p); cg_emit(g, ", 1\n");
    v.op = t; v.ty = "i1"; return v;
}

// Call a closure value `cval` (a loaded %closure) of fn-type `fnty`: extract { fn, env }
// and call fn(env, args...). Shared by ident-of-fn-type and closure-typed-field callees.
CgVal cg_indirect_call(Codegen* g, string cval, string fnty, *ExprNode e) {
    let v: CgVal; v.ety = "";
    string fp = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, fp); cg_emit(g, " = extractvalue %closure "); cg_emit(g, cval); cg_emit(g, ", 0\n");
    string ep = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, ep); cg_emit(g, " = extractvalue %closure "); cg_emit(g, cval); cg_emit(g, ", 1\n");
    List<string> fpt; List_init<string>(&fpt, 4); cg_paren_list(fnty, &fpt);
    string rt = cg_lltype(g, cg_fnty_ret(fnty));
    string cargs = cg_cat("ptr ", ep);                  // env is the first argument
    int i = 0; int nn = List_len<*ExprNode>(&e.kids);
    while (i < nn) {
        *ExprNode iax = List_get<*ExprNode>(&e.kids, i);
        CgVal a = cg_expr(g, iax);
        string aop = a.op; string aty = a.ty;
        if (i < List_len<string>(&fpt)) {
            string pety = List_get<string>(&fpt, i);
            string pty = cg_lltype(g, pety); aop = cg_coerce(g, a, pty); aty = pty;
            if (cg_is_iface(g, cg_dealias(g, pety)) == 1) { aop = cg_iface_conv(g, pety, a, iax); }   // box `&s`
        }
        cargs = cg_cat(cargs, cg_cat(", ", cg_cat(aty, cg_cat(" ", aop))));
        i = i + 1;
    }
    int isvoidc = cg_streq(rt, "void");
    string t = cg_emit_callish(g, rt, fp, cargs, isvoidc);
    if (isvoidc == 1) { v.op = ""; v.ty = "void"; return v; }
    v.op = t; v.ty = rt; v.ety = cg_fnty_ret(fnty); return v;
}

// Box a struct pointer `dataop` (of struct `structName`) as interface `ifaceName`: the fat
// pointer value {data, vtable} (an interface value is this struct, by value, like a closure).
// The per-(interface,struct) vtable global is emitted once, holding the struct's
// implementation of each interface method in declaration order.
// The function implementing interface method `mi` of `f` for struct `sname`: `S_m`, or for
// a generic instance (`Box<int>`) its inline method or a generic free `S_m<T..>(S<T..>* self,
// ...)` instantiated for it (type params bound from the receiver, then the interface's
// parameter types). Mirrors the C++ boxAsInterface.
string cg_iface_slot_fn(Codegen* g, CgIface* f, int mi, string sname) {
    string method = List_get<string>(&f.mnames, mi);
    if (cg_has_targs(sname) == 0) { return cg_cat(cg_cat(sname, "_"), method); }
    string gm = cg_ensure_method_inst(g, sname, method);
    if (gm[0] != 0) { return gm; }
    string base = cg_gen_base(sname);
    *DeclNode gd = cg_find_gfn(g, cg_cat(cg_cat(base, "_"), method));
    if (gd == null || List_len<Param>(&gd.params) == 0) { return cg_cat(cg_cat(cg_mangle(sname), "_"), method); }
    string selfty = List_get<Param>(&gd.params, 0).ty;
    List<string> sargs; List_init<string>(&sargs, 2); cg_gen_args(cg_strip_ptr(selfty), &sargs);
    List<string> rargs; List_init<string>(&rargs, 2); cg_gen_args(sname, &rargs);
    List<string> ipts = List_get<List<string>>(&f.mparams, mi);
    String sp; String_init(&sp, 16);
    String_append(&sp, gd.name); String_append(&sp, "<");
    int ti = 0; int ntp = List_len<TypeParam>(&gd.type_params);
    while (ti < ntp) {
        string tp = List_get<TypeParam>(&gd.type_params, ti).name;
        string binding = "";
        int k = 0;
        while (binding[0] == 0 && k < List_len<string>(&sargs) && k < List_len<string>(&rargs)) {
            if (cg_streq(List_get<string>(&sargs, k), tp) == 1) { binding = List_get<string>(&rargs, k); }
            k = k + 1;
        }
        int pi = 1; int np = List_len<Param>(&gd.params);
        while (binding[0] == 0 && pi < np && pi - 1 < List_len<string>(&ipts)) {
            binding = cg_infer_bind(List_get<Param>(&gd.params, pi).ty, tp, List_get<string>(&ipts, pi - 1));
            pi = pi + 1;
        }
        if (ti > 0) { String_append(&sp, ", "); }
        String_append(&sp, binding);
        ti = ti + 1;
    }
    String_append(&sp, ">");
    return cg_ensure_fn_inst(g, (string)String_cstr(&sp));
}

string cg_iface_vtable(Codegen* g, string ifaceName, string structName);   // fwd
string cg_box_iface(Codegen* g, string ifaceName, string structName, string dataop) {
    string vtg = cg_iface_vtable(g, ifaceName, structName);
    string f1 = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, f1); cg_emit(g, " = insertvalue %iface_fat undef, ptr "); cg_emit(g, dataop); cg_emit(g, ", 0\n");
    string f2 = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, f2); cg_emit(g, " = insertvalue %iface_fat "); cg_emit(g, f1); cg_emit(g, ", ptr "); cg_emit(g, vtg); cg_emit(g, ", 1\n");
    return f2;
}

// The vtable global of `structName` as an `ifaceName` (emitted once), e.g. `@Sh_vtable_Sq`.
string cg_iface_vtable(Codegen* g, string ifaceName, string structName) {
    CgIface f = cg_find_iface(g, ifaceName);
    string vtg = cg_cat("@", cg_cat(ifaceName, cg_cat("_vtable_", cg_mangle(structName))));
    string key = cg_cat("vt:", cg_cat(ifaceName, cg_cat("_", structName)));
    if (cg_seen_inst(g, key) == 0) {
        List_push<string>(&g.inst_seen, key);
        // Resolve every slot first: instantiating one may itself append to g.globals.
        List<string> slots; List_init<string>(&slots, 4);
        int mi = 0; int mn = List_len<string>(&f.mnames);
        while (mi < mn) { List_push<string>(&slots, cg_iface_slot_fn(g, &f, mi, structName)); mi = mi + 1; }
        String_append(&g.globals, vtg); String_append(&g.globals, " = private constant %");
        String_append(&g.globals, ifaceName); String_append(&g.globals, "_vtable { ");
        mi = 0;
        while (mi < mn) {
            if (mi > 0) { String_append(&g.globals, ", "); }
            String_append(&g.globals, "ptr @");
            String_append(&g.globals, List_get<string>(&slots, mi));
            mi = mi + 1;
        }
        String_append(&g.globals, " }\n");
    }
    return vtg;
}

// Constant initializer text of a global / static of Eskiu type `ety` (cg_global_init on
// its LLVM type). An interface value is `null` (the empty fat value) or a boxed
// `&global`: `{ ptr @g, ptr @I_vtable_S }`.
string cg_global_init_ty(Codegen* g, *ExprNode e, string ety) {
    string t = cg_dealias(g, ety);
    // An array of interface values: each element is boxed like a scalar one.
    string inner = t; while (cg_is_array(inner) == 1) { inner = cg_dealias(g, cg_array_elem(inner)); }
    if (e != null && e.kind == EK_ARRAYLIT && cg_is_array(t) == 1 && cg_is_iface(g, inner) == 1) {
        string elemEty = cg_array_elem(t);
        string elemLl = cg_lltype(g, elemEty);
        int cnt = 0; string lt = cg_lltype(g, t);
        int ci = 1; while ((int)lt[ci] >= 48 && (int)lt[ci] <= 57) { cnt = cnt * 10 + ((int)lt[ci] - 48); ci = ci + 1; }
        let out: String; String_init(&out, 64);
        String_push(&out, '[');
        int k = 0;
        while (k < cnt) {
            if (k > 0) { String_append(&out, ", "); }
            String_append(&out, elemLl); String_push(&out, ' ');
            if (k < List_len<*ExprNode>(&e.kids)) { String_append(&out, cg_global_init_ty(g, List_get<*ExprNode>(&e.kids, k), elemEty)); }
            else { String_append(&out, "zeroinitializer"); }
            k = k + 1;
        }
        String_push(&out, ']');
        return (string)String_cstr(&out);
    }
    if (e != null && cg_is_iface(g, t) == 1) {
        if (e.kind == EK_LITERAL && e.lit_kind == LIT_NULL) { return "zeroinitializer"; }
        if (e.kind == EK_UNARY && cg_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
            CgLocal gl = cg_find_global(g, e.a.sval);
            if (gl.slot[0] != 0 && cg_is_struct(g, cg_dealias(g, gl.ety)) == 1) {
                string vtg = cg_iface_vtable(g, t, cg_dealias(g, gl.ety));
                return cg_cat("{ ptr ", cg_cat(gl.slot, cg_cat(", ptr ", cg_cat(vtg, " }"))));
            }
        }
        dprintf(2, "error: an interface global's initializer must be null or the address of a global struct\n");
        exit(1);
    }
    return cg_global_init(g, e, cg_lltype(g, ety));
}

// The operand for value `a` (from expression `ax`) stored into a slot of Eskiu type `tety`:
// when the slot is an interface and `a` is not already that interface, box the struct
// pointer (`null` → the empty fat value). Otherwise `a.op` unchanged. Mirrors evalForType.
string cg_iface_conv(Codegen* g, string tety, CgVal a, *ExprNode ax) {
    string t = cg_dealias(g, tety);
    if (cg_is_iface(g, t) == 0) { return a.op; }
    if (cg_streq(cg_dealias(g, a.ety), t) == 1) { return a.op; }
    if (ax != null && ax.kind == EK_LITERAL && ax.lit_kind == LIT_NULL) { return "zeroinitializer"; }
    if (cg_streq(a.ty, "%iface_fat") == 1) { return a.op; }
    string sety = a.ety; if (sety[0] == 0) { sety = cg_etype(g, ax); }
    return cg_box_iface(g, t, cg_strip_ptr(sety), a.op);
}

// Dynamic dispatch `recv.method(...)` where `recv` is an interface value (a fat pointer
// `fatop`): load the data + vtable from the fat pointer, load the method's fn pointer from
// its vtable slot, and call it with `data` as the implicit first argument.
CgVal cg_dispatch_iface(Codegen* g, string ifaceName, string fatop, string method, *ExprNode e) {
    let v: CgVal; v.ety = "";
    CgIface f = cg_find_iface(g, ifaceName);
    int idx = cg_iface_midx(&f, method);
    string data = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, data); cg_emit(g, " = extractvalue %iface_fat "); cg_emit(g, fatop); cg_emit(g, ", 0\n");
    string vt = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, vt); cg_emit(g, " = extractvalue %iface_fat "); cg_emit(g, fatop); cg_emit(g, ", 1\n");
    string fg = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, fg); cg_emit(g, " = getelementptr %"); cg_emit(g, ifaceName); cg_emit(g, "_vtable, ptr "); cg_emit(g, vt);
    cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(idx)); cg_emit(g, "\n");
    string fnp = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, fnp); cg_emit(g, " = load ptr, ptr "); cg_emit(g, fg); cg_emit(g, "\n");
    string rety = List_get<string>(&f.mrets, idx);
    string rt = cg_lltype(g, rety);
    string args = cg_cat("ptr ", data);                 // self/data is the first argument
    List<string> ptys = List_get<List<string>>(&f.mparams, idx);
    int i = 0; int nn = List_len<*ExprNode>(&e.kids);
    while (i < nn) {
        *ExprNode dax = List_get<*ExprNode>(&e.kids, i);
        CgVal a = cg_expr(g, dax);
        string aop = a.op; string aty = a.ty;
        if (i < List_len<string>(&ptys)) {              // coerce to the method's param type
            string dpety = List_get<string>(&ptys, i);
            string pty = cg_lltype(g, dpety);
            if (cg_is_iface(g, cg_dealias(g, dpety)) == 1) { aop = cg_iface_conv(g, dpety, a, dax); aty = pty; }
            else if (pty[0] != 0) { aop = cg_coerce(g, a, pty); aty = pty; }
        }
        args = cg_cat(args, cg_cat(", ", cg_cat(aty, cg_cat(" ", aop))));
        i = i + 1;
    }
    int isvoid = cg_streq(rt, "void");
    string t = cg_emit_callish(g, rt, fnp, args, isvoid);
    if (isvoid == 1) { v.op = ""; v.ty = "void"; return v; }
    v.op = t; v.ty = rt; v.ety = rety; return v;
}

// Emit a call to an already-monomorphized function `@mangled` with e's args (coerced to
// its declared param types). Shared by explicit template calls and inferred generic calls.
CgVal cg_call_mangled(Codegen* g, string mangled, *ExprNode e) {
    let v: CgVal; v.ety = "";
    CgFn f = cg_find_fn(g, mangled);
    string args = "";
    int i = 0; int n = List_len<*ExprNode>(&e.kids);
    while (i < n) {
        *ExprNode ax = List_get<*ExprNode>(&e.kids, i);
        CgVal a = cg_expr(g, ax);
        string pty = cg_pty(&f, i);
        string pety = cg_pety(&f, i);
        string aop = a.op; string aty = a.ty;
        // An interface parameter (`Sh y`, or `T x` with T = Sh) boxes a struct pointer.
        if (pety[0] != 0 && cg_is_iface(g, cg_dealias(g, pety)) == 1) { aop = cg_iface_conv(g, pety, a, ax); aty = "%iface_fat"; }
        else if (pty[0] != 0) { aop = cg_coerce(g, a, pty); aty = pty; }
        else if (f.variadic == 1 && cg_streq(a.ty, "float") == 1) { aop = cg_coerce(g, a, "double"); aty = "double"; }   // vararg promotion
        else if (f.variadic == 1 && cg_int_w(a.ty) > 0 && cg_int_w(a.ty) < 32) { aop = cg_coerce(g, a, "i32"); aty = "i32"; }
        if (args[0] != 0) { args = cg_cat(args, ", "); }
        args = cg_cat(args, cg_cat(aty, cg_cat(" ", aop)));
        i = i + 1;
    }
    int isvoid = cg_streq(f.retty, "void");
    // A variadic callee needs the explicit function type: `call i32 (i32, ...) @f_int`.
    string callty = f.retty;
    if (f.variadic == 1) { callty = cg_cat(f.retty, cg_cat(" (", cg_cat(cg_va(f.fixedtypes), ")"))); }
    string t = cg_emit_callish(g, callty, cg_cat("@", mangled), args, isvoid);
    if (isvoid == 1) { v.op = ""; v.ty = "void"; return v; }
    v.op = t; v.ty = f.retty; v.ety = f.rety; return v;
}

// Whole-token index of `tok` in `s` (delimited by non-identifier chars), or -1.
int cg_tok_index(string s, string tok) {
    int n = 0; while (s[n] != 0) { n = n + 1; }
    int m = 0; while (tok[m] != 0) { m = m + 1; }
    int i = 0;
    while (i + m <= n) {
        int eq = 1; int k = 0;
        while (k < m) { if (s[i + k] != tok[k]) { eq = 0; } k = k + 1; }
        if (eq == 1) {
            int beforeOk = 1; if (i > 0) { int b = (int)s[i - 1]; if ((b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95) { beforeOk = 0; } }
            int afterOk = 1; int af = (int)s[i + m]; if ((af >= 97 && af <= 122) || (af >= 65 && af <= 90) || (af >= 48 && af <= 57) || af == 95) { afterOk = 0; }
            if (beforeOk == 1 && afterOk == 1) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Infer one type-param binding by unifying a param pattern (e.g. "Chan<T>*") against a
// concrete arg type ("Chan<int>*"): the pattern is prefix + Tp + suffix, so the binding is
// the middle of the arg once prefix/suffix are stripped. "" if it doesn't fit.
// Canonical pointer form: trailing '*'/spaces moved to the front ("Box<T>*" → "*Box<T>"),
// so a declared param (trailing-star) and a cg_etype result (leading-star) compare equal.
string cg_norm_ptr(string t) {
    int b = 0; while (t[b] != 0) { b = b + 1; }
    int stars = 0;
    while (b > 0 && ((int)t[b - 1] == 42 || (int)t[b - 1] == 32)) { if ((int)t[b - 1] == 42) { stars = stars + 1; } b = b - 1; }
    int a = 0;
    while ((int)t[a] == 42) { stars = stars + 1; a = a + 1; }
    string core = cg_sub_str(t, a, b);
    String r; String_init(&r, b - a + stars);
    int i = 0; while (i < stars) { String_push(&r, '*'); i = i + 1; }
    String_append(&r, core);
    return (string)String_cstr(&r);
}

string cg_infer_one(string pat0, string tp, string arg0) {
    string pattern = cg_norm_ptr(pat0);
    string arg = cg_norm_ptr(arg0);
    int pos = cg_tok_index(pattern, tp);
    if (pos < 0) { return ""; }
    int pn = 0; while (pattern[pn] != 0) { pn = pn + 1; }
    int tn = 0; while (tp[tn] != 0) { tn = tn + 1; }
    int an = 0; while (arg[an] != 0) { an = an + 1; }
    string prefix = cg_sub_str(pattern, 0, pos);
    string suffix = cg_sub_str(pattern, pos + tn, pn);
    int pl = pos; int sl = pn - (pos + tn);
    if (an < pl + sl) { return ""; }
    int k = 0; while (k < pl) { if (arg[k] != prefix[k]) { return ""; } k = k + 1; }   // prefix matches
    k = 0; while (k < sl) { if (arg[an - sl + k] != suffix[k]) { return ""; } k = k + 1; }  // suffix matches
    return cg_sub_str(arg, pl, an - sl);
}

// The binding of `tp` from a param pattern against an argument type: structural
// unification over nested type args first (`Pair<A, B>` binds A and B), then the
// prefix/suffix match for other shapes (e.g. a fn type `fn(*K)->uint64`).
string cg_infer_bind(string pat, string tp, string arg) {
    string b = ast_unify_tparam(pat, arg, tp);
    if (b[0] != 0) { return b; }
    return cg_infer_one(pat, tp, arg);
}

// Build `name<arg0, arg1, …>` for a generic fn called without explicit type args, inferring
// each type param from the first parameter whose pattern mentions it. "" if any is unsolved.
string cg_infer_generic(Codegen* g, *DeclNode gd, *ExprNode e) {
    String sp; String_init(&sp, 16);
    String_append(&sp, gd.name); String_append(&sp, "<");
    int ti = 0; int ntp = List_len<TypeParam>(&gd.type_params);
    while (ti < ntp) {
        string tp = List_get<TypeParam>(&gd.type_params, ti).name;
        string binding = "";
        int pi = 0; int np = List_len<Param>(&gd.params);
        while (pi < np && binding[0] == 0) {
            if (pi < List_len<*ExprNode>(&e.kids)) {
                string argty = cg_etype(g, List_get<*ExprNode>(&e.kids, pi));
                if (argty[0] != 0) { binding = cg_infer_bind(List_get<Param>(&gd.params, pi).ty, tp, argty); }
            }
            pi = pi + 1;
        }
        if (binding[0] == 0) { return ""; }              // couldn't infer this param
        if (ti > 0) { String_append(&sp, ", "); }
        String_append(&sp, binding);
        ti = ti + 1;
    }
    String_append(&sp, ">");
    return (string)String_cstr(&sp);
}

// The address (a ptr) of the struct that a member expression `ea` denotes, plus its struct
// type name (via out_sname). Mirrors the base resolution in cg_lval's EK_MEMBER.
string cg_member_baseptr(Codegen* g, *ExprNode ea, *string out_sname) {
    string bet = cg_etype(g, ea);
    if (cg_is_ptr_ty(bet) == 1) { out_sname[0] = cg_strip_ptr(bet); return cg_expr(g, ea).op; }
    CgVal lv = cg_lval(g, ea);
    if (lv.op[0] != 0) { out_sname[0] = bet; if (lv.ety[0] != 0) { out_sname[0] = lv.ety; } return lv.op; }
    CgVal val = cg_expr(g, ea);                       // rvalue → materialize
    if (val.ety[0] != 0) { out_sname[0] = val.ety; } else { out_sname[0] = bet; }
    string slot = cg_entry_alloca(g, val.ty);
    cg_emit(g, "  store "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
    return slot;
}

// `v` truncated to `w` bits, as the signed decimal LLVM expects for an iw constant.
string cg_iconst(uint64 v, int w) {
    let top: uint64 = 1;
    if (w < 64) {
        let m: uint64 = top << w;
        v = v & (m - 1);
        if (v >= m / 2) { return cg_cat("-", cg_u64toa(m - v)); }
        return cg_u64toa(v);
    }
    let sgn: uint64 = top << 63;
    if (v >= sgn) { let z: uint64 = 0; return cg_cat("-", cg_u64toa(z - v)); }
    return cg_u64toa(v);
}

// (1<<bw)-1 as a uint64 (all ones when bw >= 64).
uint64 cg_bf_mask(int bw) {
    let one: uint64 = 1;
    if (bw >= 64) { let z: uint64 = 0; return z - one; }
    return (one << bw) - one;
}

// Address of a bitfield's storage word inside the struct at `baseptr`.
// Also the address of a normal field of a bitfield-layout struct: by byte offset under the
// C layout, else the struct element.
string cg_bf_wordptr(Codegen* g, string baseptr, string sname, CgBF slot) {
    string wa = cg_tmp(g);
    if (slot.boffs >= 0) {
        cg_emit(g, "  "); cg_emit(g, wa); cg_emit(g, " = getelementptr inbounds i8, ptr "); cg_emit(g, baseptr);
        cg_emit(g, ", i64 "); cg_emit(g, cg_itoa(slot.boffs)); cg_emit(g, "\n");
        return wa;
    }
    cg_emit(g, "  "); cg_emit(g, wa); cg_emit(g, " = getelementptr inbounds %"); cg_emit(g, sname);
    cg_emit(g, ", ptr "); cg_emit(g, baseptr); cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(slot.fidx)); cg_emit(g, "\n");
    return wa;
}

// Read a bitfield from its word: load, shift down, mask, and sign-extend if signed. The
// value is in the storage type (like the C++ codegen) and carries the field's Eskiu type.
// ` align N` for a word access that needs one ("" = natural).
string cg_bf_al(CgBF slot) {
    if (slot.aal > 0) { return cg_cat(", align ", cg_itoa(slot.aal)); }
    return "";
}

// A mask constant printed for an integer of `w` bits (wider than 64: unsigned decimal).
string cg_bf_const(uint64 v, int w) {
    if (w > 64) { return cg_u64toa(v); }
    return cg_iconst(v, w);
}

// Convert integer `op` of type `from` to `to` (zext or trunc; no-op when equal).
string cg_bf_resize(Codegen* g, string op, string from, string to) {
    int fw = cg_int_w(from); int tw = cg_int_w(to);
    if (fw == tw) { return op; }
    string t = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = ");
    if (fw > tw) { cg_emit(g, "trunc "); } else { cg_emit(g, "zext "); }
    cg_emit(g, from); cg_emit(g, " "); cg_emit(g, op); cg_emit(g, " to "); cg_emit(g, to); cg_emit(g, "\n");
    return t;
}

// Read a bitfield from its word: load (as the access type), shift down, mask, and
// sign-extend if signed. The value is in the storage type (like the C++ codegen) and
// carries the field's Eskiu type.
CgVal cg_bf_load(Codegen* g, string wa, CgBF slot) {
    let v: CgVal; v.ety = slot.fety;
    string st = slot.sty; int W = cg_int_w(st);
    string at = slot.aty;
    string w = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, w); cg_emit(g, " = load "); cg_emit(g, at); cg_emit(g, ", ptr "); cg_emit(g, wa); cg_emit(g, cg_bf_al(slot)); cg_emit(g, "\n");
    string sh = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, sh); cg_emit(g, " = lshr "); cg_emit(g, at); cg_emit(g, " "); cg_emit(g, w); cg_emit(g, ", "); cg_emit(g, cg_itoa(slot.boff)); cg_emit(g, "\n");
    string shs = cg_bf_resize(g, sh, at, st);
    string m = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, m); cg_emit(g, " = and "); cg_emit(g, st); cg_emit(g, " "); cg_emit(g, shs); cg_emit(g, ", "); cg_emit(g, cg_iconst(cg_bf_mask(slot.bw), W)); cg_emit(g, "\n");
    v.ty = st;
    if (slot.sgn == 1 && slot.bw < W) {               // sign-extend from bw bits
        string s1 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, s1); cg_emit(g, " = shl "); cg_emit(g, st); cg_emit(g, " "); cg_emit(g, m); cg_emit(g, ", "); cg_emit(g, cg_itoa(W - slot.bw)); cg_emit(g, "\n");
        string s2 = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, s2); cg_emit(g, " = ashr "); cg_emit(g, st); cg_emit(g, " "); cg_emit(g, s1); cg_emit(g, ", "); cg_emit(g, cg_itoa(W - slot.bw)); cg_emit(g, "\n");
        v.op = s2; return v;
    }
    v.op = m; return v;
}

// Write a bitfield into its word: load (as the access type), clear the field's bits, OR
// in the masked/shifted value. `rhsop` is already in the storage type (slot.sty).
void cg_bf_store(Codegen* g, string wa, CgBF slot, string rhsop) {
    string st = slot.sty; int W = cg_int_w(st);
    string at = slot.aty; int AW = cg_int_w(at);
    uint64 mask = cg_bf_mask(slot.bw);
    string w = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, w); cg_emit(g, " = load "); cg_emit(g, at); cg_emit(g, ", ptr "); cg_emit(g, wa); cg_emit(g, cg_bf_al(slot)); cg_emit(g, "\n");
    string fm = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, fm); cg_emit(g, " = shl "); cg_emit(g, at); cg_emit(g, " "); cg_emit(g, cg_bf_const(mask, AW)); cg_emit(g, ", "); cg_emit(g, cg_itoa(slot.boff)); cg_emit(g, "\n");
    string nfm = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, nfm); cg_emit(g, " = xor "); cg_emit(g, at); cg_emit(g, " "); cg_emit(g, fm); cg_emit(g, ", -1\n");
    string c = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, c); cg_emit(g, " = and "); cg_emit(g, at); cg_emit(g, " "); cg_emit(g, w); cg_emit(g, ", "); cg_emit(g, nfm); cg_emit(g, "\n");
    string vm = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, vm); cg_emit(g, " = and "); cg_emit(g, st); cg_emit(g, " "); cg_emit(g, rhsop); cg_emit(g, ", "); cg_emit(g, cg_iconst(mask, W)); cg_emit(g, "\n");
    string vma = cg_bf_resize(g, vm, st, at);
    string shv = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, shv); cg_emit(g, " = shl "); cg_emit(g, at); cg_emit(g, " "); cg_emit(g, vma); cg_emit(g, ", "); cg_emit(g, cg_itoa(slot.boff)); cg_emit(g, "\n");
    string nw = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, nw); cg_emit(g, " = or "); cg_emit(g, at); cg_emit(g, " "); cg_emit(g, c); cg_emit(g, ", "); cg_emit(g, shv); cg_emit(g, "\n");
    cg_emit(g, "  store "); cg_emit(g, at); cg_emit(g, " "); cg_emit(g, nw); cg_emit(g, ", ptr "); cg_emit(g, wa); cg_emit(g, cg_bf_al(slot)); cg_emit(g, "\n");
}

// The type a bitfield is read as: `int` when all its values fit an int (C promotion),
// else its declared type (mirrors CodeGen::bitfieldReadEskiu).
string cg_bf_read_ety(Codegen* g, CgBF slot) {
    if (cg_streq(ast_bf_read_type(cg_dealias(g, slot.fety), slot.bw), "int") == 1) { return "int"; }
    return slot.fety;
}

// A bitfield value in its storage type, converted to the type it is read as.
CgVal cg_bf_promote(Codegen* g, CgVal v, CgBF slot) {
    if (cg_streq(cg_bf_read_ety(g, slot), "int") == 0) { return v; }
    if (cg_streq(v.ty, "i32") == 0) {
        string t = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = trunc "); cg_emit(g, v.ty); cg_emit(g, " "); cg_emit(g, v.op); cg_emit(g, " to i32\n");
        v.op = t; v.ty = "i32";
    }
    v.ety = "int";
    return v;
}

CgVal cg_bf_read(Codegen* g, string baseptr, string sname, CgBF slot) {
    return cg_bf_promote(g, cg_bf_load(g, cg_bf_wordptr(g, baseptr, sname, slot), slot), slot);
}

void cg_bf_write(Codegen* g, string baseptr, string sname, CgBF slot, string rhsop) {
    cg_bf_store(g, cg_bf_wordptr(g, baseptr, sname, slot), slot, rhsop);
}

void cg_struct_init(Codegen* g, string slot, string sname0, *ExprNode e) {
    string sname = cg_dealias(g, sname0);                // `Alias{...}` of a struct alias fills the struct
    CgStruct s = cg_find_struct(g, sname);
    // Fields the literal omits are zero (C aggregate-initializer semantics), not whatever
    // the stack slot held: store the zero value first, then the given fields.
    cg_emit(g, "  store %"); cg_emit(g, s.name); cg_emit(g, " zeroinitializer, ptr "); cg_emit(g, slot); cg_emit(g, "\n");
    int n = List_len<*ExprNode>(&e.kids);
    int i = 0;
    while (i < n) {
        string fname = List_get<string>(&e.names, i);
        int idx = i;                                    // positional by default
        if (fname[0] != 0) { idx = cg_field_idx(&s, fname); }
        string fety = "";
        if (idx >= 0 && idx < List_len<string>(&s.fetys)) { fety = List_get<string>(&s.fetys, idx); }
        string actual = fname; if (actual[0] == 0 && idx >= 0 && idx < List_len<string>(&s.fnames)) { actual = List_get<string>(&s.fnames, idx); }
        *ExprNode fex = List_get<*ExprNode>(&e.kids, i);
        CgBF bfslot = cg_bf(g, sname, actual);
        if (fex.kind == EK_ARRAYLIT) {                  // an array field's `{...}` fills it in place
            string ap = slot;
            if (bfslot.boffs >= 0) { ap = cg_bf_wordptr(g, slot, s.name, bfslot); }
            else if (cg_is_union(g, s.name) == 0) {
                int aidx = idx; if (bfslot.fidx >= 0) { aidx = bfslot.fidx; }
                ap = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, ap); cg_emit(g, " = getelementptr inbounds %");
                cg_emit(g, s.name); cg_emit(g, ", ptr "); cg_emit(g, slot);
                cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(aidx)); cg_emit(g, "\n");
            }
            cg_array_init(g, ap, fety, fex, 1);
            i = i + 1; continue;
        }
        CgVal val = cg_expr(g, fex);
        if (bfslot.bw > 0) {                            // a bitfield member of this literal
            cg_bf_write(g, slot, s.name, bfslot, cg_coerce(g, val, bfslot.sty));
            i = i + 1; continue;
        }
        int gepidx = idx; if (bfslot.fidx >= 0) { gepidx = bfslot.fidx; }   // normal field in a bf struct
        string fp = "";
        if (bfslot.boffs >= 0) { fp = cg_bf_wordptr(g, slot, s.name, bfslot); }
        else if (cg_is_union(g, s.name) == 1) { fp = slot; }   // a union's members start at offset 0
        else {
            fp = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, fp); cg_emit(g, " = getelementptr inbounds %");
            cg_emit(g, s.name); cg_emit(g, ", ptr "); cg_emit(g, slot);
            cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(gepidx)); cg_emit(g, "\n");
        }
        string flty = cg_lltype(g, fety);
        string fop = cg_coerce(g, val, flty);   // hoist: cg_coerce emits its own instr — must not interleave the store line
        if (cg_is_iface(g, cg_dealias(g, fety)) == 1) { fop = cg_iface_conv(g, fety, val, fex); }
        cg_emit(g, "  store "); cg_emit(g, flty); cg_emit(g, " "); cg_emit(g, fop);
        cg_emit(g, ", ptr "); cg_emit(g, fp); cg_emit(g, "\n");
        i = i + 1;
    }
}

// Evaluate a condition to an i1 operand (compare-to-zero if it isn't already i1).
CgVal cg_cond_val(Codegen* g, CgVal c);
CgVal cg_cond(Codegen* g, *ExprNode e) { return cg_cond_val(g, cg_expr(g, e)); }
// The truth value (i1) of an already evaluated operand.
CgVal cg_cond_val(Codegen* g, CgVal c) {
    if (cg_streq(c.ty, "i1") == 1) { return c; }
    string t = cg_tmp(g);
    if (cg_is_float(c.ty) == 1) {                          // float truthiness: une 0.0 (NaN is true)
        cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = fcmp une "); cg_emit(g, c.ty);
        cg_emit(g, " "); cg_emit(g, c.op); cg_emit(g, ", 0.0\n");
        let rf: CgVal; rf.op = t; rf.ty = "i1"; return rf;
    }
    string zero = "0";
    if (cg_streq(c.ty, "ptr") == 1) { zero = "null"; }   // pointer truthiness vs null
    cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = icmp ne "); cg_emit(g, c.ty);
    cg_emit(g, " "); cg_emit(g, c.op); cg_emit(g, ", "); cg_emit(g, zero); cg_emit(g, "\n");
    let r: CgVal; r.op = t; r.ty = "i1"; return r;
}

// The static type name of a thrown value, used for catch-clause strcmp matching.
string cg_throw_typename(Codegen* g, *ExprNode e) {
    if (e != null && e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_STRING) { return "string"; }
        if (e.lit_kind == LIT_INT) { return "int"; }
        if (e.lit_kind == LIT_BOOL) { return "bool"; }
        if (e.lit_kind == LIT_CHAR) { return "char"; }
    }
    string t = cg_etype(g, e);
    if (t[0] == 0) { return "unknown"; }
    return t;
}

// The name a thrown value's type is matched by (a catch clause strcmp's it): the
// spelling under the active substitution, dealiased, without the `struct:` tag, a
// template instance mangled (`Box<int>` -> `Box_int`), and `int32` spelled `int`.
string cg_ex_typename(Codegen* g, string t) {
    t = cg_strip_nullable(t);
    t = cg_apply_sub(g, t);
    t = cg_dealias(g, t);
    int n = 0; while (t[n] != 0) { n = n + 1; }
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0; int i = 0; int angle = 0;
    while (i < n) {
        if (i + 7 <= n && cg_streq(cg_sub_str(t, i, i + 7), "struct:") == 1) { i = i + 7; continue; }
        if ((int)t[i] == 60) { angle = 1; }
        buf[o] = (uint8)t[i]; o = o + 1; i = i + 1;
    }
    buf[o] = 0;
    string r = (string)buf;
    if (angle == 1) { r = cg_mangle(r); }
    if (cg_streq(r, "int32") == 1) { return "int"; }
    if (cg_streq(r, "uint32") == 1) { return "uint"; }
    if (r[0] == 0) { return "unknown"; }
    return r;
}

// Map an LLVM scalar type back to its Eskiu type name, for naming a thrown
// value whose Eskiu type could not be resolved structurally (e.g. `throw c + 1`,
// where the binary result carries only its LLVM type). "" if no clean mapping.
string cg_llty_eskiu_name(string llty) {
    if (cg_streq(llty, "i1") == 1)     { return "bool"; }
    if (cg_streq(llty, "i8") == 1)     { return "char"; }
    if (cg_streq(llty, "i16") == 1)    { return "int16"; }
    if (cg_streq(llty, "i32") == 1)    { return "int"; }
    if (cg_streq(llty, "i64") == 1)    { return "int64"; }
    if (cg_streq(llty, "float") == 1)  { return "float"; }
    if (cg_streq(llty, "double") == 1) { return "double"; }
    return "";
}

// The C++ EH personality for the target: mingw's SEH one on Windows, else Itanium's
// (C++ CodeGen::ehPersonalityName).
string cg_eh_pers(Codegen* g) {
    if (g.wintgt == 1) { return "__gxx_personality_seh0"; }
    return "__gxx_personality_v0";
}

// Does a statement subtree contain a `try`? (→ the function needs an EH personality.)
// Kind-aware: only recurses into the nested-statement fields each kind populates (an
// unset field is null, not a real subtree, so reading it would be wrong). Doesn't descend
// into expressions.
int cg_has_try_s(*StmtNode s) {
    if (s == null) { return 0; }
    if (s.kind == SK_TRY) { return 1; }
    if (s.kind == SK_BLOCK || s.kind == SK_SWITCH || s.kind == SK_CASE
        || s.kind == SK_MATCH) {
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (cg_has_try_s(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
    }
    if (s.kind == SK_IF || s.kind == SK_WHILE || s.kind == SK_FOR || s.kind == SK_FORIN
        || s.kind == SK_ARM || s.kind == SK_CATCH || s.kind == SK_DEFER) {
        if (cg_has_try_s(s.s1) == 1) { return 1; }
    }
    if (s.kind == SK_IF || s.kind == SK_FOR) {
        if (cg_has_try_s(s.s2) == 1) { return 1; }
    }
    return 0;
}

// Emit a (possibly nested) array-literal initializer into `slot` of type `arrType`.
// `int[2][3] a = {{1,2,3},{4,5,6}}` recurses one dimension per `{...}` level; a short
// list zero-fills the rest. `do_zero` clears the whole aggregate once at the top level.
void cg_array_init(Codegen* g, string slot, string arrType0, *ExprNode lit, int do_zero) {
    string arrType = cg_dealias(g, arrType0);   // `type A3 = int[3]; A3 a = {...}`
    string ty = cg_lltype(g, arrType);
    string elemStr = cg_array_elem(arrType);
    string elemLl = cg_lltype(g, elemStr);
    int elemIsArr = cg_is_array(elemStr);
    if (do_zero == 1) {
        cg_emit(g, "  store "); cg_emit(g, ty); cg_emit(g, " zeroinitializer, ptr ");
        cg_emit(g, slot); cg_emit(g, "\n");
    }
    int i = 0; int n = List_len<*ExprNode>(&lit.kids);
    while (i < n) {
        *ExprNode el = List_get<*ExprNode>(&lit.kids, i);
        string gp = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, gp); cg_emit(g, " = getelementptr "); cg_emit(g, ty);
        cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(i)); cg_emit(g, "\n");
        if (elemIsArr == 1 && el.kind == EK_ARRAYLIT) {
            cg_array_init(g, gp, elemStr, el, 0);       // outer zeroinit already covers this row
        } else {
            CgVal ev = cg_expr(g, el);
            string eop = cg_coerce(g, ev, elemLl);
            if (cg_is_iface(g, cg_dealias(g, elemStr)) == 1) { eop = cg_iface_conv(g, elemStr, ev, el); }   // box `&s`
            cg_emit(g, "  store "); cg_emit(g, elemLl); cg_emit(g, " "); cg_emit(g, eop);
            cg_emit(g, ", ptr "); cg_emit(g, gp); cg_emit(g, "\n");
        }
        i = i + 1;
    }
}

// Enter/leave a loop: push (or pop) this loop's continue target, break target, and the
// cleanup-stack depth at entry, keeping the three parallel lists in sync. `break` and
// `continue` read the innermost (last) entry.
void cg_loop_push(Codegen* g, string cont, string end, string label) {
    List_push<string>(&g.loop_cont, cont);
    List_push<string>(&g.loop_end, end);
    List_push<int>(&g.loop_cldepth, List_len<*StmtNode>(&g.cleanups));
    // Mirror onto the loops-only stack for labeled break/continue.
    string lbl = label;
    if (lbl == null) { lbl = ""; }
    List_push<string>(&g.loop_lbls, lbl);
    List_push<string>(&g.loop_lbl_end, end);
    List_push<string>(&g.loop_lbl_cont, cont);
    List_push<int>(&g.loop_lbl_cld, List_len<*StmtNode>(&g.cleanups));
}
void cg_loop_pop(Codegen* g) {
    List_remove<string>(&g.loop_cont, List_len<string>(&g.loop_cont) - 1);
    List_remove<string>(&g.loop_end, List_len<string>(&g.loop_end) - 1);
    List_remove<int>(&g.loop_cldepth, List_len<int>(&g.loop_cldepth) - 1);
    List_remove<string>(&g.loop_lbls, List_len<string>(&g.loop_lbls) - 1);
    List_remove<string>(&g.loop_lbl_end, List_len<string>(&g.loop_lbl_end) - 1);
    List_remove<string>(&g.loop_lbl_cont, List_len<string>(&g.loop_lbl_cont) - 1);
    List_remove<int>(&g.loop_lbl_cld, List_len<int>(&g.loop_lbl_cld) - 1);
}

void cg_stmt(Codegen* g, *StmtNode st) {
    if (st == null) { return; }
    if (st.kind == SK_BLOCK) {
        int mark = List_len<*StmtNode>(&g.cleanups);   // this block's cleanup frame
        int lmark = List_len<CgLocal>(&g.locals);      // and its variable scope
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) {
            if (g.terminated == 1) { i = n; }          // rest of the block is unreachable
            else { cg_stmt(g, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        }
        if (g.terminated == 0) { cg_run_cleanups(g, mark, 0); }   // fall-through: defers only
        cg_cleanups_trunc(g, mark);
        cg_locals_trunc(g, lmark);
        return;
    }
    if (st.kind == SK_DEFER) {
        cg_push_cleanup(g, st.s1, st.is_err);          // emitted at scope exit; errdefer only on the error path
        if (g.prog_eh == 1 && st.is_err == 0) { cg_defer_pad(g); }   // and on the exceptional path
        return;
    }
    if (st.kind == SK_IF) {
        // An `else if` chain is emitted with a loop (mirrors CodeGen::visit(IfStmt)). Each
        // link's else body is a scope of its own (as cg_scoped_stmt makes it); those scopes
        // and the branches to each link's end label are closed innermost first.
        List<string> ends; List_init<string>(&ends, 2);
        List<int> marks; List_init<int>(&marks, 2);
        List<int> lmarks; List_init<int>(&lmarks, 2);
        *StmtNode n = st;
        while (n != null) {
            CgVal c = cg_cond(g, n.expr);
            string l_then = cg_lbl(g);
            string l_end = cg_lbl(g);
            string l_else = l_end;
            if (n.s2 != null) { l_else = cg_lbl(g); }
            cg_emit(g, "  br i1 "); cg_emit(g, c.op); cg_emit(g, ", label %"); cg_emit(g, l_then);
            cg_emit(g, ", label %"); cg_emit(g, l_else); cg_emit(g, "\n");
            g.terminated = 1;
            cg_label(g, l_then); cg_scoped_stmt(g, n.s1); cg_br(g, l_end);
            if (n.s2 != null && n.s2.kind == SK_IF) {
                cg_label(g, l_else);
                List_push<string>(&ends, l_end);
                List_push<int>(&marks, List_len<*StmtNode>(&g.cleanups));
                List_push<int>(&lmarks, List_len<CgLocal>(&g.locals));
                n = n.s2;
            } else {
                if (n.s2 != null) { cg_label(g, l_else); cg_scoped_stmt(g, n.s2); cg_br(g, l_end); }
                cg_label(g, l_end);
                n = null;
            }
        }
        int i = List_len<string>(&ends) - 1;
        while (i >= 0) {
            int mark = List_get<int>(&marks, i);
            if (g.terminated == 0) { cg_run_cleanups(g, mark, 0); }
            cg_cleanups_trunc(g, mark);
            cg_locals_trunc(g, List_get<int>(&lmarks, i));
            string l_end = List_get<string>(&ends, i);
            cg_br(g, l_end);
            cg_label(g, l_end);
            i = i - 1;
        }
        List_free<string>(&ends); List_free<int>(&marks); List_free<int>(&lmarks);
        return;
    }
    if (st.kind == SK_WHILE) {
        string l_cond = cg_lbl(g);
        string l_body = cg_lbl(g);
        string l_end = cg_lbl(g);
        cg_br(g, l_cond);
        cg_label(g, l_cond);
        CgVal c = cg_cond(g, st.expr);
        cg_emit(g, "  br i1 "); cg_emit(g, c.op); cg_emit(g, ", label %"); cg_emit(g, l_body);
        cg_emit(g, ", label %"); cg_emit(g, l_end); cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, l_body);
        cg_loop_push(g, l_cond, l_end, st.label);
        cg_scoped_stmt(g, st.s1);
        cg_loop_pop(g);
        cg_br(g, l_cond);
        cg_label(g, l_end);
        return;
    }
    if (st.kind == SK_DOWHILE) {
        string l_body = cg_lbl(g);
        string l_cond = cg_lbl(g);
        string l_end = cg_lbl(g);
        cg_br(g, l_body);
        cg_label(g, l_body);
        cg_loop_push(g, l_cond, l_end, st.label);       // `continue` re-tests the condition
        cg_scoped_stmt(g, st.s1);
        cg_loop_pop(g);
        cg_br(g, l_cond);
        cg_label(g, l_cond);
        CgVal c = cg_cond(g, st.expr);
        cg_emit(g, "  br i1 "); cg_emit(g, c.op); cg_emit(g, ", label %"); cg_emit(g, l_body);
        cg_emit(g, ", label %"); cg_emit(g, l_end); cg_emit(g, "\n");
        g.terminated = 1;
        cg_label(g, l_end);
        return;
    }
    if (st.kind == SK_FOR) {
        string l_cond = cg_lbl(g);
        string l_body = cg_lbl(g);
        string l_step = cg_lbl(g);
        string l_end = cg_lbl(g);
        // The init is scoped to the loop; its wrapping block's items are emitted in the
        // loop scope itself so the loop variable stays visible to cond/step/body.
        int lmark = List_len<CgLocal>(&g.locals);
        // `for (i in A..B)`: derive the bounds' common integer type here too. A generic
        // instance's shared AST carries the type sema stamped for SOME instance, and the
        // no-sema driver (cg_main) stamps none. An unknown bound keeps the sema stamp.
        if (st.s1 != null && st.s1.kind == SK_BLOCK && List_len<*StmtNode>(&st.s1.items) == 2) {
            *StmtNode rlo = List_get<*StmtNode>(&st.s1.items, 0);
            *StmtNode rhi = List_get<*StmtNode>(&st.s1.items, 1);
            if (rlo.is_range == 1 && rhi.is_range == 1) {
                string ct = ast_range_var_type(cg_range_bound_type(g, rlo.expr), cg_range_bound_type(g, rhi.expr));
                if (ct[0] != 0) { rlo.type = ct; rhi.type = ct; }
            }
        }
        if (st.s1 != null) {
            if (st.s1.kind == SK_BLOCK) {
                int ii = 0;
                while (ii < List_len<*StmtNode>(&st.s1.items)) { cg_stmt(g, List_get<*StmtNode>(&st.s1.items, ii)); ii = ii + 1; }
            } else { cg_stmt(g, st.s1); }
        }
        cg_br(g, l_cond);
        cg_label(g, l_cond);
        if (st.expr != null) {
            CgVal c = cg_cond(g, st.expr);
            cg_emit(g, "  br i1 "); cg_emit(g, c.op); cg_emit(g, ", label %"); cg_emit(g, l_body);
            cg_emit(g, ", label %"); cg_emit(g, l_end); cg_emit(g, "\n");
            g.terminated = 1;
        } else {
            cg_br(g, l_body);
        }
        cg_label(g, l_body);
        cg_loop_push(g, l_step, l_end, st.label);
        cg_scoped_stmt(g, st.s2);
        cg_loop_pop(g);
        cg_br(g, l_step);
        cg_label(g, l_step);
        if (st.expr2 != null) { cg_expr(g, st.expr2); }
        cg_br(g, l_cond);
        cg_label(g, l_end);
        cg_locals_trunc(g, lmark);
        return;
    }
    if (st.kind == SK_FORIN) {
        // `for (v in it)` has no direct IR form: desugar to a counted for over the
        // iterable's elements, then reuse the SK_FOR path (break/continue, defers). Array
        // `T[N]` → it[i], length N; slice `T[]` → it[i], length it.len; list-like struct →
        // it.data[i], length it.size. `it` is the real iterable expression, so a field
        // (`b.vals`) works, not just a bare identifier. (Async fns get this via async_lower;
        // this is the synchronous path.)
        string itty = cg_etype(g, st.expr);
        string fi = cg_cat("__fi", cg_itoa(g.lam_seq)); g.lam_seq = g.lam_seq + 1;
        *ExprNode lengthE = cgb_lit(LIT_INT, "0");
        *ExprNode elemE = cgb_lit(LIT_INT, "0");
        // The iterable is evaluated once. Anything but a stable place (a call, a variable
        // index) is held in a local: a list-like value that has an address by a pointer to
        // it, anything else (an array, a slice, a pointer, a returned value) by value.
        *ExprNode itE = st.expr;
        if (ast_stable_place(st.expr) == 0) {
            string itv = cg_cat(fi, "_v");
            if (cg_is_slice(itty) == 0 && cg_is_array(itty) == 0 && (int)itty[0] != 42 && cg_addressable(g, st.expr) == 1) {
                *ExprNode addr = alloc<ExprNode>(1); addr.kind = EK_UNARY; addr.sval = "&"; addr.a = st.expr;
                cg_stmt(g, cgb_vardecl(itv, cg_cat("*", itty), addr));
            } else {
                cg_stmt(g, cgb_vardecl(itv, itty, st.expr));
            }
            itE = cgb_ident(itv);
        }
        // A slice `T[]` also matches cg_is_array (both spell "T[...]"), so test slice first.
        if (cg_is_slice(itty) == 1) {
            lengthE = cgb_member(itE, "len");
            elemE = cgb_index(itE, cgb_ident(fi));
        } else if (cg_is_array(itty) == 1) {
            string cnt = cg_dim_val(g, cg_array_count(itty));
            lengthE = cgb_lit(LIT_INT, cnt);
            elemE = cgb_index(itE, cgb_ident(fi));
        } else {
            lengthE = cgb_member(itE, "size");
            elemE = cgb_index(cgb_member(itE, "data"), cgb_ident(fi));
        }
        string elemTy = st.resolved_elem;                 // sema-stamped element type (R1)
        if (elemTy[0] == 0) { elemTy = cg_etype(g, elemE); }   // fall back structurally (e.g. the no-sema path)
        *StmtNode initS = cgb_vardecl(fi, "int", cgb_lit(LIT_INT, "0"));
        *ExprNode cond = cgb_bin("<", cgb_ident(fi), lengthE);
        *ExprNode step = cgb_bin("=", cgb_ident(fi), cgb_bin("+", cgb_ident(fi), cgb_lit(LIT_INT, "1")));
        *StmtNode bodyS = cgb_block2(cgb_vardecl(st.name, elemTy, elemE), st.s1);
        *StmtNode forS = cgb_for(initS, cond, step, bodyS);
        forS.label = st.label;                            // carry the for-in's label onto the desugared loop
        cg_stmt(g, forS);
        return;
    }
    if (st.kind == SK_BREAK) {
        if (st.label != null && st.label[0] != 0) {
            // `break label`: scan the loops-only stack from innermost out for the named loop.
            int i = List_len<string>(&g.loop_lbls);
            while (i > 0) {
                i = i - 1;
                if (cg_streq(List_get<string>(&g.loop_lbls, i), st.label) == 1) {
                    cg_run_cleanups(g, List_get<int>(&g.loop_lbl_cld, i), 0);
                    cg_br(g, List_get<string>(&g.loop_lbl_end, i));
                    return;
                }
            }
            return;
        }
        int n = List_len<string>(&g.loop_end);
        if (n > 0) {
            cg_run_cleanups(g, List_get<int>(&g.loop_cldepth, n - 1), 0);   // run loop-body defers
            cg_br(g, List_get<string>(&g.loop_end, n - 1));
        }
        return;
    }
    if (st.kind == SK_CONTINUE) {
        if (st.label != null && st.label[0] != 0) {
            int i = List_len<string>(&g.loop_lbls);
            while (i > 0) {
                i = i - 1;
                if (cg_streq(List_get<string>(&g.loop_lbls, i), st.label) == 1) {
                    cg_run_cleanups(g, List_get<int>(&g.loop_lbl_cld, i), 0);
                    cg_br(g, List_get<string>(&g.loop_lbl_cont, i));
                    return;
                }
            }
            return;
        }
        // The innermost loop's depth comes from the loops-only stack: loop_cldepth also
        // holds an entry per enclosing `switch` (for break), so indexing it by the loop
        // count ran a switch case's defers on a `continue` of a loop inside that case.
        int n = List_len<string>(&g.loop_lbl_cont);
        if (n > 0) {
            cg_run_cleanups(g, List_get<int>(&g.loop_lbl_cld, n - 1), 0);
            cg_br(g, List_get<string>(&g.loop_lbl_cont, n - 1));
        }
        return;
    }
    if (st.kind == SK_VARDECL) {
        string ty = cg_lltype(g, st.type);
        if (st.is_static == 1) {
            // A `static` local: one instance at module scope, persists across calls.
            // Its storage is a private global; the slot is that global's pointer, so
            // ordinary load/store on the local read/write the persistent cell.
            string gname = cg_cat("@.static.", cg_itoa(g.strcount));
            g.strcount = g.strcount + 1;
            g.lam_expret = cg_lam_ret_of(st.type);  // thread fn-type return into a lambda init
            // Compute the initializer first (a string literal appends its constant to
            // g.globals; that must not land mid-line — see the module-global path).
            string sinit = cg_global_init_ty(g, st.expr, st.type);
            g.lam_expret = "";
            String_append(&g.globals, gname);
            String_append(&g.globals, " = internal global ");
            String_append(&g.globals, ty);
            String_append(&g.globals, " ");
            String_append(&g.globals, sinit);
            String_append(&g.globals, "\n");
            cg_add_local(g, st.name, gname, ty, cg_apply_sub(g, st.type));
            return;
        }
        string slot = cg_entry_alloca(g, ty);   // hoisted to the entry block, not re-run per loop iteration
        // The name is bound after its initializer: `{ int64 x = x + 1; }` reads the outer x.
        if (st.expr != null) {
            if (st.expr.kind == EK_ARRAYLIT) {          // { ... } (nested for T[N][M]) → zero-fill + store
                cg_array_init(g, slot, st.type, st.expr, 1);
            } else if (st.expr.kind == EK_STRUCTINIT) { // P { f: v, ... } → store fields via GEP
                cg_struct_init(g, slot, st.type, st.expr);
            } else {
                g.lam_expret = cg_lam_ret_of(st.type);   // thread fn-type return into a lambda init
                cg_hint_iface(g, st.expr, st.type);
                CgVal init = cg_expr(g, st.expr);
                g.lam_expret = "";
                string iop = cg_coerce(g, init, ty);    // widen/truncate/null-coerce to the declared type
                if (cg_is_iface(g, cg_dealias(g, st.type)) == 1) { iop = cg_iface_conv(g, st.type, init, st.expr); }
                cg_emit(g, "  store "); cg_emit(g, ty); cg_emit(g, " "); cg_emit(g, iop);
                cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
            }
        }
        cg_add_local(g, st.name, slot, ty, cg_apply_sub(g, st.type));
        return;
    }
    if (st.kind == SK_SWITCH) {
        // C-style fall-through: a `switch` instruction jumps to each case's block; a
        // block flows into the next unless its body terminates (break/return). `break`
        // targets the end (pushed onto loop_end). Case values must be constants.
        CgVal subj = cg_expr(g, st.expr);
        int nc = List_len<*StmtNode>(&st.items);
        List<string> labels; List_init<string>(&labels, nc);
        int di = 0 - 1;                                   // default case index, -1 if none
        int i = 0;
        while (i < nc) {
            List_push<string>(&labels, cg_lbl(g));
            if (List_get<*StmtNode>(&st.items, i).expr == null) { di = i; }
            i = i + 1;
        }
        string l_end = cg_lbl(g);
        string deflbl = l_end;
        if (di >= 0) { deflbl = List_get<string>(&labels, di); }
        cg_emit(g, "  switch "); cg_emit(g, subj.ty); cg_emit(g, " "); cg_emit(g, subj.op);
        cg_emit(g, ", label %"); cg_emit(g, deflbl); cg_emit(g, " [ ");
        i = 0;
        while (i < nc) {
            *StmtNode c = List_get<*StmtNode>(&st.items, i);
            if (c.expr != null) {
                // A constant label: fold it (`K`, `K + 10`, a top-level `const`), matching
                // the C++ back-end's constant folder.
                CgK ck = cg_cfold(g, c.expr);
                if (ck.ok == 0 || ck.isf == 1) { dprintf(2, "error: switch case value must be a constant integer\n"); exit(1); }
                cg_emit(g, subj.ty); cg_emit(g, " "); cg_emit(g, cg_k_text(ck, subj.ty));
                cg_emit(g, ", label %"); cg_emit(g, List_get<string>(&labels, i)); cg_emit(g, " ");
            }
            i = i + 1;
        }
        cg_emit(g, "]\n");
        g.terminated = 1;
        List_push<string>(&g.loop_end, l_end);
        List_push<int>(&g.loop_cldepth, List_len<*StmtNode>(&g.cleanups));            // break → end
        i = 0;
        while (i < nc) {
            cg_label(g, List_get<string>(&labels, i));
            *StmtNode c = List_get<*StmtNode>(&st.items, i);
            // Each case's statements are a scope: a `defer` there runs when the case body
            // is left (by `break`, or by falling through into the next case).
            int cmark = List_len<*StmtNode>(&g.cleanups);
            int clmark = List_len<CgLocal>(&g.locals);
            int bi = 0; int bn = List_len<*StmtNode>(&c.items);
            while (bi < bn) {
                if (g.terminated == 1) { bi = bn; }
                else { cg_stmt(g, List_get<*StmtNode>(&c.items, bi)); bi = bi + 1; }
            }
            if (g.terminated == 0) { cg_run_cleanups(g, cmark, 0); }
            cg_cleanups_trunc(g, cmark);
            cg_locals_trunc(g, clmark);
            if (i + 1 < nc) { cg_br(g, List_get<string>(&labels, i + 1)); }   // fall through
            else { cg_br(g, l_end); }
            i = i + 1;
        }
        List_remove<string>(&g.loop_end, List_len<string>(&g.loop_end) - 1);
        List_remove<int>(&g.loop_cldepth, List_len<int>(&g.loop_cldepth) - 1);
        cg_label(g, l_end);
        return;
    }
    if (st.kind == SK_MATCH) {
        // Classic (payload-less) enum: the subject is the enum's i32 value directly (not a
        // tagged struct). Switch on that value, one case per arm's variant CONSTANT (which
        // respects explicit `= N`). No tag read, no payload binding. `_` is the default.
        string m_sety = cg_etype(g, st.expr);
        string m_llty = cg_lltype(g, m_sety);
        string m_enm = m_llty;
        if ((int)m_llty[0] == 37) { int ml = 0; while (m_llty[ml] != 0) { ml = ml + 1; } m_enm = cg_sub_str(m_llty, 1, ml); }
        if (cg_is_adt(g, m_enm) == 0) {
            CgVal msubj = cg_expr(g, st.expr);
            int mn = List_len<*StmtNode>(&st.items);
            List<string> mlabels; List_init<string>(&mlabels, mn);
            int mdi = 0 - 1; int mi = 0;
            while (mi < mn) {
                List_push<string>(&mlabels, cg_lbl(g));
                if (cg_streq(cg_arm_var(List_get<*StmtNode>(&st.items, mi).name), "_") == 1) { mdi = mi; }
                mi = mi + 1;
            }
            string m_end = cg_lbl(g);
            string m_def = m_end; if (mdi >= 0) { m_def = List_get<string>(&mlabels, mdi); }
            cg_emit(g, "  switch i32 "); cg_emit(g, msubj.op); cg_emit(g, ", label %"); cg_emit(g, m_def); cg_emit(g, " [ ");
            mi = 0;
            while (mi < mn) {
                string mvn = cg_arm_var(List_get<*StmtNode>(&st.items, mi).name);
                if (cg_streq(mvn, "_") == 0) {
                    cg_emit(g, "i32 "); cg_emit(g, cg_enum_val(g, mvn));
                    cg_emit(g, ", label %"); cg_emit(g, List_get<string>(&mlabels, mi)); cg_emit(g, " ");
                }
                mi = mi + 1;
            }
            cg_emit(g, "]\n"); g.terminated = 1;
            mi = 0;
            while (mi < mn) {
                cg_label(g, List_get<string>(&mlabels, mi));
                cg_scoped_stmt(g, List_get<*StmtNode>(&st.items, mi).s1);
                cg_br(g, m_end);
                mi = mi + 1;
            }
            cg_label(g, m_end);
            return;
        }
        // Read the tag of the ADT subject, switch on it to per-arm blocks; each arm binds
        // its payload fields as locals, runs its body, then jumps to the end. A `_` arm is
        // the default. Arms don't fall through.
        CgVal lv = cg_lval(g, st.expr);
        string sptr = lv.op; string sety = lv.ety;
        if (sptr[0] == 0) {                               // rvalue subject — materialize
            CgVal val = cg_expr(g, st.expr);
            sety = val.ety;
            sptr = cg_entry_alloca(g, val.ty);
            cg_emit(g, "  store "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op);
            cg_emit(g, ", ptr "); cg_emit(g, sptr); cg_emit(g, "\n");
        }
        string llty = cg_lltype(g, sety);
        // The subject's (possibly mangled) enum name — disambiguates generic instances.
        string enm = llty; if ((int)llty[0] == 37) { int ll = 0; while (llty[ll] != 0) { ll = ll + 1; } enm = cg_sub_str(llty, 1, ll); }
        string tp = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, tp); cg_emit(g, " = getelementptr "); cg_emit(g, llty);
        cg_emit(g, ", ptr "); cg_emit(g, sptr); cg_emit(g, ", i32 0, i32 0\n");
        string tag = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, tag); cg_emit(g, " = load i32, ptr "); cg_emit(g, tp); cg_emit(g, "\n");

        int na = List_len<*StmtNode>(&st.items);
        List<string> alabels; List_init<string>(&alabels, na);
        int di = 0 - 1;
        int i = 0;
        while (i < na) {
            List_push<string>(&alabels, cg_lbl(g));
            if (cg_streq(cg_arm_var(List_get<*StmtNode>(&st.items, i).name), "_") == 1) { di = i; }
            i = i + 1;
        }
        string l_end = cg_lbl(g);
        string deflbl = l_end;
        if (di >= 0) { deflbl = List_get<string>(&alabels, di); }
        cg_emit(g, "  switch i32 "); cg_emit(g, tag); cg_emit(g, ", label %"); cg_emit(g, deflbl); cg_emit(g, " [ ");
        i = 0;
        while (i < na) {
            *StmtNode arm = List_get<*StmtNode>(&st.items, i);
            string vn = cg_arm_var(arm.name);
            if (cg_streq(vn, "_") == 0) {
                CgVariant var = cg_find_variant_in(g, vn, enm);
                cg_emit(g, "i32 "); cg_emit(g, cg_itoa(var.tag));
                cg_emit(g, ", label %"); cg_emit(g, List_get<string>(&alabels, i)); cg_emit(g, " ");
            }
            i = i + 1;
        }
        cg_emit(g, "]\n");
        g.terminated = 1;
        i = 0;
        while (i < na) {
            cg_label(g, List_get<string>(&alabels, i));
            *StmtNode arm = List_get<*StmtNode>(&st.items, i);
            string vn = cg_arm_var(arm.name);
            int lbase = List_len<CgLocal>(&g.locals);     // arm-scoped bindings
            CgVariant var = cg_find_variant_in(g, vn, enm);
            List<string> binds; List_init<string>(&binds, 2);
            cg_arm_binds(arm.name, &binds);
            int nb = List_len<string>(&binds);
            if (nb > 0 && var.ename[0] != 0) {
                string pstruct = cg_payload_lltype(g, &var);
                string pp = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, pp); cg_emit(g, " = getelementptr "); cg_emit(g, llty);
                cg_emit(g, ", ptr "); cg_emit(g, sptr); cg_emit(g, ", i32 0, i32 1\n");
                int j = 0;
                while (j < nb && j < List_len<string>(&var.ptys)) {
                    string fety = List_get<string>(&var.ptys, j);
                    string fty = cg_lltype(g, fety);
                    string fp = cg_tmp(g);
                    cg_emit(g, "  "); cg_emit(g, fp); cg_emit(g, " = getelementptr "); cg_emit(g, pstruct);
                    cg_emit(g, ", ptr "); cg_emit(g, pp); cg_emit(g, ", i32 0, i32 "); cg_emit(g, cg_itoa(j)); cg_emit(g, "\n");
                    string ld = cg_tmp(g);
                    cg_emit(g, "  "); cg_emit(g, ld); cg_emit(g, " = load "); cg_emit(g, fty); cg_emit(g, ", ptr "); cg_emit(g, fp); cg_emit(g, "\n");
                    string slot = cg_entry_alloca(g, fty);
                    cg_emit(g, "  store "); cg_emit(g, fty); cg_emit(g, " "); cg_emit(g, ld); cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
                    cg_add_local(g, List_get<string>(&binds, j), slot, fty, fety);
                    j = j + 1;
                }
            }
            cg_scoped_stmt(g, arm.s1);
            cg_br(g, l_end);
            while (List_len<CgLocal>(&g.locals) > lbase) { List_remove<CgLocal>(&g.locals, List_len<CgLocal>(&g.locals) - 1); }
            i = i + 1;
        }
        cg_label(g, l_end);
        return;
    }
    if (st.kind == SK_THROW) {
        // Itanium ABI: allocate an EskiuEx { [8 reserved], ptr type_name, payload } with
        // the thrown value stored by its own type at offset 16 (a double, an int64 or a
        // whole struct keep their bits), fill it, and __cxa_throw it (an invoke inside a
        // try so the landingpad catches it).
        g.uses_eh = 1;
        CgVal val = cg_expr(g, st.expr);
        string ex = cg_tmp(g);
        int psz = cg_ll_size_of(g, val.ty);
        cg_emit(g, "  "); cg_emit(g, ex); cg_emit(g, " = call ptr @__cxa_allocate_exception(i64 ");
        cg_emit(g, cg_itoa(16 + psz)); cg_emit(g, ")\n");
        string pslot = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, pslot); cg_emit(g, " = getelementptr i8, ptr "); cg_emit(g, ex); cg_emit(g, ", i64 16\n");
        cg_emit(g, "  store "); cg_emit(g, val.ty); cg_emit(g, " "); cg_emit(g, val.op); cg_emit(g, ", ptr "); cg_emit(g, pslot); cg_emit(g, "\n");
        string tname = cg_throw_typename(g, st.expr);
        if (cg_streq(tname, "unknown") == 1) {            // fall back to the value's LLVM type
            string mapped = cg_llty_eskiu_name(val.ty);
            if (cg_streq(mapped, "") == 0) { tname = mapped; }
        }
        tname = cg_ex_typename(g, tname);
        string tnameg = cg_string_global(g, tname);
        string tslot = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, tslot); cg_emit(g, " = getelementptr i8, ptr "); cg_emit(g, ex); cg_emit(g, ", i64 8\n");
        cg_emit(g, "  store ptr "); cg_emit(g, tnameg); cg_emit(g, ", ptr "); cg_emit(g, tslot); cg_emit(g, "\n");
        cg_emit_callish(g, "void", "@__cxa_throw", cg_cat("ptr ", cg_cat(ex, ", ptr @_ZTIPv, ptr null")), 1);
        cg_emit(g, "  unreachable\n");
        g.terminated = 1;
        return;
    }
    if (st.kind == SK_TRY) {
        // try body runs with calls turned into invokes (unwind → landingpad). The landingpad
        // catches everything, reads the exception's type name, and strcmp-matches each catch.
        g.uses_eh = 1;
        string lpad = cg_lbl(g);
        string ldone = cg_lbl(g);
        string ldisp = cg_lbl(g);
        string saved = g.cur_unwind;
        g.cur_unwind = lpad;
        // Register finally as a cleanup for the body's duration, so an early exit
        // (return/break/continue/`?`) inside the body runs it. Fall-through and the
        // exceptional path still emit it below, so truncate WITHOUT running here.
        int trymark = List_len<*StmtNode>(&g.cleanups);
        if (st.s2 != null) { cg_push_cleanup(g, st.s2, 0); }
        List_push<int>(&g.try_cld, List_len<*StmtNode>(&g.cleanups));   // body defers join ldisp
        List_push<string>(&g.try_disp, ldisp);
        List_push<string>(&g.try_phi, "");
        cg_stmt(g, st.s1);                                // try body
        int ntry = List_len<int>(&g.try_cld) - 1;
        string phi_extra = List_get<string>(&g.try_phi, ntry);
        List_remove<int>(&g.try_cld, ntry);
        List_remove<string>(&g.try_disp, ntry);
        List_remove<string>(&g.try_phi, ntry);
        cg_cleanups_trunc(g, trymark);
        g.cur_unwind = saved;
        cg_br(g, ldone);
        cg_label(g, lpad);
        string lp = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, lp); cg_emit(g, " = landingpad { ptr, i32 } catch ptr null\n");
        string exptr = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, exptr); cg_emit(g, " = extractvalue { ptr, i32 } "); cg_emit(g, lp); cg_emit(g, ", 0\n");
        cg_emit(g, "  br label %"); cg_emit(g, ldisp); cg_emit(g, "\n");
        cg_label(g, ldisp);                               // catch dispatch (landingpad or a body defer's pad)
        if (phi_extra[0] != 0) {
            string exphi = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, exphi); cg_emit(g, " = phi ptr [ "); cg_emit(g, exptr); cg_emit(g, ", %");
            cg_emit(g, lpad); cg_emit(g, " ]"); cg_emit(g, phi_extra); cg_emit(g, "\n");
            exptr = exphi;
        }
        string exdata = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, exdata); cg_emit(g, " = call ptr @__cxa_begin_catch(ptr "); cg_emit(g, exptr); cg_emit(g, ")\n");
        string ets = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, ets); cg_emit(g, " = getelementptr i8, ptr "); cg_emit(g, exdata); cg_emit(g, ", i64 8\n");
        string extype = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, extype); cg_emit(g, " = load ptr, ptr "); cg_emit(g, ets); cg_emit(g, "\n");
        int ci = 0; int cn = List_len<*StmtNode>(&st.items);
        while (ci < cn) {
            *StmtNode c = List_get<*StmtNode>(&st.items, ci);
            string ctype = cg_drop_last_word(c.name);
            string cname = cg_last_word(c.name);
            string ctg = cg_string_global(g, cg_ex_typename(g, ctype));
            string cmp = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, cmp); cg_emit(g, " = call i32 @strcmp(ptr "); cg_emit(g, extype); cg_emit(g, ", ptr "); cg_emit(g, ctg); cg_emit(g, ")\n");
            string m = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, m); cg_emit(g, " = icmp eq i32 "); cg_emit(g, cmp); cg_emit(g, ", 0\n");
            string hbl = cg_lbl(g); string nbl = cg_lbl(g);
            cg_emit(g, "  br i1 "); cg_emit(g, m); cg_emit(g, ", label %"); cg_emit(g, hbl); cg_emit(g, ", label %"); cg_emit(g, nbl); cg_emit(g, "\n");
            g.terminated = 1;
            cg_label(g, hbl);
            int lbase = List_len<CgLocal>(&g.locals);
            string cty = cg_lltype(g, ctype);
            string cps = cg_tmp(g);                        // the payload, by the catch type
            cg_emit(g, "  "); cg_emit(g, cps); cg_emit(g, " = getelementptr i8, ptr "); cg_emit(g, exdata); cg_emit(g, ", i64 16\n");
            string cv = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, cv); cg_emit(g, " = load "); cg_emit(g, cty); cg_emit(g, ", ptr "); cg_emit(g, cps); cg_emit(g, "\n");
            string cslot = cg_entry_alloca(g, cty);
            cg_emit(g, "  store "); cg_emit(g, cty); cg_emit(g, " "); cg_emit(g, cv); cg_emit(g, ", ptr "); cg_emit(g, cslot); cg_emit(g, "\n");
            cg_add_local(g, cname, cslot, cty, ctype);
            cg_emit(g, "  call void @__cxa_end_catch()\n");
            // `finally` also runs when the handler leaves early (return/break/continue).
            int cmark = List_len<*StmtNode>(&g.cleanups);
            // A throw out of the handler runs it too (then the new exception propagates).
            if (st.s2 != null) { cg_push_cleanup(g, st.s2, 0); cg_defer_pad(g); }
            cg_stmt(g, c.s1);                             // handler body
            cg_cleanups_trunc(g, cmark);
            cg_br(g, ldone);
            while (List_len<CgLocal>(&g.locals) > lbase) { List_remove<CgLocal>(&g.locals, List_len<CgLocal>(&g.locals) - 1); }
            cg_label(g, nbl);
            ci = ci + 1;
        }
        // No catch clause matched: run finally on the exceptional path, then
        // re-raise the in-flight exception (do NOT swallow it). __cxa_rethrow is
        // an invoke to the enclosing landingpad when inside another try, else a call.
        if (st.s2 != null) { cg_stmt(g, st.s2); }          // finally (exceptional path)
        if (saved[0] != 0) {
            string ru = cg_lbl(g);
            cg_emit(g, "  invoke void @__cxa_rethrow() to label %"); cg_emit(g, ru);
            cg_emit(g, " unwind label %"); cg_emit(g, saved); cg_emit(g, "\n");
            cg_label(g, ru);
            cg_emit(g, "  unreachable\n");
        } else {
            cg_emit(g, "  call void @__cxa_rethrow()\n");
            cg_emit(g, "  unreachable\n");
        }
        g.terminated = 1;
        cg_label(g, ldone);
        if (st.s2 != null) { cg_stmt(g, st.s2); }          // finally (normal / handled path)
        return;
    }
    if (st.kind == SK_RETURN) {
        if (st.expr != null) {
            cg_hint_iface(g, st.expr, g.cur_rety);
            CgVal r = cg_expr(g, st.expr);
            string rop = cg_coerce(g, r, g.cur_ret);     // widen/convert to the return type (bool→int, etc.)
            if (cg_is_iface(g, cg_dealias(g, g.cur_rety)) == 1) { rop = cg_iface_conv(g, g.cur_rety, r, st.expr); }
            cg_run_cleanups(g, 0, 0);                     // normal exit: defers/finally, not errdefer
            cg_emit(g, "  ret "); cg_emit(g, g.cur_ret); cg_emit(g, " "); cg_emit(g, rop); cg_emit(g, "\n");
        } else {
            cg_run_cleanups(g, 0, 0);
            cg_emit(g, "  ret void\n");
        }
        g.terminated = 1;
        return;
    }
    if (st.kind == SK_THREADJOIN) {
        // thread_join(t) → pthread_join(t, null)
        string tid = cg_expr(g, st.expr).op;
        cg_ensure_extern(g, "pthread_join", "declare i32 @pthread_join(ptr, ptr)\n");
        cg_emit(g, "  call i32 @pthread_join(ptr "); cg_emit(g, tid); cg_emit(g, ", ptr null)\n");
        return;
    }
    if (st.kind == SK_EXPR) { cg_expr(g, st.expr); return; }
}

// Emit a function definition under LLVM name `llname`. When `self_struct` is non-empty
// the function is a method: a leading `ptr %p0` self parameter (bound to `self`, a
// pointer to the struct) precedes the declared params.
void cg_emit_fn(Codegen* g, *DeclNode d, string llname, string self_struct) {
    if (d.body == null) { return; }
    string rt = cg_lltype(g, d.ret_type);
    g.cur_ret = rt;
    g.cur_rety = cg_apply_sub(g, d.ret_type);
    List_init<CgLocal>(&g.locals, 8);
    List_init<*StmtNode>(&g.cleanups, 4);   // fresh scope-exit state per function body
    List_init<int>(&g.cl_err, 4);
    List_init<int>(&g.cl_nloc, 4);
    List_init<string>(&g.cl_unw, 4);
    List_init<int>(&g.try_cld, 4);
    List_init<string>(&g.try_disp, 4);
    List_init<string>(&g.try_phi, 4);
    g.cur_unwind = "";
    g.cur_lbl = "entry";
    List_init<int>(&g.loop_cldepth, 4);
    List_init<string>(&g.loop_lbls, 4);       // fresh loops-only label stack per function body
    List_init<string>(&g.loop_lbl_end, 4);
    List_init<string>(&g.loop_lbl_cont, 4);
    List_init<int>(&g.loop_lbl_cld, 4);
    g.terminated = 0;
    int base = 0;
    if (self_struct[0] != 0) { base = 1; }

    cg_emit(g, "define "); cg_emit(g, rt); cg_emit(g, " @"); cg_emit(g, llname); cg_emit(g, "(");
    if (base == 1) { cg_emit(g, "ptr %p0"); }
    int np = List_len<Param>(&d.params);
    int pi = 0;
    while (pi < np) {
        Param pm = List_get<Param>(&d.params, pi);
        if (pi + base > 0) { cg_emit(g, ", "); }
        if (cg_streq(pm.ty, "...") == 1) { cg_emit(g, "..."); }   // user-defined variadic
        else { cg_emit(g, cg_lltype(g, pm.ty)); cg_emit(g, " %p"); cg_emit(g, cg_itoa(pi + base)); }
        pi = pi + 1;
    }
    cg_emit(g, ")");
    if (cg_has_try_s(d.body) == 1 || g.prog_eh == 1) { cg_emit(g, " personality ptr @"); cg_emit(g, cg_eh_pers(g)); g.uses_eh = 1; }
    cg_emit(g, " {\n");
    // Emit the body into a fresh buffer while `alloca`s accumulate in entry_buf, then
    // assemble `entry:` + hoisted allocas + body. This keeps loop-body locals from
    // allocating every iteration (which overflows the stack on a long loop).
    String_init(&g.entry_buf, 128);
    String saved = g.out;
    String_init(&g.out, 512);

    if (base == 1) {                                    // spill self (a pointer to the struct)
        string sslot = cg_entry_alloca(g, "ptr");
        cg_emit(g, "  store ptr %p0, ptr "); cg_emit(g, sslot); cg_emit(g, "\n");
        cg_add_local(g, "self", sslot, "ptr", cg_cat("*", self_struct));
    }
    pi = 0;
    while (pi < np) {
        Param pm = List_get<Param>(&d.params, pi);
        if (cg_streq(pm.ty, "...") == 1) { pi = pi + 1; continue; }   // variadic marker: no slot
        string pty = cg_lltype(g, pm.ty);
        string slot = cg_entry_alloca(g, pty);
        cg_emit(g, "  store "); cg_emit(g, pty); cg_emit(g, " %p"); cg_emit(g, cg_itoa(pi + base));
        cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
        cg_add_local(g, pm.name, slot, pty, cg_apply_sub(g, pm.ty));
        pi = pi + 1;
    }

    cg_stmt(g, d.body);
    if (g.terminated == 0) {
        if (cg_streq(rt, "void") == 1) { cg_emit(g, "  ret void\n"); }
        else { cg_emit(g, "  unreachable\n"); }
    }
    // Assemble: entry: label, hoisted allocas, then the body; restore the module buffer.
    string bodytext = (string)String_cstr(&g.out);
    g.out = saved;
    cg_emit(g, "entry:\n");
    cg_emit(g, (string)String_cstr(&g.entry_buf));
    cg_emit(g, bodytext);
    cg_emit(g, "}\n\n");
}

void cg_decl(Codegen* g, *DeclNode d) {
    if (List_len<TypeParam>(&d.type_params) > 0) { return; }   // generic — emitted on demand
    if (d.kind == DK_FUNCTION) { cg_emit_fn(g, d, d.name, ""); return; }
    if (d.kind == DK_STRUCT) {                          // emit the struct's methods
        int i = 0;
        int n = List_len<*DeclNode>(&d.methods);
        while (i < n) {
            *DeclNode m = List_get<*DeclNode>(&d.methods, i);
            cg_emit_fn(g, m, cg_cat(cg_cat(d.name, "_"), m.name), d.name);
            i = i + 1;
        }
        return;
    }
}

// Emit a queued lambda as a top-level function `@__lambdaN(ptr %p0_env, params...)`:
// unpack captures from the env, bind params, emit the body. Mirrors cg_emit_fn.
void cg_emit_lambda(Codegen* g, CgLambda lam) {
    List_init<CgLocal>(&g.locals, 8);
    g.terminated = 0;
    List<CgSub> oldsub = g.cursub;                         // restore the substitution live where this lambda was written
    g.cursub = lam.sub;                                    // so type-params in the body (Pair<A,B> → Pair<int,int>) resolve
    string rt = cg_lltype(g, lam.rety);                    // resolved return type (context or written)
    g.cur_ret = rt;
    g.cur_rety = lam.rety;
    List<string> pp; List_init<string>(&pp, 4); cg_paren_list(lam.node.sval, &pp);
    cg_emit(g, "define "); cg_emit(g, rt); cg_emit(g, " @"); cg_emit(g, lam.name); cg_emit(g, "(ptr %p0");
    int k = 0; int np = List_len<string>(&pp);
    while (k < np) {
        cg_emit(g, ", "); cg_emit(g, cg_lltype(g, cg_drop_last_word(List_get<string>(&pp, k))));
        cg_emit(g, " %p"); cg_emit(g, cg_itoa(k + 1));
        k = k + 1;
    }
    cg_emit(g, ")");
    // A `try` in the lambda body lands in a landingpad, which needs a personality here too
    // (and in a program that throws, so does any defer's landingpad).
    if (cg_has_try_s(lam.node.stmt) == 1 || g.prog_eh == 1) { cg_emit(g, " personality ptr @"); cg_emit(g, cg_eh_pers(g)); g.uses_eh = 1; }
    cg_emit(g, " {\n");
    g.cur_lbl = "entry";
    String_init(&g.entry_buf, 128);            // hoist body allocas to the entry block (see cg_emit_fn)
    String saved = g.out;
    String_init(&g.out, 512);
    int si = 0;                                            // static locals: the same global cell
    while (si < List_len<CgLocal>(&lam.statics)) { List_push<CgLocal>(&g.locals, List_get<CgLocal>(&lam.statics, si)); si = si + 1; }
    int nc = List_len<string>(&lam.capn);
    if (nc > 0) {                                          // unpack captures from %p0 (env)
        string envty = cg_env_lltype(g, &lam.capt);
        int j = 0;
        while (j < nc) {
            string fety = List_get<string>(&lam.capt, j);
            string fty = cg_lltype(g, fety);
            string fp = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, fp); cg_emit(g, " = getelementptr "); cg_emit(g, envty); cg_emit(g, ", ptr %p0, i32 0, i32 "); cg_emit(g, cg_itoa(j)); cg_emit(g, "\n");
            string ld = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, ld); cg_emit(g, " = load "); cg_emit(g, fty); cg_emit(g, ", ptr "); cg_emit(g, fp); cg_emit(g, "\n");
            string slot = cg_entry_alloca(g, fty);
            cg_emit(g, "  store "); cg_emit(g, fty); cg_emit(g, " "); cg_emit(g, ld); cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
            cg_add_local(g, List_get<string>(&lam.capn, j), slot, fty, fety);
            j = j + 1;
        }
    }
    k = 0;
    while (k < np) {                                       // spill params (at %p1..)
        string piece = List_get<string>(&pp, k);
        string pname = cg_last_word(piece);
        string pety = cg_drop_last_word(piece);
        string pty = cg_lltype(g, pety);
        string slot = cg_entry_alloca(g, pty);
        cg_emit(g, "  store "); cg_emit(g, pty); cg_emit(g, " %p"); cg_emit(g, cg_itoa(k + 1));
        cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
        cg_add_local(g, pname, slot, pty, pety);
        k = k + 1;
    }
    cg_stmt(g, lam.node.stmt);
    if (g.terminated == 0) {
        if (cg_streq(rt, "void") == 1) { cg_emit(g, "  ret void\n"); } else { cg_emit(g, "  unreachable\n"); }
    }
    string bodytext = (string)String_cstr(&g.out);
    g.out = saved;
    cg_emit(g, "entry:\n");
    cg_emit(g, (string)String_cstr(&g.entry_buf));
    cg_emit(g, bodytext);
    cg_emit(g, "}\n\n");
    g.cursub = oldsub;
}

void cg_drain_lambdas(Codegen* g) {
    while (g.lam_i < List_len<CgLambda>(&g.lambdas)) {
        cg_emit_lambda(g, List_get<CgLambda>(&g.lambdas, g.lam_i));
        g.lam_i = g.lam_i + 1;
    }
}

// Does a struct decl have any bitfield member (a `: width` field)?
int cg_struct_has_bf(*DeclNode d) {
    int i = 0; int n = List_len<int>(&d.field_bits);
    while (i < n) { if (List_get<int>(&d.field_bits, i) > 0) { return 1; } i = i + 1; }
    return 0;
}

// Is `t` an unsigned-base type (→ bitfield read zero-extends, not sign-extends)?
int cg_is_unsigned(string t) {
    return cg_streq(t, "uint") == 1 || cg_streq(t, "uint8") == 1 || cg_streq(t, "uint16") == 1
        || cg_streq(t, "uint32") == 1 || cg_streq(t, "uint64") == 1 || cg_streq(t, "bool") == 1
        || cg_streq(t, "char") == 1;
}

// The bitfield slot for `sname.fname` (sentinel .fidx == -1 if not registered).
CgBF cg_bf(Codegen* g, string sname, string fname) {
    int i = 0; int n = List_len<CgBF>(&g.bitfields);
    while (i < n) {
        CgBF b = List_get<CgBF>(&g.bitfields, i);
        if (cg_streq(b.sname, sname) == 1 && cg_streq(b.fname, fname) == 1) { return b; }
        i = i + 1;
    }
    let none: CgBF; none.sname = sname; none.fname = fname; none.fidx = 0 - 1; none.boff = 0; none.bw = 0; none.sgn = 0;
    none.sty = "i32"; none.fety = ""; none.boffs = 0 - 1; none.aty = "i32"; none.aal = 0;
    return none;
}
int cg_is_bf_struct(Codegen* g, string sname) {
    int i = 0; int n = List_len<CgBF>(&g.bitfields);
    while (i < n) { if (cg_streq(List_get<CgBF>(&g.bitfields, i).sname, sname) == 1) { return 1; } i = i + 1; }
    return 0;
}

void cg_bf_layout_ms(Codegen* g, *DeclNode d);   // fwd: the Windows (MS) rules
int cg_ll_align_of(Codegen* g, string t);         // fwd
int cg_ll_size_of(Codegen* g, string t);          // fwd

// A byte range [off, end) of a bitfield struct: a storage unit (ty = its integer type,
// "" = a packed byte run) or a normal field (ty = its LLVM type, "" = a byte filler).
struct CgSpan { int off; int end; string ty; }

void cg_span_insert(List<CgSpan>* l, CgSpan s, int bigfirst) {   // keep sorted by offset
    List_push<CgSpan>(l, s);
    int i = List_len<CgSpan>(l) - 1;
    while (i > 0) {
        CgSpan p = List_get<CgSpan>(l, i - 1);
        int before = 0;
        if (s.off < p.off) { before = 1; }
        if (bigfirst == 1 && s.off == p.off && s.end > p.end) { before = 1; }
        if (before == 0) { break; }
        List_set<CgSpan>(l, i, p);
        i = i - 1;
    }
    List_set<CgSpan>(l, i, s);
}

string cg_bytes_ty(int n) { return cg_cat("[", cg_cat(cg_itoa(n), " x i8]")); }

// Lay out a struct with bitfields like C on the target (CodeGen::layoutBitfieldStruct):
// the MS rules on Windows, else SysV/AAPCS (clang's Itanium layout): a bitfield takes the
// next free bit unless it would cross a boundary of its declared type's storage unit,
// then it starts at that boundary; a packed struct (or #pragma pack) packs bitfields
// back to back; a normal field starts at the next byte, aligned. Every field is then
// addressed by byte offset (slot.boffs); the emitted `%S = type` only has to reproduce
// the C size and alignment: each maximal storage unit as an integer of its type, the
// normal fields outside the units as themselves, and `[n x i8]` for the other bytes.
void cg_bf_layout(Codegen* g, *DeclNode d) {
    if (g.msbf == 1) { cg_bf_layout_ms(g, d); return; }
    int nf = List_len<Param>(&d.params);
    int contig = 0; int cap = 0;
    if (d.is_packed == 1) { contig = 1; cap = 1; }
    else if (d.pack_align >= 2) { contig = 1; cap = d.pack_align; }
    List<CgSpan> units; List_init<CgSpan>(&units, 8);
    List<CgSpan> normals; List_init<CgSpan>(&normals, 8);
    int bitpos = 0; int salign = 1;
    int i = 0;
    while (i < nf) {
        Param pm = List_get<Param>(&d.params, i);
        int bw = List_get<int>(&d.field_bits, i);
        string lty = cg_lltype(g, pm.ty);
        int size = cg_size(g, pm.ty);
        int nal = cg_align(g, pm.ty);
        int al = nal; if (cap > 0 && al > cap) { al = cap; }
        if (al > salign) { salign = al; }
        let slot: CgBF; slot.sname = d.name; slot.fname = pm.name; slot.fety = pm.ty;
        slot.fidx = 0; slot.sty = lty; slot.aal = 0; slot.aty = lty; slot.boff = 0; slot.bw = 0; slot.sgn = 0;
        if (bw > 0) {
            slot.bw = bw;
            // Signed unless the type is unsigned or an enum with no negative member (as clang).
            string fdt = cg_dealias(g, pm.ty);
            if (cg_is_unsigned(fdt) == 0 && cg_in_strlist(&g.enum_uns, fdt) == 0) { slot.sgn = 1; }
            if (contig == 1) {
                slot.boffs = bitpos / 8; slot.boff = bitpos % 8;
                int span = (slot.boff + bw + 7) / 8;
                slot.aty = cg_cat("i", cg_itoa(span * 8)); slot.aal = 1;
                let u: CgSpan; u.off = slot.boffs; u.end = slot.boffs + span; u.ty = "";
                cg_span_insert(&units, u, 1);
            } else {
                int ub = size * 8;
                if (bitpos / ub != (bitpos + bw - 1) / ub) { bitpos = cg_align_up(bitpos, ub); }
                slot.boffs = bitpos / ub * size; slot.boff = bitpos - slot.boffs * 8;
                slot.aal = nal;
                // A bool bitfield is read and written as its byte (the value is i1).
                if (cg_streq(lty, "i1") == 1) { slot.aty = "i8"; }
                let u: CgSpan; u.off = slot.boffs; u.end = slot.boffs + size; u.ty = slot.aty;
                cg_span_insert(&units, u, 1);
            }
            bitpos = bitpos + bw;
        } else {
            int off = cg_align_up((bitpos + 7) / 8, al);
            slot.boffs = off;
            let nsp: CgSpan; nsp.off = off; nsp.end = off + size; nsp.ty = lty;
            List_push<CgSpan>(&normals, nsp);
            bitpos = (off + size) * 8;
        }
        List_push<CgBF>(&g.bitfields, slot);
        i = i + 1;
    }
    int total = cg_align_up((bitpos + 7) / 8, salign);
    // Maximal storage units (aligned power-of-two units nest or are disjoint; a packed
    // struct's overlapping byte runs merge).
    List<CgSpan> store; List_init<CgSpan>(&store, 8);
    i = 0;
    while (i < List_len<CgSpan>(&units)) {
        CgSpan u = List_get<CgSpan>(&units, i);
        int n = List_len<CgSpan>(&store);
        if (n > 0 && u.off < List_get<CgSpan>(&store, n - 1).end) {
            if (contig == 1) {
                CgSpan last = List_get<CgSpan>(&store, n - 1);
                if (u.end > last.end) { last.end = u.end; List_set<CgSpan>(&store, n - 1, last); }
            }
        } else { List_push<CgSpan>(&store, u); }
        i = i + 1;
    }
    List<CgSpan> elems; List_init<CgSpan>(&elems, 8);
    i = 0;
    while (i < List_len<CgSpan>(&store)) { cg_span_insert(&elems, List_get<CgSpan>(&store, i), 0); i = i + 1; }
    i = 0;
    while (i < List_len<CgSpan>(&normals)) {
        CgSpan nsp = List_get<CgSpan>(&normals, i);
        int o = nsp.off; int overlap = 0;
        int j = 0;
        while (j < List_len<CgSpan>(&store)) {
            CgSpan u = List_get<CgSpan>(&store, j);
            if (u.end > o && u.off < nsp.end) {
                overlap = 1;
                if (u.off > o) { let pc: CgSpan; pc.off = o; pc.end = u.off; pc.ty = ""; cg_span_insert(&elems, pc, 0); }
                if (u.end > o) { o = u.end; }
            }
            j = j + 1;
        }
        if (overlap == 0) { cg_span_insert(&elems, nsp, 0); }
        else if (o < nsp.end) { let rest: CgSpan; rest.off = o; rest.end = nsp.end; rest.ty = ""; cg_span_insert(&elems, rest, 0); }
        i = i + 1;
    }
    String body; String_init(&body, 32);
    int cur = 0;
    i = 0;
    while (i < List_len<CgSpan>(&elems)) {
        CgSpan e = List_get<CgSpan>(&elems, i);
        string t = e.ty; if (t[0] == 0) { t = cg_bytes_ty(e.end - e.off); }
        int a = 1; if (contig == 0) { a = cg_ll_align_of(g, t); }
        if (cg_align_up(cur, a) < e.off) {
            if (String_len(&body) > 0) { String_append(&body, ", "); }
            String_append(&body, cg_bytes_ty(e.off - cur));
        }
        if (String_len(&body) > 0) { String_append(&body, ", "); }
        String_append(&body, t);
        cur = e.end;
        i = i + 1;
    }
    if (contig == 1 && cur < total) {
        if (String_len(&body) > 0) { String_append(&body, ", "); }
        String_append(&body, cg_bytes_ty(total - cur));
    }
    string op = "{ "; string cl = " }";
    if (contig == 1) { op = "<{ "; cl = " }>"; }
    cg_deftype(g, d.name, cg_cat(op, cg_cat((string)String_cstr(&body), cl)));
}

// Append element `t` to an MS-layout struct body; returns its LLVM index. Under
// #pragma pack(N>=2) (packn) it is placed by hand at alignment min(align, N), with a
// `[k x i8]` filler before it, tracking the byte offset and the struct alignment.
int cg_ms_elem(Codegen* g, String* body, int* count, int* off, int* salign, int packn, string t) {
    if (packn >= 2) {
        int a = cg_ll_align_of(g, t); if (a > packn) { a = packn; }
        if (a > salign[0]) { salign[0] = a; }
        int at = cg_align_up(off[0], a);
        if (at > off[0]) {
            if (count[0] > 0) { String_append(body, ", "); }
            String_append(body, cg_bytes_ty(at - off[0]));
            count[0] = count[0] + 1;
        }
        off[0] = at + cg_ll_size_of(g, t);
    }
    if (count[0] > 0) { String_append(body, ", "); }
    String_append(body, t);
    count[0] = count[0] + 1;
    return count[0] - 1;
}

// The MS layout (Windows targets): consecutive bitfields pack into storage words of their
// declared type (uint8 → i8, uint64 → i64); a new word opens when the declared width
// changes or the next field won't fit. A normal field closes the word and gets its own
// slot. Registers a slot per field (word index + bit offset/width, or a plain index for a
// normal field) and emits `%S = type { … }` (`<{ … }>` when packed or under pack(N)).
void cg_bf_layout_ms(Codegen* g, *DeclNode d) {
    String body; String_init(&body, 32);
    int nf = List_len<Param>(&d.params);
    int packn = 0; if (d.is_packed == 0) { packn = d.pack_align; }
    int llcount = 0;          // number of LLVM fields emitted so far
    int off = 0; int salign = 1;
    int curword = 0 - 1;      // open bitfield word's LLVM index (-1 = none)
    int curbits = 0;          // open word's width in bits
    int curoff = 0;
    int i = 0;
    while (i < nf) {
        Param pm = List_get<Param>(&d.params, i);
        int bw = List_get<int>(&d.field_bits, i);
        let slot: CgBF; slot.sname = d.name; slot.fname = pm.name; slot.fety = pm.ty;
        slot.boffs = 0 - 1; slot.aal = 0;
        if (bw > 0) {
            string sty = cg_lltype(g, pm.ty);
            string uty = sty; if (cg_streq(sty, "i1") == 1) { uty = "i8"; }   // a bool's unit is its byte
            int stb = cg_int_w(uty);
            if (curword < 0 || curbits != stb || curoff + bw > stb) {   // open a fresh word
                curword = cg_ms_elem(g, &body, &llcount, &off, &salign, packn, uty);
                curbits = stb; curoff = 0;
            }
            slot.fidx = curword; slot.boff = curoff; slot.bw = bw; slot.sty = sty; slot.aty = uty;
            slot.sgn = 0; if (cg_is_unsigned(cg_dealias(g, pm.ty)) == 0) { slot.sgn = 1; }
            curoff = curoff + bw;
        } else {
            curword = 0 - 1; curbits = 0; curoff = 0;      // a normal field closes the word
            string fty = cg_lltype(g, pm.ty);
            slot.fidx = cg_ms_elem(g, &body, &llcount, &off, &salign, packn, fty);
            slot.boff = 0; slot.bw = 0; slot.sgn = 0; slot.sty = fty; slot.aty = fty;
        }
        List_push<CgBF>(&g.bitfields, slot);
        i = i + 1;
    }
    string op = "{ "; string cl = " }";
    if (d.is_packed == 1) { op = "<{ "; cl = " }>"; }
    if (packn >= 2) {
        int total = cg_align_up(off, salign);
        if (total > off) { String_append(&body, ", "); String_append(&body, cg_bytes_ty(total - off)); }
        op = "<{ "; cl = " }>";
    }
    cg_deftype(g, d.name, cg_cat(op, cg_cat((string)String_cstr(&body), cl)));
}

// Lay out a `#pragma pack(N>=2)` struct: each field at min(natural align, N), with explicit
// `[K x i8]` padding fillers, emitted as an LLVM packed struct `<{ … }>` (so LLVM adds no
// padding of its own). Records a phys-index slot per field (reusing the bitfield machinery,
// so member GEP / struct-init pick up the physical index). The logical CgStruct field-list
// is already registered by pass 1a; this only emits the type + the phys slots.
void cg_emit_pack2(Codegen* g, *DeclNode d) {
    int N = d.pack_align;
    String body; String_init(&body, 32);
    int nf = List_len<Param>(&d.params);
    int offset = 0; int structAlign = 1; int physIdx = 0; int emitted = 0;
    int i = 0;
    while (i < nf) {
        Param pm = List_get<Param>(&d.params, i);
        int al = cg_align(g, pm.ty); if (al > N) { al = N; }
        if (al > structAlign) { structAlign = al; }
        int aligned = cg_align_up(offset, al);
        if (aligned > offset) {                              // alignment padding filler
            if (emitted > 0) { String_append(&body, ", "); }
            String_append(&body, "["); String_append(&body, cg_itoa(aligned - offset)); String_append(&body, " x i8]");
            emitted = emitted + 1; physIdx = physIdx + 1; offset = aligned;
        }
        let slot: CgBF; slot.sname = d.name; slot.fname = pm.name;
        slot.fidx = physIdx; slot.boff = 0; slot.bw = 0; slot.sgn = 0;
        slot.sty = cg_lltype(g, pm.ty); slot.fety = pm.ty;
        slot.boffs = 0 - 1; slot.aty = slot.sty; slot.aal = 0;
        List_push<CgBF>(&g.bitfields, slot);
        if (emitted > 0) { String_append(&body, ", "); }
        String_append(&body, cg_lltype(g, pm.ty));
        emitted = emitted + 1; physIdx = physIdx + 1;
        offset = offset + cg_size(g, pm.ty);
        i = i + 1;
    }
    int total = cg_align_up(offset, structAlign);            // size rounds up to the struct's align
    if (total > offset) {
        if (emitted > 0) { String_append(&body, ", "); }
        String_append(&body, "["); String_append(&body, cg_itoa(total - offset)); String_append(&body, " x i8]");
    }
    cg_deftype(g, d.name, cg_cat("<{ ", cg_cat((string)String_cstr(&body), " }>")));
}

// 1 if the program also defines `name` with a body (an `extern` then a definition
// of the same symbol, e.g. a test stubbing a C library): emit only the define.
// Does the program define (not just `extern`-declare) the global variable `name`?
int cg_prog_defines_var(*Program prog, string name) {
    int i = 0; int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_VARDECL && d.is_extern == 0 && cg_streq(d.name, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

int cg_prog_defines(*Program prog, string name) {
    int i = 0; int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION && d.body != null && cg_streq(d.name, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Emit a union's storage type with its C layout: `{ <most-aligned member>, [pad x i8] }`,
// sized to the largest member rounded up to that alignment (all members overlap at
// offset 0). A bare `[N x i8]` would be 1-aligned and misplace the union in a struct.
// Anchor choice mirrors the C++ codegen: highest alignment, ties to the larger member.
void cg_emit_union(Codegen* g, *DeclNode d) {
    int maxsz = 0; int maxal = 1; string anchor = ""; int anchorsz = 0;
    int fi = 0;
    while (fi < List_len<Param>(&d.params)) {
        string ft = List_get<Param>(&d.params, fi).ty;
        int sz = cg_size(g, ft); int al = cg_align(g, ft);
        if (sz > maxsz) { maxsz = sz; }
        if (anchor[0] == 0 || al > maxal || (al == maxal && sz > anchorsz)) {
            anchor = ft; anchorsz = sz; if (al > maxal) { maxal = al; }
        }
        fi = fi + 1;
    }
    int total = cg_align_up(maxsz, maxal);
    if (total == 0) { total = 1; }
    String body; String_init(&body, 32);
    if (anchor[0] != 0) { String_append(&body, cg_lltype(g, anchor)); }
    if (total > anchorsz) {
        if (anchor[0] != 0) { String_append(&body, ", "); }
        String_append(&body, "["); String_append(&body, cg_itoa(total - anchorsz)); String_append(&body, " x i8]");
    }
    cg_deftype(g, d.name, cg_cat("{ ", cg_cat((string)String_cstr(&body), " }")));
}

// The architecture macro to predefine for programs this compiler builds (the host's, as
// resolved when this compiler itself was built).
string cg_host_arch_macro() {
    string a = "";
#ifdef __aarch64__
    a = "__aarch64__";
#endif
#ifdef __x86_64__
    a = "__x86_64__";
#endif
    return a;
}

// ---- C ABI lowering for externs --------------------------------------------------------
// An `extern` that takes or returns an aggregate (struct/union) by value is declared with
// the target C signature and its calls convert the Eskiu-level values to and from it, like
// the C++ codegen (codegen_cabi.cpp): AArch64 AAPCS64 (Darwin + Linux), x86-64 SysV, Windows
// x64 and 32-bit ARM AAPCS (soft- and hard-float), for the --target triple (cg_set_target).

// Push the scalar leaves (offset, type) of the LLVM type at s[*pos] placed at `base`;
// returns its size (*al = its alignment). A union contributes every member's leaves.
int cg_ll_leaves(Codegen* g, string s, int* pos, int base, List<CgLeaf>* out, int* al) {
    cg_ll_ws(s, pos);
    int c = (int)s[pos[0]];
    int pk = 0;
    if (c == 60 && (int)s[pos[0] + 1] == 123) { pk = 1; pos[0] = pos[0] + 1; c = 123; }   // `<{`
    if (c == 123) {                                                      // struct fields
        pos[0] = pos[0] + 1;
        int off = 0; int maxal = 1;
        cg_ll_ws(s, pos);
        while (s[pos[0]] != 0 && (int)s[pos[0]] != 125) {
            int p1 = pos[0]; int fal = 1;
            int fsz = cg_ll_layout(g, s, pos, &fal);
            if (pk == 1) { fal = 1; }
            if (fal > maxal) { maxal = fal; }
            off = cg_align_up(off, fal);
            int dal = 1; cg_ll_leaves(g, s, &p1, base + off, out, &dal);
            off = off + fsz;
            cg_ll_ws(s, pos);
            if ((int)s[pos[0]] == 44) { pos[0] = pos[0] + 1; }
            cg_ll_ws(s, pos);
        }
        if (s[pos[0]] != 0) { pos[0] = pos[0] + 1; }
        if (pk == 1) { cg_ll_ws(s, pos); if ((int)s[pos[0]] == 62) { pos[0] = pos[0] + 1; } maxal = 1; }
        al[0] = maxal;
        return cg_align_up(off, maxal);
    }
    if (c == 91) {                                                       // [N x T]
        pos[0] = pos[0] + 1; cg_ll_ws(s, pos);
        int an = cg_ll_num(s, pos); cg_ll_ws(s, pos); cg_ll_kw(s, pos, "x");
        int p1 = pos[0]; int eal = 1;
        int esz = cg_ll_layout(g, s, pos, &eal);
        int k = 0;
        while (k < an) { int p2 = p1; int dal = 1; cg_ll_leaves(g, s, &p2, base + k * esz, out, &dal); k = k + 1; }
        cg_ll_ws(s, pos); if ((int)s[pos[0]] == 93) { pos[0] = pos[0] + 1; }
        al[0] = eal;
        return an * esz;
    }
    if (c == 37) {                                                       // %name
        int p1 = pos[0];
        int sz = cg_ll_layout(g, s, pos, al);                            // ensures the body exists
        string name = cg_sub_str(s, p1 + 1, pos[0]);
        if (cg_is_union(g, name) == 1) {
            CgStruct u = cg_find_struct(g, name);
            int i = 0;
            while (i < List_len<string>(&u.fetys)) {
                string mt = cg_lltype(g, List_get<string>(&u.fetys, i));
                int p2 = 0; int dal = 1; cg_ll_leaves(g, mt, &p2, base, out, &dal);
                i = i + 1;
            }
            return sz;
        }
        // A C-layout bitfield struct: its fields, not its storage elements. Like clang, a
        // bitfield counts as data from its first bit through its declared type's width;
        // each such byte in the struct is an `i8` leaf (CodeGen::cabiLeaves).
        int bi = 0; int bfc = 0;
        while (bi < List_len<CgBF>(&g.bitfields)) {
            CgBF bs = List_get<CgBF>(&g.bitfields, bi);
            if (cg_streq(bs.sname, name) == 1 && bs.boffs >= 0) {
                bfc = 1;
                if (bs.bw == 0) {
                    string flt = cg_lltype(g, bs.fety);
                    int fp = 0; int fal = 1; cg_ll_leaves(g, flt, &fp, base + bs.boffs, out, &fal);
                } else {
                    int first = bs.boffs * 8 + bs.boff;
                    int bsw = cg_int_w(bs.sty); if (bsw < 8) { bsw = 8; }
                    int last = first + bsw;
                    int b = first / 8;
                    while (b < (last + 7) / 8 && b < sz) {
                        let bl: CgLeaf; bl.off = base + b; bl.ty = "i8"; List_push<CgLeaf>(out, bl);
                        b = b + 1;
                    }
                }
            }
            bi = bi + 1;
        }
        if (bfc == 1) { return sz; }
        string body = cg_tydef_body(g, name);
        int p3 = 0; int dal2 = 1;
        if (body[0] != 0) { cg_ll_leaves(g, body, &p3, base, out, &dal2); }
        return sz;
    }
    int p1 = pos[0];
    int sz = cg_ll_layout(g, s, pos, al);                                // a scalar
    let lf: CgLeaf; lf.off = base; lf.ty = cg_trim(cg_sub_str(s, p1, pos[0]));
    List_push<CgLeaf>(out, lf);
    return sz;
}

int cg_ll_size_of(Codegen* g, string t) { int al = 1; int p = 0; return cg_ll_layout(g, t, &p, &al); }
int cg_ll_align_of(Codegen* g, string t) { int al = 1; int p = 0; cg_ll_layout(g, t, &p, &al); return al; }
int cg_ll_is_fp(string t) { return cg_streq(t, "float") | cg_streq(t, "double"); }

// A by-value C aggregate: a named user struct/union type (not the closure / interface /
// va_list fat values, which keep their first-class lowering).
int cg_abi_is_agg(string lt) {
    if ((int)lt[0] != 37) { return 0; }
    if (cg_streq(lt, "%closure") == 1 || cg_streq(lt, "%iface_fat") == 1 || cg_streq(lt, "%__va_list") == 1) { return 0; }
    return 1;
}

// A homogeneous FP aggregate (1..4 same-type FP leaves, densely packed) as `[N x fp]`
// (asarr) or `{ fp, ... }`; "" if not one.
string cg_abi_hfa(List<CgLeaf>* lv, int size, int asarr) {
    int n = List_len<CgLeaf>(lv);
    if (n == 0) { return ""; }
    string base = List_get<CgLeaf>(lv, 0).ty;
    if (cg_ll_is_fp(base) == 0) { return ""; }
    int esz = 4; if (cg_streq(base, "double") == 1) { esz = 8; }
    int distinct = 0; int i = 0;
    while (i < n) {
        CgLeaf l = List_get<CgLeaf>(lv, i);
        if (cg_streq(l.ty, base) == 0 || l.off % esz != 0) { return ""; }
        int seen = 0; int j = 0;
        while (j < i) { if (List_get<CgLeaf>(lv, j).off == l.off) { seen = 1; } j = j + 1; }
        if (seen == 0) { distinct = distinct + 1; }
        i = i + 1;
    }
    if (distinct > 4 || size != distinct * esz) { return ""; }
    if (asarr == 1) { return cg_cat("[", cg_cat(cg_itoa(distinct), cg_cat(" x ", cg_cat(base, "]")))); }
    String t; String_init(&t, 32); String_append(&t, "{ ");
    i = 0;
    while (i < distinct) { if (i > 0) { String_append(&t, ", "); } String_append(&t, base); i = i + 1; }
    String_append(&t, " }");
    return (string)String_cstr(&t);
}

// The type of the first leaf exactly at `off` ("" if none).
string cg_abi_leaf_at(List<CgLeaf>* lv, int off) {
    int i = 0;
    while (i < List_len<CgLeaf>(lv)) { CgLeaf l = List_get<CgLeaf>(lv, i); if (l.off == off) { return l.ty; } i = i + 1; }
    return "";
}

// The IR type for SysV eightbyte `eb` of an aggregate (clang's GetSSE/INTEGERTypeAtOffset).
string cg_abi_eb_type(Codegen* g, List<CgLeaf>* lv, int size, int eb, int sse) {
    int o = eb * 8;
    string t0 = cg_abi_leaf_at(lv, o);
    if (sse == 1) {
        if (t0[0] == 0 || cg_streq(t0, "double") == 1) { return "double"; }
        if (size - o > 4 && cg_streq(cg_abi_leaf_at(lv, o + 4), "float") == 1) { return "<2 x float>"; }
        return t0;
    }
    if (cg_streq(t0, "ptr") == 1 || cg_streq(t0, "i64") == 1) { return t0; }
    int w = cg_int_w(t0);
    if (w > 0) {
        if (w < 8) { w = 8; }
        int clean = 1; int i = 0;
        while (i < List_len<CgLeaf>(lv)) {
            CgLeaf l = List_get<CgLeaf>(lv, i);
            if (l.off >= o + w / 8 && l.off < o + 8) { clean = 0; }
            i = i + 1;
        }
        if (clean == 1 && w <= 32) { return cg_cat("i", cg_itoa(w)); }
    }
    int rem = size - o; if (rem > 8) { rem = 8; }
    return cg_cat("i", cg_itoa(rem * 8));
}

CgAbi cg_abi_mem(CgAbi r, string lt, int isret, int al, int size, int* fint) {
    if (isret == 0 && fint[0] == 0 && al <= 8 && size <= 8) { r.kind = 1; r.ty = cg_cat("i", cg_itoa(size * 8)); return r; }
    r.ty = lt;
    if (isret == 1) { r.kind = 5; r.align = al; return r; }
    r.kind = 4; r.align = al; if (r.align < 8) { r.align = 8; }
    return r;
}

// Classify one param/return of Eskiu type `ety` for the host C ABI. `fint`/`fsse` count
// the free SysV argument registers (consumed as arguments are classified).
CgAbi cg_abi_classify(Codegen* g, string ety, int isret, int* fint, int* fsse) {
    let r: CgAbi; r.kind = 0; r.ty = ""; r.ty2 = ""; r.align = 0; r.salign = 0;
    string lt = cg_lltype(g, ety);
    List<CgLeaf> lv; List_init<CgLeaf>(&lv, 8);
    int al = 1; int p = 0;
    int size = cg_ll_leaves(g, lt, &p, 0, &lv, &al);
    if (cg_abi_is_agg(lt) == 0) {
        if (g.abi == 3 && isret == 0) {                // a scalar still takes a register
            int i = 0;
            while (i < List_len<CgLeaf>(&lv)) {
                if (cg_ll_is_fp(List_get<CgLeaf>(&lv, i).ty) == 1) { if (fsse[0] > 0) { fsse[0] = fsse[0] - 1; } }
                else if (fint[0] > 0) { fint[0] = fint[0] - 1; }
                i = i + 1;
            }
        }
        return r;
    }
    if (size == 0) { return r; }
    if (g.abi == 1 || g.abi == 2) {                    // AArch64 AAPCS64
        int asarr = 0; if (isret == 0) { asarr = 1; }
        string h = cg_abi_hfa(&lv, size, asarr);
        if (h[0] != 0) {
            r.kind = 1; r.ty = h;
            if (isret == 0 && g.abi == 2) { r.salign = 8; if (al >= 16) { r.salign = 16; } }
            return r;
        }
        if (size > 16) {
            r.ty = lt; r.align = al;
            if (isret == 1) { r.kind = 5; } else { r.kind = 3; }
            return r;
        }
        r.kind = 1;
        if (size > 8) { r.ty = "[2 x i64]"; }
        else if (isret == 1) { r.ty = cg_cat("i", cg_itoa(size * 8)); }
        else { r.ty = "i64"; }
        return r;
    }
    if (g.abi == 3) {                                  // x86-64 System V
        if (size > 16) { return cg_abi_mem(r, lt, isret, al, size, fint); }
        int c0 = 0; int c1 = 0;                        // 0 none, 1 INTEGER, 2 SSE
        int i = 0;
        while (i < List_len<CgLeaf>(&lv)) {
            CgLeaf l = List_get<CgLeaf>(&lv, i);
            int lsz = cg_ll_size_of(g, l.ty); int lal = cg_ll_align_of(g, l.ty);
            if (l.off % lal != 0 || l.off / 8 != (l.off + lsz - 1) / 8) { return cg_abi_mem(r, lt, isret, al, size, fint); }
            int cl = 1; if (cg_ll_is_fp(l.ty) == 1) { cl = 2; }
            if (l.off / 8 == 0) { if (c0 == 0 || cl == 1) { c0 = cl; } }
            else { if (c1 == 0 || cl == 1) { c1 = cl; } }
            i = i + 1;
        }
        int neb = 1; if (size > 8) { neb = 2; }
        int nint = 0; int nsse = 0;
        if (c0 == 2) { nsse = nsse + 1; } else { nint = nint + 1; }
        if (neb == 2) { if (c1 == 2) { nsse = nsse + 1; } else { nint = nint + 1; } }
        if (isret == 0) {
            if (nint > fint[0] || nsse > fsse[0]) { return cg_abi_mem(r, lt, isret, al, size, fint); }
            fint[0] = fint[0] - nint; fsse[0] = fsse[0] - nsse;
        }
        int s0 = 0; if (c0 == 2) { s0 = 1; }
        string lo = cg_abi_eb_type(g, &lv, size, 0, s0);
        if (neb == 1) { r.kind = 1; r.ty = lo; return r; }
        int s1 = 0; if (c1 == 2) { s1 = 1; }
        string hi = cg_abi_eb_type(g, &lv, size, 1, s1);
        if (cg_align_up(cg_ll_size_of(g, lo), cg_ll_align_of(g, hi)) != 8) {   // hi must start at 8
            if (cg_streq(lo, "float") == 1) { lo = "double"; } else { lo = "i64"; }
        }
        if (isret == 1) { r.kind = 1; r.ty = cg_cat("{ ", cg_cat(lo, cg_cat(", ", cg_cat(hi, " }")))); return r; }
        r.kind = 2; r.ty = lo; r.ty2 = hi;
        return r;
    }
    if (g.abi == 4) {                                  // Windows x64
        if (size == 1 || size == 2 || size == 4 || size == 8) { r.kind = 1; r.ty = cg_cat("i", cg_itoa(size * 8)); return r; }
        r.ty = lt; r.align = al;
        if (isret == 1) { r.kind = 5; } else { r.kind = 3; }
        return r;
    }
    if (g.abi == 5 || g.abi == 6) {                    // 32-bit ARM AAPCS (6: VFP hard-float)
        if (g.abi == 6) {
            string h = cg_abi_hfa(&lv, size, 0);
            if (h[0] != 0) { r.kind = 1; r.ty = h; return r; }
        }
        if (isret == 1) {
            if (size <= 4) { r.kind = 1; r.ty = "i32"; return r; }
            r.kind = 5; r.ty = lt; r.align = al; return r;
        }
        if (size > 64) {
            r.kind = 4; r.ty = lt; r.align = al;
            if (r.align < 4) { r.align = 4; }
            if (r.align > 8) { r.align = 8; }
            return r;
        }
        r.kind = 1;
        if (al <= 4) { r.ty = cg_cat("[", cg_cat(cg_itoa((size + 3) / 4), " x i32]")); }
        else { r.ty = cg_cat("[", cg_cat(cg_itoa((size + 7) / 8), " x i64]")); }
        return r;
    }
    return r;
}

CgCabi cg_find_cabi(Codegen* g, string name) {
    int i = 0;
    while (i < List_len<CgCabi>(&g.cabis)) {
        CgCabi c = List_get<CgCabi>(&g.cabis, i);
        if (cg_streq(c.name, name) == 1) { return c; }
        i = i + 1;
    }
    let none: CgCabi; none.name = ""; none.lowret = ""; none.lowfixed = "";
    none.ret.kind = 0; none.ret.ty = ""; none.ret.ty2 = ""; none.ret.align = 0; none.ret.salign = 0;
    List_init<CgAbi>(&none.params, 1);
    return none;
}

// An lowered param's type with its ABI attributes (`ptr byval(%T) align 8`, …).
string cg_abi_param_decl(CgAbi a, string lty) {
    if (a.kind == 1) {
        if (a.salign > 0) { return cg_cat(a.ty, cg_cat(" alignstack(", cg_cat(cg_itoa(a.salign), ")"))); }
        return a.ty;
    }
    if (a.kind == 2) { return cg_cat(a.ty, cg_cat(", ", a.ty2)); }
    if (a.kind == 3) { return "ptr"; }
    if (a.kind == 4) { return cg_cat("ptr byval(", cg_cat(a.ty, cg_cat(") align ", cg_itoa(a.align)))); }
    return lty;
}

// Classify extern `d`; when it has a by-value aggregate, register it and return the
// lowered `declare` line (else "" — the extern keeps its plain declaration).
string cg_cabi_declare(Codegen* g, *DeclNode d) {
    if (g.abi == 0) { return ""; }
    int any = cg_abi_is_agg(cg_lltype(g, d.ret_type));
    int np = List_len<Param>(&d.params);
    int i = 0;
    while (i < np) {
        Param pm = List_get<Param>(&d.params, i);
        if (cg_streq(pm.ty, "...") == 0 && cg_abi_is_agg(cg_lltype(g, pm.ty)) == 1) { any = 1; }
        i = i + 1;
    }
    if (any == 0) { return ""; }
    let c: CgCabi; c.name = d.name;
    List_init<CgAbi>(&c.params, np);
    int fint = 6; int fsse = 8;
    c.ret.kind = 0; c.ret.ty = ""; c.ret.ty2 = ""; c.ret.align = 0; c.ret.salign = 0;
    string lret = cg_lltype(g, d.ret_type);
    if (cg_streq(lret, "void") == 0) { c.ret = cg_abi_classify(g, d.ret_type, 1, &fint, &fsse); }
    if (c.ret.kind == 5 && fint > 0) { fint = fint - 1; }
    String decl; String_init(&decl, 64);      // params with attributes (the declare line)
    String fixed; String_init(&fixed, 64);    // bare lowered types (a variadic call's fn type)
    int variadic = 0;
    if (c.ret.kind == 5) {
        String_append(&decl, cg_cat("ptr sret(", cg_cat(c.ret.ty, cg_cat(") align ", cg_itoa(c.ret.align)))));
        String_append(&fixed, "ptr");
    }
    i = 0;
    while (i < np) {
        Param pm = List_get<Param>(&d.params, i);
        if (cg_streq(pm.ty, "...") == 1) { variadic = 1; i = i + 1; continue; }
        string cety = pm.ty;
        if (cg_is_fnty(cg_dealias(g, pm.ty)) == 1) { cety = "*void"; }   // a C function pointer
        CgAbi a = cg_abi_classify(g, cety, 0, &fint, &fsse);
        List_push<CgAbi>(&c.params, a);
        string lty = cg_lltype(g, cety);
        string bare = lty;
        if (a.kind == 1) { bare = a.ty; }
        else if (a.kind == 2) { bare = cg_cat(a.ty, cg_cat(", ", a.ty2)); }
        else if (a.kind >= 3) { bare = "ptr"; }
        if (String_len(&decl) > 0) { String_append(&decl, ", "); String_append(&fixed, ", "); }
        String_append(&decl, cg_abi_param_decl(a, lty));
        String_append(&fixed, bare);
        i = i + 1;
    }
    c.lowret = lret;
    if (c.ret.kind == 5) { c.lowret = "void"; }
    else if (c.ret.kind == 1) { c.lowret = c.ret.ty; }
    c.lowfixed = (string)String_cstr(&fixed);
    List_push<CgCabi>(&g.cabis, c);
    string params = (string)String_cstr(&decl);
    if (variadic == 1) { params = cg_va(params); }
    return cg_cat("declare ", cg_cat(c.lowret, cg_cat(" @", cg_cat(d.name, cg_cat("(", cg_cat(params, ")\n"))))));
}

// Reinterpret value `op` of LLVM type `from` as type `to` through a stack slot big and
// aligned enough for both (clang's coerced load/store). Returns the new operand.
string cg_abi_reinterp(Codegen* g, string op, string from, string to) {
    if (cg_streq(from, to) == 1) { return op; }
    int fs = cg_ll_size_of(g, from); int ts = cg_ll_size_of(g, to);
    int a = cg_ll_align_of(g, from); int ta = cg_ll_align_of(g, to); if (ta > a) { a = ta; }
    string big = from; if (ts > fs) { big = to; }
    string slot = cg_entry_alloca(g, cg_cat(big, cg_cat(", align ", cg_itoa(a))));
    if (fs < ts) { cg_emit(g, "  store "); cg_emit(g, to); cg_emit(g, " zeroinitializer, ptr "); cg_emit(g, slot); cg_emit(g, "\n"); }
    cg_emit(g, "  store "); cg_emit(g, from); cg_emit(g, " "); cg_emit(g, op); cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
    string t = cg_tmp(g);
    cg_emit(g, "  "); cg_emit(g, t); cg_emit(g, " = load "); cg_emit(g, to); cg_emit(g, ", ptr "); cg_emit(g, slot); cg_emit(g, "\n");
    return t;
}

// Call the lowered extern `c` with logical argument values (already coerced to its Eskiu
// parameter types; variadic extras promoted). `f` is its Eskiu-level signature. Returns
// the logical result.
CgVal cg_cabi_call(Codegen* g, CgCabi* c, CgFn* f, List<CgVal>* args) {
    let v: CgVal; v.op = ""; v.ty = "void"; v.ety = f.rety;
    String ir; String_init(&ir, 64);
    string sslot = "";
    if (c.ret.kind == 5) {
        sslot = cg_entry_alloca(g, cg_cat(c.ret.ty, cg_cat(", align ", cg_itoa(c.ret.align))));
        String_append(&ir, cg_cat("ptr sret(", cg_cat(c.ret.ty, cg_cat(") align ", cg_cat(cg_itoa(c.ret.align), cg_cat(" ", sslot))))));
    }
    int n = List_len<CgVal>(args);
    int i = 0;
    while (i < n) {
        CgVal a = List_get<CgVal>(args, i);
        string piece = cg_cat(a.ty, cg_cat(" ", a.op));
        if (i < List_len<CgAbi>(&c.params)) {
            CgAbi k = List_get<CgAbi>(&c.params, i);
            if (k.kind == 1) {
                piece = cg_cat(cg_abi_param_decl(k, a.ty), cg_cat(" ", cg_abi_reinterp(g, a.op, a.ty, k.ty)));
            } else if (k.kind == 2) {
                string pty = cg_cat("{ ", cg_cat(k.ty, cg_cat(", ", cg_cat(k.ty2, " }"))));
                string pair = cg_abi_reinterp(g, a.op, a.ty, pty);
                string e0 = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, e0); cg_emit(g, " = extractvalue "); cg_emit(g, pty); cg_emit(g, " "); cg_emit(g, pair); cg_emit(g, ", 0\n");
                string e1 = cg_tmp(g);
                cg_emit(g, "  "); cg_emit(g, e1); cg_emit(g, " = extractvalue "); cg_emit(g, pty); cg_emit(g, " "); cg_emit(g, pair); cg_emit(g, ", 1\n");
                piece = cg_cat(k.ty, cg_cat(" ", cg_cat(e0, cg_cat(", ", cg_cat(k.ty2, cg_cat(" ", e1))))));
            } else if (k.kind == 3 || k.kind == 4) {
                int cal = cg_ll_align_of(g, a.ty); if (k.align > cal) { cal = k.align; }
                string copy = cg_entry_alloca(g, cg_cat(a.ty, cg_cat(", align ", cg_itoa(cal))));
                cg_emit(g, "  store "); cg_emit(g, a.ty); cg_emit(g, " "); cg_emit(g, a.op); cg_emit(g, ", ptr "); cg_emit(g, copy); cg_emit(g, "\n");
                piece = cg_cat(cg_abi_param_decl(k, a.ty), cg_cat(" ", copy));
            }
        }
        if (String_len(&ir) > 0) { String_append(&ir, ", "); }
        String_append(&ir, piece);
        i = i + 1;
    }
    string callty = c.lowret;
    if (f.variadic == 1) { callty = cg_cat(c.lowret, cg_cat(" (", cg_cat(cg_va(c.lowfixed), ")"))); }
    int isvoid = cg_streq(c.lowret, "void");
    string t = cg_emit_callish(g, callty, cg_cat("@", c.name), (string)String_cstr(&ir), isvoid);
    if (c.ret.kind == 5) {
        string r = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, r); cg_emit(g, " = load "); cg_emit(g, f.retty); cg_emit(g, ", ptr "); cg_emit(g, sslot); cg_emit(g, "\n");
        v.op = r; v.ty = f.retty; return v;
    }
    if (isvoid == 1) { return v; }
    if (c.ret.kind == 1) { v.op = cg_abi_reinterp(g, t, c.ret.ty, f.retty); v.ty = f.retty; return v; }
    v.op = t; v.ty = f.retty; return v;
}

// Does the Eskiu function `f` take or return an aggregate by value (so C must reach it
// through a C-ABI thunk)? Externs lowered at declaration and variadics are left alone.
int cg_cabi_needs_thunk(Codegen* g, CgFn* f) {
    if (g.abi == 0 || f.variadic == 1) { return 0; }
    if (cg_find_cabi(g, f.name).name[0] != 0) { return 0; }
    if (cg_abi_is_agg(f.retty) == 1) { return 1; }
    int i = 0;
    while (i < List_len<string>(&f.ptys)) { if (cg_abi_is_agg(List_get<string>(&f.ptys, i)) == 1) { return 1; } i = i + 1; }
    return 0;
}

// The raw address C calls for the top-level function `name` (`(*void)f`): `@name`, or
// its `@__cabi_<name>` thunk (queued) when it has a by-value aggregate.
string cg_cabi_callback(Codegen* g, string name) {
    CgFn f = cg_find_fn(g, name);
    if (cg_cabi_needs_thunk(g, &f) == 0) { return cg_cat("@", name); }
    string key = cg_cat("cabi:", name);
    if (cg_seen_inst(g, cg_cat("thunk:", key)) == 0) {
        List_push<string>(&g.inst_seen, cg_cat("thunk:", key));
        List_push<string>(&g.fnthunks, key);
    }
    return cg_cat("@__cabi_", name);
}

// Emit `__cabi_<name>`: the lowered C signature (like an extern's), rebuilding the Eskiu
// values, calling `name` with first-class aggregates and returning the result the C way
// (mirrors CodeGen::cabiCallbackThunk).
void cg_emit_cabi_thunk(Codegen* g, string name) {
    CgFn f = cg_find_fn(g, name);
    int np = List_len<string>(&f.ptys);
    int fint = 6; int fsse = 8;
    let ra: CgAbi; ra.kind = 0; ra.ty = ""; ra.ty2 = ""; ra.align = 0; ra.salign = 0;
    if (cg_streq(f.retty, "void") == 0) { ra = cg_abi_classify(g, f.rety, 1, &fint, &fsse); }
    if (ra.kind == 5 && fint > 0) { fint = fint - 1; }
    String hdr; String_init(&hdr, 64);
    if (ra.kind == 5) {
        String_append(&hdr, cg_cat("ptr sret(", cg_cat(ra.ty, cg_cat(") align ", cg_cat(cg_itoa(ra.align), " %sr")))));
    }
    List<CgAbi> ks; List_init<CgAbi>(&ks, np);
    int i = 0;
    while (i < np) {
        CgAbi k = cg_abi_classify(g, List_get<string>(&f.petys, i), 0, &fint, &fsse);
        List_push<CgAbi>(&ks, k);
        string an = cg_cat("%a", cg_itoa(i));
        string lty = List_get<string>(&f.ptys, i);
        if (String_len(&hdr) > 0) { String_append(&hdr, ", "); }
        if (k.kind == 2) {
            String_append(&hdr, cg_cat(k.ty, cg_cat(" ", cg_cat(an, cg_cat("l, ", cg_cat(k.ty2, cg_cat(" ", cg_cat(an, "h"))))))));
        } else {
            String_append(&hdr, cg_cat(cg_abi_param_decl(k, lty), cg_cat(" ", an)));
        }
        i = i + 1;
    }
    string lowret = f.retty;
    if (ra.kind == 5) { lowret = "void"; } else if (ra.kind == 1) { lowret = ra.ty; }
    String_init(&g.entry_buf, 128);
    String saved = g.out;
    String_init(&g.out, 256);
    String args; String_init(&args, 64);
    i = 0;
    while (i < np) {
        CgAbi k = List_get<CgAbi>(&ks, i);
        string an = cg_cat("%a", cg_itoa(i));
        string lty = List_get<string>(&f.ptys, i);
        string op = an;
        if (k.kind == 1) { op = cg_abi_reinterp(g, an, k.ty, lty); }
        else if (k.kind == 2) {
            string pty = cg_cat("{ ", cg_cat(k.ty, cg_cat(", ", cg_cat(k.ty2, " }"))));
            string p0 = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, p0); cg_emit(g, " = insertvalue "); cg_emit(g, pty); cg_emit(g, " undef, ");
            cg_emit(g, k.ty); cg_emit(g, " "); cg_emit(g, an); cg_emit(g, "l, 0\n");
            string p1 = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, p1); cg_emit(g, " = insertvalue "); cg_emit(g, pty); cg_emit(g, " "); cg_emit(g, p0);
            cg_emit(g, ", "); cg_emit(g, k.ty2); cg_emit(g, " "); cg_emit(g, an); cg_emit(g, "h, 1\n");
            op = cg_abi_reinterp(g, p1, pty, lty);
        } else if (k.kind == 3 || k.kind == 4) {
            op = cg_tmp(g);
            cg_emit(g, "  "); cg_emit(g, op); cg_emit(g, " = load "); cg_emit(g, lty); cg_emit(g, ", ptr "); cg_emit(g, an); cg_emit(g, "\n");
        }
        if (i > 0) { String_append(&args, ", "); }
        String_append(&args, cg_cat(lty, cg_cat(" ", op)));
        i = i + 1;
    }
    string argstr = (string)String_cstr(&args);
    if (cg_streq(f.retty, "void") == 1) {
        cg_emit(g, "  call void @"); cg_emit(g, name); cg_emit(g, "("); cg_emit(g, argstr); cg_emit(g, ")\n");
        cg_emit(g, "  ret void\n");
    } else {
        string r = cg_tmp(g);
        cg_emit(g, "  "); cg_emit(g, r); cg_emit(g, " = call "); cg_emit(g, f.retty); cg_emit(g, " @"); cg_emit(g, name);
        cg_emit(g, "("); cg_emit(g, argstr); cg_emit(g, ")\n");
        if (ra.kind == 5) {
            cg_emit(g, "  store "); cg_emit(g, f.retty); cg_emit(g, " "); cg_emit(g, r); cg_emit(g, ", ptr %sr\n");
            cg_emit(g, "  ret void\n");
        } else {
            string rv = r;
            if (ra.kind == 1) { rv = cg_abi_reinterp(g, r, f.retty, ra.ty); }
            cg_emit(g, "  ret "); cg_emit(g, lowret); cg_emit(g, " "); cg_emit(g, rv); cg_emit(g, "\n");
        }
    }
    string bodytext = (string)String_cstr(&g.out);
    g.out = saved;
    cg_emit(g, "define internal "); cg_emit(g, lowret); cg_emit(g, " @__cabi_"); cg_emit(g, name);
    cg_emit(g, "("); cg_emit(g, (string)String_cstr(&hdr)); cg_emit(g, ") {\nentry:\n");
    cg_emit(g, (string)String_cstr(&g.entry_buf));
    cg_emit(g, bodytext);
    cg_emit(g, "}\n\n");
}

// An enum is an ADT (tagged union) when some variant carries a payload.
int cg_enum_is_adt(*DeclNode d) {
    int j = 0;
    while (j < List_len<Param>(&d.params)) {
        List<string> pl = List_get<List<string>>(&d.payloads, j);
        if (List_len<string>(&pl) > 0) { return 1; }
        j = j + 1;
    }
    return 0;
}

// An ADT enum's tagged-union type `%E = type { i32, [N x i64] }`: N = i64 slots holding
// the largest variant payload, laid out by BYTES with field alignment (as the C++
// makeAdtStruct does via DataLayout), so arrays, structs and nested enums fit.
void cg_emit_adt_type(Codegen* g, *DeclNode d) {
    int slots = 0; int j = 0;
    while (j < List_len<Param>(&d.params)) {
        List<string> pl = List_get<List<string>>(&d.payloads, j);
        int isl = (cg_layout_size(g, &pl) + 7) / 8;
        if (isl > slots) { slots = isl; }
        j = j + 1;
    }
    if (slots < 1) { slots = 1; }
    cg_deftype(g, d.name, cg_cat("{ i32, [", cg_cat(cg_itoa(slots), " x i64] }")));
}

// Emit the named type line for a (non-generic) struct / union / ADT enum decl, once.
// Called in declaration order by pass 1b/1c, and on demand by the layout queries when a
// type's size is needed before its turn (a union member or payload declared later).
void cg_emit_tydecl(Codegen* g, *DeclNode d) {
    if (cg_tydef_body(g, d.name)[0] != 0) { return; }
    string mark = cg_cat("tyd:", d.name);
    if (cg_seen_inst(g, mark) == 1) { return; }          // in progress (self-containing type)
    List_push<string>(&g.inst_seen, mark);
    if (d.kind == DK_UNION) { cg_emit_union(g, d); return; }
    if (d.kind == DK_ENUM) { cg_emit_adt_type(g, d); return; }
    if (cg_struct_has_bf(d) == 1) { cg_bf_layout(g, d); return; }
    if (d.pack_align >= 2) { cg_emit_pack2(g, d); return; }   // #pragma pack(N>=2): padding + phys slots
    // Build the body first: a generic field type instantiates into g.globals and must
    // precede this line, not interleave (see cg_ensure_struct_inst).
    String body; String_init(&body, 32);
    int nf = List_len<Param>(&d.params);
    int fi = 0;
    while (fi < nf) {
        if (fi > 0) { String_append(&body, ", "); }
        String_append(&body, cg_lltype(g, List_get<Param>(&d.params, fi).ty));
        fi = fi + 1;
    }
    // A `packed` struct (or `#pragma pack(1)`) is an LLVM packed struct `<{…}>` (no
    // inter-field padding, align 1); indices are unchanged (no fillers).
    string op = "{ "; string cl = " }";
    if (d.is_packed == 1) { op = "<{ "; cl = " }>"; }
    cg_deftype(g, d.name, cg_cat(op, cg_cat((string)String_cstr(&body), cl)));
}

void cg_program(Codegen* g, *Program prog) {
    // Does the program throw or catch anywhere? Only then do defers get landingpads.
    int ei = 0;
    while (ei < List_len<*DeclNode>(&prog.decls)) {
        *DeclNode ed = List_get<*DeclNode>(&prog.decls, ei);
        if (ed.kind == DK_FUNCTION && cg_has_eh_s(ed.body) == 1) { g.prog_eh = 1; }
        if (ed.kind == DK_VARDECL && cg_has_eh_e(ed.init) == 1) { g.prog_eh = 1; }
        if (ed.kind == DK_STRUCT) {
            int emi = 0;
            while (emi < List_len<*DeclNode>(&ed.methods)) {
                if (cg_has_eh_s(List_get<*DeclNode>(&ed.methods, emi).body) == 1) { g.prog_eh = 1; }
                emi = emi + 1;
            }
        }
        ei = ei + 1;
    }
    // A struct declared again (sema accepts only an identical repeat, e.g. two merged files
    // sharing a declaration) is one type: keep the first declaration, like the C++ backend.
    int di = List_len<*DeclNode>(&prog.decls) - 1;
    while (di > 0) {
        *DeclNode dd = List_get<*DeclNode>(&prog.decls, di);
        int dup = 0;
        if (dd.kind == DK_STRUCT) {
            int dj = 0;
            while (dj < di) {
                *DeclNode de = List_get<*DeclNode>(&prog.decls, dj);
                if (de.kind == DK_STRUCT && cg_streq(de.name, dd.name) == 1) { dup = 1; }
                dj = dj + 1;
            }
        }
        if (dup == 1) { List_remove<*DeclNode>(&prog.decls, di); }
        di = di - 1;
    }
    int n = List_len<*DeclNode>(&prog.decls);

    cg_deftype(g, "closure", "{ ptr, ptr }");   // fat pointer for fn values

    // Pass 0: register type aliases (`type Name = Underlying`). Done first so every later
    // type lowering / ety recording resolves aliases (cg_dealias). Chains resolve via
    // cg_dealias's recursion, so declaration order doesn't matter.
    int ai = 0;
    while (ai < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, ai);
        if (d.kind == DK_TYPEALIAS) {
            let sb: CgSub; sb.param = d.name; sb.arg = d.ret_type;
            List_push<CgSub>(&g.aliases, sb);
        }
        if (d.kind == DK_ENUM && List_len<TypeParam>(&d.type_params) == 0 && cg_enum_is_adt(d) == 0) {
            int neg = 0; int mi = 0;
            while (mi < List_len<Param>(&d.params)) {
                Param pm0 = List_get<Param>(&d.params, mi);
                if ((int)pm0.ty[0] == 45) { neg = 1; }
                // Known before any struct type is emitted, so a field's `int[Member]` resolves.
                let ec0: CgEnumC; ec0.name = pm0.name; ec0.val = pm0.ty;
                List_push<CgEnumC>(&g.econsts, ec0);
                mi = mi + 1;
            }
            if (neg == 0) { List_push<string>(&g.enum_uns, d.name); }
        }
        ai = ai + 1;
    }

    // Pass 0b: fold top-level `const int`s into econsts NOW, before any struct type is
    // emitted, so a struct field's array dimension (`int[CAP]`) resolves to its value.
    // (Mirrors the C++ pre-pass; the global-var pass below reuses these, not re-registers.)
    int ci = 0;
    while (ci < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, ci);
        if (d.kind == DK_VARDECL && d.is_const == 1 && d.init != null
            && d.init.kind == EK_LITERAL && d.init.lit_kind == LIT_INT
            && cg_streq(cg_lltype(g, d.ret_type), "i32") == 1
            && cg_is_unsigned(cg_dealias(g, d.ret_type)) == 0) {   // folded reads are int operands
            let ec: CgEnumC;
            ec.name = d.name;
            ec.val = cg_num_const("i32", d.init.sval);   // decimal, sign kept (`-5` stays -5)
            List_push<CgEnumC>(&g.econsts, ec);
        } else if (d.kind == DK_VARDECL && d.is_const == 1 && d.init != null) {
            cg_fold_const_decl(g, d);   // a constant expression (`A * 2`) or a non-int const
        }
        ci = ci + 1;
    }

    // Pass 1-iface: register interfaces (method order + return types) and emit each
    // vtable struct type `%I_vtable = type { ptr, ... }`. Runs first so cg_lltype lowers
    // an interface-typed param/field to `ptr` everywhere downstream. The shared fat-ptr
    // type `%iface_fat = type { ptr, ptr }` is emitted once when any interface exists.
    int ii0 = 0;
    while (ii0 < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, ii0);
        if (d.kind == DK_INTERFACE) {
            if (g.uses_iface == 0) {
                cg_deftype(g, "iface_fat", "{ ptr, ptr }");
                g.uses_iface = 1;
            }
            let iface: CgIface; iface.name = d.name;
            int mn = List_len<*DeclNode>(&d.methods);
            List_init<string>(&iface.mnames, mn);
            List_init<string>(&iface.mrets, mn);
            List_init<List<string>>(&iface.mparams, mn);
            String vtb; String_init(&vtb, 32); String_append(&vtb, "{ ");
            int mi = 0;
            while (mi < mn) {
                *DeclNode m = List_get<*DeclNode>(&d.methods, mi);
                List_push<string>(&iface.mnames, m.name);
                List_push<string>(&iface.mrets, m.ret_type);
                // Record each method's declared param Eskiu types so dispatch can coerce
                // args to them (a vtable call needs the same widening as a direct call).
                List<string> ptys; List_init<string>(&ptys, List_len<Param>(&m.params));
                int pj = 0;
                while (pj < List_len<Param>(&m.params)) {
                    List_push<string>(&ptys, List_get<Param>(&m.params, pj).ty);
                    pj = pj + 1;
                }
                List_push<List<string>>(&iface.mparams, ptys);
                if (mi > 0) { String_append(&vtb, ", "); }
                String_append(&vtb, "ptr");
                mi = mi + 1;
            }
            String_append(&vtb, " }");
            cg_deftype(g, cg_cat(d.name, "_vtable"), (string)String_cstr(&vtb));
            List_push<CgIface>(&g.ifaces, iface);
        }
        ii0 = ii0 + 1;
    }

    // Pass 1a: register struct layouts (field names + Eskiu types). A second declaration
    // of an already-registered struct/union name (the same header-style struct in two
    // inputs of a multi-file build) is skipped: the first one wins, as in the C++ back-end.
    List<*DeclNode> dup_types; List_init<*DeclNode>(&dup_types, 2);
    int si = 0;
    while (si < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, si);
        if ((d.kind == DK_STRUCT || d.kind == DK_UNION) && List_len<TypeParam>(&d.type_params) == 0
            && cg_is_struct(g, d.name) == 1) {
            List_push<*DeclNode>(&dup_types, d);
        } else if (d.kind == DK_STRUCT && List_len<TypeParam>(&d.type_params) > 0) {
            List_push<*DeclNode>(&g.gstructs, d);          // generic — monomorphized on demand
        } else if (d.kind == DK_STRUCT) {
            List_push<*DeclNode>(&g.tydecls, d);
            let s: CgStruct;
            s.name = d.name;
            List_init<string>(&s.fnames, 4);
            List_init<string>(&s.fetys, 4);
            int nf = List_len<Param>(&d.params);
            int fi = 0;
            while (fi < nf) {
                Param pm = List_get<Param>(&d.params, fi);
                List_push<string>(&s.fnames, pm.name);
                List_push<string>(&s.fetys, cg_dealias(g, pm.ty));
                fi = fi + 1;
            }
            List_push<CgStruct>(&g.structs, s);
        } else if (d.kind == DK_UNION) {
            let s: CgStruct;
            s.name = d.name;
            List_init<string>(&s.fnames, 4);
            List_init<string>(&s.fetys, 4);
            int nf = List_len<Param>(&d.params);
            int fi = 0;
            while (fi < nf) {
                Param pm = List_get<Param>(&d.params, fi);
                List_push<string>(&s.fnames, pm.name);
                List_push<string>(&s.fetys, pm.ty);
                fi = fi + 1;
            }
            List_push<CgStruct>(&g.structs, s);
            List_push<string>(&g.union_names, d.name);
            List_push<*DeclNode>(&g.tydecls, d);
        } else if (d.kind == DK_ENUM && List_len<TypeParam>(&d.type_params) == 0 && cg_enum_is_adt(d) == 1) {
            // Register the ADT name now so struct fields / payloads of this type lower
            // to `%Name` (not the i32 default) whatever the declaration order.
            List_push<string>(&g.adt_names, d.name);
            List_push<*DeclNode>(&g.tydecls, d);
        }
        si = si + 1;
    }
    // Pass 1b: emit the named struct/union types (now every struct name resolves). A type
    // another layout needed earlier (a union member, a pack/ADT payload) is already out.
    si = 0;
    while (si < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, si);
        int is_dup = 0;
        int dj = 0; while (dj < List_len<*DeclNode>(&dup_types)) { if (List_get<*DeclNode>(&dup_types, dj) == d) { is_dup = 1; } dj = dj + 1; }
        if (is_dup == 0 && ((d.kind == DK_STRUCT && List_len<TypeParam>(&d.type_params) == 0) || d.kind == DK_UNION)) {
            cg_emit_tydecl(g, d);
        }
        si = si + 1;
    }

    // Pass 1c: register enums. A plain enum (every variant payload-less) → integer
    // constants + an i32 type. An ADT enum (some variant carries a payload) → a
    // tagged-union type `%E = type { i32, [N x i64] }` (N = i64s to hold the largest
    // variant's payload, sized by BYTES with field alignment — so a struct-by-value
    // payload wider than one slot fits) + a variant registry (name → tag + payload
    // types), keyed by declaration order.
    si = 0;
    while (si < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, si);
        if (d.kind == DK_ENUM && List_len<TypeParam>(&d.type_params) > 0) {
            // Generic ADT enum: register the decl + variant patterns; instances (and their
            // concrete variants) are built on demand by cg_ensure_enum_inst.
            List_push<*DeclNode>(&g.genums, d);
            int gm = List_len<Param>(&d.params); int gj = 0;
            while (gj < gm) {
                let gv: CgVariant;
                gv.vname = List_get<Param>(&d.params, gj).name;
                gv.ename = d.name; gv.tag = gj;
                List<string> pl = List_get<List<string>>(&d.payloads, gj);
                List_init<string>(&gv.ptys, List_len<string>(&pl));
                int gk = 0; while (gk < List_len<string>(&pl)) { List_push<string>(&gv.ptys, List_get<string>(&pl, gk)); gk = gk + 1; }
                List_push<CgVariant>(&g.gvariants, gv);
                gj = gj + 1;
            }
        } else if (d.kind == DK_ENUM) {
            int m = List_len<Param>(&d.params);
            int j = 0;
            if (cg_enum_is_adt(d) == 1) {
                cg_emit_tydecl(g, d);
                j = 0;
                while (j < m) {
                    let var: CgVariant;
                    var.vname = List_get<Param>(&d.params, j).name;
                    var.ename = d.name; var.tag = j;
                    List<string> pl = List_get<List<string>>(&d.payloads, j);
                    List_init<string>(&var.ptys, List_len<string>(&pl));
                    int k = 0;
                    while (k < List_len<string>(&pl)) { List_push<string>(&var.ptys, List_get<string>(&pl, k)); k = k + 1; }
                    List_push<CgVariant>(&g.variants, var);
                    j = j + 1;
                }
            } else {
                List_push<string>(&g.enum_names, d.name);
                j = 0;
                while (j < m) {
                    Param pm = List_get<Param>(&d.params, j);
                    let c: CgEnumC; c.name = pm.name; c.val = pm.ty;
                    List_push<CgEnumC>(&g.econsts, c);
                    j = j + 1;
                }
            }
        }
        si = si + 1;
    }

    // Pass 1d: register + emit global variables (top-level var-decls). The symbol `@name`
    // is the address of the storage; reads load from it, writes store to it.
    si = 0;
    while (si < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, si);
        if (d.kind == DK_VARDECL) {
            // `extern <type> <name>;` — defined in another translation unit (a C
            // global). Emit an external declaration (external linkage, no init).
            // Beside its definition in the program (either order, or another input file),
            // or repeated, an `extern` names that one variable: nothing more to emit.
            if (d.is_extern == 1) {
                if (cg_prog_defines_var(prog, d.name) == 1 || cg_count_global(g, d.name) > 0) {
                    si = si + 1;
                    continue;
                }
                string ellty = cg_lltype(g, d.ret_type);
                cg_add_global(g, d.name, cg_cat("@", d.name), ellty, d.ret_type);
                String_append(&g.globals, "@"); String_append(&g.globals, d.name);
                String_append(&g.globals, " = external global "); String_append(&g.globals, ellty);
                String_append(&g.globals, "\n");
                si = si + 1;
                continue;
            }
            // Pass 0b folded the consts before any struct existed; fold a constant
            // expression again now that `sizeof(Struct)` is known (the later entry wins).
            if (d.is_const == 1 && d.init != null && d.init.kind != EK_LITERAL) { cg_fold_const_decl(g, d); }
            string llty = cg_lltype(g, d.ret_type);
            // Duplicate top-level name (e.g. two `const int X`): emit a uniquely-named global
            // (@X.1) so clang does not reject a redefinition. Const-int reads fold via econsts
            // (last-wins), so the global itself is unused; this just keeps the IR valid.
            string gsym = cg_cat("@", d.name);
            int dupn = cg_count_global(g, d.name);
            if (dupn > 0) { gsym = cg_cat(gsym, cg_cat(".", cg_itoa(dupn))); }
            cg_add_global(g, d.name, gsym, llty, d.ret_type);
            g.lam_expret = cg_lam_ret_of(d.ret_type);  // thread fn-type return into a lambda init
            // Compute the initializer FIRST: a string literal folds via cg_string_global,
            // which appends its constant to g.globals — that must land before this line, not
            // in the middle of it.
            string initstr = cg_global_init_ty(g, d.init, d.ret_type);
            g.lam_expret = "";
            String_append(&g.globals, gsym);
            String_append(&g.globals, " = global "); String_append(&g.globals, llty);
            String_append(&g.globals, " "); String_append(&g.globals, initstr);
            String_append(&g.globals, "\n");
        }
        si = si + 1;
    }

    // Pass 2: record every function's return type so calls can be typed.
    int i = 0;
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION && List_len<TypeParam>(&d.type_params) > 0) {
            List_push<*DeclNode>(&g.gfns, d);              // generic fn — monomorphized on demand
        } else if ((d.kind == DK_FUNCTION || d.kind == DK_EXTERN || d.kind == DK_INTRINSIC)
                   && cg_seen_inst(g, cg_cat("fn:", d.name)) == 0) {
            List_push<string>(&g.inst_seen, cg_cat("fn:", d.name));   // dedup (same extern in 2 stdlib files)
            let f: CgFn;
            f.name = d.name;
            f.retty = cg_lltype(g, d.ret_type);
            f.rety = d.ret_type;
            f.variadic = 0;
            string fixed = "";
            int np = List_len<Param>(&d.params);
            int pi = 0;
            int first = 1;
            List_init<string>(&f.ptys, np);
            List_init<string>(&f.petys, np);
            while (pi < np) {
                Param pm = List_get<Param>(&d.params, pi);
                if (cg_streq(pm.ty, "...") == 1) { f.variadic = 1; }
                else {
                    string plt = cg_lltype(g, pm.ty);
                    // A C function's fn-typed parameter is a C function pointer (`ptr`).
                    if (d.kind == DK_EXTERN && cg_prog_defines(prog, d.name) == 0
                        && cg_is_fnty(cg_dealias(g, pm.ty)) == 1) { plt = "ptr"; }
                    List_push<string>(&f.ptys, plt);
                    List_push<string>(&f.petys, pm.ty);
                    if (first == 0) { fixed = cg_cat(fixed, ", "); }
                    fixed = cg_cat(fixed, plt);
                    first = 0;
                }
                pi = pi + 1;
            }
            f.fixedtypes = fixed;
            List_push<CgFn>(&g.fns, f);
            string lowered = "";
            if (d.kind == DK_EXTERN && cg_prog_defines(prog, d.name) == 0) { lowered = cg_cabi_declare(g, d); }   // by-value aggregates: C ABI
            if (lowered[0] != 0) {
                String_append(&g.globals, lowered);
            } else if (d.kind == DK_EXTERN && cg_prog_defines(prog, d.name) == 0) {       // emit a declaration the calls can reference
                String_append(&g.globals, "declare ");
                String_append(&g.globals, f.retty);
                String_append(&g.globals, " @");
                String_append(&g.globals, f.name);
                String_append(&g.globals, "(");
                if (f.variadic == 1) { String_append(&g.globals, cg_va(fixed)); }
                else { String_append(&g.globals, fixed); }
                String_append(&g.globals, ")\n");
            }
        }
        i = i + 1;
    }
    // Pass 2b: register struct methods under their mangled name `Struct_method`.
    i = 0;
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_STRUCT && List_len<TypeParam>(&d.type_params) == 0) {
            int mi = 0;
            int mn = List_len<*DeclNode>(&d.methods);
            while (mi < mn) {
                *DeclNode m = List_get<*DeclNode>(&d.methods, mi);
                let mf: CgFn;
                mf.name = cg_cat(cg_cat(d.name, "_"), m.name);
                mf.retty = cg_lltype(g, m.ret_type);
                mf.rety = m.ret_type;
                mf.variadic = 0;
                mf.fixedtypes = "";
                int mnp = List_len<Param>(&m.params);
                List_init<string>(&mf.ptys, mnp + 1);
                List_init<string>(&mf.petys, mnp + 1);
                List_push<string>(&mf.ptys, "ptr");        // implicit self
                List_push<string>(&mf.petys, cg_cat("*", d.name));
                int mpi = 0;
                while (mpi < mnp) {
                    List_push<string>(&mf.ptys, cg_lltype(g, List_get<Param>(&m.params, mpi).ty));
                    List_push<string>(&mf.petys, List_get<Param>(&m.params, mpi).ty);
                    mpi = mpi + 1;
                }
                List_push<CgFn>(&g.fns, mf);
                mi = mi + 1;
            }
        }
        i = i + 1;
    }

    i = 0;
    while (i < n) { cg_decl(g, List_get<*DeclNode>(&prog.decls, i)); i = i + 1; }

    // Emit generic instantiations, lambda bodies, and fn-ptr thunks. A lambda body can
    // queue fresh instantiations (a generic call under a captured type-param) and an
    // instantiation can queue fresh lambdas, so alternate to a fixpoint (persistent
    // cursors make each drain resume where it left off, never re-emitting).
    cg_drain_worklist(g);
    cg_drain_lambdas(g);
    cg_drain_thunks(g);
    while (g.wl_i < List_len<CgInst>(&g.worklist)
        || g.lam_i < List_len<CgLambda>(&g.lambdas)
        || g.thk_i < List_len<string>(&g.fnthunks)) {
        cg_drain_worklist(g);
        cg_drain_lambdas(g);
        cg_drain_thunks(g);
    }

    if (g.uses_heap_env == 1 && cg_seen_inst(g, "fn:malloc") == 0) {   // closures' env malloc
        String_append(&g.globals, "declare ptr @malloc(i64)\n");
        List_push<string>(&g.inst_seen, "fn:malloc");
    }

    if (g.uses_trap == 1 && cg_seen_inst(g, "fn:trap") == 0) {         // --safe bounds-check trap
        String_append(&g.globals, "declare void @llvm.trap()\n");
        List_push<string>(&g.inst_seen, "fn:trap");
    }

    if (g.uses_eh == 1) {   // Itanium EH runtime (declared once, only when used)
        String_append(&g.globals, "declare i32 @"); String_append(&g.globals, cg_eh_pers(g)); String_append(&g.globals, "(...)\n");
        String_append(&g.globals, "@_ZTIPv = external global ptr\n");
        String_append(&g.globals, "declare ptr @__cxa_allocate_exception(i64)\n");
        String_append(&g.globals, "declare void @__cxa_throw(ptr, ptr, ptr)\n");
        String_append(&g.globals, "declare ptr @__cxa_begin_catch(ptr)\n");
        String_append(&g.globals, "declare void @__cxa_end_catch()\n");
        String_append(&g.globals, "declare void @__cxa_rethrow()\n");
        String_append(&g.globals, "declare i32 @strcmp(ptr, ptr)\n");
    }
}
