// Part of sema.esk (canonical spellings and assignability), imported from it in order; compile sema.esk, not this file alone.

// ── canonical type spellings and assignability (mirrors isValidAssignment) ──

int sema_is_idc(int c) {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
        return 1;
    }
    return 0;
}

int sema_slen(string t) {
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    return n;
}

// `t` without spaces, `const` words and a leading nullable `?` (the qualifiers do not
// change which conversions are allowed; const-dropping and nullability are checked apart).
string sema_bare(string t) {
    int n = sema_slen(t);
    String out;
    String_init(&out, n + 1);
    int i = 0;
    if (n > 0 && (int)t[0] == 63) {
        i = 1;
    }
    while (i < n) {
        int c = (int)t[i];
        if (c == 32) {
            i = i + 1;
        }
        else if (sema_is_idc(c) == 1) {
            int st = i;
            while (i < n && sema_is_idc((int)t[i]) == 1) {
                i = i + 1;
            }
            string w = sema_sub_str(t, st, i);
            if (sema_streq(w, "const") == 0) {
                String_append(&out, w);
            }
        } else {
            String_push(&out, (char)c);
            i = i + 1;
        }
    }
    return (string)String_cstr(&out);
}

// Return type of a fn-type spelling "fn(A,B)->R" ("" if not one).
string sema_fn_ret(string t) {
    if (sema_is_fn_type(t) == 0) {
        return "";
    }
    int i = 3;
    int depth = 0;
    int n = sema_slen(t);
    while (i < n) {
        int c = (int)t[i];
        if (c == 91) {
            i = sema_dim_close(t, i);
            if (i >= n) {
                return "";
            }
        }
        else if (c == 40 || c == 60) {
            depth = depth + 1;
        }
        else if (c == 62 && (int)t[i - 1] == 45) {}
        else if (c == 41 || c == 62 || c == 93) {
            if (depth == 0) {
                if (i + 3 <= n) {
                    return sema_trim_sub(t, i + 3, n);
                }
                return "";
            }
            depth = depth - 1;
        }
        i = i + 1;
    }
    return "";
}

// Index of the first array bracket of `t` outside `<...>` / `(...)`, or -1.
int sema_arr_bracket(string t) {
    int i = 0;
    int depth = 0;
    int br = 0;
    int run = -1;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (br > 0) {
            if (c == 91) {
                br = br + 1;
            }
            else if (c == 93) {
                br = br - 1;
            }
        }
        else if (c == 60 || c == 40) {
            depth = depth + 1;
        }
        else if ((c == 62 && (i == 0 || (int)t[i - 1] != 45)) || c == 41) {
            depth = depth - 1;
        }
        else if (c == 91 && depth == 0) {
            if (!(run >= 0 && i > 0 && (int)t[i - 1] == 93)) {
                run = i;
            }
            br = 1;
        }
        i = i + 1;
    }
    return run;
}

// A classic enum (no type parameters, no payloads): its values are `int`s.
int sema_is_plain_enum_decl(*DeclNode d) {
    if (d == null || d.kind != DK_ENUM || List_len<TypeParam>(&d.type_params) > 0) {
        return 0;
    }
    if (ast_enum_has_payload(d) == 1) {
        return 0;
    }
    return 1;
}

string sema_canon_d(Sema* s, string t, int d);

// The canonical spelling of a type (mirrors normalizeType): qualifiers dropped, pointer
// stars in front, type aliases expanded, a classic enum as `int`, `int32` as `int`.
// Two types are the same exactly when their canonical spellings are equal.
string sema_canon(Sema* s, string t0) {
    if (t0 == null) {
        return "";
    }
    return sema_canon_d(s, sema_bare(t0), 0);
}

string sema_canon_d(Sema* s, string t, int d) {
    if (t[0] == 0 || d > 24) {
        return t;
    }
    int n = sema_slen(t);
    if (sema_is_fn_type(t) == 1) {
        List<string> ps;
        List_init<string>(&ps, 4);
        sema_fn_params(t, &ps);
        string out = "fn(";
        int i = 0;
        while (i < List_len<string>(&ps)) {
            if (i > 0) {
                out = sema_cat(out, ",");
            }
            out = sema_cat(out, sema_canon_d(s, List_get<string>(&ps, i), d + 1));
            i = i + 1;
        }
        return sema_cat(sema_cat(out, ")->"), sema_canon_d(s, sema_fn_ret(t), d + 1));
    }
    int br = sema_arr_bracket(t);
    if (br > 0) {
        // An array of an array alias (`type Arr = int[3]; Arr[2]`) is 2 arrays of 3: the
        // outer dimension goes in front of the element's (C order, leftmost is outermost).
        string ce = sema_canon_d(s, sema_sub_str(t, 0, br), d + 1);
        int cen = sema_slen(ce);
        int eb = sema_arr_bracket(ce);
        if (eb > 0 && cen > 0 && (int)ce[cen - 1] == 93) {
            return sema_cat(sema_cat(sema_sub_str(ce, 0, eb), sema_sub_str(t, br, n)), sema_sub_str(ce, eb, cen));
        }
        return sema_cat(ce, sema_sub_str(t, br, n));
    }
    int a = 0;
    while ((int)t[a] == 42) {
        a = a + 1;
    }
    int b = n;
    while (b > a && (int)t[b - 1] == 42) {
        b = b - 1;
    }
    int stars = a + (n - b);
    string inner = sema_sub_str(t, a, b);
    string ci = inner;
    if (stars > 0) {
        ci = sema_canon_d(s, inner, d + 1);
    }
    else if (sema_has_lt(inner) == 1) {
        List<string> targs;
        List_init<string>(&targs, 2);
        sema_parse_targs(inner, &targs);
        ci = sema_cat(sema_base_name(inner), "<");
        int i = 0;
        while (i < List_len<string>(&targs)) {
            if (i > 0) {
                ci = sema_cat(ci, ",");
            }
            ci = sema_cat(ci, sema_canon_d(s, List_get<string>(&targs, i), d + 1));
            i = i + 1;
        }
        ci = sema_cat(ci, ">");
    } else {
        if (sema_streq(inner, "int32") == 1) {
            return "int";
        }
        if (sema_streq(inner, "uint32") == 1) {
            return "uint";
        }
        *DeclNode td = sema_find_tdecl(s, inner);
        if (td != null && td.kind == DK_TYPEALIAS && sema_in_list(&s.tparams, inner) == 0) {
            return sema_canon_d(s, sema_bare(td.ret_type), d + 1);
        }
        if (sema_is_plain_enum_decl(td) == 1) {
            return "int";
        }
    }
    int k = 0;
    // A pointer to an alias of an array (`*AI`, `type AI = int[3]`) is `int[3]*`: a leading
    // star would bind looser than the array suffix (an array of pointers).
    int cn = sema_slen(ci);
    if (cn > 0 && (int)ci[cn - 1] == 93) {
        while (k < stars) {
            ci = sema_cat(ci, "*");
            k = k + 1;
        }
        return ci;
    }
    while (k < stars) {
        ci = sema_cat("*", ci);
        k = k + 1;
    }
    return ci;
}

int sema_c_ptr(string c) {
    int n = 0;
    while (c[n] != 0) {
        n = n + 1;
    }
    if (n > 0 && (int)c[n - 1] == 93) {    // `*T[N]` is an array of pointers
        return 0;
    }
    if (c[0] == 42 || sema_streq(c, "string") == 1) {
        return 1;
    }
    return 0;
}

// Is canonical type `c` fully understood here (every name a declared, fully applied
// type), so a conversion to or from it can be judged? A pointer always is (every
// pointer converts to every other); a type parameter or an unknown name is not.
int sema_judgeable(Sema* s, string c) {
    if (c == null || c[0] == 0 || sema_streq(c, "unknown") == 1) {
        return 0;
    }
    if ((int)c[0] == 42) {
        return 1;
    }
    if (sema_is_fn_type(c) == 1) {
        List<string> ps;
        List_init<string>(&ps, 4);
        sema_fn_params(c, &ps);
        int i = 0;
        while (i < List_len<string>(&ps)) {
            if (sema_judgeable(s, List_get<string>(&ps, i)) == 0) {
                return 0;
            }
            i = i + 1;
        }
        return sema_judgeable(s, sema_fn_ret(c));
    }
    int br = sema_arr_bracket(c);
    if (br > 0) {
        int n = sema_slen(c);
        string dims = sema_sub_str(c, br, n);
        int i = 0;
        while (dims[i] != 0) {
            int ch = (int)dims[i];
            if (ch != 91 && ch != 93 && (ch < 48 || ch > 57)) {   // a named dimension: not compared
                return 0;
            }
            i = i + 1;
        }
        return sema_judgeable(s, sema_sub_str(c, 0, br));
    }
    if (sema_is_numeric_ty(c) == 1 || sema_streq(c, "string") == 1 || sema_streq(c, "void") == 1
        || sema_streq(c, "null") == 1) {
        return 1;
    }
    string base = sema_base_name(c);
    if (sema_in_list(&s.tparams, base) == 1) {
        return 0;
    }
    *DeclNode d = sema_find_tdecl(s, base);
    if (d == null || d.kind == DK_TYPEALIAS) {
        return 0;
    }
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(c, &targs);
    if (List_len<TypeParam>(&d.type_params) != List_len<string>(&targs)) {
        return 0;
    }
    int i = 0;
    while (i < List_len<string>(&targs)) {
        if (sema_judgeable(s, List_get<string>(&targs, i)) == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// Why a value of type `src0` cannot be stored in a `t0` slot ("" when it can, or when
// either type is not understood well enough to judge). Mirrors isValidAssignment and the
// messages of assignabilityError past its literal/const/nullable special cases.
// Two pointer types convert implicitly only when they point at the same type (C): a
// `*void` on either side converts to and from any pointer, and the byte pointers
// (`string`, `*char`, `*int8`, `*uint8`) interconvert. A pointee the checker cannot
// judge (a type parameter, an unknown name) is not judged. Mirrors the C++
// pointeesCompatible.
// `int32` is another spelling of `int`, and `uint32` of `uint`.
string sema_int32_as_int(string t) {
    if (sema_streq(t, "int32") == 1) {
        return "int";
    }
    if (sema_streq(t, "uint32") == 1) {
        return "uint";
    }
    return t;
}

int sema_is_byte_ptr(string t) {
    return sema_streq(t, "string") == 1 || sema_streq(t, "*char") == 1 || sema_streq(t, "*int8") == 1
        || sema_streq(t, "*uint8") == 1;
}

// The array type `t` points at when it is spelled `X[..]*` (a pointer to an array), else "".
string sema_arr_ptr_pointee(string t) {
    int n = sema_slen(t);
    if (n < 2 || (int)t[n - 1] != 42 || (int)t[0] == 42) {
        return "";
    }
    int b = n;
    while (b > 0 && (int)t[b - 1] == 42) {
        b = b - 1;
    }
    if (b == 0 || (int)t[b - 1] != 93) {
        return "";
    }
    if (n - b != 1) {
        return "";
    }
    return sema_sub_str(t, 0, b);
}

int sema_ptr_compat(Sema* s, string a0, string b0) {
    string a = sema_strip_const(sema_strip_nullable(sema_canon(s, a0)));
    string b = sema_strip_const(sema_strip_nullable(sema_canon(s, b0)));
    if (sema_streq(a, b) == 1) {
        return 1;
    }
    // An array suffix binds tighter than a leading star: `*T[N]` is an array, no pointer.
    if (sema_slen(a) > 0 && (int)a[sema_slen(a) - 1] == 93) {
        return 0;
    }
    if (sema_slen(b) > 0 && (int)b[sema_slen(b) - 1] == 93) {
        return 0;
    }
    if (sema_streq(a, "*void") == 1 || sema_streq(b, "*void") == 1) {
        return 1;
    }
    if (sema_is_byte_ptr(a) == 1 && sema_is_byte_ptr(b) == 1) {
        return 1;
    }
    if (sema_streq(a, "string") == 1 || sema_streq(b, "string") == 1) {
        return 0;
    }
    // A pointer to an array (`int[4]*`, the type of `&arr`) points at the array type.
    string aa = sema_arr_ptr_pointee(a);
    string ab = sema_arr_ptr_pointee(b);
    if (aa[0] != 0 || ab[0] != 0) {
        if (aa[0] == 0 && (int)a[0] == 42) {
            aa = sema_sub_str(a, 1, sema_slen(a));
        }
        if (ab[0] == 0 && (int)b[0] == 42) {
            ab = sema_sub_str(b, 1, sema_slen(b));
        }
        if (aa[0] == 0 || ab[0] == 0) {
            return 1;
        }
        if (sema_streq(sema_canon(s, aa), sema_canon(s, ab)) == 1) {
            return 1;
        }
        if (sema_judgeable(s, sema_canon(s, aa)) == 1 && sema_judgeable(s, sema_canon(s, ab)) == 1) {
            return 0;
        }
        return 1;
    }
    if ((int)a[0] != 42 || (int)b[0] != 42) {            // not a leading-star spelling: not judged
        return 1;
    }
    string pa = sema_strip_const(sema_strip_nullable(sema_sub_str(a, 1, sema_slen(a))));
    string pb = sema_strip_const(sema_strip_nullable(sema_sub_str(b, 1, sema_slen(b))));
    if ((int)pa[0] == 42 && (int)pb[0] == 42) {
        return sema_ptr_compat(s, pa, pb);
    }
    if (sema_streq(pa, pb) == 1) {
        return 1;
    }
    if (sema_judgeable(s, pa) == 0 || sema_judgeable(s, pb) == 0) {
        return 1;
    }
    if (sema_streq(sema_int32_as_int(pa), sema_int32_as_int(pb)) == 1) {
        return 1;
    }
    return 0;
}

string sema_assign_strict(Sema* s, string t0, string src0) {
    string ct = sema_canon(s, t0);
    string cs = sema_canon(s, src0);
    if (sema_judgeable(s, ct) == 0 || sema_judgeable(s, cs) == 0) {
        return "";
    }
    if (sema_streq(ct, cs) == 1) {
        return "";
    }
    string conv = sema_cat(sema_cat(sema_cat(sema_cat("cannot convert '", src0), "' to '"), t0), "'");
    if (sema_is_numeric_ty(ct) == 1 && sema_is_numeric_ty(cs) == 1) {
        if (sema_is_int_ty(ct) == 1 && sema_is_float_ty(cs) == 1) {
            return sema_cat(sema_cat(sema_cat(sema_cat("cannot assign a floating-point value ('", src0), "') to integer type '"), t0),
                            "' without an explicit cast (it drops the fraction)");
        }
        return "";
    }
    int tp = sema_c_ptr(ct);
    int sp = sema_c_ptr(cs);
    *DeclNode ifc = sema_find_iface(s, ct);
    if (sema_streq(cs, "null") == 1 && tp == 1) {
        return "";
    }
    if (sema_streq(cs, "null") == 1 && ifc != null) {   // the empty interface value
        return "";
    }
    if (sema_is_fn_type(ct) == 1 || sema_is_fn_type(cs) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("incompatible function type '", src0), "' for '"), t0), "'");
    }
    if (tp == 1 && sp == 1) {
        if (sema_ptr_compat(s, ct, cs) == 1) {
            return "";
        }
        return conv;
    }
    if (ifc != null) {
        if (sp == 0 && sema_is_struct(s, sema_base_name(cs)) == 1) {
            return sema_cat(sema_cat(sema_cat(sema_cat("cannot convert struct '", src0), "' to interface '"), t0), "' by value; pass a pointer (&x)");
        }
        string nom = cs;
        while ((int)nom[0] == 42) {
            nom = sema_sub_str(nom, 1, sema_slen(nom));
        }
        string why = sema_iface_mismatch_full(s, sema_base_name(nom), nom, ifc);
        if (why[0] == 0 && sp == 1) {
            return "";
        }
        if (why[0] != 0) {
            return sema_cat(sema_cat(sema_cat(sema_cat(sema_cat("'", src0), "' does not satisfy interface '"), t0), "': "), why);
        }
    }
    return conv;
}

// Conservative assignability of expression `e` to declared type `t` (mirrors the error
// cases of the C++ assignabilityError). Returns "" when OK or when either side is not
// understood well enough to judge (so a valid program is never falsely rejected).
string sema_assign_err(Sema* s, string ta0, *ExprNode e) {
    if (e == null || ta0 == null || ta0[0] == 0) {
        return "";
    }
    string t0 = sema_nullable_alias(s, ta0);
    string t = sema_strip_const(t0);
    string tc = sema_canon(s, t0);
    if (sema_find_iface(s, t) != null) {   // nullable / pointer-depth / const boxing rules
        int had0 = s.had_error;
        s.had_error = 0;
        sema_check_iface_value(s, t, e);
        int hit = s.had_error;
        s.had_error = had0 | hit;
        if (hit == 1) {
            return "";
        }
    }
    if (sema_is_int_ty(tc) == 1 && e.kind == EK_LITERAL && e.lit_kind == LIT_INT
        && sema_int_lit_fits(tc, e.sval) == 0) {
        return sema_cat(sema_cat(sema_cat(sema_cat("integer literal ", e.sval), " is out of range for '"), t), "'");
    }
    if (sema_is_int_ty(tc) == 1 && e.kind == EK_TERNARY) {   // each literal arm of a `?:` must fit
        string ta = sema_assign_err(s, t0, e.b);
        if (ta[0] != 0 && e.b != null && e.b.kind == EK_LITERAL) {
            return ta;
        }
        *ExprNode ee = List_get<*ExprNode>(&e.kids, 0);
        string tb = sema_assign_err(s, t0, ee);
        if (tb[0] != 0 && ee != null && ee.kind == EK_LITERAL) {
            return tb;
        }
    }
    string src0 = sema_infer_type(s, e);
    // A nullable `?*T` into a non-null pointer drops the check (`*T`/`null` -> `?*T` is fine).
    if (src0[0] == 63 && t0[0] != 63 && sema_c_ptr(sema_canon(s, t0)) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("assigning a nullable pointer '", src0), "' to non-null '"), t0),
                        "' requires a null-check (e.g. `if (x != null)`)");
    }
    // A pointer to a nullable pointer (`*?*T`) keeps the check on what it points to.
    if ((int)src0[0] == 42 && (int)t0[0] == 42 && (int)src0[1] == 63 && (int)t0[1] != 63 && t0[1] != 0
        && sema_c_ptr(sema_canon(s, sema_sub_str(t0, 1, sema_slen(t0)))) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("conversion drops the nullable pointee of '", src0), "' ('"), t0),
                        "' points to a non-null pointer)");
    }
    if (sema_pointee_const(src0) == 1 && sema_has_star(t0) == 1 && sema_pointee_const(t0) == 0
        && sema_is_fn_type(t0) == 0) {
        return sema_cat(sema_cat(sema_cat(sema_cat("conversion discards a const qualifier ('", src0), "' to '"), t0), "')");
    }
    string src = sema_strip_const(src0);
    if (src[0] == 0 || sema_streq(src, "unknown") == 1 || sema_streq(src, t) == 1) {
        return "";
    }
    string conv = sema_cat(sema_cat(sema_cat(sema_cat("cannot convert '", src), "' to '"), t), "'");
    if (sema_streq(src, "void") == 1) {
        return sema_cat(sema_cat("cannot convert 'void' to '", t0), "'");
    }
    if (sema_is_int_ty(t) == 1 && sema_is_float_ty(src) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("cannot assign a floating-point value ('", src), "') to integer type '"), t0),
                        "' without an explicit cast (it drops the fraction)");
    }
    // A pointer to an array (`&arr` is `int[4]*`) is not a number, nor a pointer to
    // anything but that array type (or `*void`).
    string sap = sema_arr_ptr_pointee(sema_canon(s, src));
    if (sap[0] != 0) {
        if (sema_is_numeric_ty(tc) == 1) {
            return conv;
        }
        if ((int)tc[0] == 42 && sema_ptr_compat(s, tc, sema_canon(s, src)) == 0) {
            return conv;
        }
    }
    int tnum = sema_is_numeric_ty(t);
    int snum = sema_is_numeric_ty(src);
    int tptr = 0;
    if (t[0] != 63 && sema_is_fn_type(t) == 0 && sema_is_ptrish(t) == 1 && sema_is_arr_ty(t) == 0) {
        tptr = 1;
    }
    int sptr = 0;
    if (sema_is_fn_type(src) == 0 && sema_is_ptrish(src) == 1 && sema_streq(src, "null") == 0 && sema_is_arr_ty(src) == 0) {
        sptr = 1;
    }
    if (tnum == 1 && sptr == 1) {
        return conv;
    }
    if (tptr == 1 && snum == 1) {
        return conv;
    }
    // A struct value where a pointer is expected, or a pointer where a struct value is.
    if (tptr == 1 && sema_is_struct(s, src) == 1) {
        return conv;
    }
    if (sptr == 1 && sema_is_struct(s, t) == 1) {
        return conv;
    }
    if ((tnum == 1 && sema_is_struct_value(s, src) == 1) || (snum == 1 && sema_is_struct_value(s, t) == 1)) {
        return conv;
    }
    if (sema_is_fn_type(t) == 1 && sema_is_fn_type(src) == 1 && sema_streq(sema_canon(s, t), sema_canon(s, src)) == 0) {
        return sema_cat(sema_cat(sema_cat(sema_cat("incompatible function type '", src), "' for '"), t), "'");
    }
    // A function value (a variadic one too, whose `...` is not otherwise judged) into a
    // value that is neither a closure nor a pointer.
    if (sema_is_fn_type(src) == 1 && sema_is_fn_type(tc) == 0 && sema_c_ptr(tc) == 0 && sema_judgeable(s, tc) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("incompatible function type '", src), "' for '"), t), "'");
    }
    return sema_assign_strict(s, t0, src0);
}

// Two type spellings that are both primitive and differ (a certain mismatch). Anything
// else (structs, pointers, aliases) is not compared, to stay conservative.
int sema_prim_differs(string a0, string b0) {
    string a = sema_strip_const(a0);
    string b = sema_strip_const(b0);
    int ap = sema_is_numeric_ty(a);
    if (sema_streq(a, "void") == 1 || sema_streq(a, "string") == 1) {
        ap = 1;
    }
    int bp = sema_is_numeric_ty(b);
    if (sema_streq(b, "void") == 1 || sema_streq(b, "string") == 1) {
        bp = 1;
    }
    if (ap == 1 && bp == 1 && sema_streq(a, b) == 0) {
        return 1;
    }
    return 0;
}

// Is type spelling `t` the interface's own name (its Self type)?
int sema_is_self_ty(string t, *DeclNode iface) {
    return sema_streq(sema_struct_of_type(t), iface.name);
}

// Do two spellings name different types (compared only when both are understood)?
int sema_types_differ(Sema* s, string a, string b) {
    string ca = sema_canon(s, a);
    string cb = sema_canon(s, b);
    if (sema_judgeable(s, ca) == 0 || sema_judgeable(s, cb) == 0) {
        return 0;
    }
    if (sema_streq(ca, cb) == 1) {
        return 0;
    }
    return 1;
}

// An implementation's type `a` against the interface's `b`: the C++ compares the
// normalized spellings, so a concrete `a` must match a `b` the checker cannot judge (an
// undeclared `Self`) literally. An unresolved `a` (a generic's `T`) is not judged.
int sema_iface_types_differ(Sema* s, string a, string b) {
    string ca = sema_canon(s, a);
    string cb = sema_canon(s, b);
    if (sema_judgeable(s, ca) == 0 || sema_judgeable(s, cb) == 1) {
        return sema_types_differ(s, a, b);
    }
    if (sema_streq(ca, cb) == 1) {
        return 0;
    }
    return 1;
}

// Does type `sn` implement every method of `iface` with a matching signature (arity,
// return and parameter types; a type naming the interface itself is its Self type)?
// A struct implements a method inline or as a free `Type_method`; a scalar primitive
// through a free function named like the method whose first parameter is it. "" when
// satisfied, else the reason. Mirrors the C++ interfaceMismatch.
string sema_iface_mismatch_full(Sema* s, string sn, string full, *DeclNode iface);
string sema_iface_mismatch(Sema* s, string sn, *DeclNode iface) {
    return sema_iface_mismatch_full(s, sn, sn, iface);
}

// `full` is the type as written (`Ctr<int>`), `sn` its base name: a generic instance
// may implement a method as a free function named after the instance (`Ctr_int_next`).
string sema_iface_mismatch_full(Sema* s, string sn, string full, *DeclNode iface) {
    *DeclNode sd = sema_find_struct(s, sn);
    int i = 0;
    int n = List_len<*DeclNode>(&iface.methods);
    while (i < n) {
        *DeclNode m = List_get<*DeclNode>(&iface.methods, i);
        *DeclNode impl = null;
        int skip = 0;
        if (sd != null) {
            int j = 0;
            int mn = List_len<*DeclNode>(&sd.methods);
            while (j < mn) {
                *DeclNode c = List_get<*DeclNode>(&sd.methods, j);
                if (sema_streq(c.name, m.name) == 1) {
                    impl = c;
                }
                j = j + 1;
            }
        }
        if (impl == null) {
            impl = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), m.name));
            skip = 1;
        }
        if (impl == null && sema_has_lt(full) == 1) {
            impl = sema_find_fndecl(s, sema_cat(sema_cat(sema_flat_name(full), "_"), m.name));
            skip = 1;
        }
        if (impl == null && sema_is_scalar_prim(sn) == 1) {
            *DeclNode ff = sema_find_fndecl(s, m.name);
            if (ff != null && List_len<Param>(&ff.params) > 0
                && sema_streq(sema_struct_of_type(List_get<Param>(&ff.params, 0).ty), sn) == 1) {
                impl = ff;
            }
        }
        if (impl == null) {
            return sema_cat(sema_cat("missing method '", m.name), "'");
        }
        sema_note_call(s, impl.name);      // -Wall: used through the interface's vtable
        int want = List_len<Param>(&m.params);
        int got = List_len<Param>(&impl.params) - skip;
        if (got != want) {
            uint8[96] buf;
            sprintf((string)&buf[0], "' takes %d parameter(s), the interface requires %d", got, want);
            return sema_cat(sema_cat("method '", m.name), (string)&buf[0]);
        }
        if (sema_is_self_ty(m.ret_type, iface) == 0 && sema_iface_types_differ(s, impl.ret_type, m.ret_type) == 1) {
            return sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat("method '", m.name), "' returns '"), impl.ret_type),
                            "', the interface requires '"), m.ret_type), "'");
        }
        int k = 0;
        while (k < want) {
            string wt = List_get<Param>(&m.params, k).ty;
            string gt = List_get<Param>(&impl.params, k + skip).ty;
            int selfp = sema_is_self_ty(wt, iface);
            // A Self parameter is the implementing type (or the interface itself).
            int self_bad = 0;
            if (selfp == 1) {
                string gb = sema_struct_of_type(gt);
                string gc = sema_struct_of_type(sema_canon(s, gt));
                string sb = sema_base_name(sn);
                if (sema_streq(gb, iface.name) == 0 && sema_streq(gb, sb) == 0 && sema_streq(gc, sb) == 0
                    && sema_streq(sema_base_name(gb), sb) == 0) {
                    self_bad = 1;
                }
            }
            if (self_bad == 1 || (selfp == 0 && sema_iface_types_differ(s, gt, wt) == 1)) {
                uint8[32] nb;
                sprintf((string)&nb[0], "%d", k + 1);
                return sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat("method '", m.name), "' parameter "),
                                (string)&nb[0]), " is '"), gt), "', the interface requires '"), wt), "'");
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return "";
}

// Parameter types of a fn-type spelling "fn(A,B)->R" into `out` (nesting-aware).
void sema_fn_params(string t, List<string>* out) {
    if (sema_is_fn_type(t) == 0) {
        return;
    }
    int i = 3;
    int depth = 0;
    int start = 3;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (c == 91) {   // an array dimension
            i = sema_dim_close(t, i);
            if (t[i] == 0) {
                return;
            }
        }
        else if (c == 40 || c == 60) {                  // ( <
            depth = depth + 1;
        }
        else if (c == 62 && (int)t[i - 1] == 45) {}                         // "->" arrow
        else if (c == 41 || c == 62 || c == 93) {                            // ) > ]
            if (depth == 0) {
                if (i > start) {
                    List_push<string>(out, sema_trim_sub(t, start, i));
                }
                return;
            }
            depth = depth - 1;
        } else if (c == 44 && depth == 0) {
            List_push<string>(out, sema_trim_sub(t, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
}

// The arguments of `e` from index `from` on pass through `...`: each must have a value
// (a `void` call has none).
void sema_check_variadic_extras(Sema* s, *ExprNode e, int from) {
    int i = from;
    while (i < List_len<*ExprNode>(&e.kids)) {
        if (sema_streq(sema_canon(s, sema_infer_type(s, List_get<*ExprNode>(&e.kids, i))), "void") == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: argument %d has type 'void' (a void call has no value)\n", s.filename, s.line, s.col, i + 1);
        }
        i = i + 1;
    }
}

// -Wformat (mirrors the C++ checkFormatCall): the classes a printf conversion takes after
// C's default promotions: 1 int, 2 64-bit integer, 3 double, 4 string, 5 pointer, 6 other.
int sema_fmt_class(Sema* s, *ExprNode a) {
    if (a != null && a.kind == EK_LITERAL && a.lit_kind == LIT_NULL) {
        return 5;
    }
    string t = sema_canon(s, sema_infer_type(s, a));
    if ((int)t[0] == 63) {
        t = sema_sub_str(t, 1, sema_slen(t));
    }
    if (sema_streq(t, "bool") == 1 || sema_streq(t, "char") == 1 || sema_streq(t, "int8") == 1 || sema_streq(t, "uint8") == 1
        || sema_streq(t, "int16") == 1 || sema_streq(t, "uint16") == 1 || sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1
        || sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) {
        return 1;
    }
    if (sema_is_enum(s, sema_struct_of_type(t)) == 1 && sema_has_star(t) == 0) {
        return 1;
    }
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) {
        return 2;
    }
    if (sema_streq(t, "float") == 1 || sema_streq(t, "double") == 1) {
        return 3;
    }
    if (sema_streq(t, "string") == 1) {
        return 4;
    }
    if (sema_c_ptr(t) == 1) {
        if (sema_is_byte_ptr(t) == 1) {
            return 4;
        }
        return 5;
    }
    return 6;
}

// The format argument's index among a printf-style function's arguments, or -1.
int sema_fmt_index(string fname) {
    if (sema_streq(fname, "printf") == 1 || sema_streq(fname, "log_trace") == 1 || sema_streq(fname, "log_debug") == 1
        || sema_streq(fname, "log_info") == 1 || sema_streq(fname, "log_warn") == 1 || sema_streq(fname, "log_error") == 1) {
        return 0;
    }
    if (sema_streq(fname, "fprintf") == 1 || sema_streq(fname, "dprintf") == 1 || sema_streq(fname, "sprintf") == 1
        || sema_streq(fname, "String_format") == 1 || sema_streq(fname, "String_appendf") == 1 || sema_streq(fname, "log_at") == 1) {
        return 1;
    }
    if (sema_streq(fname, "snprintf") == 1) {
        return 2;
    }
    return -1;
}

int sema_fmt_need(Sema* s, *ExprNode e, int next, int cls, string conv, int shift) {
    int argc = List_len<*ExprNode>(&e.kids);
    if (next >= argc) {
        return next + 1;
    }
    *ExprNode a = List_get<*ExprNode>(&e.kids, next);
    int got = sema_fmt_class(s, a);
    if (got == cls || (cls == 5 && got == 4)) {
        return next + 1;
    }
    string at = sema_canon(s, sema_infer_type(s, a));
    if (sema_streq(at, "unknown") == 1 || sema_streq(at, "void") == 1 || at[0] == 0) {
        return next + 1;
    }
    string what = "an int";
    if (cls == 2) {
        what = "a 64-bit integer";
    }
    if (cls == 3) {
        what = "a double";
    }
    if (cls == 4) {
        what = "a string";
    }
    if (cls == 5) {
        what = "a pointer";
    }
    sema_warn(s, "format", e.line, e.col,
              sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat("format '", conv), "' expects "), what), ", but argument "),
                       sema_i64_text((int64)(next + 1 + shift))), " has type '"), sema_type_shown(sema_infer_type(s, a))), "'"));
    return next + 1;
}

// A type as diagnostics show it: no `struct:` tags.
string sema_type_shown(string t) {
    let out: String;
    String_init(&out, 16);
    int i = 0;
    int n = sema_slen(t);
    while (i < n) {
        if (i + 7 <= n && sema_streq(sema_sub_str(t, i, i + 7), "struct:") == 1) {
            i = i + 7;
            continue;
        }
        String_push(&out, (char)t[i]);
        i = i + 1;
    }
    return (string)String_cstr(&out);
}

int sema_fmt_is(int c, string set) {
    int i = 0;
    while (set[i] != 0) {
        if ((int)set[i] == c) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

void sema_check_format(Sema* s, *ExprNode e, string fname, int shift) {
    int fi = sema_fmt_index(fname);
    if (fi < 0) {
        return;
    }
    fi = fi - shift;
    int argc = List_len<*ExprNode>(&e.kids);
    if (fi < 0 || fi >= argc) {
        return;
    }
    *ExprNode lit = List_get<*ExprNode>(&e.kids, fi);
    if (lit == null || lit.kind != EK_LITERAL || lit.lit_kind != LIT_STRING) {
        return;
    }
    string f = lit.sval;
    int n = lit.slen;
    int next = fi + 1;
    int i = 0;
    while (i < n) {
        if ((int)f[i] != 37) {
            i = i + 1;
            continue;
        }
        int st = i;
        i = i + 1;
        if (i < n && (int)f[i] == 37) {
            i = i + 1;
            continue;
        }
        while (i < n && sema_fmt_is((int)f[i], "-+ #0'") == 1) {
            i = i + 1;
        }
        if (i < n && (int)f[i] == 42) {
            next = sema_fmt_need(s, e, next, 1, "*", shift);
            i = i + 1;
        }
        else {
            while (i < n && (int)f[i] >= 48 && (int)f[i] <= 57) {
                i = i + 1;
            }
        }
        if (i < n && (int)f[i] == 46) {
            i = i + 1;
            if (i < n && (int)f[i] == 42) {
                next = sema_fmt_need(s, e, next, 1, ".*", shift);
                i = i + 1;
            }
            else {
                while (i < n && (int)f[i] >= 48 && (int)f[i] <= 57) {
                    i = i + 1;
                }
            }
        }
        int ls = i;
        while (i < n && sema_fmt_is((int)f[i], "hlLqjzt") == 1) {
            i = i + 1;
        }
        string len = sema_sub_str(f, ls, i);
        if (i >= n) {
            sema_warn(s, "format", e.line, e.col,
                      sema_cat(sema_cat("incomplete conversion '", sema_sub_str(f, st, n)), "' at the end of the format string"));
            i = n + 1;
            continue;
        }
        int c = (int)f[i];
        string conv = sema_sub_str(f, st, i + 1);
        int wide = 0;
        if (sema_streq(len, "ll") == 1 || sema_streq(len, "j") == 1 || sema_streq(len, "z") == 1
            || sema_streq(len, "t") == 1 || sema_streq(len, "q") == 1) {
            wide = 1;
        }
        if (sema_streq(len, "l") == 1 && s.msbf == 0) {
            wide = 1;
        }
        if (sema_fmt_is(c, "diouxXc") == 1) {
            int cls = 1;
            if (c != 99 && wide == 1) {
                cls = 2;
            }
            next = sema_fmt_need(s, e, next, cls, conv, shift);
        } else if (sema_fmt_is(c, "fFeEgGaA") == 1) {
            next = sema_fmt_need(s, e, next, 3, conv, shift);
        }
        else if (c == 115) {
            next = sema_fmt_need(s, e, next, 4, conv, shift);
        }
        else if (c == 112 || c == 110) {
            next = sema_fmt_need(s, e, next, 5, conv, shift);
        }
        else {
            sema_warn(s, "format", e.line, e.col, sema_cat(sema_cat("unknown conversion '", conv), "' in the format string"));
            return;
        }
        i = i + 1;
    }
    if (next > argc) {
        sema_warn(s, "format", e.line, e.col,
                  sema_cat(sema_cat(sema_cat(sema_cat("the format string needs ", sema_i64_text((int64)(next - fi - 1))), " argument(s), but "),
                           sema_i64_text((int64)(argc - fi - 1))), " are given"));
    } else if (next < argc) {
        sema_warn(s, "format", e.line, e.col,
                  sema_cat(sema_cat(sema_cat(sema_cat("the format string uses ", sema_i64_text((int64)(next - fi - 1))), " argument(s), but "),
                           sema_i64_text((int64)(argc - fi - 1))), " are given"));
    }
}

// Check a call's arguments (`e.kids`) against parameter types `pts` (a trailing "..."
// means variadic): count, then conservative per-argument assignability.
void sema_check_call_args(Sema* s, *ExprNode e, string what, List<string>* pts) {
    int np = List_len<string>(pts);
    int variadic = 0;
    if (np > 0 && sema_streq(List_get<string>(pts, np - 1), "...") == 1) {
        variadic = 1;
        np = np - 1;
    }
    int argc = List_len<*ExprNode>(&e.kids);
    if ((variadic == 1 && argc < np) || (variadic == 0 && argc != np)) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: %s expects %d argument(s), got %d\n", s.filename, s.line, s.col, what, np, argc);
        return;
    }
    int i = 0;
    while (i < np) {
        string perr = sema_assign_err(s, List_get<string>(pts, i), List_get<*ExprNode>(&e.kids, i));
        if (perr[0] != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: argument %d type mismatch: expected %s, got %s (%s)\n", s.filename, s.line, s.col, i + 1,
                   List_get<string>(pts, i), sema_infer_type(s, List_get<*ExprNode>(&e.kids, i)), perr);
        }
        i = i + 1;
    }
    if (variadic == 1) {
        sema_check_variadic_extras(s, e, np);
    }
}

// Index of the '(' opening a lambda signature's parameter list "R(T1 a, T2 b)" (the
// last top-level group, so a fn-typed return `fn(int)->int(int x)` is skipped), or -1.
int sema_lambda_open(string sig) {
    int n = sema_slen(sig);
    if (n == 0 || (int)sig[n - 1] != 41) {
        return -1;
    }
    int depth = 0;
    int i = n - 1;
    while (i >= 0) {
        int c = (int)sig[i];
        if (c == 41) {
            depth = depth + 1;
        }
        else if (c == 40) {
            depth = depth - 1;
            if (depth == 0) {
                return i;
            }
        }
        i = i - 1;
    }
    return -1;
}

// Return type of a lambda signature spelling "R(T1 a, T2 b)".
string sema_lambda_ret(string sig) {
    int i = sema_lambda_open(sig);
    if (i <= 0) {
        return "";
    }
    return sema_trim_sub(sig, 0, i);
}

// Parameter types (into `types`) and names (into `names`) of a lambda signature spelling.
void sema_lambda_sig(string sig, List<string>* types, List<string>* names) {
    int i = sema_lambda_open(sig);
    if (i < 0) {
        return;
    }
    int close = sema_slen(sig) - 1;
    int depth = 0;
    int start = i + 1;
    int j = i + 1;
    while (j <= close) {
        int c = (int)sig[j];
        if (c == 91) {
            j = sema_dim_close(sig, j);
            if (j > close) {
                j = close;
            }
            c = (int)sig[j];
        }
        else if (c == 40 || c == 60) {
            depth = depth + 1;
        }
        else if ((c == 41 && j < close) || (c == 62 && (int)sig[j - 1] != 45)) {
            depth = depth - 1;
        }
        if ((c == 44 && depth == 0) || j == close) {
            string one = sema_trim_sub(sig, start, j);
            int sp = 0;
            int k = 0;
            while (one[k] != 0) {
                if ((int)one[k] == 32) {
                    sp = k;
                }
                k = k + 1;
            }
            if (one[0] != 0) {
                if (sp > 0) {
                    List_push<string>(types, sema_trim_sub(one, 0, sp));
                    List_push<string>(names, sema_trim_sub(one, sp + 1, sema_slen(one)));
                } else {
                    List_push<string>(types, one);
                    List_push<string>(names, "");
                }
            }
            start = j + 1;
        }
        j = j + 1;
    }
}

// Parameter types of a lambda's signature spelling "R(T1 a, T2 b)" into `out`.
void sema_lambda_params(string sig, List<string>* out) {
    List<string> names;
    List_init<string>(&names, 4);
    sema_lambda_sig(sig, out, &names);
}

// A generic function call's argument count must match the declaration. Returns 1 if OK.
int sema_check_generic_arity(Sema* s, *DeclNode fd, *ExprNode e) {
    int np = List_len<Param>(&fd.params);
    int variadic = 0;
    if (np > 0 && sema_streq(List_get<Param>(&fd.params, np - 1).ty, "...") == 1) {
        variadic = 1;
        np = np - 1;
    }
    int argc = List_len<*ExprNode>(&e.kids);
    if ((variadic == 1 && argc < np) || (variadic == 0 && argc != np)) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: function '%s' expects %d argument(s), got %d\n", s.filename, s.line, s.col, fd.name, np, argc);
        return 0;
    }
    return 1;
}

// Does identifier `name` occur as a whole word in type spelling `t`?
int sema_type_mentions(string t, string name) {
    int i = 0;
    while (t[i] != 0) {
        int c = (int)t[i];
        int isid = 0;
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            isid = 1;
        }
        if (isid == 1) {
            int st = i;
            while (t[i] != 0) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) {
                    i = i + 1;
                } else {
                    break;
                }
            }
            if (sema_streq(sema_sub_str(t, st, i), name) == 1) {
                return 1;
            }
        } else {
            i = i + 1;
        }
    }
    return 0;
}

// The type parameters of `fd` that no parameter type mentions (so a call without
// explicit type arguments cannot infer them), comma-joined; "" if all are inferable.
string sema_uninferable_tparam(*DeclNode fd) {
    string out = "";
    int t = 0;
    int tn = List_len<TypeParam>(&fd.type_params);
    while (t < tn) {
        string tp = List_get<TypeParam>(&fd.type_params, t).name;
        int seen = 0;
        int i = 0;
        int np = List_len<Param>(&fd.params);
        while (i < np) {
            if (sema_type_mentions(List_get<Param>(&fd.params, i).ty, tp) == 1) {
                seen = 1;
            }
            i = i + 1;
        }
        if (seen == 0) {
            if (out[0] != 0) {
                out = sema_cat(out, ", ");
            }
            out = sema_cat(out, tp);
        }
        t = t + 1;
    }
    return out;
}

// Index of `name` among `fd`'s type parameters, or -1.
int sema_tparam_index(*DeclNode fd, string name) {
    int i = 0;
    int n = List_len<TypeParam>(&fd.type_params);
    while (i < n) {
        if (sema_streq(List_get<TypeParam>(&fd.type_params, i).name, name) == 1) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// 1 when parameter `i` of `fd` is spelled as the bare type parameter `tp` (`T a`): a
// by-value deduction. The other parameters bind structurally first and take precedence.
int sema_bare_tparam(*DeclNode fd, int i, string tp) {
    return sema_streq(ast_unify_canon(List_get<Param>(&fd.params, i).ty), tp);
}

// The binding of `tp` from the by-value arguments of an inferred generic call: they must
// agree, and integer ones that differ meet at their common type by C's usual arithmetic
// conversions (`maxof(1, big)` is `maxof<int64>`). Any other disagreement is reported
// when `report` is 1 (mirrors the C++). "" when no by-value argument binds it.
string sema_byvalue_bind(Sema* s, *DeclNode fd, *ExprNode e, string tp, int report) {
    string b = "";
    int from = 0;
    int i = 0;
    int n = List_len<*ExprNode>(&e.kids);
    int np = List_len<Param>(&fd.params);
    while (i < n && i < np) {
        if (sema_bare_tparam(fd, i, tp) == 1) {
            string at = sema_value_type(sema_infer_type(s, List_get<*ExprNode>(&e.kids, i)));
            if (at[0] != 0 && sema_streq(at, "null") == 0 && sema_streq(at, "unknown") == 0) {
                at = ast_unify_tparam(List_get<Param>(&fd.params, i).ty, at, tp);
                if (at[0] != 0) {
                    if (b[0] == 0) {
                        b = at;
                        from = i;
                    }
                    else if (sema_streq(sema_canon(s, b), sema_canon(s, at)) == 0) {
                        string common = ast_range_var_type(sema_canon(s, b), sema_canon(s, at));
                        if (common[0] != 0) {
                            b = common;
                        }
                        else if (report == 1) {
                            s.had_error = 1;
                            dprintf(2, "error: %s:%d:%d: argument %d type mismatch: type parameter '%s' is deduced as '%s' from argument %d and as '%s' here\n",
                                   s.filename, s.line, s.col, i + 1, tp, b, from + 1, at);
                            return "";
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return b;
}

// The structural binding of `tp` (from a parameter other than a bare `T a`), or "".
string sema_struct_bind(Sema* s, *DeclNode fd, *ExprNode e, string tp) {
    int i = 0;
    int n = List_len<*ExprNode>(&e.kids);
    int np = List_len<Param>(&fd.params);
    while (i < n && i < np) {
        if (sema_bare_tparam(fd, i, tp) == 0) {
            string at = sema_value_type(sema_infer_type(s, List_get<*ExprNode>(&e.kids, i)));
            if (at[0] != 0 && sema_streq(at, "null") == 0 && sema_streq(at, "unknown") == 0) {
                string b = ast_unify_tparam(List_get<Param>(&fd.params, i).ty, at, tp);
                if (b[0] != 0) {
                    return b;
                }
            }
        }
        i = i + 1;
    }
    return "";
}

// Inferred generic call: the by-value deductions of each type parameter not bound
// structurally must agree (sema_byvalue_bind). 1 when they do.
int sema_check_generic_binding(Sema* s, *DeclNode fd, *ExprNode e) {
    int ok = 1;
    int t = 0;
    int tn = List_len<TypeParam>(&fd.type_params);
    while (t < tn) {
        string tp = List_get<TypeParam>(&fd.type_params, t).name;
        if (sema_struct_bind(s, fd, e, tp)[0] == 0) {
            int before = s.had_error;
            s.had_error = 0;
            sema_byvalue_bind(s, fd, e, tp, 1);
            if (s.had_error == 1) {
                ok = 0;
            }
            if (before == 1) {
                s.had_error = 1;
            }
        }
        t = t + 1;
    }
    return ok;
}

// `t` with the pointer stars and spaces stripped from both ends ("*Box<int>" -> "Box<int>").
string sema_strip_ptr_sp(string t) {
    int a = 0;
    while ((int)t[a] == 42 || (int)t[a] == 32) {
        a = a + 1;
    }
    int b = 0;
    while (t[b] != 0) {
        b = b + 1;
    }
    while (b > a && ((int)t[b - 1] == 42 || (int)t[b - 1] == 32)) {
        b = b - 1;
    }
    return sema_sub_str(t, a, b);
}

// Token-wise substitution: each identifier in `t` found in `names` becomes the matching
// entry of `args` (unchanged past the end of `args`). "*T" -> "*int". An array or slice
// argument keeps its grouping (codegen cg_subst_ids): a star before it goes after it
// (`*T`, T = int[], is `int[]*`, a pointer to the slice) and dimensions after it go in
// front of its own (`T[2]`, T = int[3], is `int[2][3]`).
string sema_subst_names(string t, List<string>* names, List<string>* args) {
    if (List_len<string>(args) == 0) {
        return t;
    }
    int n = 0;
    while (t[n] != 0) {
        n = n + 1;
    }
    String out;
    String_init(&out, n + 8);
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            int st = i;
            while (i < n) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) {
                    i = i + 1;
                }
                else {
                    break;
                }
            }
            string id = sema_sub_str(t, st, i);
            string rep = id;
            int k = 0;
            while (k < List_len<string>(names) && k < List_len<string>(args)) {
                if (sema_streq(List_get<string>(names, k), id) == 1) {
                    rep = List_get<string>(args, k);
                }
                k = k + 1;
            }
            int rn = sema_slen(rep);
            int rt = rn;
            while (rt > 0 && (int)rep[rt - 1] == 42) {
                rt = rt - 1;
            }
            if (rep != id && rn > 0 && (int)rep[rn - 1] == 93 && i < n && (int)t[i] == 91 && st > 0 && (int)t[st - 1] == 42) {
                // `*T[2]`, T = int[3]: 2 pointers to int[3], `int[3]*[2]`
                int stars = 0;
                while (st - stars > 0 && (int)t[st - stars - 1] == 42) {
                    stars = stars + 1;
                }
                out.len = out.len - (int64)stars;
                out.data[out.len] = (char)0;
                String_append(&out, rep);
                while (stars > 0) {
                    String_push(&out, '*');
                    stars = stars - 1;
                }
            } else if (rep != id && rt < rn && rt > 0 && (int)rep[rt - 1] == 93) {
                int stars = 0;
                while (st - stars > 0 && (int)t[st - stars - 1] == 42) {
                    stars = stars + 1;
                }
                out.len = out.len - (int64)stars;
                out.data[out.len] = (char)0;
                String_append(&out, rep);
                while (stars > 0) {
                    String_push(&out, '*');
                    stars = stars - 1;
                }
            } else if (rep != id && rn > 0 && (int)rep[rn - 1] == 93) {
                if (i < n && (int)t[i] == 91) {
                    int ds = i;
                    while (i < n && (int)t[i] == 91) {
                        while (i < n && (int)t[i] != 93) {
                            i = i + 1;
                        }
                        if (i < n) {
                            i = i + 1;
                        }
                    }
                    int rb = sema_arr_bracket(rep);
                    if (rb > 0) {
                        rep = sema_cat(sema_cat(sema_sub_str(rep, 0, rb), sema_sub_str(t, ds, i)), sema_sub_str(rep, rb, rn));
                    }
                    else {
                        rep = sema_cat(rep, sema_sub_str(t, ds, i));
                    }
                    String_append(&out, rep);
                } else {
                    int stars = 0;
                    while (st - stars > 0 && (int)t[st - stars - 1] == 42) {
                        stars = stars + 1;
                    }
                    out.len = out.len - (int64)stars;
                    out.data[out.len] = (char)0;
                    String_append(&out, rep);
                    while (stars > 0) {
                        String_push(&out, '*');
                        stars = stars - 1;
                    }
                }
            } else {
                String_append(&out, rep);
            }
        } else {
            String_push(&out, (char)c);
            i = i + 1;
        }
    }
    return (string)String_cstr(&out);
}

// sema_subst_names over the names of the type parameters `tps`.
string sema_subst_params(string t, List<TypeParam>* tps, List<string>* args) {
    if (List_len<string>(args) == 0 || List_len<TypeParam>(tps) == 0) {
        return t;
    }
    List<string> names;
    List_init<string>(&names, 4);
    int i = 0;
    while (i < List_len<TypeParam>(tps)) {
        List_push<string>(&names, List_get<TypeParam>(tps, i).name);
        i = i + 1;
    }
    return sema_subst_names(t, &names, args);
}

// A type spelling inside the generic instance being checked, with its type parameters
// replaced by the instance's arguments (unchanged outside an instance).
string sema_isub(Sema* s, string t) {
    if (s.in_inst == 0 || t == null) {
        return t;
    }
    return sema_subst_names(t, &s.isub_p, &s.isub_a);
}

// Queue an instance of `qfn` (keyed and displayed as `name<args>suffix`) for checking,
// unless it is already queued. `owner` is the generic struct of an inline method.
void sema_queue_inst(Sema* s, *DeclNode qfn, *DeclNode owner, List<string>* targs, string name, string suffix) {
    if (qfn == null || qfn.body == null) {
        return;
    }
    let si: SInst;
    List_init<string>(&si.targs, 4);
    string disp = sema_cat(name, "<");
    int i = 0;
    while (i < List_len<string>(targs)) {
        string a = sema_isub(s, List_get<string>(targs, i));
        List_push<string>(&si.targs, a);
        if (i > 0) {
            disp = sema_cat(disp, ",");
        }
        disp = sema_cat(disp, a);
        i = i + 1;
    }
    disp = sema_cat(sema_cat(disp, ">"), suffix);
    if (StrTab_has(&s.inst_seen_set, disp) == 1) {
        return;
    }
    List_push<string>(&s.inst_seen, disp);
    StrTab_set(&s.inst_seen_set, disp, 1);
    si.func = qfn;
    si.owner = owner;
    si.display = disp;
    si.depth = s.inst_depth + 1;
    List_push<SInst>(&s.insts, si);
}

// Any user operator overload for `op` ("+", "u-", ...)? Built-in operand rules then defer
// to the overload resolution codegen performs (with its numeric coercions).
int sema_any_op(Sema* s, string op) {
    int i = 0;
    int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.operator_sym != null && sema_streq(d.operator_sym, op) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// 1 when every argument of the call `e` has a known type (so a failed inference is a
// real error, not a gap in this checker's expression typing).
int sema_args_typed(Sema* s, *ExprNode e) {
    int i = 0;
    while (i < List_len<*ExprNode>(&e.kids)) {
        string at = sema_infer_type(s, List_get<*ExprNode>(&e.kids, i));
        if (at[0] == 0 || sema_streq(at, "unknown") == 1) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

// The type an argument binds a type parameter to: a value's own `const` is dropped (`const
// int` binds `int`), a pointer's pointee const is kept (`const int*` binds itself).
string sema_value_type(string t) {
    if (sema_pointee_const(t) == 1) {
        return t;
    }
    return sema_strip_const(t);
}

// The type arguments of an inferred generic call `f(x, y)`: a parameter spelled exactly
// as a type parameter (`T a`) binds it to the argument's type, and any other parameter
// type unifies structurally (`Pair<A, B> p`). 1 when every type parameter is bound; an
// unbound one is left as "" in `out`.
int sema_bind_targs(Sema* s, *DeclNode fd, *ExprNode e, List<string>* out) {
    int ok = 1;
    int t = 0;
    int tn = List_len<TypeParam>(&fd.type_params);
    while (t < tn) {
        string tp = List_get<TypeParam>(&fd.type_params, t).name;
        string b = sema_struct_bind(s, fd, e, tp);
        if (b[0] == 0) {
            b = sema_byvalue_bind(s, fd, e, tp, 0);
        }
        if (b[0] == 0) {
            ok = 0;
        }
        List_push<string>(out, b);
        t = t + 1;
    }
    return ok;
}

// The type arguments of `x.m(...)` resolved to the generic free function `fd`
// (`S_m<T..>(S<T..>* self, ...)`), with receiver type `bt` (`S<A..>` or a pointer to
// it): a type parameter named by the self parameter's type arguments takes the
// receiver's argument at that position; any other one binds from an argument spelled
// exactly as it. 1 when every type parameter is bound.
int sema_method_targs(Sema* s, *DeclNode fd, string bt, *ExprNode e, List<string>* out) {
    List<string> sargs;
    List_init<string>(&sargs, 2);
    sema_parse_targs(sema_strip_ptr_sp(List_get<Param>(&fd.params, 0).ty), &sargs);
    List<string> rargs;
    List_init<string>(&rargs, 2);
    sema_parse_targs(sema_strip_ptr_sp(bt), &rargs);
    int t = 0;
    int tn = List_len<TypeParam>(&fd.type_params);
    while (t < tn) {
        string tp = List_get<TypeParam>(&fd.type_params, t).name;
        string b = "";
        int k = 0;
        while (k < List_len<string>(&sargs) && k < List_len<string>(&rargs) && b[0] == 0) {
            if (sema_streq(List_get<string>(&sargs, k), tp) == 1) {
                b = List_get<string>(&rargs, k);
            }
            k = k + 1;
        }
        int i = 1;
        int np = List_len<Param>(&fd.params);
        int n = List_len<*ExprNode>(&e.kids);
        while (b[0] == 0 && i < np && i - 1 < n) {
            if (sema_streq(List_get<Param>(&fd.params, i).ty, tp) == 1) {
                string at = sema_strip_const(sema_infer_type(s, List_get<*ExprNode>(&e.kids, i - 1)));
                if (at[0] != 0 && sema_streq(at, "null") == 0 && sema_streq(at, "unknown") == 0) {
                    b = at;
                }
            }
            i = i + 1;
        }
        if (b[0] == 0) {
            return 0;
        }
        List_push<string>(out, b);
        t = t + 1;
    }
    return 1;
}

// A call through a fn-typed value of type `ft`.
void sema_check_fn_value_call(Sema* s, *ExprNode e, string what, string ft) {
    List<string> pts;
    List_init<string>(&pts, 4);
    sema_fn_params(ft, &pts);
    sema_check_call_args(s, e, what, &pts);
}

// Report `field 'f': <err>` / `<ctx>: <err>` when non-empty.
void sema_report_assign(Sema* s, string ctx, string err) {
    if (err[0] == 0) {
        return;
    }
    s.had_error = 1;
    dprintf(2, "error: %s:%d:%d: %s: %s\n", s.filename, s.line, s.col, ctx, err);
}

// The declaration of struct `name` (or null).
*DeclNode sema_find_struct(Sema* s, string name) {
    int i = NameIdx_first(&s.sdecls_ix, name);
    if (i < 0) {
        return null;
    }
    return List_get<*DeclNode>(&s.sdecls, i);
}

// Field type `ft` of a generic struct `d` with the literal's type args substituted when the
// field is spelled exactly as a type parameter ("T" → "int"); otherwise unchanged.
string sema_subst_tparam(*DeclNode d, List<string>* targs, string ft) {
    int i = 0;
    int n = List_len<TypeParam>(&d.type_params);
    while (i < n) {
        if (sema_streq(List_get<TypeParam>(&d.type_params, i).name, ft) == 1) {
            if (i < List_len<string>(targs)) {
                return List_get<string>(targs, i);
            }
            return "";
        }
        i = i + 1;
    }
    return ft;
}

// Is `ft` mentioning a type parameter of `d` (so its concrete type is unknown here)?
int sema_mentions_tparam(*DeclNode d, string ft) {
    int i = 0;
    int n = List_len<TypeParam>(&d.type_params);
    while (i < n) {
        string tp = List_get<TypeParam>(&d.type_params, i).name;
        if (sema_streq(sema_struct_of_type(ft), tp) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Struct literal `S{...}`: too many positional values, a repeated or unknown named field,
// and field value types (mirrors the C++ visit(StructInitExpr)).
void sema_check_struct_init(Sema* s, *ExprNode e) {
    *DeclNode d = sema_find_struct(s, sema_base_name(e.sval));
    if (d == null) {
        return;
    }
    List<string> targs;
    List_init<string>(&targs, 2);
    sema_parse_targs(e.sval, &targs);
    int nf = List_len<Param>(&d.params);
    int n = List_len<*ExprNode>(&e.kids);
    let seen: StrTab;                      // a set: the fields named so far
    // A literal is either positional or named (mirrors the C++ StructInitExpr check).
    int named0 = 0;
    int mixed = 0;
    int mi = 0;
    while (mi < n) {
        int isnamed = 0;
        if (mi < List_len<string>(&e.names)) {
            if (List_get<string>(&e.names, mi)[0] != 0) {
                isnamed = 1;
            }
        }
        if (mi == 0) {
            named0 = isnamed;
        } else if (isnamed != named0) {
            mixed = 1;
        }
        mi = mi + 1;
    }
    if (mixed == 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: cannot mix positional and named field initializers in a '%s' literal\n", s.filename, s.line, s.col, e.sval);
    }
    // A union's members overlap: its literal initializes exactly one of them (C).
    if (d.kind == DK_UNION && n > 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: a union literal initializes one member ('%s' literal has %d)\n", s.filename, s.line, s.col, e.sval, n);
    }
    int i = 0;
    int sil = s.line;
    int sic = s.col;
    while (i < n) {
        *ExprNode v = List_get<*ExprNode>(&e.kids, i);
        // Each field's diagnostics point at its value (as the C++ checker).
        s.line = sil;
        s.col = sic;
        if (v != null && v.line > 0) {
            s.line = v.line;
            s.col = v.col;
        }
        string nm = "";
        if (i < List_len<string>(&e.names)) {
            nm = List_get<string>(&e.names, i);
        }
        string ft = "";
        string shown = nm;
        if (nm[0] != 0) {
            int fi = sema_field_index(d, nm);
            if (fi >= 0) {
                ft = List_get<Param>(&d.params, fi).ty;
            }
            if (ft[0] == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: struct '%s' has no field '%s'\n", s.filename, s.line, s.col, e.sval, nm);
            } else if (StrTab_has(&seen, nm) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: field '%s' is initialized more than once in '%s' literal\n", s.filename, s.line, s.col, nm, e.sval);
            } else {
                StrTab_set(&seen, nm, 1);
            }
        } else if (i < nf) {
            Param p = List_get<Param>(&d.params, i);
            ft = p.ty;
            shown = p.name;
        } else if (i == nf) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: too many initializers for struct '%s' (it has %d field(s), got %d)\n", s.filename, s.line, s.col, e.sval, nf, n);
        }
        if (ft[0] != 0) {
            string cft = sema_subst_tparam(d, &targs, ft);
            // A field type built from a type parameter (`*X`, `X[2]`) takes the literal's
            // type arguments too.
            if (List_len<TypeParam>(&d.type_params) > 0 && List_len<string>(&targs) == List_len<TypeParam>(&d.type_params)) {
                cft = sema_subst_params(ft, &d.type_params, &targs);
            }
            if (cft[0] != 0 && sema_mentions_tparam(d, cft) == 0) {
                sema_report_assign(s, sema_cat(sema_cat("field '", shown), "'"), sema_assign_err(s, cft, v));
            }
        }
        i = i + 1;
    }
    s.line = sil;
    s.col = sic;
}

// Recursively check an array literal against a (possibly multi-dimensional) array type:
// too many elements for a numeric dimension is an error; a short list zero-fills (C-style).
// Is `e` a compile-time constant initializer codegen can fold? Mirrors the C++ isConstInit:
// a literal / sizeof, a numeric unary/cast of one, or an array/struct literal of constants.
// A bare identifier is excluded (it could be a runtime local codegen would silently zero).
// Is `e` a compile-time constant initializer (C semantics) the constant folder emits?
// A literal, `sizeof`, an enum member, a global `const`, the address of a global, a
// non-capturing lambda, and unary/binary/ternary/cast combinations of those, or an
// array/struct literal of constants. A call or a non-const variable read is not
// constant. Used for global and `static` initializers (mirrors TypeChecker::isConstInit).
int sema_is_enum_member(Sema* s, string name) {
    return NameIdx_first(&s.evars_ix, name) >= 0;
}

int sema_is_const_init(Sema* s, *ExprNode e) {
    if (e == null) {
        return 1;
    }
    if (e.kind == EK_LITERAL) {
        return 1;
    }
    if (e.kind == EK_SIZEOF) {
        return 1;
    }
    if (e.kind == EK_LAMBDA) {
        return 1;
    }
    if (e.kind == EK_IDENT) {
        int i = sema_sym_index(s, e.sval);
        if (i >= 0) {
            Sym sy = List_get<Sym>(&s.syms, i);
            if (sy.depth == 0 && sy.is_const == 1) {
                return 1;
            }
            if (sy.depth > 0) {
                return sema_is_enum_member(s, e.sval);
            }
        }
        if (sema_find_fn(s, e.sval) >= 0) {   // a function name: a constant closure
            return 1;
        }
        return sema_is_enum_member(s, e.sval);
    }
    if (e.kind == EK_UNARY) {
        if (sema_streq(e.sval, "&") == 1) {
            if (e.a == null || e.a.kind != EK_IDENT) {
                return 0;
            }
            if (sema_find_fn(s, e.a.sval) >= 0) {
                return 0;
            }
            if (sema_sym_depth(s, e.a.sval) == 0) {
                return 1;
            }
            return 0;
        }
        if (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "~") == 1 || sema_streq(e.sval, "!") == 1
            || sema_streq(e.sval, "+") == 1) {
            return sema_is_const_init(s, e.a);
        }
        return 0;
    }
    if (e.kind == EK_BINARY) {
        string op = e.sval;
        if (sema_streq(op, "=") == 1) {
            return 0;
        }
        int n0 = 0;
        while (op[n0] != 0) {
            n0 = n0 + 1;
        }
        if (n0 >= 2 && (int)op[n0 - 1] == 61 && sema_streq(op, "==") == 0 && sema_streq(op, "!=") == 0
            && sema_streq(op, "<=") == 0 && sema_streq(op, ">=") == 0) {   // compound assign
            return 0;
        }
        if (sema_is_const_init(s, e.a) == 0) {
            return 0;
        }
        return sema_is_const_init(s, e.b);
    }
    if (e.kind == EK_TERNARY) {
        if (sema_is_const_init(s, e.a) == 0 || sema_is_const_init(s, e.b) == 0) {
            return 0;
        }
        return sema_is_const_init(s, List_get<*ExprNode>(&e.kids, 0));
    }
    if (e.kind == EK_CAST) {
        return sema_is_const_init(s, e.a);
    }
    if (e.kind == EK_ARRAYLIT || e.kind == EK_STRUCTINIT) {
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            if (sema_is_const_init(s, List_get<*ExprNode>(&e.kids, i)) == 0) {
                return 0;
            }
            i = i + 1;
        }
        return 1;
    }
    return 0;
}

void sema_check_arr_init(Sema* s, string arrT0, *ExprNode a) {
    string arrT = arrT0;
    if (sema_is_arr_ty(arrT) == 0) {
        // Through a type alias (`type A3 = int[3]`) the target is the array; anything else
        // is not an array: `int x = {1, 2};` (mirrors the C++ VarDecl check).
        string ac = sema_canon(s, arrT);
        if (sema_is_arr_ty(ac) == 0) {
            if (sema_judgeable(s, ac) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: an array literal '{...}' can only initialize an array type, not '%s'\n",
                        s.filename, s.line, s.col, arrT0);
            }
            return;
        }
        arrT = ac;
    }
    string dim = sema_arr_count(arrT);
    if (sema_all_digits(dim) == 1) {
        int cnt = List_len<*ExprNode>(&a.kids);
        if ((int64)cnt > sema_parse_int(dim)) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: array literal has %d elements but '%s' holds %s\n", s.filename, s.line, s.col, cnt, arrT, dim);
        }
    }
    string elemT = sema_arr_elem(arrT);
    int i = 0;
    int n = List_len<*ExprNode>(&a.kids);
    while (i < n) {
        *ExprNode el = List_get<*ExprNode>(&a.kids, i);
        if (el.kind == EK_ARRAYLIT) {                   // nested rows: each element is itself an array literal
            sema_check_arr_init(s, elemT, el);
        } else if (sema_is_arr_ty(elemT) == 0) {                                        // each element converts to the element type
            string aerr = sema_assign_err(s, elemT, el);
            if (aerr[0] != 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: array element: %s\n", s.filename, s.line, s.col, aerr);
            }
        }
        i = i + 1;
    }
}

int sema_has_star(string t) {
    int i = 0;
    while (t[i] != 0) {   // 42 = '*'
        if ((int)t[i] == 42) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// Pointer-to-const: spelling starts with "const " and is a pointer (e.g. "const int*").
int sema_pointee_const(string t) {
    if (t[0] != 99 || t[1] != 111 || t[2] != 110 || t[3] != 115
        || t[4] != 116 || t[5] != 32) {     // not "const "
        return 0;
    }
    return sema_has_star(t);
}

// An integer-literal spelling that denotes zero (only sign chars and '0' digits).
int sema_lit_is_zero(string v) {
    int i = 0;
    if (v[0] == 0) {
        return 0;
    }
    while (v[i] != 0) {
        int c = (int)v[i];
        if (c != 48 && c != 43 && c != 45) {   // not '0' / '+' / '-'
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

int sema_is_assign(string op) {
    if (sema_streq(op, "=") == 1) {
        return 1;
    }
    if (sema_streq(op, "+=") == 1 || sema_streq(op, "-=") == 1 || sema_streq(op, "*=") == 1
        || sema_streq(op, "/=") == 1 || sema_streq(op, "%=") == 1) {
        return 1;
    }
    return 0;
}

// Is the assignment target a read-only location? A const binding, a field/element reached
// through one (a const struct's members are read-only), or storage reached through a
// pointer to const (`r.x`, `r[i]`, `*r` with `r: const T*`).
int sema_is_readonly_lvalue(Sema* s, *ExprNode e) {
    if (e == null) {
        return 0;
    }
    if (e.kind == EK_IDENT) {
        return sema_sym_const(s, e.sval);
    }
    if (e.kind == EK_MEMBER || e.kind == EK_INDEX) {
        string bt = sema_strip_nullable(sema_infer_type(s, e.a));
        string bc = sema_canon(s, bt);
        if ((int)bc[0] == 42) {
            return sema_pointee_const(bt);
        }
        return sema_is_readonly_lvalue(s, e.a);
    }
    // `*p` writes through a pointer — read-only when p points to const.
    if (e.kind == EK_UNARY && sema_streq(e.sval, "*") == 1) {
        return sema_pointee_const(sema_infer_type(s, e.a));
    }
    return 0;
}

// Owned substring s[a, b) with leading/trailing spaces trimmed.
string sema_trim_sub(string s, int a, int b) {
    while (a < b && (int)s[a] == 32) {
        a = a + 1;
    }
    while (b > a && (int)s[b - 1] == 32) {
        b = b - 1;
    }
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int i = 0;
    while (i < len) {
        buf[i] = (uint8)s[a + i];
        i = i + 1;
    }
    buf[len] = 0;
    return (string)buf;
}

*DeclNode sema_find_fndecl(Sema* s, string name) {
    int i = NameIdx_first(&s.fndecls_ix, name);
    if (i < 0) {
        return null;
    }
    return List_get<*DeclNode>(&s.fndecls, i);
}

// Is `name` a C function: declared `extern` and not also defined by the program?
int sema_is_c_extern(Sema* s, string name) {
    int ext = 0;
    int i = NameIdx_first(&s.fndecls_ix, name);
    while (i >= 0) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.kind == DK_EXTERN) {
            ext = 1;
        }
        if (d.kind == DK_FUNCTION && d.body != null) {
            return 0;
        }
        i = NameIdx_next(&s.fndecls_ix, i);
    }
    return ext;
}

// Is `t` a fn type, through type aliases?
int sema_is_fn_type_alias(Sema* s, string t) {
    string ft = sema_strip_const(t);
    int hops = 0;
    while (hops < 16) {
        if (sema_is_fn_type(ft) == 1) {
            return 1;
        }
        *DeclNode ad = sema_find_tdecl(s, ft);
        if (ad == null || ad.kind != DK_TYPEALIAS) {
            return 0;
        }
        ft = sema_strip_const(ad.ret_type);
        hops = hops + 1;
    }
    return 0;
}

*DeclNode sema_find_iface(Sema* s, string name) {
    int i = 0;
    int n = List_len<*DeclNode>(&s.ifaces);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.ifaces, i);
        if (sema_streq(d.name, name) == 1) {
            return d;
        }
        i = i + 1;
    }
    return null;
}

int sema_is_scalar_prim(string c) {
    if (sema_streq(c, "int") == 1 || sema_streq(c, "int8") == 1 || sema_streq(c, "int16") == 1
        || sema_streq(c, "int32") == 1 || sema_streq(c, "int64") == 1 || sema_streq(c, "uint") == 1
        || sema_streq(c, "uint8") == 1 || sema_streq(c, "uint16") == 1 || sema_streq(c, "uint32") == 1
        || sema_streq(c, "uint64") == 1 || sema_streq(c, "char") == 1 || sema_streq(c, "bool") == 1
        || sema_streq(c, "float") == 1 || sema_streq(c, "double") == 1) {
        return 1;
    }
    return 0;
}

// Bounded generics: each constrained type parameter's argument (`targs`, parallel to
// `tps`) must satisfy its interface constraints, structurally (mirrors the C++
// checkConstraints). Returns 1 when all hold.
int sema_check_constraints(Sema* s, List<TypeParam>* tps, List<string>* targs) {
    int ok = 1;
    int t = 0;
    while (t < List_len<TypeParam>(tps) && t < List_len<string>(targs)) {
        TypeParam tp = List_get<TypeParam>(tps, t);
        string concrete = sema_isub(s, List_get<string>(targs, t));
        string bare = sema_canon(s, concrete);
        while ((int)bare[0] == 42) {
            bare = sema_sub_str(bare, 1, sema_slen(bare));
        }
        string full = bare;
        bare = sema_base_name(bare);
        int ci = 0;
        if (sema_in_list(&s.tparams, bare) == 1) {   // still abstract
            ci = List_len<string>(&tp.constraints);
        }
        while (ci < List_len<string>(&tp.constraints)) {
            string ic = List_get<string>(&tp.constraints, ci);
            *DeclNode iface = sema_find_iface(s, ic);
            if (iface == null) {
                s.had_error = 1;
                ok = 0;
                dprintf(2, "error: %s:%d:%d: unknown constraint interface '%s'\n", s.filename, s.line, s.col, ic);
            } else {
                string why = sema_iface_mismatch_full(s, bare, full, iface);
                if (why[0] != 0) {
                    s.had_error = 1;
                    ok = 0;
                    dprintf(2, "error: %s:%d:%d: type '%s' does not satisfy constraint '%s' (required by a bounded type parameter): %s\n",
                           s.filename, s.line, s.col, concrete, ic, why);
                }
            }
            ci = ci + 1;
        }
        t = t + 1;
    }
    return ok;
}

// Extract the type arguments of a template-call spelling ("pick<int>" → ["int"],
// "Map<string, int>" → ["string","int"]), tracking nesting and trimming spaces.
void sema_parse_targs(string sval, List<string>* out) {
    int i = 0;
    while (sval[i] != 0 && (int)sval[i] != 60) {                  // find '<'
        if ((int)sval[i] == 91) {
            i = sema_dim_close(sval, i);
            if (sval[i] == 0) {
                return;
            }
        }
        i = i + 1;
    }
    if (sval[i] == 0) {
        return;
    }
    i = i + 1;
    int depth = 0;
    int start = i;
    while (sval[i] != 0) {
        int c = (int)sval[i];
        if (c == 91) {
            i = sema_dim_close(sval, i);
            if (sval[i] == 0) {
                break;
            }
        }
        else if (c == 60 || c == 40) {        // '<' or '(' (nested generic / fn params)
            depth = depth + 1;
        }
        else if (c == 41) {   // ')'
            if (depth > 0) {
                depth = depth - 1;
            }
        }
        else if (c == 62 && (i == 0 || (int)sval[i - 1] != 45)) {   // '>' closing a generic, NOT the "->" arrow
            if (depth == 0) {
                break;
            }
            depth = depth - 1;
        }
        else if (c == 44 && depth == 0) {
            List_push<string>(out, sema_trim_sub(sval, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if (i > start) {
        List_push<string>(out, sema_trim_sub(sval, start, i));
    }
}
