// Driver: `eskiuc run selfhost/tc_main.esk FILE` (or compiled) — preprocess + parse +
// type-check FILE, printing in the `--test-typechecker` format (banner + verdict).
// Exit 0 = "Type checking succeeded!", 1 = "Type checking failed!". The parity
// harness compares the verdict + diagnostics (EXPECT-ERROR substrings), like
// tests/run.sh's negative tests — not a byte diff.

import <io>;
import <fs>;
import "preprocessor.esk";
import "parser.esk";
import "sema.esk";
import "bigstack.esk";

int tc_main(int argc, string* argv) {
    if (argc < 2) {
        printf("usage: tc_main <file.esk>\n");
        return 1;
    }
    let n: int64 = 0;
    *uint8 raw = fs_read_all(argv[1], &n);
    if (raw == null) {
        dprintf(2, "error: cannot read %s\n", argv[1]);
        return 1;
    }

#ifdef __APPLE__
    g_pp_os = "__APPLE__";
#else
    g_pp_os = "__linux__";
#endif
    parser_session_init();
    register_file(argv[1]);           // before preprocessing: its import prescan dedups against it
    let pperr: int = 0;
    string pp = pp_run((string)raw, (int)n, argv[1], &pperr);
    *uint8 src = (*uint8)pp;
    int plen = g_pp_out_len;

    printf("Type checking: %s\n", argv[1]);
    printf("========================================================\n");

    let p: Parser;
    g_lex_file = argv[1];
    p_init(&p, src, plen);
    p.basedir = str_dir(argv[1]);
    *Program prog = parse_program(&p);

    let sm: Sema;
    sema_init(&sm, argv[1]);
    int ok = sema_check(&sm, prog);

    printf("========================================================\n");
    if (ok == 1) {
        printf("Type checking succeeded!\n");
        return 0;
    }
    printf("Type checking failed!\n");
    return 1;
}

// Run the driver on a thread with a large stack, so deeply nested input reaches the
// parser's nesting limit instead of overflowing the stack (see bigstack.esk).
void main_body() { big_rc = tc_main(big_argc, big_argv); }
int main(int argc, string* argv) {
    big_argc = argc;
    big_argv = argv;
    run_on_big_stack(main_body);
    return big_rc;
}
