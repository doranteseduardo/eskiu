// Driver: `eskiuc run selfhost/pp_main.esk FILE` (or compiled) — preprocess FILE
// with the self-hosted preprocessor, then lex the result and print each token in
// the EXACT `--test-lexer` format. Parity oracle: `eskiuc --test-lexer FILE`, which
// builds `Lexer(source)` with an EMPTY filename and no predefined OS macros — so we
// preprocess with filename "" to match (__FILE__ -> "").

import <io>;
import <fs>;
import "preprocessor.esk";
import "lexer.esk";
import "bigstack.esk";

// Same as lex_main: print a token's value as the C++ lexer stores it (STRING_LIT /
// CHAR_LIT decoded, quotes dropped; everything else raw lexeme bytes).
void emit_value(*uint8 src, int type, int start, int len) {
    if (type == STRING_LIT) {
        int i = start + 1;
        int endp = start + len - 1;
        while (i < endp) {
            int ch = (int)src[i];
            if (ch == 92 && i + 1 < endp) { i = i + 1; int adv = 0; putchar(decode_escape_span(src, i, endp, &adv)); i = i + adv; }
            else { putchar(ch); }
            i = i + 1;
        }
        return;
    }
    if (type == CHAR_LIT) {
        int i = start + 1;
        int endp = start + len - 1;
        if (i < endp) {
            int ch = (int)src[i];
            if (ch == 92 && i + 1 < endp) { i = i + 1; int adv = 0; putchar(decode_escape_span(src, i, endp, &adv)); }
            else { putchar(ch); }
        }
        return;
    }
    int i = 0;
    while (i < len) { putchar((int)src[start + i]); i = i + 1; }
}

int pp_main(int argc, string* argv) {
    if (argc < 2) {
        printf("usage: pp_main <file.esk>\n");
        return 1;
    }

    let n: int64 = 0;
    *uint8 raw = fs_read_all(argv[1], &n);
    if (raw == null) {
        printf("error: cannot read %s\n", argv[1]);
        return 1;
    }

#ifdef __APPLE__
    g_pp_os = "__APPLE__";
#else
    g_pp_os = "__linux__";
#endif
    let had_err: int = 0;
    string pp = pp_run((string)raw, (int)n, argv[1], &had_err);
    *uint8 src = (*uint8)pp;
    int plen = g_pp_out_len;

    let lx: Lexer;
    lx.src = src;
    lx.len = plen;
    lx.pos = 0;
    lx.line = 1;
    lx.col = 1;

    Token t = lx_next(&lx);
    while (t.type != EOF_TOKEN) {
        printf("  Line %3d, Col %3d  %15s  '", t.line, t.col, token_name(t.type));
        emit_value(src, t.type, t.start, t.len);
        printf("'\n");
        t = lx_next(&lx);
    }
    return 0;
}

// Run the driver on a thread with a large stack, so deeply nested input reaches the
// parser's nesting limit instead of overflowing the stack (see bigstack.esk).
void main_body() { big_rc = pp_main(big_argc, big_argv); }
int main(int argc, string* argv) {
    big_argc = argc;
    big_argv = argv;
    run_on_big_stack(main_body);
    return big_rc;
}
