// AST for the self-hosted parser + a printer that reproduces the C++
// `--test-parser` dump (ast/ast_printer.cpp) byte-for-byte. Nodes are tagged
// heap structs (one fat struct per category, `kind` selects the live fields);
// cross-category children are pointers. Grown slice by slice — S0 covers just
// FunctionDecl / BlockStmt / ReturnStmt / integer LiteralExpr.

import <io>;
import <mem>;
import <list>;

// Node kind tags (mirror the C++ node set; extended as slices land).
enum DeclKind {
    DK_FUNCTION, DK_EXTERN, DK_INTRINSIC, DK_STRUCT, DK_UNION,
    DK_INTERFACE, DK_ENUM, DK_TYPEALIAS
}
enum StmtKind {
    SK_BLOCK, SK_RETURN, SK_IF, SK_WHILE, SK_FOR, SK_FORIN,
    SK_BREAK, SK_CONTINUE, SK_EXPR, SK_VARDECL,
    SK_SWITCH, SK_CASE, SK_MATCH, SK_ARM, SK_TRY, SK_CATCH,
    SK_THROW, SK_THREADJOIN, SK_ASM, SK_ASMINPUT
}
enum ExprKind {
    EK_LITERAL, EK_IDENT, EK_BINARY, EK_UNARY,
    EK_CALL, EK_INDEX, EK_MEMBER, EK_QUESTION, EK_CAST, EK_SIZEOF,
    EK_STRUCTINIT, EK_TEMPLATECALL
}

// Literal kinds, in the C++ LiteralExpr::Kind order; lit_name maps to the
// printer's label (INT/FLOAT/STRING/CHAR/BOOL/NULL).
enum LitKind { LIT_INT, LIT_FLOAT, LIT_STRING, LIT_CHAR, LIT_BOOL, LIT_NULL }

struct Param { string ty; string name; }

struct ExprNode {
    int kind;
    int lit_kind;          // for EK_LITERAL
    string sval;           // literal text / operator / name / member / struct or template sig
    *ExprNode a;
    *ExprNode b;
    List<*ExprNode> kids;  // call/template args, struct-init values
    List<string> names;    // struct-init field names (parallel to kids; "" = positional)
}

struct StmtNode {
    int kind;
    *ExprNode expr;        // return value / expr-stmt / if|while cond / for cond / for-in iterable / var init
    *ExprNode expr2;       // for step
    *StmtNode s1;          // then / while|for-in body / for init
    *StmtNode s2;          // else / for body
    List<*StmtNode> items; // block items
    string name;           // var-decl name / for-in variable
    string type;           // var-decl type
}

struct DeclNode {
    int kind;
    string name;
    string ret_type;
    *StmtNode body;
    List<Param> params;
}

struct Program {
    List<*DeclNode> decls;
}

string lit_name(int k) {
    if (k == LIT_INT) { return "INT"; }
    if (k == LIT_FLOAT) { return "FLOAT"; }
    if (k == LIT_STRING) { return "STRING"; }
    if (k == LIT_CHAR) { return "CHAR"; }
    if (k == LIT_BOOL) { return "BOOL"; }
    return "NULL";
}

// ── Printer (2-space indent per depth; mirrors ast_printer.cpp) ──────────────

void pind(int d) {
    int i = 0;
    while (i < d) { printf("  "); i = i + 1; }
}

void pline(int d, string s) {
    pind(d);
    printf("%s\n", s);
}

void print_expr(*ExprNode e, int d) {
    if (e.kind == EK_LITERAL) {
        pind(d);
        printf("LiteralExpr(%s): %s\n", lit_name(e.lit_kind), e.sval);
        return;
    }
    if (e.kind == EK_IDENT) {
        pind(d);
        printf("IdentExpr: %s\n", e.sval);
        return;
    }
    if (e.kind == EK_BINARY) {
        pind(d);
        printf("BinaryExpr: %s\n", e.sval);
        pline(d + 1, "Left:");
        print_expr(e.a, d + 2);
        pline(d + 1, "Right:");
        print_expr(e.b, d + 2);
        return;
    }
    if (e.kind == EK_UNARY) {
        pind(d);
        printf("UnaryExpr: %s\n", e.sval);
        print_expr(e.a, d + 1);
        return;
    }
    if (e.kind == EK_CALL) {
        pline(d, "CallExpr");
        pline(d + 1, "Callee:");
        print_expr(e.a, d + 2);
        pline(d + 1, "Args:");
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { print_expr(List_get<*ExprNode>(&e.kids, i), d + 2); i = i + 1; }
        return;
    }
    if (e.kind == EK_INDEX) {
        pline(d, "IndexExpr");
        pline(d + 1, "Base:");
        print_expr(e.a, d + 2);
        pline(d + 1, "Index:");
        print_expr(e.b, d + 2);
        return;
    }
    if (e.kind == EK_MEMBER) {
        pind(d);
        printf("MemberExpr: .%s\n", e.sval);
        print_expr(e.a, d + 1);
        return;
    }
    if (e.kind == EK_QUESTION) {
        pline(d, "QuestionExpr (?)");
        print_expr(e.a, d + 1);
        return;
    }
    if (e.kind == EK_CAST) {
        pind(d);
        printf("CastExpr: (%s)\n", e.sval);
        print_expr(e.a, d + 1);
        return;
    }
    if (e.kind == EK_SIZEOF) {
        pind(d);
        printf("SizeofExpr: sizeof(%s)\n", e.sval);
        return;
    }
    if (e.kind == EK_STRUCTINIT) {
        pind(d);
        printf("StructInitExpr: %s\n", e.sval);
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            string nm = List_get<string>(&e.names, i);
            if (nm[0] != 0) {                 // named field
                pind(d + 1);
                printf(".%s:\n", nm);
            }
            print_expr(List_get<*ExprNode>(&e.kids, i), d + 2);
            i = i + 1;
        }
        return;
    }
    if (e.kind == EK_TEMPLATECALL) {
        pind(d);
        printf("TemplateCallExpr: %s\n", e.sval);
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) {
            print_expr(List_get<*ExprNode>(&e.kids, i), d + 1);
            i = i + 1;
        }
        return;
    }
}

void print_stmt(*StmtNode s, int d) {
    if (s.kind == SK_BLOCK) {
        pline(d, "BlockStmt");
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            print_stmt(List_get<*StmtNode>(&s.items, i), d + 1);
            i = i + 1;
        }
        return;
    }
    if (s.kind == SK_RETURN) {
        pline(d, "ReturnStmt");
        if (s.expr != null) { print_expr(s.expr, d + 1); }
        return;
    }
    if (s.kind == SK_IF) {
        pline(d, "IfStmt");
        pline(d + 1, "Condition:");
        print_expr(s.expr, d + 2);
        pline(d + 1, "Then:");
        print_stmt(s.s1, d + 2);
        if (s.s2 != null) {
            pline(d + 1, "Else:");
            print_stmt(s.s2, d + 2);
        }
        return;
    }
    if (s.kind == SK_WHILE) {
        pline(d, "WhileStmt");
        pline(d + 1, "Condition:");
        print_expr(s.expr, d + 2);
        pline(d + 1, "Body:");
        print_stmt(s.s1, d + 2);
        return;
    }
    if (s.kind == SK_FOR) {
        pline(d, "ForStmt");
        if (s.s1 != null) {
            pline(d + 1, "Init:");
            print_stmt(s.s1, d + 2);
        }
        if (s.expr != null) {
            pline(d + 1, "Condition:");
            print_expr(s.expr, d + 2);
        }
        if (s.expr2 != null) {
            pline(d + 1, "Step:");
            print_expr(s.expr2, d + 2);
        }
        pline(d + 1, "Body:");
        print_stmt(s.s2, d + 2);
        return;
    }
    if (s.kind == SK_FORIN) {
        pind(d);
        printf("ForInStmt (%s in ...)\n", s.name);
        pline(d + 1, "Iterable:");
        print_expr(s.expr, d + 2);
        pline(d + 1, "Body:");
        print_stmt(s.s1, d + 2);
        return;
    }
    if (s.kind == SK_BREAK) { pline(d, "BreakStmt"); return; }
    if (s.kind == SK_CONTINUE) { pline(d, "ContinueStmt"); return; }
    if (s.kind == SK_EXPR) {
        pline(d, "ExprStmt");
        print_expr(s.expr, d + 1);
        return;
    }
    if (s.kind == SK_VARDECL) {
        pind(d);
        printf("VarDecl: %s: %s\n", s.name, s.type);
        if (s.expr != null) {
            pline(d + 1, "Initializer:");
            print_expr(s.expr, d + 2);
        }
        return;
    }
    if (s.kind == SK_SWITCH) {
        pline(d, "SwitchStmt");
        pline(d + 1, "Subject:");
        print_expr(s.expr, d + 2);
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) { print_stmt(List_get<*StmtNode>(&s.items, i), d + 1); i = i + 1; }
        return;
    }
    if (s.kind == SK_CASE) {
        if (s.expr != null) {
            pline(d, "Case:");
            print_expr(s.expr, d + 1);
        } else {
            pline(d, "Default:");
        }
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) { print_stmt(List_get<*StmtNode>(&s.items, i), d + 1); i = i + 1; }
        return;
    }
    if (s.kind == SK_MATCH) {
        pline(d, "MatchStmt");
        pline(d + 1, "Subject:");
        print_expr(s.expr, d + 2);
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) { print_stmt(List_get<*StmtNode>(&s.items, i), d + 1); i = i + 1; }
        return;
    }
    if (s.kind == SK_ARM) {
        pind(d);
        printf("Arm %s:\n", s.name);
        print_stmt(s.s1, d + 1);
        return;
    }
    if (s.kind == SK_TRY) {
        pline(d, "TryStmt");
        print_stmt(s.s1, d + 1);
        int i = 0;
        int n = List_len<*StmtNode>(&s.items);
        while (i < n) { print_stmt(List_get<*StmtNode>(&s.items, i), d + 1); i = i + 1; }
        if (s.s2 != null) {
            pline(d + 1, "Finally");
            print_stmt(s.s2, d + 2);
        }
        return;
    }
    if (s.kind == SK_CATCH) {
        pind(d);
        printf("CatchClause: %s\n", s.name);
        print_stmt(s.s1, d + 1);
        return;
    }
    if (s.kind == SK_THROW) {
        pline(d, "ThrowStmt");
        if (s.expr != null) { print_expr(s.expr, d + 1); }
        return;
    }
    if (s.kind == SK_THREADJOIN) {
        pline(d, "ThreadJoinStmt");
        print_expr(s.expr, d + 1);
        return;
    }
    if (s.kind == SK_ASM) {
        pind(d);
        printf("AsmStmt: asm(\"%s\")\n", s.name);
        int n = List_len<*StmtNode>(&s.items);
        int i = 0;
        while (i < n) {
            *StmtNode inp = List_get<*StmtNode>(&s.items, i);
            pind(d + 1);
            printf("input: \"%s\"\n", inp.name);
            print_expr(inp.expr, d + 2);
            i = i + 1;
        }
        return;
    }
}

// Print each entry of dn.params as `<ty> <name>` at depth d (function/extern
// parameters, struct/union fields).
void print_params(*DeclNode dn, int d) {
    int i = 0;
    int n = List_len<Param>(&dn.params);
    while (i < n) {
        Param pm = List_get<Param>(&dn.params, i);
        pind(d);
        printf("%s %s\n", pm.ty, pm.name);
        i = i + 1;
    }
}

void print_decl(*DeclNode dn, int d) {
    if (dn.kind == DK_FUNCTION) {
        pind(d);
        printf("FunctionDecl: %s -> %s\n", dn.name, dn.ret_type);
        pline(d + 1, "Parameters:");
        print_params(dn, d + 2);
        pline(d + 1, "Body:");
        print_stmt(dn.body, d + 2);
        return;
    }
    if (dn.kind == DK_EXTERN) {
        pind(d);
        printf("ExternDecl: %s -> %s\n", dn.name, dn.ret_type);
        pline(d + 1, "Parameters:");
        print_params(dn, d + 2);
        return;
    }
    if (dn.kind == DK_INTRINSIC) {
        pind(d);
        printf("IntrinsicDecl: %s -> %s\n", dn.name, dn.ret_type);
        pline(d + 1, "Parameters:");
        print_params(dn, d + 2);
        return;
    }
    if (dn.kind == DK_STRUCT) {
        pind(d);
        printf("StructDecl: %s\n", dn.name);
        pline(d + 1, "Fields:");
        print_params(dn, d + 2);
        return;
    }
    if (dn.kind == DK_UNION) {
        pind(d);
        printf("UnionDecl: %s\n", dn.name);
        print_params(dn, d + 1);
        return;
    }
    if (dn.kind == DK_INTERFACE) {
        pind(d);
        printf("InterfaceDecl: %s\n", dn.name);
        int i = 0;
        int n = List_len<Param>(&dn.params);
        while (i < n) {
            Param pm = List_get<Param>(&dn.params, i);
            pind(d + 1);
            printf("%s %s(...)\n", pm.ty, pm.name);
            i = i + 1;
        }
        return;
    }
    if (dn.kind == DK_ENUM) {
        pind(d);
        printf("EnumDecl: %s\n", dn.name);
        int i = 0;
        int n = List_len<Param>(&dn.params);
        while (i < n) {
            Param pm = List_get<Param>(&dn.params, i);
            pind(d + 1);
            printf("%s = %s\n", pm.name, pm.ty);     // name = value
            i = i + 1;
        }
        return;
    }
    if (dn.kind == DK_TYPEALIAS) {
        pind(d);
        printf("TypeAlias: %s = %s\n", dn.name, dn.ret_type);
        return;
    }
}

void print_program(*Program p) {
    printf("Program\n");
    int i = 0;
    int n = List_len<*DeclNode>(&p.decls);
    while (i < n) {
        print_decl(List_get<*DeclNode>(&p.decls, i), 1);
        i = i + 1;
    }
}
