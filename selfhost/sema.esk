// Self-hosted semantic analyzer (Phase B of the back-end). Consumes the enriched
// AST (ast.esk). Mirrors sema/type_checker.cpp incrementally.
//
// S0: name resolution — a two-pass walk (register top-level names, then check
// bodies with a scope stack) that catches *undefined variables*. The oracle is the
// verdict (`Type checking succeeded!` / exit code) + the `tests/errors/` EXPECT-ERROR
// substring, like tests/run.sh's negative tests. Types, calls, generics, traits,
// const-correctness, match exhaustiveness, async/escape come in later slices.
//
// Symbol table: a flat list of {name, depth}. Entering a scope bumps `depth`;
// leaving it pops every trailing entry at that depth. Avoids nested-List mutation
// (List_get returns structs by value). Lambda/match-arm/catch bodies are not yet
// walked (they bind names we don't extract yet) — safe: under-checking can't turn a
// clean program's verdict from succeeded to failed.

import <io>;
import <list>;
import <mem>;
import "ast.esk";

struct Sym { string name; int depth; }

struct Sema {
    List<Sym> syms;
    int depth;
    int had_error;
    string filename;
}

// Mutually-recursive walk.
void sema_expr(Sema* s, *ExprNode e);
void sema_stmt(Sema* s, *StmtNode st);

int sema_streq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] == b[i]) { return 1; }
    return 0;
}

void sema_init(Sema* s, string filename) {
    List_init<Sym>(&s.syms, 64);
    s.depth = 0;                           // global scope
    s.had_error = 0;
    s.filename = filename;
}

void sema_push(Sema* s) { s.depth = s.depth + 1; }

void sema_pop(Sema* s) {
    int d = s.depth;
    while (List_len<Sym>(&s.syms) > 0) {
        Sym last = List_get<Sym>(&s.syms, List_len<Sym>(&s.syms) - 1);
        if (last.depth < d) { break; }
        List_remove<Sym>(&s.syms, List_len<Sym>(&s.syms) - 1);
    }
    s.depth = d - 1;
}

void sema_define(Sema* s, string name) {
    let sym: Sym;
    sym.name = name;
    sym.depth = s.depth;
    List_push<Sym>(&s.syms, sym);
}

int sema_lookup(Sema* s, string name) {
    int i = List_len<Sym>(&s.syms) - 1;
    while (i >= 0) {
        if (sema_streq(List_get<Sym>(&s.syms, i).name, name) == 1) { return 1; }
        i = i - 1;
    }
    return 0;
}

// ── expression walk ──

void sema_expr(Sema* s, *ExprNode e) {
    if (e == null) { return; }
    int k = e.kind;
    if (k == EK_IDENT) {
        if (sema_lookup(s, e.sval) == 0) {
            s.had_error = 1;
            printf("error: %s:0:0: undefined variable '%s'\n", s.filename, e.sval);
        }
        return;
    }
    if (k == EK_LITERAL || k == EK_SIZEOF) { return; }
    if (k == EK_BINARY) { sema_expr(s, e.a); sema_expr(s, e.b); return; }
    if (k == EK_UNARY || k == EK_MEMBER || k == EK_QUESTION || k == EK_CAST
        || k == EK_AWAIT || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        sema_expr(s, e.a);
        return;
    }
    if (k == EK_INDEX || k == EK_ALLOCWITH) { sema_expr(s, e.a); sema_expr(s, e.b); return; }
    if (k == EK_CALL) {
        sema_expr(s, e.a);                 // callee (functions live in the global scope)
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    if (k == EK_STRUCTINIT || k == EK_TEMPLATECALL) {   // name is a type/fn, not an ident
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    // EK_LAMBDA: body params aren't extracted yet → skip (S0 under-check, no false error).
}

// ── statement walk ──

void sema_stmt(Sema* s, *StmtNode st) {
    if (st == null) { return; }
    int k = st.kind;
    if (k == SK_BLOCK) {
        sema_push(s);
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        sema_pop(s);
        return;
    }
    if (k == SK_VARDECL) {
        sema_expr(s, st.expr);             // initializer (can't reference itself)
        sema_define(s, st.name);
        return;
    }
    if (k == SK_RETURN || k == SK_THROW) { sema_expr(s, st.expr); return; }
    if (k == SK_EXPR || k == SK_THREADJOIN) { sema_expr(s, st.expr); return; }
    if (k == SK_IF) {
        sema_expr(s, st.expr);
        sema_stmt(s, st.s1);
        sema_stmt(s, st.s2);
        return;
    }
    if (k == SK_WHILE) { sema_expr(s, st.expr); sema_stmt(s, st.s1); return; }
    if (k == SK_FOR) {
        sema_push(s);                      // init var stays in scope for cond/step/body
        // The init is wrapped in a BlockStmt; walk its items in the FOR scope rather
        // than via sema_stmt (which would push/pop a sub-scope and drop the loop var).
        if (st.s1 != null && st.s1.kind == SK_BLOCK) {
            int i = 0;
            int n = List_len<*StmtNode>(&st.s1.items);
            while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.s1.items, i)); i = i + 1; }
        } else {
            sema_stmt(s, st.s1);
        }
        sema_expr(s, st.expr);
        sema_expr(s, st.expr2);
        sema_stmt(s, st.s2);
        sema_pop(s);
        return;
    }
    if (k == SK_FORIN) {
        sema_push(s);
        sema_expr(s, st.expr);             // iterable (loop var not yet in scope)
        sema_define(s, st.name);
        sema_stmt(s, st.s1);
        sema_pop(s);
        return;
    }
    if (k == SK_BREAK || k == SK_CONTINUE) { return; }
    if (k == SK_SWITCH || k == SK_MATCH) {
        sema_expr(s, st.expr);             // subject
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        return;
    }
    if (k == SK_CASE) {
        sema_expr(s, st.expr);             // case value (null for default)
        sema_push(s);
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        sema_pop(s);
        return;
    }
    if (k == SK_TRY) {
        sema_stmt(s, st.s1);               // body
        // catch clauses (items) bind names we don't extract yet → skip their bodies
        sema_stmt(s, st.s2);               // finally
        return;
    }
    if (k == SK_ASM) {
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_expr(s, List_get<*StmtNode>(&st.items, i).expr); i = i + 1; }
        return;
    }
    // SK_ARM / SK_CATCH bodies: not walked in S0 (bindings not yet extracted).
}

// ── entry ──

// Register top-level names that can be referenced as a bare identifier: functions,
// externs, intrinsics, global vars, and enum members (constants / variant ctors).
void sema_register_globals(Sema* s, *Program prog) {
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION || d.kind == DK_EXTERN
            || d.kind == DK_INTRINSIC || d.kind == DK_VARDECL) {
            sema_define(s, d.name);
        }
        if (d.kind == DK_ENUM) {
            int j = 0;
            int m = List_len<Param>(&d.params);
            while (j < m) { sema_define(s, List_get<Param>(&d.params, j).name); j = j + 1; }
        }
        i = i + 1;
    }
}

// Check a function/method body: a fresh scope with the params (and `self` for
// methods) defined, then walk the body.
void sema_check_fn(Sema* s, *DeclNode f, int is_method) {
    if (f.body == null) { return; }
    sema_push(s);
    if (is_method == 1) { sema_define(s, "self"); }
    int j = 0;
    int m = List_len<Param>(&f.params);
    while (j < m) { sema_define(s, List_get<Param>(&f.params, j).name); j = j + 1; }
    sema_stmt(s, f.body);
    sema_pop(s);
}

// Returns 1 if the program type-checks (no errors), 0 otherwise.
int sema_check(Sema* s, *Program prog) {
    sema_register_globals(s, prog);
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION) { sema_check_fn(s, d, 0); }
        if (d.kind == DK_STRUCT) {
            int k = 0;
            int mm = List_len<*DeclNode>(&d.methods);
            while (k < mm) { sema_check_fn(s, List_get<*DeclNode>(&d.methods, k), 1); k = k + 1; }
        }
        i = i + 1;
    }
    if (s.had_error == 1) { return 0; }
    return 1;
}
