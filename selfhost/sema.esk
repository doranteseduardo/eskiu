// Self-hosted semantic analyzer (Phase B of the back-end). Consumes the enriched
// AST (ast.esk). Mirrors sema/type_checker.cpp incrementally.
//
// S0: name resolution — a two-pass walk (register top-level names, then check
// bodies with a scope stack) that catches *undefined variables*. The oracle is the
// verdict (`Type checking succeeded!` / exit code) + the `tests/errors/` EXPECT-ERROR
// substring, like tests/run.sh's negative tests. Types, calls, generics, traits,
// const-correctness, match exhaustiveness, async/escape come in later slices.
//
// Symbol table: a flat list of {name, depth}. Entering a scope bumps `depth`;
// leaving it pops every trailing entry at that depth. Avoids nested-List mutation
// (List_get returns structs by value). Lambda/match-arm/catch bodies are not yet
// walked (they bind names we don't extract yet) — safe: under-checking can't turn a
// clean program's verdict from succeeded to failed.

import <io>;
import <list>;
import <string>;
import <mem>;
import "ast.esk";

struct Sym { string name; string type; int depth; int is_const; *ExprNode init; int is_static; int addr_taken; }   // init: a const's initializer (case-label folding)

// Signature of a non-generic top-level function/extern/intrinsic, for arg-count
// checking. `variadic` = trailing `...`; `fixed` = required arg count.
struct FnSig { string name; int fixed; int variadic; }

// A top-level name and what declared it (for the one-namespace duplicate check).
struct NameEnt { string name; string kind; *DeclNode d; }

// A generic instance queued for checking: the template function (or a generic struct's
// inline method, with `owner` the struct), its concrete type arguments, and its display
// name ("pick<Box>") for diagnostics. Mirrors the C++ PendingInstance.
struct SInst { *DeclNode func; *DeclNode owner; List<string> targs; string display; int depth; }

// One enum variant, for match exhaustiveness.
struct EVar { string en; string variant; string val; int plain; }   // val = member value (classic enums)

struct Sema {
    int fold_depth;          // recursion guard for sema_fold_int through const initializers
    int ptrsz;               // the target's pointer size and int64/double alignment, so
    int i64al;               // sizeof folds to its layout (sema_set_target)
    int msbf;                // 1: bitfields follow the MS (Windows) layout rules
    int bfal;                // 1: an unnamed bitfield raises its struct's alignment (AAPCS)
    int msvc;                // 1: MSVC (not mingw): a `: 0` under pack(N) is aligned to at most N
    List<Sym> syms;
    List<string> gaddr;      // names whose address is taken anywhere (a global among them is never narrowed)
    List<FnSig> fns;
    List<string> types;     // declared type names (struct/union/interface/enum/alias)
    List<string> structs;   // struct names (subset of types; have fields/methods)
    List<string> members;   // "Struct.member" keys for each struct field AND method
    List<string> enums;     // enum names (for match exhaustiveness)
    List<EVar> evars;       // every enum's variants
    List<*DeclNode> fndecls; // all top-level fn/extern/intrinsic decls (params, type-params)
    List<*DeclNode> ifaces;  // interface decls (their required methods)
    List<*DeclNode> sdecls;  // struct decls (field names + types, for struct literals)
    List<string> tparams;    // type parameters in scope (a generic struct's methods)
    List<*DeclNode> tdecls;  // every type decl (struct/union/enum/interface/alias)
    int depth;
    int param_depth;         // depth of the current function's parameters (-1 outside one)
    int had_error;
    int in_async;           // currently inside an `async` function body?
    int fin_depth;          // `finally` blocks enclosing the current point (no `return` inside one)
    int in_variadic;        // the function being checked has a variadic parameter (`...`)?
    int await_seen;         // has an `await` appeared in the current function?
    string cur_ret;         // current function's return type (for `?` propagation)
    string cur_ret_raw;     // the same as written (a generic body: in terms of its type params)
    string match_ty;        // subject type of the `match` whose arms are being checked
    string lam_ret;         // return type a lambda initializer is reconciled to ("" = its own)
    List<string> watched;   // non-escaping fn-type params of the current function
    List<string> escaped;   // watched params seen used beyond a direct call
    string callee_ctx;      // name being called right now (a watched param here is OK)
    List<int> lam_bounds;   // scope depth just outside each enclosing lambda (innermost last)
    List<int> lam_esc;      // per enclosing lambda: 1 if it outlives the call (not passed to a non-escaping param)
    int call_epoch;         // bumped by every call (sema_drop_global_narrowings)
    int has_ops;            // any `operator` overload declared (an operator use may be a call)
    int has_alias;          // any `type X = ...` declared (an expression type may name one)
    List<*ExprNode> tern_ifn;    // `?:` expressions bound for an interface (each arm boxes) ...
    List<string> tern_ift;       // ... and that interface type
    int last_if_then_called;   // the last SK_IF's then-branch made a call
    int last_if_else_called;   // ... its else path did
    int lam_arg_nonesc;     // the lambda about to be checked is an argument to a non-escaping param
    string lam_local;       // the local the lambda about to be checked initializes ("" if none)
    List<string> lam_local_of;   // per enclosing lambda: the local it initializes
    List<string> wlocals;        // locals initialized by a lambda
    List<string> wlocals_esc;    // those used beyond a direct call
    List<string> cap_param;      // a watched param captured by a lambda bound to a local ...
    List<string> cap_local;      // ... and that local: the param escapes if the local does
    int lam_arg_stack;           // the lambda about to be checked is an argument to a non-escaping param of a non-async fn
    List<*ExprNode> lam_nodes;   // per enclosing lambda: its node
    List<*ExprNode> wlam;        // lambdas bound to a local (parallel: the local, 1 if in an async body)
    List<string> wlam_name;
    List<int> wlam_async;
    List<*ExprNode> lcap_lam;    // a lambda capturing a lambda-bound local ...
    List<string> lcap_name;      // ... and that local: the local escapes if the lambda outlives the call
    List<string> narrowed;  // `?*T` vars proven non-null in the current branch (`if (x != null)`)
    List<string> loop_lbls; // enclosing loop labels ("" for unlabeled), for labeled break/continue
    int sw_depth;           // enclosing switches (a bare `break` may exit one)
    string filename;
    int line;               // position of the node being checked (0 = unknown), for diagnostics
    int col;
    // Per-instantiation checking of generic bodies (after the main pass): the queue, the
    // display keys already queued, and while one is checked its substitution (parallel
    // type-param names / concrete arguments).
    List<SInst> insts;
    List<string> inst_seen;
    List<string> isub_p;
    List<string> isub_a;
    int in_inst;
    int inst_depth;
    // Globals declared after the top-level declaration being checked: C declares a global
    // at its definition, so an earlier initializer or function body cannot name it.
    List<string> late_globals;
}

// Mutually-recursive walk.
void sema_expr(Sema* s, *ExprNode e);
void sema_stmt(Sema* s, *StmtNode st);
*DeclNode sema_find_fndecl(Sema* s, string name);   // used by sema_infer_type before its definition

// Substring [a, b) of s (b exclusive), heap-allocated and NUL-terminated.
string sema_sub_str(string s, int a, int b) {
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0; while (k < len) { buf[k] = (uint8)s[a + k]; k = k + 1; }
    buf[len] = 0;
    return (string)buf;
}

int sema_streq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] == b[i]) { return 1; }
    return 0;
}

int sema_is_fn_type(string t) {     // "fn(...)->R"
    if (t[0] == 102 && t[1] == 110 && t[2] == 40) { return 1; }   // 'f','n','('
    return 0;
}

// Strip a leading "const " so a type predicate sees the bare spelling.
string sema_strip_const(string t) {
    if (t[0] == 99 && t[1] == 111 && t[2] == 110 && t[3] == 115 && t[4] == 116 && t[5] == 32) {
        int n = 0; while (t[n] != 0) { n = n + 1; }
        return sema_sub_str(t, 6, n);
    }
    return t;
}

int sema_is_int_ty(string t0) {
    string t = sema_strip_const(t0);
    return sema_streq(t, "int") == 1 || sema_streq(t, "int8") == 1 || sema_streq(t, "int16") == 1
        || sema_streq(t, "int32") == 1 || sema_streq(t, "int64") == 1
        || sema_streq(t, "uint") == 1 || sema_streq(t, "uint8") == 1 || sema_streq(t, "uint16") == 1
        || sema_streq(t, "uint32") == 1 || sema_streq(t, "uint64") == 1
        || sema_streq(t, "char") == 1 || sema_streq(t, "bool") == 1;
}

int sema_is_float_ty(string t0) {
    string t = sema_strip_const(t0);
    return sema_streq(t, "float") == 1 || sema_streq(t, "double") == 1;
}

int sema_is_numeric_ty(string t) { return sema_is_int_ty(t) == 1 || sema_is_float_ty(t) == 1; }

extern double strtod(string s, *string end);

// Does the floating value v, truncated toward zero, fit the integer type t (mirrors
// floatConstFitsInt)? Powers of two are exact doubles; at 64 bits `>=` is exact.
int sema_float_fits_int(double v, string t) {
    int bits = 32;
    int uns = 0;
    if (t[0] == 117) { uns = 1; }                                   // 'u'
    if (sema_streq(t, "int8") == 1 || sema_streq(t, "uint8") == 1 || sema_streq(t, "char") == 1) { bits = 8; }
    else if (sema_streq(t, "int16") == 1 || sema_streq(t, "uint16") == 1) { bits = 16; }
    else if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) { bits = 64; }
    double lim = 1.0;
    int k = 0;
    int top = bits - 1;
    if (uns == 1) { top = bits; }
    while (k < top) { lim = lim * 2.0; k = k + 1; }
    if (uns == 1) { if (v > 0.0 - 1.0 && v < lim) { return 1; } return 0; }
    if (bits == 64) { if (v >= 0.0 - lim && v < lim) { return 1; } return 0; }
    if (v > 0.0 - lim - 1.0 && v < lim) { return 1; }
    return 0;
}

// Array-type helpers (mirror the codegen versions; sema does not import codegen).
int sema_is_arr_ty(string t) {
    int i = 0; while (t[i] != 0) { if ((int)t[i] == 91) { return 1; } i = i + 1; }   // '['
    return 0;
}
// A fixed array `T[N]` (its outer dimension, the first bracket, is not a slice `[]`):
// its elements are in the value's own storage, unlike a slice's.
int sema_is_fixed_arr_ty(string t) {
    int i = 0; while (t[i] != 0) { if ((int)t[i] == 91) { return (int)t[i + 1] != 93; } i = i + 1; }
    return 0;
}
int sema_all_digits(string v) {
    if (v[0] == 0) { return 0; }
    int i = 0; while (v[i] != 0) { int c = (int)v[i]; if (c < 48 || c > 57) { return 0; } i = i + 1; }
    return 1;
}
int sema_atoi(string v) {
    int i = 0; int r = 0;
    while (v[i] != 0) { int c = (int)v[i]; if (c < 48 || c > 57) { return r; } r = r * 10 + (c - 48); i = i + 1; }
    return r;
}
// The first `[N]` dimension of an array type ("int[2][3]" → "2"), or "0" if none.
string sema_arr_count(string t) {
    int i = 0; while (t[i] != 0 && (int)t[i] != 91) { i = i + 1; }
    if (t[i] == 0) { return "0"; }
    i = i + 1; int st = i;
    while (t[i] != 0 && (int)t[i] != 93) { i = i + 1; }
    return sema_sub_str(t, st, i);
}
// The element type of an array ("int[2][3]" → "int[3]"): prefix before '[' + suffix after ']'.
int sema_arr_bracket(string t);
string sema_arr_elem(string t) {
    int open = sema_arr_bracket(t);
    if (open < 0) { open = 0; while (t[open] != 0 && (int)t[open] != 91) { open = open + 1; } }
    if (t[open] == 0) { return t; }
    int close = open; while (t[close] != 0 && (int)t[close] != 93) { close = close + 1; }
    int tn = 0; while (t[tn] != 0) { tn = tn + 1; }
    string pre = sema_sub_str(t, 0, open);
    string suf = sema_sub_str(t, close + 1, tn);
    return sema_cat(pre, suf);
}

// Drop a leading `?` (the checked-nullable marker on `?*T`). A `?*T` operates like `*T`
// everywhere except the deref/index/member safety check, which inspects the `?` directly.
string sema_strip_nullable(string t) {
    if (t[0] == 63) {                                 // '?'
        int n = 0; while (t[n] != 0) { n = n + 1; }
        return sema_sub_str(t, 1, n);
    }
    return t;
}

// Pointer-like for comparison: leading/trailing `*`, `string`, or `null` (mirrors C++).
int sema_is_ptrish(string t0) {
    string t = sema_strip_nullable(sema_strip_const(t0));
    int n = 0; while (t[n] != 0) { n = n + 1; }
    if (n == 0) { return 0; }
    if (t[n - 1] == 93) { return 0; }                  // `*T[N]` is an array of pointers
    if (t[0] == 42 || t[n - 1] == 42) { return 1; }   // '*'
    return sema_streq(t, "string") == 1 || sema_streq(t, "null") == 1;
}

// A comparison operator (==, !=, <, >, <=, >=)?
int sema_is_cmp_op(string op) {
    return sema_streq(op, "==") == 1 || sema_streq(op, "!=") == 1
        || sema_streq(op, "<") == 1 || sema_streq(op, ">") == 1
        || sema_streq(op, "<=") == 1 || sema_streq(op, ">=") == 1;
}

// Does integer literal `v` (decimal, 0x hex or 0-octal) fit target int type `t0`?
// Mirrors the C++ intLiteralFits: a literal too large for 64 bits fits nothing. A binary
// or suffixed spelling is treated as fitting (skip).
int sema_int_lit_fits(string t0, string v) {
    string t = sema_strip_const(t0);
    int i = 0; int neg = 0;
    if (v[0] == 45) { neg = 1; i = 1; }               // leading '-'
    if (v[i] == 48 && (v[i + 1] == 98 || v[i + 1] == 66)) { return 1; }  // 0b: skip
    uint64 base = (uint64)10;
    if (v[i] == 48 && (v[i + 1] == 120 || v[i + 1] == 88)) { base = (uint64)16; i = i + 2; }
    else if (v[i] == 48 && v[i + 1] != 0) { base = (uint64)8; i = i + 1; }
    uint64 mag = (uint64)0;
    while (v[i] != 0) {
        int c = (int)v[i];
        int dv = -1;
        if (c >= 48 && c <= 57) { dv = c - 48; }
        else if (base == (uint64)16 && c >= 97 && c <= 102) { dv = c - 87; }
        else if (base == (uint64)16 && c >= 65 && c <= 70) { dv = c - 55; }
        if (dv < 0 || (uint64)dv >= base) { return 1; }   // non-digit (suffix etc.): skip
        if (mag > ((uint64)18446744073709551615 - (uint64)dv) / base) { return 0; }   // wider than 64 bits
        mag = mag * base + (uint64)dv;
        i = i + 1;
    }
    if (sema_streq(t, "uint64") == 1) { if (neg == 1) { return 0; } return 1; }
    if (sema_streq(t, "int64") == 1) {
        if (neg == 1) { if (mag <= (uint64)9223372036854775808) { return 1; } return 0; }
        if (mag <= (uint64)9223372036854775807) { return 1; } return 0;
    }
    if (sema_streq(t, "bool") == 1) { if (neg == 1) { return 0; } if (mag <= (uint64)1) { return 1; } return 0; }
    if (sema_streq(t, "uint8") == 1 || sema_streq(t, "char") == 1) { if (neg == 1) { return 0; } if (mag <= (uint64)255) { return 1; } return 0; }
    if (sema_streq(t, "uint16") == 1) { if (neg == 1) { return 0; } if (mag <= (uint64)65535) { return 1; } return 0; }
    if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) { if (neg == 1) { return 0; } if (mag <= (uint64)4294967295) { return 1; } return 0; }
    if (sema_streq(t, "int8") == 1) { if (neg == 1) { if (mag <= (uint64)128) { return 1; } return 0; } if (mag <= (uint64)127) { return 1; } return 0; }
    if (sema_streq(t, "int16") == 1) { if (neg == 1) { if (mag <= (uint64)32768) { return 1; } return 0; } if (mag <= (uint64)32767) { return 1; } return 0; }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1) { if (neg == 1) { if (mag <= (uint64)2147483648) { return 1; } return 0; } if (mag <= (uint64)2147483647) { return 1; } return 0; }
    return 1;
}

// Does the folded case value `v` lie in the range of integer type `t0`? (Mirrors the C++
// caseValueFits; a 64-bit or unknown subject holds every folded value.)
int sema_case_fits(string t0, int64 v) {
    string t = sema_strip_const(t0);
    int64 lo = (int64)0; int64 hi = (int64)-1;
    if (sema_streq(t, "bool") == 1) { hi = (int64)1; }
    else if (sema_streq(t, "char") == 1 || sema_streq(t, "uint8") == 1) { hi = (int64)255; }
    else if (sema_streq(t, "int8") == 1) { lo = (int64)-128; hi = (int64)127; }
    else if (sema_streq(t, "uint16") == 1) { hi = (int64)65535; }
    else if (sema_streq(t, "int16") == 1) { lo = (int64)-32768; hi = (int64)32767; }
    else if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) { hi = (int64)4294967295; }
    else if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1) { lo = (int64)-2147483648; hi = (int64)2147483647; }
    else { return 1; }
    if (v < lo || v > hi) { return 0; }
    return 1;
}

int64 sema_parse_int(string t);
// The value of an array dimension spelling: a number or a classic enum member (-1 when
// unknown, e.g. a `const` name).
int64 sema_dim_value(Sema* s, string dim) {
    if (sema_all_digits(dim) == 1) { return sema_parse_int(dim); }
    int i = 0; int n = List_len<EVar>(&s.evars);
    while (i < n) {
        EVar ev = List_get<EVar>(&s.evars, i);
        if (ev.plain == 1 && sema_streq(ev.variant, dim) == 1) { return sema_parse_int(ev.val); }
        i = i + 1;
    }
    return (int64)-1;
}

// Index of the `]` closing the array dimension that opens at `t[i]` (a `[`), or of the
// terminating NUL. A dimension is an expression (`int[K << 1]`, `int[K < 4 ? 2 : 1]`),
// so the type-spelling scanners skip over it rather than read its `<`, `>`, `*`, `(`.
int sema_dim_close(string t, int i) {
    int depth = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 91) { depth = depth + 1; }
        else if ((int)t[i] == 93) { depth = depth - 1; if (depth == 0) { return i; } }
        i = i + 1;
    }
    return i;
}

// Pointer levels of a type spelling, outside any `<...>` type arguments ("*Box<*int>" is 1).
int sema_ptr_depth(string t) {
    int stars = 0; int i = 0; int nest = 0;
    while (t[i] != 0) {
        int ch = (int)t[i];
        if (ch == 91) { i = sema_dim_close(t, i); if (t[i] == 0) { return stars; } }
        else if (ch == 60 || ch == 40) { nest = nest + 1; }
        else if ((ch == 62 || ch == 41) && nest > 0) { nest = nest - 1; }
        else if (ch == 42 && nest == 0) { stars = stars + 1; }
        i = i + 1;
    }
    return stars;
}

int sema_in_list(List<string>* l, string name) {
    int i = 0; int n = List_len<string>(l);
    while (i < n) { if (sema_streq(List_get<string>(l, i), name) == 1) { return 1; } i = i + 1; }
    return 0;
}

// Emit a semantic error with a fixed message at the position of the node being checked
// (`s.line:s.col`, 0:0 when unknown) and mark the check failed.
void sema_error(Sema* s, string msg) {
    s.had_error = 1;
    dprintf(2, "error: %s:%d:%d: %s\n", s.filename, s.line, s.col, msg);
}

int sema_has_sub(string t, string sub) {
    int i = 0;
    while (t[i] != 0) { if (ast_has_prefix((string)((*uint8)t + i), sub) == 1) { return 1; } i = i + 1; }
    return 0;
}
// The layout facts of the --target triple (mirrors cg_set_target): 4-byte pointers on
// 32-bit x86 and ARM, and int64/double aligned to 4 by the SysV i386 ABI.
void sema_set_target(Sema* s, string triple) {
    if (triple == null || triple[0] == 0) { return; }
    s.ptrsz = 8; s.i64al = 8;
    int win = sema_has_sub(triple, "windows") | sema_has_sub(triple, "win32") | sema_has_sub(triple, "mingw");
    s.msbf = win;
    ast_target_bf(triple, &s.bfal, &s.msvc);
    if (ast_has_prefix(triple, "aarch64") == 1 || ast_has_prefix(triple, "arm64") == 1
        || ast_has_prefix(triple, "x86_64") == 1 || ast_has_prefix(triple, "amd64") == 1) { return; }
    if (ast_has_prefix(triple, "i386") == 1 || ast_has_prefix(triple, "i486") == 1
        || ast_has_prefix(triple, "i586") == 1 || ast_has_prefix(triple, "i686") == 1) {
        s.ptrsz = 4;
        if (win == 0) { s.i64al = 4; }
        return;
    }
    if (ast_has_prefix(triple, "arm") == 1 || ast_has_prefix(triple, "thumb") == 1) { s.ptrsz = 4; }
}

int sema_fold_int(Sema* s, *ExprNode e, int64* out);
void sema_expr(Sema* s, *ExprNode e);
string sema_i64_text(int64 v) {
    *uint8 b = alloc<uint8>(24);
    sprintf((string)b, "%lld", v);
    return (string)b;
}
// Fold a classic enum's member value expressions (`B = A << 2`) into its members' values
// (the params' ty and the registered EVars), in order: a member's value may use the
// members before it. `report` checks each expression and diagnoses one that is not an
// integer constant expression (the declaration-order pass), then consumes the
// expressions. Mirrors the C++ TypeChecker::foldEnumValues.
void sema_fold_enum(Sema* s, *DeclNode d, int report) {
    int any = 0; int i = 0;
    while (i < List_len<*ExprNode>(&d.enum_vals)) { if (List_get<*ExprNode>(&d.enum_vals, i) != null) { any = 1; } i = i + 1; }
    if (any == 0) { return; }
    int sline = s.line; int scol = s.col;
    int known = 1; int seen = 0;
    int64 prev = (int64)0;
    i = 0;
    while (i < List_len<Param>(&d.params)) {
        Param pm = List_get<Param>(&d.params, i);
        *ExprNode ve = null;
        if (i < List_len<*ExprNode>(&d.enum_vals)) { ve = List_get<*ExprNode>(&d.enum_vals, i); }
        int64 v = sema_parse_int(pm.ty);
        if (ve != null) {
            seen = 1;
            int e0 = s.had_error; s.had_error = 0;
            if (report == 1) { s.line = ve.line; s.col = ve.col; sema_expr(s, ve); }
            int fresh = s.had_error;
            int64 r = (int64)0;
            known = 0;
            if (fresh == 0 && sema_fold_int(s, ve, &r) == 1) { known = 1; v = r; }
            if (known == 0 && fresh == 0 && report == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: value of enum member '%s' of '%s' is not an integer constant expression\n",
                        s.filename, ve.line, ve.col, pm.name, d.name);
            }
            if (e0 == 1) { s.had_error = 1; }
        } else if (seen == 1) {
            v = prev + (int64)1;
        }
        if (known == 1 || seen == 0) {
            pm.ty = sema_i64_text(v);
            List_set<Param>(&d.params, i, pm);
            int k = 0;
            while (k < List_len<EVar>(&s.evars)) {
                EVar ev = List_get<EVar>(&s.evars, k);
                if (sema_streq(ev.en, d.name) == 1 && sema_streq(ev.variant, pm.name) == 1) { ev.val = pm.ty; List_set<EVar>(&s.evars, k, ev); }
                k = k + 1;
            }
        }
        prev = sema_parse_int(pm.ty);
        i = i + 1;
    }
    s.line = sline; s.col = scol;
    if (report == 1 && s.had_error == 0) {
        i = 0;
        while (i < List_len<*ExprNode>(&d.enum_vals)) { List_set<*ExprNode>(&d.enum_vals, i, null); i = i + 1; }
    }
}

void sema_init(Sema* s, string filename) {
    memset((*void)s, 0, sizeof(Sema));   // every field starts as a valid empty value
    s.ptrsz = 8; s.i64al = 8; s.msbf = 0;
    ast_target_bf("", &s.bfal, &s.msvc);
#ifdef _WIN32
    s.msbf = 1;
#endif
    List_init<Sym>(&s.syms, 64);
    List_init<FnSig>(&s.fns, 32);
    List_init<string>(&s.types, 32);
    List_init<string>(&s.structs, 16);
    List_init<string>(&s.members, 64);
    List_init<string>(&s.enums, 16);
    List_init<EVar>(&s.evars, 32);
    List_init<*DeclNode>(&s.fndecls, 64);
    List_init<*DeclNode>(&s.ifaces, 16);
    List_init<*DeclNode>(&s.sdecls, 16);
    List_init<string>(&s.tparams, 4);
    List_init<*DeclNode>(&s.tdecls, 16);
    s.depth = 0;                           // global scope
    s.fold_depth = 0;
    s.had_error = 0;
    s.in_async = 0;
    s.await_seen = 0;
    s.cur_ret = ""; s.cur_ret_raw = "";
    s.match_ty = "";
    s.lam_ret = "";
    List_init<string>(&s.watched, 4);
    List_init<string>(&s.late_globals, 4);
    List_init<string>(&s.escaped, 4);
    List_init<string>(&s.narrowed, 4);
    s.has_ops = 0;
    List_init<*ExprNode>(&s.tern_ifn, 4);
    List_init<string>(&s.tern_ift, 4);
    List_init<string>(&s.loop_lbls, 4);
    List_init<int>(&s.lam_bounds, 4);
    List_init<int>(&s.lam_esc, 4);
    List_init<*ExprNode>(&s.lam_nodes, 4);
    List_init<string>(&s.lam_local_of, 4);
    s.lam_local = "";
    s.callee_ctx = "";
    s.sw_depth = 0;
    s.param_depth = 0 - 1;
    s.line = 0; s.col = 0;
    s.filename = filename;
    List_init<SInst>(&s.insts, 8);
    List_init<string>(&s.inst_seen, 8);
    List_init<string>(&s.isub_p, 4);
    List_init<string>(&s.isub_a, 4);
    s.in_inst = 0;
    s.inst_depth = 0;
}

// Bumped whenever an expression's type may change (a binding, a scope, a narrowing, a
// statement): a `?:` node's memoized type is valid within one epoch. Global, never reset,
// so a node typed by an earlier Sema (before the async lowering) is never stale.
int g_sema_epoch;
void sema_bump(Sema* s) { g_sema_epoch = g_sema_epoch + 1; }

void sema_push(Sema* s) { s.depth = s.depth + 1; sema_bump(s); }

void sema_pop(Sema* s) {
    sema_bump(s);
    int d = s.depth;
    while (List_len<Sym>(&s.syms) > 0) {
        Sym last = List_get<Sym>(&s.syms, List_len<Sym>(&s.syms) - 1);
        if (last.depth < d) { break; }
        List_remove<Sym>(&s.syms, List_len<Sym>(&s.syms) - 1);
    }
    s.depth = d - 1;
}

*DeclNode sema_find_tdecl(Sema* s, string name);

// `type NP = ?*N;`: a use of NP is the nullable pointer itself, so the `?` the
// null-safety checks read off the front of a type must be visible (mirrors the C++
// nullableAliasTarget).
string sema_nullable_alias(Sema* s, string t) {
    string cur = t;
    int hops = 0;
    while (hops < 64) {
        *DeclNode ad = sema_find_tdecl(s, cur);
        if (ad == null || ad.kind != DK_TYPEALIAS) { return t; }
        cur = ad.ret_type;
        if ((int)cur[0] == 63) { return cur; }
        hops = hops + 1;
    }
    return t;
}

void sema_define(Sema* s, string name, string type, int is_const) {
    let sym: Sym;
    sym.name = name;
    sym.type = sema_nullable_alias(s, type);
    sym.depth = s.depth;
    sym.is_const = is_const;
    sym.init = null;
    sym.is_static = 0;
    sym.addr_taken = 0;
    List_push<Sym>(&s.syms, sym);
    sema_bump(s);
}

// Record the initializer of the binding just defined, when it is a `const`.
void sema_set_const_init(Sema* s, *ExprNode init) {
    int n = List_len<Sym>(&s.syms);
    if (n == 0) { return; }
    Sym sym = List_get<Sym>(&s.syms, n - 1);
    if (sym.is_const == 0) { return; }
    sym.init = init;
    List_set<Sym>(&s.syms, n - 1, sym);
}

// Index of the innermost binding of `name` in the symbol stack, or -1 if unbound.
// The one reverse scan the symbol-table queries below share.
int sema_sym_index(Sema* s, string name) {
    int i = List_len<Sym>(&s.syms) - 1;
    while (i >= 0) {
        if (sema_streq(List_get<Sym>(&s.syms, i).name, name) == 1) { return i; }
        i = i - 1;
    }
    return -1;
}

// Retype the innermost binding of `name` (a `for (i in A..B)` decl widened to the
// bounds' common type after both were declared).
void sema_set_sym_type(Sema* s, string name, string type) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return; }
    Sym sym = List_get<Sym>(&s.syms, i);
    sym.type = type;
    List_set<Sym>(&s.syms, i, sym);
    sema_bump(s);
}

// Is `name` a read-only (const) binding?
int sema_sym_const(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return 0; }
    return List_get<Sym>(&s.syms, i).is_const;
}

// Scope depth of the innermost binding of `name`, or -1. Depth 0 = a global; a
// function-scope local or parameter is at depth >= 1.
int sema_sym_depth(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return -1; }
    return List_get<Sym>(&s.syms, i).depth;
}

int sema_lookup(Sema* s, string name) {
    if (sema_sym_index(s, name) >= 0) { return 1; }
    return 0;
}

// Declared type of `name` (innermost binding), or "" if unbound / untyped.
string sema_lookup_type(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return ""; }
    return List_get<Sym>(&s.syms, i).type;
}

// Is `name` bound in a local (non-global) scope? The innermost binding wins, so a
// local shadow of a global function means a call should NOT be arg-count-checked
// against the function signature (it could be a fn-pointer variable).
int sema_local_bound(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return 0; }
    if (List_get<Sym>(&s.syms, i).depth > 0) { return 1; }
    return 0;
}

// Is `name` a member of a classic (payload-free, non-generic) enum?
int sema_plain_member(Sema* s, string name) {
    int i = 0; int n = List_len<EVar>(&s.evars);
    while (i < n) {
        EVar ev = List_get<EVar>(&s.evars, i);
        if (ev.plain == 1 && sema_streq(ev.variant, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// The declared type of field `name` of struct/union `sn`, or null when it has no such
// field (a method is not a field).
string sema_field_type(Sema* s, string sn, string name) {
    *DeclNode d = sema_find_tdecl(s, sn);
    if (d == null || (d.kind != DK_STRUCT && d.kind != DK_UNION)) { return null; }
    int i = 0; int n = List_len<Param>(&d.params);
    while (i < n) {
        Param f = List_get<Param>(&d.params, i);
        if (sema_streq(f.name, name) == 1) { return f.ty; }
        i = i + 1;
    }
    return null;
}

// Is `name` a function declared `must_use`? (Discarding its result is an error.)
int sema_fn_must_use(Sema* s, string name) {
    int i = 0; int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.is_mustuse == 1 && sema_streq(d.name, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Register a non-generic function/extern/intrinsic signature. Generic functions are
// instantiated/inferred, so they get no fixed arg-count check (mirrors the C++
// funcTemplateDecls vs functionSignatures split).
void sema_register_fn(Sema* s, *DeclNode d) {
    if (List_len<TypeParam>(&d.type_params) > 0) { return; }
    let sig: FnSig;
    sig.name = d.name;
    int np = List_len<Param>(&d.params);
    sig.variadic = 0;
    sig.fixed = np;
    if (np > 0) {                          // guard List_get against a -1 index
        string lastty = List_get<Param>(&d.params, np - 1).ty;
        if (sema_streq(lastty, "...") == 1) {
            sig.variadic = 1;
            sig.fixed = np - 1;
        }
    }
    List_push<FnSig>(&s.fns, sig);
}

*DeclNode sema_find_tdecl(Sema* s, string name);
int sema_is_arr_ty(string t);
// A value type with no scalar meaning: a struct/union, a sum type, an interface value, a
// fixed array, a slice, or a closure (mirrors the C++ isAggregateValue). Such a value is
// not a truth value and has no built-in comparison.
int sema_is_aggregate(Sema* s, string t0) {
    string t = sema_strip_nullable(sema_strip_const(t0));
    if (t[0] == 0) { return 0; }
    if (sema_is_arr_ty(t) == 1 || sema_is_fn_type(t) == 1) { return 1; }
    if (sema_has_star(t) == 1) { return 0; }
    *DeclNode d = sema_find_tdecl(s, sema_base_name(t));
    if (d == null) { return 0; }
    if (d.kind == DK_STRUCT || d.kind == DK_UNION || d.kind == DK_INTERFACE) { return 1; }
    if (d.kind == DK_ENUM) {
        if (List_len<TypeParam>(&d.type_params) > 0) { return 1; }
        int i = 0;
        while (i < List_len<List<string>>(&d.payloads)) {
            List<string> pl = List_get<List<string>>(&d.payloads, i);
            if (List_len<string>(&pl) > 0) { return 1; }
            i = i + 1;
        }
    }
    return 0;
}

*DeclNode sema_find_iface(Sema* s, string name);
string sema_canon(Sema* s, string t0);
// An interface value (not a pointer to one)? It is a truth value (true when not null) and
// compares with `null` (mirrors the C++ isTruthValue).
int sema_is_iface_val(Sema* s, string t0) {
    if (t0 == null || t0[0] == 0) { return 0; }
    string c = sema_canon(s, sema_strip_nullable(sema_strip_const(t0)));
    if (sema_has_star(c) == 1) { return 0; }
    if (sema_find_iface(s, c) != null) { return 1; }
    return 0;
}

// A struct value (not a pointer to one, not an array of them)?
int sema_is_struct_value(Sema* s, string t) {
    if (t[0] == 0 || sema_has_star(t) == 1 || sema_is_arr_ty(t) == 1) { return 0; }
    return sema_is_struct(s, sema_base_name(t));
}

int sema_find_fn(Sema* s, string name) {
    int i = 0;
    int n = List_len<FnSig>(&s.fns);
    while (i < n) {
        if (sema_streq(List_get<FnSig>(&s.fns, i).name, name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

int sema_is_type(Sema* s, string name) {
    return sema_in_list(&s.types, name);
}

// Leading name of a spelling, up to a generic '<' or payload '(':
// "Box<int>" -> "Box", "A(x)" -> "A", "W" -> "W".
string sema_base_name(string sp) {
    int n = 0;
    while (sp[n] != 0 && (int)sp[n] != 60 && (int)sp[n] != 40) {   // '<' or '('
        if ((int)sp[n] == 91) { n = sema_dim_close(sp, n); if (sp[n] == 0) { return sp; } }
        n = n + 1;
    }
    if ((int)sp[n] == 0) { return sp; }
    *uint8 buf = alloc<uint8>(n + 1);
    int i = 0;
    while (i < n) { buf[i] = (uint8)sp[i]; i = i + 1; }
    buf[n] = 0;
    return (string)buf;
}

string sema_cat(string a, string b) {
    int la = 0; while (a[la] != 0) { la = la + 1; }
    int lb = 0; while (b[lb] != 0) { lb = lb + 1; }
    *uint8 buf = alloc<uint8>(la + lb + 1);
    int i = 0; while (i < la) { buf[i] = (uint8)a[i]; i = i + 1; }
    int j = 0; while (j < lb) { buf[la + j] = (uint8)b[j]; j = j + 1; }
    buf[la + lb] = 0;
    return (string)buf;
}

// Reduce a type spelling to its base struct name: strip leading '*'/spaces and any
// generic '<...>' or pointer suffix, and a `const` qualifier (`const P*` names P).
// "*Point" -> "Point", "List<int>" -> "List".
string sema_struct_of_type(string t0) {
    string t = sema_strip_const(t0);
    int i = 0;
    while ((int)t[i] == 42 || (int)t[i] == 32 || (int)t[i] == 63) { i = i + 1; }   // skip '*' / ' ' / '?'
    int j = i;
    while (t[j] != 0 && (int)t[j] != 60 && (int)t[j] != 42 && (int)t[j] != 32) {
        if ((int)t[j] == 91) { j = sema_dim_close(t, j); if (t[j] == 0) { break; } }
        j = j + 1;
    }
    int len = j - i;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0; while (k < len) { buf[k] = (uint8)t[i + k]; k = k + 1; }
    buf[len] = 0;
    return (string)buf;
}

// `t` with every space removed ("Result<int, string>" -> "Result<int,string>").
string sema_nospace(string t) {
    int n = 0; while (t[n] != 0) { n = n + 1; }
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0; int i = 0;
    while (i < n) { if ((int)t[i] != 32) { buf[o] = (uint8)t[i]; o = o + 1; } i = i + 1; }
    buf[o] = 0;
    return (string)buf;
}
int sema_has_lt(string t) {
    int i = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 60) { return 1; }
        if ((int)t[i] == 91) { i = sema_dim_close(t, i); if (t[i] == 0) { return 0; } }
        i = i + 1;
    }
    return 0;
}

// Is `t` a spelling of a known type? Its base name (pointer stars, generic args and array
// dims stripped) must be a primitive or a declared type. fn types are accepted as-is.
int sema_known_type(Sema* s, string t) {
    if (sema_is_fn_type(t) == 1) { return 1; }
    string b0 = sema_struct_of_type(sema_strip_nullable(sema_strip_const(t)));
    if (sema_is_fn_type(b0) == 1) { return 1; }                          // a pointer to a fn value
    int n = 0; while (b0[n] != 0 && (int)b0[n] != 91) { n = n + 1; }   // cut at '['
    string b = sema_sub_str(b0, 0, n);
    if (sema_is_fn_type(b) == 1) { return 1; }         // a pointer to / array of fn(...)->R
    if (sema_is_numeric_ty(b) == 1 || sema_streq(b, "void") == 1 || sema_streq(b, "string") == 1
        || sema_streq(b, "va_list") == 1) { return 1; }
    if (sema_in_list(&s.tparams, b) == 1) { return 1; }
    return sema_in_list(&s.types, b);
}

// The declaration of type `name` (struct/union/enum/interface/alias), or null.
*DeclNode sema_find_tdecl(Sema* s, string name) {
    int i = 0; int n = List_len<*DeclNode>(&s.tdecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.tdecls, i);
        if (sema_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

// A declared type spelling (field / parameter / return / variable) must name known types,
// and a generic instance must supply exactly the template's type-parameter count
// (mirrors the C++ validateStructType).
int sema_fold_int(Sema* s, *ExprNode e, int64* out);
int sema_fold_num(Sema* s, *ExprNode e, int* is_int, int64* iv, double* dv);
string sema_trim_sub(string s, int a, int b);
void sema_check_decl_type(Sema* s, string t);
string sema_resolve_scalar(Sema* s, string t0);
string sema_isub(Sema* s, string t);
// `sizeof(t)` for a scalar whose size is the same on every target (0 otherwise).
int64 sema_fixed_scalar_size(string t) {
    if (sema_streq(t, "int8") == 1 || sema_streq(t, "uint8") == 1 || sema_streq(t, "char") == 1
        || sema_streq(t, "bool") == 1) { return (int64)1; }
    if (sema_streq(t, "int16") == 1 || sema_streq(t, "uint16") == 1) { return (int64)2; }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1 || sema_streq(t, "uint") == 1
        || sema_streq(t, "uint32") == 1 || sema_streq(t, "float") == 1) { return (int64)4; }
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1 || sema_streq(t, "double") == 1) { return (int64)8; }
    return (int64)0;
}
string sema_dealias(Sema* s, string t0);
int sema_is_plain_enum_decl(*DeclNode d);
int64 sema_const_layout(Sema* s, string t0, int64* al, int depth);
// A name in a dimension that sema_const_layout folds: a classic enum member, a `const`
// int, or `sizeof(T)` of a type whose layout is known.
int sema_layout_dim_name(Sema* s, string nm, int64* out) {
    if (ast_has_prefix(nm, "sizeof(") == 1) {
        int64 zal = (int64)1;
        *out = sema_const_layout(s, sema_sub_str(nm, 7, sema_slen(nm) - 1), &zal, 1);
        return (int)(*out > (int64)0);
    }
    int64 ev = sema_dim_value(s, nm);
    if (ev >= (int64)0) { *out = ev; return 1; }
    int si = sema_sym_index(s, nm);
    if (si < 0) { return 0; }
    Sym sy = List_get<Sym>(&s.syms, si);
    if (sy.is_const == 1 && sy.init != null && sema_fold_int(s, sy.init, out) == 1) { return 1; }
    return 0;
}
// Size (and ABI alignment in *al) of a concrete type as the target lays it out, mirroring
// the C++ TypeChecker::constLayout and the codegen layout (cg_size): scalars, pointers,
// closures, interfaces, slices, fixed arrays, and structs and unions of those (C layout,
// `packed`). 0 for a layout only codegen knows here: a generic instance, a sum type, a
// bitfield struct, `#pragma pack(N)` with N >= 2, `va_list`, a type parameter.
int64 sema_const_layout(Sema* s, string t0, int64* al, int depth) {
    al[0] = (int64)1;
    if (depth > 64 || t0 == null) { return (int64)0; }
    string t = sema_strip_const(sema_dealias(s, sema_strip_const(t0)));
    if ((int)t[0] == 63) { t = sema_sub_str(t, 1, sema_slen(t)); }                 // '?'
    int n = sema_slen(t);
    if (n == 0) { return (int64)0; }
    int64 ps = (int64)s.ptrsz;
    // The outermost array or slice is the first `[...]` outside any `<...>` or `(...)`.
    int k = 0; int dep = 0; int ob = 0 - 1;
    while (k < n && ob < 0) {
        int c = (int)t[k];
        if (c == 60 || c == 40) { dep = dep + 1; }
        else if ((c == 62 && k > 0 && (int)t[k - 1] != 45) || c == 41) { dep = dep - 1; }
        else if (c == 91 && dep == 0) { ob = k; }
        k = k + 1;
    }
    if (ob > 0 && (int)t[n - 1] == 93) {
        int cb = sema_dim_close(t, ob);
        string rest = sema_cat(sema_sub_str(t, 0, ob), sema_sub_str(t, cb + 1, n));
        if (cb == ob + 1) {                                                       // `T[]`: {ptr, i64}
            int64 sal = (int64)s.i64al; if (ps > sal) { sal = ps; }
            al[0] = sal;
            int64 off = ((ps + (int64)s.i64al - (int64)1) / (int64)s.i64al) * (int64)s.i64al + (int64)8;
            return ((off + sal - (int64)1) / sal) * sal;
        }
        string dim = sema_trim_sub(t, ob + 1, cb);
        int64 dv = (int64)0;
        int known = 0;
        if (sema_all_digits(dim) == 1) { dv = sema_parse_int(dim); known = 1; }
        else { known = ast_fold_dim(dim, int(string nm, *int64 out) { return sema_layout_dim_name(s, nm, out); }, &dv); }
        if (known == 0 || dv <= (int64)0) { return (int64)0; }
        int64 eal = (int64)1;
        int64 esz = sema_const_layout(s, rest, &eal, depth + 1);
        al[0] = eal;
        return esz * dv;
    }
    if ((int)t[0] == 42 || (int)t[n - 1] == 42 || sema_streq(t, "string") == 1) { al[0] = ps; return ps; }
    if (sema_is_fn_type(t) == 1) { al[0] = ps; return ps * (int64)2; }
    int64 fx = sema_fixed_scalar_size(t);
    if (fx > (int64)0) {
        al[0] = fx;
        if (fx == (int64)8) { al[0] = (int64)s.i64al; }
        return fx;
    }
    List<string> targs; List_init<string>(&targs, 2);
    string base = t;
    int i = 0; while (i < n && (int)t[i] != 60) { i = i + 1; }
    if (i < n) { base = sema_base_name(t); sema_parse_targs(t, &targs); }   // a generic instance
    if (sema_in_list(&s.tparams, base) == 1) { return (int64)0; }
    *DeclNode d = sema_find_tdecl(s, base);
    if (d == null) { return (int64)0; }
    if (List_len<TypeParam>(&d.type_params) != List_len<string>(&targs)) { return (int64)0; }
    return sema_decl_layout(s, d, &targs, al, depth);
}

int64 sema_up(int64 x, int64 a) { if (a <= (int64)0) { return x; } return ((x + a - (int64)1) / a) * a; }

// Size (and alignment in al[0]) of a declared type with its type arguments `targs`, as
// codegen lays it out; 0 when only codegen knows it (a `pack(N>=2)` struct, a `: 0`
// bitfield). Mirrors C++ TypeChecker::constLayout / bitfieldLayout.
int64 sema_decl_layout(Sema* s, *DeclNode d, List<string>* targs, int64* al, int depth) {
    int64 ps = (int64)s.ptrsz;
    if (d.kind == DK_INTERFACE) { al[0] = ps; return ps * (int64)2; }
    if (d.kind == DK_ENUM) {
        if (sema_is_plain_enum_decl(d) == 1) { al[0] = (int64)4; return (int64)4; }
        // { i32 tag, [N x i64] payload }, N the largest variant's bytes in i64s.
        int64 maxb = (int64)0;
        int vi = 0;
        while (vi < List_len<List<string>>(&d.payloads)) {
            List<string> pl = List_get<List<string>>(&d.payloads, vi);
            int64 b = (int64)0;
            int pi = 0;
            while (pi < List_len<string>(&pl)) {
                int64 pal = (int64)1;
                int64 psz = sema_const_layout(s, sema_subst_params(List_get<string>(&pl, pi), &d.type_params, targs), &pal, depth + 1);
                if (psz == (int64)0) { return (int64)0; }
                b = sema_up(b, pal) + psz;
                pi = pi + 1;
            }
            if (b > maxb) { maxb = b; }
            vi = vi + 1;
        }
        int64 nw = (maxb + (int64)7) / (int64)8; if (nw == (int64)0) { nw = (int64)1; }
        int64 ea = (int64)s.i64al; if (ea < (int64)4) { ea = (int64)4; }
        al[0] = ea;
        return sema_up(sema_up((int64)4, (int64)s.i64al) + (int64)8 * nw, ea);
    }
    if (d.kind != DK_STRUCT && d.kind != DK_UNION) { return (int64)0; }
    // `#pragma pack(N>=2)`: each alignment capped at N and bitfields packed back to back;
    // the struct (or union) is as aligned as its most aligned (capped) field, as C
    // (mirrors the C++ constLayout).
    int64 packn = (int64)0;
    if (d.is_packed == 0 && d.pack_align >= 2) { packn = (int64)d.pack_align; }
    List<Param> lfs; List<int> lbits; List<int> lnamed;
    ast_layout_fields(d, &lfs, &lbits, &lnamed);
    int nf = List_len<Param>(&lfs);
    int hasbits = 0;
    if (List_len<string>(&d.pad_tys) > 0) { hasbits = 1; }
    int fi = 0;
    while (fi < nf) {
        if (List_get<int>(&lbits, fi) != 0) { hasbits = 1; }
        fi = fi + 1;
    }
    if (hasbits == 1 && d.kind == DK_UNION) { return (int64)0; }
    int64 off = (int64)0; int64 maxal = (int64)1;
    int64 bitpos = (int64)0;                         // SysV bitfield cursor
    int open = 0; int64 curbits = (int64)0; int64 curoff = (int64)0;   // MS open storage word
    int after = 0;                                   // MS: the previous field is a bitfield
    fi = 0;
    while (fi < nf) {
        int bw = List_get<int>(&lbits, fi);
        int unnamed = 1 - List_get<int>(&lnamed, fi);
        if (bw < 0) { return (int64)0; }
        int64 fal = (int64)1;
        int64 fsz = sema_const_layout(s, sema_subst_params(List_get<Param>(&lfs, fi).ty, &d.type_params, targs), &fal, depth + 1);
        if (fsz == (int64)0) { return (int64)0; }
        int64 nat = fal;
        if (d.is_packed == 1) { fal = (int64)1; }
        if (packn > (int64)0 && fal > packn) { fal = packn; }
        if (hasbits == 0) {
            if (fal > maxal) { maxal = fal; }
            if (d.kind == DK_UNION) { if (fsz > off) { off = fsz; } }
            else { off = sema_up(off, fal) + fsz; }
        } else if (s.msbf == 1) {                    // MS: each storage word is an element
            if (unnamed == 1 && bw == 0) {
                // A `: 0` right after a bitfield closes the word and aligns the next field
                // to its type (capped by the packing on MSVC only); elsewhere it is ignored.
                if (after == 1) {
                    int64 za = nat; if (s.msvc == 1) { za = fal; }
                    off = sema_up(off, za); if (za > maxal) { maxal = za; }
                }
                open = 0; after = 0;
            } else if (bw > 0) {
                int64 stb = fsz * (int64)8;
                if (open == 0 || curbits != stb || curoff + (int64)bw > stb) {
                    off = sema_up(off, fal) + fsz; if (fal > maxal) { maxal = fal; }
                    open = 1; curbits = stb; curoff = (int64)0;
                }
                curoff = curoff + (int64)bw;
                after = 1;
            } else {
                open = 0; after = 0;
                off = sema_up(off, fal) + fsz; if (fal > maxal) { maxal = fal; }
            }
        } else if (unnamed == 1 && bw == 0) {        // SysV / AAPCS `: 0`: next boundary of its type
            bitpos = sema_up(bitpos, nat * (int64)8);
            if (s.bfal == 1 && nat > maxal) { maxal = nat; }
        } else {                                     // SysV / AAPCS (an unnamed one aligns only on AAPCS)
            if ((unnamed == 0 || s.bfal == 1) && fal > maxal) { maxal = fal; }
            if (bw > 0) {
                int64 ub = fsz * (int64)8;
                if (d.is_packed == 0 && packn == (int64)0 && fal < fsz) {
                    // Aligned below its size (int64 on 32-bit x86 SysV): may not cross its
                    // size from an alignment boundary.
                    if (bitpos % (fal * (int64)8) + (int64)bw > ub) { bitpos = sema_up(bitpos, fal * (int64)8); }
                } else if (d.is_packed == 0 && packn == (int64)0 && bitpos / ub != (bitpos + (int64)bw - (int64)1) / ub) { bitpos = sema_up(bitpos, ub); }
                bitpos = bitpos + (int64)bw;
            } else {
                int64 fo = sema_up((bitpos + (int64)7) / (int64)8, fal);
                bitpos = (fo + fsz) * (int64)8;
            }
        }
        fi = fi + 1;
    }
    if (hasbits == 1 && s.msbf == 0) { off = (bitpos + (int64)7) / (int64)8; }
    al[0] = maxal;
    return sema_up(off, maxal);
}
int64 sema_const_sizeof(Sema* s, string t) {
    int64 al = (int64)1;
    return sema_const_layout(s, t, &al, 0);
}
// Does dimension text `dim` have a `sizeof(T)` whose size is target layout? Its value is
// then left to codegen.
int sema_dim_sized_later(Sema* s, string dim) {
    int n = 0; while (dim[n] != 0) { n = n + 1; }
    int i = 0;
    while (i + 7 <= n) {
        if (sema_streq(sema_sub_str(dim, i, i + 7), "sizeof(") == 1) {
            int j = i + 7; int depth = 1;
            while (j < n && depth > 0) {
                if (dim[j] == '(') { depth = depth + 1; } else if (dim[j] == ')') { depth = depth - 1; }
                j = j + 1;
            }
            if (sema_const_sizeof(s, sema_trim_sub(dim, i + 7, j - 1)) == (int64)0) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}
// A name in a dimension expression: a classic enum member or an in-scope `const` int.
// `sizeof(T)`: T must be a sized type; codegen, which knows the layout, folds the size
// (mirrors the C++ checkArrayDim).
int sema_dim_name(Sema* s, string nm, int64* out) {
    if (ast_has_prefix(nm, "sizeof(") == 1) {
        int nl = 0; while (nm[nl] != 0) { nl = nl + 1; }
        string t = sema_sub_str(nm, 7, nl - 1);
        int e0 = s.had_error; s.had_error = 0;
        sema_check_decl_type(s, t);
        if (s.had_error == 0 && sema_is_void_value(sema_resolve_scalar(s, sema_isub(s, t))) == 1) {
            sema_error(s, "sizeof of 'void': a void value has no size");
        }
        int fine = 1 - s.had_error;
        if (e0 == 1) { s.had_error = 1; }
        *out = (int64)0;
        if (fine == 1) { *out = sema_const_sizeof(s, t); }
        if (*out == (int64)0) { *out = (int64)8; }
        return 1;
    }
    int64 ev = sema_dim_value(s, nm);
    if (ev >= (int64)0) { *out = ev; return 1; }
    int si = sema_sym_index(s, nm);
    if (si < 0) { return 0; }
    Sym sy = List_get<Sym>(&s.syms, si);
    if (sy.depth == 0 && sema_in_list(&s.late_globals, nm) == 1) { return 0; }
    if (sy.is_const == 1 && sy.init != null && sema_fold_int(s, sy.init, out) == 1) { return 1; }
    return 0;
}
// Each fixed-array dimension `[N]` of `t` (a number, an enum member, or a `const` int)
// must be positive (mirrors the C++ checkArrayDim).
void sema_check_dims(Sema* s, string t) {
    int i = 0;
    while (t[i] != 0) {
        if ((int)t[i] == 91 && (int)t[i + 1] != 93) {          // '[' not followed by ']'
            int st = i + 1; int j = st;
            while (t[j] != 0 && (int)t[j] != 93) { j = j + 1; }
            string dim = sema_trim_sub(t, st, j);
            int64 v = (int64)0; int known = 0;
            if ((int)dim[0] == 45 || sema_all_digits(dim) == 1) { v = sema_parse_int(dim); known = 1; }
            else {
                int64 ev = sema_dim_value(s, dim);
                if (ev >= (int64)0) { v = ev; known = 1; }
                int si = sema_sym_index(s, dim);
                if (known == 0 && si >= 0) {
                    Sym sy = List_get<Sym>(&s.syms, si);
                    int later = 0;                    // a global declared further down is not in scope yet
                    if (sy.depth == 0 && sema_in_list(&s.late_globals, dim) == 1) { later = 1; }
                    if (later == 0 && sy.is_const == 1 && sy.init != null && sema_fold_int(s, sy.init, &v) == 1) { known = 1; }
                }
                // An integer constant expression (`(uint8)258`, `N*2`), folded like a `const`
                // (mirrors the C++ checkArrayDim).
                if (known == 0 && si < 0) {
                    known = ast_fold_dim(dim, int(string nm, *int64 out) { return sema_dim_name(s, nm, out); }, &v);
                }
            }
            if (known == 1 && v <= (int64)0 && sema_dim_sized_later(s, dim) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: array size must be positive, got %lld\n", s.filename, s.line, s.col, v);
            }
            if (known == 0 && dim[0] != 0) {             // no variable-length arrays
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: array size must be a compile-time constant, got '%s'\n", s.filename, s.line, s.col, dim);
            }
            i = j;
        } else { i = i + 1; }
    }
}

// Whether `t` is one of `d`'s type parameters.
int sema_names_tparam(*DeclNode d, string t) {
    int k = 0;
    while (k < List_len<TypeParam>(&d.type_params)) {
        if (sema_streq(List_get<TypeParam>(&d.type_params, k).name, t) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

// A generic struct's bitfield typed by a type parameter is checked with the instance's
// type argument (mirrors the C++ per-instance checkBitfield).
void sema_check_inst_bitfields(Sema* s, *DeclNode d, List<string>* targs) {
    if (d.kind != DK_STRUCT) { return; }
    int i = 0;
    while (i < List_len<Param>(&d.params) && i < List_len<int>(&d.field_bits)) {
        Param f = List_get<Param>(&d.params, i);
        int bw = List_get<int>(&d.field_bits, i);
        int k = 0;
        while (bw > 0 && k < List_len<TypeParam>(&d.type_params) && k < List_len<string>(targs)) {
            if (sema_streq(List_get<TypeParam>(&d.type_params, k).name, f.ty) == 1) {
                string at = List_get<string>(targs, k);
                int tb = sema_int_bits(sema_bitfield_base(s, at));
                if (tb == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' must have an integer type, got '%s'\n", s.filename, s.line, s.col, f.name, d.name, at);
                } else if (bw > tb) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' is %d bits wide, more than its type '%s' holds (%d)\n",
                           s.filename, s.line, s.col, f.name, d.name, bw, at, tb);
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

void sema_check_decl_type(Sema* s, string t) {
    if (t == null || t[0] == 0 || sema_streq(t, "...") == 1 || sema_is_fn_type(t) == 1) { return; }
    if ((int)t[0] == 63 && sema_known_type(s, t) == 1 && sema_c_ptr(sema_canon(s, t)) == 0) {   // `?` marks a pointer only
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: a nullable type must be a pointer ('?*T'), got '%s'\n", s.filename, s.line, s.col, t);
        return;
    }
    sema_check_dims(s, t);
    if (sema_known_type(s, t) == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: unknown type '%s'\n", s.filename, s.line, s.col, sema_base_name(sema_struct_of_type(t)));
        return;
    }
    string b = sema_base_name(sema_struct_of_type(sema_strip_nullable(sema_strip_const(t))));
    *DeclNode d = sema_find_tdecl(s, b);
    List<string> targs; List_init<string>(&targs, 2);
    sema_parse_targs(t, &targs);
    int want = 0;
    if (d != null) { want = List_len<TypeParam>(&d.type_params); }
    int got = List_len<string>(&targs);
    if (d != null && (want > 0 || got > 0) && want != got) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: '%s' expects %d type argument(s), got %d\n", s.filename, s.line, s.col, b, want, got);
        return;
    }
    int k = 0;
    while (k < got) { sema_check_decl_type(s, List_get<string>(&targs, k)); k = k + 1; }
    if (d != null && want > 0 && want == got) {
        sema_check_constraints(s, &d.type_params, &targs);
        sema_check_inst_bitfields(s, d, &targs);
    }
}

// Name of the struct/union a field of type `ft` holds BY VALUE ("" for a pointer, slice,
// fn, or non-struct): a fixed-size array of a struct still holds it by value.
string sema_value_struct(Sema* s, string ft) {
    if (sema_has_star(ft) == 1 || sema_is_fn_type(ft) == 1) { return ""; }
    int i = 0; while (ft[i] != 0) { if ((int)ft[i] == 91 && (int)ft[i + 1] == 93) { return ""; } i = i + 1; }   // "[]" slice
    string b0 = sema_strip_const(ft);
    int n = 0; while (b0[n] != 0 && (int)b0[n] != 91) { n = n + 1; }
    string b = sema_base_name(sema_sub_str(b0, 0, n));
    *DeclNode d = sema_find_tdecl(s, b);
    int hops = 0;                          // through type aliases (`type SS = S;`)
    while (d != null && d.kind == DK_TYPEALIAS && hops < 32) {
        string at = d.ret_type;
        if (sema_has_star(at) == 1 || sema_is_fn_type(at) == 1) { return ""; }
        int k = 0; while (at[k] != 0) { if ((int)at[k] == 91 && (int)at[k + 1] == 93) { return ""; } k = k + 1; }
        string a0 = sema_strip_const(at);
        int an = 0; while (a0[an] != 0 && (int)a0[an] != 91) { an = an + 1; }
        b = sema_base_name(sema_sub_str(a0, 0, an));
        d = sema_find_tdecl(s, b);
        hops = hops + 1;
    }
    if (d == null || (d.kind != DK_STRUCT && d.kind != DK_UNION && d.kind != DK_ENUM)) { return ""; }
    if (List_len<TypeParam>(&d.type_params) > 0) { return ""; }
    return b;
}

// The by-value members of an aggregate (mirrors the C++ VNode): a struct/union's field
// types, or an enum's variant payload types; `descs` gets "field 'x'" / "variant 'V'".
void sema_value_members(*DeclNode d, List<string>* types, List<string>* descs) {
    int i = 0; int n = List_len<Param>(&d.params);
    while (i < n) {
        Param f = List_get<Param>(&d.params, i);
        if (d.kind == DK_ENUM) {
            if (i < List_len<List<string>>(&d.payloads)) {
                List<string> pl = List_get<List<string>>(&d.payloads, i);
                int j = 0;
                while (j < List_len<string>(&pl)) {
                    List_push<string>(types, List_get<string>(&pl, j));
                    List_push<string>(descs, sema_cat(sema_cat("variant '", f.name), "'"));
                    j = j + 1;
                }
            }
        } else {
            List_push<string>(types, f.ty);
            List_push<string>(descs, sema_cat(sema_cat("field '", f.name), "'"));
        }
        i = i + 1;
    }
}

string sema_value_kind(*DeclNode d) {
    if (d != null && d.kind == DK_ENUM) { return "enum"; }
    return "struct";
}

// An aggregate with by-value members: a struct, a union, or a sum type (an enum with a
// payload).
int sema_is_value_aggr(*DeclNode d) {
    if (d == null) { return 0; }
    if (d.kind == DK_STRUCT || d.kind == DK_UNION) { return 1; }
    if (d.kind != DK_ENUM) { return 0; }
    int i = 0;
    while (i < List_len<List<string>>(&d.payloads)) {
        List<string> pl = List_get<List<string>>(&d.payloads, i);
        if (List_len<string>(&pl) > 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

// DFS for a struct/union that contains itself by value (no finite layout). `onstack` holds
// the current path, `done` the finished nodes, `reported` the already-diagnosed structs.
void sema_cycle_dfs(Sema* s, *DeclNode d, List<string>* onstack, List<string>* done, List<string>* reported) {
    List_push<string>(onstack, d.name);
    s.line = d.line; s.col = d.col;
    List<string> ftys; List_init<string>(&ftys, 4);
    List<string> fdescs; List_init<string>(&fdescs, 4);
    sema_value_members(d, &ftys, &fdescs);
    int i = 0; int n = List_len<string>(&ftys);
    while (i < n) {
        string m = sema_value_struct(s, List_get<string>(&ftys, i));
        if (m[0] != 0) {
            if (sema_in_list(onstack, m) == 1) {
                if (sema_in_list(reported, m) == 0) {
                    List_push<string>(reported, m);
                    s.had_error = 1;
                    *DeclNode md = sema_find_tdecl(s, m);
                    dprintf(2, "error: %s:%d:%d: %s '%s' contains itself by value (through %s of '%s'); use a pointer\n",
                           s.filename, md.line, md.col, sema_value_kind(md), m, List_get<string>(&fdescs, i), d.name);
                }
            } else if (sema_in_list(done, m) == 0) {
                sema_cycle_dfs(s, sema_find_tdecl(s, m), onstack, done, reported);
            }
        }
        i = i + 1;
    }
    sema_list_erase(onstack, d.name);
    List_push<string>(done, d.name);
}

// The struct spelling a field of type `ft` holds by value, through generic instances too
// ("" for a pointer, slice, fn, or non-struct); array suffixes are peeled. Spaces dropped.
string sema_value_core_n(Sema* s, string ft, int hops);
string sema_value_core(Sema* s, string ft) { return sema_value_core_n(s, ft, 0); }
// An alias is resolved (`type RA = W<RB>` holds a `W<RB>`), then arrays peeled again.
string sema_value_core_n(Sema* s, string ft, int hops) {
    string t = sema_nospace(sema_strip_nullable(sema_strip_const(ft)));
    if ((int)t[0] == 42 || (int)t[0] == 63 || sema_is_fn_type(t) == 1) { return ""; }
    int depth = 0; int n = 0;
    while (t[n] != 0) {
        int c = (int)t[n];
        if (c == 60) { depth = depth + 1; }
        else if (c == 62) { depth = depth - 1; }
        else if (c == 91 && depth == 0) { break; }
        n = n + 1;
    }
    if (t[n] != 0 && (int)t[n + 1] == 93) { return ""; }        // "T[]" slice
    string core = sema_sub_str(t, 0, n);
    int m = 0; while (core[m] != 0) { m = m + 1; }
    if (m == 0 || (int)core[m - 1] == 42) { return ""; }         // trailing-star pointer
    *DeclNode d = sema_find_tdecl(s, sema_base_name(core));
    if (d != null && d.kind == DK_TYPEALIAS && hops < 32) { return sema_value_core_n(s, d.ret_type, hops + 1); }
    if (sema_is_value_aggr(d) == 0) { return ""; }
    return core;
}

// Walk the by-value field spellings of struct spelling `sp` (a generic instance's type
// arguments substituted), with `stack` the current path. A spelling that recurs on it is
// a cycle through a generic instance; a path of ever-growing instances (`N<N<T>> next`)
// has no finite layout either. Reports once per struct (`reported`); 1 = stop the walk.
// Mirrors the generic part of the C++ TypeChecker::checkValueCycles.
int sema_gen_cycle_walk(Sema* s, string sp, List<string>* stack, *DeclNode root, List<string>* reported) {
    *DeclNode d = sema_find_tdecl(s, sema_base_name(sp));
    if (d == null) { return 0; }
    List<string> args; List_init<string>(&args, 2); ast_targs(sp, &args);
    if (List_len<TypeParam>(&d.type_params) != List_len<string>(&args)) { return 0; }
    List_push<string>(stack, sp);
    List<string> ftys; List_init<string>(&ftys, 4);
    List<string> fdescs; List_init<string>(&fdescs, 4);
    sema_value_members(d, &ftys, &fdescs);
    int i = 0; int n = List_len<string>(&ftys);
    while (i < n) {
        string fdesc = List_get<string>(&fdescs, i);
        string core = sema_value_core(s, sema_subst_params(List_get<string>(&ftys, i), &d.type_params, &args));
        if (core[0] != 0) {
            int hit = 0 - 1;
            int k = 0; while (k < List_len<string>(stack)) { if (sema_streq(List_get<string>(stack, k), core) == 1) { hit = k; } k = k + 1; }
            string msg = ""; string key = "";
            if (hit >= 0) {
                int gen = 0;
                k = hit; while (k < List_len<string>(stack)) { if (sema_has_lt(List_get<string>(stack, k)) == 1) { gen = 1; } k = k + 1; }
                if (gen == 1) { key = sema_base_name(core); msg = "cycle"; }
            } else if (List_len<string>(stack) >= 64) {
                key = sema_base_name(List_get<string>(stack, 0)); msg = "deep";
            } else if (sema_gen_cycle_walk(s, core, stack, root, reported) == 1) {
                List_remove<string>(stack, List_len<string>(stack) - 1);
                return 1;
            }
            if (msg[0] != 0) {
                if (sema_in_list(reported, key) == 0) {
                    List_push<string>(reported, key);
                    s.had_error = 1;
                    string kw = sema_value_kind(sema_find_tdecl(s, key));
                    if (sema_streq(msg, "cycle") == 1) {
                        dprintf(2, "error: %s:%d:%d: %s '%s' contains itself by value (through %s of '%s'); use a pointer\n",
                               s.filename, root.line, root.col, kw, core, fdesc, sp);
                    } else {
                        dprintf(2, "error: %s:%d:%d: %s '%s' contains itself by value through ever-deeper generic instances (%s of '%s'); use a pointer\n",
                               s.filename, root.line, root.col, kw, key, fdesc, sema_base_name(sp));
                    }
                }
                List_remove<string>(stack, List_len<string>(stack) - 1);
                return 1;
            }
        }
        i = i + 1;
    }
    List_remove<string>(stack, List_len<string>(stack) - 1);
    return 0;
}

void sema_check_value_cycles(Sema* s) {
    List<string> onstack; List_init<string>(&onstack, 4);
    List<string> done; List_init<string>(&done, 8);
    List<string> reported; List_init<string>(&reported, 2);
    int i = 0; int n = List_len<*DeclNode>(&s.tdecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.tdecls, i);
        if (sema_is_value_aggr(d) == 1 && List_len<TypeParam>(&d.type_params) == 0
            && sema_in_list(&done, d.name) == 0) {
            sema_cycle_dfs(s, d, &onstack, &done, &reported);
        }
        i = i + 1;
    }
    // Through generic instances: from every struct (a generic one with its own type
    // parameters, `N<T>`).
    List<string> greported; List_init<string>(&greported, 2);
    i = 0;
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.tdecls, i);
        if (sema_is_value_aggr(d) == 1) {
            string sp = d.name;
            int tp = 0;
            while (tp < List_len<TypeParam>(&d.type_params)) {
                if (tp == 0) { sp = sema_cat(sp, "<"); } else { sp = sema_cat(sp, ","); }
                sp = sema_cat(sp, List_get<TypeParam>(&d.type_params, tp).name);
                tp = tp + 1;
            }
            if (tp > 0) { sp = sema_cat(sp, ">"); }
            List<string> stack; List_init<string>(&stack, 8);
            sema_gen_cycle_walk(s, sp, &stack, d, &greported);
        }
        i = i + 1;
    }
}

int sema_is_struct(Sema* s, string name) {
    return sema_in_list(&s.structs, name);
}

int sema_has_member(Sema* s, string key) {   // key = "Struct.member"
    return sema_in_list(&s.members, key);
}

// Is `name` a variant of any enum (e.g. a generic `Some` constructed as `Some<int>(5)`)?
int sema_is_variant_name(Sema* s, string name) {
    int i = 0; int n = List_len<EVar>(&s.evars);
    while (i < n) { if (sema_streq(List_get<EVar>(&s.evars, i).variant, name) == 1) { return 1; } i = i + 1; }
    return 0;
}

// The variant `v` of enum `en` (plain = 0 and val = null when absent).
EVar sema_find_evar(Sema* s, string en, string v) {
    int i = 0; int n = List_len<EVar>(&s.evars);
    while (i < n) {
        EVar ev = List_get<EVar>(&s.evars, i);
        if (sema_streq(ev.en, en) == 1 && sema_streq(ev.variant, v) == 1) { return ev; }
        i = i + 1;
    }
    let none: EVar; none.en = en; none.variant = v; none.val = null; none.plain = 0;
    return none;
}

// A variant of `en` other than `self_v`, already in `seen`, whose value is `val` ("" if none).
string sema_evar_with_val(Sema* s, string en, string val, List<string>* seen, string self_v) {
    int i = 0; int n = List_len<EVar>(&s.evars);
    while (i < n) {
        EVar ev = List_get<EVar>(&s.evars, i);
        if (sema_streq(ev.en, en) == 1 && sema_streq(ev.variant, self_v) == 0 && sema_streq(ev.val, val) == 1
            && sema_in_list(seen, ev.variant) == 1) { return ev.variant; }
        i = i + 1;
    }
    return "";
}

int sema_is_enum(Sema* s, string name) {
    return sema_in_list(&s.enums, name);
}

// `+ - * / %`: the operators whose result type sema_infer_type derives from its operands.
int sema_is_arith_op(string op) {
    return sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1 || sema_streq(op, "*") == 1
        || sema_streq(op, "/") == 1 || sema_streq(op, "%") == 1;
}

// A value-producing binary operator (arithmetic, bitwise or shift): its result type
// follows its operands' types.
int sema_is_valop(string op) {
    return sema_is_arith_op(op) == 1 || sema_streq(op, "&") == 1 || sema_streq(op, "|") == 1
        || sema_streq(op, "^") == 1 || sema_streq(op, "<<") == 1 || sema_streq(op, ">>") == 1;
}

// The integer promotion of a canonical integer type (C: narrow types become `int`).
string sema_int_promote(string t) {
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) { return t; }
    if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) { return "uint"; }
    return "int";
}

// The user operator overload of `op` whose parameters take operand types `tys` (exactly,
// or through a numeric conversion, as the C++ resolveOperator's assignability does), or
// null. `op` is the overload spelling ("+", "u-", "[]").
*DeclNode sema_find_op(Sema* s, string op, List<string>* tys) {
    int n = List_len<string>(tys);
    int pass = 0;
    while (pass < 2) {
        int i = 0; int nd = List_len<*DeclNode>(&s.fndecls);
        while (i < nd) {
            *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
            if (d.operator_sym != null && sema_streq(d.operator_sym, op) == 1 && List_len<Param>(&d.params) == n) {
                int ok = 1; int k = 0;
                while (k < n && ok == 1) {
                    string pc = sema_canon(s, List_get<Param>(&d.params, k).ty);
                    string ac = sema_canon(s, List_get<string>(tys, k));
                    if (sema_streq(pc, ac) == 0) {
                        if (pass == 0) { ok = 0; }
                        else if (sema_is_numeric_ty(pc) == 0 || sema_is_numeric_ty(ac) == 0
                                 || (sema_is_int_ty(pc) == 1 && sema_is_float_ty(ac) == 1)) {
                            if (sema_c_ptr(pc) == 0 || (sema_c_ptr(ac) == 0 && sema_streq(ac, "null") == 0)) { ok = 0; }
                            // pointers convert only through `*void` (or from null), as in C++
                            else if (sema_streq(ac, "null") == 0 && sema_streq(pc, "*void") == 0 && sema_streq(ac, "*void") == 0
                                     && sema_streq(pc, "string") == 0 && sema_streq(ac, "string") == 0) { ok = 0; }
                        }
                    }
                    k = k + 1;
                }
                if (ok == 1) { return d; }
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return null;
}

// The user overload of binary `op` for operand types `lt`, `rt` (null if none).
*DeclNode sema_find_binop(Sema* s, string op, string lt, string rt) {
    List<string> tys; List_init<string>(&tys, 2);
    List_push<string>(&tys, lt); List_push<string>(&tys, rt);
    return sema_find_op(s, op, &tys);
}

// The inferred type of binary `op` over operand types `lt` and `rt` (as sema_infer_type
// gives them; "" = unknown): comparisons and `&&`/`||` are bool; numbers follow C's usual
// arithmetic conversions (a shift takes its promoted left operand's type); pointer
// arithmetic keeps the pointer (`ptr - ptr` counts elements, int64); a struct operand
// goes through its user operator overload.
string sema_binary_type(Sema* s, string op, string lt, string rt) {
    if (sema_is_cmp_op(op) == 1 || sema_streq(op, "&&") == 1 || sema_streq(op, "||") == 1) { return "bool"; }
    if (sema_is_valop(op) == 0) { return ""; }
    if (lt[0] == 0 || rt[0] == 0) { return ""; }
    // Stepping a `?*T` does not prove it non-null: `p + n` is still a `?*T`.
    if ((sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1) && (int)lt[0] == 63 && sema_is_int_ty(sema_canon(s, rt)) == 1) { return lt; }
    string l = sema_canon(s, lt);
    string r = sema_canon(s, rt);
    if (sema_is_numeric_ty(l) == 1 && sema_is_numeric_ty(r) == 1) {
        if (sema_is_float_ty(l) == 1 || sema_is_float_ty(r) == 1) {
            if (sema_streq(op, "+") == 0 && sema_streq(op, "-") == 0 && sema_streq(op, "*") == 0
                && sema_streq(op, "/") == 0 && sema_streq(op, "%") == 0) { return ""; }
            if (sema_streq(l, "double") == 1 || sema_streq(r, "double") == 1) { return "double"; }
            return "float";
        }
        if (sema_streq(op, "<<") == 1 || sema_streq(op, ">>") == 1) { return sema_int_promote(l); }
        return ast_range_var_type(sema_int_promote(l), sema_int_promote(r));
    }
    int lp = sema_c_ptr(l); int rp = sema_c_ptr(r);
    if (lp == 1 && sema_is_int_ty(r) == 1 && (sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1)) { return sema_strip_nullable(lt); }
    if (lp == 1 && rp == 1 && sema_streq(op, "-") == 1) { return "int64"; }
    *DeclNode od = sema_find_binop(s, op, lt, rt);
    if (od != null) { return od.ret_type; }
    return "";
}

// The pointee of pointer type `t` ("" when not a pointer): `*T` / `T*` give T, and a
// `const T*` gives `const T`.
string sema_pointee(string t0) {
    string t = sema_strip_nullable(t0);
    int cst = 0;
    if (sema_pointee_const(t) == 1) { cst = 1; t = sema_strip_const(t); }
    int n = sema_slen(t);
    string r = "";
    if (n > 0 && (int)t[n - 1] == 93) { return ""; }   // `*T[N]`: an array, not a pointer
    if (n >= 6 && sema_streq(sema_sub_str(t, n - 6, n), "*const") == 1) { r = sema_sub_str(t, 0, n - 6); }
    else if (n > 0 && (int)t[n - 1] == 42) { r = sema_sub_str(t, 0, n - 1); }
    else if (n > 0 && (int)t[0] == 42) { r = sema_sub_str(t, 1, n); }
    else { return ""; }
    if (cst == 1) { return sema_cat("const ", r); }
    return r;
}

// Element type of slice type `t` ("int[]" -> "int"), "" when not a slice.
string sema_slice_elem(string t0) {
    string t = sema_strip_const(sema_strip_nullable(t0));
    int n = sema_slen(t);
    if (n > 2 && (int)t[n - 2] == 91 && (int)t[n - 1] == 93) { return sema_sub_str(t, 0, n - 2); }
    return "";
}

// "fn(T1,T2)->R" of a lambda signature spelling "R(T1 a, T2 b)".
string sema_lambda_fn_type(string sig) {
    string ret = sema_lambda_ret(sig);
    if (ret[0] == 0) { return ""; }
    List<string> ps; List_init<string>(&ps, 4);
    sema_lambda_params(sig, &ps);
    string out = "fn(";
    int k = 0;
    while (k < List_len<string>(&ps)) {
        if (k > 0) { out = sema_cat(out, ","); }
        out = sema_cat(out, List_get<string>(&ps, k));
        k = k + 1;
    }
    return sema_cat(sema_cat(out, ")->"), ret);
}

// The value type `T` of a `*Future<T>` ("" if `t` is not one).
string sema_future_inner(Sema* s, string t) {
    string c = sema_canon(s, t);
    if ((int)c[0] != 42) { return ""; }
    string inr = sema_sub_str(c, 1, sema_slen(c));
    if (sema_streq(sema_base_name(inr), "Future") == 0) { return ""; }
    List<string> targs; List_init<string>(&targs, 1);
    sema_parse_targs(inr, &targs);
    if (List_len<string>(&targs) != 1) { return ""; }
    return List_get<string>(&targs, 0);
}

// The type an `async` function's call yields: `*Future<T>`.
// An `async void` function's future carries a 1-byte unit (uint8), as in the C++.
string sema_async_type(string ret) {
    string r = ret;
    if (sema_streq(sema_strip_const(ret), "void") == 1) { r = "uint8"; }
    return sema_cat(sema_cat("*Future<", r), ">");
}

// The return type of the method call `x.m(args)` `e` ("" when unknown).
string sema_method_ret(Sema* s, *ExprNode e) {
    *ExprNode mem = e.a;
    string bt = sema_infer_type(s, mem.a);
    if (bt[0] == 0 || sema_is_fn_type(bt) == 1) { return ""; }
    string sn = sema_struct_of_type(bt);
    *DeclNode ifc = sema_find_iface(s, sn);
    if (ifc != null) {
        int ii = 0;
        while (ii < List_len<*DeclNode>(&ifc.methods)) {
            *DeclNode c = List_get<*DeclNode>(&ifc.methods, ii);
            if (sema_streq(c.name, mem.sval) == 1) { return c.ret_type; }
            ii = ii + 1;
        }
        return "";
    }
    *DeclNode sd = sema_find_struct(s, sn);
    if (sd == null) { return ""; }
    List<string> rtargs; List_init<string>(&rtargs, 2);
    sema_parse_targs(sema_strip_ptr_sp(sema_strip_const(bt)), &rtargs);
    int j = 0;
    while (j < List_len<*DeclNode>(&sd.methods)) {
        *DeclNode cm = List_get<*DeclNode>(&sd.methods, j);
        if (sema_streq(cm.name, mem.sval) == 1) {
            if (List_len<TypeParam>(&sd.type_params) > 0 && List_len<string>(&rtargs) != List_len<TypeParam>(&sd.type_params)) { return ""; }
            if (cm.is_async == 1) { return ""; }
            return sema_subst_params(cm.ret_type, &sd.type_params, &rtargs);
        }
        j = j + 1;
    }
    int fi = 0;
    while (fi < List_len<Param>(&sd.params)) {
        Param fp = List_get<Param>(&sd.params, fi);
        if (sema_streq(fp.name, mem.sval) == 1) {
            string fty = sema_subst_params(fp.ty, &sd.type_params, &rtargs);
            if (sema_is_fn_type(fty) == 1) { return sema_fn_ret(fty); }
            return "";
        }
        fi = fi + 1;
    }
    *DeclNode ffn = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), mem.sval));
    if (ffn == null || ffn.is_async == 1 || List_len<Param>(&ffn.params) == 0) { return ""; }
    if (List_len<TypeParam>(&ffn.type_params) == 0) { return ffn.ret_type; }
    List<string> gtargs; List_init<string>(&gtargs, 2);
    if (sema_method_targs(s, ffn, bt, e, &gtargs) == 0) { return ""; }
    return sema_subst_params(ffn.ret_type, &ffn.type_params, &gtargs);
}

// The enum a variant constructor `name` builds, or null.
*DeclNode sema_variant_enum(Sema* s, string name) {
    int i = 0; int n = List_len<EVar>(&s.evars);
    while (i < n) {
        EVar ev = List_get<EVar>(&s.evars, i);
        if (sema_streq(ev.variant, name) == 1) { return sema_find_tdecl(s, ev.en); }
        i = i + 1;
    }
    return null;
}

string sema_infer_type(Sema* s, *ExprNode e);
int sema_variant_index(*DeclNode d, string v);

// The type of a generic variant constructor `Some(x)` without type arguments: each type
// parameter that is a payload field's whole type takes that argument's type (mirrors the
// C++ inference, which does not look at the target type). "" when one stays unbound.
string sema_variant_ctor_type(Sema* s, *DeclNode ed, *ExprNode e) {
    int vi = sema_variant_index(ed, e.a.sval);
    if (vi < 0 || vi >= List_len<List<string>>(&ed.payloads)) { return ""; }
    List<string> pl = List_get<List<string>>(&ed.payloads, vi);
    int tn = List_len<TypeParam>(&ed.type_params);
    List<string> bound; List_init<string>(&bound, 2);
    int t = 0; while (t < tn) { List_push<string>(&bound, ""); t = t + 1; }
    int i = 0;
    while (i < List_len<string>(&pl) && i < List_len<*ExprNode>(&e.kids)) {
        string pt = sema_nospace(List_get<string>(&pl, i));
        t = 0;
        while (t < tn) {
            if (sema_streq(pt, List_get<TypeParam>(&ed.type_params, t).name) == 1 && List_get<string>(&bound, t)[0] == 0) {
                string at = sema_infer_type(s, List_get<*ExprNode>(&e.kids, i));
                if (at[0] == 0) { return ""; }
                List_set<string>(&bound, t, at);
            }
            t = t + 1;
        }
        i = i + 1;
    }
    string r = sema_cat(ed.name, "<");
    t = 0;
    while (t < tn) {
        if (List_get<string>(&bound, t)[0] == 0) { return ""; }
        if (t > 0) { r = sema_cat(r, ","); }
        r = sema_cat(r, List_get<string>(&bound, t));
        t = t + 1;
    }
    return sema_cat(r, ">");
}

// Best-effort string type of an expression ("" = unknown), mirroring the C++
// getExpressionType for the forms whose type is certain here.
// A type spelled as a type alias (`PSq` for `type PSq = *Sq`), through every alias hop,
// const dropped; any other spelling unchanged (mirrors the C++ dealiasOperand). A classic
// enum keeps its name (a `match` recovers the variant set from it).
string sema_dealias(Sema* s, string t0) {
    if (s.has_alias == 0 || t0 == null || t0[0] == 0) { return t0; }
    string t = sema_strip_const(t0);
    int hops = 0;
    while (hops < 32) {
        int i = 0;
        while (t[i] != 0 && sema_is_idc((int)t[i]) == 1) { i = i + 1; }
        if (i == 0 || t[i] != 0 || sema_in_list(&s.tparams, t) == 1) { hops = 32; }
        else {
            *DeclNode ad = sema_find_tdecl(s, t);
            if (ad == null || ad.kind != DK_TYPEALIAS) { hops = 32; }
            else { t = sema_strip_const(ad.ret_type); }
        }
        hops = hops + 1;
    }
    if (sema_streq(t, sema_strip_const(t0)) == 1) { return t0; }
    return t;
}

string sema_infer_type_raw(Sema* s, *ExprNode e);

// The struct a `self` parameter points to, through aliases (`*VV self`, `type VV = V`).
string sema_self_struct(Sema* s, string t) {
    string d = sema_dealias(s, t);
    int n = sema_slen(d);
    int a = 0; while (a < n && ((int)d[a] == 42 || (int)d[a] == 32)) { a = a + 1; }
    int b = n; while (b > a && ((int)d[b - 1] == 42 || (int)d[b - 1] == 32)) { b = b - 1; }
    return sema_struct_of_type(sema_dealias(s, sema_sub_str(d, a, b)));
}
// The type of an expression, never spelled as an alias: every shape check (pointer,
// array, slice, fn value, interface, struct) sees the alias's target.
string sema_infer_type(Sema* s, *ExprNode e) {
    return sema_dealias(s, sema_infer_type_raw(s, e));
}

// The type of member `field` of a value of type `mbt` (`s.f` → the field's declared
// type, `sl.len` → int64), or "" when unknown.
string sema_member_type(Sema* s, string mbt, string field) {
    if (mbt[0] != 0 && sema_is_fn_type(mbt) == 0) {
        if (sema_slice_elem(mbt)[0] != 0 && sema_has_star(mbt) == 0 && sema_streq(field, "len") == 1) { return "int64"; }
        *DeclNode msd = sema_find_struct(s, sema_struct_of_type(mbt));
        List<string> mtargs; List_init<string>(&mtargs, 2);
        if (msd != null) { sema_parse_targs(sema_strip_ptr_sp(sema_strip_const(mbt)), &mtargs); }
        // A generic struct's field resolves only through an instance (`Box<int>`).
        if (msd != null && (List_len<TypeParam>(&msd.type_params) == 0
            || List_len<string>(&mtargs) == List_len<TypeParam>(&msd.type_params))) {
            int mi = 0; int mn = List_len<Param>(&msd.params);
            while (mi < mn) {
                Param mf = List_get<Param>(&msd.params, mi);
                if (sema_streq(mf.name, field) == 1) {
                    // A bitfield whose values all fit an int reads as `int` (C promotion).
                    if (mi < List_len<int>(&msd.field_bits) && List_get<int>(&msd.field_bits, mi) > 0
                        && sema_streq(ast_bf_read_type(sema_canon(s, sema_strip_const(mf.ty)), List_get<int>(&msd.field_bits, mi)), "int") == 1) {
                        return "int";
                    }
                    return sema_subst_params(mf.ty, &msd.type_params, &mtargs);
                }
                mi = mi + 1;
            }
        }
    }
    return "";
}

// The common type of a `?:`'s arms ("" when unknown), for sema_infer_type_raw.
string sema_ternary_type(Sema* s, *ExprNode e) {
    string tt = sema_infer_type(s, e.b);
    string et = sema_infer_type(s, List_get<*ExprNode>(&e.kids, 0));
    if (tt[0] == 0 || et[0] == 0) { return ""; }
    string tc = sema_canon(s, tt); string ec = sema_canon(s, et);
    if (sema_is_numeric_ty(tc) == 1 && sema_is_numeric_ty(ec) == 1 && sema_streq(tc, ec) == 0) {
        if (sema_is_float_ty(tc) == 1 || sema_is_float_ty(ec) == 1) {
            if (sema_streq(tc, "double") == 1 || sema_streq(ec, "double") == 1) { return "double"; }
            return "float";
        }
        return ast_range_var_type(sema_int_promote(tc), sema_int_promote(ec));
    }
    if (sema_streq(tc, "null") == 1) { return et; }
    if (sema_streq(ec, "null") == 1) { return tt; }
    if (sema_pointee_const(et) == 1 && sema_pointee_const(tt) == 0) { return et; }
    if (sema_streq(tc, ec) == 1 || sema_c_ptr(tc) == 1) { return tt; }
    return "";
}

string sema_infer_type_raw(Sema* s, *ExprNode e) {
    if (e == null) { return ""; }
    if (e.kind == EK_IDENT) {
        string vt = sema_lookup_type(s, e.sval);
        if (vt[0] == 63 && sema_is_narrowed(s, e.sval) == 1) { return sema_strip_nullable(vt); }   // proven non-null here
        if (vt[0] != 0) { return vt; }                      // a variable / param with a known type
        int si = sema_sym_index(s, e.sval);
        if (si >= 0 && List_get<Sym>(&s.syms, si).depth > 0) { return ""; }   // a local of unknown type
        *DeclNode ff = sema_find_fndecl(s, e.sval);         // else maybe a bare function used as a value
        if (ff != null && ff.is_async == 0) {               // build its "fn(params)->ret" spelling (parser form)
            string ft = "fn(";
            int i = 0; int np = List_len<Param>(&ff.params);
            while (i < np) {
                if (i > 0) { ft = sema_cat(ft, ","); }
                ft = sema_cat(ft, List_get<Param>(&ff.params, i).ty);
                i = i + 1;
            }
            return sema_cat(sema_cat(ft, ")->"), ff.ret_type);
        }
        if (ff == null && si >= 0) {                        // an enum member: a classic one is an int
            *DeclNode ed = sema_variant_enum(s, e.sval);
            if (ed != null && List_len<TypeParam>(&ed.type_params) == 0) {
                if (sema_is_plain_enum_decl(ed) == 1) { return "int"; }
                return ed.name;
            }
        }
        return "";
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) {                       // int, or int64 when it does not fit
            if (sema_int_lit_fits("int", e.sval) == 0) { return "int64"; }
            return "int";
        }
        if (e.lit_kind == LIT_FLOAT) { return "double"; }
        if (e.lit_kind == LIT_STRING) { return "string"; }
        if (e.lit_kind == LIT_CHAR) { return "char"; }
        if (e.lit_kind == LIT_BOOL) { return "bool"; }
        if (e.lit_kind == LIT_NULL) { return "null"; }
        return "";
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_IDENT) {   // direct call → callee's return type
        string cvt = sema_lookup_type(s, e.a.sval);
        if (sema_local_bound(s, e.a.sval) == 1 || (cvt[0] != 0 && sema_find_fndecl(s, e.a.sval) == null)) {
            if (sema_is_fn_type(cvt) == 1) { return sema_fn_ret(cvt); }
            return "";
        }
        *DeclNode fd = sema_find_fndecl(s, e.a.sval);
        if (fd != null) {
            if (List_len<TypeParam>(&fd.type_params) > 0) {
                List<string> btargs; List_init<string>(&btargs, 2);
                string unb = sema_uninferable_tparam(fd);
                if (unb[0] != 0 || sema_bind_targs(s, fd, e, &btargs) == 0) { return ""; }
                string gr = sema_subst_params(fd.ret_type, &fd.type_params, &btargs);
                if (fd.is_async == 1) { return sema_async_type(gr); }
                return gr;
            }
            if (fd.is_async == 1) { return sema_async_type(fd.ret_type); }
            return fd.ret_type;
        }
        *DeclNode ved = sema_variant_enum(s, e.a.sval);     // a payload variant constructor `A(1)`
        if (ved != null && List_len<TypeParam>(&ved.type_params) == 0) { return ved.name; }
        if (ved != null) { return sema_variant_ctor_type(s, ved, e); }
        return "";
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_MEMBER) { return sema_method_ret(s, e); }
    if (e.kind == EK_CALL && e.a != null) {                 // a call through a fn value: `mk()(1)`
        string ct = sema_infer_type(s, e.a);
        if (sema_is_fn_type(ct) == 1) { return sema_fn_ret(ct); }
        return "";
    }
    if (e.kind == EK_TEMPLATECALL) {
        string tb = sema_base_name(e.sval);
        List<string> targs; List_init<string>(&targs, 2);
        sema_parse_targs(e.sval, &targs);
        int ti = 0;
        while (ti < List_len<string>(&targs)) { List_set<string>(&targs, ti, sema_isub(s, List_get<string>(&targs, ti))); ti = ti + 1; }
        *DeclNode tfd = sema_find_fndecl(s, tb);
        if (tfd != null) {
            if (List_len<TypeParam>(&tfd.type_params) != List_len<string>(&targs)) { return ""; }
            string tr = sema_subst_params(tfd.ret_type, &tfd.type_params, &targs);
            if (tfd.is_async == 1) { return sema_async_type(tr); }
            return tr;
        }
        *DeclNode ted = sema_variant_enum(s, tb);           // `Some<int>(5)`
        if (ted != null && List_len<TypeParam>(&ted.type_params) == List_len<string>(&targs) && List_len<string>(&targs) > 0) {
            string out = sema_cat(ted.name, "<");
            int k = 0;
            while (k < List_len<string>(&targs)) {
                if (k > 0) { out = sema_cat(out, ","); }
                out = sema_cat(out, List_get<string>(&targs, k));
                k = k + 1;
            }
            return sema_cat(out, ">");
        }
        return "";
    }
    if (e.kind == EK_UNARY) {
        if (sema_streq(e.sval, "&") == 1) {                 // address-of → pointer, const-tracking
            string bt = sema_infer_type(s, e.a);
            if (bt[0] == 0) { return ""; }
            // A pointer to a closure is `*fn(...)->R`: a trailing `*` would read as part of R.
            if (sema_is_fn_type(sema_strip_const(bt)) == 1) { return sema_cat("*", sema_strip_const(bt)); }
            // A pointer to a nullable pointer is `*?*T`: a trailing `*` would make `?*T*`,
            // a nullable pointer to `*T`.
            if ((int)bt[0] == 63) { return sema_cat("*", bt); }
            if (sema_is_readonly_lvalue(s, e.a) == 1) { return sema_cat("const ", sema_cat(sema_strip_const(bt), "*")); }
            return sema_cat(bt, "*");
        }
        if (sema_streq(e.sval, "!") == 1) { return "bool"; }
        string ot = sema_infer_type(s, e.a);
        if (ot[0] == 0) { return ""; }
        if (sema_streq(e.sval, "*") == 1) {
            string pt = sema_pointee(ot);
            if (sema_streq(sema_canon(s, ot), "string") == 1) { return ""; }
            return pt;
        }
        string oc = sema_canon(s, ot);
        if (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "+") == 1 || sema_streq(e.sval, "~") == 1) {
            if (sema_is_int_ty(oc) == 1) { return sema_int_promote(oc); }
            if (sema_is_float_ty(oc) == 1 && sema_streq(e.sval, "~") == 0) { return oc; }
            string uop = e.sval; if (sema_streq(uop, "-") == 1) { uop = "u-"; }
            List<string> tys; List_init<string>(&tys, 1); List_push<string>(&tys, ot);
            *DeclNode od = sema_find_op(s, uop, &tys);
            if (od != null) { return od.ret_type; }
        }
        return "";
    }
    if (e.kind == EK_BINARY) {
        if (sema_is_valop(e.sval) == 0) { return sema_binary_type(s, e.sval, "", ""); }
        // Memoized per node like `?:`: each level of `a + (a + (...))` asks for the type of
        // its right operand, itself a binary expression (linear, not quadratic).
        if (e.sm_epoch == g_sema_epoch && g_sema_epoch != 0) { return e.sm_ety; }
        // An operator chain (`a + b + c ...`) is typed along its left spine with a loop:
        // the leftmost operand, then each operator bottom-up over the running type.
        List<*ExprNode> spine; List_init<*ExprNode>(&spine, 8);
        *ExprNode b = e;
        while (b != null && b.kind == EK_BINARY && sema_is_valop(b.sval) == 1) {
            List_push<*ExprNode>(&spine, b);
            b = b.a;
        }
        string t = sema_infer_type(s, b);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) {
            *ExprNode n = List_get<*ExprNode>(&spine, i);
            t = sema_binary_type(s, n.sval, t, sema_infer_type(s, n.b));
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        e.sm_ety = t; e.sm_epoch = g_sema_epoch;
        return t;
    }
    if (e.kind == EK_MEMBER) { return sema_member_type(s, sema_infer_type(s, e.a), e.sval); }
    if (e.kind == EK_INDEX) {
        string bt = sema_infer_type(s, e.a);
        if (bt[0] == 0) { return ""; }
        string bc = sema_canon(s, bt);
        if (List_len<*ExprNode>(&e.kids) > 0) {           // a[lo..hi] → a slice of the elements
            if (sema_arr_bracket(bc) > 0 && sema_slice_elem(bc)[0] == 0) { return sema_cat(sema_arr_elem(bc), "[]"); }
            if (sema_slice_elem(bc)[0] != 0) { return bc; }
            if (sema_streq(bc, "string") == 1) { return "char[]"; }   // a string slices to its chars
            return "";
        }
        if (sema_slice_elem(bc)[0] != 0 && sema_arr_bracket(bc) == sema_slen(bc) - 2) { return sema_slice_elem(bc); }
        // A pointer to an array or slice (`int[]*`, from `*IS`) indexes its pointee.
        if (sema_slen(bc) > 0 && (int)bc[sema_slen(bc) - 1] == 42) { return sema_sub_str(bc, 0, sema_slen(bc) - 1); }
        if (sema_arr_bracket(bc) > 0) { return sema_arr_elem(bc); }
        if (sema_streq(bc, "string") == 1) { return "char"; }
        if ((int)bc[0] == 42) { return sema_pointee(bt); }
        List<string> tys; List_init<string>(&tys, 2);
        List_push<string>(&tys, bt); List_push<string>(&tys, sema_infer_type(s, e.b));
        *DeclNode od = sema_find_op(s, "[]", &tys);
        if (od != null) { return od.ret_type; }
        return "";
    }
    if (e.kind == EK_CAST) { return sema_isub(s, e.sval); }
    if (e.kind == EK_SIZEOF) { return "int64"; }
    if (e.kind == EK_STRUCTINIT) {
        if (sema_known_type(s, e.sval) == 1) { return e.sval; }
        return "";
    }
    if (e.kind == EK_TERNARY) {
        // Memoized per node while no binding, scope or narrowing changes: each level of a
        // nested `?:` asks for its arm's type, which is itself a `?:` (linear, not quadratic).
        if (e.sm_epoch == g_sema_epoch && g_sema_epoch != 0) { return e.sm_ety; }
        string r = sema_ternary_type(s, e);
        e.sm_ety = r; e.sm_epoch = g_sema_epoch;
        return r;
    }
    if (e.kind == EK_AWAIT) { return sema_future_inner(s, sema_infer_type(s, e.a)); }
    if (e.kind == EK_LAMBDA) { return sema_isub(s, sema_lambda_fn_type(e.sval)); }
    if (e.kind == EK_INCDEC) {
        // `b.f++` of a bitfield: the old value in its declared type (as clang).
        if ((int)e.sval[1] != 114 && e.a != null && e.a.kind == EK_MEMBER) {
            *DeclNode isd = sema_find_struct(s, sema_struct_of_type(sema_infer_type(s, e.a.a)));
            if (isd != null) {
                int ii = 0;
                while (ii < List_len<Param>(&isd.params)) {
                    if (sema_streq(List_get<Param>(&isd.params, ii).name, e.a.sval) == 1 && ii < List_len<int>(&isd.field_bits)
                        && List_get<int>(&isd.field_bits, ii) > 0) { return List_get<Param>(&isd.params, ii).ty; }
                    ii = ii + 1;
                }
            }
        }
        return sema_infer_type(s, e.a);
    }
    if (e.kind == EK_ALLOCWITH) { return sema_cat("*", e.sval); }
    if (e.kind == EK_THREADCREATE) { return "*void"; }    // the thread handle
    return "";
}

// A type spelling with type aliases resolved and a classic enum collapsed to `int`.
string sema_resolve_scalar(Sema* s, string t0) {
    string t = sema_strip_const(t0);
    int hops = 0;
    while (hops < 16) {
        *DeclNode ad = sema_find_tdecl(s, t);
        if (ad != null && ad.kind == DK_TYPEALIAS) { t = sema_strip_const(ad.ret_type); }
        else { if (ad != null && ad.kind == DK_ENUM) { t = "int"; } hops = 16; }
        hops = hops + 1;
    }
    return t;
}

// The (resolved) type of a `for (i in A..B)` bound, "" when unknown. Beyond
// sema_infer_type it types a bare integer literal by its value, a cast by its target,
// and integer `+ - * / %` / unary `-` by the usual arithmetic conversions.
string sema_range_bound_type(Sema* s, *ExprNode e) {
    if (e == null) { return ""; }
    if (e.kind == EK_LITERAL && e.lit_kind == LIT_INT) { return ast_range_lit_type(e.sval); }
    if (e.kind == EK_CAST) { return sema_resolve_scalar(s, sema_isub(s, e.sval)); }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "-") == 1) {
        string ut = sema_range_bound_type(s, e.a);
        string pt = ast_range_var_type(ut, "int");
        if (pt[0] != 0) { return pt; }
        return ut;
    }
    if (e.kind == EK_BINARY && (e.op_fn == null || e.op_fn[0] == 0) && sema_is_arith_op(e.sval) == 1) {
        string ct = ast_range_var_type(sema_range_bound_type(s, e.a), sema_range_bound_type(s, e.b));
        if (ct[0] != 0) { return ct; }
    }
    string t = sema_infer_type(s, e);
    if (t[0] == 0) { return ""; }
    return sema_resolve_scalar(s, t);
}

// An interface value refers to a struct through a pointer; converting a struct VALUE to
// an interface-typed slot (param, variable, return) is an error, as in the C++ checker.
void sema_check_iface_value(Sema* s, string tety, *ExprNode e) {
    if (e == null || tety[0] == 0) { return; }
    int isif = 0; int i = 0;
    while (i < List_len<*DeclNode>(&s.ifaces)) { if (sema_streq(List_get<*DeclNode>(&s.ifaces, i).name, tety) == 1) { isif = 1; } i = i + 1; }
    if (isif == 0) { return; }
    string src = sema_infer_type(s, e);
    if (src[0] == 0) { return; }
    // An interface value refers to its target through a non-null pointer: a `?*T` needs a
    // null-check first (mirrors the C++ nullable assignability rule).
    if (src[0] == 63) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: assigning a nullable pointer '%s' to non-null '%s' requires a null-check (e.g. `if (x != null)`)\n",
               s.filename, s.line, s.col, src, tety);
        return;
    }
    string bare = sema_strip_const(src);
    string sn = sema_struct_of_type(bare);
    if (sema_has_star(bare) == 1 && sema_in_list(&s.structs, sn) == 1) {
        if (sema_ptr_depth(bare) != 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: cannot convert '%s' to interface '%s': only a pointer to a struct (a single '*') converts to an interface\n",
                   s.filename, s.line, s.col, src, tety);
            return;
        }
        // Boxing a pointer to const: every implementing method must take a const self.
        if (sema_pointee_const(src) == 1) {
            *DeclNode ifd = sema_find_iface(s, tety);
            *DeclNode sd = sema_find_struct(s, sn);
            int mi = 0;
            while (ifd != null && mi < List_len<*DeclNode>(&ifd.methods)) {
                string mname = List_get<*DeclNode>(&ifd.methods, mi).name;
                int mutable_self = 0;
                if (sd != null) {
                    int j = 0;
                    while (j < List_len<*DeclNode>(&sd.methods)) { if (sema_streq(List_get<*DeclNode>(&sd.methods, j).name, mname) == 1) { mutable_self = 1; } j = j + 1; }
                }
                *DeclNode ff = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), mname));
                if (mutable_self == 0 && ff != null && List_len<Param>(&ff.params) > 0
                    && sema_pointee_const(List_get<Param>(&ff.params, 0).ty) == 0) { mutable_self = 1; }
                if (mutable_self == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: conversion discards a const qualifier ('%s' to '%s'): method '%s' of '%s' takes a mutable self\n",
                           s.filename, s.line, s.col, src, tety, mname, sn);
                    return;
                }
                mi = mi + 1;
            }
        }
        return;
    }
    if (sema_in_list(&s.structs, src) == 0) { return; }
    s.had_error = 1;
    dprintf(2, "error: %s:%d:%d: cannot convert struct '%s' to interface '%s' by value; pass a pointer (&x)\n",
           s.filename, s.line, s.col, src, tety);
}

// ── canonical type spellings and assignability (mirrors isValidAssignment) ──

int sema_is_idc(int c) {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) { return 1; }
    return 0;
}

int sema_slen(string t) { int n = 0; while (t[n] != 0) { n = n + 1; } return n; }

// `t` without spaces, `const` words and a leading nullable `?` (the qualifiers do not
// change which conversions are allowed; const-dropping and nullability are checked apart).
string sema_bare(string t) {
    int n = sema_slen(t);
    String out; String_init(&out, n + 1);
    int i = 0;
    if (n > 0 && (int)t[0] == 63) { i = 1; }
    while (i < n) {
        int c = (int)t[i];
        if (c == 32) { i = i + 1; }
        else if (sema_is_idc(c) == 1) {
            int st = i;
            while (i < n && sema_is_idc((int)t[i]) == 1) { i = i + 1; }
            string w = sema_sub_str(t, st, i);
            if (sema_streq(w, "const") == 0) { String_append(&out, w); }
        } else { String_push(&out, (char)c); i = i + 1; }
    }
    return (string)String_cstr(&out);
}

// Return type of a fn-type spelling "fn(A,B)->R" ("" if not one).
string sema_fn_ret(string t) {
    if (sema_is_fn_type(t) == 0) { return ""; }
    int i = 3; int depth = 0; int n = sema_slen(t);
    while (i < n) {
        int c = (int)t[i];
        if (c == 91) { i = sema_dim_close(t, i); if (i >= n) { return ""; } }
        else if (c == 40 || c == 60) { depth = depth + 1; }
        else if (c == 62 && (int)t[i - 1] == 45) { }
        else if (c == 41 || c == 62 || c == 93) {
            if (depth == 0) {
                if (i + 3 <= n) { return sema_trim_sub(t, i + 3, n); }
                return "";
            }
            depth = depth - 1;
        }
        i = i + 1;
    }
    return "";
}

// Index of the first array bracket of `t` outside `<...>` / `(...)`, or -1.
int sema_arr_bracket(string t) {
    int i = 0; int depth = 0; int br = 0; int run = -1;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (br > 0) {
            if (c == 91) { br = br + 1; }
            else if (c == 93) { br = br - 1; }
        }
        else if (c == 60 || c == 40) { depth = depth + 1; }
        else if ((c == 62 && (i == 0 || (int)t[i - 1] != 45)) || c == 41) { depth = depth - 1; }
        else if (c == 91 && depth == 0) {
            if (!(run >= 0 && i > 0 && (int)t[i - 1] == 93)) { run = i; }
            br = 1;
        }
        i = i + 1;
    }
    return run;
}

// A classic enum (no type parameters, no payloads): its values are `int`s.
int sema_is_plain_enum_decl(*DeclNode d) {
    if (d == null || d.kind != DK_ENUM || List_len<TypeParam>(&d.type_params) > 0) { return 0; }
    int i = 0;
    while (i < List_len<List<string>>(&d.payloads)) {
        List<string> pl = List_get<List<string>>(&d.payloads, i);
        if (List_len<string>(&pl) > 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

string sema_canon_d(Sema* s, string t, int d);

// The canonical spelling of a type (mirrors normalizeType): qualifiers dropped, pointer
// stars in front, type aliases expanded, a classic enum as `int`, `int32` as `int`.
// Two types are the same exactly when their canonical spellings are equal.
string sema_canon(Sema* s, string t0) {
    if (t0 == null) { return ""; }
    return sema_canon_d(s, sema_bare(t0), 0);
}

string sema_canon_d(Sema* s, string t, int d) {
    if (t[0] == 0 || d > 24) { return t; }
    int n = sema_slen(t);
    if (sema_is_fn_type(t) == 1) {
        List<string> ps; List_init<string>(&ps, 4);
        sema_fn_params(t, &ps);
        string out = "fn(";
        int i = 0;
        while (i < List_len<string>(&ps)) {
            if (i > 0) { out = sema_cat(out, ","); }
            out = sema_cat(out, sema_canon_d(s, List_get<string>(&ps, i), d + 1));
            i = i + 1;
        }
        return sema_cat(sema_cat(out, ")->"), sema_canon_d(s, sema_fn_ret(t), d + 1));
    }
    int br = sema_arr_bracket(t);
    if (br > 0) {
        // An array of an array alias (`type Arr = int[3]; Arr[2]`) is 2 arrays of 3: the
        // outer dimension goes in front of the element's (C order, leftmost is outermost).
        string ce = sema_canon_d(s, sema_sub_str(t, 0, br), d + 1);
        int cen = sema_slen(ce);
        int eb = sema_arr_bracket(ce);
        if (eb > 0 && cen > 0 && (int)ce[cen - 1] == 93) {
            return sema_cat(sema_cat(sema_sub_str(ce, 0, eb), sema_sub_str(t, br, n)), sema_sub_str(ce, eb, cen));
        }
        return sema_cat(ce, sema_sub_str(t, br, n));
    }
    int a = 0; while ((int)t[a] == 42) { a = a + 1; }
    int b = n; while (b > a && (int)t[b - 1] == 42) { b = b - 1; }
    int stars = a + (n - b);
    string inner = sema_sub_str(t, a, b);
    string ci = inner;
    if (stars > 0) { ci = sema_canon_d(s, inner, d + 1); }
    else if (sema_has_lt(inner) == 1) {
        List<string> targs; List_init<string>(&targs, 2);
        sema_parse_targs(inner, &targs);
        ci = sema_cat(sema_base_name(inner), "<");
        int i = 0;
        while (i < List_len<string>(&targs)) {
            if (i > 0) { ci = sema_cat(ci, ","); }
            ci = sema_cat(ci, sema_canon_d(s, List_get<string>(&targs, i), d + 1));
            i = i + 1;
        }
        ci = sema_cat(ci, ">");
    } else {
        if (sema_streq(inner, "int32") == 1) { return "int"; }
        if (sema_streq(inner, "uint32") == 1) { return "uint"; }
        *DeclNode td = sema_find_tdecl(s, inner);
        if (td != null && td.kind == DK_TYPEALIAS && sema_in_list(&s.tparams, inner) == 0) {
            return sema_canon_d(s, sema_bare(td.ret_type), d + 1);
        }
        if (sema_is_plain_enum_decl(td) == 1) { return "int"; }
    }
    int k = 0;
    // A pointer to an alias of an array (`*AI`, `type AI = int[3]`) is `int[3]*`: a leading
    // star would bind looser than the array suffix (an array of pointers).
    int cn = sema_slen(ci);
    if (cn > 0 && (int)ci[cn - 1] == 93) {
        while (k < stars) { ci = sema_cat(ci, "*"); k = k + 1; }
        return ci;
    }
    while (k < stars) { ci = sema_cat("*", ci); k = k + 1; }
    return ci;
}

int sema_c_ptr(string c) {
    int n = 0; while (c[n] != 0) { n = n + 1; }
    if (n > 0 && (int)c[n - 1] == 93) { return 0; }    // `*T[N]` is an array of pointers
    if (c[0] == 42 || sema_streq(c, "string") == 1) { return 1; }
    return 0;
}

// Is canonical type `c` fully understood here (every name a declared, fully applied
// type), so a conversion to or from it can be judged? A pointer always is (every
// pointer converts to every other); a type parameter or an unknown name is not.
int sema_judgeable(Sema* s, string c) {
    if (c == null || c[0] == 0 || sema_streq(c, "unknown") == 1) { return 0; }
    if ((int)c[0] == 42) { return 1; }
    if (sema_is_fn_type(c) == 1) {
        List<string> ps; List_init<string>(&ps, 4);
        sema_fn_params(c, &ps);
        int i = 0;
        while (i < List_len<string>(&ps)) { if (sema_judgeable(s, List_get<string>(&ps, i)) == 0) { return 0; } i = i + 1; }
        return sema_judgeable(s, sema_fn_ret(c));
    }
    int br = sema_arr_bracket(c);
    if (br > 0) {
        int n = sema_slen(c);
        string dims = sema_sub_str(c, br, n);
        int i = 0;
        while (dims[i] != 0) {
            int ch = (int)dims[i];
            if (ch != 91 && ch != 93 && (ch < 48 || ch > 57)) { return 0; }   // a named dimension: not compared
            i = i + 1;
        }
        return sema_judgeable(s, sema_sub_str(c, 0, br));
    }
    if (sema_is_numeric_ty(c) == 1 || sema_streq(c, "string") == 1 || sema_streq(c, "void") == 1
        || sema_streq(c, "null") == 1) { return 1; }
    string base = sema_base_name(c);
    if (sema_in_list(&s.tparams, base) == 1) { return 0; }
    *DeclNode d = sema_find_tdecl(s, base);
    if (d == null || d.kind == DK_TYPEALIAS) { return 0; }
    List<string> targs; List_init<string>(&targs, 2);
    sema_parse_targs(c, &targs);
    if (List_len<TypeParam>(&d.type_params) != List_len<string>(&targs)) { return 0; }
    int i = 0;
    while (i < List_len<string>(&targs)) { if (sema_judgeable(s, List_get<string>(&targs, i)) == 0) { return 0; } i = i + 1; }
    return 1;
}

// Why a value of type `src0` cannot be stored in a `t0` slot ("" when it can, or when
// either type is not understood well enough to judge). Mirrors isValidAssignment and the
// messages of assignabilityError past its literal/const/nullable special cases.
// Two pointer types convert implicitly only when they point at the same type (C): a
// `*void` on either side converts to and from any pointer, and the byte pointers
// (`string`, `*char`, `*int8`, `*uint8`) interconvert. A pointee the checker cannot
// judge (a type parameter, an unknown name) is not judged. Mirrors the C++
// pointeesCompatible.
// `int32` is another spelling of `int`, and `uint32` of `uint`.
string sema_int32_as_int(string t) {
    if (sema_streq(t, "int32") == 1) { return "int"; }
    if (sema_streq(t, "uint32") == 1) { return "uint"; }
    return t;
}
int sema_is_byte_ptr(string t) {
    return sema_streq(t, "string") == 1 || sema_streq(t, "*char") == 1 || sema_streq(t, "*int8") == 1
        || sema_streq(t, "*uint8") == 1;
}
// The array type `t` points at when it is spelled `X[..]*` (a pointer to an array), else "".
string sema_arr_ptr_pointee(string t) {
    int n = sema_slen(t);
    if (n < 2 || (int)t[n - 1] != 42 || (int)t[0] == 42) { return ""; }
    int b = n; while (b > 0 && (int)t[b - 1] == 42) { b = b - 1; }
    if (b == 0 || (int)t[b - 1] != 93) { return ""; }
    if (n - b != 1) { return ""; }
    return sema_sub_str(t, 0, b);
}

int sema_ptr_compat(Sema* s, string a0, string b0) {
    string a = sema_strip_const(sema_strip_nullable(sema_canon(s, a0)));
    string b = sema_strip_const(sema_strip_nullable(sema_canon(s, b0)));
    if (sema_streq(a, b) == 1) { return 1; }
    // An array suffix binds tighter than a leading star: `*T[N]` is an array, no pointer.
    if (sema_slen(a) > 0 && (int)a[sema_slen(a) - 1] == 93) { return 0; }
    if (sema_slen(b) > 0 && (int)b[sema_slen(b) - 1] == 93) { return 0; }
    if (sema_streq(a, "*void") == 1 || sema_streq(b, "*void") == 1) { return 1; }
    if (sema_is_byte_ptr(a) == 1 && sema_is_byte_ptr(b) == 1) { return 1; }
    if (sema_streq(a, "string") == 1 || sema_streq(b, "string") == 1) { return 0; }
    // A pointer to an array (`int[4]*`, the type of `&arr`) points at the array type.
    string aa = sema_arr_ptr_pointee(a);
    string ab = sema_arr_ptr_pointee(b);
    if (aa[0] != 0 || ab[0] != 0) {
        if (aa[0] == 0 && (int)a[0] == 42) { aa = sema_sub_str(a, 1, sema_slen(a)); }
        if (ab[0] == 0 && (int)b[0] == 42) { ab = sema_sub_str(b, 1, sema_slen(b)); }
        if (aa[0] == 0 || ab[0] == 0) { return 1; }
        if (sema_streq(sema_canon(s, aa), sema_canon(s, ab)) == 1) { return 1; }
        if (sema_judgeable(s, sema_canon(s, aa)) == 1 && sema_judgeable(s, sema_canon(s, ab)) == 1) { return 0; }
        return 1;
    }
    if ((int)a[0] != 42 || (int)b[0] != 42) { return 1; }            // not a leading-star spelling: not judged
    string pa = sema_strip_const(sema_strip_nullable(sema_sub_str(a, 1, sema_slen(a))));
    string pb = sema_strip_const(sema_strip_nullable(sema_sub_str(b, 1, sema_slen(b))));
    if ((int)pa[0] == 42 && (int)pb[0] == 42) { return sema_ptr_compat(s, pa, pb); }
    if (sema_streq(pa, pb) == 1) { return 1; }
    if (sema_judgeable(s, pa) == 0 || sema_judgeable(s, pb) == 0) { return 1; }
    if (sema_streq(sema_int32_as_int(pa), sema_int32_as_int(pb)) == 1) { return 1; }
    return 0;
}

string sema_assign_strict(Sema* s, string t0, string src0) {
    string ct = sema_canon(s, t0);
    string cs = sema_canon(s, src0);
    if (sema_judgeable(s, ct) == 0 || sema_judgeable(s, cs) == 0) { return ""; }
    if (sema_streq(ct, cs) == 1) { return ""; }
    string conv = sema_cat(sema_cat(sema_cat(sema_cat("cannot convert '", src0), "' to '"), t0), "'");
    if (sema_is_numeric_ty(ct) == 1 && sema_is_numeric_ty(cs) == 1) {
        if (sema_is_int_ty(ct) == 1 && sema_is_float_ty(cs) == 1) {
            return sema_cat(sema_cat(sema_cat(sema_cat("cannot assign a floating-point value ('", src0), "') to integer type '"), t0),
                            "' without an explicit cast (it drops the fraction)");
        }
        return "";
    }
    int tp = sema_c_ptr(ct);
    int sp = sema_c_ptr(cs);
    *DeclNode ifc = sema_find_iface(s, ct);
    if (sema_streq(cs, "null") == 1 && tp == 1) { return ""; }
    if (sema_streq(cs, "null") == 1 && ifc != null) { return ""; }   // the empty interface value
    if (sema_is_fn_type(ct) == 1 || sema_is_fn_type(cs) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("incompatible function type '", src0), "' for '"), t0), "'");
    }
    if (tp == 1 && sp == 1) {
        if (sema_ptr_compat(s, ct, cs) == 1) { return ""; }
        return conv;
    }
    if (ifc != null) {
        if (sp == 0 && sema_is_struct(s, sema_base_name(cs)) == 1) {
            return sema_cat(sema_cat(sema_cat(sema_cat("cannot convert struct '", src0), "' to interface '"), t0), "' by value; pass a pointer (&x)");
        }
        string nom = cs; while ((int)nom[0] == 42) { nom = sema_sub_str(nom, 1, sema_slen(nom)); }
        string why = sema_iface_mismatch(s, sema_base_name(nom), ifc);
        if (why[0] == 0 && sp == 1) { return ""; }
        if (why[0] != 0) {
            return sema_cat(sema_cat(sema_cat(sema_cat(sema_cat("'", src0), "' does not satisfy interface '"), t0), "': "), why);
        }
    }
    return conv;
}

// Conservative assignability of expression `e` to declared type `t` (mirrors the error
// cases of the C++ assignabilityError). Returns "" when OK or when either side is not
// understood well enough to judge (so a valid program is never falsely rejected).
string sema_assign_err(Sema* s, string ta0, *ExprNode e) {
    if (e == null || ta0 == null || ta0[0] == 0) { return ""; }
    string t0 = sema_nullable_alias(s, ta0);
    string t = sema_strip_const(t0);
    string tc = sema_canon(s, t0);
    if (sema_find_iface(s, t) != null) {   // nullable / pointer-depth / const boxing rules
        int had0 = s.had_error; s.had_error = 0;
        sema_check_iface_value(s, t, e);
        int hit = s.had_error; s.had_error = had0 | hit;
        if (hit == 1) { return ""; }
    }
    if (sema_is_int_ty(tc) == 1 && e.kind == EK_LITERAL && e.lit_kind == LIT_INT
        && sema_int_lit_fits(tc, e.sval) == 0) {
        return sema_cat(sema_cat(sema_cat(sema_cat("integer literal ", e.sval), " is out of range for '"), t), "'");
    }
    if (sema_is_int_ty(tc) == 1 && e.kind == EK_TERNARY) {   // each literal arm of a `?:` must fit
        string ta = sema_assign_err(s, t0, e.b);
        if (ta[0] != 0 && e.b != null && e.b.kind == EK_LITERAL) { return ta; }
        *ExprNode ee = List_get<*ExprNode>(&e.kids, 0);
        string tb = sema_assign_err(s, t0, ee);
        if (tb[0] != 0 && ee != null && ee.kind == EK_LITERAL) { return tb; }
    }
    string src0 = sema_infer_type(s, e);
    // A nullable `?*T` into a non-null pointer drops the check (`*T`/`null` -> `?*T` is fine).
    if (src0[0] == 63 && t0[0] != 63 && sema_c_ptr(sema_canon(s, t0)) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("assigning a nullable pointer '", src0), "' to non-null '"), t0),
                        "' requires a null-check (e.g. `if (x != null)`)");
    }
    // A pointer to a nullable pointer (`*?*T`) keeps the check on what it points to.
    if ((int)src0[0] == 42 && (int)t0[0] == 42 && (int)src0[1] == 63 && (int)t0[1] != 63 && t0[1] != 0
        && sema_c_ptr(sema_canon(s, sema_sub_str(t0, 1, sema_slen(t0)))) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("conversion drops the nullable pointee of '", src0), "' ('"), t0),
                        "' points to a non-null pointer)");
    }
    if (sema_pointee_const(src0) == 1 && sema_has_star(t0) == 1 && sema_pointee_const(t0) == 0
        && sema_is_fn_type(t0) == 0) {
        return sema_cat(sema_cat(sema_cat(sema_cat("conversion discards a const qualifier ('", src0), "' to '"), t0), "')");
    }
    string src = sema_strip_const(src0);
    if (src[0] == 0 || sema_streq(src, "unknown") == 1 || sema_streq(src, t) == 1) { return ""; }
    string conv = sema_cat(sema_cat(sema_cat(sema_cat("cannot convert '", src), "' to '"), t), "'");
    if (sema_streq(src, "void") == 1) { return sema_cat(sema_cat("cannot convert 'void' to '", t0), "'"); }
    if (sema_is_int_ty(t) == 1 && sema_is_float_ty(src) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("cannot assign a floating-point value ('", src), "') to integer type '"), t0),
                        "' without an explicit cast (it drops the fraction)");
    }
    // A pointer to an array (`&arr` is `int[4]*`) is not a number, nor a pointer to
    // anything but that array type (or `*void`).
    string sap = sema_arr_ptr_pointee(sema_canon(s, src));
    if (sap[0] != 0) {
        if (sema_is_numeric_ty(tc) == 1) { return conv; }
        if ((int)tc[0] == 42 && sema_ptr_compat(s, tc, sema_canon(s, src)) == 0) { return conv; }
    }
    int tnum = sema_is_numeric_ty(t);
    int snum = sema_is_numeric_ty(src);
    int tptr = 0; if (t[0] != 63 && sema_is_fn_type(t) == 0 && sema_is_ptrish(t) == 1 && sema_is_arr_ty(t) == 0) { tptr = 1; }
    int sptr = 0; if (sema_is_fn_type(src) == 0 && sema_is_ptrish(src) == 1 && sema_streq(src, "null") == 0 && sema_is_arr_ty(src) == 0) { sptr = 1; }
    if (tnum == 1 && sptr == 1) { return conv; }
    if (tptr == 1 && snum == 1) { return conv; }
    // A struct value where a pointer is expected, or a pointer where a struct value is.
    if (tptr == 1 && sema_is_struct(s, src) == 1) { return conv; }
    if (sptr == 1 && sema_is_struct(s, t) == 1) { return conv; }
    if ((tnum == 1 && sema_is_struct_value(s, src) == 1) || (snum == 1 && sema_is_struct_value(s, t) == 1)) { return conv; }
    if (sema_is_fn_type(t) == 1 && sema_is_fn_type(src) == 1 && sema_streq(sema_canon(s, t), sema_canon(s, src)) == 0) {
        return sema_cat(sema_cat(sema_cat(sema_cat("incompatible function type '", src), "' for '"), t), "'");
    }
    // A function value (a variadic one too, whose `...` is not otherwise judged) into a
    // value that is neither a closure nor a pointer.
    if (sema_is_fn_type(src) == 1 && sema_is_fn_type(tc) == 0 && sema_c_ptr(tc) == 0 && sema_judgeable(s, tc) == 1) {
        return sema_cat(sema_cat(sema_cat(sema_cat("incompatible function type '", src), "' for '"), t), "'");
    }
    return sema_assign_strict(s, t0, src0);
}

// Two type spellings that are both primitive and differ (a certain mismatch). Anything
// else (structs, pointers, aliases) is not compared, to stay conservative.
int sema_prim_differs(string a0, string b0) {
    string a = sema_strip_const(a0); string b = sema_strip_const(b0);
    int ap = sema_is_numeric_ty(a); if (sema_streq(a, "void") == 1 || sema_streq(a, "string") == 1) { ap = 1; }
    int bp = sema_is_numeric_ty(b); if (sema_streq(b, "void") == 1 || sema_streq(b, "string") == 1) { bp = 1; }
    if (ap == 1 && bp == 1 && sema_streq(a, b) == 0) { return 1; }
    return 0;
}

// Is type spelling `t` the interface's own name (its Self type)?
int sema_is_self_ty(string t, *DeclNode iface) {
    return sema_streq(sema_struct_of_type(t), iface.name);
}

// Do two spellings name different types (compared only when both are understood)?
int sema_types_differ(Sema* s, string a, string b) {
    string ca = sema_canon(s, a); string cb = sema_canon(s, b);
    if (sema_judgeable(s, ca) == 0 || sema_judgeable(s, cb) == 0) { return 0; }
    if (sema_streq(ca, cb) == 1) { return 0; }
    return 1;
}

// An implementation's type `a` against the interface's `b`: the C++ compares the
// normalized spellings, so a concrete `a` must match a `b` the checker cannot judge (an
// undeclared `Self`) literally. An unresolved `a` (a generic's `T`) is not judged.
int sema_iface_types_differ(Sema* s, string a, string b) {
    string ca = sema_canon(s, a); string cb = sema_canon(s, b);
    if (sema_judgeable(s, ca) == 0 || sema_judgeable(s, cb) == 1) { return sema_types_differ(s, a, b); }
    if (sema_streq(ca, cb) == 1) { return 0; }
    return 1;
}

// Does type `sn` implement every method of `iface` with a matching signature (arity,
// return and parameter types; a type naming the interface itself is its Self type)?
// A struct implements a method inline or as a free `Type_method`; a scalar primitive
// through a free function named like the method whose first parameter is it. "" when
// satisfied, else the reason. Mirrors the C++ interfaceMismatch.
string sema_iface_mismatch(Sema* s, string sn, *DeclNode iface) {
    *DeclNode sd = sema_find_struct(s, sn);
    int i = 0; int n = List_len<*DeclNode>(&iface.methods);
    while (i < n) {
        *DeclNode m = List_get<*DeclNode>(&iface.methods, i);
        *DeclNode impl = null; int skip = 0;
        if (sd != null) {
            int j = 0; int mn = List_len<*DeclNode>(&sd.methods);
            while (j < mn) { *DeclNode c = List_get<*DeclNode>(&sd.methods, j); if (sema_streq(c.name, m.name) == 1) { impl = c; } j = j + 1; }
        }
        if (impl == null) { impl = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), m.name)); skip = 1; }
        if (impl == null && sema_is_scalar_prim(sn) == 1) {
            *DeclNode ff = sema_find_fndecl(s, m.name);
            if (ff != null && List_len<Param>(&ff.params) > 0
                && sema_streq(sema_struct_of_type(List_get<Param>(&ff.params, 0).ty), sn) == 1) { impl = ff; }
        }
        if (impl == null) { return sema_cat(sema_cat("missing method '", m.name), "'"); }
        int want = List_len<Param>(&m.params);
        int got = List_len<Param>(&impl.params) - skip;
        if (got != want) {
            uint8[96] buf;
            sprintf((string)&buf[0], "' takes %d parameter(s), the interface requires %d", got, want);
            return sema_cat(sema_cat("method '", m.name), (string)&buf[0]);
        }
        if (sema_is_self_ty(m.ret_type, iface) == 0 && sema_iface_types_differ(s, impl.ret_type, m.ret_type) == 1) {
            return sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat("method '", m.name), "' returns '"), impl.ret_type),
                            "', the interface requires '"), m.ret_type), "'");
        }
        int k = 0;
        while (k < want) {
            string wt = List_get<Param>(&m.params, k).ty;
            string gt = List_get<Param>(&impl.params, k + skip).ty;
            int selfp = sema_is_self_ty(wt, iface);
            // A Self parameter is the implementing type (or the interface itself).
            int self_bad = 0;
            if (selfp == 1) {
                string gb = sema_struct_of_type(gt);
                string gc = sema_struct_of_type(sema_canon(s, gt));
                string sb = sema_base_name(sn);
                if (sema_streq(gb, iface.name) == 0 && sema_streq(gb, sb) == 0 && sema_streq(gc, sb) == 0
                    && sema_streq(sema_base_name(gb), sb) == 0) { self_bad = 1; }
            }
            if (self_bad == 1 || (selfp == 0 && sema_iface_types_differ(s, gt, wt) == 1)) {
                uint8[32] nb;
                sprintf((string)&nb[0], "%d", k + 1);
                return sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat(sema_cat("method '", m.name), "' parameter "),
                                (string)&nb[0]), " is '"), gt), "', the interface requires '"), wt), "'");
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return "";
}

// Parameter types of a fn-type spelling "fn(A,B)->R" into `out` (nesting-aware).
void sema_fn_params(string t, List<string>* out) {
    if (sema_is_fn_type(t) == 0) { return; }
    int i = 3; int depth = 0; int start = 3;
    while (t[i] != 0) {
        int c = (int)t[i];
        if (c == 91) { i = sema_dim_close(t, i); if (t[i] == 0) { return; } }   // an array dimension
        else if (c == 40 || c == 60) { depth = depth + 1; }                  // ( <
        else if (c == 62 && (int)t[i - 1] == 45) { }                         // "->" arrow
        else if (c == 41 || c == 62 || c == 93) {                            // ) > ]
            if (depth == 0) {
                if (i > start) { List_push<string>(out, sema_trim_sub(t, start, i)); }
                return;
            }
            depth = depth - 1;
        } else if (c == 44 && depth == 0) {
            List_push<string>(out, sema_trim_sub(t, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
}

// The arguments of `e` from index `from` on pass through `...`: each must have a value
// (a `void` call has none).
void sema_check_variadic_extras(Sema* s, *ExprNode e, int from) {
    int i = from;
    while (i < List_len<*ExprNode>(&e.kids)) {
        if (sema_streq(sema_canon(s, sema_infer_type(s, List_get<*ExprNode>(&e.kids, i))), "void") == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: argument %d has type 'void' (a void call has no value)\n", s.filename, s.line, s.col, i + 1);
        }
        i = i + 1;
    }
}

// Check a call's arguments (`e.kids`) against parameter types `pts` (a trailing "..."
// means variadic): count, then conservative per-argument assignability.
void sema_check_call_args(Sema* s, *ExprNode e, string what, List<string>* pts) {
    int np = List_len<string>(pts);
    int variadic = 0;
    if (np > 0 && sema_streq(List_get<string>(pts, np - 1), "...") == 1) { variadic = 1; np = np - 1; }
    int argc = List_len<*ExprNode>(&e.kids);
    if ((variadic == 1 && argc < np) || (variadic == 0 && argc != np)) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: %s expects %d argument(s), got %d\n", s.filename, s.line, s.col, what, np, argc);
        return;
    }
    int i = 0;
    while (i < np) {
        string perr = sema_assign_err(s, List_get<string>(pts, i), List_get<*ExprNode>(&e.kids, i));
        if (perr[0] != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: argument %d type mismatch: expected %s, got %s (%s)\n", s.filename, s.line, s.col, i + 1,
                   List_get<string>(pts, i), sema_infer_type(s, List_get<*ExprNode>(&e.kids, i)), perr);
        }
        i = i + 1;
    }
    if (variadic == 1) { sema_check_variadic_extras(s, e, np); }
}

// Index of the '(' opening a lambda signature's parameter list "R(T1 a, T2 b)" (the
// last top-level group, so a fn-typed return `fn(int)->int(int x)` is skipped), or -1.
int sema_lambda_open(string sig) {
    int n = sema_slen(sig);
    if (n == 0 || (int)sig[n - 1] != 41) { return -1; }
    int depth = 0; int i = n - 1;
    while (i >= 0) {
        int c = (int)sig[i];
        if (c == 41) { depth = depth + 1; }
        else if (c == 40) { depth = depth - 1; if (depth == 0) { return i; } }
        i = i - 1;
    }
    return -1;
}

// Return type of a lambda signature spelling "R(T1 a, T2 b)".
string sema_lambda_ret(string sig) {
    int i = sema_lambda_open(sig);
    if (i <= 0) { return ""; }
    return sema_trim_sub(sig, 0, i);
}

// Parameter types (into `types`) and names (into `names`) of a lambda signature spelling.
void sema_lambda_sig(string sig, List<string>* types, List<string>* names) {
    int i = sema_lambda_open(sig);
    if (i < 0) { return; }
    int close = sema_slen(sig) - 1;
    int depth = 0; int start = i + 1; int j = i + 1;
    while (j <= close) {
        int c = (int)sig[j];
        if (c == 91) { j = sema_dim_close(sig, j); if (j > close) { j = close; } c = (int)sig[j]; }
        else if (c == 40 || c == 60) { depth = depth + 1; }
        else if ((c == 41 && j < close) || (c == 62 && (int)sig[j - 1] != 45)) { depth = depth - 1; }
        if ((c == 44 && depth == 0) || j == close) {
            string one = sema_trim_sub(sig, start, j);
            int sp = 0; int k = 0; while (one[k] != 0) { if ((int)one[k] == 32) { sp = k; } k = k + 1; }
            if (one[0] != 0) {
                if (sp > 0) {
                    List_push<string>(types, sema_trim_sub(one, 0, sp));
                    List_push<string>(names, sema_trim_sub(one, sp + 1, sema_slen(one)));
                } else { List_push<string>(types, one); List_push<string>(names, ""); }
            }
            start = j + 1;
        }
        j = j + 1;
    }
}

// Parameter types of a lambda's signature spelling "R(T1 a, T2 b)" into `out`.
void sema_lambda_params(string sig, List<string>* out) {
    List<string> names; List_init<string>(&names, 4);
    sema_lambda_sig(sig, out, &names);
}

// A generic function call's argument count must match the declaration. Returns 1 if OK.
int sema_check_generic_arity(Sema* s, *DeclNode fd, *ExprNode e) {
    int np = List_len<Param>(&fd.params);
    int variadic = 0;
    if (np > 0 && sema_streq(List_get<Param>(&fd.params, np - 1).ty, "...") == 1) { variadic = 1; np = np - 1; }
    int argc = List_len<*ExprNode>(&e.kids);
    if ((variadic == 1 && argc < np) || (variadic == 0 && argc != np)) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: function '%s' expects %d argument(s), got %d\n", s.filename, s.line, s.col, fd.name, np, argc);
        return 0;
    }
    return 1;
}

// Does identifier `name` occur as a whole word in type spelling `t`?
int sema_type_mentions(string t, string name) {
    int i = 0;
    while (t[i] != 0) {
        int c = (int)t[i];
        int isid = 0; if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) { isid = 1; }
        if (isid == 1) {
            int st = i;
            while (t[i] != 0) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) { i = i + 1; } else { break; }
            }
            if (sema_streq(sema_sub_str(t, st, i), name) == 1) { return 1; }
        } else { i = i + 1; }
    }
    return 0;
}

// The type parameters of `fd` that no parameter type mentions (so a call without
// explicit type arguments cannot infer them), comma-joined; "" if all are inferable.
string sema_uninferable_tparam(*DeclNode fd) {
    string out = "";
    int t = 0; int tn = List_len<TypeParam>(&fd.type_params);
    while (t < tn) {
        string tp = List_get<TypeParam>(&fd.type_params, t).name;
        int seen = 0;
        int i = 0; int np = List_len<Param>(&fd.params);
        while (i < np) { if (sema_type_mentions(List_get<Param>(&fd.params, i).ty, tp) == 1) { seen = 1; } i = i + 1; }
        if (seen == 0) {
            if (out[0] != 0) { out = sema_cat(out, ", "); }
            out = sema_cat(out, tp);
        }
        t = t + 1;
    }
    return out;
}

// Index of `name` among `fd`'s type parameters, or -1.
int sema_tparam_index(*DeclNode fd, string name) {
    int i = 0; int n = List_len<TypeParam>(&fd.type_params);
    while (i < n) { if (sema_streq(List_get<TypeParam>(&fd.type_params, i).name, name) == 1) { return i; } i = i + 1; }
    return -1;
}

// 1 when parameter `i` of `fd` is spelled as the bare type parameter `tp` (`T a`): a
// by-value deduction. The other parameters bind structurally first and take precedence.
int sema_bare_tparam(*DeclNode fd, int i, string tp) {
    return sema_streq(ast_unify_canon(List_get<Param>(&fd.params, i).ty), tp);
}

// The binding of `tp` from the by-value arguments of an inferred generic call: they must
// agree, and integer ones that differ meet at their common type by C's usual arithmetic
// conversions (`maxof(1, big)` is `maxof<int64>`). Any other disagreement is reported
// when `report` is 1 (mirrors the C++). "" when no by-value argument binds it.
string sema_byvalue_bind(Sema* s, *DeclNode fd, *ExprNode e, string tp, int report) {
    string b = ""; int from = 0;
    int i = 0; int n = List_len<*ExprNode>(&e.kids); int np = List_len<Param>(&fd.params);
    while (i < n && i < np) {
        if (sema_bare_tparam(fd, i, tp) == 1) {
            string at = sema_value_type(sema_infer_type(s, List_get<*ExprNode>(&e.kids, i)));
            if (at[0] != 0 && sema_streq(at, "null") == 0 && sema_streq(at, "unknown") == 0) {
                at = ast_unify_tparam(List_get<Param>(&fd.params, i).ty, at, tp);
                if (at[0] != 0) {
                    if (b[0] == 0) { b = at; from = i; }
                    else if (sema_streq(sema_canon(s, b), sema_canon(s, at)) == 0) {
                        string common = ast_range_var_type(sema_canon(s, b), sema_canon(s, at));
                        if (common[0] != 0) { b = common; }
                        else if (report == 1) {
                            s.had_error = 1;
                            dprintf(2, "error: %s:%d:%d: argument %d type mismatch: type parameter '%s' is deduced as '%s' from argument %d and as '%s' here\n",
                                   s.filename, s.line, s.col, i + 1, tp, b, from + 1, at);
                            return "";
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return b;
}

// The structural binding of `tp` (from a parameter other than a bare `T a`), or "".
string sema_struct_bind(Sema* s, *DeclNode fd, *ExprNode e, string tp) {
    int i = 0; int n = List_len<*ExprNode>(&e.kids); int np = List_len<Param>(&fd.params);
    while (i < n && i < np) {
        if (sema_bare_tparam(fd, i, tp) == 0) {
            string at = sema_value_type(sema_infer_type(s, List_get<*ExprNode>(&e.kids, i)));
            if (at[0] != 0 && sema_streq(at, "null") == 0 && sema_streq(at, "unknown") == 0) {
                string b = ast_unify_tparam(List_get<Param>(&fd.params, i).ty, at, tp);
                if (b[0] != 0) { return b; }
            }
        }
        i = i + 1;
    }
    return "";
}

// Inferred generic call: the by-value deductions of each type parameter not bound
// structurally must agree (sema_byvalue_bind). 1 when they do.
int sema_check_generic_binding(Sema* s, *DeclNode fd, *ExprNode e) {
    int ok = 1;
    int t = 0; int tn = List_len<TypeParam>(&fd.type_params);
    while (t < tn) {
        string tp = List_get<TypeParam>(&fd.type_params, t).name;
        if (sema_struct_bind(s, fd, e, tp)[0] == 0) {
            int before = s.had_error; s.had_error = 0;
            sema_byvalue_bind(s, fd, e, tp, 1);
            if (s.had_error == 1) { ok = 0; }
            if (before == 1) { s.had_error = 1; }
        }
        t = t + 1;
    }
    return ok;
}

// `t` with the pointer stars and spaces stripped from both ends ("*Box<int>" -> "Box<int>").
string sema_strip_ptr_sp(string t) {
    int a = 0; while ((int)t[a] == 42 || (int)t[a] == 32) { a = a + 1; }
    int b = 0; while (t[b] != 0) { b = b + 1; }
    while (b > a && ((int)t[b - 1] == 42 || (int)t[b - 1] == 32)) { b = b - 1; }
    return sema_sub_str(t, a, b);
}

// Token-wise substitution: each identifier in `t` found in `names` becomes the matching
// entry of `args` (unchanged past the end of `args`). "*T" -> "*int". An array or slice
// argument keeps its grouping (codegen cg_subst_ids): a star before it goes after it
// (`*T`, T = int[], is `int[]*`, a pointer to the slice) and dimensions after it go in
// front of its own (`T[2]`, T = int[3], is `int[2][3]`).
string sema_subst_names(string t, List<string>* names, List<string>* args) {
    if (List_len<string>(args) == 0) { return t; }
    int n = 0; while (t[n] != 0) { n = n + 1; }
    String out; String_init(&out, n + 8);
    int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
            int st = i;
            while (i < n) {
                int d = (int)t[i];
                if ((d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) || d == 95) { i = i + 1; }
                else { break; }
            }
            string id = sema_sub_str(t, st, i);
            string rep = id;
            int k = 0;
            while (k < List_len<string>(names) && k < List_len<string>(args)) {
                if (sema_streq(List_get<string>(names, k), id) == 1) { rep = List_get<string>(args, k); }
                k = k + 1;
            }
            int rn = sema_slen(rep);
            int rt = rn; while (rt > 0 && (int)rep[rt - 1] == 42) { rt = rt - 1; }
            if (rep != id && rn > 0 && (int)rep[rn - 1] == 93 && i < n && (int)t[i] == 91 && st > 0 && (int)t[st - 1] == 42) {
                // `*T[2]`, T = int[3]: 2 pointers to int[3], `int[3]*[2]`
                int stars = 0;
                while (st - stars > 0 && (int)t[st - stars - 1] == 42) { stars = stars + 1; }
                out.len = out.len - (int64)stars;
                out.data[out.len] = (char)0;
                String_append(&out, rep);
                while (stars > 0) { String_push(&out, '*'); stars = stars - 1; }
            } else if (rep != id && rt < rn && rt > 0 && (int)rep[rt - 1] == 93) {
                int stars = 0;
                while (st - stars > 0 && (int)t[st - stars - 1] == 42) { stars = stars + 1; }
                out.len = out.len - (int64)stars;
                out.data[out.len] = (char)0;
                String_append(&out, rep);
                while (stars > 0) { String_push(&out, '*'); stars = stars - 1; }
            } else if (rep != id && rn > 0 && (int)rep[rn - 1] == 93) {
                if (i < n && (int)t[i] == 91) {
                    int ds = i;
                    while (i < n && (int)t[i] == 91) {
                        while (i < n && (int)t[i] != 93) { i = i + 1; }
                        if (i < n) { i = i + 1; }
                    }
                    int rb = sema_arr_bracket(rep);
                    if (rb > 0) { rep = sema_cat(sema_cat(sema_sub_str(rep, 0, rb), sema_sub_str(t, ds, i)), sema_sub_str(rep, rb, rn)); }
                    else { rep = sema_cat(rep, sema_sub_str(t, ds, i)); }
                    String_append(&out, rep);
                } else {
                    int stars = 0;
                    while (st - stars > 0 && (int)t[st - stars - 1] == 42) { stars = stars + 1; }
                    out.len = out.len - (int64)stars;
                    out.data[out.len] = (char)0;
                    String_append(&out, rep);
                    while (stars > 0) { String_push(&out, '*'); stars = stars - 1; }
                }
            } else { String_append(&out, rep); }
        } else {
            String_push(&out, (char)c);
            i = i + 1;
        }
    }
    return (string)String_cstr(&out);
}

// sema_subst_names over the names of the type parameters `tps`.
string sema_subst_params(string t, List<TypeParam>* tps, List<string>* args) {
    if (List_len<string>(args) == 0 || List_len<TypeParam>(tps) == 0) { return t; }
    List<string> names; List_init<string>(&names, 4);
    int i = 0; while (i < List_len<TypeParam>(tps)) { List_push<string>(&names, List_get<TypeParam>(tps, i).name); i = i + 1; }
    return sema_subst_names(t, &names, args);
}

// A type spelling inside the generic instance being checked, with its type parameters
// replaced by the instance's arguments (unchanged outside an instance).
string sema_isub(Sema* s, string t) {
    if (s.in_inst == 0 || t == null) { return t; }
    return sema_subst_names(t, &s.isub_p, &s.isub_a);
}

// Queue an instance of `qfn` (keyed and displayed as `name<args>suffix`) for checking,
// unless it is already queued. `owner` is the generic struct of an inline method.
void sema_queue_inst(Sema* s, *DeclNode qfn, *DeclNode owner, List<string>* targs, string name, string suffix) {
    if (qfn == null || qfn.body == null) { return; }
    let si: SInst;
    List_init<string>(&si.targs, 4);
    string disp = sema_cat(name, "<");
    int i = 0;
    while (i < List_len<string>(targs)) {
        string a = sema_isub(s, List_get<string>(targs, i));
        List_push<string>(&si.targs, a);
        if (i > 0) { disp = sema_cat(disp, ","); }
        disp = sema_cat(disp, a);
        i = i + 1;
    }
    disp = sema_cat(sema_cat(disp, ">"), suffix);
    if (sema_in_list(&s.inst_seen, disp) == 1) { return; }
    List_push<string>(&s.inst_seen, disp);
    si.func = qfn; si.owner = owner; si.display = disp; si.depth = s.inst_depth + 1;
    List_push<SInst>(&s.insts, si);
}

// Any user operator overload for `op` ("+", "u-", ...)? Built-in operand rules then defer
// to the overload resolution codegen performs (with its numeric coercions).
int sema_any_op(Sema* s, string op) {
    int i = 0; int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.operator_sym != null && sema_streq(d.operator_sym, op) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// 1 when every argument of the call `e` has a known type (so a failed inference is a
// real error, not a gap in this checker's expression typing).
int sema_args_typed(Sema* s, *ExprNode e) {
    int i = 0;
    while (i < List_len<*ExprNode>(&e.kids)) {
        string at = sema_infer_type(s, List_get<*ExprNode>(&e.kids, i));
        if (at[0] == 0 || sema_streq(at, "unknown") == 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

// The type an argument binds a type parameter to: a value's own `const` is dropped (`const
// int` binds `int`), a pointer's pointee const is kept (`const int*` binds itself).
string sema_value_type(string t) {
    if (sema_pointee_const(t) == 1) { return t; }
    return sema_strip_const(t);
}

// The type arguments of an inferred generic call `f(x, y)`: a parameter spelled exactly
// as a type parameter (`T a`) binds it to the argument's type, and any other parameter
// type unifies structurally (`Pair<A, B> p`). 1 when every type parameter is bound; an
// unbound one is left as "" in `out`.
int sema_bind_targs(Sema* s, *DeclNode fd, *ExprNode e, List<string>* out) {
    int ok = 1;
    int t = 0; int tn = List_len<TypeParam>(&fd.type_params);
    while (t < tn) {
        string tp = List_get<TypeParam>(&fd.type_params, t).name;
        string b = sema_struct_bind(s, fd, e, tp);
        if (b[0] == 0) { b = sema_byvalue_bind(s, fd, e, tp, 0); }
        if (b[0] == 0) { ok = 0; }
        List_push<string>(out, b);
        t = t + 1;
    }
    return ok;
}

// The type arguments of `x.m(...)` resolved to the generic free function `fd`
// (`S_m<T..>(S<T..>* self, ...)`), with receiver type `bt` (`S<A..>` or a pointer to
// it): a type parameter named by the self parameter's type arguments takes the
// receiver's argument at that position; any other one binds from an argument spelled
// exactly as it. 1 when every type parameter is bound.
int sema_method_targs(Sema* s, *DeclNode fd, string bt, *ExprNode e, List<string>* out) {
    List<string> sargs; List_init<string>(&sargs, 2);
    sema_parse_targs(sema_strip_ptr_sp(List_get<Param>(&fd.params, 0).ty), &sargs);
    List<string> rargs; List_init<string>(&rargs, 2);
    sema_parse_targs(sema_strip_ptr_sp(bt), &rargs);
    int t = 0; int tn = List_len<TypeParam>(&fd.type_params);
    while (t < tn) {
        string tp = List_get<TypeParam>(&fd.type_params, t).name;
        string b = "";
        int k = 0;
        while (k < List_len<string>(&sargs) && k < List_len<string>(&rargs) && b[0] == 0) {
            if (sema_streq(List_get<string>(&sargs, k), tp) == 1) { b = List_get<string>(&rargs, k); }
            k = k + 1;
        }
        int i = 1; int np = List_len<Param>(&fd.params); int n = List_len<*ExprNode>(&e.kids);
        while (b[0] == 0 && i < np && i - 1 < n) {
            if (sema_streq(List_get<Param>(&fd.params, i).ty, tp) == 1) {
                string at = sema_strip_const(sema_infer_type(s, List_get<*ExprNode>(&e.kids, i - 1)));
                if (at[0] != 0 && sema_streq(at, "null") == 0 && sema_streq(at, "unknown") == 0) { b = at; }
            }
            i = i + 1;
        }
        if (b[0] == 0) { return 0; }
        List_push<string>(out, b);
        t = t + 1;
    }
    return 1;
}

// A call through a fn-typed value of type `ft`.
void sema_check_fn_value_call(Sema* s, *ExprNode e, string what, string ft) {
    List<string> pts; List_init<string>(&pts, 4);
    sema_fn_params(ft, &pts);
    sema_check_call_args(s, e, what, &pts);
}

// Report `field 'f': <err>` / `<ctx>: <err>` when non-empty.
void sema_report_assign(Sema* s, string ctx, string err) {
    if (err[0] == 0) { return; }
    s.had_error = 1;
    dprintf(2, "error: %s:%d:%d: %s: %s\n", s.filename, s.line, s.col, ctx, err);
}

// The declaration of struct `name` (or null).
*DeclNode sema_find_struct(Sema* s, string name) {
    int i = 0; int n = List_len<*DeclNode>(&s.sdecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.sdecls, i);
        if (sema_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

// Field type `ft` of a generic struct `d` with the literal's type args substituted when the
// field is spelled exactly as a type parameter ("T" → "int"); otherwise unchanged.
string sema_subst_tparam(*DeclNode d, List<string>* targs, string ft) {
    int i = 0; int n = List_len<TypeParam>(&d.type_params);
    while (i < n) {
        if (sema_streq(List_get<TypeParam>(&d.type_params, i).name, ft) == 1) {
            if (i < List_len<string>(targs)) { return List_get<string>(targs, i); }
            return "";
        }
        i = i + 1;
    }
    return ft;
}

// Is `ft` mentioning a type parameter of `d` (so its concrete type is unknown here)?
int sema_mentions_tparam(*DeclNode d, string ft) {
    int i = 0; int n = List_len<TypeParam>(&d.type_params);
    while (i < n) {
        string tp = List_get<TypeParam>(&d.type_params, i).name;
        if (sema_streq(sema_struct_of_type(ft), tp) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Struct literal `S{...}`: too many positional values, a repeated or unknown named field,
// and field value types (mirrors the C++ visit(StructInitExpr)).
void sema_check_struct_init(Sema* s, *ExprNode e) {
    *DeclNode d = sema_find_struct(s, sema_base_name(e.sval));
    if (d == null) { return; }
    List<string> targs; List_init<string>(&targs, 2);
    sema_parse_targs(e.sval, &targs);
    int nf = List_len<Param>(&d.params);
    int n = List_len<*ExprNode>(&e.kids);
    List<string> seen; List_init<string>(&seen, 4);
    // A literal is either positional or named (mirrors the C++ StructInitExpr check).
    int named0 = 0; int mixed = 0; int mi = 0;
    while (mi < n) {
        int isnamed = 0;
        if (mi < List_len<string>(&e.names)) { if (List_get<string>(&e.names, mi)[0] != 0) { isnamed = 1; } }
        if (mi == 0) { named0 = isnamed; } else if (isnamed != named0) { mixed = 1; }
        mi = mi + 1;
    }
    if (mixed == 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: cannot mix positional and named field initializers in a '%s' literal\n", s.filename, s.line, s.col, e.sval);
    }
    // A union's members overlap: its literal initializes exactly one of them (C).
    if (d.kind == DK_UNION && n > 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: a union literal initializes one member ('%s' literal has %d)\n", s.filename, s.line, s.col, e.sval, n);
    }
    int i = 0;
    int sil = s.line; int sic = s.col;
    while (i < n) {
        *ExprNode v = List_get<*ExprNode>(&e.kids, i);
        // Each field's diagnostics point at its value (as the C++ checker).
        s.line = sil; s.col = sic;
        if (v != null && v.line > 0) { s.line = v.line; s.col = v.col; }
        string nm = "";
        if (i < List_len<string>(&e.names)) { nm = List_get<string>(&e.names, i); }
        string ft = "";
        string shown = nm;
        if (nm[0] != 0) {
            int fi = 0;
            while (fi < nf) {
                Param p = List_get<Param>(&d.params, fi);
                if (sema_streq(p.name, nm) == 1) { ft = p.ty; }
                fi = fi + 1;
            }
            if (ft[0] == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: struct '%s' has no field '%s'\n", s.filename, s.line, s.col, e.sval, nm);
            } else if (sema_in_list(&seen, nm) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: field '%s' is initialized more than once in '%s' literal\n", s.filename, s.line, s.col, nm, e.sval);
            } else { List_push<string>(&seen, nm); }
        } else if (i < nf) {
            Param p = List_get<Param>(&d.params, i);
            ft = p.ty; shown = p.name;
        } else if (i == nf) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: too many initializers for struct '%s' (it has %d field(s), got %d)\n", s.filename, s.line, s.col, e.sval, nf, n);
        }
        if (ft[0] != 0) {
            string cft = sema_subst_tparam(d, &targs, ft);
            // A field type built from a type parameter (`*X`, `X[2]`) takes the literal's
            // type arguments too.
            if (List_len<TypeParam>(&d.type_params) > 0 && List_len<string>(&targs) == List_len<TypeParam>(&d.type_params)) {
                cft = sema_subst_params(ft, &d.type_params, &targs);
            }
            if (cft[0] != 0 && sema_mentions_tparam(d, cft) == 0) {
                sema_report_assign(s, sema_cat(sema_cat("field '", shown), "'"), sema_assign_err(s, cft, v));
            }
        }
        i = i + 1;
    }
    s.line = sil; s.col = sic;
}

// Recursively check an array literal against a (possibly multi-dimensional) array type:
// too many elements for a numeric dimension is an error; a short list zero-fills (C-style).
// Is `e` a compile-time constant initializer codegen can fold? Mirrors the C++ isConstInit:
// a literal / sizeof, a numeric unary/cast of one, or an array/struct literal of constants.
// A bare identifier is excluded (it could be a runtime local codegen would silently zero).
// Is `e` a compile-time constant initializer (C semantics) the constant folder emits?
// A literal, `sizeof`, an enum member, a global `const`, the address of a global, a
// non-capturing lambda, and unary/binary/ternary/cast combinations of those, or an
// array/struct literal of constants. A call or a non-const variable read is not
// constant. Used for global and `static` initializers (mirrors TypeChecker::isConstInit).
int sema_is_enum_member(Sema* s, string name) {
    int i = 0; int n = List_len<EVar>(&s.evars);
    while (i < n) { if (sema_streq(List_get<EVar>(&s.evars, i).variant, name) == 1) { return 1; } i = i + 1; }
    return 0;
}
int sema_is_const_init(Sema* s, *ExprNode e) {
    if (e == null) { return 1; }
    if (e.kind == EK_LITERAL) { return 1; }
    if (e.kind == EK_SIZEOF) { return 1; }
    if (e.kind == EK_LAMBDA) { return 1; }
    if (e.kind == EK_IDENT) {
        int i = sema_sym_index(s, e.sval);
        if (i >= 0) {
            Sym sy = List_get<Sym>(&s.syms, i);
            if (sy.depth == 0 && sy.is_const == 1) { return 1; }
            if (sy.depth > 0) { return sema_is_enum_member(s, e.sval); }
        }
        if (sema_find_fn(s, e.sval) >= 0) { return 1; }   // a function name: a constant closure
        return sema_is_enum_member(s, e.sval);
    }
    if (e.kind == EK_UNARY) {
        if (sema_streq(e.sval, "&") == 1) {
            if (e.a == null || e.a.kind != EK_IDENT) { return 0; }
            if (sema_find_fn(s, e.a.sval) >= 0) { return 0; }
            if (sema_sym_depth(s, e.a.sval) == 0) { return 1; }
            return 0;
        }
        if (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "~") == 1 || sema_streq(e.sval, "!") == 1
            || sema_streq(e.sval, "+") == 1) {
            return sema_is_const_init(s, e.a);
        }
        return 0;
    }
    if (e.kind == EK_BINARY) {
        string op = e.sval;
        if (sema_streq(op, "=") == 1) { return 0; }
        int n0 = 0; while (op[n0] != 0) { n0 = n0 + 1; }
        if (n0 >= 2 && (int)op[n0 - 1] == 61 && sema_streq(op, "==") == 0 && sema_streq(op, "!=") == 0
            && sema_streq(op, "<=") == 0 && sema_streq(op, ">=") == 0) { return 0; }   // compound assign
        if (sema_is_const_init(s, e.a) == 0) { return 0; }
        return sema_is_const_init(s, e.b);
    }
    if (e.kind == EK_TERNARY) {
        if (sema_is_const_init(s, e.a) == 0 || sema_is_const_init(s, e.b) == 0) { return 0; }
        return sema_is_const_init(s, List_get<*ExprNode>(&e.kids, 0));
    }
    if (e.kind == EK_CAST) { return sema_is_const_init(s, e.a); }
    if (e.kind == EK_ARRAYLIT || e.kind == EK_STRUCTINIT) {
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { if (sema_is_const_init(s, List_get<*ExprNode>(&e.kids, i)) == 0) { return 0; } i = i + 1; }
        return 1;
    }
    return 0;
}

void sema_check_arr_init(Sema* s, string arrT0, *ExprNode a) {
    string arrT = arrT0;
    if (sema_is_arr_ty(arrT) == 0) {
        // Through a type alias (`type A3 = int[3]`) the target is the array; anything else
        // is not an array: `int x = {1, 2};` (mirrors the C++ VarDecl check).
        string ac = sema_canon(s, arrT);
        if (sema_is_arr_ty(ac) == 0) {
            if (sema_judgeable(s, ac) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: an array literal '{...}' can only initialize an array type, not '%s'\n",
                        s.filename, s.line, s.col, arrT0);
            }
            return;
        }
        arrT = ac;
    }
    string dim = sema_arr_count(arrT);
    if (sema_all_digits(dim) == 1) {
        int cnt = List_len<*ExprNode>(&a.kids);
        if (cnt > sema_atoi(dim)) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: array literal has %d elements but '%s' holds %s\n", s.filename, s.line, s.col, cnt, arrT, dim);
        }
    }
    string elemT = sema_arr_elem(arrT);
    int i = 0; int n = List_len<*ExprNode>(&a.kids);
    while (i < n) {
        *ExprNode el = List_get<*ExprNode>(&a.kids, i);
        if (el.kind == EK_ARRAYLIT) {                   // nested rows: each element is itself an array literal
            sema_check_arr_init(s, elemT, el);
        } else if (sema_is_arr_ty(elemT) == 0) {                                        // each element converts to the element type
            string aerr = sema_assign_err(s, elemT, el);
            if (aerr[0] != 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: array element: %s\n", s.filename, s.line, s.col, aerr);
            }
        }
        i = i + 1;
    }
}

int sema_has_star(string t) {
    int i = 0;
    while (t[i] != 0) { if ((int)t[i] == 42) { return 1; } i = i + 1; }   // 42 = '*'
    return 0;
}

// Pointer-to-const: spelling starts with "const " and is a pointer (e.g. "const int*").
int sema_pointee_const(string t) {
    if (t[0] != 99 || t[1] != 111 || t[2] != 110 || t[3] != 115
        || t[4] != 116 || t[5] != 32) { return 0; }     // not "const "
    return sema_has_star(t);
}

// An integer-literal spelling that denotes zero (only sign chars and '0' digits).
int sema_lit_is_zero(string v) {
    int i = 0;
    if (v[0] == 0) { return 0; }
    while (v[i] != 0) {
        int c = (int)v[i];
        if (c != 48 && c != 43 && c != 45) { return 0; }   // not '0' / '+' / '-'
        i = i + 1;
    }
    return 1;
}

int sema_is_assign(string op) {
    if (sema_streq(op, "=") == 1) { return 1; }
    if (sema_streq(op, "+=") == 1 || sema_streq(op, "-=") == 1 || sema_streq(op, "*=") == 1
        || sema_streq(op, "/=") == 1 || sema_streq(op, "%=") == 1) { return 1; }
    return 0;
}

// Is the assignment target a read-only location? A const binding, a field/element reached
// through one (a const struct's members are read-only), or storage reached through a
// pointer to const (`r.x`, `r[i]`, `*r` with `r: const T*`).
int sema_is_readonly_lvalue(Sema* s, *ExprNode e) {
    if (e == null) { return 0; }
    if (e.kind == EK_IDENT) { return sema_sym_const(s, e.sval); }
    if (e.kind == EK_MEMBER || e.kind == EK_INDEX) {
        string bt = sema_strip_nullable(sema_infer_type(s, e.a));
        string bc = sema_canon(s, bt);
        if ((int)bc[0] == 42) { return sema_pointee_const(bt); }
        return sema_is_readonly_lvalue(s, e.a);
    }
    // `*p` writes through a pointer — read-only when p points to const.
    if (e.kind == EK_UNARY && sema_streq(e.sval, "*") == 1) {
        return sema_pointee_const(sema_infer_type(s, e.a));
    }
    return 0;
}

// Owned substring s[a, b) with leading/trailing spaces trimmed.
string sema_trim_sub(string s, int a, int b) {
    while (a < b && (int)s[a] == 32) { a = a + 1; }
    while (b > a && (int)s[b - 1] == 32) { b = b - 1; }
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int i = 0; while (i < len) { buf[i] = (uint8)s[a + i]; i = i + 1; }
    buf[len] = 0;
    return (string)buf;
}

*DeclNode sema_find_fndecl(Sema* s, string name) {
    int i = 0; int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (sema_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

// Is `name` a C function: declared `extern` and not also defined by the program?
int sema_is_c_extern(Sema* s, string name) {
    int ext = 0; int i = 0; int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (sema_streq(d.name, name) == 1) {
            if (d.kind == DK_EXTERN) { ext = 1; }
            if (d.kind == DK_FUNCTION && d.body != null) { return 0; }
        }
        i = i + 1;
    }
    return ext;
}

// Is `t` a fn type, through type aliases?
int sema_is_fn_type_alias(Sema* s, string t) {
    string ft = sema_strip_const(t);
    int hops = 0;
    while (hops < 16) {
        if (sema_is_fn_type(ft) == 1) { return 1; }
        *DeclNode ad = sema_find_tdecl(s, ft);
        if (ad == null || ad.kind != DK_TYPEALIAS) { return 0; }
        ft = sema_strip_const(ad.ret_type);
        hops = hops + 1;
    }
    return 0;
}

*DeclNode sema_find_iface(Sema* s, string name) {
    int i = 0; int n = List_len<*DeclNode>(&s.ifaces);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.ifaces, i);
        if (sema_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

int sema_is_scalar_prim(string c) {
    if (sema_streq(c, "int") == 1 || sema_streq(c, "int8") == 1 || sema_streq(c, "int16") == 1
        || sema_streq(c, "int32") == 1 || sema_streq(c, "int64") == 1 || sema_streq(c, "uint") == 1
        || sema_streq(c, "uint8") == 1 || sema_streq(c, "uint16") == 1 || sema_streq(c, "uint32") == 1
        || sema_streq(c, "uint64") == 1 || sema_streq(c, "char") == 1 || sema_streq(c, "bool") == 1
        || sema_streq(c, "float") == 1 || sema_streq(c, "double") == 1) { return 1; }
    return 0;
}

// Bounded generics: each constrained type parameter's argument (`targs`, parallel to
// `tps`) must satisfy its interface constraints, structurally (mirrors the C++
// checkConstraints). Returns 1 when all hold.
int sema_check_constraints(Sema* s, List<TypeParam>* tps, List<string>* targs) {
    int ok = 1;
    int t = 0;
    while (t < List_len<TypeParam>(tps) && t < List_len<string>(targs)) {
        TypeParam tp = List_get<TypeParam>(tps, t);
        string concrete = sema_isub(s, List_get<string>(targs, t));
        string bare = sema_canon(s, concrete);
        while ((int)bare[0] == 42) { bare = sema_sub_str(bare, 1, sema_slen(bare)); }
        bare = sema_base_name(bare);
        int ci = 0;
        if (sema_in_list(&s.tparams, bare) == 1) { ci = List_len<string>(&tp.constraints); }   // still abstract
        while (ci < List_len<string>(&tp.constraints)) {
            string ic = List_get<string>(&tp.constraints, ci);
            *DeclNode iface = sema_find_iface(s, ic);
            if (iface == null) {
                s.had_error = 1; ok = 0;
                dprintf(2, "error: %s:%d:%d: unknown constraint interface '%s'\n", s.filename, s.line, s.col, ic);
            } else {
                string why = sema_iface_mismatch(s, bare, iface);
                if (why[0] != 0) {
                    s.had_error = 1; ok = 0;
                    dprintf(2, "error: %s:%d:%d: type '%s' does not satisfy constraint '%s' (required by a bounded type parameter): %s\n",
                           s.filename, s.line, s.col, concrete, ic, why);
                }
            }
            ci = ci + 1;
        }
        t = t + 1;
    }
    return ok;
}

// Extract the type arguments of a template-call spelling ("pick<int>" → ["int"],
// "Map<string, int>" → ["string","int"]), tracking nesting and trimming spaces.
void sema_parse_targs(string sval, List<string>* out) {
    int i = 0;
    while (sval[i] != 0 && (int)sval[i] != 60) {                  // find '<'
        if ((int)sval[i] == 91) { i = sema_dim_close(sval, i); if (sval[i] == 0) { return; } }
        i = i + 1;
    }
    if (sval[i] == 0) { return; }
    i = i + 1;
    int depth = 0;
    int start = i;
    while (sval[i] != 0) {
        int c = (int)sval[i];
        if (c == 91) { i = sema_dim_close(sval, i); if (sval[i] == 0) { break; } }
        else if (c == 60 || c == 40) { depth = depth + 1; }        // '<' or '(' (nested generic / fn params)
        else if (c == 41) { if (depth > 0) { depth = depth - 1; } }   // ')'
        else if (c == 62 && (i == 0 || (int)sval[i - 1] != 45)) {   // '>' closing a generic, NOT the "->" arrow
            if (depth == 0) { break; }
            depth = depth - 1;
        }
        else if (c == 44 && depth == 0) {
            List_push<string>(out, sema_trim_sub(sval, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if (i > start) { List_push<string>(out, sema_trim_sub(sval, start, i)); }
}

// ── nullable-pointer safety (`?*T`) ──

// Narrowing key of the innermost binding of `name` ("name@depth"), so a shadowing
// declaration is a different variable; "" when unbound.
string sema_nkey(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) { return ""; }
    Sym sy = List_get<Sym>(&s.syms, si);
    int d = sy.depth;
    uint8[24] buf;
    // A `static` local is one cell shared by every call and closure, like a global: its
    // key ends in "@0" (mirrors the C++ narrowKey).
    if (d > 0 && sy.is_static == 1) { sprintf((string)&buf[0], "@%d@0", d); }
    else { sprintf((string)&buf[0], "@%d", d); }
    return sema_cat(name, (string)&buf[0]);
}

// Is `name` proven non-null here (a null-check narrowed it, mirrors C++ narrowedNonNull)?
int sema_is_narrowed(Sema* s, string name) {
    string k = sema_nkey(s, name);
    if (k[0] == 0) { return 0; }
    return sema_in_list(&s.narrowed, k);
}

// Loop-label stack for labeled break/continue (mirrors C++ loopLabelStack).
void sema_lbl_push(Sema* s, string lbl) {
    if (lbl == null) { lbl = ""; }
    List_push<string>(&s.loop_lbls, lbl);
}
void sema_lbl_pop(Sema* s) {
    int n = List_len<string>(&s.loop_lbls);
    if (n > 0) { List_remove<string>(&s.loop_lbls, n - 1); }
}

// Remove the first `narrowed` entry equal to key `k`.
void sema_narrow_drop(Sema* s, string k) {
    int i = 0; int n = List_len<string>(&s.narrowed);
    while (i < n) {
        if (sema_streq(List_get<string>(&s.narrowed, i), k) == 1) {
            List_remove<string>(&s.narrowed, i); sema_bump(s); return;
        }
        i = i + 1;
    }
}

// Forget every narrowing of variable `name` (any binding depth).
void sema_narrow_kill(Sema* s, string name) {
    int i = List_len<string>(&s.narrowed) - 1;
    while (i >= 0) {
        string k = List_get<string>(&s.narrowed, i);
        int j = 0;
        while (name[j] != 0 && k[j] == name[j]) { j = j + 1; }
        if (name[j] == 0 && (int)k[j] == 64) { List_remove<string>(&s.narrowed, i); sema_bump(s); }   // '@'
        i = i - 1;
    }
}

// Names whose address is taken (`&x`) anywhere in `e` / `st`, lambda bodies included
// (mirrors astwalk::collectAddressTaken; the same kind-aware walk as sema_drop_assigned).
void sema_addr_names(*StmtNode st, List<string>* out);
void sema_addr_names_e(*ExprNode e, List<string>* out) {
    if (e == null) { return; }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) { List_push<string>(out, e.a.sval); }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX || e.kind == EK_TERNARY) { sema_addr_names_e(e.a, out); sema_addr_names_e(e.b, out); }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST || e.kind == EK_QUESTION
             || e.kind == EK_AWAIT || e.kind == EK_CALL || e.kind == EK_INCDEC) { sema_addr_names_e(e.a, out); }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_addr_names_e(List_get<*ExprNode>(&e.kids, i), out); i = i + 1; }
    }
    if (e.kind == EK_LAMBDA) { sema_addr_names(e.stmt, out); }
}
void sema_addr_names(*StmtNode st, List<string>* out) {
    if (st == null) { return; }
    sema_addr_names_e(st.expr, out);
    sema_addr_names_e(st.expr2, out);
    sema_addr_names(st.s1, out);
    sema_addr_names(st.s2, out);
    int i = 0; int n = List_len<*StmtNode>(&st.items);
    while (i < n) { sema_addr_names(List_get<*StmtNode>(&st.items, i), out); i = i + 1; }
}

// Mark the innermost binding of `name`: its address is taken, so a write through that
// pointer can null it behind a check (no narrowing).
void sema_mark_addr(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) { return; }
    Sym sy = List_get<Sym>(&s.syms, si);
    sy.addr_taken = 1;
    List_set<Sym>(&s.syms, si, sy);
    sema_bump(s);
}

// Before a loop body is checked: every `&x` in it (a later iteration's check must not
// trust a pointer taken further down; mirrors the C++ markAddrTakenIn).
void sema_mark_addr_in(Sema* s, *StmtNode st) {
    List<string> names; List_init<string>(&names, 4);
    sema_addr_names(st, &names);
    int i = 0;
    while (i < List_len<string>(&names)) { sema_mark_addr(s, List_get<string>(&names, i)); i = i + 1; }
    List_free<string>(&names);
}

// A call (or an await) may run code that assigns any global: its narrowing ends.
void sema_drop_global_narrowings(Sema* s) {
    s.call_epoch = s.call_epoch + 1;
    int i = List_len<string>(&s.narrowed) - 1;
    while (i >= 0) {
        string k = List_get<string>(&s.narrowed, i);
        int n = 0; while (k[n] != 0) { n = n + 1; }
        if (n >= 2 && (int)k[n - 2] == 64 && (int)k[n - 1] == 48) { List_remove<string>(&s.narrowed, i); sema_bump(s); }   // "@0"
        i = i - 1;
    }
}

// The keys of global variables ("@0") removed from `keys`.
void sema_drop_global_keys(List<string>* keys) {
    int i = List_len<string>(keys) - 1;
    while (i >= 0) {
        string k = List_get<string>(keys, i);
        int n = 0; while (k[n] != 0) { n = n + 1; }
        if (n >= 2 && (int)k[n - 2] == 64 && (int)k[n - 1] == 48) { List_remove<string>(keys, i); }
        i = i - 1;
    }
}

// Does evaluating `e` make a call? (A lambda body is not evaluated there; mirrors the C++
// exprHasCall.)
int sema_is_op_call(Sema* s, *ExprNode e);
int sema_has_call(Sema* s, *ExprNode e) {
    if (e == null || e.kind == EK_LAMBDA) { return 0; }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_AWAIT
        || e.kind == EK_ALLOCWITH || e.kind == EK_THREADCREATE) { return 1; }
    if (sema_is_op_call(s, e) == 1) { return 1; }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        if (sema_has_call(s, e.a) == 1 || sema_has_call(s, e.b) == 1) { return 1; }
    } else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST
               || e.kind == EK_QUESTION || e.kind == EK_INCDEC) {
        if (sema_has_call(s, e.a) == 1) { return 1; }
    }
    if (e.kind == EK_STRUCTINIT || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { if (sema_has_call(s, List_get<*ExprNode>(&e.kids, i)) == 1) { return 1; } i = i + 1; }
    }
    return 0;
}

// The flat name of a generic instance spelling (`G<int>` -> `G_int`, `M<string, int>` ->
// `M_string_int`), like the C++ mangleTemplate; a plain name is itself.
string sema_flat_name(string t) {
    int n = sema_slen(t);
    *uint8 buf = alloc<uint8>(n + 1);
    int o = 0; int i = 0;
    while (i < n) {
        int c = (int)t[i];
        if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) { buf[o] = (uint8)c; o = o + 1; }
        else if (c == 42) { buf[o] = 112; o = o + 1; }            // '*' -> 'p'
        else if (c == 60 || c == 44) { buf[o] = 95; o = o + 1; }   // '<' ',' -> '_'
        i = i + 1;
    }
    buf[o] = 0;
    return (string)buf;
}

*DeclNode sema_variant_enum(Sema* s, string name);
int sema_variant_index(*DeclNode d, string name);
// A generic variant built where a known instance of its enum is expected (`Opt<int64> a =
// Some(5)`, `return None;`, an argument, an assignment, a struct-literal field, an array
// literal element, a variant's payload) takes that instance's type arguments: the node
// becomes the explicit form (`Some<int64>(5)`, `None<int>()`), which codegen lowers as
// written. A `?:` passes the target to both arms, an array literal its element type to
// each element. In a generic body, which every instance shares, only a `raw` target (as
// written: a declared type, the declared return type) is used and its argument spellings
// are kept (`return None;` in an `Opt<T>` function is `None<T>()`). Mirrors the C++
// inferVariantTarget.
void sema_infer_variant_r(Sema* s, *ExprNode x, string t, int raw) {
    int generic = 0;
    if (s.in_inst == 1 || List_len<string>(&s.tparams) > 0) { generic = 1; }
    if (x == null || t == null || t[0] == 0 || (generic == 1 && raw == 0)) { return; }
    if (x.kind == EK_TERNARY) {
        sema_infer_variant_r(s, x.b, t, raw);
        if (List_len<*ExprNode>(&x.kids) > 0) { sema_infer_variant_r(s, List_get<*ExprNode>(&x.kids, 0), t, raw); }
        return;
    }
    if (x.kind == EK_ARRAYLIT) {
        string at = sema_strip_const(t);
        int an = sema_slen(at);
        if (an == 0 || (int)at[an - 1] != 93 || sema_arr_bracket(at) <= 0) { return; }
        string et = sema_arr_elem(at);
        int ai = 0;
        while (ai < List_len<*ExprNode>(&x.kids)) { sema_infer_variant_r(s, List_get<*ExprNode>(&x.kids, ai), et, raw); ai = ai + 1; }
        return;
    }
    string name = "";
    if (x.kind == EK_CALL && x.a != null && x.a.kind == EK_IDENT) { name = x.a.sval; }
    else if (x.kind == EK_IDENT) { name = x.sval; }
    else { return; }
    if (sema_sym_depth(s, name) > 0) { return; }
    *DeclNode ve = sema_variant_enum(s, name);
    if (ve == null || List_len<TypeParam>(&ve.type_params) == 0 || sema_variant_index(ve, name) < 0) { return; }
    string c = sema_strip_const(t);
    if (generic == 0) { c = sema_canon(s, t); }
    if (c[0] == 0 || (int)c[0] == 63 || sema_has_lt(c) == 0 || sema_streq(sema_base_name(c), ve.name) == 0) { return; }
    List<string> targs; List_init<string>(&targs, 2);
    sema_parse_targs(c, &targs);
    if (List_len<string>(&targs) != List_len<TypeParam>(&ve.type_params)) { return; }
    string sig = sema_cat(name, "<");
    int i = 0;
    while (i < List_len<string>(&targs)) {
        if (i > 0) { sig = sema_cat(sig, ","); }
        sig = sema_cat(sig, List_get<string>(&targs, i));
        i = i + 1;
    }
    sig = sema_cat(sig, ">");
    if (x.kind == EK_IDENT) { List_init<*ExprNode>(&x.kids, 1); }
    x.kind = EK_TEMPLATECALL; x.sval = sig; x.a = null;
}
void sema_infer_variant(Sema* s, *ExprNode x, string t) { sema_infer_variant_r(s, x, t, 0); }

// The payload arguments of a generic variant built with type arguments `targs` (as
// written) take the payload's instance: `Some<Opt<int64>>(Some(5))`.
void sema_infer_variant_payload(Sema* s, *ExprNode e, string v, List<string>* targs) {
    *DeclNode ed = sema_variant_enum(s, v);
    if (ed == null || List_len<TypeParam>(&ed.type_params) == 0) { return; }
    int vi = sema_variant_index(ed, v);
    if (vi < 0 || vi >= List_len<List<string>>(&ed.payloads)) { return; }
    if (List_len<string>(targs) != List_len<TypeParam>(&ed.type_params)) { return; }
    List<string> pl = List_get<List<string>>(&ed.payloads, vi);
    List<string> names; List_init<string>(&names, 2);
    int k = 0;
    while (k < List_len<TypeParam>(&ed.type_params)) { List_push<string>(&names, List_get<TypeParam>(&ed.type_params, k).name); k = k + 1; }
    int i = 0;
    while (i < List_len<string>(&pl) && i < List_len<*ExprNode>(&e.kids)) {
        sema_infer_variant_r(s, List_get<*ExprNode>(&e.kids, i), sema_subst_names(List_get<string>(&pl, i), &names, targs), 1);
        i = i + 1;
    }
}

// A struct literal's generic-variant field values take the field's instance (`S{ o:
// Some(3) }`); the declared field types of a non-generic struct are the same in every
// instance.
void sema_infer_struct_fields(Sema* s, *ExprNode e) {
    List<string> targs; List_init<string>(&targs, 2);
    sema_parse_targs(e.sval, &targs);
    if (List_len<string>(&targs) > 0) { return; }
    *DeclNode d = sema_find_struct(s, sema_base_name(e.sval));
    if (d == null || List_len<TypeParam>(&d.type_params) > 0) { return; }
    int nf = List_len<Param>(&d.params);
    int i = 0;
    while (i < List_len<*ExprNode>(&e.kids)) {
        string nm = "";
        if (i < List_len<string>(&e.names)) { nm = List_get<string>(&e.names, i); }
        string ft = "";
        if (nm[0] != 0) {
            int fi = 0;
            while (fi < nf) { if (sema_streq(List_get<Param>(&d.params, fi).name, nm) == 1) { ft = List_get<Param>(&d.params, fi).ty; } fi = fi + 1; }
        } else if (i < nf) { ft = List_get<Param>(&d.params, i).ty; }
        if (ft[0] != 0) { sema_infer_variant_r(s, List_get<*ExprNode>(&e.kids, i), ft, 1); }
        i = i + 1;
    }
}

// A `?:` whose value goes to an interface (a declaration, assignment, return or argument):
// each arm boxes into the interface on its own, so the arms may point at different
// conforming structs (mirrors the C++ ifaceTargetHint).
void sema_hint_iface(Sema* s, *ExprNode x, string t) {
    if (x == null || x.kind != EK_TERNARY || t == null || t[0] == 0) { return; }
    if (sema_find_iface(s, sema_strip_const(sema_strip_nullable(sema_canon(s, t)))) == null) { return; }
    List_push<*ExprNode>(&s.tern_ifn, x);
    List_push<string>(&s.tern_ift, t);
}
string sema_hint_of(Sema* s, *ExprNode x) {
    int i = List_len<*ExprNode>(&s.tern_ifn) - 1;
    while (i >= 0) {
        if (List_get<*ExprNode>(&s.tern_ifn, i) == x) { return List_get<string>(&s.tern_ift, i); }
        i = i - 1;
    }
    return "";
}

// Does `e` (a binary, unary or subscript node) resolve to a user operator overload? Then
// evaluating it is a call (mirrors the C++ operatorCallNodes).
int sema_is_op_call(Sema* s, *ExprNode e) {
    if (s.has_ops == 0 || e == null || e.a == null) { return 0; }
    string op = "";
    if (e.kind == EK_BINARY && e.b != null) {
        op = e.sval;
        if (sema_streq(op, "&&") == 1 || sema_streq(op, "||") == 1 || sema_streq(op, "=") == 1) { return 0; }
        int n = 0; while (op[n] != 0) { n = n + 1; }
        if (n >= 2 && (int)op[n - 1] == 61 && sema_is_cmp_op(op) == 0) { op = sema_sub_str(op, 0, n - 1); }   // `a += b`
    } else if (e.kind == EK_UNARY && (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "!") == 1 || sema_streq(e.sval, "~") == 1)) {
        op = e.sval;
        if (sema_streq(op, "-") == 1) { op = "u-"; }
    } else if (e.kind == EK_INDEX && e.b != null && List_len<*ExprNode>(&e.kids) == 0) {
        op = "[]";
    } else {
        return 0;
    }
    List<string> tys; List_init<string>(&tys, 2);
    List_push<string>(&tys, sema_infer_type(s, e.a));
    if (e.kind != EK_UNARY) { List_push<string>(&tys, sema_infer_type(s, e.b)); }
    *DeclNode d = sema_find_op(s, op, &tys);
    List_free<string>(&tys);
    if (d != null) { return 1; }
    return 0;
}

// May `name` be narrowed? Not when its address is taken (a write through the pointer can
// store null behind the check); for a global, anywhere in the program.
int sema_narrowable(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) { return 1; }
    Sym sy = List_get<Sym>(&s.syms, si);
    if (sy.addr_taken == 1) { return 0; }
    if (sy.depth == 0 && sema_in_list(&s.gaddr, name) == 1) { return 0; }
    return 1;
}

void sema_cond_narrow_leaf(Sema* s, *ExprNode c, int when_true, List<string>* out);
// Keys of the `?*T` variables proven non-null when `c` evaluates to `when_true`
// (`p != null`, `p == null` false, `p`, `!c`, `a && b` true, `a || b` false).
void sema_cond_narrow(Sema* s, *ExprNode c, int when_true, List<string>* out) {
    // The left spine of a run of `&&` (or `||`) is followed with a loop; its right
    // operands are scanned afterwards, bottom-up, so the keys keep their source order.
    List<*ExprNode> rights; List_init<*ExprNode>(&rights, 4);
    List<int> senses; List_init<int>(&senses, 4);
    *ExprNode whole = c;
    while (c != null) {
        if (c.kind == EK_UNARY && sema_streq(c.sval, "!") == 1) {
            if (when_true == 1) { when_true = 0; } else { when_true = 1; }
            c = c.a;
            continue;
        }
        if (c.kind == EK_BINARY
            && ((sema_streq(c.sval, "&&") == 1 && when_true == 1) || (sema_streq(c.sval, "||") == 1 && when_true == 0))) {
            List_push<*ExprNode>(&rights, c.b);
            List_push<int>(&senses, when_true);
            c = c.a;
            continue;
        }
        break;
    }
    // A call may assign any global: a global proven non-null by an earlier operand is
    // not proven after this one runs.
    if (sema_has_call(s, c) == 1) { sema_drop_global_keys(out); }
    sema_cond_narrow_leaf(s, c, when_true, out);
    int i = List_len<*ExprNode>(&rights) - 1;
    while (i >= 0) {
        sema_cond_narrow(s, List_get<*ExprNode>(&rights, i), List_get<int>(&senses, i), out);
        i = i - 1;
    }
    List_free<*ExprNode>(&rights);
    List_free<int>(&senses);
    // A variable the condition itself assigns, steps, or takes the address of is not
    // proven by an earlier test in it (mirrors the C++ condNarrowings).
    if (List_len<string>(out) > 0) {
        List<string> asg; List_init<string>(&asg, 2);
        sema_assigned_names(whole, &asg);
        int k = List_len<string>(out) - 1;
        while (k >= 0 && List_len<string>(&asg) > 0) {
            string key = List_get<string>(out, k);
            int at = 0; while (key[at] != 0 && (int)key[at] != 64) { at = at + 1; }   // '@'
            if (sema_in_list(&asg, sema_sub_str(key, 0, at)) == 1) { List_remove<string>(out, k); }
            k = k - 1;
        }
    }
}

// Names of the variables `e` assigns, increments/decrements, or takes the address of (not
// inside a lambda body, whose captures are copies). Kind-aware, like sema_drop_assigned_e.
void sema_assigned_names(*ExprNode e, List<string>* out) {
    if (e == null) { return; }
    if (e.kind == EK_BINARY && sema_streq(e.sval, "=") == 1 && e.a != null && e.a.kind == EK_IDENT) { List_push<string>(out, e.a.sval); }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) { List_push<string>(out, e.a.sval); }
    if (e.kind == EK_INCDEC && e.a != null && e.a.kind == EK_IDENT) { List_push<string>(out, e.a.sval); }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX || e.kind == EK_TERNARY) { sema_assigned_names(e.a, out); sema_assigned_names(e.b, out); }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST || e.kind == EK_QUESTION
             || e.kind == EK_AWAIT || e.kind == EK_CALL || e.kind == EK_INCDEC) { sema_assigned_names(e.a, out); }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_assigned_names(List_get<*ExprNode>(&e.kids, i), out); i = i + 1; }
    }
}

// sema_cond_narrow for an operand that is not itself `!`, or a `&&`/`||` run.
void sema_cond_narrow_leaf(Sema* s, *ExprNode c, int when_true, List<string>* out) {
    if (c == null) { return; }
    if (c.kind == EK_BINARY) {
        if (sema_streq(c.sval, "!=") == 1 || sema_streq(c.sval, "==") == 1) {
            *ExprNode idE = null;
            if (c.a != null && c.a.kind == EK_IDENT && c.b != null && c.b.kind == EK_LITERAL && c.b.lit_kind == LIT_NULL) { idE = c.a; }
            else if (c.b != null && c.b.kind == EK_IDENT && c.a != null && c.a.kind == EK_LITERAL && c.a.lit_kind == LIT_NULL) { idE = c.b; }
            if (idE != null && sema_lookup_type(s, idE.sval)[0] == 63 && sema_streq(c.sval, "!=") == when_true
                && sema_narrowable(s, idE.sval) == 1) {
                List_push<string>(out, sema_nkey(s, idE.sval));
            }
        }
        return;
    }
    if (when_true == 1 && c.kind == EK_IDENT && sema_lookup_type(s, c.sval)[0] == 63 && sema_narrowable(s, c.sval) == 1) {
        List_push<string>(out, sema_nkey(s, c.sval));   // `if (p)`
    }
}

// Insert `keys` into the narrowed set; the newly inserted ones go to `ins` (to undo).
void sema_narrow_apply(Sema* s, List<string>* keys, List<string>* ins) {
    int i = 0; int n = List_len<string>(keys);
    while (i < n) {
        string k = List_get<string>(keys, i);
        if (k[0] != 0 && sema_in_list(&s.narrowed, k) == 0) { List_push<string>(&s.narrowed, k); List_push<string>(ins, k); sema_bump(s); }
        i = i + 1;
    }
}

void sema_narrow_undo(Sema* s, List<string>* ins) {
    int i = 0; int n = List_len<string>(ins);
    while (i < n) { sema_narrow_drop(s, List_get<string>(ins, i)); i = i + 1; }
}

// Forget narrowing of every variable assigned (or address-taken) in `e` / `st`, before a
// loop whose later iterations observe the assignment. Kind-aware walk (see uninit scan).
void sema_drop_assigned_e(Sema* s, *ExprNode e) {
    if (e == null || List_len<string>(&s.narrowed) == 0) { return; }
    if (e.kind == EK_BINARY && sema_streq(e.sval, "=") == 1 && e.a != null && e.a.kind == EK_IDENT) { sema_narrow_kill(s, e.a.sval); }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) { sema_narrow_kill(s, e.a.sval); }
    if (e.kind == EK_BINARY || e.kind == EK_INDEX || e.kind == EK_TERNARY) { sema_drop_assigned_e(s, e.a); sema_drop_assigned_e(s, e.b); }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST || e.kind == EK_QUESTION
             || e.kind == EK_AWAIT || e.kind == EK_CALL || e.kind == EK_INCDEC) { sema_drop_assigned_e(s, e.a); }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX || e.kind == EK_TERNARY) {
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_drop_assigned_e(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
    }
    if (e.kind == EK_LAMBDA) { sema_drop_assigned(s, e.stmt); }
}

void sema_drop_assigned(Sema* s, *StmtNode st) {
    if (st == null || List_len<string>(&s.narrowed) == 0) { return; }
    sema_drop_assigned_e(s, st.expr);
    sema_drop_assigned_e(s, st.expr2);
    sema_drop_assigned(s, st.s1);
    sema_drop_assigned(s, st.s2);
    int i = 0; int n = List_len<*StmtNode>(&st.items);
    while (i < n) { sema_drop_assigned(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
}

// A `?*T` (checked nullable pointer) may not be dereferenced / indexed / member-accessed
// without a null-check. Mirrors the C++ `checkNullableDeref`: the `?` prefix marks the type
// nullable; a narrowed ident is exempt in its guarded branch.
void sema_check_nullable_deref(Sema* s, *ExprNode operand, string how) {
    if (operand == null) { return; }
    string t = sema_infer_type(s, operand);
    if (t[0] != 63) { return; }                        // not (or no longer) a `?…` nullable pointer
    s.had_error = 1;
    int ol = s.line; int oc = s.col;                   // at the pointer (as the C++ checker)
    if (operand.line > 0) { ol = operand.line; oc = operand.col; }
    dprintf(2, "error: %s:%d:%d: cannot %s a possibly-null pointer of type '%s'; check it first (e.g. `if (x != null)`)\n",
           s.filename, ol, oc, how, t);
}

// `s.len` of a slice: a read-only view of the fat pointer's length.
int sema_is_slice_len(Sema* s, *ExprNode e) {
    if (e == null || e.kind != EK_MEMBER || sema_streq(e.sval, "len") == 0) { return 0; }
    string bt = sema_strip_nullable(sema_strip_const(sema_infer_type(s, e.a)));
    int n = 0; while (bt[n] != 0) { n = n + 1; }
    if (n >= 2 && (int)bt[n - 2] == 91 && (int)bt[n - 1] == 93) { return 1; }   // "...[]"
    return 0;
}

// An expression that denotes storage (a variable, field, element, or `*p`): it may be
// assigned to or have its address taken. Mirrors the C++ isLvalueExpr.
int sema_stored_base(Sema* s, *ExprNode base);
int sema_is_lvalue(Sema* s, *ExprNode e) {
    if (e == null) { return 0; }
    if (e.kind == EK_IDENT) {
        if (sema_local_bound(s, e.sval) == 1) { return 1; }
        if (sema_find_fn(s, e.sval) >= 0) { return 0; }
        return 1;
    }
    if (e.kind == EK_UNARY) { return sema_streq(e.sval, "*"); }
    if (e.kind == EK_MEMBER) {
        if (sema_is_slice_len(s, e) == 1) { return 0; }
        return sema_stored_base(s, e.a);
    }
    if (e.kind == EK_INDEX) {
        if (List_len<*ExprNode>(&e.kids) > 0) { return 0; }
        // `v[i]` on a struct value calls its `operator []`, which returns a value.
        string bc = sema_canon(s, sema_infer_type(s, e.a));
        if (sema_judgeable(s, bc) == 1 && sema_is_struct(s, sema_base_name(bc)) == 1 && sema_arr_bracket(bc) < 0) { return 0; }
        return sema_stored_base(s, e.a);
    }
    return 0;
}

// A field or an array element is storage only when its struct or array is: through a
// pointer (or a slice), or itself stored (`mk().x` and `arr()[0]` are temporaries).
// Mirrors the C++ isLvalueExpr.
int sema_stored_base(Sema* s, *ExprNode base) {
    string bc = sema_canon(s, sema_strip_nullable(sema_infer_type(s, base)));
    int n = sema_slen(bc);
    if (n == 0) { return 1; }
    if ((int)bc[n - 1] == 93 && !(n >= 2 && (int)bc[n - 2] == 91)) { return sema_is_lvalue(s, base); }   // T[N]
    if ((int)bc[0] == 42 || (int)bc[n - 1] == 42) { return 1; }                                        // pointer
    if ((int)bc[n - 1] == 93) { return 1; }                                                             // slice
    if (sema_is_struct(s, sema_base_name(bc)) == 1) { return sema_is_lvalue(s, base); }
    return 1;
}

// Parse an integer spelling (optional '-', decimal, 0x hex, leading-0 octal) as int64.
int64 sema_parse_int(string t) {
    int i = 0; int64 base = 10; int64 sign = (int64)1;
    if (t[0] == '-') { sign = (int64)-1; i = 1; }
    if (t[i] == '0' && (t[i + 1] == 'x' || t[i + 1] == 'X')) { base = 16; i = i + 2; }
    else if (t[i] == '0' && t[i + 1] != 0) { base = 8; i = i + 1; }
    int64 v = 0;
    while (t[i] != 0) {
        int ch = (int)t[i]; int64 d = 0;
        if (ch >= 48 && ch <= 57) { d = (int64)(ch - 48); }
        else if (ch >= 97 && ch <= 102) { d = (int64)(ch - 87); }
        else if (ch >= 65 && ch <= 70) { d = (int64)(ch - 55); }
        else { return sign * v; }
        v = v * base + d;
        i = i + 1;
    }
    return sign * v;
}

// Value of an integer constant expression built from literals, enum members, unary and
// binary operators and casts (mirrors TypeChecker::foldConstInt). Returns 0 when the
// value is not known here (`sizeof`, a non-constant name, division by zero).
// `v` converted to the integer type `t` (C: truncate, then sign- or zero-extend); a
// non-integer or 64-bit type leaves it unchanged.
int64 sema_trunc_const(string t, int64 v) {
    if (sema_streq(t, "bool") == 1) { if (v != (int64)0) { return (int64)1; } return (int64)0; }
    if (sema_streq(t, "char") == 1 || sema_streq(t, "uint8") == 1) { return (int64)(uint8)v; }
    if (sema_streq(t, "int8") == 1) { return (int64)(int8)v; }
    if (sema_streq(t, "uint16") == 1) { return (int64)(uint16)v; }
    if (sema_streq(t, "int16") == 1) { return (int64)(int16)v; }
    if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) { return (int64)(uint32)v; }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1) { return (int64)(int32)v; }
    return v;
}

int sema_fold_ci(Sema* s, *ExprNode e, AstCInt* out);
int sema_fold_num_ci(Sema* s, *ExprNode e, int* is_int, AstCInt* iv, double* dv);

int sema_fold_int(Sema* s, *ExprNode e, int64* out) {
    AstCInt c = ast_ci_make((int64)0, 32, 0);
    if (sema_fold_ci(s, e, &c) == 0) { return 0; }
    out[0] = c.v;
    return 1;
}

// An integer literal spelling (an optional '-') with its C type.
AstCInt sema_lit_ci(string t) {
    if (t[0] == '-') {
        AstCInt m = ast_ci_lit(sema_parse_int(sema_sub_str(t, 1, sema_slen(t))));
        AstCInt r = m;
        ast_ci_unary("-", m, &r);
        return r;
    }
    return ast_ci_lit(sema_parse_int(t));
}

// The typed fold behind sema_fold_int (mirrors TypeChecker::foldConstIntT): the value
// keeps its C type, so the operators follow C's usual arithmetic conversions.
int sema_fold_ci(Sema* s, *ExprNode e, AstCInt* out) {
    if (e == null) { return 0; }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) { out[0] = sema_lit_ci(e.sval); return 1; }
        if (e.lit_kind == LIT_CHAR) { out[0] = ast_ci_make((int64)(uint8)e.sval[0], 32, 0); return 1; }
        if (e.lit_kind == LIT_BOOL) { out[0] = ast_ci_bool(sema_streq(e.sval, "true")); return 1; }
        return 0;
    }
    if (e.kind == EK_IDENT) {
        int si = sema_sym_index(s, e.sval);
        // An enum member is registered as an untyped global; it folds to its value below.
        if (si >= 0 && List_get<Sym>(&s.syms, si).depth == 0 && List_get<Sym>(&s.syms, si).type[0] == 0) { si = -1; }
        if (si >= 0) {
            // A `const` integer folds through its initializer (bounded against a
            // self-referential const).
            Sym sy = List_get<Sym>(&s.syms, si);
            if (sy.is_const == 0 && sy.depth == 0 && sy.type[0] == 0) { si = -1; }   // an enum member
        }
        if (si >= 0) {
            Sym sy = List_get<Sym>(&s.syms, si);
            if (sy.is_const == 0 || sy.init == null || sema_is_int_ty(sy.type) == 0) { return 0; }
            if (s.fold_depth > 64) { return 0; }
            s.fold_depth = s.fold_depth + 1;
            AstCInt v = ast_ci_make((int64)0, 32, 0);
            int ok = sema_fold_ci(s, sy.init, &v);
            s.fold_depth = s.fold_depth - 1;
            if (ok == 0) { return 0; }
            if (ast_ci_cast(sema_strip_const(sema_resolve_scalar(s, sy.type)), v, out) == 0) { out[0] = v; }
            return 1;
        }
        int i = 0; int n = List_len<EVar>(&s.evars);
        while (i < n) {
            EVar ev = List_get<EVar>(&s.evars, i);
            if (sema_streq(ev.variant, e.sval) == 1 && ev.plain == 1) {
                out[0] = ast_ci_of(sema_parse_int(ev.val));
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if (e.kind == EK_UNARY) {
        AstCInt v = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, e.a, &v) == 0) { return 0; }
        return ast_ci_unary(e.sval, v, out);
    }
    if (e.kind == EK_BINARY) {
        // A left-leaning chain (`A + B + C ...`) is folded along its spine with a loop.
        List<*ExprNode> spine; List_init<*ExprNode>(&spine, 4);
        *ExprNode b = e;
        while (b != null && b.kind == EK_BINARY) { List_push<*ExprNode>(&spine, b); b = b.a; }
        AstCInt x = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, b, &x) == 0) { return 0; }
        int i = List_len<*ExprNode>(&spine) - 1;
        while (i >= 0) {
            *ExprNode n = List_get<*ExprNode>(&spine, i);
            AstCInt y = ast_ci_make((int64)0, 32, 0);
            int land = sema_streq(n.sval, "&&"); int lor = sema_streq(n.sval, "||");
            if (land == 1 || lor == 1) {
                // `&&` / `||` short-circuit: an unevaluated right operand need not fold.
                if ((land == 1 && x.v == (int64)0) || (lor == 1 && x.v != (int64)0)) { x = ast_ci_bool(lor); }
                else {
                    if (sema_fold_ci(s, n.b, &y) == 0) { return 0; }
                    x = ast_ci_bool((int)(y.v != (int64)0));
                }
                i = i - 1;
                continue;
            }
            if (sema_fold_ci(s, n.b, &y) == 0) { return 0; }
            if (ast_ci_binary(n.sval, x, y, &x) == 0) { return 0; }
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        out[0] = x;
        return 1;
    }
    if (e.kind == EK_TERNARY) {
        AstCInt c = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, e.a, &c) == 0) { return 0; }
        *ExprNode taken = List_get<*ExprNode>(&e.kids, 0);
        *ExprNode other = e.b;
        if (c.v != (int64)0) { taken = e.b; other = List_get<*ExprNode>(&e.kids, 0); }
        AstCInt a = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, taken, &a) == 0) { return 0; }
        out[0] = a;
        // The arms meet at their common type (when the other one folds too).
        AstCInt o = ast_ci_make((int64)0, 32, 0);
        if (sema_fold_ci(s, other, &o) == 1) {
            int r = a.rank; if (o.rank > r) { r = o.rank; }
            int u = 0;
            if (a.rank == o.rank) { if (a.uns == 1 || o.uns == 1) { u = 1; } }
            else if (a.rank > o.rank) { u = a.uns; } else { u = o.uns; }
            out[0] = ast_ci_make(a.v, r, u);
        }
        return 1;
    }
    if (e.kind == EK_CAST) {
        string to = sema_strip_const(sema_resolve_scalar(s, sema_isub(s, e.sval)));
        int is_int = 1; AstCInt iv = ast_ci_make((int64)0, 32, 0); double dv = 0.0;
        if (sema_fold_num_ci(s, e.a, &is_int, &iv, &dv) == 0) { return 0; }
        if (is_int == 0) {
            // A floating value converts toward zero; out of range it has no value (C).
            if (sema_is_int_ty(to) == 0) { return 0; }
            int64 fv = (int64)0;
            if (sema_streq(to, "bool") == 1) { if (dv != 0.0) { fv = (int64)1; } }
            else {
                if (sema_float_fits_int(dv, to) == 0) { return 0; }
                if (dv >= 9223372036854775808.0) { fv = (int64)(uint64)dv; } else { fv = (int64)dv; }
            }
            iv = ast_ci_make(fv, 64, sema_streq(to, "uint64"));
        }
        if (ast_ci_cast(to, iv, out) == 0) { out[0] = iv; }
        return 1;
    }
    if (e.kind == EK_SIZEOF) {
        // A type whose target layout is known here (scalars, pointers, arrays, structs and
        // unions of those) folds; the rest is left to codegen (mirrors the C++). A size is
        // unsigned 64-bit (C's size_t).
        if (s.in_inst == 1) { return 0; }
        string zt = e.sval;
        if (e.a != null) { zt = sema_infer_type(s, e.a); }
        else if (sema_known_type(s, zt) == 0 && sema_lookup(s, zt) == 1) { zt = sema_lookup_type(s, zt); }
        if (zt == null || zt[0] == 0) { return 0; }
        int64 sz = sema_const_sizeof(s, zt);
        if (sz == (int64)0) { return 0; }
        out[0] = ast_ci_make(sz, 64, 1);
        return 1;
    }
    return 0;
}

double sema_fold_to_float(string t, double v) {
    if (sema_streq(t, "float") == 1) { return (double)(float)v; }
    return v;
}

double sema_ci_double(AstCInt c) {
    if (c.uns == 1) { return (double)(uint64)c.v; }
    return (double)c.v;
}

// Fold an arithmetic constant expression that may involve floating values (C rules:
// integer operands stay integer; mirrors TypeChecker::foldConstNum). is_int says which
// of iv / dv holds the value.
int sema_fold_num(Sema* s, *ExprNode e, int* is_int, int64* iv, double* dv) {
    AstCInt c = ast_ci_make((int64)0, 32, 0);
    if (sema_fold_num_ci(s, e, is_int, &c, dv) == 0) { return 0; }
    iv[0] = c.v;
    return 1;
}

int sema_fold_num_ci(Sema* s, *ExprNode e, int* is_int, AstCInt* iv, double* dv) {
    if (e == null) { return 0; }
    if (e.kind == EK_LITERAL && e.lit_kind == LIT_FLOAT) {
        is_int[0] = 0; dv[0] = strtod(e.sval, null);
        return 1;
    }
    if (e.kind == EK_IDENT) {
        int si = sema_sym_index(s, e.sval);
        if (si >= 0) {
            Sym sy = List_get<Sym>(&s.syms, si);
            string t = sema_strip_const(sema_resolve_scalar(s, sy.type));
            if (sy.is_const == 1 && sy.init != null && (sema_streq(t, "float") == 1 || sema_streq(t, "double") == 1)) {
                if (s.fold_depth > 64) { return 0; }
                s.fold_depth = s.fold_depth + 1;
                int ok = sema_fold_num_ci(s, sy.init, is_int, iv, dv);
                s.fold_depth = s.fold_depth - 1;
                if (ok == 0) { return 0; }
                if (is_int[0] == 1) { dv[0] = sema_ci_double(iv[0]); }
                is_int[0] = 0; dv[0] = sema_fold_to_float(t, dv[0]);
                return 1;
            }
        }
    }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "-") == 1) {
        if (sema_fold_num_ci(s, e.a, is_int, iv, dv) == 0) { return 0; }
        if (is_int[0] == 1) { AstCInt t = iv[0]; ast_ci_unary("-", t, iv); } else { dv[0] = 0.0 - dv[0]; }
        return 1;
    }
    if (e.kind == EK_BINARY) {
        List<*ExprNode> spine; List_init<*ExprNode>(&spine, 4);
        *ExprNode b = e;
        while (b != null && b.kind == EK_BINARY) { List_push<*ExprNode>(&spine, b); b = b.a; }
        int ok = sema_fold_num_ci(s, b, is_int, iv, dv);
        int i = List_len<*ExprNode>(&spine) - 1;
        while (ok == 1 && i >= 0) {
            *ExprNode n = List_get<*ExprNode>(&spine, i);
            int y_int = 1; AstCInt yi = ast_ci_make((int64)0, 32, 0); double yd = 0.0;
            if (sema_fold_num_ci(s, n.b, &y_int, &yi, &yd) == 0) { ok = 0; }
            else if (is_int[0] == 1 && y_int == 1) {
                AstCInt x0 = iv[0];
                if (ast_ci_binary(n.sval, x0, yi, iv) == 0) { ok = 0; }
            } else {
                double x = dv[0];
                if (is_int[0] == 1) { x = sema_ci_double(iv[0]); }
                double y = yd;
                if (y_int == 1) { y = sema_ci_double(yi); }
                if (sema_streq(n.sval, "+") == 1) { dv[0] = x + y; }
                else if (sema_streq(n.sval, "-") == 1) { dv[0] = x - y; }
                else if (sema_streq(n.sval, "*") == 1) { dv[0] = x * y; }
                else if (sema_streq(n.sval, "/") == 1) { dv[0] = x / y; }
                else { ok = 0; }
                is_int[0] = 0;
            }
            i = i - 1;
        }
        List_free<*ExprNode>(&spine);
        return ok;
    }
    if (e.kind == EK_CAST) {
        string to = sema_strip_const(sema_resolve_scalar(s, sema_isub(s, e.sval)));
        if (sema_streq(to, "float") == 1 || sema_streq(to, "double") == 1) {
            if (sema_fold_num_ci(s, e.a, is_int, iv, dv) == 0) { return 0; }
            if (is_int[0] == 1) { dv[0] = sema_ci_double(iv[0]); }
            is_int[0] = 0; dv[0] = sema_fold_to_float(to, dv[0]);
            return 1;
        }
    }
    is_int[0] = 1;
    return sema_fold_ci(s, e, iv);
}

// A switch `case` label codegen can fold to an integer constant.
int sema_is_const_int(Sema* s, *ExprNode e) {
    if (e == null) { return 0; }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT || e.lit_kind == LIT_CHAR || e.lit_kind == LIT_BOOL) { return 1; }
        return 0;
    }
    if (e.kind == EK_IDENT) {
        if (sema_local_bound(s, e.sval) == 0 && sema_is_enum_member(s, e.sval) == 1) { return 1; }
        // `const int K = 7` folds too
        int ci = sema_sym_index(s, e.sval);   // (a const parameter has no initializer to fold)
        if (sema_sym_const(s, e.sval) == 1 && ci >= 0 && List_get<Sym>(&s.syms, ci).init != null
            && sema_is_int_ty(sema_lookup_type(s, e.sval)) == 1) { return 1; }
        return 0;
    }
    if (e.kind == EK_UNARY) {
        if (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "~") == 1 || sema_streq(e.sval, "!") == 1) { return sema_is_const_int(s, e.a); }
        return 0;
    }
    if (e.kind == EK_BINARY) {
        if (sema_streq(e.sval, "=") == 1 || sema_streq(e.sval, "&&") == 1 || sema_streq(e.sval, "||") == 1) { return 0; }
        if (sema_is_const_int(s, e.a) == 1 && sema_is_const_int(s, e.b) == 1) { return 1; }
        return 0;
    }
    if (e.kind == EK_CAST) { return sema_is_const_int(s, e.a); }
    if (e.kind == EK_SIZEOF) { return 1; }
    return 0;
}

// Coarse class of a type spelling for cast checking: 1 number (incl. enum), 2 pointer,
// 3 aggregate (struct/union value, array), 0 unknown (alias etc.: not judged).
int sema_cast_class(Sema* s, string t0) {
    string t = sema_strip_nullable(sema_strip_const(t0));
    if (t[0] == 0) { return 0; }
    if (sema_is_numeric_ty(t) == 1 || sema_is_enum(s, t) == 1) {
        *DeclNode ed = sema_find_tdecl(s, t);
        if (ed != null && ed.kind == DK_ENUM && sema_is_aggregate(s, t) == 1) { return 3; }   // a sum type
        return 1;
    }
    if (sema_is_fn_type(t) == 1) { return 3; }
    if (sema_is_ptrish(t) == 1) { return 2; }
    if (sema_is_arr_ty(t) == 1) { return 3; }
    *DeclNode d = sema_find_tdecl(s, sema_base_name(t));
    if (d != null && (d.kind == DK_STRUCT || d.kind == DK_UNION)) { return 3; }
    if (sema_find_iface(s, t) != null) { return 3; }   // an interface value {data, vtable}
    return 0;
}

// Is any `operator []` overload declared?
int sema_any_index_op(Sema* s) {
    int i = 0; int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.operator_sym != null && sema_streq(d.operator_sym, "[]") == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ── expression walk ──

// `recs` with a record of type `t` in the generic instance being checked appended: its
// type arguments joined by '\t', a '\f', the type, a '\n' (al_generalize reads these).
string sema_inst_rec(Sema* s, string recs, string t) {
    string r = recs; if (r == null) { r = ""; }
    int i = 0;
    while (i < List_len<string>(&s.isub_a)) {
        if (i > 0) { r = sema_cat(r, "\t"); }
        r = sema_cat(r, List_get<string>(&s.isub_a, i));
        i = i + 1;
    }
    r = sema_cat(r, "\f");
    if (t != null) { r = sema_cat(r, t); }
    return sema_cat(r, "\n");
}

void sema_binary_chain(Sema* s, *ExprNode e);
// Check `e` with its position as the current diagnostic location (restored afterwards so
// the enclosing node's own checks report at the enclosing node).
void sema_expr(Sema* s, *ExprNode e) {
    if (e == null) { return; }
    int pl = s.line; int pc = s.col;
    if (e.line > 0) { s.line = e.line; s.col = e.col; }
    sema_expr_k(s, e);
    if (s.in_async == 1) {                 // the async lowering's temporaries
        e.aty = sema_infer_type(s, e);
        if (s.in_inst == 1) { e.ainst = sema_inst_rec(s, e.ainst, e.aty); }
    }
    // The callee may assign any global: a global's narrowing ends after the call.
    // alloc_with calls the allocator's method and thread_create starts code that may run
    // at once, so they end it too.
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_AWAIT || e.kind == EK_ALLOCWITH
        || e.kind == EK_THREADCREATE || sema_is_op_call(s, e) == 1) { sema_drop_global_narrowings(s); }
    s.line = pl; s.col = pc;
}

// The checks of one non-assignment binary operator `e` whose operands have the inferred
// types `lt0` and `rt0` (see sema_binary_chain).
// An aggregate (struct, union or payload enum): compared only through a user operator
// (mirrors the C++ isAgg).
int sema_is_agg(Sema* s, string c) {
    if (sema_is_struct(s, sema_base_name(c)) == 1) { return 1; }
    *DeclNode d = sema_find_tdecl(s, sema_base_name(c));
    if (d != null && d.kind == DK_ENUM && sema_is_plain_enum_decl(d) == 0) { return 1; }
    return 0;
}

// Do the built-in operators accept binary `op` over operand types `lt0`, `rt0`? 1 yes,
// 0 no (only a user overload can), -1 when a type is not understood well enough to judge.
// Mirrors the C++ inferBinaryExprType.
int sema_binop_verdict(Sema* s, string op, string lt0, string rt0) {
    string l = sema_canon(s, lt0); string r = sema_canon(s, rt0);
    if (sema_judgeable(s, l) == 0 || sema_judgeable(s, r) == 0) { return -1; }
    // A `void` call has no value to compare or test.
    int has_void = 0;
    if (sema_streq(l, "void") == 1 || sema_streq(r, "void") == 1) { has_void = 1; }
    if (sema_is_cmp_op(op) == 1) {
        if (has_void == 1) { return 0; }
        int lp = sema_c_ptr(l); if (sema_streq(l, "null") == 1) { lp = 1; }
        int rp = sema_c_ptr(r); if (sema_streq(r, "null") == 1) { rp = 1; }
        if (sema_is_numeric_ty(l) == 1 && sema_is_numeric_ty(r) == 1) { return 1; }
        if (lp == 1 && rp == 1) { return 1; }
        // An interface value compares with `null` (its data pointer is null or set).
        if ((sema_streq(op, "==") == 1 || sema_streq(op, "!=") == 1)
            && ((sema_is_iface_val(s, lt0) == 1 && sema_streq(r, "null") == 1)
                || (sema_streq(l, "null") == 1 && sema_is_iface_val(s, rt0) == 1))) { return 1; }
        if (sema_is_aggregate(s, lt0) == 1 || sema_is_aggregate(s, rt0) == 1) { return 0; }   // no built-in == on aggregates
        if (sema_streq(l, r) == 1 && sema_is_agg(s, l) == 0) { return 1; }
        return 0;
    }
    if (sema_streq(op, "&&") == 1 || sema_streq(op, "||") == 1) { return 1 - has_void; }
    if (sema_streq(op, "&") == 1 || sema_streq(op, "|") == 1 || sema_streq(op, "^") == 1
        || sema_streq(op, "<<") == 1 || sema_streq(op, ">>") == 1) {
        if (sema_is_int_ty(l) == 1 && sema_is_int_ty(r) == 1) { return 1; }
        return 0;
    }
    if (sema_is_arith_op(op) == 0) { return -1; }
    if (sema_streq(op, "-") == 1 && sema_c_ptr(l) == 1 && sema_c_ptr(r) == 1) { return 1; }
    if ((sema_streq(op, "+") == 1 || sema_streq(op, "-") == 1) && sema_c_ptr(l) == 1 && sema_is_int_ty(r) == 1) { return 1; }
    if (sema_is_numeric_ty(l) == 1 && sema_is_numeric_ty(r) == 1) { return 1; }
    return 0;
}

void sema_binary_checks(Sema* s, *ExprNode e, string lt0, string rt0) {
    // `p - q` counts elements between two pointers into one array: they must point to
    // the same type (C, mirrors the C++ finishBinary).
    if (e.a != null && e.b != null && sema_streq(e.sval, "-") == 1) {
        string pl = sema_strip_nullable(sema_canon(s, lt0));
        string pr = sema_strip_nullable(sema_canon(s, rt0));
        if ((int)pl[0] == 42 && (int)pr[0] == 42 && sema_judgeable(s, pl) == 1 && sema_judgeable(s, pr) == 1
            && sema_streq(pl, pr) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: pointer subtraction needs pointers to the same type, got '%s' and '%s'\n", s.filename, s.line, s.col, lt0, rt0);
            return;
        }
    }
    int verdict = -1;
    if (e.a != null && e.b != null) { verdict = sema_binop_verdict(s, e.sval, lt0, rt0); }
    if (verdict == 0 && sema_find_binop(s, e.sval, lt0, rt0) == null) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: invalid operands for operator: %s and %s\n", s.filename, s.line, s.col, lt0, rt0);
    }
    if (e.a != null && e.b != null && verdict == -1) {
        // Operand kinds the built-in operators reject (a user operator overload aside).
        string olt = sema_strip_const(lt0);
        string ort = sema_strip_const(rt0);
        int bitop = 0;
        if (sema_streq(e.sval, "&") == 1 || sema_streq(e.sval, "|") == 1 || sema_streq(e.sval, "^") == 1
            || sema_streq(e.sval, "<<") == 1 || sema_streq(e.sval, ">>") == 1) { bitop = 1; }
        int arith = 0;
        if (sema_streq(e.sval, "+") == 1 || sema_streq(e.sval, "*") == 1 || sema_streq(e.sval, "/") == 1
            || sema_streq(e.sval, "%") == 1) { arith = 1; }
        int bad = 0;
        if (bitop == 1 && (sema_is_float_ty(olt) == 1 || sema_is_float_ty(ort) == 1)
            && (sema_is_numeric_ty(olt) == 1 && sema_is_numeric_ty(ort) == 1)) { bad = 1; }
        if (arith == 1 && sema_is_ptrish(olt) == 1 && sema_is_ptrish(ort) == 1
            && sema_streq(olt, "null") == 0 && sema_streq(ort, "null") == 0) { bad = 1; }
        // A struct value has no built-in arithmetic/bitwise operator (only a user
        // overload), and a pointer or string has no `*` `/` `%`.
        if ((arith == 1 || bitop == 1 || sema_streq(e.sval, "-") == 1)
            && (sema_is_struct(s, olt) == 1 || sema_is_struct(s, ort) == 1) && sema_find_binop(s, e.sval, olt, ort) == null) { bad = 1; }
        if ((bitop == 1 || sema_streq(e.sval, "*") == 1 || sema_streq(e.sval, "/") == 1 || sema_streq(e.sval, "%") == 1)
            && olt[0] != 0 && ort[0] != 0 && sema_any_op(s, e.sval) == 0
            && ((sema_is_ptrish(olt) == 1 && sema_is_arr_ty(olt) == 0) || (sema_is_ptrish(ort) == 1 && sema_is_arr_ty(ort) == 0))) { bad = 1; }
        if (bad == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: invalid operands for operator: %s and %s\n", s.filename, s.line, s.col, olt, ort);
        }
    }
    // A constant shift count must be below the (promoted) left operand's width and not
    // negative (C: undefined). An unknown left type is checked against 64 bits.
    if ((sema_streq(e.sval, "<<") == 1 || sema_streq(e.sval, ">>") == 1) && e.b != null) {
        int64 cnt = (int64)0;
        string slt = sema_resolve_scalar(s, lt0);
        int width = 0;
        if (slt[0] == 0 || sema_streq(slt, "int64") == 1 || sema_streq(slt, "uint64") == 1) { width = 64; }
        else if (sema_is_int_ty(slt) == 1) { width = 32; }
        if (width > 0 && sema_fold_int(s, e.b, &cnt) == 1 && (cnt < (int64)0 || cnt >= (int64)width)) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: shift count %lld is out of range for a %d-bit operand (it must be 0..%d)\n",
                   s.filename, s.line, s.col, cnt, width, width - 1);
        }
    }
    // `&&` / `||` take truth values (scalars), not aggregates.
    if ((sema_streq(e.sval, "&&") == 1 || sema_streq(e.sval, "||") == 1)
        && ((sema_is_aggregate(s, lt0) == 1 && sema_is_iface_val(s, lt0) == 0)
            || (sema_is_aggregate(s, rt0) == 1 && sema_is_iface_val(s, rt0) == 0))) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: invalid operands for operator: %s and %s\n", s.filename, s.line, s.col, lt0, rt0);
    }
    // Division / remainder by a literal zero is a guaranteed runtime trap.
    if ((sema_streq(e.sval, "/") == 1 || sema_streq(e.sval, "%") == 1)
        && e.b != null && e.b.kind == EK_LITERAL && e.b.lit_kind == LIT_INT
        && sema_lit_is_zero(e.b.sval) == 1) {
        if (sema_streq(e.sval, "/") == 1) { sema_error(s, "division by zero"); }
        else { sema_error(s, "remainder by zero"); }
    }
    // An integer division whose operands are constant expressions (names, `sizeof`,
    // casts) is checked like a literal one: by zero, or the most negative value by -1,
    // is undefined in C (mirrors the C++ finishBinary).
    if ((sema_streq(e.sval, "/") == 1 || sema_streq(e.sval, "%") == 1) && e.a != null && e.b != null) {
        string drt = sema_strip_const(sema_resolve_scalar(s, sema_binary_type(s, e.sval, lt0, rt0)));
        int lit_zero = 0;
        if (e.b.kind == EK_LITERAL && e.b.lit_kind == LIT_INT && sema_lit_is_zero(e.b.sval) == 1) { lit_zero = 1; }
        int64 dx = (int64)0; int64 dy = (int64)0;
        int wide = 0;
        if (sema_streq(drt, "int64") == 1 || sema_streq(drt, "uint64") == 1) { wide = 1; }
        string what = "remainder";
        if (sema_streq(e.sval, "/") == 1) { what = "division"; }
        if (sema_is_int_ty(drt) == 1 && sema_fold_int(s, e.b, &dy) == 1) {
            if (wide == 0) { dy = sema_trunc_const(drt, dy); }
            if (dy == (int64)0 && lit_zero == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: %s by zero\n", s.filename, s.line, s.col, what);
            } else if (dy == (int64)-1 && (sema_streq(drt, "int") == 1 || sema_streq(drt, "int32") == 1 || sema_streq(drt, "int64") == 1)
                       && sema_fold_int(s, e.a, &dx) == 1) {
                if (wide == 0) { dx = sema_trunc_const(drt, dx); }
                int64 lo = (int64)-2147483647 - (int64)1;
                if (wide == 1) { lo = (int64)-9223372036854775807 - (int64)1; }
                if (dx == lo) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: %s overflows: %lld %s -1 does not fit '%s'\n", s.filename, s.line, s.col, what, dx, e.sval, drt);
                }
            }
        }
    }
    // Comparison operands must be mutually comparable: both numeric, both pointer-like
    // (incl. null), or the same non-aggregate type. Conservative: only flag when both
    // operand types are known (unknown → skip, never falsely reject).
    if (sema_is_cmp_op(e.sval) == 1 && verdict == -1) {
        string lt = lt0;
        string rt = rt0;
        if (lt[0] != 0 && rt[0] != 0 && sema_streq(lt, "unknown") == 0 && sema_streq(rt, "unknown") == 0) {
            int ok = 0;
            // Aggregates (struct/union, sum type, interface value, array, slice, closure)
            // have no built-in comparison (only a user `operator ==`).
            if (sema_is_aggregate(s, lt) == 1 || sema_is_aggregate(s, rt) == 1) { ok = 0; }
            else if (sema_is_numeric_ty(lt) == 1 && sema_is_numeric_ty(rt) == 1) { ok = 1; }
            else if (sema_is_ptrish(lt) == 1 && sema_is_ptrish(rt) == 1) { ok = 1; }
            else if (sema_streq(lt, rt) == 1 && sema_is_struct(s, sema_base_name(lt)) == 0) { ok = 1; }
            if (ok == 0) {                                 // or a user `operator ==(L,R)` exists
                let cty: List<string>; List_init<string>(&cty, 2);
                List_push<string>(&cty, lt); List_push<string>(&cty, rt);
                string copn = ast_op_name(e.sval, &cty);
                if (copn[0] != 0 && sema_find_fn(s, copn) >= 0) { ok = 1; }
            }
            if (ok == 0) { sema_error(s, "invalid operands for operator"); }
        }
    }
}

// A non-assignment binary expression. A left-leaning chain (`a + b + c ...`) is as deep
// as it is long, so its left spine is handled with loops, in the order a recursive walk
// would take: the operand types are inferred bottom-up once, each operator's checks run
// top-down, then the operands are visited in source order (the leftmost first), each
// right operand at its operator's position and, under `&&`/`||`, with the left side's
// narrowing in force.
void sema_binary_chain(Sema* s, *ExprNode e) {
    List<*ExprNode> spine; List_init<*ExprNode>(&spine, 8);
    *ExprNode b = e;
    while (b != null && b.kind == EK_BINARY && sema_is_assign(b.sval) == 0) {
        List_push<*ExprNode>(&spine, b);
        b = b.a;
    }
    int n = List_len<*ExprNode>(&spine);
    List<string> lts; List_init<string>(&lts, n);
    List<string> rts; List_init<string>(&rts, n);
    List<int> pls; List_init<int>(&pls, n);
    List<int> pcs; List_init<int>(&pcs, n);
    int i = 0;
    while (i < n) {
        List_push<string>(&lts, ""); List_push<string>(&rts, "");
        *ExprNode pn = List_get<*ExprNode>(&spine, i);
        if (i > 0 && pn.line > 0) { List_push<int>(&pls, pn.line); List_push<int>(&pcs, pn.col); }
        else if (i > 0) { List_push<int>(&pls, List_get<int>(&pls, i - 1)); List_push<int>(&pcs, List_get<int>(&pcs, i - 1)); }
        else { List_push<int>(&pls, s.line); List_push<int>(&pcs, s.col); }
        i = i + 1;
    }
    string t = sema_infer_type(s, b);
    i = n - 1;
    while (i >= 0) {
        *ExprNode tn = List_get<*ExprNode>(&spine, i);
        string rt = sema_infer_type(s, tn.b);
        List_set<string>(&lts, i, t);
        List_set<string>(&rts, i, rt);
        t = sema_binary_type(s, tn.sval, t, rt);
        i = i - 1;
    }
    i = 0;
    while (i < n) {
        s.line = List_get<int>(&pls, i); s.col = List_get<int>(&pcs, i);
        sema_binary_checks(s, List_get<*ExprNode>(&spine, i), List_get<string>(&lts, i), List_get<string>(&rts, i));
        i = i + 1;
    }
    s.line = List_get<int>(&pls, n - 1); s.col = List_get<int>(&pcs, n - 1);
    sema_expr(s, b);
    // Narrowing keys of the left operand of the operator just visited: in a run of the
    // same `&&` (or `||`), the next operator's left narrows to those plus the previous
    // right operand's, so each operand is scanned once instead of the whole prefix.
    List<string> keys; List_init<string>(&keys, 2);
    i = n - 1;
    while (i >= 0) {
        *ExprNode vn = List_get<*ExprNode>(&spine, i);
        s.line = List_get<int>(&pls, i); s.col = List_get<int>(&pcs, i);
        if (sema_streq(vn.sval, "&&") == 1 || sema_streq(vn.sval, "||") == 1) {
            // Short-circuit narrowing: the right operand sees the left's outcome.
            int wt = sema_streq(vn.sval, "&&");
            int same = 0;
            if (i + 1 < n) {
                *ExprNode below = List_get<*ExprNode>(&spine, i + 1);
                same = sema_streq(below.sval, vn.sval);
                if (same == 1) { sema_cond_narrow(s, below.b, wt, &keys); }
            }
            if (same == 0) {
                List_free<string>(&keys); List_init<string>(&keys, 2);
                sema_cond_narrow(s, vn.a, wt, &keys);
            }
            List<string> ins; List_init<string>(&ins, 2);
            sema_narrow_apply(s, &keys, &ins);
            sema_expr(s, vn.b);
            sema_narrow_undo(s, &ins);
        } else {
            sema_expr(s, vn.b);
        }
        i = i - 1;
    }
    s.line = List_get<int>(&pls, 0); s.col = List_get<int>(&pcs, 0);
    List_free<*ExprNode>(&spine);
}

// `va_start(ap)` / `va_end(ap)` / `va_arg<T>(ap)`: one `va_list` operand (mirrors
// TypeChecker::checkVaListArg).
void sema_check_va_list_arg(Sema* s, string what, *ExprNode e) {
    int n = List_len<*ExprNode>(&e.kids);
    if (n != 1) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: '%s' takes one argument (a va_list), got %d\n", s.filename, s.line, s.col, what, n);
        return;
    }
    string t = sema_infer_type(s, List_get<*ExprNode>(&e.kids, 0));
    if (t[0] != 0 && sema_streq(sema_canon(s, t), "va_list") == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: '%s' needs a 'va_list', got '%s'\n", s.filename, s.line, s.col, what, t);
    }
}

void sema_expr_k(Sema* s, *ExprNode e) {
    if (e == null) { return; }
    int k = e.kind;
    if (k == EK_IDENT) {
        // va_start/va_end are variadic-access builtins with no declaration (va_arg<T> is a
        // template call). Treat them as defined, matching the C++ checker.
        if ((sema_lookup(s, e.sval) == 0
             || (sema_local_bound(s, e.sval) == 0 && sema_in_list(&s.late_globals, e.sval) == 1))
            && sema_streq(e.sval, "va_start") == 0 && sema_streq(e.sval, "va_end") == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: undefined variable '%s'\n", s.filename, s.line, s.col, e.sval);
        } else if (sema_sym_depth(s, e.sval) <= 0) {
            // A generic enum's variant does not name its type arguments by itself (they
            // are not inferred from the target type): `None<int>()` (mirrors the C++).
            *DeclNode gve = sema_variant_enum(s, e.sval);
            int gvi = -1;
            int gpl = 0;
            if (gve != null) { gvi = sema_variant_index(gve, e.sval); }
            if (gvi >= 0 && gvi < List_len<List<string>>(&gve.payloads)) {
                List<string> gpv = List_get<List<string>>(&gve.payloads, gvi);
                gpl = List_len<string>(&gpv);
            }
            if (gve != null && List_len<TypeParam>(&gve.type_params) > 0 && gvi >= 0 && gpl == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: variant '%s' of generic enum '%s' needs explicit type arguments, as in %s<int>()\n",
                        s.filename, s.line, s.col, e.sval, gve.name, e.sval);
            }
            if (gve != null && List_len<TypeParam>(&gve.type_params) == 0 && gpl > 0
                && sema_streq(e.sval, s.callee_ctx) == 0 && sema_find_fndecl(s, e.sval) == null) {
                s.had_error = 1;                   // a payload variant is built by a call: `A(1)`
                dprintf(2, "error: %s:%d:%d: variant '%s' needs %d argument(s)\n", s.filename, s.line, s.col, e.sval, gpl);
            }
        }
        // Escape soundness: a non-escaping closure param used anywhere but as the
        // immediate callee of a call escapes.
        if (sema_in_list(&s.watched, e.sval) == 1
            && (sema_streq(e.sval, s.callee_ctx) == 0 || sema_captured_by_escaping(s, e.sval) == 1)) {
            if (sema_in_list(&s.escaped, e.sval) == 0) { List_push<string>(&s.escaped, e.sval); }
        }
        if (sema_in_list(&s.wlocals, e.sval) == 1 && sema_streq(e.sval, s.callee_ctx) == 0
            && sema_in_list(&s.wlocals_esc, e.sval) == 0) {
            List_push<string>(&s.wlocals_esc, e.sval);
        }
        if (sema_in_list(&s.wlocals, e.sval) == 1) { sema_note_local_capture(s, e.sval); }
        return;
    }
    if (k == EK_SIZEOF && e.a != null) {   // sizeof(expr): checked, never evaluated
        sema_expr(s, e.a);
        string zt = sema_infer_type(s, e.a);
        if (sema_is_void_value(sema_resolve_scalar(s, zt)) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: sizeof of 'void': a void value has no size\n", s.filename, s.line, s.col);
        }
        return;
    }
    if (k == EK_SIZEOF) {                  // sizeof(T) or sizeof(variable): T must be a known type
        *DeclNode szd = sema_find_tdecl(s, e.sval);
        if (sema_lookup(s, e.sval) == 0 && szd != null && List_len<TypeParam>(&szd.type_params) > 0
            && sema_in_list(&s.tparams, e.sval) == 0) {
            s.had_error = 1;                // a generic type has no size until instantiated
            dprintf(2, "error: %s:%d:%d: unknown type '%s'\n", s.filename, s.line, s.col, e.sval);
        }
        // A variable: a typed symbol, not a function, an enum member, or a later global.
        int szvar = 0;
        if (sema_lookup(s, e.sval) == 1 && (sema_local_bound(s, e.sval) == 1
            || (sema_lookup_type(s, e.sval)[0] != 0 && sema_in_list(&s.late_globals, e.sval) == 0))) { szvar = 1; }
        if (szvar == 0 && sema_known_type(s, e.sval) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: unknown type '%s'\n", s.filename, s.line, s.col, sema_base_name(sema_struct_of_type(e.sval)));
        }
        if (sema_lookup(s, e.sval) == 0 && sema_is_void_value(sema_resolve_scalar(s, sema_isub(s, e.sval))) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: sizeof of 'void': a void value has no size\n", s.filename, s.line, s.col);
        }
        return;
    }
    if (k == EK_LITERAL) { return; }
    if (k == EK_BINARY && sema_is_assign(e.sval) == 0) { sema_binary_chain(s, e); return; }
    if (k == EK_BINARY) {                              // an assignment (`=` or compound)
        // A compound assignment `x op= lit` (desugared to `x = x op lit`, sharing the target
        // node) stores into x's type, so its literal operand must fit it, as for `x = lit`.
        if (sema_streq(e.sval, "=") == 1 && e.b != null && e.b.kind == EK_BINARY && e.b.a == e.a
            && sema_streq(e.b.sval, "<<") == 0 && sema_streq(e.b.sval, ">>") == 0
            && e.b.b != null && e.b.b.kind == EK_LITERAL && e.b.b.lit_kind == LIT_INT) {
            string ct = sema_strip_const(sema_infer_type(s, e.a));
            if (sema_is_int_ty(ct) == 1 && sema_int_lit_fits(ct, e.b.b.sval) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: compound assignment: integer literal %s is out of range for '%s'\n", s.filename, s.line, s.col, e.b.b.sval, ct);
            }
        }
        if (sema_streq(e.sval, "=") == 1 && e.a != null) {
            string alt = sema_infer_type(s, e.a);
            if (e.a.kind == EK_IDENT) { alt = sema_lookup_type(s, e.a.sval); }   // declared type, even if narrowed
            sema_infer_variant(s, e.b, alt);
            if (e.b != null && e.b.kind == EK_ARRAYLIT) {
                // A `{...}` literal is only an initializer (mirrors the C++ assignability).
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: assignment: cannot convert 'array-literal' to '%s'\n", s.filename, s.line, s.col, alt);
            } else if (alt[0] != 0) {
                string aerr = sema_assign_err(s, alt, e.b);
                if (aerr[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: assignment: %s\n", s.filename, s.line, s.col, aerr);
                }
            }
        }
        if (sema_is_slice_len(s, e.a) == 1) {
            sema_error(s, "cannot assign to the length of a slice: it is read-only (take a new slice instead)");
        } else if (sema_streq(e.sval, "=") == 1 && sema_is_lvalue(s, e.a) == 0) {
            sema_error(s, "cannot assign to this expression: it is not a variable, field, element, or dereference");
        }
        if (sema_is_assign(e.sval) == 1 && sema_is_readonly_lvalue(s, e.a) == 1) {
            sema_error(s, "cannot assign to read-only location");
        }
        if (sema_is_assign(e.sval) == 1) { sema_check_captured_write(s, e.a); }
        sema_expr(s, e.a);
        if (sema_streq(e.sval, "=") == 1) {
            sema_hint_iface(s, e.b, sema_infer_type(s, e.a));
        }
        sema_expr(s, e.b);
        // `p = ...` ends p's narrowing unless it stores an address `&x` or steps the pointer
        // itself (`p = p + k`, `p += k`).
        int keeps = 0;
        if (e.b != null && e.b.kind == EK_UNARY && sema_streq(e.b.sval, "&") == 1) { keeps = 1; }
        if (e.b != null && e.b.kind == EK_BINARY && (sema_streq(e.b.sval, "+") == 1 || sema_streq(e.b.sval, "-") == 1)
            && e.b.a != null && e.b.a.kind == EK_IDENT && e.a != null && e.a.kind == EK_IDENT
            && sema_streq(e.b.a.sval, e.a.sval) == 1) { keeps = 1; }
        if (sema_streq(e.sval, "=") == 1 && e.a != null && e.a.kind == EK_IDENT && keeps == 0) {
            string nk = sema_nkey(s, e.a.sval);
            if (nk[0] != 0) { sema_narrow_drop(s, nk); }
        }
        return;
    }
    if (k == EK_INCDEC) {                              // ++x / x++ etc.
        // The operand must be a modifiable lvalue: an ident, field, element, or deref
        // (not a literal or other rvalue like `5++`).
        if (e.a == null || (e.a.kind != EK_IDENT && e.a.kind != EK_MEMBER && e.a.kind != EK_INDEX
            && (e.a.kind != EK_UNARY || sema_streq(e.a.sval, "*") == 0))) {
            sema_error(s, "'++'/'--' requires a modifiable variable");
        } else if (sema_is_slice_len(s, e.a) == 1) {
            sema_error(s, "cannot assign to the length of a slice: it is read-only (take a new slice instead)");
        } else if (sema_is_readonly_lvalue(s, e.a) == 1) {
            sema_error(s, "cannot modify read-only location");
        } else {
            string it = sema_infer_type(s, e.a);         // integer or pointer only (C++ rule)
            string ic = sema_canon(s, it);
            *DeclNode ied = sema_find_tdecl(s, sema_strip_const(it));   // an enum value is not an integer here
            if ((ied != null && ied.kind == DK_ENUM)
                || (sema_judgeable(s, ic) == 1 && sema_is_int_ty(ic) == 0 && sema_c_ptr(ic) == 0)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: '++'/'--' requires an integer or pointer, got '%s'\n", s.filename, s.line, s.col, it);
            }
        }
        sema_check_captured_write(s, e.a);
        sema_expr(s, e.a); return;
    }
    if (k == EK_ARRAYLIT) {                            // { e0, e1, ... }
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    if (k == EK_TERNARY) {                             // cond ? then : else
        sema_expr(s, e.a);
        *ExprNode elseE = List_get<*ExprNode>(&e.kids, 0);
        string ihint = sema_hint_of(s, e);
        if (ihint[0] != 0) { sema_hint_iface(s, e.b, ihint); sema_hint_iface(s, elseE, ihint); }   // nested arms too
        List<string> tkeys; List_init<string>(&tkeys, 2);
        List<string> tins; List_init<string>(&tins, 2);
        sema_cond_narrow(s, e.a, 1, &tkeys);
        sema_narrow_apply(s, &tkeys, &tins);
        sema_expr(s, e.b);
        sema_narrow_undo(s, &tins);
        List<string> fkeys; List_init<string>(&fkeys, 2);
        List<string> fins; List_init<string>(&fins, 2);
        sema_cond_narrow(s, e.a, 0, &fkeys);
        sema_narrow_apply(s, &fkeys, &fins);
        sema_expr(s, elseE);
        sema_narrow_undo(s, &fins);
        string cty = sema_infer_type(s, e.a);
        string ccn = sema_canon(s, cty);
        if (sema_judgeable(s, ccn) == 1 && sema_is_numeric_ty(ccn) == 0 && sema_c_ptr(ccn) == 0 && sema_is_iface_val(s, cty) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: ternary condition must be a bool, integer, or pointer, got %s\n", s.filename, s.line, s.col, cty);
        }
        // The two arms need a common type: same, both numeric, or both pointer-like.
        // Conservative: only flag when both arm types are known.
        string tt = sema_infer_type(s, e.b);
        string et = sema_infer_type(s, elseE);
        if (tt[0] != 0 && et[0] != 0 && sema_streq(tt, "unknown") == 0 && sema_streq(et, "unknown") == 0) {
            int ok = 0;
            if (sema_streq(tt, et) == 1) { ok = 1; }
            else if (sema_is_numeric_ty(tt) == 1 && sema_is_numeric_ty(et) == 1) { ok = 1; }
            else if (sema_is_ptrish(tt) == 1 && sema_is_ptrish(et) == 1
                     && (sema_streq(tt, "null") == 1 || sema_streq(et, "null") == 1 || sema_ptr_compat(s, tt, et) == 1)) { ok = 1; }
            // Bound for an interface: each arm that converts to it is boxed there.
            else if (ihint[0] != 0 && sema_assign_strict(s, ihint, tt)[0] == 0 && sema_assign_strict(s, ihint, et)[0] == 0) { ok = 1; }
            // One arm converts to the other's type (a `*Sq` arm meets an interface arm as
            // the interface, mirrors the C++ ternary).
            else if (sema_assign_strict(s, tt, et)[0] == 0 || sema_assign_strict(s, et, tt)[0] == 0) { ok = 1; }
            if (ok == 0) { sema_error(s, "ternary branches have incompatible types"); }
        }
        return;
    }
    if (k == EK_AWAIT) {
        if (s.in_async == 0) {
            sema_error(s, "await is only allowed inside an async function");
        }
        s.await_seen = 1;
        sema_expr(s, e.a);
        string awt = sema_infer_type(s, e.a);         // the operand is a `*Future<T>`
        string awc = sema_canon(s, awt);
        if (sema_judgeable(s, awc) == 1 && sema_future_inner(s, awt)[0] == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: await expects a *Future<T>, got %s\n", s.filename, s.line, s.col, awt);
        }
        return;
    }
    if (k == EK_MEMBER) {
        // A chain `a.b.c...` is walked once, innermost member first, carrying the type of
        // each base forward: re-walking and re-inferring every base from scratch costs
        // time quadratic in the chain's length.
        List<*ExprNode> chain; List_init<*ExprNode>(&chain, 4);
        *ExprNode base = e;
        while (base != null && base.kind == EK_MEMBER) { List_push<*ExprNode>(&chain, base); base = base.a; }
        // Each member reports at its own position, else at its nearest positioned
        // enclosing member's (as the recursive walk would).
        int pl = s.line; int pc = s.col;
        List<int> lines; List_init<int>(&lines, 4);
        List<int> cols; List_init<int>(&cols, 4);
        int ln = pl; int cl = pc;
        int cj = 0;
        while (cj < List_len<*ExprNode>(&chain)) {
            *ExprNode mj = List_get<*ExprNode>(&chain, cj);
            if (cj > 0 && mj.line > 0) { ln = mj.line; cl = mj.col; }
            List_push<int>(&lines, ln); List_push<int>(&cols, cl);
            cj = cj + 1;
        }
        s.line = ln; s.col = cl;
        sema_expr(s, base);                // walk base (catches undefined vars in it)
        string bt = sema_infer_type(s, base);
        int ci = List_len<*ExprNode>(&chain) - 1;
        *ExprNode mbase = base;            // the base of the member being checked
        while (ci >= 0) {
            *ExprNode m = List_get<*ExprNode>(&chain, ci);
            s.line = List_get<int>(&lines, ci); s.col = List_get<int>(&cols, ci);
            if (bt[0] == 63) {             // a `?…` nullable pointer base (sema_check_nullable_deref)
                s.had_error = 1;
                int bl = s.line; int bc = s.col;   // at the base pointer (as the C++ checker)
                if (mbase != null && mbase.line > 0) { bl = mbase.line; bc = mbase.col; }
                dprintf(2, "error: %s:%d:%d: cannot %s a possibly-null pointer of type '%s'; check it first (e.g. `if (x != null)`)\n",
                       s.filename, bl, bc, "access a member of", bt);
            }
            mbase = m;
            // Only a struct or union (or a pointer to one) has members; a slice has `len`.
            string mbc = sema_canon(s, bt);
            if ((int)mbc[0] == 42) { mbc = sema_sub_str(mbc, 1, sema_slen(mbc)); }
            if (sema_judgeable(s, mbc) == 1 && sema_is_struct(s, sema_base_name(mbc)) == 0
                && (sema_slice_elem(mbc)[0] == 0 || sema_streq(m.sval, "len") == 0)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot access member '%s' on non-struct type '%s'\n", s.filename, s.line, s.col, m.sval, bt);
            }
            int btn = 0; while (bt[btn] != 0) { btn = btn + 1; }
            // An array/slice base (`Box<int>[]`) is not its element struct (`s.len`).
            if (bt[0] != 0 && (int)bt[btn - 1] != 93) {   // base type known → validate the member
                string sn = sema_struct_of_type(bt);
                if (sema_is_struct(s, sn) == 1 && (sema_has_member(s, sema_cat(sema_cat(sn, "."), m.sval)) == 0
                                                   || sema_field_type(s, sn, m.sval) == null)) {
                    s.had_error = 1;               // (a method is only called, never a value)
                    dprintf(2, "error: %s:%d:%d: struct '%s' has no member '%s'\n", s.filename, s.line, s.col, sn, m.sval);
                }
            }
            bt = sema_dealias(s, sema_member_type(s, bt, m.sval));
            ci = ci - 1;
        }
        s.line = pl; s.col = pc;
        List_free<*ExprNode>(&chain); List_free<int>(&lines); List_free<int>(&cols);
        return;
    }
    if (k == EK_QUESTION) {            // `expr?` propagates an Err into the enclosing function
        if (s.fin_depth > 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: '?' is not allowed inside a finally block (it would return from the function)\n", s.filename, s.line, s.col);
        }
        sema_expr(s, e.a);
        // The enclosing function must return the SAME Result-like type as the operand
        // (a struct with `ok`/`value` fields; the type name, not a literal "Result"). The
        // self-host tracks struct names but not fields, so it compares the struct names and
        // skips when either is unknown (matching C++'s ret == operand-type check).
        string qt = sema_infer_type(s, e.a);
        string opn = sema_struct_of_type(qt);
        string retn = sema_struct_of_type(s.cur_ret);
        if (qt[0] != 0) {                  // the operand must be Result-like (`ok` + `value` fields)
            *DeclNode qd = sema_find_struct(s, opn);
            int okf = 0; int valf = 0; string okty = "";
            if (qd != null && sema_has_star(qt) == 0) {
                int qi = 0; int qn = List_len<Param>(&qd.params);
                while (qi < qn) {
                    string fnm = List_get<Param>(&qd.params, qi).name;
                    if (sema_streq(fnm, "ok") == 1) { okf = 1; okty = List_get<Param>(&qd.params, qi).ty; }
                    if (sema_streq(fnm, "value") == 1) { valf = 1; }
                    qi = qi + 1;
                }
            }
            if ((okf == 0 || valf == 0) && (qd != null || sema_is_numeric_ty(qt) == 1 || sema_is_ptrish(qt) == 1)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: `?` operator requires a Result-like value (with `ok` and `value` fields), got %s\n", s.filename, s.line, s.col, qt);
            } else if (okf == 1 && valf == 1) {
                // `?` tests `ok` as a flag (zero is the error): an integer or a bool.
                if (List_len<TypeParam>(&qd.type_params) > 0) {
                    List<string> qtargs; List_init<string>(&qtargs, 2);
                    sema_parse_targs(qt, &qtargs);
                    okty = sema_subst_params(okty, &qd.type_params, &qtargs);
                }
                string okc = sema_canon(s, okty);
                if (sema_judgeable(s, okc) == 1 && sema_is_int_ty(okc) == 0 && sema_streq(okc, "bool") == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: `?` needs an integer or bool `ok` field, got '%s'\n", s.filename, s.line, s.col, okty);
                }
            }
        }
        // Same base name but different type args (`Result<int,string>` in a function
        // returning `Result<int64,string>`) is also a mismatch: compare the full spellings.
        string opt = sema_nospace(sema_infer_type(s, e.a));
        string rett = sema_nospace(s.cur_ret);
        int mismatch = 0;
        if (opn[0] != 0 && retn[0] != 0 && sema_streq(opn, retn) == 0) { mismatch = 1; }
        if (mismatch == 0 && opn[0] != 0 && retn[0] != 0 && sema_has_lt(opt) == 1 && sema_has_lt(rett) == 1
            && sema_streq(opt, rett) == 0) { mismatch = 1; }
        if (mismatch == 1) {
            sema_error(s, "`?` can only be used in a function returning the same Result type");
        }
        return;
    }
    if ((k == EK_FREECLOSURE || k == EK_THREADCREATE) && e.a != null) {
        // free_closure takes a closure; thread_create a `fn()->void` one (mirrors the C++).
        string ct = sema_infer_type(s, e.a);
        if (ct[0] != 0) {
            string cc = sema_canon(s, ct);
            if (k == EK_FREECLOSURE && sema_is_fn_type(cc) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: free_closure expects a closure (fn(...)->R), got %s\n", s.filename, s.line, s.col, ct);
            }
            if (k == EK_THREADCREATE && sema_streq(cc, "fn()->void") == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: thread_create expects a closure 'fn()->void', got '%s'\n", s.filename, s.line, s.col, ct);
            }
        }
    }
    if (k == EK_UNARY || k == EK_CAST
        || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        if (k == EK_UNARY && sema_streq(e.sval, "*") == 1) {
            sema_check_nullable_deref(s, e.a, "dereference");
            // A `*void` points at no type: there is nothing to read or write through it.
            string dt = sema_infer_type(s, e.a);
            if (dt[0] != 0 && sema_streq(sema_strip_nullable(sema_canon(s, dt)), "*void") == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot dereference '%s': it points to 'void' (cast it to a typed pointer first)\n", s.filename, s.line, s.col, dt);
            }
        }
        if (k == EK_UNARY && e.a != null && sema_streq(e.sval, "&") == 0) {
            // The built-in operand rules (mirrors the C++ inferUnaryExprType): `-`/`+` take a
            // number, `~` an integer, `*` a pointer, `!` anything but a struct; `-`, `~` and
            // `!` otherwise go through a user operator overload.
            string ut = sema_strip_nullable(sema_infer_type(s, e.a));
            string uc = sema_canon(s, ut);
            if (sema_judgeable(s, uc) == 1) {
                int ok = 1;
                if (sema_streq(e.sval, "-") == 1 || sema_streq(e.sval, "+") == 1) { ok = sema_is_numeric_ty(uc); }
                else if (sema_streq(e.sval, "~") == 1) { ok = sema_is_int_ty(uc); }
                else if (sema_streq(e.sval, "*") == 1) { ok = sema_c_ptr(uc); }
                else if (sema_streq(e.sval, "!") == 1 && ((sema_is_aggregate(s, ut) == 1 && sema_is_iface_val(s, ut) == 0) || sema_is_void_value(uc) == 1)) { ok = 0; }
                if (ok == 0 && sema_streq(e.sval, "*") == 0 && sema_streq(e.sval, "+") == 0) {
                    string uop = e.sval; if (sema_streq(uop, "-") == 1) { uop = "u-"; }
                    List<string> utys; List_init<string>(&utys, 1); List_push<string>(&utys, ut);
                    if (sema_find_op(s, uop, &utys) != null) { ok = 1; }
                }
                if (ok == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: invalid operand for unary operator: %s\n", s.filename, s.line, s.col, ut);
                }
            }
        }
        if (k == EK_UNARY && sema_streq(e.sval, "&") == 1 && sema_is_lvalue(s, e.a) == 0) {
            sema_error(s, "cannot take the address of this expression: it is not a variable, field, element, or dereference");
        }
        if (k == EK_UNARY && sema_streq(e.sval, "&") == 1) { sema_check_captured_address(s, e.a); }
        if (k == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_MEMBER) {
            *DeclNode bsd = sema_find_struct(s, sema_struct_of_type(sema_infer_type(s, e.a.a)));
            if (bsd != null) {
                int bi = 0; int bn = List_len<Param>(&bsd.params);
                while (bi < bn) {
                    if (sema_streq(List_get<Param>(&bsd.params, bi).name, e.a.sval) == 1 && bi < List_len<int>(&bsd.field_bits)
                        && List_get<int>(&bsd.field_bits, bi) > 0) {
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: cannot take the address of bitfield '%s'\n", s.filename, s.line, s.col, e.a.sval);
                    }
                    bi = bi + 1;
                }
            }
        }
        if (k == EK_CAST) {
            // Scalars convert (numbers, pointers, integer<->pointer); an aggregate casts only
            // to its own type; float<->pointer has no meaning. Unknown sides are not judged.
            string cfrom = sema_infer_type(s, e.a);
            string cto = sema_isub(s, e.sval);   // the target in a generic instance (`(T)0`, T = S)
            int fc = sema_cast_class(s, cfrom);
            int tc = sema_cast_class(s, cto);
            int fn_name = 0;
            if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0 && sema_find_fndecl(s, e.a.sval) != null) { fn_name = 1; }
            int bad = 0;
            if (fc != 0 && tc != 0 && sema_streq(sema_strip_const(cfrom), sema_strip_const(cto)) == 0 && fn_name == 0) {
                if (fc == 3 || tc == 3) { bad = 1; }
                if ((fc == 2 && tc == 1 && sema_is_float_ty(cto) == 1) || (fc == 1 && tc == 2 && sema_is_float_ty(cfrom) == 1)) { bad = 1; }
            }
            // A top-level function name casts only to a pointer (its raw C address).
            if (fn_name == 1 && tc != 0 && tc != 2 && sema_streq(sema_strip_const(cfrom), sema_strip_const(cto)) == 0) { bad = 1; }
            // A void value converts to nothing but `void`, and a `{...}` literal is only an
            // initializer (mirrors the C++ visit(CastExpr)).
            if (sema_is_void_value(cto) == 0) {
                if (cfrom[0] != 0 && sema_is_void_value(cfrom) == 1) { bad = 1; }
                if (e.a != null && e.a.kind == EK_ARRAYLIT) { bad = 1; cfrom = "array-literal"; }
            }
            if (bad == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot cast '%s' to '%s'\n", s.filename, s.line, s.col, cfrom, e.sval);
            }
            // A floating constant cast to an integer type must fit it (mirrors the C++).
            *ExprNode fsrc = e.a;
            int fneg = 0;
            if (fsrc != null && fsrc.kind == EK_UNARY && sema_streq(fsrc.sval, "-") == 1) { fneg = 1; fsrc = fsrc.a; }
            string tt = sema_strip_const(sema_resolve_scalar(s, sema_isub(s, e.sval)));
            int f_int = 1; int64 fiv = (int64)0; double fv = 0.0;
            if (bad == 0 && sema_is_int_ty(tt) == 1 && sema_streq(tt, "bool") == 0
                && sema_fold_num(s, e.a, &f_int, &fiv, &fv) == 1 && f_int == 0 && sema_float_fits_int(fv, tt) == 0) {
                s.had_error = 1;
                if (fsrc != null && fsrc.kind == EK_LITERAL && fsrc.lit_kind == LIT_FLOAT) {
                    string sign = "";
                    if (fneg == 1) { sign = "-"; }
                    dprintf(2, "error: %s:%d:%d: floating constant %s%s is out of range for '%s'\n", s.filename, s.line, s.col, sign, fsrc.sval, e.sval);
                } else {
                    dprintf(2, "error: %s:%d:%d: floating constant expression (value %g) is out of range for '%s'\n", s.filename, s.line, s.col, fv, e.sval);
                }
            }
        }
        // `&p` of a narrowed `?*T` may be written through (storing null): narrowing ends.
        if (k == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
            sema_mark_addr(s, e.a.sval);
            string ak = sema_nkey(s, e.a.sval);
            if (ak[0] != 0) { sema_narrow_drop(s, ak); }
        }
        sema_expr(s, e.a);
        return;
    }
    if (k == EK_ALLOCWITH && e.a != null && e.b != null) {
        // The count is an integer; the allocator's type names its alloc method,
        // `<Type>_alloc` (mirrors the C++ visit(AllocWithExpr)).
        string awc = sema_infer_type(s, e.b);
        if (awc[0] != 0 && sema_is_int_ty(sema_canon(s, awc)) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: alloc_with count must be integer, got %s\n", s.filename, s.line, s.col, awc);
        }
        // The element type needs a size: a known, non-void type.
        if (sema_known_type(s, e.sval) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: unknown type '%s'\n", s.filename, s.line, s.col, sema_base_name(sema_struct_of_type(e.sval)));
        } else if (sema_is_void_value(sema_resolve_scalar(s, sema_isub(s, e.sval))) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: alloc_with of 'void': a void element has no size\n", s.filename, s.line, s.col);
        }
        // The allocator is passed as `self`, so it must be a pointer to the allocator; its type
        // names its alloc method, `*void <Type>_alloc(*<Type> self, int64 size)`.
        string awa = sema_infer_type(s, e.a);
        if (awa[0] != 0) {
            string araw = sema_strip_nullable(sema_canon(s, awa));
            string ab = araw;
            int a0 = 0; while ((int)ab[a0] == 42) { a0 = a0 + 1; }
            int a1 = sema_slen(ab); while (a1 > a0 && (int)ab[a1 - 1] == 42) { a1 = a1 - 1; }
            ab = sema_sub_str(ab, a0, a1);
            // A generic instance (`G<int>`) names its alloc function by the instance's flat
            // name (`G_int_alloc`), as the C++ mangling spells it.
            string afn = sema_cat(sema_flat_name(ab), "_alloc");
            int has = 0;
            *DeclNode afd = null;       // the alloc function (null: an inline method)
            int ashape = 1;
            if (sema_find_fn(s, afn) >= 0) {
                has = 1;
                afd = sema_find_fndecl(s, afn);
                if (afd != null) {
                    if (List_len<Param>(&afd.params) != 2) { ashape = 0; }
                    else {
                        string sp = sema_canon(s, List_get<Param>(&afd.params, 0).ty);
                        if (sema_has_star(sp) == 0 || sema_streq(sema_strip_const(sema_pointee(sp)), ab) == 0) { ashape = 0; }
                        if (sema_is_int_ty(sema_canon(s, List_get<Param>(&afd.params, 1).ty)) == 0) { ashape = 0; }
                    }
                    if (sema_has_star(sema_canon(s, afd.ret_type)) == 0) { ashape = 0; }
                }
            }
            *DeclNode asd = sema_find_struct(s, sema_base_name(ab));   // or an inline `alloc` method
            if (asd != null) {
                int mi = 0;
                while (mi < List_len<*DeclNode>(&asd.methods)) {
                    *DeclNode am = List_get<*DeclNode>(&asd.methods, mi);
                    if (sema_streq(am.name, "alloc") == 1) {
                        has = 1;
                        if (List_len<Param>(&am.params) != 1 || sema_is_int_ty(sema_canon(s, List_get<Param>(&am.params, 0).ty)) == 0
                            || sema_has_star(sema_canon(s, am.ret_type)) == 0) { ashape = 0; }
                    }
                    mi = mi + 1;
                }
            }
            if (sema_has_star(araw) == 0 || sema_has_star(sema_pointee(araw)) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: alloc_with: the allocator must be a pointer to it, got '%s' (pass its address, as in alloc_with(&a, T, n))\n", s.filename, s.line, s.col, sema_strip_const(awa));
            } else if (has == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: alloc_with: allocator type '%s' has no alloc method (%s)\n", s.filename, s.line, s.col, ab, afn);
            } else if (ashape == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: alloc_with: '%s' must have the shape '*void %s(*%s self, int64 size)'\n", s.filename, s.line, s.col, afn, afn, ab);
            }
        }
    }
    if (k == EK_INDEX || k == EK_ALLOCWITH) {
        // Constant slice bounds `a[lo..hi]`: 0 <= lo <= hi on any base, and <= N into a fixed array.
        // Constant indices and bounds (a literal, an enum member, a `const`, or an
        // expression over them) into a fixed array are checked (mirrors the C++ IndexExpr).
        if (k == EK_INDEX && List_len<*ExprNode>(&e.kids) > 0) {
            *ExprNode hiE = List_get<*ExprNode>(&e.kids, 0);
            string abt = sema_infer_type(s, e.a);
            // A slice of a fixed array refers to the array's storage (a string or pointer base does not).
            string sbc = sema_canon(s, sema_strip_nullable(abt));
            int sbr = sema_arr_bracket(sbc); int sbn = sema_slen(sbc);
            if (sbr > 0 && (int)sbc[sbr + 1] != 93 && (int)sbc[0] != 42 && (int)sbc[sbn - 1] != 42) {
                sema_check_captured_address(s, e.a);
            }
            int64 lo = (int64)0; int64 hi = (int64)0;
            int lo_ok = sema_fold_int(s, e.b, &lo);
            int hi_ok = sema_fold_int(s, hiE, &hi);
            if (sema_is_arr_ty(abt) == 1 && sema_is_readonly_lvalue(s, e.a) == 1) {
                s.had_error = 1;             // a slice lets its elements be written
                dprintf(2, "error: %s:%d:%d: cannot slice read-only array: a slice allows writing its elements\n", s.filename, s.line, s.col);
            } else if (sema_is_arr_ty(abt) == 1 && sbr > 0 && (int)sbc[sbr + 1] != 93 && (int)sbc[0] != 42 && (int)sbc[sbn - 1] != 42
                       && sema_is_lvalue(s, e.a) == 0) {
                sema_error(s, "cannot slice a temporary array: store it in a variable first");
            }
            {
                int64 dv = (int64)-1;   // lo <= hi on any base; the dimension only for a fixed array
                if (sema_is_arr_ty(abt) == 1) { dv = sema_dim_value(s, sema_arr_count(abt)); }
                if ((lo_ok == 1 && lo < (int64)0) || (hi_ok == 1 && hi < (int64)0)) {
                    sema_error(s, "slice bound is negative");
                } else if (lo_ok == 1 && hi_ok == 1 && lo > hi) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: slice bounds out of order: %lld..%lld\n", s.filename, s.line, s.col, lo, hi);
                } else if (dv >= (int64)0 && hi_ok == 1 && hi > dv) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: slice bound %lld is out of bounds for array of size %lld\n", s.filename, s.line, s.col, hi, dv);
                } else if (dv >= (int64)0 && lo_ok == 1 && lo > dv) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: slice bound %lld is out of bounds for array of size %lld\n", s.filename, s.line, s.col, lo, dv);
                }
            }
            sema_expr(s, hiE);
        }
        // The index (and a slice's upper bound) must be an integer.
        if (k == EK_INDEX && e.b != null) {
            string ixt = sema_infer_type(s, e.b);
            string ixc = sema_canon(s, ixt);
            if (sema_judgeable(s, ixc) == 1 && sema_is_int_ty(ixc) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: array index must be integer, got %s\n", s.filename, s.line, s.col, ixt);
            }
            if (List_len<*ExprNode>(&e.kids) > 0) {
                string hxt = sema_infer_type(s, List_get<*ExprNode>(&e.kids, 0));
                string hxc = sema_canon(s, hxt);
                if (sema_judgeable(s, hxc) == 1 && sema_is_int_ty(hxc) == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: slice bound must be integer, got %s\n", s.filename, s.line, s.col, hxt);
                }
            }
        }
        // Constant-index bounds check on a fixed array (the index folds like a case label).
        if (k == EK_INDEX && List_len<*ExprNode>(&e.kids) == 0 && e.b != null) {
            string bt = sema_canon(s, sema_infer_type(s, e.a));
            int64 idx = (int64)0;
            if (sema_is_arr_ty(bt) == 1 && sema_fold_int(s, e.b, &idx) == 1) {
                int64 dim = sema_dim_value(s, sema_arr_count(bt));
                if (idx < (int64)0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: array index %lld is out of bounds\n", s.filename, s.line, s.col, idx);
                } else if (dim >= (int64)0 && idx >= dim) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: array index %lld is out of bounds for array of size %lld\n", s.filename, s.line, s.col, idx, dim);
                }
            }
        }
        sema_check_nullable_deref(s, e.a, "index");
        if (k == EK_INDEX) {                            // only arrays, slices, pointers, strings index
            string ibt = sema_infer_type(s, e.a);
            int icls = sema_cast_class(s, ibt);
            int bad = 0;
            if (icls == 1) { bad = 1; }
            if (sema_streq(ibt, "null") == 1) { bad = 1; }   // `null[0]` points at nothing
            if (icls == 3 && sema_is_arr_ty(ibt) == 0 && sema_is_fn_type(ibt) == 0) {
                // a struct value: only through a user `operator []`
                List<string> oty; List_init<string>(&oty, 2);
                List_push<string>(&oty, ibt); List_push<string>(&oty, "int");
                if (sema_find_fn(s, ast_op_name("[]", &oty)) < 0 && sema_any_index_op(s) == 0) { bad = 1; }
            }
            if (bad == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot index into a value of type '%s'\n", s.filename, s.line, s.col, ibt);
            }
        }
        sema_expr(s, e.a); sema_expr(s, e.b); return;
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_MEMBER) {
        // Method-call syntax `x.m(...)`: `m` is an inline method, a field holding a fn
        // pointer, or a free function `Type_m(self, ...)` (mirrors the C++ method path).
        *ExprNode mem = e.a;
        sema_expr(s, mem.a);
        sema_check_nullable_deref(s, mem.a, "access a member of");
        string bt = sema_infer_type(s, mem.a);
        // A pointer to an alias (`IL*`, `type IL = List<int>`) calls the target's methods.
        if (s.has_alias == 1 && sema_ptr_depth(bt) == 1 && sema_pointee_const(bt) == 0) {
            string bpe = sema_pointee(bt);
            string bpd = sema_dealias(s, bpe);
            if (bpe[0] != 0 && sema_streq(bpd, bpe) == 0) { bt = sema_cat("*", bpd); }
        }
        string sn = sema_struct_of_type(bt);
        // Dot syntax dereferences at most one pointer level.
        if (sema_is_fn_type(bt) == 0) {
            if (sema_ptr_depth(bt) > 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: cannot call method '%s' through '%s': dot syntax dereferences one pointer level (dereference it first)\n",
                       s.filename, s.line, s.col, mem.sval, bt);
                int ai = 0; while (ai < List_len<*ExprNode>(&e.kids)) { sema_expr(s, List_get<*ExprNode>(&e.kids, ai)); ai = ai + 1; }
                return;
            }
        }
        *DeclNode ifc = null;
        if (bt[0] != 0) { ifc = sema_find_iface(s, sn); }
        if (ifc != null) {                                    // interface (vtable) dispatch
            *DeclNode im = null;
            int ii = 0; int inn = List_len<*DeclNode>(&ifc.methods);
            while (ii < inn) { *DeclNode c = List_get<*DeclNode>(&ifc.methods, ii); if (sema_streq(c.name, mem.sval) == 1) { im = c; } ii = ii + 1; }
            if (im == null) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: interface '%s' has no method '%s'\n", s.filename, s.line, s.col, sn, mem.sval);
            } else {
                List<string> ipts; List_init<string>(&ipts, 4);
                int pi = 0; int pn = List_len<Param>(&im.params);
                while (pi < pn) { List_push<string>(&ipts, List_get<Param>(&im.params, pi).ty); pi = pi + 1; }
                sema_check_call_args(s, e, sema_cat(sema_cat("method '", mem.sval), "'"), &ipts);
            }
        }
        if (bt[0] != 0 && sema_is_struct(s, sn) == 1) {
            int inline_m = 0;
            *DeclNode imd = null;
            *DeclNode sd = sema_find_struct(s, sn);
            if (sd != null) {
                int j = 0; int mn = List_len<*DeclNode>(&sd.methods);
                while (j < mn) {
                    *DeclNode cm = List_get<*DeclNode>(&sd.methods, j);
                    if (sema_streq(cm.name, mem.sval) == 1) { inline_m = 1; imd = cm; }
                    j = j + 1;
                }
            }
            *DeclNode ffn = sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), mem.sval));
            // Arguments against the method's parameters (self excluded), with the same
            // count + assignability rules as a bare call (mirrors the C++ method path).
            string mwhat = sema_cat(sema_cat("method '", mem.sval), "'");
            if (imd != null) {
                List<string> mpts; List_init<string>(&mpts, 4);
                List<string> rtargs; List_init<string>(&rtargs, 2);
                sema_parse_targs(sema_strip_ptr_sp(bt), &rtargs);
                int mpi = 0; int mpn = List_len<Param>(&imd.params);
                while (mpi < mpn) {
                    List_push<string>(&mpts, sema_subst_params(List_get<Param>(&imd.params, mpi).ty, &sd.type_params, &rtargs));
                    mpi = mpi + 1;
                }
                sema_check_call_args(s, e, mwhat, &mpts);
                // A generic struct instance's method body is checked per instance, once called.
                if (List_len<TypeParam>(&sd.type_params) > 0 && List_len<string>(&rtargs) == List_len<TypeParam>(&sd.type_params)) {
                    sema_queue_inst(s, imd, sd, &rtargs, sd.name, sema_cat(".", mem.sval));
                }
            } else if (ffn != null && List_len<TypeParam>(&ffn.type_params) == 0
                       && (List_len<Param>(&ffn.params) == 0 || sema_has_star(sema_dealias(s, List_get<Param>(&ffn.params, 0).ty)) == 0
                           || sema_streq(sema_self_struct(s, List_get<Param>(&ffn.params, 0).ty), sn) == 0)) {
                // Dot syntax passes the receiver's address: the first parameter must be a
                // pointer to the receiver's type (mirrors the C++ method path).
                string fp0 = "none";
                if (List_len<Param>(&ffn.params) > 0) { fp0 = List_get<Param>(&ffn.params, 0).ty; }
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: '%s' cannot be called as method '%s' of '%s': its first parameter must be '*%s self' (it is '%s')\n",
                       s.filename, s.line, s.col, ffn.name, mem.sval, sn, sn, fp0);
            } else if (ffn != null && List_len<TypeParam>(&ffn.type_params) == 0 && List_len<Param>(&ffn.params) > 0) {
                List<string> fpts; List_init<string>(&fpts, 4);
                int fpi = 1; int fpn = List_len<Param>(&ffn.params);
                while (fpi < fpn) { List_push<string>(&fpts, List_get<Param>(&ffn.params, fpi).ty); fpi = fpi + 1; }
                sema_check_call_args(s, e, mwhat, &fpts);
            } else if (ffn != null && List_len<Param>(&ffn.params) > 0) {
                // A generic free function `S_m<T..>(S<T..>* self, ...)` on an instance of S
                // (the `Type_method` convention): the type arguments come from the receiver
                // (then the arguments); check the arguments against the instantiated params.
                List<string> gtargs; List_init<string>(&gtargs, 2);
                if (sema_method_targs(s, ffn, bt, e, &gtargs) == 1) {
                    List<string> gpts; List_init<string>(&gpts, 4);
                    int gpi = 1; int gpn = List_len<Param>(&ffn.params);
                    while (gpi < gpn) {
                        List_push<string>(&gpts, sema_subst_params(List_get<Param>(&ffn.params, gpi).ty, &ffn.type_params, &gtargs));
                        gpi = gpi + 1;
                    }
                    sema_check_call_args(s, e, mwhat, &gpts);
                    sema_queue_inst(s, ffn, null, &gtargs, ffn.name, "");
                }
            }
            int is_field = 0;
            if (inline_m == 0 && sema_has_member(s, sema_cat(sema_cat(sn, "."), mem.sval)) == 1) { is_field = 1; }
            int nonfn_field = 0;                  // `s.v()` on a field that holds no fn pointer
            if (is_field == 1) {
                string fty = sema_field_type(s, sn, mem.sval);
                if (fty != null && sema_is_fn_type(sema_canon(s, fty)) == 0 && sema_judgeable(s, sema_canon(s, fty)) == 1) { nonfn_field = 1; }
            }
            if (inline_m == 0 && ffn == null && (is_field == 0 || nonfn_field == 1)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: undefined method '%s' on type '%s'\n", s.filename, s.line, s.col, mem.sval, sn);
            }
            if (is_field == 1 && sd != null) {                // a field holding a fn pointer: o.cb(args)
                int fi = 0; int nf = List_len<Param>(&sd.params);
                while (fi < nf) {
                    Param fp = List_get<Param>(&sd.params, fi);
                    if (sema_streq(fp.name, mem.sval) == 1 && sema_is_fn_type(fp.ty) == 1) {
                        sema_check_fn_value_call(s, e, sema_cat(sema_cat("'", mem.sval), "'"), fp.ty);
                    }
                    fi = fi + 1;
                }
            }
            // A method with a plain (mutable) `self` may write through it, so it cannot be
            // called on a read-only receiver unless it declares `const T* self`.
            int ro = 0;
            if (sema_has_star(bt) == 1) { ro = sema_pointee_const(bt); }
            else { ro = sema_is_readonly_lvalue(s, mem.a); }
            int self_const = 0;
            if (inline_m == 0 && ffn != null && List_len<Param>(&ffn.params) > 0) {
                self_const = sema_pointee_const(List_get<Param>(&ffn.params, 0).ty);
            }
            if (ro == 1 && is_field == 0) {
                if (self_const == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: cannot call method '%s' on a read-only value: its self may modify it (declare it 'const %s* self' if it does not)\n",
                           s.filename, s.line, s.col, mem.sval, sn);
                }
            } else if (is_field == 0 && self_const == 0 && sema_has_star(bt) == 0
                       && (inline_m == 1 || (ffn != null && List_len<Param>(&ffn.params) > 0
                                             && sema_has_star(sema_dealias(s, List_get<Param>(&ffn.params, 0).ty)) == 1))) {
                // A captured value is read-only in the lambda: a non-const self would get
                // the closure's copy (mirrors the C++ checkCapturedMethodCall).
                string cn = sema_captured_root(s, mem.a);
                if (cn[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: cannot call method '%s' on captured variable '%s': a closure captures it by value, and a non-const self may modify the copy (use a 'const T* self' method, or capture a pointer)\n",
                           s.filename, s.line, s.col, mem.sval, cn);
                }
            }
        }
        // A receiver that is not a struct, union or interface: only a free `Type_m`, or
        // inside a generic instance a constrained call on a scalar primitive (lowered to
        // the free function `m(x, ...)`), can serve the call.
        string rbc = sema_canon(s, bt);
        if (ifc == null && sema_judgeable(s, rbc) == 1 && sema_is_struct(s, sn) == 0) {
            int served = 0;
            if (sema_find_fndecl(s, sema_cat(sema_cat(sn, "_"), mem.sval)) != null) { served = 1; }
            if (s.in_inst == 1 && sema_is_scalar_prim(rbc) == 1) {
                *DeclNode pf = sema_find_fndecl(s, mem.sval);
                if (pf != null && List_len<Param>(&pf.params) > 0) { served = 1; }
            }
            if (served == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: undefined method '%s' on type '%s'\n", s.filename, s.line, s.col, mem.sval, bt);
            }
        }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
        // A generic variant argument takes the parameter's instance (`get(Some(40))`).
        *DeclNode vfd = sema_find_fndecl(s, e.a.sval);
        if (vfd != null && List_len<TypeParam>(&vfd.type_params) == 0) {
            int vi = 0;
            while (vi < List_len<*ExprNode>(&e.kids) && vi < List_len<Param>(&vfd.params)) {
                sema_infer_variant(s, List_get<*ExprNode>(&e.kids, vi), List_get<Param>(&vfd.params, vi).ty);
                vi = vi + 1;
            }
        }
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0
        && sema_find_fndecl(s, e.a.sval) == null && sema_variant_enum(s, e.a.sval) != null) {
        sema_check_variant_args(s, e, e.a.sval, null);
    }
    if (k == EK_CALL && e.a != null && e.a.kind == EK_IDENT && sema_lookup(s, e.a.sval) == 0
        && (sema_streq(e.a.sval, "va_start") == 1 || sema_streq(e.a.sval, "va_end") == 1)) {
        sema_check_va_list_arg(s, e.a.sval, e);
        if (sema_streq(e.a.sval, "va_start") == 1 && s.in_variadic == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'va_start' used in a function with no variadic parameter ('...')\n", s.filename, s.line, s.col);
        }
    }
    if (k == EK_CALL) {
        // arg-count check: only when the callee is a bare global function (not a local
        // fn-pointer var, not an ADT variant, not a generic — those resolve elsewhere).
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
            int fi = sema_find_fn(s, e.a.sval);
            if (fi >= 0) {
                FnSig sig = List_get<FnSig>(&s.fns, fi);
                int argc = List_len<*ExprNode>(&e.kids);
                if (sig.variadic == 1) {
                    if (argc < sig.fixed) {
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: function '%s' expects at least %d arguments, got %d\n",
                               s.filename, s.line, s.col, e.a.sval, sig.fixed, argc);
                    } else { sema_check_variadic_extras(s, e, sig.fixed); }
                } else if (argc != sig.fixed) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: function '%s' expects %d arguments, got %d\n",
                           s.filename, s.line, s.col, e.a.sval, sig.fixed, argc);
                }
                // Argument types against the declared parameter types (conservative).
                *DeclNode cfd = sema_find_fndecl(s, e.a.sval);
                if (cfd != null) {
                    int cext = sema_is_c_extern(s, e.a.sval);
                    int ai = 0;
                    while (ai < argc && ai < sig.fixed) {
                        // A C function's fn-typed parameter is a C function pointer: C can
                        // only call a named top-level function (or get null), never a
                        // closure's environment.
                        *ExprNode cax = List_get<*ExprNode>(&e.kids, ai);
                        if (cext == 1 && sema_is_fn_type_alias(s, List_get<Param>(&cfd.params, ai).ty) == 1) {
                            if (cax.kind == EK_LITERAL && cax.lit_kind == LIT_NULL) { ai = ai + 1; continue; }
                            if (cax.kind != EK_IDENT || sema_local_bound(s, cax.sval) == 1 || sema_find_fn(s, cax.sval) < 0) {
                                s.had_error = 1;
                                dprintf(2, "error: %s:%d:%d: argument %d of extern '%s' is a C function pointer: pass a top-level function by name, not a closure value\n",
                                       s.filename, s.line, s.col, ai + 1, e.a.sval);
                                ai = ai + 1; continue;
                            }
                        }
                        string perr = sema_assign_err(s, List_get<Param>(&cfd.params, ai).ty, List_get<*ExprNode>(&e.kids, ai));
                        if (perr[0] != 0) {
                            s.had_error = 1;
                            dprintf(2, "error: %s:%d:%d: argument %d type mismatch: expected %s, got %s (%s)\n", s.filename, s.line, s.col, ai + 1,
                                   List_get<Param>(&cfd.params, ai).ty, sema_infer_type(s, List_get<*ExprNode>(&e.kids, ai)), perr);
                        }
                        ai = ai + 1;
                    }
                }
            }
        }
        // An inferred generic call `id(1)`: argument count, and arguments bound to the same
        // bare type parameter must agree (`pick(1, "s")`).
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0 && sema_find_fn(s, e.a.sval) < 0) {
            *DeclNode gfd = sema_find_fndecl(s, e.a.sval);
            if (gfd != null && List_len<TypeParam>(&gfd.type_params) > 0) {
                string unb = sema_uninferable_tparam(gfd);
                if (unb[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: cannot infer type argument(s) %s of generic function '%s' from the call; write them explicitly, e.g. %s<...>(...)\n",
                           s.filename, s.line, s.col, unb, gfd.name, gfd.name);
                } else if (sema_check_generic_arity(s, gfd, e) == 1) {
                    int agree = sema_check_generic_binding(s, gfd, e);
                    List<string> btargs; List_init<string>(&btargs, 4);
                    if (sema_bind_targs(s, gfd, e, &btargs) == 1) {
                        if (agree == 1 && sema_check_constraints(s, &gfd.type_params, &btargs) == 1) {
                            // The inferred instance's parameter types must accept every
                            // argument (`swp(&i64, &i32)` against `*T`), as in C++.
                            List<string> ipts; List_init<string>(&ipts, 4);
                            int pi = 0;
                            while (pi < List_len<Param>(&gfd.params)) {
                                List_push<string>(&ipts, sema_subst_params(List_get<Param>(&gfd.params, pi).ty, &gfd.type_params, &btargs));
                                pi = pi + 1;
                            }
                            int before = s.had_error; s.had_error = 0;
                            sema_check_call_args(s, e, sema_cat(sema_cat("function '", gfd.name), "'"), &ipts);
                            int bad = s.had_error;
                            if (before == 1) { s.had_error = 1; }
                            if (bad == 0) { sema_queue_inst(s, gfd, null, &btargs, gfd.name, ""); }
                        }
                    }
                    else if (sema_args_typed(s, e) == 1) {
                        string unbound = "";
                        int ui = 0;
                        while (ui < List_len<string>(&btargs)) {
                            if (List_get<string>(&btargs, ui)[0] == 0) {
                                if (unbound[0] != 0) { unbound = sema_cat(unbound, ", "); }
                                unbound = sema_cat(unbound, List_get<TypeParam>(&gfd.type_params, ui).name);
                            }
                            ui = ui + 1;
                        }
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: cannot infer type argument(s) %s of generic function '%s' from the call; write them explicitly, e.g. %s<...>(...)\n",
                               s.filename, s.line, s.col, unbound, gfd.name, gfd.name);
                    }
                }
            }
        }
        // A call through a fn-typed value: a fn-pointer variable (local or global, not a
        // declared function), or any other callee expression (`mk()(1)`).
        if (e.a != null && e.a.kind == EK_IDENT && (sema_local_bound(s, e.a.sval) == 1 || sema_find_fn(s, e.a.sval) < 0)) {
            string vt = sema_lookup_type(s, e.a.sval);
            string cvt = sema_canon(s, vt);
            if (sema_is_fn_type(vt) == 1) { sema_check_fn_value_call(s, e, sema_cat(sema_cat("'", e.a.sval), "'"), vt); }
            else if (vt[0] != 0 && sema_is_fn_type(cvt) == 0
                     && (sema_is_numeric_ty(sema_strip_const(vt)) == 1 || sema_streq(vt, "string") == 1 || sema_judgeable(s, cvt) == 1)) {
                // a local or a global variable that is not callable (a global used to slip
                // through to codegen, which crashed)
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: undefined function '%s' ('%s' is a variable of type '%s')\n", s.filename, e.a.line, e.a.col, e.a.sval, e.a.sval, vt);
            } else if (vt[0] == 0 && sema_local_bound(s, e.a.sval) == 0 && sema_find_fndecl(s, e.a.sval) == null
                       && sema_plain_member(s, e.a.sval) == 1) {
                s.had_error = 1;                   // a classic enum member is a constant
                dprintf(2, "error: %s:%d:%d: undefined function '%s'\n", s.filename, e.a.line, e.a.col, e.a.sval);
            }
        } else if (e.a != null && e.a.kind != EK_IDENT) {
            string ct = sema_infer_type(s, e.a);
            if (sema_is_fn_type(ct) == 1) { sema_check_fn_value_call(s, e, "the called function value", ct); }
        }
        string prev = s.callee_ctx;        // mark the callee so a watched param here is OK
        if (e.a != null && e.a.kind == EK_IDENT) { s.callee_ctx = e.a.sval; }
        else { s.callee_ctx = ""; }
        sema_expr(s, e.a);                 // callee (functions live in the global scope)
        s.callee_ctx = prev;
        // A watched (non-escaping) closure param passed straight to a non-escaping param
        // of an Eskiu function does not escape: the callee may only call it (mirrors the
        // C++ visit(CallExpr)). A C function's fn-typed param is a C pointer, not this.
        *DeclNode cfd = null;
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) { cfd = sema_find_fndecl(s, e.a.sval); }
        if (cfd != null && cfd.kind != DK_FUNCTION) { cfd = null; }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        // A `?:` argument to an interface parameter of a named function boxes arm by arm.
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
            *DeclNode hfd = sema_find_fndecl(s, e.a.sval);
            int hi = 0;
            while (hfd != null && hi < n && hi < List_len<Param>(&hfd.params)) {
                sema_hint_iface(s, List_get<*ExprNode>(&e.kids, hi), List_get<Param>(&hfd.params, hi).ty);
                hi = hi + 1;
            }
        }
        while (i < n) {
            *ExprNode ka = List_get<*ExprNode>(&e.kids, i);
            int fwd = 0;
            if (cfd != null && ka != null && ka.kind == EK_IDENT && sema_in_list(&s.watched, ka.sval) == 1
                && i < List_len<Param>(&cfd.params)) {
                int pesc = 0;
                if (i < List_len<int>(&cfd.param_escaping)) { pesc = List_get<int>(&cfd.param_escaping, i); }
                if (pesc == 0) { fwd = 1; }
            }
            if (ka != null && ka.kind == EK_LAMBDA && cfd != null && i < List_len<Param>(&cfd.params)) {
                int lesc = 0;
                if (i < List_len<int>(&cfd.param_escaping)) { lesc = List_get<int>(&cfd.param_escaping, i); }
                if (lesc == 0 && s.in_inst == 0) { s.lam_arg_nonesc = 1; }
                if (lesc == 0 && s.in_inst == 0 && cfd.is_async == 0) { s.lam_arg_stack = 1; }
            }
            if (fwd == 1) {
                string pk = s.callee_ctx;
                s.callee_ctx = ka.sval;
                sema_expr(s, ka);
                s.callee_ctx = pk;
            } else {
                sema_expr(s, ka);
            }
            i = i + 1;
        }
        return;
    }
    if (k == EK_STRUCTINIT) {
        // A literal through a type alias (`type LI = Box<int>; LI{v: 3}`) names the aliased
        // struct; the node is rewritten to it so codegen sees the struct itself.
        int ahops = 0;
        while (ahops < 32) {
            *DeclNode ad = sema_find_tdecl(s, e.sval);
            if (ad == null || ad.kind != DK_TYPEALIAS) { ahops = 32; }
            else { e.sval = ad.ret_type; }
            ahops = ahops + 1;
        }
        string base = sema_base_name(e.sval);
        *DeclNode sd0 = sema_find_tdecl(s, base);
        List<string> sitargs; List_init<string>(&sitargs, 2);
        sema_parse_targs(e.sval, &sitargs);
        if (sema_is_type(s, base) == 0 || (sd0 != null && sd0.kind != DK_STRUCT && sd0.kind != DK_UNION)) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: undefined struct '%s'\n", s.filename, s.line, s.col, base);
        } else if (sd0 != null && sd0.kind == DK_STRUCT && List_len<TypeParam>(&sd0.type_params) > 0
                   && List_len<string>(&sitargs) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: generic struct '%s' needs type arguments, as in %s<int>{...}\n", s.filename, s.line, s.col, base, base);
        } else if (sd0 != null && sd0.kind == DK_STRUCT && List_len<TypeParam>(&sd0.type_params) == 0
                   && List_len<string>(&sitargs) > 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: struct '%s' is not generic: write %s{...}\n", s.filename, s.line, s.col, base, base);
        }
        sema_infer_struct_fields(s, e);
        sema_check_struct_init(s, e);
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    if (k == EK_TEMPLATECALL) {        // Name<args>(...) — check bounded-generic constraints
        *DeclNode fd = sema_find_fndecl(s, sema_base_name(e.sval));
        string tbase = sema_base_name(e.sval);
        if (fd == null && sema_streq(tbase, "va_arg") == 1) {
            List<string> vat; List_init<string>(&vat, 1);
            sema_parse_targs(e.sval, &vat);
            sema_check_va_list_arg(s, "va_arg", e);
            if (List_len<string>(&vat) == 1) {
                string vt = List_get<string>(&vat, 0);
                string vc = sema_canon(s, sema_isub(s, vt));
                if (sema_is_aggregate(s, vc) == 1 || sema_is_void_value(vc) == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: 'va_arg' cannot read a '%s': a variadic argument is an integer, a floating-point value or a pointer\n", s.filename, s.line, s.col, vt);
                } else {
                    // The default argument promotions: a float arrives as a double and a
                    // narrow integer as an int (mirrors the C++ va_arg check).
                    string vp = "";
                    if (sema_streq(vc, "float") == 1) { vp = "double"; }
                    if (sema_streq(vc, "bool") == 1 || sema_streq(vc, "char") == 1 || sema_streq(vc, "int8") == 1
                        || sema_streq(vc, "int16") == 1 || sema_streq(vc, "uint8") == 1 || sema_streq(vc, "uint16") == 1) { vp = "int"; }
                    if (vp[0] != 0) {
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: 'va_arg' cannot read a '%s': a variadic '%s' is promoted to '%s'; read va_arg<%s> and convert it\n",
                                s.filename, s.line, s.col, vt, vc, vp, vp);
                    }
                }
            }
        }
        if (fd == null && sema_is_variant_name(s, tbase) == 1) {
            List<string> vtargs; List_init<string>(&vtargs, 2);
            sema_parse_targs(e.sval, &vtargs);
            sema_infer_variant_payload(s, e, tbase, &vtargs);
            sema_check_variant_args(s, e, tbase, &vtargs);
        }
        if (fd == null && sema_streq(tbase, "va_arg") == 0 && sema_is_variant_name(s, tbase) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: undefined template function '%s'\n", s.filename, s.line, s.col, tbase);
        }
        if (fd != null) {
            List<string> targs;
            List_init<string>(&targs, 4);
            sema_parse_targs(e.sval, &targs);
            int tn = List_len<TypeParam>(&fd.type_params);
            int na = List_len<string>(&targs);
            int inst_ok = 1;
            if (tn > 0 && na != tn) {
                s.had_error = 1; inst_ok = 0;
                dprintf(2, "error: %s:%d:%d: generic function '%s' expects %d type argument(s), got %d\n", s.filename, s.line, s.col, fd.name, tn, na);
            }
            if (sema_check_generic_arity(s, fd, e) == 0) { inst_ok = 0; }
            if (na == tn && sema_check_constraints(s, &fd.type_params, &targs) == 0) { inst_ok = 0; }
            if (inst_ok == 1 && tn > 0) {
                // A generic variant argument takes the parameter's instance
                // (`get<int64>(Some(8))`), from the type arguments as written.
                int vai = 0;
                while (vai < List_len<*ExprNode>(&e.kids) && vai < List_len<Param>(&fd.params)) {
                    sema_infer_variant_r(s, List_get<*ExprNode>(&e.kids, vai),
                                         sema_subst_params(List_get<Param>(&fd.params, vai).ty, &fd.type_params, &targs), 1);
                    vai = vai + 1;
                }
                // The arguments against the instantiated parameter types.
                List<string> ctargs; List_init<string>(&ctargs, 4);
                int ci2 = 0;
                while (ci2 < na) { List_push<string>(&ctargs, sema_isub(s, List_get<string>(&targs, ci2))); ci2 = ci2 + 1; }
                int ai = 0; int an = List_len<*ExprNode>(&e.kids);
                while (ai < an && ai < List_len<Param>(&fd.params)) {
                    string pty = sema_subst_params(List_get<Param>(&fd.params, ai).ty, &fd.type_params, &ctargs);
                    if (sema_streq(pty, "...") == 1) { sema_check_variadic_extras(s, e, ai); ai = an; }
                    else {
                        *ExprNode aexp = List_get<*ExprNode>(&e.kids, ai);
                        string aerr = sema_assign_err(s, pty, aexp);
                        if (aerr[0] != 0) {
                            s.had_error = 1;
                            dprintf(2, "error: %s:%d:%d: argument %d: expected %s, got %s (%s)\n", s.filename, s.line, s.col, ai + 1, pty,
                                   sema_infer_type(s, aexp), aerr);
                        }
                        ai = ai + 1;
                    }
                }
                sema_queue_inst(s, fd, null, &targs, fd.name, "");
            }
        }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    // A lambda is its own (non-async) function: its body is checked with its parameters
    // in a fresh scope over the enclosing one (captures, with their null-narrowing), its
    // own return type, and no enclosing loop or switch (mirrors the C++ visit(LambdaExpr)).
    if (k == EK_LAMBDA) {
        sema_check_lambda(s, e);
        // A lambda returning a value must return on every path, like a function. Its
        // signature spelling is "R(T a, ...)".
        int lp = 0; while (e.sval[lp] != 0 && (int)e.sval[lp] != 40) { lp = lp + 1; }
        string lret = sema_trim_sub(e.sval, 0, lp);
        if (e.stmt != null && lret[0] != 0 && sema_streq(sema_strip_const(lret), "void") == 0
            && sema_always_returns(e.stmt) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: missing return in lambda returning '%s' (control can reach the end without returning a value)\n",
                   s.filename, s.line, s.col, lret);
        }
    }
}

// A lambda-bound local `name` read inside enclosing lambdas: each lambda it is outer to
// captures it (mirrors the C++ localCaptures).
void sema_note_local_capture(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) { return; }
    int sd = List_get<Sym>(&s.syms, si).depth;
    int j = 0;
    while (j < List_len<int>(&s.lam_bounds)) {
        if (sd <= List_get<int>(&s.lam_bounds, j)) {
            List_push<*ExprNode>(&s.lcap_lam, List_get<*ExprNode>(&s.lam_nodes, j));
            List_push<string>(&s.lcap_name, name);
        }
        j = j + 1;
    }
}

// Does lambda `l` outlive its creating call? Not when its env is already on the stack, nor
// when it is bound to a local only called outside an async body.
int sema_lam_outlives(Sema* s, *ExprNode l) {
    if (l.stack_env == 1) { return 0; }
    int i = 0;
    while (i < List_len<*ExprNode>(&s.wlam)) {
        if (List_get<*ExprNode>(&s.wlam, i) == l) {
            if (List_get<int>(&s.wlam_async, i) == 1) { return 1; }
            return sema_in_list(&s.wlocals_esc, List_get<string>(&s.wlam_name, i));
        }
        i = i + 1;
    }
    return 1;
}

// At the end of a function: a lambda bound to a local that is only called gets its env on
// the stack. The local escapes when it is used beyond a call or captured by a lambda that
// outlives the call. A local of an async body keeps a heap env: it lives in the frame
// across suspensions, and the async lowering frees it with the frame.
void sema_stack_envs(Sema* s) {
    int changed = 1;
    while (changed == 1) {
        changed = 0;
        int i = 0;
        while (i < List_len<string>(&s.lcap_name)) {
            string nm = List_get<string>(&s.lcap_name, i);
            if (sema_in_list(&s.wlocals_esc, nm) == 0 && sema_lam_outlives(s, List_get<*ExprNode>(&s.lcap_lam, i)) == 1) {
                List_push<string>(&s.wlocals_esc, nm);
                changed = 1;
            }
            i = i + 1;
        }
    }
    int k = 0;
    while (k < List_len<*ExprNode>(&s.wlam)) {
        if (List_get<int>(&s.wlam_async, k) == 0 && sema_in_list(&s.wlocals_esc, List_get<string>(&s.wlam_name, k)) == 0) {
            *ExprNode wl = List_get<*ExprNode>(&s.wlam, k);
            wl.stack_env = 1;
        }
        k = k + 1;
    }
}

// Is `name` (an outer variable) captured by an enclosing lambda that outlives the call?
int sema_captured_by_escaping(Sema* s, string name) {
    int si = sema_sym_index(s, name);
    if (si < 0) { return 0; }
    int sd = List_get<Sym>(&s.syms, si).depth;
    int j = 0;
    while (j < List_len<int>(&s.lam_bounds)) {
        if (sd <= List_get<int>(&s.lam_bounds, j) && List_get<int>(&s.lam_esc, j) == 1) {
            // A lambda bound to a local escapes only if that local is used beyond a call.
            string lo = List_get<string>(&s.lam_local_of, j);
            if (lo[0] == 0) { return 1; }
            List_push<string>(&s.cap_param, name);
            List_push<string>(&s.cap_local, lo);
        }
        j = j + 1;
    }
    return 0;
}

void sema_check_lambda(Sema* s, *ExprNode e) {
    List<string> ptys; List_init<string>(&ptys, 4);
    List<string> pnames; List_init<string>(&pnames, 4);
    sema_lambda_sig(e.sval, &ptys, &pnames);
    string saved_ret = s.cur_ret; int saved_async = s.in_async; int saved_seen = s.await_seen;
    int saved_fin = s.fin_depth; s.fin_depth = 0;
    int saved_sw = s.sw_depth; int saved_pd = s.param_depth; int saved_var = s.in_variadic;
    s.in_variadic = 0;
    List<string> saved_lbls = s.loop_lbls;
    List_init<string>(&s.loop_lbls, 4);
    // The body sees the enclosing null-narrowing; its assignments to captured copies do
    // not end it outside the lambda.
    List<string> saved_narrowed = s.narrowed;
    List_init<string>(&s.narrowed, 4);
    int ni = 0;
    while (ni < List_len<string>(&saved_narrowed)) { List_push<string>(&s.narrowed, List_get<string>(&saved_narrowed, ni)); ni = ni + 1; }
    // The body runs later, when a global (or `static` local) may have been nulled.
    sema_drop_global_keys(&s.narrowed);
    sema_bump(s);
    string saved_ret_raw = s.cur_ret_raw;
    s.cur_ret = sema_isub(s, sema_lambda_ret(e.sval));
    s.cur_ret_raw = sema_lambda_ret(e.sval);
    if (s.lam_ret != null && s.lam_ret[0] != 0) { s.cur_ret = s.lam_ret; s.cur_ret_raw = s.lam_ret; }
    s.lam_ret = "";
    s.in_async = 0; s.sw_depth = 0;
    List_push<int>(&s.lam_bounds, s.depth);
    if (s.lam_arg_nonesc == 1) { List_push<int>(&s.lam_esc, 0); } else { List_push<int>(&s.lam_esc, 1); }
    s.lam_arg_nonesc = 0;
    // An argument to a non-escaping param of a (non-async) function does not outlive the
    // call: its env goes on the stack.
    if (s.lam_arg_stack == 1) { e.stack_env = 1; }
    s.lam_arg_stack = 0;
    List_push<*ExprNode>(&s.lam_nodes, e);
    List_push<string>(&s.lam_local_of, s.lam_local);
    s.lam_local = "";
    sema_push(s);
    List<string> seen; List_init<string>(&seen, 4);
    int i = 0;
    while (i < List_len<string>(&ptys)) {
        string pn = List_get<string>(&pnames, i);
        if (pn[0] != 0) {
            if (sema_in_list(&seen, pn) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: duplicate parameter '%s' in lambda\n", s.filename, s.line, s.col, pn);
            } else { List_push<string>(&seen, pn); }
            sema_define(s, pn, sema_isub(s, List_get<string>(&ptys, i)), 0);
        }
        i = i + 1;
    }
    s.param_depth = s.depth;
    sema_stmt(s, e.stmt);
    sema_pop(s);
    List_remove<int>(&s.lam_bounds, List_len<int>(&s.lam_bounds) - 1);
    List_remove<int>(&s.lam_esc, List_len<int>(&s.lam_esc) - 1);
    List_remove<*ExprNode>(&s.lam_nodes, List_len<*ExprNode>(&s.lam_nodes) - 1);
    List_remove<string>(&s.lam_local_of, List_len<string>(&s.lam_local_of) - 1);
    s.cur_ret = saved_ret; s.cur_ret_raw = saved_ret_raw; s.in_async = saved_async; s.await_seen = saved_seen;
    s.fin_depth = saved_fin;
    s.sw_depth = saved_sw; s.param_depth = saved_pd; s.in_variadic = saved_var;
    s.loop_lbls = saved_lbls;
    s.narrowed = saved_narrowed;
    sema_bump(s);
}

// The `must_use` function whose result `ex`, evaluated for its side effects only, would
// discard: a call (also through a method or an operator overload) or either arm of a `?:`
// (mirrors the C++ discardedMustUse). "" if none.
string sema_discarded_must_use(Sema* s, *ExprNode ex) {
    if (ex == null) { return ""; }
    string fname = "";
    if (ex.kind == EK_CALL && ex.a != null && ex.a.kind == EK_IDENT) {
        fname = ex.a.sval;
    } else if (ex.kind == EK_CALL && ex.a != null && ex.a.kind == EK_MEMBER) {
        // Method-call syntax `x.m()` resolves to the free function `Type_m`.
        string sn = sema_struct_of_type(sema_infer_type(s, ex.a.a));
        if (sn[0] != 0) { fname = sema_cat(sema_cat(sn, "_"), ex.a.sval); }
    } else if (ex.kind == EK_TEMPLATECALL) {
        int j = 0; while (ex.sval[j] != 0 && (int)ex.sval[j] != 60) { j = j + 1; }   // up to '<'
        fname = sema_sub_str(ex.sval, 0, j);
    } else if (ex.kind == EK_TERNARY) {
        string f1 = sema_discarded_must_use(s, ex.b);
        if (f1[0] != 0) { return f1; }
        return sema_discarded_must_use(s, List_get<*ExprNode>(&ex.kids, 0));
    } else if (ex.kind == EK_BINARY && sema_is_assign(ex.sval) == 0 && ex.a != null && ex.b != null) {
        List<string> oty; List_init<string>(&oty, 2);   // an operator overload `a + b`
        List_push<string>(&oty, sema_infer_type(s, ex.a)); List_push<string>(&oty, sema_infer_type(s, ex.b));
        *DeclNode od = sema_find_fndecl(s, ast_op_name(ex.sval, &oty));
        if (od != null) { fname = od.name; if (od.is_mustuse == 1) { return sema_fn_display(od); } }
        return "";
    }
    if (fname[0] != 0 && sema_fn_must_use(s, fname) == 1) { return fname; }
    return "";
}

// The bindings of a match-arm label "Variant(a, b)" into `out` (none without parentheses).
void sema_arm_bindings(string label, List<string>* out) {
    int i = 0; while (label[i] != 0 && (int)label[i] != 40) { i = i + 1; }   // '('
    if (label[i] == 0) { return; }
    int st = i + 1; int j = st;
    while (label[j] != 0 && (int)label[j] != 41) {
        if ((int)label[j] == 44) { string b = sema_trim_sub(label, st, j); if (b[0] != 0) { List_push<string>(out, b); } st = j + 1; }
        j = j + 1;
    }
    string last = sema_trim_sub(label, st, j);
    if (last[0] != 0) { List_push<string>(out, last); }
}

// ── statement walk ──

// A closure captures an enclosing local by value, so an assignment (or `++`/`--`) to one
// inside the lambda would change only its copy: an error (mirrors the C++
// checkCapturedWrite). A global or a `static` local is not captured.
// A field or element of a captured struct/array value (`p.a = 5`, `arr[0] = 9`) is part
// of the copy too; a write through a pointer (`ptr.a`, `*p`, a slice or string element)
// reaches the shared object and is allowed.
// The captured variable whose own storage `t` names (itself, a field or a fixed array
// element of it, not through a pointer) inside a lambda, or "" (mirrors the C++
// capturedRoot).
string sema_captured_root(Sema* s, *ExprNode t) {
    int nb = List_len<int>(&s.lam_bounds);
    if (nb == 0) { return ""; }
    int walking = 1;
    while (walking == 1 && t != null) {
        if (t.kind == EK_MEMBER) {
            string bc = sema_canon(s, sema_strip_nullable(sema_infer_type(s, t.a)));
            if (sema_is_ptrish(bc) == 1) { return ""; }
            t = t.a;
        } else if (t.kind == EK_INDEX) {
            if (List_len<*ExprNode>(&t.kids) > 0) { return ""; }        // a slice a[lo..hi]
            string bc = sema_canon(s, sema_strip_nullable(sema_infer_type(s, t.a)));
            int br = sema_arr_bracket(bc);
            if (br < 0 || (int)bc[br + 1] == 93) { return ""; }          // not a fixed array T[N]
            t = t.a;
        } else { walking = 0; }
    }
    if (t == null || t.kind != EK_IDENT) { return ""; }
    int si = sema_sym_index(s, t.sval);
    if (si < 0) { return ""; }
    Sym sy = List_get<Sym>(&s.syms, si);
    if (sy.depth >= 1 && sy.depth <= List_get<int>(&s.lam_bounds, nb - 1) && sy.is_static == 0) { return t.sval; }
    return "";
}

void sema_check_captured_write(Sema* s, *ExprNode t) {
    string n = sema_captured_root(s, t);
    if (n[0] != 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: cannot assign to captured variable '%s': a closure captures it by value (use a pointer, a global, or a static)\n",
               s.filename, s.line, s.col, n);
    }
}

// `&x` / `x[lo..hi]` of a captured variable's storage: the address is the closure's copy,
// so a write through it is lost (mirrors the C++ checkCapturedAddress).
void sema_check_captured_address(Sema* s, *ExprNode t) {
    string n = sema_captured_root(s, t);
    if (n[0] != 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: cannot take the address of captured variable '%s': a closure captures it by value, so a write through the address is lost (use a pointer, a global, or a static)\n",
               s.filename, s.line, s.col, n);
    }
}

// A loop or `if` condition: a `bool`, a number (`!= 0`) or a pointer, `string` and `?*T`
// included (`!= null`) (mirrors the C++ checkCondition).
void sema_cond(Sema* s, *ExprNode c) {
    sema_expr(s, c);
    if (c == null) { return; }
    string ct = sema_infer_type(s, c);
    string cc = sema_canon(s, ct);
    if (sema_judgeable(s, cc) == 1 && sema_is_numeric_ty(cc) == 0 && sema_c_ptr(cc) == 0 && sema_is_iface_val(s, ct) == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: condition must be boolean, numeric, or a pointer, got %s\n", s.filename, s.line, s.col, ct);
    }
}

// A `?` in a defer body's expression `e` is an early return too (a lambda in the body is
// its own function, so its `?` is fine).
void sema_defer_expr(Sema* s, *ExprNode e) {
    if (e == null || e.kind == EK_LAMBDA) { return; }
    if (e.kind == EK_QUESTION) {
        s.had_error = 1;
        int l = s.line; int c = s.col;
        if (e.line > 0) { l = e.line; c = e.col; }
        dprintf(2, "error: %s:%d:%d: '?' is not allowed inside a defer body (it would return from the function)\n", s.filename, l, c);
    }
    sema_defer_expr(s, e.a);
    sema_defer_expr(s, e.b);
    int i = 0; while (i < List_len<*ExprNode>(&e.kids)) { sema_defer_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
}

// The local (or parameter) whose own storage `e` denotes: a variable, or a field / element
// of a value (not reached through a pointer). "" for anything else, a global, or a static
// (mirrors the C++ localStorageRoot).
string sema_local_root(Sema* s, *ExprNode e) {
    while (e != null) {
        if (e.kind == EK_IDENT) {
            int i = sema_sym_index(s, e.sval);
            if (i < 0) { return ""; }
            Sym sy = List_get<Sym>(&s.syms, i);
            if (sy.depth < 1 || sy.is_static == 1) { return ""; }
            return e.sval;
        }
        if (e.kind == EK_MEMBER) {
            if (sema_has_star(sema_infer_type(s, e.a)) == 1) { return ""; }
            e = e.a;
        } else if (e.kind == EK_INDEX && List_len<*ExprNode>(&e.kids) == 0) {
            if (sema_is_fixed_arr_ty(sema_infer_type(s, e.a)) == 0) { return ""; }
            e = e.a;
        } else { return ""; }
    }
    return "";
}

// A defer body runs during scope-exit cleanup, so it may not transfer control out of
// itself: a `return`, or a `break`/`continue` not enclosed by a loop/switch *within* the
// body, would jump to a target that is gone. `depth` counts loops/switches inside the body.
void sema_defer_walk(Sema* s, *StmtNode st, int depth) {
    if (st == null) { return; }
    int k = st.kind;
    if (k != SK_RETURN) { sema_defer_expr(s, st.expr); sema_defer_expr(s, st.expr2); }
    if (k == SK_RETURN) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: 'return' is not allowed inside a defer body\n", s.filename, st.line, st.col);
        return;
    }
    if (k == SK_BREAK || k == SK_CONTINUE) {
        // Unlabeled break/continue is fine only when a loop is nested inside the defer body
        // (depth > 0). A labeled one always names a loop that could sit outside the defer,
        // so it may never escape, regardless of depth.
        int labeled = 0;
        if (st.label != null && st.label[0] != 0) { labeled = 1; }
        if (depth == 0 || labeled == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'break'/'continue' inside a defer body may not escape it\n", s.filename, st.line, st.col);
        }
        return;
    }
    if (k == SK_BLOCK) {
        int i = 0; int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_defer_walk(s, List_get<*StmtNode>(&st.items, i), depth); i = i + 1; }
        return;
    }
    if (k == SK_IF) { sema_defer_walk(s, st.s1, depth); sema_defer_walk(s, st.s2, depth); return; }
    if (k == SK_WHILE || k == SK_DOWHILE || k == SK_FORIN) { sema_defer_walk(s, st.s1, depth + 1); return; }
    if (k == SK_FOR) { sema_defer_walk(s, st.s1, depth); sema_defer_walk(s, st.s2, depth + 1); return; }   // s1 init, s2 body
    if (k == SK_TRY) {
        sema_defer_walk(s, st.s1, depth);
        int i = 0; while (i < List_len<*StmtNode>(&st.items)) { sema_defer_walk(s, List_get<*StmtNode>(&st.items, i), depth); i = i + 1; }
        sema_defer_walk(s, st.s2, depth);
        return;
    }
    if (k == SK_CATCH || k == SK_ARM) { sema_defer_walk(s, st.s1, depth); return; }
    if (k == SK_MATCH) {
        int i = 0; while (i < List_len<*StmtNode>(&st.items)) { sema_defer_walk(s, List_get<*StmtNode>(&st.items, i), depth); i = i + 1; }
        return;
    }
    if (k == SK_SWITCH) {
        int i = 0; int n = List_len<*StmtNode>(&st.items);
        while (i < n) {
            *StmtNode c = List_get<*StmtNode>(&st.items, i);
            int j = 0; int m = List_len<*StmtNode>(&c.items);
            while (j < m) { sema_defer_walk(s, List_get<*StmtNode>(&c.items, j), depth + 1); j = j + 1; }
            i = i + 1;
        }
        return;
    }
    if (k == SK_DEFER) { sema_defer_walk(s, st.s1, depth); return; }
}

string sema_void_type_err(Sema* s, string t0);   // fwd
// An extended-asm output (`"=r"(y)`, `"+r"(y)`, `"=m"(y)`): the asm writes it, so it must
// be a writable lvalue of a scalar type, an integer other than bool, a float or a pointer
// (mirrors the C++ visit(AsmStmt)).
void sema_asm_output(Sema* s, string c, *ExprNode e) {
    sema_expr(s, e);
    if ((int)c[0] != 61 && (int)c[0] != 43) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: asm output constraint '%s' must start with '=' or '+'\n", s.filename, s.line, s.col, c);
        return;
    }
    if (sema_is_slice_len(s, e) == 1 || sema_is_lvalue(s, e) == 0) {
        sema_error(s, "asm output operand must be an lvalue (a variable, field, element, or dereference)");
        return;
    }
    if (sema_is_readonly_lvalue(s, e) == 1) { sema_error(s, "asm output operand is read-only"); }
    sema_check_captured_write(s, e);
    if (e.kind == EK_MEMBER) {
        *DeclNode bsd = sema_find_struct(s, sema_struct_of_type(sema_infer_type(s, e.a)));
        if (bsd != null) {
            int bi = 0; int bn = List_len<Param>(&bsd.params);
            while (bi < bn) {
                if (sema_streq(List_get<Param>(&bsd.params, bi).name, e.sval) == 1 && bi < List_len<int>(&bsd.field_bits)
                    && List_get<int>(&bsd.field_bits, bi) > 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: asm output operand cannot be a bitfield ('%s')\n", s.filename, s.line, s.col, e.sval);
                }
                bi = bi + 1;
            }
        }
    }
    string t = sema_infer_type(s, e);
    if (t[0] != 0 && sema_streq(t, "unknown") == 0) {
        string c0 = sema_canon(s, sema_strip_nullable(sema_strip_const(t)));
        string cn = sema_strip_const(c0);
        int ok = 0;
        if (sema_is_numeric_ty(cn) == 1 && sema_streq(cn, "bool") == 0) { ok = 1; }
        if (sema_c_ptr(cn) == 1) { ok = 1; }
        int ei = 0;
        while (ei < List_len<EVar>(&s.evars)) {
            EVar ev = List_get<EVar>(&s.evars, ei);
            if (ev.plain == 1 && sema_streq(ev.en, cn) == 1) { ok = 1; }
            ei = ei + 1;
        }
        if (ok == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: asm output operand must have an integer, floating-point or pointer type, got '%s'\n", s.filename, s.line, s.col, t);
        }
    }
    if (e.kind == EK_IDENT) { sema_narrow_kill(s, e.sval); }   // the asm may store null
}

void sema_stmt(Sema* s, *StmtNode st) {
    if (st == null) { return; }
    int pl = s.line; int pc = s.col;
    if (st.line > 0) { s.line = st.line; s.col = st.col; }
    sema_bump(s);
    sema_stmt_k(s, st);
    sema_bump(s);
    s.line = pl; s.col = pc;
}

void sema_stmt_k(Sema* s, *StmtNode st) {
    if (st == null) { return; }
    int k = st.kind;
    if (k == SK_BLOCK) {
        sema_push(s);
        List<string> guard; List_init<string>(&guard, 2);   // early-exit guard narrowings, undone at block end
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) {
            *StmtNode it = List_get<*StmtNode>(&st.items, i);
            sema_stmt(s, it);
            // After `if (p == null) return ...;` the rest of the block runs only when the
            // condition was false (resp. true, when only the else branch exits).
            if (it.kind == SK_IF && it.expr != null) {
                int then_exits = 1 - sema_can_complete(it.s1);
                int else_exits = 0;
                if (it.s2 != null) { else_exits = 1 - sema_can_complete(it.s2); }
                List<string> keys; List_init<string>(&keys, 2);
                // A call on the path that falls through may have assigned a global.
                if (then_exits == 1 && else_exits == 0) {
                    sema_cond_narrow(s, it.expr, 0, &keys);
                    if (s.last_if_else_called == 1) { sema_drop_global_keys(&keys); }
                } else if (else_exits == 1 && then_exits == 0) {
                    sema_cond_narrow(s, it.expr, 1, &keys);
                    if (s.last_if_then_called == 1) { sema_drop_global_keys(&keys); }
                }
                sema_narrow_apply(s, &keys, &guard);
                // The branch that falls through may have assigned the variable.
                if (then_exits == 1 && else_exits == 0) { sema_drop_assigned(s, it.s2); }
                else if (else_exits == 1 && then_exits == 0) { sema_drop_assigned(s, it.s1); }
            }
            i = i + 1;
        }
        sema_narrow_undo(s, &guard);
        sema_pop(s);
        return;
    }
    if (k == SK_VARDECL) {
        string vty = sema_isub(s, st.type);   // a generic instance's `T x` names its argument
        // A lambda initializing a `fn(...)->R` returns R: its body is checked against R
        // (mirrors the C++ reconciliation of the lambda's return type).
        if (st.expr != null && st.expr.kind == EK_LAMBDA && sema_is_fn_type(vty) == 1) { s.lam_ret = sema_fn_ret(vty); }
        int lam_bound = 0;                 // a lambda bound to a local that is only called does not escape
        if (st.expr != null && st.expr.kind == EK_LAMBDA && st.is_static == 0 && s.in_inst == 0) {
            lam_bound = 1;
            s.lam_local = st.name;
        }
        sema_hint_iface(s, st.expr, st.type);
        sema_infer_variant_r(s, st.expr, st.type, 1);
        sema_expr(s, st.expr);             // initializer (can't reference itself)
        s.lam_ret = "";
        s.lam_local = "";
        if (lam_bound == 1) {
            List_push<string>(&s.wlocals, st.name);
            List_push<*ExprNode>(&s.wlam, st.expr); List_push<string>(&s.wlam_name, st.name);
            List_push<int>(&s.wlam_async, s.in_async);
        }
        // A `for (i in A..B)` bound decl takes its bound's integer type (promoted to at
        // least `int`); SK_FOR then widens both decls to their common type.
        int bad_range = 0;
        if (st.is_range == 1) {
            string bt = sema_range_bound_type(s, st.expr);
            if (bt[0] != 0) {
                string rt = ast_range_var_type(bt, "int");
                if (rt[0] == 0) {
                    s.had_error = 1; bad_range = 1;
                    int rl = s.line; int rc = s.col;   // at the bound (as the C++ checker)
                    if (st.expr != null && st.expr.line > 0) { rl = st.expr.line; rc = st.expr.col; }
                    dprintf(2, "error: %s:%d:%d: range bound must be an integer, got '%s'\n", s.filename, rl, rc, bt);
                } else { st.type = rt; vty = rt; }
            }
        }
        if (st.expr != null && st.expr.kind == EK_ARRAYLIT && vty[0] != 0) {
            sema_check_arr_init(s, vty, st.expr);   // too many elements for the fixed size
        }
        if (st.is_static == 1 && st.expr != null && sema_is_const_init(s, st.expr) == 0) {
            sema_error(s, "a 'static' local's initializer must be a constant");
        }
        if (st.is_const == 1 && st.expr == null) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: const '%s' must be initialized\n", s.filename, s.line, s.col, st.name);
        }
        // Initializer type compatibility: the shared assignability rule (mirrors the C++
        // assignabilityError), which knows nothing it cannot judge, so a valid program is
        // never falsely rejected.
        if (st.expr != null && vty[0] != 0 && bad_range == 0) {
            if (st.expr.kind == EK_LAMBDA && sema_is_fn_type(vty) == 1) {
                // A lambda's return type is reconciled to the declared one; its parameters must match.
                List<string> dps; List_init<string>(&dps, 4); sema_fn_params(vty, &dps);
                List<string> lps; List_init<string>(&lps, 4); sema_lambda_params(st.expr.sval, &lps);
                int same = 1;
                if (List_len<string>(&dps) != List_len<string>(&lps)) { same = 0; }
                int pi = 0;
                while (same == 1 && pi < List_len<string>(&dps)) {
                    if (sema_streq(sema_canon(s, List_get<string>(&dps, pi)), sema_canon(s, sema_isub(s, List_get<string>(&lps, pi)))) == 0) { same = 0; }
                    pi = pi + 1;
                }
                if (same == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: initializing '%s': incompatible function type '%s' for '%s'\n", s.filename, s.line, s.col, st.name, st.expr.sval, vty);
                }
            } else {
                string aerr = sema_assign_err(s, vty, st.expr);
                if (aerr[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: initializing '%s': %s\n", s.filename, s.line, s.col, st.name, aerr);
                }
            }
        }
        sema_check_decl_type(s, vty);
        int prev_i = sema_sym_index(s, st.name);    // `let x; let x;` in one scope (an inner block may shadow)
        int dup_d = 0;
        if (s.depth > 0 && prev_i >= 0) {
            int pd = List_get<Sym>(&s.syms, prev_i).depth;
            if (pd == s.depth) { dup_d = 1; }
            // the function's outermost block shares the parameters' scope (C)
            if (pd == s.param_depth && s.depth == s.param_depth + 1) { dup_d = 1; }
        }
        if (dup_d == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: redefinition of '%s' in the same scope\n", s.filename, s.line, s.col, st.name);
        }
        string vterr = sema_void_type_err(s, vty);
        if (vterr[0] != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: variable '%s' %s\n", s.filename, s.line, s.col, st.name, vterr);
        }
        sema_define(s, st.name, vty, st.is_const);
        if (st.is_static == 1) {
            int sti = List_len<Sym>(&s.syms) - 1;
            Sym ss = List_get<Sym>(&s.syms, sti); ss.is_static = 1; List_set<Sym>(&s.syms, sti, ss);
        }
        sema_set_const_init(s, st.expr);
        if (st.is_static == 1) {           // static storage: its address outlives the call
            int sn = List_len<Sym>(&s.syms) - 1;
            Sym ssym = List_get<Sym>(&s.syms, sn); ssym.is_static = 1; List_set<Sym>(&s.syms, sn, ssym);
        }
        return;
    }
    if (k == SK_RETURN) {
        if (s.fin_depth > 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'return' is not allowed inside a finally block\n", s.filename, s.line, s.col);
        }
        sema_hint_iface(s, st.expr, s.cur_ret);
        sema_infer_variant_r(s, st.expr, s.cur_ret_raw, 1);
        sema_expr(s, st.expr);
        if (st.expr != null && sema_streq(s.cur_ret, "void") == 1) {
            string rvt = sema_infer_type(s, st.expr);
            if (rvt[0] != 0 && sema_streq(rvt, "void") == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: return type mismatch: expected void, got %s\n", s.filename, s.line, s.col, rvt);
            }
        } else if (st.expr == null && s.cur_ret[0] != 0 && sema_streq(s.cur_ret, "void") == 0) {
            s.had_error = 1;                           // a bare `return;` in a non-void function
            dprintf(2, "error: %s:%d:%d: return type mismatch: expected %s, got void\n", s.filename, s.line, s.col, s.cur_ret);
        } else if (st.expr != null && s.cur_ret[0] != 0) {
            string rerr = sema_assign_err(s, s.cur_ret, st.expr);
            if (rerr[0] != 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: return type mismatch: expected %s, got %s (%s)\n", s.filename, s.line, s.col, s.cur_ret,
                       sema_infer_type(s, st.expr), rerr);
            }
        }
        // Returning the address of a local or parameter, of a field or element of one, or a
        // slice of a local array yields a dangling pointer (its frame is gone). A `static`
        // local lives on, and a field or element reached through a pointer is elsewhere.
        // The value may reach the return through a pointer cast or either `?:` arm.
        List<*ExprNode> leaves; List_init<*ExprNode>(&leaves, 4);
        if (st.expr != null) { List_push<*ExprNode>(&leaves, st.expr); }
        while (List_len<*ExprNode>(&leaves) > 0) {
            *ExprNode rv = List_get<*ExprNode>(&leaves, List_len<*ExprNode>(&leaves) - 1);
            List_remove<*ExprNode>(&leaves, List_len<*ExprNode>(&leaves) - 1);
            if (rv == null) { continue; }
            if (rv.kind == EK_CAST && sema_is_ptrish(sema_resolve_scalar(s, sema_isub(s, rv.sval))) == 1) {
                List_push<*ExprNode>(&leaves, rv.a);
                continue;
            }
            if (rv.kind == EK_TERNARY) {
                List_push<*ExprNode>(&leaves, List_get<*ExprNode>(&rv.kids, 0));
                List_push<*ExprNode>(&leaves, rv.b);
                continue;
            }
            if (rv.kind == EK_UNARY && sema_streq(rv.sval, "&") == 1) {
                string root = sema_local_root(s, rv.a);
                if (root[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: returning the address of local '%s' (dangling pointer)\n", s.filename, s.line, s.col, root);
                }
            }
            if (rv.kind == EK_INDEX && List_len<*ExprNode>(&rv.kids) > 0
                && sema_is_fixed_arr_ty(sema_infer_type(s, rv.a)) == 1) {
                string root = sema_local_root(s, rv.a);
                if (root[0] != 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: returning a slice of local array '%s' (dangling)\n", s.filename, s.line, s.col, root);
                }
            }
        }
        List_free<*ExprNode>(&leaves);
        return;
    }
    if (k == SK_THROW) {
        sema_expr(s, st.expr);
        if (st.expr != null && sema_is_void_value(sema_infer_type(s, st.expr)) == 1) {
            sema_error(s, "cannot throw a 'void' value");
        }
        return;
    }
    if (k == SK_THREADJOIN) {
        sema_expr(s, st.expr);
        sema_drop_global_narrowings(s);   // the joined thread may have assigned any global
        string jt = sema_infer_type(s, st.expr);
        if (jt[0] != 0 && sema_streq(sema_strip_nullable(sema_canon(s, jt)), "*void") == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: thread_join expects a thread handle ('*void' from thread_create), got '%s'\n", s.filename, s.line, s.col, jt);
        }
        return;
    }
    if (k == SK_EXPR) {
        sema_expr(s, st.expr);
        // A bare call to a must_use function discards its result — reject it.
        string fname = sema_discarded_must_use(s, st.expr);
        if (fname[0] != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: result of '%s' must be used (it is marked must_use)\n", s.filename, s.line, s.col, fname);
        }
        return;
    }
    if (k == SK_IF) {
        // An `else if` chain is checked with a loop (mirrors the C++ visit(IfStmt)); each
        // link's else-narrowings stay in force for the links after it, undone at the end.
        List<string> fins; List_init<string>(&fins, 2);
        int pl = s.line; int pc = s.col;
        int then_start = s.call_epoch; int then_end = s.call_epoch;
        *StmtNode n = st;
        while (n != null) {
            if (n.line > 0) { s.line = n.line; s.col = n.col; }
            sema_cond(s, n.expr);
            // Null-narrowing: `if (q != null)` proves `q` non-null in the then-branch (and
            // `if (q == null)` in the else-branch), so a `?*T` may be dereferenced there.
            List<string> tkeys; List_init<string>(&tkeys, 2);
            List<string> tins; List_init<string>(&tins, 2);
            sema_cond_narrow(s, n.expr, 1, &tkeys);
            sema_narrow_apply(s, &tkeys, &tins);
            if (n == st) { then_start = s.call_epoch; }
            sema_stmt(s, n.s1);
            if (n == st) { then_end = s.call_epoch; }
            sema_narrow_undo(s, &tins);
            List<string> fkeys; List_init<string>(&fkeys, 2);
            sema_cond_narrow(s, n.expr, 0, &fkeys);
            sema_narrow_apply(s, &fkeys, &fins);
            if (n.s2 != null && n.s2.kind == SK_IF) { n = n.s2; }
            else { sema_stmt(s, n.s2); n = null; }
        }
        sema_narrow_undo(s, &fins);
        s.last_if_then_called = 0; s.last_if_else_called = 0;
        if (then_end != then_start) { s.last_if_then_called = 1; }
        if (s.call_epoch != then_end) { s.last_if_else_called = 1; }
        s.line = pl; s.col = pc;
        return;
    }
    if (k == SK_WHILE) {
        // An outer narrowing does not survive an assignment in the loop (later iterations
        // observe it); the condition's own narrowing holds at the top of every iteration.
        sema_drop_assigned(s, st);
        sema_mark_addr_in(s, st.s1);
        sema_cond(s, st.expr);
        List<string> keys; List_init<string>(&keys, 2);
        List<string> ins; List_init<string>(&ins, 2);
        sema_cond_narrow(s, st.expr, 1, &keys);
        sema_narrow_apply(s, &keys, &ins);
        sema_lbl_push(s, st.label); sema_stmt(s, st.s1); sema_lbl_pop(s);
        sema_narrow_undo(s, &ins);
        return;
    }
    if (k == SK_DOWHILE) { sema_drop_assigned(s, st); sema_mark_addr_in(s, st.s1); sema_lbl_push(s, st.label); sema_stmt(s, st.s1); sema_lbl_pop(s); sema_cond(s, st.expr); return; }
    if (k == SK_FOR) {
        sema_push(s);                      // init var stays in scope for cond/step/body
        // The init is wrapped in a BlockStmt; walk its items in the FOR scope rather
        // than via sema_stmt (which would push/pop a sub-scope and drop the loop var).
        if (st.s1 != null && st.s1.kind == SK_BLOCK) {
            int i = 0;
            int n = List_len<*StmtNode>(&st.s1.items);
            while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.s1.items, i)); i = i + 1; }
            // `for (i in A..B)`: the loop variable and the bound share the bounds' common type.
            if (n == 2) {
                *StmtNode rlo = List_get<*StmtNode>(&st.s1.items, 0);
                *StmtNode rhi = List_get<*StmtNode>(&st.s1.items, 1);
                if (rlo.is_range == 1 && rhi.is_range == 1) {
                    string ct = ast_range_var_type(rlo.type, rhi.type);
                    if (ct[0] != 0) {
                        rlo.type = ct; rhi.type = ct;
                        sema_set_sym_type(s, rlo.name, ct);
                        sema_set_sym_type(s, rhi.name, ct);
                    }
                }
            }
        } else {
            sema_stmt(s, st.s1);
        }
        sema_drop_assigned_e(s, st.expr);
        sema_drop_assigned_e(s, st.expr2);
        sema_drop_assigned(s, st.s2);
        sema_mark_addr_in(s, st.s2);
        sema_cond(s, st.expr);
        List<string> keys; List_init<string>(&keys, 2);
        List<string> ins; List_init<string>(&ins, 2);
        sema_cond_narrow(s, st.expr, 1, &keys);
        sema_narrow_apply(s, &keys, &ins);
        sema_lbl_push(s, st.label);
        sema_stmt(s, st.s2);
        sema_lbl_pop(s);
        sema_expr(s, st.expr2);            // the step runs after the body
        string sfn = sema_discarded_must_use(s, st.expr2);   // its value is discarded
        if (sfn[0] != 0) {
            s.had_error = 1;
            int sl = s.line; int sc = s.col;           // at the step (as the C++ checker)
            if (st.expr2.line > 0) { sl = st.expr2.line; sc = st.expr2.col; }
            dprintf(2, "error: %s:%d:%d: result of '%s' must be used (it is marked must_use)\n", s.filename, sl, sc, sfn);
        }
        sema_narrow_undo(s, &ins);
        sema_pop(s);
        return;
    }
    if (k == SK_FORIN) {
        sema_push(s);
        sema_expr(s, st.expr);             // iterable (loop var not yet in scope)
        // Stamp the loop-variable (element) type for the lowering to consume, mirroring the
        // C++ resolvedElemType. Arrays `T[N]` and slices `T[]` resolve from the iterable's
        // type; a list-like container stays "" and is resolved structurally at lowering.
        string itt = sema_infer_type(s, st.expr);
        string elem = "";
        if (sema_is_arr_ty(itt) == 1) { elem = sema_arr_elem(itt); }
        if (s.in_inst == 0) { st.resolved_elem = elem; st.resolved_iter = itt; }
        // Anything but an array, a slice or a List-like struct (`data` + `size` fields)
        // cannot be iterated (mirrors the C++ visit(ForInStmt)).
        string itc = sema_canon(s, itt);
        while ((int)itc[0] == 42) { itc = sema_sub_str(itc, 1, sema_slen(itc)); }   // through a pointer too
        if (sema_judgeable(s, itc) == 1 && sema_arr_bracket(itc) < 0) {
            *DeclNode lsd = sema_find_struct(s, sema_base_name(itc));
            int listy = 0;
            if (lsd != null) {
                int hs = 0; int hd = 0; int fi = 0;
                while (fi < List_len<Param>(&lsd.params)) {
                    string fnm = List_get<Param>(&lsd.params, fi).name;
                    if (sema_streq(fnm, "size") == 1) { hs = 1; }
                    if (sema_streq(fnm, "data") == 1) { hd = 1; }
                    fi = fi + 1;
                }
                if (hs == 1 && hd == 1) { listy = 1; }
            }
            if (listy == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: for-in expects a fixed-size array or a List-like value (with `data` and `size` fields), got %s\n",
                       s.filename, s.line, s.col, itt);
            }
        }
        sema_drop_assigned(s, st.s1);
        sema_mark_addr_in(s, st.s1);
        sema_define(s, st.name, elem, 0);
        sema_lbl_push(s, st.label);
        sema_stmt(s, st.s1);
        sema_lbl_pop(s);
        sema_pop(s);
        return;
    }
    if (k == SK_BREAK || k == SK_CONTINUE) {
        if ((st.label == null || st.label[0] == 0) && List_len<string>(&s.loop_lbls) == 0) {
            if (k == SK_CONTINUE) { sema_error(s, "'continue' outside of a loop"); }
            else if (s.sw_depth == 0) { sema_error(s, "'break' outside of a loop or switch"); }
        }
        if (st.label != null && st.label[0] != 0 && sema_in_list(&s.loop_lbls, st.label) == 0) {
            string kw = "break";
            if (k == SK_CONTINUE) { kw = "continue"; }
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: labeled '%s %s' has no enclosing loop labeled '%s'\n",
                   s.filename, s.line, s.col, kw, st.label, st.label);
        }
        return;
    }
    if (k == SK_SWITCH || k == SK_MATCH) {
        sema_expr(s, st.expr);             // subject
        if (k == SK_SWITCH) {
            // The subject is an integer (a classic enum counts); each case value must
            // convert to it (mirrors the C++ visit(SwitchStmt)).
            string swt = sema_infer_type(s, st.expr);
            string swc = sema_canon(s, swt);
            if (sema_judgeable(s, swc) == 1 && sema_is_int_ty(swc) == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: switch subject must be integer type, got %s\n", s.filename, s.line, s.col, swt);
            }
            int cj = 0;
            while (cj < List_len<*StmtNode>(&st.items)) {
                *StmtNode cc = List_get<*StmtNode>(&st.items, cj);
                if (cc.kind == SK_CASE && cc.expr != null && sema_judgeable(s, swc) == 1) {
                    string cvt = sema_infer_type(s, cc.expr);
                    string cvc = sema_canon(s, cvt);
                    if (sema_judgeable(s, cvc) == 1 && (sema_is_int_ty(swc) == 0 || sema_is_int_ty(cvc) == 0)
                        && sema_assign_strict(s, swt, cvt)[0] != 0) {
                        int sl0 = s.line; int sc0 = s.col;
                        if (cc.expr.line > 0) { s.line = cc.expr.line; s.col = cc.expr.col; }
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: case value type '%s' is incompatible with switch subject type '%s'\n", s.filename, s.line, s.col, cvt, swt);
                        s.line = sl0; s.col = sc0;
                    }
                }
                cj = cj + 1;
            }
            // Duplicate case values: compare folded values (so `7` and `(4 * 2) - 1`
            // collide, as in C); a label that doesn't fold (a `const` name) by its text.
            List<string> seen;
            List_init<string>(&seen, 8);
            List<int64> seen_cv;
            List_init<int64>(&seen_cv, 8);
            int ci = 0;
            int cn = List_len<*StmtNode>(&st.items);
            int defaults = 0;
            while (ci < cn) {
                *StmtNode c = List_get<*StmtNode>(&st.items, ci);
                int sl = s.line; int sc = s.col;       // a case's errors point at its value
                if (c.kind == SK_CASE && c.expr != null && c.expr.line > 0) { s.line = c.expr.line; s.col = c.expr.col; }
                if (c.kind == SK_CASE && c.expr != null && sema_is_const_int(s, c.expr) == 0) {
                    sema_error(s, "switch case value must be a constant integer expression");
                }
                if (c.kind == SK_CASE && c.expr == null) {
                    defaults = defaults + 1;
                    if (defaults == 2) { sema_error(s, "multiple 'default' labels in one switch"); }
                }
                int64 cv = (int64)0;
                int folded = 0;
                if (c.kind == SK_CASE && c.expr != null && sema_fold_int(s, c.expr, &cv) == 1) { folded = 1; }
                // A label the subject's type cannot hold never matches (and, truncated, could
                // collide with another label).
                if (folded == 1 && sema_case_fits(sema_resolve_scalar(s, sema_infer_type(s, st.expr)), cv) == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: case value %lld is out of range for switch subject type '%s'\n",
                           s.filename, s.line, s.col, cv, sema_infer_type(s, st.expr));
                    folded = 0;
                }
                if (folded == 1) {
                    int dj = 0; int dup = 0;
                    while (dj < List_len<int64>(&seen_cv)) { if (List_get<int64>(&seen_cv, dj) == cv) { dup = 1; } dj = dj + 1; }
                    if (dup == 1) { sema_error(s, "duplicate case value in switch"); }
                    else { List_push<int64>(&seen_cv, cv); }
                } else if (c.kind == SK_CASE && c.expr != null && c.expr.kind == EK_IDENT) {
                    string key = c.expr.sval;
                    int found = sema_in_list(&seen, key);
                    if (found == 1) {
                        sema_error(s, "duplicate case value in switch");
                    } else {
                        List_push<string>(&seen, key);
                    }
                }
                s.line = sl; s.col = sc;
                ci = ci + 1;
            }
        }
        if (k == SK_MATCH) {
            // Collect arm variants (label is "Variant(binds)" or "_"), catching dups
            // and noting a `_` wildcard, then check exhaustiveness.
            List<string> seen;
            List_init<string>(&seen, 8);
            List<string> seen_vals;                // values of the arms of a classic enum
            List_init<string>(&seen_vals, 8);
            string mraw = sema_infer_type(s, st.expr);
            string mres = sema_strip_const(mraw);   // through type aliases
            int mh = 0;
            while (mh < 32) {
                *DeclNode mad = sema_find_tdecl(s, sema_base_name(mres));
                if (mad != null && mad.kind == DK_TYPEALIAS && sema_has_star(mres) == 0) { mres = sema_strip_const(mad.ret_type); }
                else { mh = 32; }
                mh = mh + 1;
            }
            string msty = sema_struct_of_type(mres);
            // The subject is an enum value (not a pointer to one, nor a struct).
            *DeclNode mdd = sema_find_tdecl(s, msty);
            int menum = 0;
            if (sema_has_star(mres) == 0 && (int)mres[0] != 63
                && (sema_is_enum(s, msty) == 1 || (mdd != null && mdd.kind == DK_ENUM))) { menum = 1; }
            if (mraw[0] != 0 && menum == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: match subject must be an enum, got %s\n", s.filename, s.line, s.col, mraw);
            }
            int has_wild = 0;
            int ai = 0;
            int an = List_len<*StmtNode>(&st.items);
            while (ai < an) {
                *StmtNode arm = List_get<*StmtNode>(&st.items, ai);
                if (arm.kind == SK_ARM) {
                    string v = sema_base_name(arm.name);
                    if (sema_streq(v, "_") == 1) { has_wild = 1; }
                    *DeclNode med = sema_find_tdecl(s, msty);
                    if (sema_streq(v, "_") == 0 && med != null && med.kind == DK_ENUM) {
                        int vi = sema_variant_index(med, v);
                        if (vi < 0) {
                            s.had_error = 1;
                            dprintf(2, "error: %s:%d:%d: '%s' is not a variant of %s\n", s.filename, s.line, s.col, v, msty);
                        } else {
                            List<string> binds; List_init<string>(&binds, 2);
                            sema_arm_binds(arm.name, &binds);
                            int want = 0;
                            if (vi < List_len<List<string>>(&med.payloads)) {
                                List<string> pl = List_get<List<string>>(&med.payloads, vi);
                                want = List_len<string>(&pl);
                            }
                            if (want != List_len<string>(&binds)) {
                                s.had_error = 1;
                                dprintf(2, "error: %s:%d:%d: variant '%s' binds %d field(s), got %d\n", s.filename, s.line, s.col, v, want, List_len<string>(&binds));
                            }
                        }
                    }
                    // Each binding of `A(x, y)` names a different variable.
                    List<string> binds; List_init<string>(&binds, 2);
                    sema_arm_bindings(arm.name, &binds);
                    List<string> bseen; List_init<string>(&bseen, 2);
                    int bi = 0;
                    while (bi < List_len<string>(&binds)) {
                        string bn = List_get<string>(&binds, bi);
                        if (sema_streq(bn, "_") == 0 && sema_in_list(&bseen, bn) == 1) {
                            s.had_error = 1;
                            dprintf(2, "error: %s:%d:%d: duplicate binding '%s' in match arm '%s'\n", s.filename, s.line, s.col, bn, v);
                        } else { List_push<string>(&bseen, bn); }
                        bi = bi + 1;
                    }
                    int found = sema_in_list(&seen, v);
                    if (found == 1) {
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: duplicate match arm for variant '%s'\n", s.filename, s.line, s.col, v);
                    } else {
                        List_push<string>(&seen, v);
                        // Two members of a classic enum may share a value (legal, as in C),
                        // but a match on the value cannot have two arms for it.
                        EVar mv = sema_find_evar(s, msty, v);
                        if (mv.plain == 1 && mv.val != null) {
                            string prevv = sema_evar_with_val(s, msty, mv.val, &seen, v);
                            if (prevv[0] != 0) {
                                s.had_error = 1;
                                dprintf(2, "error: %s:%d:%d: duplicate match value: '%s' has the same value (%s) as '%s'\n",
                                       s.filename, s.line, s.col, v, mv.val, prevv);
                            }
                            List_push<string>(&seen_vals, mv.val);
                        }
                    }
                }
                ai = ai + 1;
            }
            // Exhaustiveness: without `_`, every variant of the subject's enum must
            // be covered. Skip if the subject type/enum can't be determined.
            if (has_wild == 0) {
                string sty = sema_struct_of_type(sema_infer_type(s, st.expr));
                if (sema_is_enum(s, sty) == 1) {
                    int reported = 0;
                    int ei = 0;
                    int en = List_len<EVar>(&s.evars);
                    while (ei < en) {
                        EVar ev = List_get<EVar>(&s.evars, ei);
                        if (reported == 0 && sema_streq(ev.en, sty) == 1) {
                            int covered = sema_in_list(&seen, ev.variant);
                            if (covered == 0 && ev.plain == 1 && sema_in_list(&seen_vals, ev.val) == 1) { covered = 1; }
                            if (covered == 0) {
                                s.had_error = 1;
                                dprintf(2, "error: %s:%d:%d: non-exhaustive match on '%s': missing '%s'\n",
                                       s.filename, s.line, s.col, sty, ev.variant);
                                reported = 1;
                            }
                        }
                        ei = ei + 1;
                    }
                }
            }
        }
        if (k == SK_SWITCH) { s.sw_depth = s.sw_depth + 1; sema_push(s); }   // one scope (C)
        string saved_mty = s.match_ty;
        if (k == SK_MATCH) { s.match_ty = sema_infer_type(s, st.expr); }
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        s.match_ty = saved_mty;
        if (k == SK_SWITCH) { sema_pop(s); s.sw_depth = s.sw_depth - 1; }
        return;
    }
    if (k == SK_CASE) {
        sema_expr(s, st.expr);             // case value (null for default)
        int i = 0;                         // in the switch's scope: a declaration here is
        int n = List_len<*StmtNode>(&st.items);   // visible in the cases after it
        while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        return;
    }
    if (k == SK_TRY) {
        sema_stmt(s, st.s1);               // body
        int ci = 0;
        while (ci < List_len<*StmtNode>(&st.items)) { sema_stmt(s, List_get<*StmtNode>(&st.items, ci)); ci = ci + 1; }
        s.fin_depth = s.fin_depth + 1;     // a `return` may not leave a finally block
        sema_stmt(s, st.s2);               // finally
        s.fin_depth = s.fin_depth - 1;
        return;
    }
    if (k == SK_DEFER) {
        sema_defer_walk(s, st.s1, 0);      // no return / escaping break|continue in a defer body
        sema_stmt(s, st.s1);               // deferred body
        return;
    }
    if (k == SK_ASM) {
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) {
            *StmtNode op = List_get<*StmtNode>(&st.items, i);
            i = i + 1;
            if (op.kind == SK_ASMOUTPUT) { sema_asm_output(s, op.name, op.expr); continue; }
            if ((int)op.name[0] == 61 || (int)op.name[0] == 43) {   // '=' / '+'
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: asm input constraint '%s' cannot start with '=' or '+'\n", s.filename, s.line, s.col, op.name);
            }
            sema_expr(s, op.expr);
        }
        return;
    }
    if (k == SK_ARM) {
        // A match arm: its payload bindings take the variant's field types (the subject's
        // type arguments substituted), in a scope of their own.
        sema_push(s);
        List<string> binds; List_init<string>(&binds, 2);
        sema_arm_binds(st.name, &binds);
        string v = sema_base_name(st.name);
        string mty = s.match_ty; if (mty == null) { mty = ""; }
        *DeclNode med = sema_find_tdecl(s, sema_struct_of_type(mty));
        List<string> fts; List_init<string>(&fts, 2);
        if (med != null && med.kind == DK_ENUM) {
            int vi = sema_variant_index(med, v);
            List<string> mtargs; List_init<string>(&mtargs, 2);
            sema_parse_targs(sema_strip_ptr_sp(sema_strip_const(mty)), &mtargs);
            if (vi >= 0 && vi < List_len<List<string>>(&med.payloads)
                && List_len<string>(&mtargs) == List_len<TypeParam>(&med.type_params)) {
                List<string> pl = List_get<List<string>>(&med.payloads, vi);
                int pi = 0;
                while (pi < List_len<string>(&pl)) {
                    List_push<string>(&fts, sema_subst_params(List_get<string>(&pl, pi), &med.type_params, &mtargs));
                    pi = pi + 1;
                }
            }
        }
        int bi = 0;
        string ats = "";                   // the binding types, for the async lowering
        while (bi < List_len<string>(&binds)) {
            string bt = "";
            if (bi < List_len<string>(&fts)) { bt = List_get<string>(&fts, bi); }
            sema_define(s, List_get<string>(&binds, bi), bt, 0);
            if (bi > 0) { ats = sema_cat(ats, ";"); }
            ats = sema_cat(ats, bt);
            bi = bi + 1;
        }
        st.arm_types = ats;
        if (s.in_async == 1 && s.in_inst == 1) { st.arm_inst = sema_inst_rec(s, st.arm_inst, ats); }
        sema_stmt(s, st.s1);
        sema_pop(s);
        return;
    }
    if (k == SK_CATCH) {
        // `catch (T name) { ... }`: the body sees `name` of type T.
        sema_push(s);
        int sp = 0; int j = 0;
        while (st.name[j] != 0) { if ((int)st.name[j] == 32) { sp = j; } j = j + 1; }
        if (sp > 0) { sema_define(s, sema_sub_str(st.name, sp + 1, j), sema_sub_str(st.name, 0, sp), 0); }
        sema_stmt(s, st.s1);
        sema_pop(s);
        return;
    }
}

// A variant constructor call `V(args)` (`targs` = explicit type arguments of `V<..>(..)`,
// or null): the argument count must match the payload, and for a non-generic enum (or
// explicit type arguments) each argument must convert to its field type.
void sema_check_variant_args(Sema* s, *ExprNode e, string v, List<string>* targs) {
    *DeclNode ed = sema_variant_enum(s, v);
    if (ed == null) { return; }
    int vi = sema_variant_index(ed, v);
    if (vi < 0 || vi >= List_len<List<string>>(&ed.payloads)) { return; }
    List<string> pl = List_get<List<string>>(&ed.payloads, vi);
    int want = List_len<string>(&pl);
    int got = List_len<*ExprNode>(&e.kids);
    if (want == 0 && targs == null && List_len<TypeParam>(&ed.type_params) == 0 && sema_is_plain_enum_decl(ed) == 0) {
        s.had_error = 1;                   // a nullary variant is written bare: `B`
        dprintf(2, "error: %s:%d:%d: variant '%s' takes no arguments\n", s.filename, s.line, s.col, v);
        return;
    }
    if (want != got) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: variant '%s' expects %d argument(s), got %d\n", s.filename, s.line, s.col, v, want, got);
        return;
    }
    int tn = List_len<TypeParam>(&ed.type_params);
    List<string> subs; List_init<string>(&subs, 2);
    if (targs != null) {
        int ti = 0;
        while (ti < List_len<string>(targs)) { List_push<string>(&subs, sema_isub(s, List_get<string>(targs, ti))); ti = ti + 1; }
    }
    if (tn > 0 && List_len<string>(&subs) != tn) { return; }
    int i = 0;
    while (i < want) {
        string ft = sema_subst_params(List_get<string>(&pl, i), &ed.type_params, &subs);
        string at = sema_infer_type(s, List_get<*ExprNode>(&e.kids, i));
        *ExprNode av = List_get<*ExprNode>(&e.kids, i);
        string fc = sema_canon(s, ft);
        if (sema_assign_strict(s, ft, at)[0] != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: variant '%s' argument %d type mismatch\n", s.filename, s.line, s.col, v, i + 1);
        } else if (sema_is_int_ty(fc) == 1 && av != null && av.kind == EK_LITERAL && av.lit_kind == LIT_INT
                   && sema_int_lit_fits(fc, av.sval) == 0) {
            s.had_error = 1;                   // a literal must fit the payload, as for a function argument
            dprintf(2, "error: %s:%d:%d: variant '%s' argument %d: integer literal %s is out of range for '%s'\n",
                    s.filename, s.line, s.col, v, i + 1, av.sval, ft);
        }
        i = i + 1;
    }
}

// Index of variant `v` among enum `d`'s members, or -1.
int sema_variant_index(*DeclNode d, string v) {
    int i = 0;
    while (i < List_len<Param>(&d.params)) { if (sema_streq(List_get<Param>(&d.params, i).name, v) == 1) { return i; } i = i + 1; }
    return -1;
}

// The payload binding names of a match-arm label "Variant(a, b)" into `out`.
void sema_arm_binds(string label, List<string>* out) {
    int i = 0; while (label[i] != 0 && (int)label[i] != 40) { i = i + 1; }
    if (label[i] == 0) { return; }
    int n = sema_slen(label);
    int close = n - 1; while (close > i && (int)label[close] != 41) { close = close - 1; }
    int start = i + 1; int j = i + 1;
    while (j <= close) {
        if ((int)label[j] == 44 || j == close) {
            string one = sema_trim_sub(label, start, j);
            if (one[0] != 0) { List_push<string>(out, one); }
            start = j + 1;
        }
        j = j + 1;
    }
}

// ── entry ──

// Register top-level names that can be referenced as a bare identifier: functions,
// externs, intrinsics, global vars, and enum members (constants / variant ctors).
// Diagnostics inside `d` name the file it was parsed from (the primary input if unknown).
void sema_enter_decl(Sema* s, *DeclNode d, string primary) {
    s.filename = primary;
    if (d.file != null) { if (d.file[0] != 0) { s.filename = d.file; } }
}

void sema_register_globals(Sema* s, *Program prog) {
    string primary = s.filename;
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        sema_enter_decl(s, d, primary);
        if (d.kind == DK_FUNCTION || d.kind == DK_EXTERN
            || d.kind == DK_INTRINSIC || d.kind == DK_VARDECL) {
            string gty = "";
            if (d.kind == DK_VARDECL) { gty = d.ret_type; }   // global var's type
            sema_define(s, d.name, gty, d.is_const);
            if (d.kind == DK_VARDECL) { sema_set_const_init(s, d.init); }
            // Global array literal must fit the fixed size (locals are checked in SK_VARDECL).
            if (d.kind == DK_VARDECL && d.init != null && d.init.kind == EK_ARRAYLIT
                && d.ret_type != null && d.ret_type[0] != 0) {
                sema_check_arr_init(s, d.ret_type, d.init);
            }
        }
        if (d.kind == DK_FUNCTION || d.kind == DK_EXTERN || d.kind == DK_INTRINSIC) {
            sema_register_fn(s, d);
            List_push<*DeclNode>(&s.fndecls, d);
            if (d.operator_sym != null) { s.has_ops = 1; }
        }
        if (d.kind == DK_INTERFACE) { List_push<*DeclNode>(&s.ifaces, d); }
        if (d.kind == DK_STRUCT || d.kind == DK_UNION || d.kind == DK_INTERFACE
            || d.kind == DK_ENUM || d.kind == DK_TYPEALIAS) {
            List_push<string>(&s.types, d.name);
            List_push<*DeclNode>(&s.tdecls, d);
            if (d.kind == DK_TYPEALIAS) { s.has_alias = 1; }
        }
        if (d.kind == DK_STRUCT || d.kind == DK_UNION) {
            List_push<string>(&s.structs, d.name);
            List_push<*DeclNode>(&s.sdecls, d);
            int fi = 0;                                       // fields are valid members
            int fn2 = List_len<Param>(&d.params);
            while (fi < fn2) {
                List_push<string>(&s.members, sema_cat(sema_cat(d.name, "."), List_get<Param>(&d.params, fi).name));
                fi = fi + 1;
            }
            int mi = 0;                                       // methods are valid members too
            int mn = List_len<*DeclNode>(&d.methods);
            while (mi < mn) {
                List_push<string>(&s.members, sema_cat(sema_cat(d.name, "."), List_get<*DeclNode>(&d.methods, mi).name));
                mi = mi + 1;
            }
        }
        if (d.kind == DK_ENUM) {
            List_push<string>(&s.enums, d.name);
            int j = 0;
            int m = List_len<Param>(&d.params);
            while (j < m) {
                string vn = List_get<Param>(&d.params, j).name;
                sema_define(s, vn, "", 0);
                let ev: EVar; ev.en = d.name; ev.variant = vn;
                ev.val = List_get<Param>(&d.params, j).ty;
                ev.plain = 1;
                if (List_len<TypeParam>(&d.type_params) > 0) { ev.plain = 0; }
                int pj = 0;
                while (pj < List_len<List<string>>(&d.payloads)) {
                    List<string> ppl = List_get<List<string>>(&d.payloads, pj);
                    if (List_len<string>(&ppl) > 0) { ev.plain = 0; }
                    pj = pj + 1;
                }
                List_push<EVar>(&s.evars, ev);
                j = j + 1;
            }
            if (sema_is_plain_enum_decl(d) == 1) { sema_fold_enum(s, d, 0); }   // provisional: later decls unseen
        }
        i = i + 1;
    }
    s.filename = primary;
}

// ── Definite-return analysis (mirrors sema/typecheck_decl.cpp) ───────────────
// A non-void function must return, throw, or provably diverge on every path;
// falling off the end is an error, not an implicit zero return.

// Is `c` a literal that is always true? (`while(1)`, `while(true)`, `for(;;)`)
int sema_cond_true(*ExprNode c) {
    if (c == null) { return 1; }                       // for(;;)
    if (c.kind != EK_LITERAL) { return 0; }
    if (c.lit_kind == LIT_BOOL) { return sema_streq(c.sval, "true"); }
    if (c.lit_kind == LIT_INT)  { if (sema_streq(c.sval, "0") == 1) { return 0; } return 1; }
    return 0;
}

int sema_can_complete(*StmtNode s);

// Label text of a loop/jump node ("" when unlabeled).
string sema_lbl(*StmtNode s) {
    if (s.label == null) { return ""; }
    return s.label;
}

// Does `s` hold a `break` (or, with want_cont, a `continue`) that transfers to the loop or
// switch enclosing it, labeled `label` ("" for none / a switch)? `inner` = inside a nested
// loop/switch, where an unlabeled jump binds there instead; a labeled jump naming `label`
// reaches from any depth. Mirrors the C++ jumpsTo.
int sema_jumps_to(*StmtNode s, string label, int want_cont, int inner) {
    if (s == null) { return 0; }
    int k = s.kind;
    if (k == SK_BREAK || k == SK_CONTINUE) {
        if ((k == SK_CONTINUE) != (want_cont == 1)) { return 0; }
        string l = sema_lbl(s);
        if (l[0] == 0) { if (inner == 0) { return 1; } return 0; }
        if (label[0] != 0 && sema_streq(l, label) == 1) { return 1; }
        return 0;
    }
    if (k == SK_BLOCK) {
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_jumps_to(List_get<*StmtNode>(&s.items, i), label, want_cont, inner) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    if (k == SK_IF) {
        if (sema_jumps_to(s.s1, label, want_cont, inner) == 1) { return 1; }
        return sema_jumps_to(s.s2, label, want_cont, inner);
    }
    if (k == SK_WHILE || k == SK_DOWHILE || k == SK_FORIN) { return sema_jumps_to(s.s1, label, want_cont, 1); }
    if (k == SK_FOR) { return sema_jumps_to(s.s2, label, want_cont, 1); }
    if (k == SK_SWITCH) {                               // captures an unlabeled break, not a continue
        int in2 = 1; if (want_cont == 1) { in2 = inner; }
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            *StmtNode c = List_get<*StmtNode>(&s.items, i);
            int j = 0; int m = List_len<*StmtNode>(&c.items);
            while (j < m) { if (sema_jumps_to(List_get<*StmtNode>(&c.items, j), label, want_cont, in2) == 1) { return 1; } j = j + 1; }
            i = i + 1;
        }
        return 0;
    }
    if (k == SK_MATCH) {                                // match is not a jump target
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_jumps_to(List_get<*StmtNode>(&s.items, i).s1, label, want_cont, inner) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    if (k == SK_TRY) {
        if (sema_jumps_to(s.s1, label, want_cont, inner) == 1) { return 1; }
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_jumps_to(List_get<*StmtNode>(&s.items, i).s1, label, want_cont, inner) == 1) { return 1; } i = i + 1; }
        return sema_jumps_to(s.s2, label, want_cont, inner);
    }
    return 0;
}

// Can executing `s` fall through to the next statement? Conservative: unsure means yes.
// Mirrors the C++ canCompleteNormally.
int sema_can_complete(*StmtNode s) {
    if (s == null) { return 1; }
    int k = s.kind;
    if (k == SK_RETURN || k == SK_THROW || k == SK_BREAK || k == SK_CONTINUE) { return 0; }
    if (k == SK_BLOCK) {
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_can_complete(List_get<*StmtNode>(&s.items, i)) == 0) { return 0; } i = i + 1; }
        return 1;
    }
    if (k == SK_IF) {
        if (s.s2 == null) { return 1; }
        if (sema_can_complete(s.s1) == 1) { return 1; }
        return sema_can_complete(s.s2);
    }
    if (k == SK_WHILE) {
        if (sema_cond_true(s.expr) == 0) { return 1; }
        return sema_jumps_to(s.s1, sema_lbl(s), 0, 0);
    }
    if (k == SK_FOR) {                                  // body is s2 (s1 is init)
        if (sema_cond_true(s.expr) == 0) { return 1; }
        return sema_jumps_to(s.s2, sema_lbl(s), 0, 0);
    }
    if (k == SK_DOWHILE) {                              // body runs at least once
        if (sema_jumps_to(s.s1, sema_lbl(s), 0, 0) == 1) { return 1; }
        int reaches = sema_can_complete(s.s1);
        if (reaches == 0) { reaches = sema_jumps_to(s.s1, sema_lbl(s), 1, 0); }
        if (reaches == 1 && sema_cond_true(s.expr) == 0) { return 1; }
        return 0;
    }
    if (k == SK_FORIN) { return 1; }                    // may iterate zero times
    if (k == SK_SWITCH) {                               // cases fall through in order
        int n = List_len<*StmtNode>(&s.items);
        int has_default = 0;
        int i = 0;
        while (i < n) { if (List_get<*StmtNode>(&s.items, i).expr == null) { has_default = 1; } i = i + 1; }
        if (has_default == 0 || n == 0) { return 1; }
        i = 0;
        while (i < n) {
            *StmtNode c = List_get<*StmtNode>(&s.items, i);
            int j = 0; int m = List_len<*StmtNode>(&c.items);
            while (j < m) { if (sema_jumps_to(List_get<*StmtNode>(&c.items, j), "", 0, 0) == 1) { return 1; } j = j + 1; }
            i = i + 1;
        }
        *StmtNode last = List_get<*StmtNode>(&s.items, n - 1);
        int j = 0; int m = List_len<*StmtNode>(&last.items);
        while (j < m) { if (sema_can_complete(List_get<*StmtNode>(&last.items, j)) == 0) { return 0; } j = j + 1; }
        return 1;
    }
    if (k == SK_MATCH) {                                // exhaustiveness checked separately
        int n = List_len<*StmtNode>(&s.items);
        if (n == 0) { return 1; }
        int i = 0;
        while (i < n) { if (sema_can_complete(List_get<*StmtNode>(&s.items, i).s1) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    if (k == SK_TRY) {
        if (s.s2 != null && sema_can_complete(s.s2) == 0) { return 0; }
        if (sema_can_complete(s.s1) == 1) { return 1; }
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_can_complete(List_get<*StmtNode>(&s.items, i).s1) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    return 1;
}

int sema_always_returns(*StmtNode s) {
    if (sema_can_complete(s) == 1) { return 0; }
    return 1;
}

// Check a function/method body: a fresh scope with the params (and `self` for
// methods) defined, then walk the body.
// Remove the first occurrence of `name` from a string list (used by the uninit scan).
void sema_list_erase(List<string>* l, string name) {
    int i = 0; int n = List_len<string>(l);
    while (i < n) {
        if (sema_streq(List_get<string>(l, i), name) == 1) { List_remove<string>(l, i); return; }
        i = i + 1;
    }
}

// Scan an expression for a read of a still-uninitialized scalar. `&x` counts as
// initializing x (its address may be written through), not a read.
void sema_uninit_scan(Sema* s, *ExprNode e, List<string>* uninit) {
    if (e == null) { return; }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        sema_list_erase(uninit, e.a.sval);
        return;
    }
    // An assignment (also nested: `x = y = 3`, `let y = (x = 5)`) writes its target after
    // evaluating the value; the target itself is not read.
    if (e.kind == EK_BINARY && sema_streq(e.sval, "=") == 1) {
        sema_uninit_scan(s, e.b, uninit);
        if (e.a != null && e.a.kind == EK_IDENT) { sema_list_erase(uninit, e.a.sval); }
        else { sema_uninit_scan(s, e.a, uninit); }
        return;
    }
    if (e.kind == EK_IDENT) {
        if (sema_in_list(uninit, e.sval) == 1) {
            s.had_error = 1;
            int ul = s.line; int uc = s.col;
            if (e.line > 0) { ul = e.line; uc = e.col; }   // at the read, not the function header
            dprintf(2, "error: %s:%d:%d: use of uninitialized variable '%s'\n", s.filename, ul, uc, e.sval);
            sema_list_erase(uninit, e.sval);       // report once
        }
        return;
    }
    // Recurse ONLY into the child fields each kind populates. alloc zeroes, so an unset
    // field is null (not garbage), but reading a child a kind never sets is still a wrong
    // answer. Mirrors the proven kind-aware walker `cg_collect_idents_e`; note
    // EK_TEMPLATECALL keeps its callee in `sval`, not `a`, so `a` must NOT be read for it.
    if (e.kind == EK_BINARY || e.kind == EK_INDEX) { sema_uninit_scan(s, e.a, uninit); sema_uninit_scan(s, e.b, uninit); }
    else if (e.kind == EK_UNARY || e.kind == EK_MEMBER || e.kind == EK_CAST
             || e.kind == EK_QUESTION || e.kind == EK_AWAIT || e.kind == EK_CALL
             || e.kind == EK_INCDEC) { sema_uninit_scan(s, e.a, uninit); }
    if (e.kind == EK_CALL || e.kind == EK_TEMPLATECALL || e.kind == EK_STRUCTINIT
        || e.kind == EK_ARRAYLIT || e.kind == EK_INDEX) {
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_uninit_scan(s, List_get<*ExprNode>(&e.kids, i), uninit); i = i + 1; }
    }
    if (e.kind == EK_TERNARY) {
        sema_uninit_scan(s, e.a, uninit); sema_uninit_scan(s, e.b, uninit);
        sema_uninit_scan(s, List_get<*ExprNode>(&e.kids, 0), uninit);
    }
}

// Conservative straight-line scan of a function body for reads of an uninitialized scalar
// local, stopping at the first control-flow statement (mirrors C++ checkUninitPrefix).
void sema_check_uninit(Sema* s, *StmtNode body) {
    if (body == null || body.kind != SK_BLOCK) { return; }
    List<string> uninit; List_init<string>(&uninit, 4);
    int i = 0; int n = List_len<*StmtNode>(&body.items);
    while (i < n) {
        *StmtNode it = List_get<*StmtNode>(&body.items, i);
        i = i + 1;
        if (it.kind == SK_VARDECL) {
            if (it.expr != null) { sema_uninit_scan(s, it.expr, &uninit); sema_list_erase(&uninit, it.name); }
            else if (it.is_static == 1) { sema_list_erase(&uninit, it.name); }   // static storage starts at zero (C)
            else {
                string t = sema_isub(s, it.type);  // only genuine scalars (arrays init piecewise); a generic instance's `T x` too
                if (sema_is_arr_ty(t) == 0 && (sema_is_numeric_ty(t) == 1 || sema_is_ptrish(t) == 1 || sema_is_fn_type(t) == 1)) {
                    List_push<string>(&uninit, it.name);
                }
            }
        } else if (it.kind == SK_EXPR) {
            sema_uninit_scan(s, it.expr, &uninit);
        } else if (it.kind == SK_RETURN) {
            if (it.expr != null) { sema_uninit_scan(s, it.expr, &uninit); }
        } else {
            i = n;                                 // control flow / anything else: stop (conservative)
        }
    }
}

// Is `t` a `void` value type (void, or an array of void)? Only a function result may be void.
int sema_is_void_value(string t0) {
    string t = sema_strip_const(t0);
    if (sema_has_star(t) == 1) { return 0; }
    int n = 0; while (t[n] != 0 && (int)t[n] != 91) { n = n + 1; }
    return sema_streq(sema_sub_str(t, 0, n), "void");
}

// "" when a value of type `t0` is fine, else why not (mirrors TypeChecker::voidTypeError):
// a `void` value (also an array or slice of one), or a generic instance like `Box<void>`
// whose type argument makes a field a `void` value.
string sema_void_type_err(Sema* s, string t0) {
    if (sema_is_void_value(t0) == 1) { return "cannot have type 'void'"; }
    string t = sema_strip_const(t0);
    if (sema_has_star(t) == 1 || sema_is_fn_type(t) == 1) { return ""; }
    int n = 0; while (t[n] != 0 && (int)t[n] != 91) { n = n + 1; }
    string bt = sema_sub_str(t, 0, n);
    if (sema_has_lt(bt) == 0) { return ""; }
    *DeclNode d = sema_find_struct(s, sema_base_name(bt));
    if (d == null || List_len<TypeParam>(&d.type_params) == 0) { return ""; }
    List<string> targs; List_init<string>(&targs, 2);
    sema_parse_targs(bt, &targs);
    int i = 0;
    while (i < List_len<Param>(&d.params)) {
        Param f = List_get<Param>(&d.params, i);
        if (sema_is_void_value(sema_subst_params(f.ty, &d.type_params, &targs)) == 1) {
            return sema_cat(sema_cat(sema_cat(sema_cat("cannot have type '", t0), "': its field '"), f.name), "' would be 'void'");
        }
        i = i + 1;
    }
    return "";
}

// "ret(p1, p2)" signature spelling of a function, for the prototype/definition check.
string sema_sig_of(*DeclNode f) {
    string out = sema_cat(sema_strip_const(f.ret_type), "(");
    int i = 0; int n = List_len<Param>(&f.params);
    while (i < n) {
        if (i > 0) { out = sema_cat(out, ", "); }
        out = sema_cat(out, List_get<Param>(&f.params, i).ty);
        i = i + 1;
    }
    return sema_cat(out, ")");
}

// Do two struct decls have identical fields (a multi-file merge of one declaration)?
int sema_same_struct(*DeclNode a, *DeclNode b) {
    List<Param> af; List<int> ab; List<int> an; ast_layout_fields(a, &af, &ab, &an);
    List<Param> bf; List<int> bb; List<int> bn; ast_layout_fields(b, &bf, &bb, &bn);
    int n = List_len<Param>(&af);
    if (n != List_len<Param>(&bf)) { return 0; }
    if (List_len<*DeclNode>(&a.methods) != List_len<*DeclNode>(&b.methods)) { return 0; }
    if (List_len<TypeParam>(&a.type_params) != List_len<TypeParam>(&b.type_params)) { return 0; }
    int i = 0;
    while (i < n) {
        Param x = List_get<Param>(&af, i); Param y = List_get<Param>(&bf, i);
        if (sema_streq(x.ty, y.ty) == 0 || sema_streq(x.name, y.name) == 0) { return 0; }
        if (List_get<int>(&ab, i) != List_get<int>(&bb, i) || List_get<int>(&an, i) != List_get<int>(&bn, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

int sema_is_type_kind(string k) {
    if (sema_streq(k, "struct") == 1 || sema_streq(k, "union") == 1 || sema_streq(k, "enum") == 1
        || sema_streq(k, "interface") == 1 || sema_streq(k, "type alias") == 1) { return 1; }
    return 0;
}

// "a struct", "an enum member", ...
string sema_article(string k) {
    if (k[0] == 101 || k[0] == 105 || k[0] == 117) { return sema_cat("an ", k); }   // e i u
    return sema_cat("a ", k);
}

// Index of `name` in the top-level name table, or -1.
int sema_name_index(List<NameEnt>* tab, string name) {
    int i = 0; int n = List_len<NameEnt>(tab);
    while (i < n) { if (sema_streq(List_get<NameEnt>(tab, i).name, name) == 1) { return i; } i = i + 1; }
    return -1;
}

// Declare top-level `name` of `kind`; report a duplicate or a conflict (mirrors the C++
// checkTopLevelNames: prototypes, `extern` variables and identical structs are allowed).
void sema_declare_top(Sema* s, List<NameEnt>* tab, string name, string kind, *DeclNode d) {
    int i = sema_name_index(tab, name);
    if (i < 0) { let ne: NameEnt; ne.name = name; ne.kind = kind; ne.d = d; List_push<NameEnt>(tab, ne); return; }
    NameEnt prev = List_get<NameEnt>(tab, i);
    if (sema_streq(kind, "function") == 1 && sema_streq(prev.kind, "function") == 1) {
        int pg = List_len<TypeParam>(&prev.d.type_params); int dg = List_len<TypeParam>(&d.type_params);
        if (pg > 0 || dg > 0) {
            // Two bodies are reported as a redefinition; a generic and a non-generic
            // function may not share a name (a call would silently pick one).
            if ((pg == 0) != (dg == 0) && (prev.d.body == null || d.body == null)) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: conflicting declaration of function '%s' (a generic and a non-generic function cannot share a name)\n",
                       s.filename, s.line, s.col, sema_fn_display(d));
            }
            return;
        }
        if (sema_streq(sema_sig_of(prev.d), sema_sig_of(d)) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: conflicting declaration of function '%s' (%s vs the earlier %s)\n",
                   s.filename, s.line, s.col, sema_fn_display(d), sema_sig_of(d), sema_sig_of(prev.d));
        }
        return;                                      // two bodies: reported as a redefinition
    }
    if (sema_streq(kind, "variable") == 1 && sema_streq(prev.kind, "variable") == 1) {
        if ((prev.d.is_extern == 1 || d.is_extern == 1) && sema_streq(prev.d.ret_type, d.ret_type) == 1) { return; }
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: redefinition of global variable '%s'\n", s.filename, s.line, s.col, name);
        return;
    }
    if (sema_streq(kind, "struct") == 1 && sema_streq(prev.kind, "struct") == 1) {
        if (sema_same_struct(prev.d, d) == 1) { return; }
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: redefinition of struct '%s' with different fields\n", s.filename, s.line, s.col, name);
        return;
    }
    if (sema_streq(kind, "type alias") == 1 && sema_streq(prev.kind, "type alias") == 1
        && sema_streq(prev.d.ret_type, d.ret_type) == 1) { return; }
    // Types and enum members live apart (a struct `G` beside a member `G` is fine).
    if ((sema_is_type_kind(kind) == 1 && sema_streq(prev.kind, "enum member") == 1)
        || (sema_is_type_kind(prev.kind) == 1 && sema_streq(kind, "enum member") == 1)) { return; }
    s.had_error = 1;
    if (sema_streq(kind, prev.kind) == 1) {
        dprintf(2, "error: %s:%d:%d: redefinition of %s '%s'\n", s.filename, s.line, s.col, kind, name);
    } else {
        dprintf(2, "error: %s:%d:%d: '%s' is declared as both %s and %s\n", s.filename, s.line, s.col, name, sema_article(prev.kind), sema_article(kind));
    }
}

// "ret(p1, p2)" of an extern with type aliases and classic enums resolved (as C++ compares
// normalized signatures).
string sema_extern_sig(Sema* s, *DeclNode f) {
    string out = sema_cat(sema_resolve_scalar(s, f.ret_type), "(");
    int i = 0; int n = List_len<Param>(&f.params);
    while (i < n) {
        if (i > 0) { out = sema_cat(out, ", "); }
        out = sema_cat(out, sema_resolve_scalar(s, List_get<Param>(&f.params, i).ty));
        i = i + 1;
    }
    return sema_cat(out, ")");
}

void sema_check_top_names(Sema* s, *Program prog) {
    List<NameEnt> tab; List_init<NameEnt>(&tab, 64);
    int i = 0; int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        s.line = d.line; s.col = d.col;
        if (d.kind == DK_FUNCTION) { sema_declare_top(s, &tab, d.name, "function", d); }
        else if (d.kind == DK_VARDECL) { sema_declare_top(s, &tab, d.name, "variable", d); }
        else if (d.kind == DK_STRUCT) {
            sema_declare_top(s, &tab, d.name, "struct", d);
            int m = 0; int mn = List_len<*DeclNode>(&d.methods);
            while (m < mn) {                         // an inline method `S.m` is the function `S_m`
                *DeclNode md = List_get<*DeclNode>(&d.methods, m);
                sema_declare_top(s, &tab, sema_cat(sema_cat(d.name, "_"), md.name), "method", md);
                m = m + 1;
            }
        }
        else if (d.kind == DK_UNION) { sema_declare_top(s, &tab, d.name, "union", d); }
        else if (d.kind == DK_ENUM) {
            sema_declare_top(s, &tab, d.name, "enum", d);
            // A classic member is an int constant, apart from type names; a sum type's
            // variant is a constructor, so it may not share a name with a type either.
            string mkind = "enum member";
            if (sema_is_aggregate(s, d.name) == 1) { mkind = "variant"; }
            int j = 0; int jn = List_len<Param>(&d.params);
            while (j < jn) { sema_declare_top(s, &tab, List_get<Param>(&d.params, j).name, mkind, d); j = j + 1; }
        }
        else if (d.kind == DK_EXTERN) {
            // An `extern` may be declared again (modules share C functions), but with the
            // same signature: two different ones cannot both describe the C symbol.
            int j = 0;
            while (j < i) {
                *DeclNode pd = List_get<*DeclNode>(&prog.decls, j);
                if (pd.kind == DK_EXTERN && sema_streq(pd.name, d.name) == 1) {
                    string a = sema_extern_sig(s, pd); string b = sema_extern_sig(s, d);
                    if (sema_streq(a, b) == 0) {
                        s.had_error = 1;
                        dprintf(2, "error: %s:%d:%d: conflicting declaration of extern '%s' (%s vs the earlier %s)\n", s.filename, s.line, s.col, d.name, b, a);
                    }
                    j = i;
                }
                j = j + 1;
            }
        }
        else if (d.kind == DK_INTERFACE) { sema_declare_top(s, &tab, d.name, "interface", d); }
        else if (d.kind == DK_TYPEALIAS) { sema_declare_top(s, &tab, d.name, "type alias", d); }
        i = i + 1;
    }
}

// Source spelling of a function for diagnostics: an operator shows as `operator +(V, V)`
// rather than its mangled name.
string sema_fn_display(*DeclNode d) {
    if (d.operator_sym == null || d.operator_sym[0] == 0) { return d.name; }
    string op = d.operator_sym;
    if (sema_streq(op, "u-") == 1) { op = "-"; }
    string out = sema_cat(sema_cat("operator ", op), "(");
    int i = 0; int n = List_len<Param>(&d.params);
    while (i < n) {
        if (i > 0) { out = sema_cat(out, ", "); }
        out = sema_cat(out, List_get<Param>(&d.params, i).ty);
        i = i + 1;
    }
    return sema_cat(out, ")");
}

// A function's parameter and return types must name known types; no parameter is void.
void sema_check_sig_types(Sema* s, *DeclNode f) {
    int i = 0; int n = List_len<Param>(&f.params);
    List<string> pnames; List_init<string>(&pnames, 4);
    while (i < n) {
        Param pm = List_get<Param>(&f.params, i);
        if (pm.name != null && pm.name[0] != 0 && sema_streq(pm.ty, "...") == 0) {
            if (sema_in_list(&pnames, pm.name) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: duplicate parameter '%s' in function '%s'\n", s.filename, s.line, s.col, pm.name, sema_fn_display(f));
            } else { List_push<string>(&pnames, pm.name); }
        }
        sema_check_decl_type(s, pm.ty);
        string pterr = sema_void_type_err(s, pm.ty);
        if (pterr[0] != 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: parameter '%s' %s\n", s.filename, s.line, s.col, pm.name, pterr);
        }
        i = i + 1;
    }
    sema_check_decl_type(s, f.ret_type);
}

// Bit width of an integer type usable for a bitfield, or 0 when it is not one.
int sema_int_bits(string t) {
    if (sema_streq(t, "bool") == 1) { return 1; }
    if (sema_streq(t, "char") == 1 || sema_streq(t, "int8") == 1 || sema_streq(t, "uint8") == 1) { return 8; }
    if (sema_streq(t, "int16") == 1 || sema_streq(t, "uint16") == 1) { return 16; }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1 || sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) { return 32; }
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) { return 64; }
    return 0;
}

// A bitfield's declared type with aliases resolved and a classic enum as `int` (a sum type
// stays itself: it is not an integer).
string sema_bitfield_base(Sema* s, string t) {
    string ft = sema_strip_const(t);
    int hops = 0;
    while (hops < 16) {
        *DeclNode ad = sema_find_tdecl(s, ft);
        if (ad != null && ad.kind == DK_TYPEALIAS) { ft = sema_strip_const(ad.ret_type); }
        else { if (sema_is_plain_enum_decl(ad) == 1) { ft = "int"; } hops = 16; }
        hops = hops + 1;
    }
    return ft;
}

// Struct/union fields: not void; a bitfield needs an integer type at least as wide.
void sema_check_fields(Sema* s, *DeclNode d) {
    int i = 0; int n = List_len<Param>(&d.params);
    List<string> fnames; List_init<string>(&fnames, 8);
    string what = "struct"; if (d.kind == DK_UNION) { what = "union"; }
    int k = 0;
    while (k < n) {
        string fname = List_get<Param>(&d.params, k).name;
        if (sema_in_list(&fnames, fname) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: duplicate field '%s' in %s '%s'\n", s.filename, s.line, s.col, fname, what, d.name);
        } else { List_push<string>(&fnames, fname); }
        k = k + 1;
    }
    List<string> mnames; List_init<string>(&mnames, 4);
    int m = 0; int mn = List_len<*DeclNode>(&d.methods);
    while (m < mn) {
        string mname = List_get<*DeclNode>(&d.methods, m).name;
        *DeclNode md = List_get<*DeclNode>(&d.methods, m);
        int mdl = s.line; int mdc = s.col;             // at the method (as the C++ checker)
        if (md.line > 0) { mdl = md.line; mdc = md.col; }
        if (sema_in_list(&fnames, mname) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: method '%s' of struct '%s' has the same name as a field\n", s.filename, mdl, mdc, mname, d.name);
        }
        if (sema_in_list(&mnames, mname) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: duplicate method '%s' in struct '%s'\n", s.filename, mdl, mdc, mname, d.name);
        } else { List_push<string>(&mnames, mname); }
        int mp = 0;
        while (mp < List_len<Param>(&md.params)) {
            if (sema_streq(List_get<Param>(&md.params, mp).name, "self") == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: method '%s' of struct '%s' cannot have a parameter named 'self': it is the implicit receiver\n",
                        s.filename, md.line, md.col, mname, d.name);
            }
            mp = mp + 1;
        }
        m = m + 1;
    }
    int pi = 0;
    while (pi < List_len<string>(&d.pad_tys)) {               // unnamed bitfields `T : N;`
        string pty = List_get<string>(&d.pad_tys, pi);
        int pw = List_get<int>(&d.pad_bits, pi);
        int ptb = sema_int_bits(sema_bitfield_base(s, pty));
        if (ptb == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: unnamed bitfield of '%s' must have an integer type, got '%s'\n", s.filename, s.line, s.col, d.name, pty);
        } else if (pw > ptb) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: unnamed bitfield of '%s' is %d bits wide, more than its type '%s' holds (%d)\n",
                   s.filename, s.line, s.col, d.name, pw, pty, ptb);
        }
        pi = pi + 1;
    }
    while (i < n) {
        Param f = List_get<Param>(&d.params, i);
        string fterr = sema_void_type_err(s, f.ty);
        if (fterr[0] != 0 && (List_len<TypeParam>(&d.type_params) == 0 || sema_is_void_value(f.ty) == 1)) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: field '%s' of '%s' %s\n", s.filename, s.line, s.col, f.name, d.name, fterr);
        }
        int bw = 0;
        if (d.kind == DK_STRUCT && i < List_len<int>(&d.field_bits)) { bw = List_get<int>(&d.field_bits, i); }
        if (bw < 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' has zero width (only an unnamed bitfield may be zero-width)\n", s.filename, s.line, s.col, f.name, d.name);
        }
        if (bw > 0 && sema_names_tparam(d, f.ty) == 0) {   // a type parameter: checked per instance
            int tb = sema_int_bits(sema_bitfield_base(s, f.ty));
            if (tb == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' must have an integer type, got '%s'\n", s.filename, s.line, s.col, f.name, d.name, f.ty);
            } else if (bw > tb) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: bitfield '%s' of '%s' is %d bits wide, more than its type '%s' holds (%d)\n",
                       s.filename, s.line, s.col, f.name, d.name, bw, f.ty, tb);
            }
        }
        i = i + 1;
    }
}

// A type alias that resolves back to itself names no type (`type A = B; type B = A;`).
void sema_check_alias_cycles(Sema* s) {
    int i = 0; int n = List_len<*DeclNode>(&s.tdecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.tdecls, i);
        s.line = d.line; s.col = d.col;
        if (d.kind == DK_TYPEALIAS) {
            string cur = d.ret_type;
            int steps = 0;
            int cyc = 0;
            while (steps < 64) {
                string b0 = sema_struct_of_type(sema_strip_const(cur));
                int bn = 0; while (b0[bn] != 0 && (int)b0[bn] != 91) { bn = bn + 1; }
                string b = sema_base_name(sema_sub_str(b0, 0, bn));
                // Also through a type argument (`type L = List<L>;`): its layout needs itself.
                if (sema_streq(b, d.name) == 1 || sema_type_mentions(cur, d.name) == 1) { cyc = 1; steps = 64; }
                else {
                    *DeclNode nx = sema_find_tdecl(s, b);
                    if (nx == null || nx.kind != DK_TYPEALIAS) { steps = 64; }
                    else { cur = nx.ret_type; }
                }
                steps = steps + 1;
            }
            if (cyc == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: type alias '%s' refers to itself (a cyclic alias names no type)\n", s.filename, s.line, s.col, d.name);
            }
        }
        i = i + 1;
    }
}

void sema_check_fn(Sema* s, *DeclNode f, string self_type) {
    if (f.body == null) { return; }
    s.line = f.line; s.col = f.col;
    // Template body: full type-checking (escape soundness, `?`, uninitialized reads,
    // undefined-variable) is deferred to instantiation, exactly as the C++ checker does,
    // because the param types are still abstract. Only the definite-return check is
    // structural (control-flow, type-independent), so it still applies here.
    if (List_len<TypeParam>(&f.type_params) > 0 && s.in_inst == 0) {
        if (f.is_async == 0 && sema_streq(f.ret_type, "void") == 0
            && sema_always_returns(f.body) == 0) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: missing return in non-void function '%s' (control can reach the end without returning a %s)\n",
                   s.filename, s.line, s.col, f.name, f.ret_type);
        }
        return;
    }
    // `main` is the entry point; its return value is the process exit code, so it must be int.
    if (sema_streq(f.name, "main") == 1 && sema_streq(f.ret_type, "int") == 0
        && sema_streq(f.ret_type, "int32") == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: 'main' must return int (its return value is the process exit code); got '%s'\n",
               s.filename, s.line, s.col, f.ret_type);
    }
    if (sema_streq(f.name, "main") == 1 && f.is_async == 1 && s.in_inst == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: 'main' cannot be async: the program's entry point must return int directly (run an async function from main with an executor)\n",
               s.filename, s.line, s.col);
    }
    s.in_async = f.is_async;
    s.in_variadic = 0;
    int vpn = List_len<Param>(&f.params);
    if (vpn > 0 && sema_streq(List_get<Param>(&f.params, vpn - 1).ty, "...") == 1) { s.in_variadic = 1; }
    s.await_seen = 0;
    s.cur_ret = sema_isub(s, f.ret_type);
    s.cur_ret_raw = f.ret_type;
    // Escape soundness: watch non-escaping fn-type params for the body walk. (Not in a
    // generic instance: as in the C++ checker, it is enforced on non-generic functions.)
    List_init<string>(&s.watched, 4);
    List_init<string>(&s.escaped, 4);
    List_init<string>(&s.wlocals, 4);
    List_init<string>(&s.wlocals_esc, 4);
    List_init<*ExprNode>(&s.wlam, 4); List_init<string>(&s.wlam_name, 4); List_init<int>(&s.wlam_async, 4);
    List_init<*ExprNode>(&s.lcap_lam, 4); List_init<string>(&s.lcap_name, 4);
    s.lam_arg_stack = 0;
    List_init<string>(&s.cap_param, 4);
    List_init<string>(&s.cap_local, 4);
    List_init<string>(&s.narrowed, 4);
    List_init<string>(&s.loop_lbls, 4);
    s.callee_ctx = "";
    int pe = 0;
    int pn = List_len<Param>(&f.params);
    while (pe < pn) {
        Param pm = List_get<Param>(&f.params, pe);
        int marked = 0;
        if (pe < List_len<int>(&f.param_escaping)) { marked = List_get<int>(&f.param_escaping, pe); }
        if (sema_is_fn_type(pm.ty) == 1 && marked == 0 && s.in_inst == 0) { List_push<string>(&s.watched, pm.name); }
        pe = pe + 1;
    }
    sema_push(s);
    if (self_type[0] != 0) { sema_define(s, "self", sema_cat("*", self_type), 0); }   // method: self points at the struct
    int j = 0;
    int m = List_len<Param>(&f.params);
    while (j < m) {
        Param pm = List_get<Param>(&f.params, j);
        // `const int x` (or `T*const p`): the parameter itself may not be reassigned.
        int pconst = 0;
        int pn2 = 0; while (pm.ty[pn2] != 0) { pn2 = pn2 + 1; }
        if (pn2 >= 6 && sema_streq(sema_sub_str(pm.ty, 0, 6), "const ") == 1 && sema_has_star(pm.ty) == 0) { pconst = 1; }
        if (pn2 >= 6 && sema_streq(sema_sub_str(pm.ty, pn2 - 6, pn2), "*const") == 1) { pconst = 1; }
        sema_define(s, pm.name, sema_isub(s, pm.ty), pconst);
        if (s.in_inst == 1) {              // `id<void>`: a type argument may make a parameter void
            string iperr = sema_void_type_err(s, sema_isub(s, pm.ty));
            if (iperr[0] != 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: parameter '%s' %s\n", s.filename, s.line, s.col, pm.name, iperr);
            }
        }
        j = j + 1;
    }
    int prev_pd = s.param_depth;
    s.param_depth = s.depth;
    sema_stmt(s, f.body);
    s.param_depth = prev_pd;
    sema_pop(s);
    if (f.is_async == 0) { sema_check_uninit(s, f.body); }   // reads of an uninitialized scalar local
    // A non-void function must return on every path (no implicit zero return);
    // void may fall off, and async completes its future implicitly.
    if (f.is_async == 0 && s.in_inst == 0 && sema_streq(f.ret_type, "void") == 0
        && sema_always_returns(f.body) == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: missing return in non-void function '%s' (control can reach the end without returning a %s)\n",
               s.filename, s.line, s.col, f.name, f.ret_type);
    }
    if (f.is_async == 1 && s.await_seen == 0) {
        s.had_error = 1;
        dprintf(2, "error: %s:%d:%d: async function '%s' has no `await`\n", s.filename, s.line, s.col, f.name);
    }
    sema_stack_envs(s);
    int ci = 0;
    while (ci < List_len<string>(&s.cap_param)) {
        if (sema_in_list(&s.wlocals_esc, List_get<string>(&s.cap_local, ci)) == 1
            && sema_in_list(&s.escaped, List_get<string>(&s.cap_param, ci)) == 0) {
            List_push<string>(&s.escaped, List_get<string>(&s.cap_param, ci));
        }
        ci = ci + 1;
    }
    int wi = 0;
    int wn = List_len<string>(&s.watched);
    while (wi < wn) {
        string wnm = List_get<string>(&s.watched, wi);
        if (sema_in_list(&s.escaped, wnm) == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: closure parameter '%s' escapes (used beyond a direct call); mark it `escaping`\n",
                   s.filename, s.line, s.col, wnm);
        }
        wi = wi + 1;
    }
    s.in_async = 0;
}

// Check each queued generic instance: the template body with its type parameters bound
// to the instance's arguments. Checking one may queue more, so this runs until the
// queue drains. A failing instance is followed by a note naming it.
void sema_check_insts(Sema* s, string primary) {
    int i = 0;
    while (i < List_len<SInst>(&s.insts)) {
        SInst p = List_get<SInst>(&s.insts, i);
        *DeclNode top = p.func;
        if (p.owner != null) { top = p.owner; }
        sema_enter_decl(s, top, primary);
        s.line = p.func.line; s.col = p.func.col;
        if (p.depth > 64) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: generic instantiation of '%s' is nested more than 64 levels deep (infinitely recursive generic?)\n",
                   s.filename, s.line, s.col, p.display);
            return;
        }
        List<TypeParam>* tps = &p.func.type_params;
        if (p.owner != null) { tps = &p.owner.type_params; }
        List_init<string>(&s.isub_p, 4); List_init<string>(&s.isub_a, 4); List_init<string>(&s.tparams, 4);
        int k = 0;
        while (k < List_len<TypeParam>(tps) && k < List_len<string>(&p.targs)) {
            List_push<string>(&s.isub_p, List_get<TypeParam>(tps, k).name);
            List_push<string>(&s.tparams, List_get<TypeParam>(tps, k).name);
            List_push<string>(&s.isub_a, List_get<string>(&p.targs, k));
            k = k + 1;
        }
        string self_t = "";
        if (p.owner != null) {
            self_t = sema_cat(p.owner.name, "<");
            int a = 0;
            while (a < List_len<string>(&p.targs)) {
                if (a > 0) { self_t = sema_cat(self_t, ","); }
                self_t = sema_cat(self_t, List_get<string>(&p.targs, a));
                a = a + 1;
            }
            self_t = sema_cat(self_t, ">");
        }
        int saved = s.had_error;
        s.had_error = 0;
        s.in_inst = 1; s.inst_depth = p.depth;
        sema_check_fn(s, p.func, self_t);
        s.in_inst = 0; s.inst_depth = 0;
        if (s.had_error == 1) {
            dprintf(2, "note: %s:%d:%d: (in instantiation of %s)\n", s.filename, p.func.line, p.func.col, p.display);
        }
        if (saved == 1) { s.had_error = 1; }
        List_init<string>(&s.isub_p, 4); List_init<string>(&s.isub_a, 4); List_init<string>(&s.tparams, 4);
        i = i + 1;
    }
}

// Returns 1 if the program type-checks (no errors), 0 otherwise.
int sema_check(Sema* s, *Program prog) {
    // Every `&name` in the program: a global whose address is taken is never narrowed.
    List_init<string>(&s.gaddr, 8);
    int gi = 0;
    while (gi < List_len<*DeclNode>(&prog.decls)) {
        *DeclNode gd = List_get<*DeclNode>(&prog.decls, gi);
        if (gd.kind == DK_FUNCTION) { sema_addr_names(gd.body, &s.gaddr); }
        else if (gd.kind == DK_VARDECL) { sema_addr_names_e(gd.init, &s.gaddr); }
        else if (gd.kind == DK_STRUCT) {
            int gm = 0;
            while (gm < List_len<*DeclNode>(&gd.methods)) { sema_addr_names(List_get<*DeclNode>(&gd.methods, gm).body, &s.gaddr); gm = gm + 1; }
        }
        gi = gi + 1;
    }
    sema_register_globals(s, prog);
    sema_check_top_names(s, prog);
    sema_check_alias_cycles(s);
    if (s.had_error == 1) { return 0; }   // a cyclic alias makes every later type check meaningless
    List<string> defined_fns;   // top-level functions WITH a body, to catch a redefinition
    List_init<string>(&defined_fns, 32);
    string primary = s.filename;
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    int gi0 = 0;
    while (gi0 < n) {
        *DeclNode gd = List_get<*DeclNode>(&prog.decls, gi0);
        if (gd.kind == DK_VARDECL) { List_push<string>(&s.late_globals, gd.name); }
        gi0 = gi0 + 1;
    }
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        sema_enter_decl(s, d, primary);
        s.line = d.line; s.col = d.col;
        if (d.kind == DK_FUNCTION && d.body != null) {
            if (sema_in_list(&defined_fns, d.name) == 1) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: redefinition of function '%s'\n", s.filename, s.line, s.col, sema_fn_display(d));
            } else { List_push<string>(&defined_fns, d.name); }
        }
        if (d.kind == DK_INTRINSIC) {
            if (sema_streq(d.name, "atomic_load") == 0 && sema_streq(d.name, "atomic_store") == 0
                && sema_streq(d.name, "atomic_swap") == 0 && sema_streq(d.name, "atomic_cas") == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: unknown intrinsic '%s'\n", s.filename, s.line, s.col, d.name);
            }
        }
        if ((d.kind == DK_FUNCTION && List_len<TypeParam>(&d.type_params) == 0) || d.kind == DK_EXTERN) {
            sema_check_sig_types(s, d);
        }
        // A type parameter is named once (`<T, T>`).
        if (d.kind == DK_FUNCTION || d.kind == DK_STRUCT || d.kind == DK_ENUM) {
            List<string> tpn; List_init<string>(&tpn, 2);
            int ti2 = 0;
            while (ti2 < List_len<TypeParam>(&d.type_params)) {
                string tpname = List_get<TypeParam>(&d.type_params, ti2).name;
                if (sema_in_list(&tpn, tpname) == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: duplicate type parameter '%s' in '%s'\n", s.filename, s.line, s.col, tpname, sema_fn_display(d));
                } else { List_push<string>(&tpn, tpname); }
                ti2 = ti2 + 1;
            }
        }
        // An interface requires each method once.
        if (d.kind == DK_INTERFACE) {
            List<string> imn; List_init<string>(&imn, 4);
            int ii2 = 0;
            while (ii2 < List_len<*DeclNode>(&d.methods)) {
                string imname = List_get<*DeclNode>(&d.methods, ii2).name;
                if (sema_in_list(&imn, imname) == 1) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: duplicate method '%s' in interface '%s'\n", s.filename, s.line, s.col, imname, d.name);
                } else { List_push<string>(&imn, imname); }
                ii2 = ii2 + 1;
            }
        }
        // `must_use` asks the caller to use a result; a void function has none.
        if (d.kind == DK_FUNCTION && d.is_mustuse == 1 && sema_streq(sema_strip_const(d.ret_type), "void") == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'must_use' on '%s', which returns void (there is no result to use)\n", s.filename, s.line, s.col, sema_fn_display(d));
        }
        // `main` is called by the C runtime as `main()` or `main(argc, argv[, envp])`.
        if (d.kind == DK_FUNCTION && sema_streq(d.name, "main") == 1 && List_len<Param>(&d.params) > 0) {
            int mok = 0;
            int mnp = List_len<Param>(&d.params);
            string a0 = sema_resolve_scalar(s, List_get<Param>(&d.params, 0).ty);
            if ((mnp == 2 || mnp == 3) && (sema_streq(a0, "int") == 1 || sema_streq(a0, "int32") == 1)) { mok = 1; }
            int mi2 = 1;
            while (mok == 1 && mi2 < mnp) {
                string at = sema_strip_const(List_get<Param>(&d.params, mi2).ty);
                string abase = sema_strip_ptr_sp(at);
                int ad = sema_ptr_depth(at);
                if (!((ad == 1 && sema_streq(abase, "string") == 1)
                      || (ad == 2 && (sema_streq(abase, "char") == 1 || sema_streq(abase, "uint8") == 1 || sema_streq(abase, "int8") == 1)))) { mok = 0; }
                mi2 = mi2 + 1;
            }
            if (mok == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: 'main' must take no parameters or (int argc, string* argv): the C runtime calls it that way\n", s.filename, s.line, s.col);
            }
        }
        // An operator overload extends an operator to a user type: one operand must be a
        // struct/union, a sum type or an interface value (mirrors the C++ check).
        if (d.kind == DK_FUNCTION && d.operator_sym != null && d.operator_sym[0] != 0) {
            int user = 0; int oi = 0;
            while (oi < List_len<Param>(&d.params)) {
                string ot = sema_dealias(s, List_get<Param>(&d.params, oi).ty);
                if (sema_has_star(ot) == 0 && sema_is_fn_type(ot) == 0 && sema_is_arr_ty(ot) == 0
                    && sema_is_aggregate(s, ot) == 1) { user = 1; }
                oi = oi + 1;
            }
            if (user == 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: '%s' does not overload an operator for a user type: an operand must be a struct, union, sum type or interface (built-in operands keep their built-in meaning)\n",
                       s.filename, s.line, s.col, sema_fn_display(d));
            }
            // Operand count: `!`, `~` and unary `-` take one, every other operator two.
            string op = d.operator_sym;
            int want = 2;
            if (sema_streq(op, "u-") == 1 || sema_streq(op, "!") == 1 || sema_streq(op, "~") == 1) { want = 1; }
            int got = List_len<Param>(&d.params);
            if (got != want) {
                string shown = op;
                if (sema_streq(op, "u-") == 1) { shown = "-"; }
                string cnt = "2 parameters";
                if (sema_streq(shown, "-") == 1) { cnt = "1 or 2 parameters"; }
                else if (want == 1) { cnt = "1 parameter"; }
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: operator '%s' takes %s, got %d\n", s.filename, s.line, s.col, shown, cnt, got);
            }
        }
        if (d.kind == DK_FUNCTION) { sema_check_fn(s, d, ""); }
        // A global's initializer runs at compile time (no code runs before `main`), so it
        // must be a constant expression, as in C.
        if (d.kind == DK_VARDECL) { sema_check_decl_type(s, d.ret_type); }   // a global's type must exist
        if (d.kind == DK_VARDECL && d.is_static == 1) {
            s.had_error = 1;
            dprintf(2, "error: %s:%d:%d: 'static' is only allowed on a local variable\n", s.filename, d.line, d.col);
        }
        if (d.kind == DK_TYPEALIAS) { sema_check_decl_type(s, d.ret_type); }  // so must an alias's
        if (d.kind == DK_ENUM && sema_is_plain_enum_decl(d) == 1) { sema_fold_enum(s, d, 1); }
        if (d.kind == DK_ENUM) {           // a classic enum is an int: each member value must fit it
            int adt = 0; int pj = 0;
            while (pj < List_len<List<string>>(&d.payloads)) {
                List<string> epl = List_get<List<string>>(&d.payloads, pj);
                if (List_len<string>(&epl) > 0) { adt = 1; }
                pj = pj + 1;
            }
            int ej = 0;
            while (adt == 0 && List_len<TypeParam>(&d.type_params) == 0 && ej < List_len<Param>(&d.params)) {
                Param em = List_get<Param>(&d.params, ej);
                if (sema_int_lit_fits("int", em.ty) == 0) {
                    s.had_error = 1;
                    dprintf(2, "error: %s:%d:%d: enum member '%s' of '%s' has value %s, out of range for 'int'\n",
                           s.filename, s.line, s.col, em.name, d.name, em.ty);
                }
                ej = ej + 1;
            }
        }
        if (d.kind == DK_VARDECL && d.is_extern == 0 && d.init != null) {
            // The initializer is an expression like any other (names, operators, shift
            // counts), checked before the global itself is declared.
            if (d.init.kind == EK_LAMBDA && sema_is_fn_type(d.ret_type) == 1) { s.lam_ret = sema_fn_ret(d.ret_type); }
            sema_expr(s, d.init);
            s.lam_ret = "";
        }
        if (d.kind == DK_VARDECL && d.is_extern == 0 && d.init != null && sema_is_const_init(s, d.init) == 0) {
            sema_error(s, sema_cat(sema_cat("initializer of global '", d.name), "' is not a compile-time constant"));
        }
        // A global's initializer converts to its type like a local's (mirrors the C++ VarDecl
        // check, which runs for globals too).
        if (d.kind == DK_VARDECL && d.is_extern == 0 && d.init != null && d.init.kind != EK_LAMBDA
            && d.ret_type != null && d.ret_type[0] != 0) {
            string gerr = sema_assign_err(s, d.ret_type, d.init);
            if (gerr[0] != 0) {
                s.had_error = 1;
                dprintf(2, "error: %s:%d:%d: initializing '%s': %s\n", s.filename, s.line, s.col, d.name, gerr);
            }
        }
        if (d.kind == DK_VARDECL) {
            int lg = 0;
            while (lg < List_len<string>(&s.late_globals)) {
                // every entry of the name (an `extern` declaration and the definition)
                if (sema_streq(List_get<string>(&s.late_globals, lg), d.name) == 1) { List_remove<string>(&s.late_globals, lg); }
                else { lg = lg + 1; }
            }
        }
        if (d.kind == DK_STRUCT || d.kind == DK_UNION) {
            List_init<string>(&s.tparams, 4);
            int ti = 0; int tn = List_len<TypeParam>(&d.type_params);
            while (ti < tn) { List_push<string>(&s.tparams, List_get<TypeParam>(&d.type_params, ti).name); ti = ti + 1; }
            int fi = 0; int fn2 = List_len<Param>(&d.params);
            while (fi < fn2) { sema_check_decl_type(s, List_get<Param>(&d.params, fi).ty); fi = fi + 1; }
            sema_check_fields(s, d);
            int k = 0;
            int mm = List_len<*DeclNode>(&d.methods);
            while (k < mm) {
                sema_check_sig_types(s, List_get<*DeclNode>(&d.methods, k));
                // A generic struct's method bodies are checked per instance (sema_check_insts).
                if (tn == 0) { sema_check_fn(s, List_get<*DeclNode>(&d.methods, k), d.name); }
                k = k + 1;
            }
            List_init<string>(&s.tparams, 4);
        }
        i = i + 1;
    }
    sema_check_insts(s, primary);
    s.filename = primary;
    sema_check_value_cycles(s);
    if (s.had_error == 1) { return 0; }
    return 1;
}
