// Self-hosted semantic analyzer (Phase B of the back-end). Consumes the enriched
// AST (ast.esk). Mirrors sema/type_checker.cpp incrementally.
//
// S0: name resolution — a two-pass walk (register top-level names, then check
// bodies with a scope stack) that catches *undefined variables*. The oracle is the
// verdict (`Type checking succeeded!` / exit code) + the `tests/errors/` EXPECT-ERROR
// substring, like tests/run.sh's negative tests. Types, calls, generics, traits,
// const-correctness, match exhaustiveness, async/escape come in later slices.
//
// Symbol table: a flat list of {name, depth}. Entering a scope bumps `depth`;
// leaving it pops every trailing entry at that depth. Avoids nested-List mutation
// (List_get returns structs by value). Lambda/match-arm/catch bodies are not yet
// walked (they bind names we don't extract yet) — safe: under-checking can't turn a
// clean program's verdict from succeeded to failed.

import <io>;
import <list>;
import <mem>;
import "ast.esk";

struct Sym { string name; string type; int depth; int is_const; }

// Signature of a non-generic top-level function/extern/intrinsic, for arg-count
// checking. `variadic` = trailing `...`; `fixed` = required arg count.
struct FnSig { string name; int fixed; int variadic; }

// One enum variant, for match exhaustiveness.
struct EVar { string en; string variant; }

struct Sema {
    List<Sym> syms;
    List<FnSig> fns;
    List<string> types;     // declared type names (struct/union/interface/enum/alias)
    List<string> structs;   // struct names (subset of types; have fields/methods)
    List<string> members;   // "Struct.member" keys for each struct field AND method
    List<string> enums;     // enum names (for match exhaustiveness)
    List<EVar> evars;       // every enum's variants
    List<*DeclNode> fndecls; // all top-level fn/extern/intrinsic decls (params, type-params)
    List<*DeclNode> ifaces;  // interface decls (their required methods)
    int depth;
    int had_error;
    int in_async;           // currently inside an `async` function body?
    int await_seen;         // has an `await` appeared in the current function?
    string cur_ret;         // current function's return type (for `?` propagation)
    List<string> watched;   // non-escaping fn-type params of the current function
    List<string> escaped;   // watched params seen used beyond a direct call
    string callee_ctx;      // name being called right now (a watched param here is OK)
    string filename;
}

// Mutually-recursive walk.
void sema_expr(Sema* s, *ExprNode e);
void sema_stmt(Sema* s, *StmtNode st);
*DeclNode sema_find_fndecl(Sema* s, string name);   // used by sema_infer_type before its definition

// Substring [a, b) of s (b exclusive), heap-allocated and NUL-terminated.
string sema_sub_str(string s, int a, int b) {
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0; while (k < len) { buf[k] = (uint8)s[a + k]; k = k + 1; }
    buf[len] = 0;
    return (string)buf;
}

int sema_streq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] == b[i]) { return 1; }
    return 0;
}

int sema_is_fn_type(string t) {     // "fn(...)->R"
    if (t[0] == 102 && t[1] == 110 && t[2] == 40) { return 1; }   // 'f','n','('
    return 0;
}

// Strip a leading "const " so a type predicate sees the bare spelling.
string sema_strip_const(string t) {
    if (t[0] == 99 && t[1] == 111 && t[2] == 110 && t[3] == 115 && t[4] == 116 && t[5] == 32) {
        int n = 0; while (t[n] != 0) { n = n + 1; }
        return sema_sub_str(t, 6, n);
    }
    return t;
}

int sema_is_int_ty(string t0) {
    string t = sema_strip_const(t0);
    return sema_streq(t, "int") == 1 || sema_streq(t, "int8") == 1 || sema_streq(t, "int16") == 1
        || sema_streq(t, "int32") == 1 || sema_streq(t, "int64") == 1
        || sema_streq(t, "uint") == 1 || sema_streq(t, "uint8") == 1 || sema_streq(t, "uint16") == 1
        || sema_streq(t, "uint32") == 1 || sema_streq(t, "uint64") == 1
        || sema_streq(t, "char") == 1 || sema_streq(t, "bool") == 1;
}

int sema_is_float_ty(string t0) {
    string t = sema_strip_const(t0);
    return sema_streq(t, "float") == 1 || sema_streq(t, "double") == 1;
}

int sema_is_numeric_ty(string t) { return sema_is_int_ty(t) == 1 || sema_is_float_ty(t) == 1; }

// Array-type helpers (mirror the codegen versions; sema does not import codegen).
int sema_is_arr_ty(string t) {
    int i = 0; while (t[i] != 0) { if ((int)t[i] == 91) { return 1; } i = i + 1; }   // '['
    return 0;
}
int sema_all_digits(string v) {
    if (v[0] == 0) { return 0; }
    int i = 0; while (v[i] != 0) { int c = (int)v[i]; if (c < 48 || c > 57) { return 0; } i = i + 1; }
    return 1;
}
int sema_atoi(string v) {
    int i = 0; int r = 0;
    while (v[i] != 0) { int c = (int)v[i]; if (c < 48 || c > 57) { return r; } r = r * 10 + (c - 48); i = i + 1; }
    return r;
}
// The first `[N]` dimension of an array type ("int[2][3]" → "2"), or "0" if none.
string sema_arr_count(string t) {
    int i = 0; while (t[i] != 0 && (int)t[i] != 91) { i = i + 1; }
    if (t[i] == 0) { return "0"; }
    i = i + 1; int st = i;
    while (t[i] != 0 && (int)t[i] != 93) { i = i + 1; }
    return sema_sub_str(t, st, i);
}
// The element type of an array ("int[2][3]" → "int[3]"): prefix before '[' + suffix after ']'.
string sema_arr_elem(string t) {
    int open = 0; while (t[open] != 0 && (int)t[open] != 91) { open = open + 1; }
    if (t[open] == 0) { return t; }
    int close = open; while (t[close] != 0 && (int)t[close] != 93) { close = close + 1; }
    int tn = 0; while (t[tn] != 0) { tn = tn + 1; }
    string pre = sema_sub_str(t, 0, open);
    string suf = sema_sub_str(t, close + 1, tn);
    return sema_cat(pre, suf);
}

// Pointer-like for comparison: leading/trailing `*`, `string`, or `null` (mirrors C++).
int sema_is_ptrish(string t0) {
    string t = sema_strip_const(t0);
    int n = 0; while (t[n] != 0) { n = n + 1; }
    if (n == 0) { return 0; }
    if (t[0] == 42 || t[n - 1] == 42) { return 1; }   // '*'
    return sema_streq(t, "string") == 1 || sema_streq(t, "null") == 1;
}

// A comparison operator (==, !=, <, >, <=, >=)?
int sema_is_cmp_op(string op) {
    return sema_streq(op, "==") == 1 || sema_streq(op, "!=") == 1
        || sema_streq(op, "<") == 1 || sema_streq(op, ">") == 1
        || sema_streq(op, "<=") == 1 || sema_streq(op, ">=") == 1;
}

// Does a plain decimal integer literal `v` fit target int type `t0`? Mirrors the C++
// intLiteralFits. Conservative: a hex/binary/suffixed literal is treated as fitting (skip).
int sema_int_lit_fits(string t0, string v) {
    string t = sema_strip_const(t0);
    int i = 0; int neg = 0;
    if (v[0] == 45) { neg = 1; i = 1; }               // leading '-'
    if (v[i] == 48 && (v[i + 1] == 120 || v[i + 1] == 88 || v[i + 1] == 98)) { return 1; }  // 0x/0b: skip
    uint64 mag = (uint64)0;
    while (v[i] != 0) {
        int c = (int)v[i];
        if (c < 48 || c > 57) { return 1; }           // non-digit (suffix etc.): skip
        mag = mag * (uint64)10 + (uint64)(c - 48);
        i = i + 1;
    }
    if (sema_streq(t, "int64") == 1 || sema_streq(t, "uint64") == 1) { return 1; }
    if (sema_streq(t, "bool") == 1) { if (neg == 1) { return 0; } if (mag <= (uint64)1) { return 1; } return 0; }
    if (sema_streq(t, "uint8") == 1 || sema_streq(t, "char") == 1) { if (neg == 1) { return 0; } if (mag <= (uint64)255) { return 1; } return 0; }
    if (sema_streq(t, "uint16") == 1) { if (neg == 1) { return 0; } if (mag <= (uint64)65535) { return 1; } return 0; }
    if (sema_streq(t, "uint") == 1 || sema_streq(t, "uint32") == 1) { if (neg == 1) { return 0; } if (mag <= (uint64)4294967295) { return 1; } return 0; }
    if (sema_streq(t, "int8") == 1) { if (neg == 1) { if (mag <= (uint64)128) { return 1; } return 0; } if (mag <= (uint64)127) { return 1; } return 0; }
    if (sema_streq(t, "int16") == 1) { if (neg == 1) { if (mag <= (uint64)32768) { return 1; } return 0; } if (mag <= (uint64)32767) { return 1; } return 0; }
    if (sema_streq(t, "int") == 1 || sema_streq(t, "int32") == 1) { if (neg == 1) { if (mag <= (uint64)2147483648) { return 1; } return 0; } if (mag <= (uint64)2147483647) { return 1; } return 0; }
    return 1;
}

int sema_in_list(List<string>* l, string name) {
    int i = 0; int n = List_len<string>(l);
    while (i < n) { if (sema_streq(List_get<string>(l, i), name) == 1) { return 1; } i = i + 1; }
    return 0;
}

// Emit a semantic error with a fixed message (the port doesn't track positions, hence
// the `:0:0:`) and mark the check failed. Shared by diagnostics that carry no extra args.
void sema_error(Sema* s, string msg) {
    s.had_error = 1;
    printf("error: %s:0:0: %s\n", s.filename, msg);
}

void sema_init(Sema* s, string filename) {
    List_init<Sym>(&s.syms, 64);
    List_init<FnSig>(&s.fns, 32);
    List_init<string>(&s.types, 32);
    List_init<string>(&s.structs, 16);
    List_init<string>(&s.members, 64);
    List_init<string>(&s.enums, 16);
    List_init<EVar>(&s.evars, 32);
    List_init<*DeclNode>(&s.fndecls, 64);
    List_init<*DeclNode>(&s.ifaces, 16);
    s.depth = 0;                           // global scope
    s.had_error = 0;
    s.in_async = 0;
    s.await_seen = 0;
    s.cur_ret = "";
    List_init<string>(&s.watched, 4);
    List_init<string>(&s.escaped, 4);
    s.callee_ctx = "";
    s.filename = filename;
}

void sema_push(Sema* s) { s.depth = s.depth + 1; }

void sema_pop(Sema* s) {
    int d = s.depth;
    while (List_len<Sym>(&s.syms) > 0) {
        Sym last = List_get<Sym>(&s.syms, List_len<Sym>(&s.syms) - 1);
        if (last.depth < d) { break; }
        List_remove<Sym>(&s.syms, List_len<Sym>(&s.syms) - 1);
    }
    s.depth = d - 1;
}

void sema_define(Sema* s, string name, string type, int is_const) {
    let sym: Sym;
    sym.name = name;
    sym.type = type;
    sym.depth = s.depth;
    sym.is_const = is_const;
    List_push<Sym>(&s.syms, sym);
}

// Index of the innermost binding of `name` in the symbol stack, or -1 if unbound.
// The one reverse scan the symbol-table queries below share.
int sema_sym_index(Sema* s, string name) {
    int i = List_len<Sym>(&s.syms) - 1;
    while (i >= 0) {
        if (sema_streq(List_get<Sym>(&s.syms, i).name, name) == 1) { return i; }
        i = i - 1;
    }
    return -1;
}

// Is `name` a read-only (const) binding?
int sema_sym_const(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return 0; }
    return List_get<Sym>(&s.syms, i).is_const;
}

// Scope depth of the innermost binding of `name`, or -1. Depth 0 = a global; a
// function-scope local or parameter is at depth >= 1.
int sema_sym_depth(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return -1; }
    return List_get<Sym>(&s.syms, i).depth;
}

int sema_lookup(Sema* s, string name) {
    if (sema_sym_index(s, name) >= 0) { return 1; }
    return 0;
}

// Declared type of `name` (innermost binding), or "" if unbound / untyped.
string sema_lookup_type(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return ""; }
    return List_get<Sym>(&s.syms, i).type;
}

// Is `name` bound in a local (non-global) scope? The innermost binding wins, so a
// local shadow of a global function means a call should NOT be arg-count-checked
// against the function signature (it could be a fn-pointer variable).
int sema_local_bound(Sema* s, string name) {
    int i = sema_sym_index(s, name);
    if (i < 0) { return 0; }
    if (List_get<Sym>(&s.syms, i).depth > 0) { return 1; }
    return 0;
}

// Is `name` a function declared `must_use`? (Discarding its result is an error.)
int sema_fn_must_use(Sema* s, string name) {
    int i = 0; int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (d.is_mustuse == 1 && sema_streq(d.name, name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Register a non-generic function/extern/intrinsic signature. Generic functions are
// instantiated/inferred, so they get no fixed arg-count check (mirrors the C++
// funcTemplateDecls vs functionSignatures split).
void sema_register_fn(Sema* s, *DeclNode d) {
    if (List_len<TypeParam>(&d.type_params) > 0) { return; }
    let sig: FnSig;
    sig.name = d.name;
    int np = List_len<Param>(&d.params);
    sig.variadic = 0;
    sig.fixed = np;
    if (np > 0) {                          // guard List_get against a -1 index
        string lastty = List_get<Param>(&d.params, np - 1).ty;
        if (sema_streq(lastty, "...") == 1) {
            sig.variadic = 1;
            sig.fixed = np - 1;
        }
    }
    List_push<FnSig>(&s.fns, sig);
}

int sema_find_fn(Sema* s, string name) {
    int i = 0;
    int n = List_len<FnSig>(&s.fns);
    while (i < n) {
        if (sema_streq(List_get<FnSig>(&s.fns, i).name, name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

int sema_is_type(Sema* s, string name) {
    return sema_in_list(&s.types, name);
}

// Leading name of a spelling, up to a generic '<' or payload '(':
// "Box<int>" -> "Box", "A(x)" -> "A", "W" -> "W".
string sema_base_name(string sp) {
    int n = 0;
    while (sp[n] != 0 && (int)sp[n] != 60 && (int)sp[n] != 40) { n = n + 1; }   // '<' or '('
    if ((int)sp[n] == 0) { return sp; }
    *uint8 buf = alloc<uint8>(n + 1);
    int i = 0;
    while (i < n) { buf[i] = (uint8)sp[i]; i = i + 1; }
    buf[n] = 0;
    return (string)buf;
}

string sema_cat(string a, string b) {
    int la = 0; while (a[la] != 0) { la = la + 1; }
    int lb = 0; while (b[lb] != 0) { lb = lb + 1; }
    *uint8 buf = alloc<uint8>(la + lb + 1);
    int i = 0; while (i < la) { buf[i] = (uint8)a[i]; i = i + 1; }
    int j = 0; while (j < lb) { buf[la + j] = (uint8)b[j]; j = j + 1; }
    buf[la + lb] = 0;
    return (string)buf;
}

// Reduce a type spelling to its base struct name: strip leading '*'/spaces and any
// generic '<...>' or pointer suffix. "*Point" -> "Point", "List<int>" -> "List".
string sema_struct_of_type(string t) {
    int i = 0;
    while ((int)t[i] == 42 || (int)t[i] == 32) { i = i + 1; }       // skip '*' / ' '
    int j = i;
    while (t[j] != 0 && (int)t[j] != 60 && (int)t[j] != 42 && (int)t[j] != 32) { j = j + 1; }
    int len = j - i;
    *uint8 buf = alloc<uint8>(len + 1);
    int k = 0; while (k < len) { buf[k] = (uint8)t[i + k]; k = k + 1; }
    buf[len] = 0;
    return (string)buf;
}

int sema_is_struct(Sema* s, string name) {
    return sema_in_list(&s.structs, name);
}

int sema_has_member(Sema* s, string key) {   // key = "Struct.member"
    return sema_in_list(&s.members, key);
}

int sema_is_enum(Sema* s, string name) {
    return sema_in_list(&s.enums, name);
}

// Best-effort string type of an expression ("" = unknown). Grows per slice; for now
// only identifiers (via the symbol table) resolve — enough to validate `ident.field`.
string sema_infer_type(Sema* s, *ExprNode e) {
    if (e == null) { return ""; }
    if (e.kind == EK_IDENT) {
        string vt = sema_lookup_type(s, e.sval);
        if (vt[0] != 0) { return vt; }                      // a variable / param with a known type
        *DeclNode ff = sema_find_fndecl(s, e.sval);         // else maybe a bare function used as a value
        if (ff != null && ff.is_async == 0) {               // build its "fn(params)->ret" spelling (parser form)
            string ft = "fn(";
            int i = 0; int np = List_len<Param>(&ff.params);
            while (i < np) {
                if (i > 0) { ft = sema_cat(ft, ","); }
                ft = sema_cat(ft, List_get<Param>(&ff.params, i).ty);
                i = i + 1;
            }
            return sema_cat(sema_cat(ft, ")->"), ff.ret_type);
        }
        return "";
    }
    if (e.kind == EK_LITERAL) {
        if (e.lit_kind == LIT_INT) { return "int"; }
        if (e.lit_kind == LIT_FLOAT) { return "double"; }
        if (e.lit_kind == LIT_STRING) { return "string"; }
        if (e.lit_kind == LIT_CHAR) { return "char"; }
        if (e.lit_kind == LIT_BOOL) { return "bool"; }
        if (e.lit_kind == LIT_NULL) { return "null"; }
        return "";
    }
    if (e.kind == EK_CALL && e.a != null && e.a.kind == EK_IDENT) {   // direct call → callee's return type
        *DeclNode fd = sema_find_fndecl(s, e.a.sval);
        if (fd != null) {
            if (fd.is_async == 1) { return ""; }   // an async call yields a Future<T>, not the declared inner type
            return fd.ret_type;
        }
    }
    if (e.kind == EK_UNARY) {
        if (sema_streq(e.sval, "&") == 1) {                 // address-of → pointer, const-tracking
            string bt = sema_infer_type(s, e.a);
            if (bt[0] == 0) { return ""; }
            if (sema_is_readonly_lvalue(s, e.a) == 1) { return sema_cat("const ", sema_cat(bt, "*")); }
            return sema_cat(bt, "*");
        }
        if (sema_streq(e.sval, "!") == 1) { return "bool"; }
    }
    if (e.kind == EK_INDEX) {                            // arr[i] → element type (arrays only for now)
        string bt = sema_infer_type(s, e.a);
        if (sema_is_arr_ty(bt) == 1) { return sema_arr_elem(bt); }
    }
    return "";
}

// Recursively check an array literal against a (possibly multi-dimensional) array type:
// too many elements for a numeric dimension is an error; a short list zero-fills (C-style).
void sema_check_arr_init(Sema* s, string arrT, *ExprNode a) {
    if (sema_is_arr_ty(arrT) == 0) { return; }
    string dim = sema_arr_count(arrT);
    if (sema_all_digits(dim) == 1) {
        int cnt = List_len<*ExprNode>(&a.kids);
        if (cnt > sema_atoi(dim)) {
            s.had_error = 1;
            printf("error: %s:0:0: array literal has %d elements but '%s' holds %s\n", s.filename, cnt, arrT, dim);
        }
    }
    string elemT = sema_arr_elem(arrT);
    if (sema_is_arr_ty(elemT) == 1) {                   // nested rows: each element is itself an array literal
        int i = 0; int n = List_len<*ExprNode>(&a.kids);
        while (i < n) {
            *ExprNode el = List_get<*ExprNode>(&a.kids, i);
            if (el.kind == EK_ARRAYLIT) { sema_check_arr_init(s, elemT, el); }
            i = i + 1;
        }
    }
}

int sema_has_star(string t) {
    int i = 0;
    while (t[i] != 0) { if ((int)t[i] == 42) { return 1; } i = i + 1; }   // 42 = '*'
    return 0;
}

// Pointer-to-const: spelling starts with "const " and is a pointer (e.g. "const int*").
int sema_pointee_const(string t) {
    if (t[0] != 99 || t[1] != 111 || t[2] != 110 || t[3] != 115
        || t[4] != 116 || t[5] != 32) { return 0; }     // not "const "
    return sema_has_star(t);
}

// An integer-literal spelling that denotes zero (only sign chars and '0' digits).
int sema_lit_is_zero(string v) {
    int i = 0;
    if (v[0] == 0) { return 0; }
    while (v[i] != 0) {
        int c = (int)v[i];
        if (c != 48 && c != 43 && c != 45) { return 0; }   // not '0' / '+' / '-'
        i = i + 1;
    }
    return 1;
}

int sema_is_assign(string op) {
    if (sema_streq(op, "=") == 1) { return 1; }
    if (sema_streq(op, "+=") == 1 || sema_streq(op, "-=") == 1 || sema_streq(op, "*=") == 1
        || sema_streq(op, "/=") == 1 || sema_streq(op, "%=") == 1) { return 1; }
    return 0;
}

// Is the assignment target a read-only location? A const binding, or a field/element
// reached through one (a const struct's members are read-only). Pointee-const through
// a deref is a later slice.
int sema_is_readonly_lvalue(Sema* s, *ExprNode e) {
    if (e == null) { return 0; }
    if (e.kind == EK_IDENT) { return sema_sym_const(s, e.sval); }
    if (e.kind == EK_MEMBER || e.kind == EK_INDEX) { return sema_is_readonly_lvalue(s, e.a); }
    // `*p` writes through a pointer — read-only when p points to const.
    if (e.kind == EK_UNARY && sema_streq(e.sval, "*") == 1) {
        return sema_pointee_const(sema_infer_type(s, e.a));
    }
    return 0;
}

// Owned substring s[a, b) with leading/trailing spaces trimmed.
string sema_trim_sub(string s, int a, int b) {
    while (a < b && (int)s[a] == 32) { a = a + 1; }
    while (b > a && (int)s[b - 1] == 32) { b = b - 1; }
    int len = b - a;
    *uint8 buf = alloc<uint8>(len + 1);
    int i = 0; while (i < len) { buf[i] = (uint8)s[a + i]; i = i + 1; }
    buf[len] = 0;
    return (string)buf;
}

*DeclNode sema_find_fndecl(Sema* s, string name) {
    int i = 0; int n = List_len<*DeclNode>(&s.fndecls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.fndecls, i);
        if (sema_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

*DeclNode sema_find_iface(Sema* s, string name) {
    int i = 0; int n = List_len<*DeclNode>(&s.ifaces);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&s.ifaces, i);
        if (sema_streq(d.name, name) == 1) { return d; }
        i = i + 1;
    }
    return null;
}

int sema_is_scalar_prim(string c) {
    if (sema_streq(c, "int") == 1 || sema_streq(c, "int8") == 1 || sema_streq(c, "int16") == 1
        || sema_streq(c, "int32") == 1 || sema_streq(c, "int64") == 1 || sema_streq(c, "uint") == 1
        || sema_streq(c, "uint8") == 1 || sema_streq(c, "uint16") == 1 || sema_streq(c, "uint32") == 1
        || sema_streq(c, "uint64") == 1 || sema_streq(c, "char") == 1 || sema_streq(c, "bool") == 1
        || sema_streq(c, "float") == 1 || sema_streq(c, "double") == 1) { return 1; }
    return 0;
}

// Does concrete type `c` satisfy interface `iface_name`? A struct satisfies via a
// real method `c.method`; a scalar primitive may satisfy via a free function named
// `method` whose first parameter is `c` (mirrors structSatisfiesInterface). Unknown
// interface → treat as satisfied (don't false-positive).
int sema_satisfies(Sema* s, string c, string iface_name) {
    *DeclNode iface = sema_find_iface(s, iface_name);
    if (iface == null) { return 1; }
    int prim = sema_is_scalar_prim(c);
    int i = 0; int n = List_len<*DeclNode>(&iface.methods);
    while (i < n) {
        string m = List_get<*DeclNode>(&iface.methods, i).name;
        int ok = 0;
        if (sema_has_member(s, sema_cat(sema_cat(c, "."), m)) == 1) { ok = 1; }   // struct method
        if (ok == 0 && prim == 1) {                                               // free-fn fallback
            *DeclNode ff = sema_find_fndecl(s, m);
            if (ff != null && List_len<Param>(&ff.params) > 0) {
                if (sema_streq(sema_struct_of_type(List_get<Param>(&ff.params, 0).ty), c) == 1) { ok = 1; }
            }
        }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Extract the type arguments of a template-call spelling ("pick<int>" → ["int"],
// "Map<string, int>" → ["string","int"]), tracking nesting and trimming spaces.
void sema_parse_targs(string sval, List<string>* out) {
    int i = 0;
    while (sval[i] != 0 && (int)sval[i] != 60) { i = i + 1; }   // find '<'
    if (sval[i] == 0) { return; }
    i = i + 1;
    int depth = 0;
    int start = i;
    while (sval[i] != 0) {
        int c = (int)sval[i];
        if (c == 60) { depth = depth + 1; }
        else if (c == 62) { if (depth == 0) { break; } depth = depth - 1; }
        else if (c == 44 && depth == 0) {
            List_push<string>(out, sema_trim_sub(sval, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if (i > start) { List_push<string>(out, sema_trim_sub(sval, start, i)); }
}

// ── expression walk ──

void sema_expr(Sema* s, *ExprNode e) {
    if (e == null) { return; }
    int k = e.kind;
    if (k == EK_IDENT) {
        // va_start/va_end are variadic-access builtins with no declaration (va_arg<T> is a
        // template call). Treat them as defined, matching the C++ checker.
        if (sema_lookup(s, e.sval) == 0
            && sema_streq(e.sval, "va_start") == 0 && sema_streq(e.sval, "va_end") == 0) {
            s.had_error = 1;
            printf("error: %s:0:0: undefined variable '%s'\n", s.filename, e.sval);
        }
        // Escape soundness: a non-escaping closure param used anywhere but as the
        // immediate callee of a call escapes.
        if (sema_in_list(&s.watched, e.sval) == 1 && sema_streq(e.sval, s.callee_ctx) == 0) {
            if (sema_in_list(&s.escaped, e.sval) == 0) { List_push<string>(&s.escaped, e.sval); }
        }
        return;
    }
    if (k == EK_LITERAL || k == EK_SIZEOF) { return; }
    if (k == EK_BINARY) {
        if (sema_is_assign(e.sval) == 1 && sema_is_readonly_lvalue(s, e.a) == 1) {
            sema_error(s, "cannot assign to read-only location");
        }
        // Division / remainder by a literal zero is a guaranteed runtime trap.
        if ((sema_streq(e.sval, "/") == 1 || sema_streq(e.sval, "%") == 1)
            && e.b != null && e.b.kind == EK_LITERAL && e.b.lit_kind == LIT_INT
            && sema_lit_is_zero(e.b.sval) == 1) {
            if (sema_streq(e.sval, "/") == 1) { sema_error(s, "division by zero"); }
            else { sema_error(s, "remainder by zero"); }
        }
        // Comparison operands must be mutually comparable: both numeric, both pointer-like
        // (incl. null), or the same non-aggregate type. Conservative: only flag when both
        // operand types are known (unknown → skip, never falsely reject).
        if (sema_is_cmp_op(e.sval) == 1) {
            string lt = sema_infer_type(s, e.a);
            string rt = sema_infer_type(s, e.b);
            if (lt[0] != 0 && rt[0] != 0 && sema_streq(lt, "unknown") == 0 && sema_streq(rt, "unknown") == 0) {
                int ok = 0;
                if (sema_is_numeric_ty(lt) == 1 && sema_is_numeric_ty(rt) == 1) { ok = 1; }
                else if (sema_is_ptrish(lt) == 1 && sema_is_ptrish(rt) == 1) { ok = 1; }
                else if (sema_streq(lt, rt) == 1 && sema_is_struct(s, sema_base_name(lt)) == 0) { ok = 1; }
                if (ok == 0) { sema_error(s, "invalid operands for operator"); }
            }
        }
        sema_expr(s, e.a); sema_expr(s, e.b); return;
    }
    if (k == EK_INCDEC) {                              // ++x / x++ etc.
        // The operand must be a modifiable lvalue: an ident, field, element, or deref
        // (not a literal or other rvalue like `5++`).
        if (e.a == null || (e.a.kind != EK_IDENT && e.a.kind != EK_MEMBER && e.a.kind != EK_INDEX
            && (e.a.kind != EK_UNARY || sema_streq(e.a.sval, "*") == 0))) {
            sema_error(s, "'++'/'--' requires a modifiable variable");
        } else if (sema_is_readonly_lvalue(s, e.a) == 1) {
            sema_error(s, "cannot modify read-only location");
        }
        sema_expr(s, e.a); return;
    }
    if (k == EK_ARRAYLIT) {                            // { e0, e1, ... }
        int i = 0; int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    if (k == EK_TERNARY) {                             // cond ? then : else
        sema_expr(s, e.a);
        sema_expr(s, e.b);
        *ExprNode elseE = List_get<*ExprNode>(&e.kids, 0);
        sema_expr(s, elseE);
        // The two arms need a common type: same, both numeric, or both pointer-like.
        // Conservative: only flag when both arm types are known.
        string tt = sema_infer_type(s, e.b);
        string et = sema_infer_type(s, elseE);
        if (tt[0] != 0 && et[0] != 0 && sema_streq(tt, "unknown") == 0 && sema_streq(et, "unknown") == 0) {
            int ok = 0;
            if (sema_streq(tt, et) == 1) { ok = 1; }
            else if (sema_is_numeric_ty(tt) == 1 && sema_is_numeric_ty(et) == 1) { ok = 1; }
            else if (sema_is_ptrish(tt) == 1 && sema_is_ptrish(et) == 1) { ok = 1; }
            if (ok == 0) { sema_error(s, "ternary branches have incompatible types"); }
        }
        return;
    }
    if (k == EK_AWAIT) {
        if (s.in_async == 0) {
            sema_error(s, "await is only allowed inside an async function");
        }
        s.await_seen = 1;
        sema_expr(s, e.a);
        return;
    }
    if (k == EK_MEMBER) {
        sema_expr(s, e.a);                 // walk base (catches undefined vars in it)
        string bt = sema_infer_type(s, e.a);
        if (bt[0] != 0) {                  // base type known → validate the member
            string sn = sema_struct_of_type(bt);
            if (sema_is_struct(s, sn) == 1 && sema_has_member(s, sema_cat(sema_cat(sn, "."), e.sval)) == 0) {
                s.had_error = 1;
                printf("error: %s:0:0: struct '%s' has no member '%s'\n", s.filename, sn, e.sval);
            }
        }
        return;
    }
    if (k == EK_QUESTION) {            // `expr?` propagates an Err into the enclosing function
        sema_expr(s, e.a);
        // The enclosing function must return the SAME Result-like type as the operand
        // (a struct with `ok`/`value` fields; the type name, not a literal "Result"). The
        // self-host tracks struct names but not fields, so it compares the struct names and
        // skips when either is unknown (matching C++'s ret == operand-type check).
        string opn = sema_struct_of_type(sema_infer_type(s, e.a));
        string retn = sema_struct_of_type(s.cur_ret);
        if (opn[0] != 0 && retn[0] != 0 && sema_streq(opn, retn) == 0) {
            sema_error(s, "`?` can only be used in a function returning the same Result type");
        }
        return;
    }
    if (k == EK_UNARY || k == EK_CAST
        || k == EK_FREECLOSURE || k == EK_THREADCREATE) {
        sema_expr(s, e.a);
        return;
    }
    if (k == EK_INDEX || k == EK_ALLOCWITH) {
        // Constant-index bounds check on a fixed array with a numeric dimension.
        if (k == EK_INDEX && e.b != null && e.b.kind == EK_LITERAL && e.b.lit_kind == LIT_INT
            && sema_all_digits(e.b.sval) == 1) {
            string bt = sema_infer_type(s, e.a);
            if (sema_is_arr_ty(bt) == 1) {
                string dim = sema_arr_count(bt);
                if (sema_all_digits(dim) == 1 && sema_atoi(e.b.sval) >= sema_atoi(dim)) {
                    s.had_error = 1;
                    printf("error: %s:0:0: array index %s is out of bounds for array of size %s\n", s.filename, e.b.sval, dim);
                }
            }
        }
        sema_expr(s, e.a); sema_expr(s, e.b); return;
    }
    if (k == EK_CALL) {
        // arg-count check: only when the callee is a bare global function (not a local
        // fn-pointer var, not an ADT variant, not a generic — those resolve elsewhere).
        if (e.a != null && e.a.kind == EK_IDENT && sema_local_bound(s, e.a.sval) == 0) {
            int fi = sema_find_fn(s, e.a.sval);
            if (fi >= 0) {
                FnSig sig = List_get<FnSig>(&s.fns, fi);
                int argc = List_len<*ExprNode>(&e.kids);
                if (sig.variadic == 1) {
                    if (argc < sig.fixed) {
                        s.had_error = 1;
                        printf("error: %s:0:0: function '%s' expects at least %d arguments, got %d\n",
                               s.filename, e.a.sval, sig.fixed, argc);
                    }
                } else if (argc != sig.fixed) {
                    s.had_error = 1;
                    printf("error: %s:0:0: function '%s' expects %d arguments, got %d\n",
                           s.filename, e.a.sval, sig.fixed, argc);
                }
            }
        }
        string prev = s.callee_ctx;        // mark the callee so a watched param here is OK
        if (e.a != null && e.a.kind == EK_IDENT) { s.callee_ctx = e.a.sval; }
        else { s.callee_ctx = ""; }
        sema_expr(s, e.a);                 // callee (functions live in the global scope)
        s.callee_ctx = prev;
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    if (k == EK_STRUCTINIT) {
        string base = sema_base_name(e.sval);
        if (sema_is_type(s, base) == 0) {
            s.had_error = 1;
            printf("error: %s:0:0: undefined struct '%s'\n", s.filename, base);
        }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    if (k == EK_TEMPLATECALL) {        // Name<args>(...) — check bounded-generic constraints
        *DeclNode fd = sema_find_fndecl(s, sema_base_name(e.sval));
        if (fd != null) {
            List<string> targs;
            List_init<string>(&targs, 4);
            sema_parse_targs(e.sval, &targs);
            int tn = List_len<TypeParam>(&fd.type_params);
            int na = List_len<string>(&targs);
            int ti = 0;
            while (ti < tn && ti < na) {
                TypeParam tp = List_get<TypeParam>(&fd.type_params, ti);
                string concrete = List_get<string>(&targs, ti);
                int ci = 0;
                int cn = List_len<string>(&tp.constraints);
                while (ci < cn) {
                    string ic = List_get<string>(&tp.constraints, ci);
                    if (sema_satisfies(s, concrete, ic) == 0) {
                        s.had_error = 1;
                        printf("error: %s:0:0: type '%s' does not satisfy constraint '%s'\n",
                               s.filename, concrete, ic);
                    }
                    ci = ci + 1;
                }
                ti = ti + 1;
            }
        }
        int i = 0;
        int n = List_len<*ExprNode>(&e.kids);
        while (i < n) { sema_expr(s, List_get<*ExprNode>(&e.kids, i)); i = i + 1; }
        return;
    }
    // EK_LAMBDA: body params aren't extracted yet → skip (S0 under-check, no false error).
}

// ── statement walk ──

// A defer body runs during scope-exit cleanup, so it may not transfer control out of
// itself: a `return`, or a `break`/`continue` not enclosed by a loop/switch *within* the
// body, would jump to a target that is gone. `depth` counts loops/switches inside the body.
void sema_defer_walk(Sema* s, *StmtNode st, int depth) {
    if (st == null) { return; }
    int k = st.kind;
    if (k == SK_RETURN) {
        s.had_error = 1;
        printf("error: %s:0:0: 'return' is not allowed inside a defer body\n", s.filename);
        return;
    }
    if ((k == SK_BREAK || k == SK_CONTINUE) && depth == 0) {
        s.had_error = 1;
        printf("error: %s:0:0: 'break'/'continue' inside a defer body may not escape it\n", s.filename);
        return;
    }
    if (k == SK_BLOCK) {
        int i = 0; int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_defer_walk(s, List_get<*StmtNode>(&st.items, i), depth); i = i + 1; }
        return;
    }
    if (k == SK_IF) { sema_defer_walk(s, st.s1, depth); sema_defer_walk(s, st.s2, depth); return; }
    if (k == SK_WHILE || k == SK_DOWHILE || k == SK_FORIN) { sema_defer_walk(s, st.s1, depth + 1); return; }
    if (k == SK_FOR) { sema_defer_walk(s, st.s2, depth + 1); return; }   // s2 = for body
    if (k == SK_SWITCH) {
        int i = 0; int n = List_len<*StmtNode>(&st.items);
        while (i < n) {
            *StmtNode c = List_get<*StmtNode>(&st.items, i);
            int j = 0; int m = List_len<*StmtNode>(&c.items);
            while (j < m) { sema_defer_walk(s, List_get<*StmtNode>(&c.items, j), depth + 1); j = j + 1; }
            i = i + 1;
        }
        return;
    }
    if (k == SK_DEFER) { sema_defer_walk(s, st.s1, depth); return; }
}

void sema_stmt(Sema* s, *StmtNode st) {
    if (st == null) { return; }
    int k = st.kind;
    if (k == SK_BLOCK) {
        sema_push(s);
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        sema_pop(s);
        return;
    }
    if (k == SK_VARDECL) {
        sema_expr(s, st.expr);             // initializer (can't reference itself)
        if (st.expr != null && st.expr.kind == EK_ARRAYLIT && sema_is_arr_ty(st.type) == 1) {
            sema_check_arr_init(s, st.type, st.expr);   // too many elements for the fixed size
        }
        if (st.is_static == 1 && st.expr != null && st.expr.kind != EK_LITERAL) {
            sema_error(s, "a 'static' local's initializer must be a constant");
        }
        if (st.is_const == 1 && st.expr == null) {
            s.had_error = 1;
            printf("error: %s:0:0: const '%s' must be initialized\n", s.filename, st.name);
        }
        // Initializing a non-const pointer from a pointer-to-const drops const.
        if (st.expr != null && sema_has_star(st.type) == 1 && sema_pointee_const(st.type) == 0) {
            if (sema_pointee_const(sema_infer_type(s, st.expr)) == 1) {
                sema_error(s, "initialization discards a const qualifier");
            }
        }
        // Initializer type compatibility. Conservative: only flag a conversion the C++
        // checker also rejects, defaulting to OK when the source type is unknown (so a
        // valid program is never falsely rejected). Mirrors assignabilityError's error cases.
        if (st.expr != null && st.type[0] != 0) {
            if (sema_is_int_ty(st.type) == 1 && st.expr.kind == EK_LITERAL
                && st.expr.lit_kind == LIT_INT && sema_int_lit_fits(st.type, st.expr.sval) == 0) {
                s.had_error = 1;
                printf("error: %s:0:0: integer literal %s is out of range for '%s'\n", s.filename, st.expr.sval, st.type);
            } else {
                string src = sema_infer_type(s, st.expr);
                if (src[0] != 0 && sema_streq(src, "unknown") == 0 && sema_streq(src, st.type) == 0) {
                    if (sema_is_int_ty(st.type) == 1 && sema_is_float_ty(src) == 1) {
                        sema_error(s, "cannot assign a floating-point value to an integer type without an explicit cast (it drops the fraction)");
                    } else if (sema_streq(src, "string") == 1 && (sema_is_int_ty(st.type) == 1 || sema_is_float_ty(st.type) == 1)) {
                        sema_error(s, "cannot convert 'string' to a numeric type");
                    } else if (sema_streq(src, "void") == 1 && sema_streq(st.type, "void") == 0) {
                        sema_error(s, "cannot convert a 'void' value");
                    } else if (sema_is_fn_type(st.type) == 1 && sema_is_fn_type(src) == 1) {
                        sema_error(s, "incompatible function type");   // src != st.type (guarded above)
                    }
                }
            }
        }
        sema_define(s, st.name, st.type, st.is_const);
        return;
    }
    if (k == SK_RETURN) {
        sema_expr(s, st.expr);
        // Returning `&local`/`&param` yields a dangling pointer (its frame is gone). Only
        // the clear bare-ident case is flagged; `&arr[i]`/`&p.field` point into other memory.
        if (st.expr != null && st.expr.kind == EK_UNARY && sema_streq(st.expr.sval, "&") == 1
            && st.expr.a != null && st.expr.a.kind == EK_IDENT
            && sema_sym_depth(s, st.expr.a.sval) >= 1) {
            s.had_error = 1;
            printf("error: %s:0:0: returning the address of local '%s' (dangling pointer)\n", s.filename, st.expr.a.sval);
        }
        return;
    }
    if (k == SK_THROW) { sema_expr(s, st.expr); return; }
    if (k == SK_THREADJOIN) { sema_expr(s, st.expr); return; }
    if (k == SK_EXPR) {
        sema_expr(s, st.expr);
        // A bare call to a must_use function discards its result — reject it.
        *ExprNode ex = st.expr;
        string fname = "";
        if (ex != null && ex.kind == EK_CALL && ex.a != null && ex.a.kind == EK_IDENT) {
            fname = ex.a.sval;
        } else if (ex != null && ex.kind == EK_TEMPLATECALL) {
            int j = 0; while (ex.sval[j] != 0 && (int)ex.sval[j] != 60) { j = j + 1; }   // up to '<'
            fname = sema_sub_str(ex.sval, 0, j);
        }
        if (fname[0] != 0 && sema_fn_must_use(s, fname) == 1) {
            s.had_error = 1;
            printf("error: %s:0:0: result of '%s' must be used (it is marked must_use)\n", s.filename, fname);
        }
        return;
    }
    if (k == SK_IF) {
        sema_expr(s, st.expr);
        sema_stmt(s, st.s1);
        sema_stmt(s, st.s2);
        return;
    }
    if (k == SK_WHILE) { sema_expr(s, st.expr); sema_stmt(s, st.s1); return; }
    if (k == SK_DOWHILE) { sema_stmt(s, st.s1); sema_expr(s, st.expr); return; }
    if (k == SK_FOR) {
        sema_push(s);                      // init var stays in scope for cond/step/body
        // The init is wrapped in a BlockStmt; walk its items in the FOR scope rather
        // than via sema_stmt (which would push/pop a sub-scope and drop the loop var).
        if (st.s1 != null && st.s1.kind == SK_BLOCK) {
            int i = 0;
            int n = List_len<*StmtNode>(&st.s1.items);
            while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.s1.items, i)); i = i + 1; }
        } else {
            sema_stmt(s, st.s1);
        }
        sema_expr(s, st.expr);
        sema_expr(s, st.expr2);
        sema_stmt(s, st.s2);
        sema_pop(s);
        return;
    }
    if (k == SK_FORIN) {
        sema_push(s);
        sema_expr(s, st.expr);             // iterable (loop var not yet in scope)
        sema_define(s, st.name, "", 0);       // element type not inferred yet
        sema_stmt(s, st.s1);
        sema_pop(s);
        return;
    }
    if (k == SK_BREAK || k == SK_CONTINUE) { return; }
    if (k == SK_SWITCH || k == SK_MATCH) {
        sema_expr(s, st.expr);             // subject
        if (k == SK_SWITCH) {
            // Duplicate case values: compare literal/ident text (under-detects across
            // different spellings of the same value, but never false-positives).
            List<string> seen;
            List_init<string>(&seen, 8);
            int ci = 0;
            int cn = List_len<*StmtNode>(&st.items);
            while (ci < cn) {
                *StmtNode c = List_get<*StmtNode>(&st.items, ci);
                if (c.kind == SK_CASE && c.expr != null
                    && (c.expr.kind == EK_LITERAL || c.expr.kind == EK_IDENT)) {
                    string key = c.expr.sval;
                    int found = sema_in_list(&seen, key);
                    if (found == 1) {
                        sema_error(s, "duplicate case value in switch");
                    } else {
                        List_push<string>(&seen, key);
                    }
                }
                ci = ci + 1;
            }
        }
        if (k == SK_MATCH) {
            // Collect arm variants (label is "Variant(binds)" or "_"), catching dups
            // and noting a `_` wildcard, then check exhaustiveness.
            List<string> seen;
            List_init<string>(&seen, 8);
            int has_wild = 0;
            int ai = 0;
            int an = List_len<*StmtNode>(&st.items);
            while (ai < an) {
                *StmtNode arm = List_get<*StmtNode>(&st.items, ai);
                if (arm.kind == SK_ARM) {
                    string v = sema_base_name(arm.name);
                    if (sema_streq(v, "_") == 1) { has_wild = 1; }
                    int found = sema_in_list(&seen, v);
                    if (found == 1) {
                        s.had_error = 1;
                        printf("error: %s:0:0: duplicate match arm for variant '%s'\n", s.filename, v);
                    } else {
                        List_push<string>(&seen, v);
                    }
                }
                ai = ai + 1;
            }
            // Exhaustiveness: without `_`, every variant of the subject's enum must
            // be covered. Skip if the subject type/enum can't be determined.
            if (has_wild == 0) {
                string sty = sema_struct_of_type(sema_infer_type(s, st.expr));
                if (sema_is_enum(s, sty) == 1) {
                    int reported = 0;
                    int ei = 0;
                    int en = List_len<EVar>(&s.evars);
                    while (ei < en) {
                        EVar ev = List_get<EVar>(&s.evars, ei);
                        if (reported == 0 && sema_streq(ev.en, sty) == 1) {
                            int covered = sema_in_list(&seen, ev.variant);
                            if (covered == 0) {
                                s.had_error = 1;
                                printf("error: %s:0:0: non-exhaustive match on '%s': missing '%s'\n",
                                       s.filename, sty, ev.variant);
                                reported = 1;
                            }
                        }
                        ei = ei + 1;
                    }
                }
            }
        }
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        return;
    }
    if (k == SK_CASE) {
        sema_expr(s, st.expr);             // case value (null for default)
        sema_push(s);
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_stmt(s, List_get<*StmtNode>(&st.items, i)); i = i + 1; }
        sema_pop(s);
        return;
    }
    if (k == SK_TRY) {
        sema_stmt(s, st.s1);               // body
        // catch clauses (items) bind names we don't extract yet → skip their bodies
        sema_stmt(s, st.s2);               // finally
        return;
    }
    if (k == SK_DEFER) {
        sema_defer_walk(s, st.s1, 0);      // no return / escaping break|continue in a defer body
        sema_stmt(s, st.s1);               // deferred body
        return;
    }
    if (k == SK_ASM) {
        int i = 0;
        int n = List_len<*StmtNode>(&st.items);
        while (i < n) { sema_expr(s, List_get<*StmtNode>(&st.items, i).expr); i = i + 1; }
        return;
    }
    // SK_ARM / SK_CATCH bodies: not walked in S0 (bindings not yet extracted).
}

// ── entry ──

// Register top-level names that can be referenced as a bare identifier: functions,
// externs, intrinsics, global vars, and enum members (constants / variant ctors).
void sema_register_globals(Sema* s, *Program prog) {
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION || d.kind == DK_EXTERN
            || d.kind == DK_INTRINSIC || d.kind == DK_VARDECL) {
            string gty = "";
            if (d.kind == DK_VARDECL) { gty = d.ret_type; }   // global var's type
            sema_define(s, d.name, gty, d.is_const);
        }
        if (d.kind == DK_FUNCTION || d.kind == DK_EXTERN || d.kind == DK_INTRINSIC) {
            sema_register_fn(s, d);
            List_push<*DeclNode>(&s.fndecls, d);
        }
        if (d.kind == DK_INTERFACE) { List_push<*DeclNode>(&s.ifaces, d); }
        if (d.kind == DK_STRUCT || d.kind == DK_UNION || d.kind == DK_INTERFACE
            || d.kind == DK_ENUM || d.kind == DK_TYPEALIAS) {
            List_push<string>(&s.types, d.name);
        }
        if (d.kind == DK_STRUCT) {
            List_push<string>(&s.structs, d.name);
            int fi = 0;                                       // fields are valid members
            int fn2 = List_len<Param>(&d.params);
            while (fi < fn2) {
                List_push<string>(&s.members, sema_cat(sema_cat(d.name, "."), List_get<Param>(&d.params, fi).name));
                fi = fi + 1;
            }
            int mi = 0;                                       // methods are valid members too
            int mn = List_len<*DeclNode>(&d.methods);
            while (mi < mn) {
                List_push<string>(&s.members, sema_cat(sema_cat(d.name, "."), List_get<*DeclNode>(&d.methods, mi).name));
                mi = mi + 1;
            }
        }
        if (d.kind == DK_ENUM) {
            List_push<string>(&s.enums, d.name);
            int j = 0;
            int m = List_len<Param>(&d.params);
            while (j < m) {
                string vn = List_get<Param>(&d.params, j).name;
                sema_define(s, vn, "", 0);
                let ev: EVar; ev.en = d.name; ev.variant = vn;
                List_push<EVar>(&s.evars, ev);
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// ── Definite-return analysis (mirrors sema/typecheck_decl.cpp) ───────────────
// A non-void function must return, throw, or provably diverge on every path;
// falling off the end is an error, not an implicit zero return.

// Is `c` a literal that is always true? (`while(1)`, `while(true)`, `for(;;)`)
int sema_cond_true(*ExprNode c) {
    if (c == null) { return 1; }                       // for(;;)
    if (c.kind != EK_LITERAL) { return 0; }
    if (c.lit_kind == LIT_BOOL) { return sema_streq(c.sval, "true"); }
    if (c.lit_kind == LIT_INT)  { if (sema_streq(c.sval, "0") == 1) { return 0; } return 1; }
    return 0;
}

int sema_always_returns(*StmtNode s);

// Does `s` hold a `break` that exits the enclosing loop (not one swallowed by a
// nested loop or switch)?
int sema_has_break(*StmtNode s) {
    if (s == null) { return 0; }
    if (s.kind == SK_BREAK) { return 1; }
    if (s.kind == SK_BLOCK) {
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_has_break(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    if (s.kind == SK_IF) {
        if (sema_has_break(s.s1) == 1) { return 1; }
        return sema_has_break(s.s2);
    }
    // Nested loops and switch capture their own break — do not descend.
    if (s.kind == SK_WHILE) { return 0; }
    if (s.kind == SK_DOWHILE) { return 0; }
    if (s.kind == SK_FOR)   { return 0; }
    if (s.kind == SK_FORIN) { return 0; }
    if (s.kind == SK_SWITCH){ return 0; }
    if (s.kind == SK_MATCH) {                           // match is not a loop
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_has_break(List_get<*StmtNode>(&s.items, i).s1) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    if (s.kind == SK_TRY) {
        if (sema_has_break(s.s1) == 1) { return 1; }
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_has_break(List_get<*StmtNode>(&s.items, i).s1) == 1) { return 1; } i = i + 1; }
        return sema_has_break(s.s2);
    }
    return 0;
}

// Does executing `s` guarantee control does not fall through (returns, throws,
// or provably diverges)? Conservative: anything it cannot prove returns 0.
int sema_always_returns(*StmtNode s) {
    if (s == null) { return 0; }
    if (s.kind == SK_RETURN) { return 1; }
    if (s.kind == SK_THROW)  { return 1; }
    if (s.kind == SK_BLOCK) {
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_always_returns(List_get<*StmtNode>(&s.items, i)) == 1) { return 1; } i = i + 1; }
        return 0;
    }
    if (s.kind == SK_IF) {
        if (s.s2 == null) { return 0; }
        if (sema_always_returns(s.s1) == 0) { return 0; }
        return sema_always_returns(s.s2);
    }
    if (s.kind == SK_WHILE) {
        if (sema_cond_true(s.expr) == 1 && sema_has_break(s.s1) == 0) { return 1; }
        return 0;
    }
    if (s.kind == SK_DOWHILE) {                         // body runs at least once
        if (sema_always_returns(s.s1) == 1) { return 1; }
        if (sema_cond_true(s.expr) == 1 && sema_has_break(s.s1) == 0) { return 1; }
        return 0;
    }
    if (s.kind == SK_FOR) {                             // body is s2 (s1 is init)
        if (sema_cond_true(s.expr) == 1 && sema_has_break(s.s2) == 0) { return 1; }
        return 0;
    }
    if (s.kind == SK_FORIN) { return 0; }               // may iterate zero times
    if (s.kind == SK_SWITCH) {
        int has_default = 0;
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) {
            *StmtNode c = List_get<*StmtNode>(&s.items, i);
            if (c.expr == null) { has_default = 1; }
            int case_ret = 0;
            int j = 0; int cn = List_len<*StmtNode>(&c.items);
            while (j < cn) { if (sema_always_returns(List_get<*StmtNode>(&c.items, j)) == 1) { case_ret = 1; } j = j + 1; }
            if (case_ret == 0) { return 0; }
            i = i + 1;
        }
        return has_default;
    }
    if (s.kind == SK_MATCH) {                           // exhaustiveness checked earlier
        int n = List_len<*StmtNode>(&s.items);
        if (n == 0) { return 0; }
        int i = 0;
        while (i < n) {
            if (sema_always_returns(List_get<*StmtNode>(&s.items, i).s1) == 0) { return 0; }
            i = i + 1;
        }
        return 1;
    }
    if (s.kind == SK_TRY) {
        if (s.s2 != null && sema_always_returns(s.s2) == 1) { return 1; }
        if (sema_always_returns(s.s1) == 0) { return 0; }
        int i = 0; int n = List_len<*StmtNode>(&s.items);
        while (i < n) { if (sema_always_returns(List_get<*StmtNode>(&s.items, i).s1) == 0) { return 0; } i = i + 1; }
        return 1;
    }
    return 0;
}

// Check a function/method body: a fresh scope with the params (and `self` for
// methods) defined, then walk the body.
// Remove the first occurrence of `name` from a string list (used by the uninit scan).
void sema_list_erase(List<string>* l, string name) {
    int i = 0; int n = List_len<string>(l);
    while (i < n) {
        if (sema_streq(List_get<string>(l, i), name) == 1) { List_remove<string>(l, i); return; }
        i = i + 1;
    }
}

// Scan an expression for a read of a still-uninitialized scalar. `&x` counts as
// initializing x (its address may be written through), not a read.
void sema_uninit_scan(Sema* s, *ExprNode e, List<string>* uninit) {
    if (e == null) { return; }
    if (e.kind == EK_UNARY && sema_streq(e.sval, "&") == 1 && e.a != null && e.a.kind == EK_IDENT) {
        sema_list_erase(uninit, e.a.sval);
        return;
    }
    if (e.kind == EK_IDENT) {
        if (sema_in_list(uninit, e.sval) == 1) {
            s.had_error = 1;
            printf("error: %s:0:0: use of uninitialized variable '%s'\n", s.filename, e.sval);
            sema_list_erase(uninit, e.sval);       // report once
        }
        return;
    }
    sema_uninit_scan(s, e.a, uninit);
    sema_uninit_scan(s, e.b, uninit);
    int i = 0; int n = List_len<*ExprNode>(&e.kids);
    while (i < n) { sema_uninit_scan(s, List_get<*ExprNode>(&e.kids, i), uninit); i = i + 1; }
}

// Conservative straight-line scan of a function body for reads of an uninitialized scalar
// local, stopping at the first control-flow statement (mirrors C++ checkUninitPrefix).
void sema_check_uninit(Sema* s, *StmtNode body) {
    if (body == null || body.kind != SK_BLOCK) { return; }
    List<string> uninit; List_init<string>(&uninit, 4);
    int i = 0; int n = List_len<*StmtNode>(&body.items);
    while (i < n) {
        *StmtNode it = List_get<*StmtNode>(&body.items, i);
        i = i + 1;
        if (it.kind == SK_VARDECL) {
            if (it.expr != null) { sema_uninit_scan(s, it.expr, &uninit); sema_list_erase(&uninit, it.name); }
            else {
                string t = it.type;                // only genuine scalars (arrays init piecewise)
                if (sema_is_arr_ty(t) == 0 && (sema_is_numeric_ty(t) == 1 || sema_is_ptrish(t) == 1 || sema_is_fn_type(t) == 1)) {
                    List_push<string>(&uninit, it.name);
                }
            }
        } else if (it.kind == SK_EXPR) {
            *ExprNode e = it.expr;
            if (e != null && e.kind == EK_BINARY && sema_streq(e.sval, "=") == 1) {
                sema_uninit_scan(s, e.b, &uninit);
                if (e.a != null && e.a.kind == EK_IDENT) { sema_list_erase(&uninit, e.a.sval); }
                else { sema_uninit_scan(s, e.a, &uninit); }
            } else { sema_uninit_scan(s, e, &uninit); }
        } else if (it.kind == SK_RETURN) {
            if (it.expr != null) { sema_uninit_scan(s, it.expr, &uninit); }
        } else {
            i = n;                                 // control flow / anything else: stop (conservative)
        }
    }
}

void sema_check_fn(Sema* s, *DeclNode f, string self_type) {
    if (f.body == null) { return; }
    // Template body: full type-checking (escape soundness, `?`, uninitialized reads,
    // undefined-variable) is deferred to instantiation, exactly as the C++ checker does,
    // because the param types are still abstract. Only the definite-return check is
    // structural (control-flow, type-independent), so it still applies here.
    if (List_len<TypeParam>(&f.type_params) > 0) {
        if (f.is_async == 0 && sema_streq(f.ret_type, "void") == 0
            && sema_always_returns(f.body) == 0) {
            s.had_error = 1;
            printf("error: %s:0:0: missing return in non-void function '%s' (control can reach the end without returning a %s)\n",
                   s.filename, f.name, f.ret_type);
        }
        return;
    }
    // `main` is the entry point; its return value is the process exit code, so it must be int.
    if (sema_streq(f.name, "main") == 1 && sema_streq(f.ret_type, "int") == 0) {
        s.had_error = 1;
        printf("error: %s:0:0: 'main' must return int (its return value is the process exit code); got '%s'\n",
               s.filename, f.ret_type);
    }
    s.in_async = f.is_async;
    s.await_seen = 0;
    s.cur_ret = f.ret_type;
    // Escape soundness: watch non-escaping fn-type params for the body walk.
    List_init<string>(&s.watched, 4);
    List_init<string>(&s.escaped, 4);
    s.callee_ctx = "";
    int pe = 0;
    int pn = List_len<Param>(&f.params);
    while (pe < pn) {
        Param pm = List_get<Param>(&f.params, pe);
        int marked = 0;
        if (pe < List_len<int>(&f.param_escaping)) { marked = List_get<int>(&f.param_escaping, pe); }
        if (sema_is_fn_type(pm.ty) == 1 && marked == 0) { List_push<string>(&s.watched, pm.name); }
        pe = pe + 1;
    }
    sema_push(s);
    if (self_type[0] != 0) { sema_define(s, "self", self_type, 0); }   // method: self is the struct
    int j = 0;
    int m = List_len<Param>(&f.params);
    while (j < m) {
        Param pm = List_get<Param>(&f.params, j);
        sema_define(s, pm.name, pm.ty, 0);
        j = j + 1;
    }
    sema_stmt(s, f.body);
    sema_pop(s);
    if (f.is_async == 0) { sema_check_uninit(s, f.body); }   // reads of an uninitialized scalar local
    // A non-void function must return on every path (no implicit zero return);
    // void may fall off, and async completes its future implicitly.
    if (f.is_async == 0 && sema_streq(f.ret_type, "void") == 0
        && sema_always_returns(f.body) == 0) {
        s.had_error = 1;
        printf("error: %s:0:0: missing return in non-void function '%s' (control can reach the end without returning a %s)\n",
               s.filename, f.name, f.ret_type);
    }
    if (f.is_async == 1 && s.await_seen == 0) {
        s.had_error = 1;
        printf("error: %s:0:0: async function '%s' has no `await`\n", s.filename, f.name);
    }
    int wi = 0;
    int wn = List_len<string>(&s.watched);
    while (wi < wn) {
        string wnm = List_get<string>(&s.watched, wi);
        if (sema_in_list(&s.escaped, wnm) == 1) {
            s.had_error = 1;
            printf("error: %s:0:0: closure parameter '%s' escapes (used beyond a direct call); mark it `escaping`\n",
                   s.filename, wnm);
        }
        wi = wi + 1;
    }
    s.in_async = 0;
}

// Returns 1 if the program type-checks (no errors), 0 otherwise.
int sema_check(Sema* s, *Program prog) {
    sema_register_globals(s, prog);
    List<string> defined_fns;   // top-level functions WITH a body, to catch a redefinition
    List_init<string>(&defined_fns, 32);
    int i = 0;
    int n = List_len<*DeclNode>(&prog.decls);
    while (i < n) {
        *DeclNode d = List_get<*DeclNode>(&prog.decls, i);
        if (d.kind == DK_FUNCTION && d.body != null) {
            if (sema_in_list(&defined_fns, d.name) == 1) {
                s.had_error = 1;
                printf("error: %s:0:0: redefinition of function '%s'\n", s.filename, d.name);
            } else { List_push<string>(&defined_fns, d.name); }
        }
        if (d.kind == DK_INTRINSIC) {
            if (sema_streq(d.name, "atomic_load") == 0 && sema_streq(d.name, "atomic_store") == 0
                && sema_streq(d.name, "atomic_swap") == 0 && sema_streq(d.name, "atomic_cas") == 0) {
                s.had_error = 1;
                printf("error: %s:0:0: unknown intrinsic '%s'\n", s.filename, d.name);
            }
        }
        if (d.kind == DK_FUNCTION) { sema_check_fn(s, d, ""); }
        if (d.kind == DK_STRUCT) {
            int k = 0;
            int mm = List_len<*DeclNode>(&d.methods);
            while (k < mm) { sema_check_fn(s, List_get<*DeclNode>(&d.methods, k), d.name); k = k + 1; }
        }
        i = i + 1;
    }
    if (s.had_error == 1) { return 0; }
    return 1;
}
