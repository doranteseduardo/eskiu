// Driver: `eskiuc run selfhost/lex_main.esk FILE` — lex FILE and print each token,
// one per line, as:  Line L, Col C: NAME 'value'  (NAME via token_name).
// EOF is not printed (the C++ loop stops at it). The parity harness normalizes
// BOTH this output and the C++ `--test-lexer` output to `L|C|NAME|value` and diffs.

import <io>;
import <fs>;
import "lexer.esk";

int main(int argc, string* argv) {
    if (argc < 2) {
        printf("usage: lex_main <file.esk>\n");
        return 1;
    }

    let n: int64 = 0;
    *uint8 src = fs_read_all(argv[1], &n);
    if (src == null) {
        printf("error: cannot read %s\n", argv[1]);
        return 1;
    }

    let lx: Lexer;
    lx.src = src;
    lx.len = (int)n;
    lx.pos = 0;
    lx.line = 1;
    lx.col = 1;

    Token t = lx_next(&lx);
    while (t.type != EOF_TOKEN) {
        printf("Line %d, Col %d: %s '", t.line, t.col, token_name(t.type));
        int i = 0;
        while (i < t.len) {
            putchar((int)src[t.start + i]);
            i = i + 1;
        }
        printf("'\n");
        t = lx_next(&lx);
    }
    return 0;
}
