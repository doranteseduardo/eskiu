// Driver: `eskiuc run selfhost/cg_main.esk FILE` (or compiled) — preprocess + parse +
// generate LLVM IR for FILE, printing the .ll text to stdout. Pipe it to clang to get
// a native binary. The parity harness compiles both this output and the C++ build and
// compares runtime behavior (exit code + stdout).

import <io>;
import <fs>;
import "preprocessor.esk";
import "parser.esk";
import "codegen.esk";

int main(int argc, string* argv) {
    if (argc < 2) {
        printf("usage: cg_main <file.esk>\n");
        return 1;
    }
    let n: int64 = 0;
    *uint8 raw = fs_read_all(argv[1], &n);
    if (raw == null) {
        printf("error: cannot read %s\n", argv[1]);
        return 1;
    }

    let pperr: int = 0;
    string pp = pp_run((string)raw, (int)n, argv[1], &pperr);
    *uint8 src = (*uint8)pp;
    int plen = 0;
    while (src[plen] != 0) { plen = plen + 1; }

    parser_session_init();
    let p: Parser;
    p_init(&p, src, plen);
    p.basedir = str_dir(argv[1]);
    *Program prog = parse_program(&p);

    let g: Codegen;
    cg_init(&g);
    cg_program(&g, prog);
    printf("%s", (string)String_cstr(&g.globals));   // declares + string constants
    printf("\n");
    printf("%s", (string)String_cstr(&g.out));        // function definitions
    return 0;
}
