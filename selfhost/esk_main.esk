// Unified self-hosted compiler driver: the full pipeline in Eskiu.
//
//   preprocess (pp_run) → parse (parse_program) → type-check (sema_check) → codegen
//
// Emits LLVM IR text for FILE to stdout (pipe to clang to get a native binary), exactly
// like cg_main, but with the semantic-analysis pass wired in: if type checking fails the
// driver reports the failure and exits non-zero WITHOUT emitting IR (a real compiler
// rejects ill-typed input rather than miscompiling it). On success only the `.ll` reaches
// stdout, so the output stays pipe-clean.
//
// This is the front of the self-hosting bootstrap: `esk_main` compiled by itself compiles
// the whole compiler. See tests/selfhost/cg_bootstrap.sh.

import <io>;
import <fs>;
import "preprocessor.esk";
import "parser.esk";
import "sema.esk";
import "async_lower.esk";
import "codegen.esk";
import "fmt.esk";

extern int64 write(int fd, *void buf, int64 n);
extern int    remove(string path);  // delete the temp .ll after linking
extern int    fork();               // spawn clang / the `run` program without a shell
extern int    execvp(string file, *string argv);
extern int    waitpid(int pid, *int status, int options);
extern void   _exit(int code);
extern string getenv(string name);  // $CLANG selects the clang binary (default "clang")
extern int    getpid();             // unique temp-exe name for `run`

// Diagnostics go to stderr (fd 2), never stdout — stdout carries only the emitted .ll.
void eprint(string s) {
    int64 n = 0;
    while (s[n] != 0) { n = n + 1; }
    write(2, (*void)s, n);
}

// Run args[0] with `args` as its argv (execvp: no shell, so spaces, quotes and `$`
// in an argument reach the program verbatim). Returns its exit code, 128+N when it
// was killed by signal N (the shell convention), or 127 if it could not be started.
int spawn_wait(List<string>* args) {
    int n = List_len<string>(args);
    *string av = alloc<string>((int64)(n + 1));    // zeroed, so av[n] is the NULL terminator
    int i = 0;
    while (i < n) { av[i] = List_get<string>(args, i); i = i + 1; }
    int pid = fork();
    if (pid < 0) { eprint("error: fork failed\n"); return 127; }
    if (pid == 0) {
        execvp(av[0], av);
        eprint("error: cannot run '"); eprint(av[0]); eprint("'\n");
        _exit(127);
    }
    let st: int = 0;
    if (waitpid(pid, &st, 0) < 0) { return 127; }
    int sig = st & 127;
    if (sig == 0) { return (st >> 8) & 255; }       // WIFEXITED → WEXITSTATUS
    return 128 + sig;                               // WIFSIGNALED → 128 + WTERMSIG
}

// Append the words of a command such as $CLANG ("clang -m64") to `args`.
void push_words(List<string>* args, string cmd) {
    int n = 0;
    while (cmd[n] != 0) { n = n + 1; }
    int i = 0;
    while (i < n) {
        while (i < n && ((int)cmd[i] == 32 || (int)cmd[i] == 9)) { i = i + 1; }
        int st = i;
        while (i < n && (int)cmd[i] != 32 && (int)cmd[i] != 9) { i = i + 1; }
        if (i > st) {
            *uint8 w = alloc<uint8>((int64)(i - st + 1));
            int k = 0;
            while (k < i - st) { w[k] = (uint8)cmd[st + k]; k = k + 1; }
            List_push<string>(args, (string)w);
        }
    }
}

int bytes_eq(*uint8 a, int an, *uint8 b, int bn) {
    if (an != bn) { return 0; }
    int i = 0;
    while (i < an) { if (a[i] != b[i]) { return 0; } i = i + 1; }
    return 1;
}

// `eskiuc fmt [--check] file.esk …` — reformat each file in place. With --check, don't
// write; exit non-zero if any file is not already formatted. Mirrors the C++ runFmt.
int run_fmt(List<string>* files, int check) {
    if (List_len<string>(files) == 0) { eprint("error: fmt: no input files\n"); return 1; }
    int changed = 0;
    int failed = 0;
    int i = 0;
    while (i < List_len<string>(files)) {
        string f = List_get<string>(files, i);
        i = i + 1;
        let flen: int64 = 0;
        *uint8 raw = fs_read_all(f, &flen);
        if (raw == null) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: fmt: cannot open '%s'\n", f);
            eprint((string)&eb[0]);
            failed = failed + 1;
            continue;
        }
        let formatted: String = format_source(raw, (int)flen);
        *uint8 fb = (*uint8)String_cstr(&formatted);
        int fl = (int)String_len(&formatted);
        if (bytes_eq(fb, fl, raw, (int)flen) == 1) { continue; }
        changed = changed + 1;
        if (check == 1) { printf("%s\n", f); continue; }
        if (fs_write_all(f, fb, (int64)fl) == 0) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: fmt: cannot write '%s'\n", f);
            eprint((string)&eb[0]);
            failed = failed + 1;
            continue;
        }
    }
    if (failed > 0) { return 1; }
    if (check == 1 && changed > 0) { return 1; }   // CI signal: files need formatting
    return 0;
}

int main(int argc, string* argv) {
    // CLI: esk_main [-o <out>] <file.esk>. With -o, produce a native binary (write
    // the IR to a temp .ll and invoke clang); without it, emit the .ll to stdout —
    // the form the bootstrap harness pipes to clang.
    // `eskiuc fmt [--check] file.esk …` — reindent files in place, no compile pipeline.
    if (argc >= 2 && cg_streq(argv[1], "fmt") == 1) {
        int check = 0;
        List<string> ffiles;
        List_init<string>(&ffiles, 2);
        int fj = 2;
        while (fj < argc) {
            if (cg_streq(argv[fj], "--check") == 1) { check = 1; }
            else { List_push<string>(&ffiles, argv[fj]); }
            fj = fj + 1;
        }
        return run_fmt(&ffiles, check);
    }

    List<string> infiles;
    List_init<string>(&infiles, 2);
    string outfile = null;
    string mode = "";        // "" = compile; else --version / --test-{lexer,parser,typechecker,codegen}
    int san = 0;             // 0 = none, 1 = address, 2 = undefined
    int safe = 0;            // --safe: opt-in runtime slice/array bounds checks
    // `esk_main run script.esk [args...]`: compile to a temp exe, run it forwarding
    // [args...], propagate its exit code, then delete it (matches the C++ `run`). Any
    // flags before the script go to the compiler; the first non-flag is the script and
    // everything after it becomes the program's argv.
    int runmode = 0;
    List<string> runargs;
    List_init<string>(&runargs, 2);
    int start = 1;
    if (argc >= 2 && cg_streq(argv[1], "run") == 1) { runmode = 1; start = 2; }
    int gotscript = 0;
    int sawsep = 0;
    int ai = start;
    while (ai < argc) {
        if (runmode == 1 && gotscript == 1) {
            // Everything after the script is program argv; a `--` right after it only
            // separates, so it is dropped (like the C++ `run`).
            if (sawsep == 0 && List_len<string>(&runargs) == 0 && cg_streq(argv[ai], "--") == 1) { sawsep = 1; }
            else { List_push<string>(&runargs, argv[ai]); }
            ai = ai + 1;
            continue;
        }
        if (cg_streq(argv[ai], "-o") == 1) {
            ai = ai + 1;
            if (ai < argc) { outfile = argv[ai]; }
        } else if (cg_streq(argv[ai], "--asan") == 1) {
            san = 1;
        } else if (cg_streq(argv[ai], "--ubsan") == 1) {
            san = 2;
        } else if (cg_streq(argv[ai], "--safe") == 1) {
            safe = 1;
        } else if (cg_streq(argv[ai], "--version") == 1
                || cg_streq(argv[ai], "--test-lexer") == 1
                || cg_streq(argv[ai], "--test-parser") == 1
                || cg_streq(argv[ai], "--test-typechecker") == 1
                || cg_streq(argv[ai], "--test-codegen") == 1) {
            mode = argv[ai];
        } else if (argv[ai][0] != 45) {   // not a flag ('-') → input file; unknown flags like -Wall/-Wextra are accepted and ignored
            List_push<string>(&infiles, argv[ai]);
            gotscript = 1;
        }
        ai = ai + 1;
    }
    // `run` links to a unique temp exe under /tmp, then executes it below.
    uint8[256] runexe;
    if (runmode == 1) {
        sprintf((string)&runexe[0], "/tmp/eskiu-run-%d", getpid());
        outfile = (string)&runexe[0];
    }
    if (cg_streq(mode, "--version") == 1) {
        printf("Eskiu 0.9.1\n");
        return 0;
    }
    if (List_len<string>(&infiles) == 0) {
        eprint("usage: esk_main [-o <out>] [--asan|--ubsan] [--safe] [--test-*] <file.esk> [more.esk ...]\n");
        return 1;
    }
    string infile = List_get<string>(&infiles, 0);   // primary file: test modes + diagnostics

    // Every mode preprocesses exactly like a real compile (the C++ test modes share the
    // build's predefined macros): the host OS macro picks the stdlib platform branch
    // (kqueue vs epoll, sockaddr layout) and __FILE__ is the real path.
#ifdef __APPLE__
    g_pp_os = "__APPLE__";
#else
    g_pp_os = "__linux__";
#endif
    g_pp_arch = cg_host_arch_macro();

    // --test-lexer: preprocess, then print the token stream (C++ testLexer).
    if (cg_streq(mode, "--test-lexer") == 1) {
        let ln: int64 = 0;
        *uint8 lraw = fs_read_all(infile, &ln);
        if (lraw == null) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: cannot read %s\n", infile);
            eprint((string)&eb[0]);
            return 1;
        }
        let lperr: int = 0;
        string lpp = pp_run((string)lraw, (int)ln, infile, &lperr);
        *uint8 lsrc = (*uint8)lpp;
        int llen = 0;
        while (lsrc[llen] != 0) { llen = llen + 1; }
        g_lex_file = infile;
        lex_dump(lsrc, llen);
        if (lperr != 0 || g_lex_errs > 0) { return 1; }
        return 0;
    }

    // --test-typechecker prints its banner before parsing (matches tc_main).
    if (cg_streq(mode, "--test-typechecker") == 1) {
        printf("Type checking: %s\n", infile);
        printf("========================================================\n");
    }

    parser_session_init();
    *Program prog = alloc<Program>(1);
    List_init<*DeclNode>(&prog.decls, 4);
    // Parse every input file into the one shared program (multi-file merge; the shared
    // import/type-name session dedups across files, like the C++ driver).
    int fi = 0;
    while (fi < List_len<string>(&infiles)) {
        string f = List_get<string>(&infiles, fi);
        // Register the root input, so an import cycle back to it (or an input an
        // earlier input already imported) is not parsed twice.
        if (register_file(f) == 0) { fi = fi + 1; continue; }
        let flen: int64 = 0;
        *uint8 raw = fs_read_all(f, &flen);
        if (raw == null) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: cannot read %s\n", f);
            eprint((string)&eb[0]);
            return 1;
        }
        let pperr: int = 0;
        string pp = pp_run((string)raw, (int)flen, f, &pperr);
        if (pperr != 0) { return 1; }       // a directive error (reported by pp_run) aborts the build
        *uint8 src = (*uint8)pp;
        int plen = 0;
        while (src[plen] != 0) { plen = plen + 1; }
        let p: Parser;
        g_lex_file = f;
        p_init(&p, src, plen);
        p.basedir = str_dir(f);
        parse_into(&p, prog);
        fi = fi + 1;
    }

    if (cg_streq(mode, "--test-parser") == 1) { print_program(prog); return 0; }

    // Semantic analysis: run for a real compile and for --test-typechecker; skip it for
    // --test-codegen (matches cg_main, whose IR the cg gate compares behaviorally). A
    // failed check must NOT emit IR.
    if (cg_streq(mode, "--test-codegen") == 0) {
        let sm: Sema;
        sema_init(&sm, infile);
        int ok = sema_check(&sm, prog);
        if (cg_streq(mode, "--test-typechecker") == 1) {
            printf("========================================================\n");
            if (ok == 1) { printf("Type checking succeeded!\n"); return 0; }
            printf("Type checking failed!\n");
            return 1;
        }
        if (ok == 0) {
            uint8[512] eb;
            sprintf((string)&eb[0], "error: %s: type checking failed\n", infile);
            eprint((string)&eb[0]);
            return 1;
        }
    }

    async_lower(prog);                 // lower async fns → frame + resume + ctor (after sema)

    let g: Codegen;
    cg_init(&g);
    g.safe = safe;                     // --safe → emit runtime bounds checks
    cg_program(&g, prog);
    if (outfile == null || cg_streq(mode, "--test-codegen") == 1) {
        // No -o (or --test-codegen): emit the .ll to stdout (the bootstrap harness pipes it to clang).
        printf("%s", (string)String_cstr(&g.globals));   // declares + string constants
        printf("\n");
        printf("%s", (string)String_cstr(&g.out));        // function definitions
        return 0;
    }

    // -o: assemble the full IR, write it to a temp .ll next to the output, and invoke
    // clang to link a native binary end to end.
    let ir: String;
    String_init(&ir, 8192);
    String_append(&ir, (string)String_cstr(&g.globals));
    String_append(&ir, "\n");
    String_append(&ir, (string)String_cstr(&g.out));
    string tmp = cg_cat(outfile, ".ll");
    if (fs_write_all(tmp, (*uint8)String_cstr(&ir), String_len(&ir)) == 0) {
        eprint("error: cannot write temporary IR\n");
        return 1;
    }
    string cc = getenv("CLANG");        // clang emits from .ll; cc/gcc can't, so no findCDriver ladder
    if (cc == null) { cc = "clang"; }
    List<string> cargs;
    List_init<string>(&cargs, 8);
    push_words(&cargs, cc);
    if (san == 1) { List_push<string>(&cargs, "-fsanitize=address"); }
    else if (san == 2) { List_push<string>(&cargs, "-fsanitize=undefined"); }
    List_push<string>(&cargs, tmp);
    List_push<string>(&cargs, "-o");
    List_push<string>(&cargs, outfile);
    int rc = spawn_wait(&cargs);
    remove(tmp);
    if (rc != 0) {
        eprint("error: clang failed to link the output\n");
        return 1;
    }
    if (runmode == 0) { return 0; }

    // run: exec the temp binary with the program's argv (no shell), then delete it and
    // return its exit status (128+N if a signal killed it, like the C++ `run`).
    List<string> pargs;
    List_init<string>(&pargs, 4);
    List_push<string>(&pargs, outfile);
    int k = 0;
    while (k < List_len<string>(&runargs)) {
        List_push<string>(&pargs, List_get<string>(&runargs, k));
        k = k + 1;
    }
    int st = spawn_wait(&pargs);
    remove(outfile);
    return st;
}
