// Source reformatter for `esk_main fmt` (promotion P2), a byte-for-byte mirror of the
// C++ `formatSource` (main_support.cpp). The rule set is deliberately conservative:
//   * 4-space indent per `{` nesting level, dedenting for each leading `}`
//   * at most one blank line between blocks
//   * trailing whitespace stripped, exactly one final newline per non-empty line
// Each line's content (operators, inner spacing, comments) is preserved verbatim.
// Braces inside strings, char literals and comments are ignored, so the transform is
// idempotent and safe. Preprocessor lines (`#…`) sit at column 0 and do not nest.

import <io>;
import <string>;

// Reindent `src` (n bytes) and return the formatted text. Mirrors the C++ line split
// (strip `\r`, break on `\n`, with the remainder after the last `\n` as a final line).
String format_source(*uint8 src, int n) {
    let out: String;
    String_init(&out, n + 64);
    int depth = 0;         // current `{` nesting
    int inBlock = 0;       // inside a /* … */ block comment
    int pendingBlank = 0;  // blank lines buffered (for collapsing)
    int wroteAny = 0;

    let raw: String;       // one source line, `\r` stripped, not yet trimmed
    String_init(&raw, 128);
    let t: String;         // the trimmed line content
    String_init(&t, 128);

    int i = 0;
    int done = 0;
    while (done == 0) {
        String_clear(&raw);
        while (i < n && src[i] != 10) {
            if (src[i] != 13) { String_push(&raw, (char)src[i]); }
            i = i + 1;
        }
        if (i < n) { i = i + 1; }   // consume the '\n'
        else { done = 1; }          // final remainder line: process it, then stop

        int rlen = (int)String_len(&raw);
        *uint8 rb = (*uint8)String_cstr(&raw);

        if (inBlock == 1) {         // verbatim until the comment closes
            int a = 0;
            while (a < rlen) { String_push(&out, (char)rb[a]); a = a + 1; }
            String_push(&out, (char)10);
            int b = 0;
            while (b + 1 < rlen) {
                if (rb[b] == 42 && rb[b + 1] == 47) { inBlock = 0; b = rlen; }
                else { b = b + 1; }
            }
            wroteAny = 1;
            continue;
        }

        // trim leading/trailing spaces and tabs into `t`
        int ts = 0;
        while (ts < rlen && (rb[ts] == 32 || rb[ts] == 9)) { ts = ts + 1; }
        int te = rlen;
        while (te > ts && (rb[te - 1] == 32 || rb[te - 1] == 9)) { te = te - 1; }
        String_clear(&t);
        int cp = ts;
        while (cp < te) { String_push(&t, (char)rb[cp]); cp = cp + 1; }
        int tlen = (int)String_len(&t);
        *uint8 tb = (*uint8)String_cstr(&t);

        if (tlen == 0) { pendingBlank = pendingBlank + 1; continue; }

        if (wroteAny == 1 && pendingBlank > 0) { String_push(&out, (char)10); }  // collapse to one blank
        pendingBlank = 0;

        if (tb[0] == 35) {          // '#' preprocessor line: column 0, no nesting change
            int a = 0;
            while (a < tlen) { String_push(&out, (char)tb[a]); a = a + 1; }
            String_push(&out, (char)10);
            wroteAny = 1;
            continue;
        }

        // this line's indent dedents for each leading '}'
        int lead = depth;
        int k = 0;
        while (k < tlen) {
            if (tb[k] == 125) { lead = lead - 1; k = k + 1; }
            else { k = tlen; }      // break at the first non-'}'
        }
        if (lead < 0) { lead = 0; }
        int sp = 0;
        while (sp < lead * 4) { String_push(&out, (char)32); sp = sp + 1; }
        int a = 0;
        while (a < tlen) { String_push(&out, (char)tb[a]); a = a + 1; }
        String_push(&out, (char)10);
        wroteAny = 1;

        // update nesting from this line's code, skipping strings/chars/comments
        int j = 0;
        while (j < tlen) {
            int c = (int)tb[j];
            if (c == 34 || c == 39) {           // string / char literal
                int q = c;
                j = j + 1;
                while (j < tlen && (int)tb[j] != q) {
                    if (tb[j] == 92 && j + 1 < tlen) { j = j + 1; }  // skip the escaped char
                    j = j + 1;
                }
                j = j + 1;                      // move past the closing quote
                continue;
            }
            if (c == 47 && j + 1 < tlen && tb[j + 1] == 47) { j = tlen; continue; }  // '//' line comment
            if (c == 47 && j + 1 < tlen && tb[j + 1] == 42) {   // '/*' block comment
                inBlock = 1;
                int m = j + 2;
                while (m + 1 < tlen) {
                    if (tb[m] == 42 && tb[m + 1] == 47) { inBlock = 0; j = m + 1; m = tlen; }
                    else { m = m + 1; }
                }
                if (inBlock == 1) { j = tlen; continue; }   // runs onto the next line
                j = j + 1;
                continue;
            }
            if (c == 123) { depth = depth + 1; }
            else { if (c == 125) { depth = depth - 1; } }
            j = j + 1;
        }
        if (depth < 0) { depth = 0; }
    }
    return out;
}
