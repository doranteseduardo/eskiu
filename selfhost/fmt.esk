// Source reformatter for `esk_main fmt` (promotion P2), a byte-for-byte mirror of the
// C++ `formatSource` (main_support.cpp). The rule set is deliberately conservative:
//   * 4-space indent per `{` nesting level, dedenting for each leading `}`
//   * blank lines kept (every line keeps its number); only trailing ones are dropped
//   * trailing whitespace stripped (except after a trailing `\`, where trimming would
//     create a continuation), exactly one final newline per non-empty line
// Each line's content (operators, inner spacing, comments, every byte of a string or
// char literal) is preserved verbatim; only a CRLF line ending's `\r` is taken off.
// Braces inside strings, char literals and comments are ignored, so the transform is
// idempotent and safe. Preprocessor lines (`#…`) sit at column 0 and do not nest.

import <io>;
import <string>;

// Update the `{` nesting from tb[from, tlen) (code state), skipping strings, chars and
// comments; a `/*` without its `*/` leaves *in_block set (mirrors the C++ scanNesting).
void fmt_scan(*uint8 tb, int tlen, int from, *int depth, *int in_block) {
    int j = from;
    while (j < tlen) {
        int c = (int)tb[j];
        if (c == 34 || c == 39) {           // string / char literal
            int q = c;
            j = j + 1;
            while (j < tlen && (int)tb[j] != q) {
                if (tb[j] == 92 && j + 1 < tlen) { j = j + 1; }  // skip the escaped char
                j = j + 1;
            }
            j = j + 1;                      // move past the closing quote
            continue;
        }
        if (c == 47 && j + 1 < tlen && tb[j + 1] == 47) { j = tlen; continue; }  // '//' line comment
        if (c == 47 && j + 1 < tlen && tb[j + 1] == 42) {   // '/*' block comment
            in_block[0] = 1;
            int m = j + 2;
            while (m + 1 < tlen) {
                if (tb[m] == 42 && tb[m + 1] == 47) { in_block[0] = 0; j = m + 1; m = tlen; }
                else { m = m + 1; }
            }
            if (in_block[0] == 1) { j = tlen; continue; }   // runs onto the next line
            j = j + 1;
            continue;
        }
        if (c == 123) { depth[0] = depth[0] + 1; }
        else { if (c == 125) { depth[0] = depth[0] - 1; } }
        j = j + 1;
    }
    if (depth[0] < 0) { depth[0] = 0; }
}

// Append the line ending: CRLF when `crlf` is set, else LF.
void fmt_eol(String* out, int crlf) {
    if (crlf == 1) { String_push(out, (char)13); }
    String_push(out, (char)10);
}

// Reindent `src` (n bytes) and return the formatted text. Mirrors the C++ line split
// (break on `\n`, drop the one `\r` before it, with the remainder after the last `\n`
// as a final line)
// and keeps the file's line ending (CRLF if its first line break is `\r\n`).
String format_source(*uint8 src, int n) {
    let out: String;
    String_init(&out, n + 64);
    let depth: int = 0;    // current `{` nesting
    let inBlock: int = 0;  // inside a /* … */ block comment
    int pendingBlank = 0;  // blank lines buffered (dropped only at the end of the file)
    int crlf = 0;
    int fnl = 0;
    while (fnl < n && src[fnl] != 10) { fnl = fnl + 1; }
    if (fnl < n && fnl > 0 && src[fnl - 1] == 13) { crlf = 1; }

    let raw: String;       // one source line, `\r` stripped, not yet trimmed
    String_init(&raw, 128);
    let t: String;         // the trimmed line content
    String_init(&t, 128);

    int i = 0;
    int done = 0;
    while (done == 0) {
        String_clear(&raw);
        while (i < n && src[i] != 10) { String_push(&raw, (char)src[i]); i = i + 1; }
        if (i < n) {                // consume the '\n', and a CRLF ending's '\r'
            i = i + 1;
            int rl = (int)String_len(&raw);
            if (rl > 0 && (int)String_char_at(&raw, rl - 1) == 13) { raw.len = raw.len - 1; raw.data[raw.len] = 0; }
        }
        else { done = 1; }          // final remainder line: process it, then stop

        int rlen = (int)String_len(&raw);
        *uint8 rb = (*uint8)String_cstr(&raw);

        if (inBlock == 1) {         // verbatim until the comment closes
            int a = 0;
            while (a < rlen) { String_push(&out, (char)rb[a]); a = a + 1; }
            fmt_eol(&out, crlf);
            int b = 0;
            while (b + 1 < rlen) {
                if (rb[b] == 42 && rb[b + 1] == 47) {
                    inBlock = 0;
                    fmt_scan(rb, rlen, b + 2, &depth, &inBlock);   // code after the `*/` still nests
                    b = rlen;
                }
                else { b = b + 1; }
            }
            continue;
        }

        // trim leading/trailing spaces and tabs into `t`
        int ts = 0;
        while (ts < rlen && (rb[ts] == 32 || rb[ts] == 9)) { ts = ts + 1; }
        int te = rlen;
        while (te > ts && (rb[te - 1] == 32 || rb[te - 1] == 9)) { te = te - 1; }
        if (te > ts && rb[te - 1] == 92) { te = rlen; }   // `\ ` must not become a continuation
        String_clear(&t);
        int cp = ts;
        while (cp < te) { String_push(&t, (char)rb[cp]); cp = cp + 1; }
        int tlen = (int)String_len(&t);
        *uint8 tb = (*uint8)String_cstr(&t);

        if (tlen == 0) { pendingBlank = pendingBlank + 1; continue; }

        while (pendingBlank > 0) { fmt_eol(&out, crlf); pendingBlank = pendingBlank - 1; }   // keep every blank line

        if (tb[0] == 35) {          // '#' preprocessor line: column 0, no nesting change
            int a = 0;
            while (a < tlen) { String_push(&out, (char)tb[a]); a = a + 1; }
            fmt_eol(&out, crlf);
            continue;
        }

        // this line's indent dedents for each leading '}'
        int lead = depth;
        int k = 0;
        while (k < tlen) {
            if (tb[k] == 125) { lead = lead - 1; k = k + 1; }
            else { k = tlen; }      // break at the first non-'}'
        }
        if (lead < 0) { lead = 0; }
        int sp = 0;
        while (sp < lead * 4) { String_push(&out, (char)32); sp = sp + 1; }
        int a = 0;
        while (a < tlen) { String_push(&out, (char)tb[a]); a = a + 1; }
        fmt_eol(&out, crlf);

        fmt_scan(tb, tlen, 0, &depth, &inBlock);   // update nesting from this line's code
    }
    return out;
}
