// Source reformatter for `esk_main fmt` (promotion P2), a byte-for-byte mirror of the
// C++ `formatSource` (main_support.cpp). The rule set is deliberately conservative:
//   * 4-space indent per `{` nesting level, dedenting for each leading `}`
//   * blank lines kept (every line keeps its number); only trailing ones are dropped
//   * trailing whitespace stripped (except after a trailing `\`, where trimming would
//     create a continuation), exactly one final newline per non-empty line
//   * a line after one ending in `\` (a continuation) is kept byte for byte
// Each line's content (operators, inner spacing, comments, every byte of a string or
// char literal) is preserved verbatim; only a CRLF line ending's `\r` is taken off.
// Braces inside strings, char literals and comments are ignored, so the transform is
// idempotent and safe. Preprocessor lines (`#…`) sit at column 0 and do not nest.

import <io>;
import <string>;
import <list>;

// Update the `{` nesting from tb[from, tlen) (code state), skipping strings, chars and
// comments; a `/*` without its `*/` leaves *in_block set (mirrors the C++ scanNesting).
// A string still open at the end of the line leaves *in_str set (and one open at
// the start is continued).
void fmt_scan(*uint8 tb, int tlen, int from, *int depth, *int in_block, *int in_str) {
    int j = from;
    while (j < tlen) {
        int c = (int)tb[j];
        if (in_str[0] == 1 || c == 34 || c == 39) {           // string / char literal
            int q = c;
            if (in_str[0] == 1) { q = 34; } else { j = j + 1; }
            in_str[0] = 0;
            while (j < tlen && (int)tb[j] != q) {
                if (tb[j] == 92 && j + 1 < tlen) { j = j + 1; }  // skip the escaped char
                j = j + 1;
            }
            if (j >= tlen && q == 34) { in_str[0] = 1; }
            j = j + 1;                      // move past the closing quote
            continue;
        }
        if (c == 47 && j + 1 < tlen && tb[j + 1] == 47) { j = tlen; continue; }  // '//' line comment
        if (c == 47 && j + 1 < tlen && tb[j + 1] == 42) {   // '/*' block comment
            in_block[0] = 1;
            int m = j + 2;
            while (m + 1 < tlen) {
                if (tb[m] == 42 && tb[m + 1] == 47) { in_block[0] = 0; j = m + 1; m = tlen; }
                else { m = m + 1; }
            }
            if (in_block[0] == 1) { j = tlen; continue; }   // runs onto the next line
            j = j + 1;
            continue;
        }
        if (c == 123) { depth[0] = depth[0] + 1; }
        else { if (c == 125) { depth[0] = depth[0] - 1; } }
        j = j + 1;
    }
    if (depth[0] < 0) { depth[0] = 0; }
}

// The end of b[s, e) with trailing spaces and tabs dropped, unless that exposes a
// trailing `\` (trimming there would create a continuation).
int fmt_rtrim(*uint8 b, int s, int e) {
    int te = e;
    while (te > s && (b[te - 1] == 32 || b[te - 1] == 9)) { te = te - 1; }
    if (te > s && b[te - 1] == 92) { te = e; }
    return te;
}

// 1 when the directive line b[0, n) leaves a `/*` comment open (literals and `//`
// skipped, as the preprocessor strips a directive's comments; mirrors the C++).
int fmt_dir_opens(*uint8 b, int n) {
    int i = 0;
    while (i < n) {
        int c = (int)b[i];
        if (c == 34 || c == 39) {
            i = i + 1;
            while (i < n && (int)b[i] != c) { if (b[i] == 92 && i + 1 < n) { i = i + 1; } i = i + 1; }
            i = i + 1;
            continue;
        }
        if (c == 47 && i + 1 < n && b[i + 1] == 47) { return 0; }
        if (c == 47 && i + 1 < n && b[i + 1] == 42) {
            int e = i + 2;
            while (e + 1 < n && !(b[e] == 42 && b[e + 1] == 47)) { e = e + 1; }
            if (e + 1 >= n) { return 1; }
            i = e + 2;
            continue;
        }
        i = i + 1;
    }
    return 0;
}

// 1 when the C strings `a` and `b` are equal.
int fmt_eq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && a[i] == b[i]) { i = i + 1; }
    if (a[i] == b[i]) { return 1; }
    return 0;
}

// Append the line ending: CRLF when `crlf` is set, else LF.
void fmt_eol(String* out, int crlf) {
    if (crlf == 1) { String_push(out, (char)13); }
    String_push(out, (char)10);
}

// Reindent `src` (n bytes) and return the formatted text. Mirrors the C++ line split
// (break on `\n`, drop the one `\r` before it, with the remainder after the last `\n`
// as a final line)
// and keeps the file's line ending (CRLF if its first line break is `\r\n`).
String format_source(*uint8 src, int n) {
    let out: String;
    String_init(&out, n + 64);
    let depth: int = 0;    // current `{` nesting
    let inBlock: int = 0;  // inside a /* … */ block comment
    let inStr: int = 0;    // a string literal continues onto the next line
    int prevCont = 0;      // the previous line ends with `\`: this one continues it
    int ppCont = 0;        // the continued line is a preprocessor line (no nesting)
    int pendingBlank = 0;  // blank lines buffered (dropped only at the end of the file)
    // The preprocessor's view (mirrors the C++): a `#` line inside a multi-line string is
    // string text, each branch of a conditional and the code after `#endif` start from
    // the string state at the `#if`, and a directive that leaves a `/*` open opens a
    // comment for the following lines. In a string opened inside a conditional (maybe a
    // branch that is not compiled) a `#` line keeps its bytes but counts as a directive.
    List<int> condStr; List_init<int>(&condStr, 4);
    int strSeen = 0;       // inStr was already set at the start of the previous line
    int strInCond = 0;     // the open string began inside a conditional
    let ppLine: String;    // the directive's logical line (continuations joined)
    String_init(&ppLine, 64);
    int firstLine = 1;
    int crlf = 0;
    int fnl = 0;
    while (fnl < n && src[fnl] != 10) { fnl = fnl + 1; }
    if (fnl < n && fnl > 0 && src[fnl - 1] == 13) { crlf = 1; }

    let raw: String;       // one source line, `\r` stripped, not yet trimmed
    String_init(&raw, 128);
    let t: String;         // the trimmed line content
    String_init(&t, 128);

    int i = 0;
    int done = 0;
    while (done == 0) {
        String_clear(&raw);
        while (i < n && src[i] != 10) { String_push(&raw, (char)src[i]); i = i + 1; }
        if (i < n) {                // consume the '\n', and a CRLF ending's '\r'
            i = i + 1;
            int rl = (int)String_len(&raw);
            if (rl > 0 && (int)String_char_at(&raw, rl - 1) == 13) { raw.len = raw.len - 1; raw.data[raw.len] = 0; }
        }
        else { done = 1; }          // final remainder line: process it, then stop

        int rlen = (int)String_len(&raw);
        *uint8 rb = (*uint8)String_cstr(&raw);
        int cont = prevCont;
        int shebang = 0;
        if (firstLine == 1 && rlen >= 2 && rb[0] == 35 && rb[1] == 33) { shebang = 1; }
        firstLine = 0;
        prevCont = 0;
        if (rlen > 0 && rb[rlen - 1] == 92) { prevCont = 1; }
        if (inStr == 1 && strSeen == 0) {
            strInCond = 0;
            if (List_len<int>(&condStr) > 0) { strInCond = 1; }
        }
        strSeen = inStr;
        int h0 = 0;
        while (h0 < rlen && (rb[h0] == 32 || rb[h0] == 9)) { h0 = h0 + 1; }
        int directive = 0;
        if (inBlock == 0 && cont == 0 && (inStr == 0 || strInCond == 1) && h0 < rlen && rb[h0] == 35) { directive = 1; }

        if (inBlock == 1) {         // verbatim until the comment closes
            int a = 0;
            while (a < rlen) { String_push(&out, (char)rb[a]); a = a + 1; }
            fmt_eol(&out, crlf);
            int b = 0;
            while (b + 1 < rlen) {
                if (rb[b] == 42 && rb[b + 1] == 47) {
                    inBlock = 0;
                    fmt_scan(rb, rlen, b + 2, &depth, &inBlock, &inStr);   // code after the `*/` still nests
                    b = rlen;
                }
                else { b = b + 1; }
            }
            continue;
        }

        if (inStr == 1 && directive == 0) {   // inside a multi-line string: bytes verbatim
            fmt_scan(rb, rlen, 0, &depth, &inBlock, &inStr);
            int ve = rlen;
            if (inStr == 0) { ve = fmt_rtrim(rb, 0, rlen); }
            int a = 0;
            while (a < ve) { String_push(&out, (char)rb[a]); a = a + 1; }
            fmt_eol(&out, crlf);
            continue;
        }

        if (cont == 1) {            // a continuation line: bytes verbatim
            int a = 0;
            while (a < rlen) { String_push(&out, (char)rb[a]); a = a + 1; }
            fmt_eol(&out, crlf);
            if (ppCont == 0) { fmt_scan(rb, rlen, 0, &depth, &inBlock, &inStr); }
            else {
                int a2 = 0; int ae = rlen; if (prevCont == 1) { ae = rlen - 1; }
                while (a2 < ae) { String_push(&ppLine, (char)rb[a2]); a2 = a2 + 1; }
                if (prevCont == 0) { inBlock = fmt_dir_opens((*uint8)String_cstr(&ppLine), (int)String_len(&ppLine)); }
            }
            continue;
        }

        // drop leading spaces and tabs into `t` (trailing ones go after the scan)
        int ts = 0;
        while (ts < rlen && (rb[ts] == 32 || rb[ts] == 9)) { ts = ts + 1; }
        if (ts == rlen) { pendingBlank = pendingBlank + 1; continue; }
        String_clear(&t);
        int cp = ts;
        while (cp < rlen) { String_push(&t, (char)rb[cp]); cp = cp + 1; }
        int tlen = (int)String_len(&t);
        *uint8 tb = (*uint8)String_cstr(&t);

        while (pendingBlank > 0) { fmt_eol(&out, crlf); pendingBlank = pendingBlank - 1; }   // keep every blank line

        ppCont = 0;
        if (tb[0] == 35) { ppCont = 1; }
        if (tb[0] == 35) {          // '#' preprocessor line: column 0, no nesting change
            int full = tlen;
            tlen = fmt_rtrim(tb, 0, tlen);
            int a = 0;
            if (inStr == 1) { while (a < rlen) { String_push(&out, (char)rb[a]); a = a + 1; } }
            else { while (a < tlen) { String_push(&out, (char)tb[a]); a = a + 1; } }
            fmt_eol(&out, crlf);
            int k2 = 1;
            while (k2 < full && (tb[k2] == 32 || tb[k2] == 9)) { k2 = k2 + 1; }
            int ks = k2;
            while (k2 < full && ((tb[k2] >= 97 && tb[k2] <= 122) || (tb[k2] >= 65 && tb[k2] <= 90)
                                 || (tb[k2] >= 48 && tb[k2] <= 57) || tb[k2] == 95)) { k2 = k2 + 1; }
            String kws; String_init(&kws, 8);
            int q = ks; while (q < k2) { String_push(&kws, (char)tb[q]); q = q + 1; }
            string kw = (string)String_cstr(&kws);
            int nc = List_len<int>(&condStr);
            if (fmt_eq(kw, "if") == 1 || fmt_eq(kw, "ifdef") == 1 || fmt_eq(kw, "ifndef") == 1) { List_push<int>(&condStr, inStr); }
            else if ((fmt_eq(kw, "elif") == 1 || fmt_eq(kw, "else") == 1) && nc > 0) { inStr = List_get<int>(&condStr, nc - 1); }
            else if (fmt_eq(kw, "endif") == 1 && nc > 0) { inStr = List_get<int>(&condStr, nc - 1); List_remove<int>(&condStr, nc - 1); }
            if (prevCont == 1) {
                String_clear(&ppLine);
                int a3 = 0; while (a3 < full - 1) { String_push(&ppLine, (char)tb[a3]); a3 = a3 + 1; }
            } else if (shebang == 0) { inBlock = fmt_dir_opens(tb, full); }
            continue;
        }

        // this line's indent dedents for each leading '}'
        int lead = depth;
        int k = 0;
        while (k < tlen) {
            if (tb[k] == 125) { lead = lead - 1; k = k + 1; }
            else { k = tlen; }      // break at the first non-'}'
        }
        if (lead < 0) { lead = 0; }
        fmt_scan(tb, tlen, 0, &depth, &inBlock, &inStr);   // update nesting from this line's code
        if (inStr == 0) { tlen = fmt_rtrim(tb, 0, tlen); }  // blanks inside an open string are its bytes
        int sp = 0;
        while (sp < lead * 4) { String_push(&out, (char)32); sp = sp + 1; }
        int a = 0;
        while (a < tlen) { String_push(&out, (char)tb[a]); a = a + 1; }
        fmt_eol(&out, crlf);
    }
    return out;
}
