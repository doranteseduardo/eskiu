// Self-hosted text preprocessor — a port of lexer/preprocessor.cpp. Runs before the
// lexer: object- and function-like #define/#undef, #ifdef/#ifndef/#else/#endif
// conditionals, #pragma passthrough, #error, backslash line splicing, and the
// predefined __FILE__/__LINE__ macros. Directive and inactive lines become blank
// lines so source line numbers are preserved. Substitution is identifier-aware
// (skips string/char literals and // comments) and recursive (a macro is not
// re-expanded within its own expansion).
//
// Parity target: the C++ `--test-lexer`, which preprocesses like a real build: the
// predefined host OS macro (`__APPLE__`/`__linux__`, value 1) and `__FILE__` = the path.

import <string>;
import <list>;
import <mem>;

// Host OS macro to predefine for real compilation (set by the compiler driver per host;
// null/"" for the lexer-parity driver). See pp_run.
string g_pp_os;
string g_pp_arch;   // host architecture macro (__aarch64__ / __x86_64__), set like g_pp_os

// Further predefined macros (value 1) for real compilation, e.g. _WIN64 or
// __ESKIU_FREESTANDING__ (the C++ seedPredefinedMacros). Set by the driver.
List<string> g_pp_predef;

struct PPMacro {
    string name;
    int is_function;
    List<string> params;
    string body;
}

struct PPCond {
    int parent;     // was the enclosing scope active when this #if was opened?
    int branch;     // is the current branch (then/elif/else) taken?
    int taken;      // has some branch of this #if chain already been selected?
    int saw_else;   // has the #else been seen?
    int line;       // where the opening #if/#ifdef/#ifndef is (for "missing #endif")
    int col;
}

extern int64 write(int fd, *void buf, int64 n);

// Report a located preprocessor error on stderr (mirrors the C++ ppError).
void pp_error(string file, int line, int col, string msg, *int had_err) {
    String m;
    String_init(&m, 64);
    String_append(&m, "error: ");
    if (file[0] == 0) { String_append(&m, "<input>"); } else { String_append(&m, file); }
    String num;
    String_init(&num, 12);
    String_from_int(&num, line);
    String_append(&m, ":"); String_append(&m, (string)String_cstr(&num));
    String_from_int(&num, col);
    String_append(&m, ":"); String_append(&m, (string)String_cstr(&num));
    String_append(&m, ": "); String_append(&m, msg); String_append(&m, "\n");
    write(2, (*void)String_cstr(&m), (int64)String_len(&m));
    had_err[0] = 1;
}

// ── small char / string helpers (pp_-prefixed to avoid clashing with the lexer) ──

int pp_is_alpha(int c) {
    if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95) { return 1; }
    return 0;
}
int pp_is_alnum(int c) {
    if (pp_is_alpha(c) == 1) { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}
int pp_is_sp(int c) {
    if (c == 32 || c == 9) { return 1; }
    return 0;
}

int pp_clen(string s) {
    int i = 0;
    while (s[i] != 0) { i = i + 1; }
    return i;
}

int pp_eq(string a, string b) {
    int i = 0;
    while (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { return 0; }
        i = i + 1;
    }
    if (a[i] == b[i]) { return 1; }
    return 0;
}

// Owned NUL-terminated substring s[start, start+count).
string pp_sub(string s, int start, int count) {
    *uint8 buf = alloc<uint8>(count + 1);
    int i = 0;
    while (i < count) { buf[i] = (uint8)s[start + i]; i = i + 1; }
    buf[count] = 0;
    return (string)buf;
}

// Trim leading/trailing spaces and tabs (mirrors ppTrim).
string pp_trim(string s) {
    int n = pp_clen(s);
    int a = 0;
    while (a < n && pp_is_sp((int)s[a]) == 1) { a = a + 1; }
    if (a >= n) { return ""; }
    int b = n - 1;
    while (b > a && pp_is_sp((int)s[b]) == 1) { b = b - 1; }
    return pp_sub(s, a, b - a + 1);
}

// Drop the last character of a String (no String_pop in the stdlib).
void pp_pop(String* s) {
    if (s.len > 0) { s.len = s.len - 1; s.data[s.len] = 0; }
}

// ── macro table (push-only List; redefine via set, #undef via remove) ──

int pp_find(List<PPMacro>* tbl, string name) {
    int i = 0;
    int n = List_len<PPMacro>(tbl);
    while (i < n) {
        if (pp_eq(List_get<PPMacro>(tbl, i).name, name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
void pp_define(List<PPMacro>* tbl, PPMacro m) {
    int idx = pp_find(tbl, m.name);
    if (idx >= 0) { List_set<PPMacro>(tbl, idx, m); }
    else { List_push<PPMacro>(tbl, m); }
}
void pp_undef(List<PPMacro>* tbl, string name) {
    int idx = pp_find(tbl, name);
    if (idx >= 0) { List_remove<PPMacro>(tbl, idx); }
}
int pp_defined(List<PPMacro>* tbl, string name) {
    if (pp_find(tbl, name) >= 0) { return 1; }
    return 0;
}

int pp_in_set(List<string>* set, string id) {
    int i = 0;
    int n = List_len<string>(set);
    while (i < n) {
        if (pp_eq(List_get<string>(set, i), id) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

// ── expansion ──

// Replace each parameter name in a function-like macro body with its argument
// (mirrors ppSubstParams; literal-aware, no expansion).
string pp_subst_params(string body, List<string>* params, List<string>* args) {
    String out;
    String_init(&out, pp_clen(body) + 16);
    int n = pp_clen(body);
    int i = 0;
    while (i < n) {
        int c = (int)body[i];
        if (c == 34 || c == 39) {                 // " or ' — copy literal verbatim
            int q = c;
            String_push(&out, (char)c); i = i + 1;
            while (i < n) {
                if ((int)body[i] == 92 && i + 1 < n) {
                    String_push(&out, (char)body[i]); String_push(&out, (char)body[i + 1]); i = i + 2; continue;
                }
                String_push(&out, (char)body[i]);
                if ((int)body[i] == q) { i = i + 1; break; }
                i = i + 1;
            }
            continue;
        }
        if (pp_is_alpha(c) == 1) {
            int j = i;
            while (j < n && pp_is_alnum((int)body[j]) == 1) { j = j + 1; }
            string id = pp_sub(body, i, j - i);
            int pi = 0;
            int pn = List_len<string>(params);
            int found = 0 - 1;
            while (pi < pn) {
                if (pp_eq(List_get<string>(params, pi), id) == 1) { found = pi; }
                pi = pi + 1;
            }
            if (found >= 0 && found < List_len<string>(args)) {
                String_append(&out, List_get<string>(args, found));
            } else {
                String_append(&out, id);
            }
            i = j; continue;
        }
        String_push(&out, (char)c); i = i + 1;
    }
    return (string)String_cstr(&out);
}

// Copy the string/char literal starting at text[i] (the opening quote) onto `out`;
// returns the index just past the closing quote (mirrors ppCopyLiteral).
int pp_copy_lit(string text, int i, int n, String* out) {
    int q = (int)text[i];
    String_push(out, (char)q); i = i + 1;
    while (i < n) {
        if ((int)text[i] == 92 && i + 1 < n) {
            String_push(out, (char)text[i]); String_push(out, (char)text[i + 1]); i = i + 2; continue;
        }
        String_push(out, (char)text[i]);
        if ((int)text[i] == q) { i = i + 1; break; }
        i = i + 1;
    }
    return i;
}

// Expand all macros in `text`, recursively. `expanding` guards a macro against
// re-expansion within its own expansion (mirrors ppExpand). `blk` carries the
// `/* */` comment state across lines (in: open at start; out: open at end).
string pp_expand(string text, List<PPMacro>* tbl, List<string>* expanding, *int blk) {
    String out;
    String_init(&out, pp_clen(text) + 16);
    int n = pp_clen(text);
    int i = 0;
    int inb = blk[0];
    while (i < n) {
        int c = (int)text[i];
        if (inb == 1) {                           // inside /* */ → copy verbatim to */
            if (c == 42 && i + 1 < n && (int)text[i + 1] == 47) {
                String_push(&out, (char)42); String_push(&out, (char)47); i = i + 2; inb = 0; continue;
            }
            String_push(&out, (char)c); i = i + 1; continue;
        }
        if (c == 47 && i + 1 < n && (int)text[i + 1] == 42) {   // /* opens a block comment
            String_push(&out, (char)47); String_push(&out, (char)42); i = i + 2; inb = 1; continue;
        }
        if (c == 34 || c == 39) {                 // string/char literal — copy verbatim
            i = pp_copy_lit(text, i, n, &out);
            continue;
        }
        if (c == 47 && i + 1 < n && (int)text[i + 1] == 47) {   // // line comment → copy rest
            String_append(&out, pp_sub(text, i, n - i));
            i = n; continue;
        }
        if (pp_is_alpha(c) == 1) {
            int j = i;
            while (j < n && pp_is_alnum((int)text[j]) == 1) { j = j + 1; }
            string id = pp_sub(text, i, j - i);
            int idx = pp_find(tbl, id);
            if (idx >= 0 && pp_in_set(expanding, id) == 0) {
                PPMacro mac = List_get<PPMacro>(tbl, idx);
                if (mac.is_function == 0) {
                    List_push<string>(expanding, id);
                    int b0 = 0;
                    String_append(&out, pp_expand(mac.body, tbl, expanding, &b0));
                    List_remove<string>(expanding, List_len<string>(expanding) - 1);
                    i = j; continue;
                }
                int k = j;
                while (k < n && pp_is_sp((int)text[k]) == 1) { k = k + 1; }
                if (k < n && (int)text[k] == 40) {         // function-like call: '('
                    // Split at top-level commas; string/char literals are copied whole.
                    List<string> args;
                    List_init<string>(&args, 4);
                    String cur;
                    String_init(&cur, 16);
                    int depth = 0;
                    int sawAny = 0;
                    int p = k + 1;
                    int closed = 0;
                    while (p < n && closed == 0) {
                        int d = (int)text[p];
                        if (d == 34 || d == 39) { p = pp_copy_lit(text, p, n, &cur); sawAny = 1; }
                        else if (d == 40) { depth = depth + 1; String_push(&cur, (char)d); sawAny = 1; p = p + 1; }
                        else if (d == 41) {
                            if (depth == 0) { p = p + 1; closed = 1; }
                            else { depth = depth - 1; String_push(&cur, (char)d); p = p + 1; }
                        }
                        else if (d == 44 && depth == 0) {
                            List_push<string>(&args, pp_trim((string)String_cstr(&cur))); String_clear(&cur); p = p + 1;
                        }
                        else { String_push(&cur, (char)d); sawAny = 1; p = p + 1; }
                    }
                    if (sawAny == 1 || List_len<string>(&args) > 0) {
                        List_push<string>(&args, pp_trim((string)String_cstr(&cur)));
                    }
                    // Arguments are fully macro-expanded before substitution (C rule).
                    int ai = 0;
                    while (ai < List_len<string>(&args)) {
                        int b1 = 0;
                        List_set<string>(&args, ai, pp_expand(List_get<string>(&args, ai), tbl, expanding, &b1));
                        ai = ai + 1;
                    }
                    string sub = pp_subst_params(mac.body, &mac.params, &args);
                    List_push<string>(expanding, id);
                    int b2 = 0;
                    String_append(&out, pp_expand(sub, tbl, expanding, &b2));
                    List_remove<string>(expanding, List_len<string>(expanding) - 1);
                    i = p; continue;
                }
                // function-like name not followed by '(' → leave as-is
            }
            String_append(&out, id); i = j; continue;
        }
        String_push(&out, (char)c); i = i + 1;
    }
    blk[0] = inb;
    return (string)String_cstr(&out);
}

// Does `line` end inside a /* */ comment, given whether one was open at its start
// (mirrors endsInBlockComment)?
int pp_ends_in_block(string line, int inb) {
    int n = pp_clen(line);
    int i = 0;
    while (i < n) {
        int c = (int)line[i];
        if (inb == 1) {
            if (c == 42 && i + 1 < n && (int)line[i + 1] == 47) { inb = 0; i = i + 1; }
            i = i + 1; continue;
        }
        if (c == 47 && i + 1 < n && (int)line[i + 1] == 42) { inb = 1; i = i + 2; continue; }
        if (c == 34 || c == 39) {
            int q = c; i = i + 1;
            while (i < n && (int)line[i] != q) { if ((int)line[i] == 92) { i = i + 1; } i = i + 1; }
            i = i + 1; continue;
        }
        if (c == 47 && i + 1 < n && (int)line[i + 1] == 47) { return inb; }
        i = i + 1;
    }
    return inb;
}

// Does a line ending in '\' genuinely continue (mirrors backslashContinuesLine)?
// Precondition: the trailing char is '\'. Returns 0 if that '\' is inside a //
// comment, an open block comment, or a string/char literal.
int pp_bs_continues(string line) {
    int in_str = 0;
    int in_chr = 0;
    int in_block = 0;
    int n = pp_clen(line);
    int i = 0;
    while (i < n) {
        int c = (int)line[i];
        if (in_block == 1) {
            if (c == 42 && i + 1 < n && (int)line[i + 1] == 47) { in_block = 0; i = i + 1; }
            i = i + 1; continue;
        }
        if (in_str == 1) {
            if (c == 92 && i + 1 < n) { i = i + 2; continue; }
            if (c == 34) { in_str = 0; }
            i = i + 1; continue;
        }
        if (in_chr == 1) {
            if (c == 92 && i + 1 < n) { i = i + 2; continue; }
            if (c == 39) { in_chr = 0; }
            i = i + 1; continue;
        }
        if (c == 34) { in_str = 1; i = i + 1; continue; }
        if (c == 39) { in_chr = 1; i = i + 1; continue; }
        if (c == 47 && i + 1 < n && (int)line[i + 1] == 47) { return 0; }       // // comment
        if (c == 47 && i + 1 < n && (int)line[i + 1] == 42) { in_block = 1; i = i + 2; continue; }
        i = i + 1;
    }
    if (in_str == 0 && in_chr == 0 && in_block == 0) { return 1; }
    return 0;
}

int pp_active(List<PPCond>* stack) {
    int n = List_len<PPCond>(stack);
    if (n == 0) { return 1; }
    PPCond top = List_get<PPCond>(stack, n - 1);
    if (top.parent == 1 && top.branch == 1) { return 1; }
    return 0;
}

// First whitespace-delimited token of `s` starting at `from` (used for directive
// operands like the name after #ifdef).
string pp_first_word(string s, int from, int n) {
    int p = from;
    while (p < n && pp_is_sp((int)s[p]) == 1) { p = p + 1; }
    int st = p;
    while (p < n && pp_is_sp((int)s[p]) == 0) { p = p + 1; }
    return pp_sub(s, st, p - st);
}

string pp_cat(string a, string b) {
    String o;
    String_init(&o, pp_clen(a) + pp_clen(b) + 1);
    String_append(&o, a); String_append(&o, b);
    return (string)String_cstr(&o);
}

// ── #if / #elif constant expressions (mirrors PPExprEval / ppEvalIf) ──
struct PPEval {
    List<string> toks;
    int pos;
    string err;      // first error ("" = none)
}

string pp_ev_peek(PPEval* ev) {
    if (ev.pos < List_len<string>(&ev.toks)) { return List_get<string>(&ev.toks, ev.pos); }
    return "";
}
int pp_ev_eat(PPEval* ev, string t) {
    if (pp_eq(pp_ev_peek(ev), t) == 1) { ev.pos = ev.pos + 1; return 1; }
    return 0;
}
void pp_ev_fail(PPEval* ev, string msg) {
    if (ev.err[0] == 0) { ev.err = msg; }
}

int64 pp_ev_ternary(PPEval* ev);

int64 pp_ev_primary(PPEval* ev) {
    if (ev.pos >= List_len<string>(&ev.toks)) { pp_ev_fail(ev, "expected a value"); return 0; }
    string t = List_get<string>(&ev.toks, ev.pos);
    ev.pos = ev.pos + 1;
    int c0 = (int)t[0];
    if (pp_eq(t, "(") == 1) {
        int64 v = pp_ev_ternary(ev);
        if (pp_ev_eat(ev, ")") == 0) { pp_ev_fail(ev, "expected ')'"); }
        return v;
    }
    if (c0 >= 48 && c0 <= 57) {
        int n = pp_clen(t);
        while (n > 0 && ((int)t[n - 1] == 117 || (int)t[n - 1] == 85 || (int)t[n - 1] == 108 || (int)t[n - 1] == 76)) { n = n - 1; }
        int hex = 0;
        if (n > 1 && c0 == 48 && ((int)t[1] == 120 || (int)t[1] == 88)) { hex = 1; }
        int base = 10;
        int start = 0;
        if (hex == 1) { base = 16; start = 2; }
        else if (n > 1 && c0 == 48) { base = 8; }
        if (start >= n) { pp_ev_fail(ev, pp_cat(pp_cat("invalid integer '", t), "'")); return 0; }
        int64 v = 0;
        int k = start;
        while (k < n) {
            int c = (int)t[k];
            int dv = 99;
            if (c >= 48 && c <= 57) { dv = c - 48; }
            else if (c >= 97 && c <= 102) { dv = c - 87; }
            else if (c >= 65 && c <= 70) { dv = c - 55; }
            if (dv >= base) { pp_ev_fail(ev, pp_cat(pp_cat("invalid integer '", t), "'")); return 0; }
            v = v * (int64)base + (int64)dv;
            k = k + 1;
        }
        return v;
    }
    if (c0 == 39) {
        int n = pp_clen(t);
        if (n >= 4 && (int)t[1] == 92) {
            int e = (int)t[2];
            if (e == 110) { return 10; }
            if (e == 116) { return 9; }
            if (e == 114) { return 13; }
            if (e == 48) { return 0; }
            return (int64)e;
        }
        if (n >= 3) { return (int64)((int)t[1]); }
        pp_ev_fail(ev, "invalid character constant");
        return 0;
    }
    if (pp_is_alpha(c0) == 1) { return 0; }
    pp_ev_fail(ev, pp_cat(pp_cat("unexpected '", t), "'"));
    return 0;
}

int64 pp_ev_unary(PPEval* ev) {
    if (pp_ev_eat(ev, "!") == 1) { if (pp_ev_unary(ev) == 0) { return 1; } return 0; }
    if (pp_ev_eat(ev, "~") == 1) { return ~pp_ev_unary(ev); }
    if (pp_ev_eat(ev, "-") == 1) { return 0 - pp_ev_unary(ev); }
    if (pp_ev_eat(ev, "+") == 1) { return pp_ev_unary(ev); }
    return pp_ev_primary(ev);
}

int64 pp_ev_mul(PPEval* ev) {
    int64 v = pp_ev_unary(ev);
    while (1 == 1) {
        if (pp_ev_eat(ev, "*") == 1) { v = v * pp_ev_unary(ev); }
        else if (pp_eq(pp_ev_peek(ev), "/") == 1 || pp_eq(pp_ev_peek(ev), "%") == 1) {
            int dv = pp_eq(pp_ev_peek(ev), "/");
            ev.pos = ev.pos + 1;
            int64 r = pp_ev_unary(ev);
            if (r == 0) { pp_ev_fail(ev, "division by zero"); return 0; }
            if (dv == 1) { v = v / r; } else { v = v % r; }
        } else { return v; }
    }
    return v;
}
int64 pp_ev_add(PPEval* ev) {
    int64 v = pp_ev_mul(ev);
    while (1 == 1) {
        if (pp_ev_eat(ev, "+") == 1) { v = v + pp_ev_mul(ev); }
        else if (pp_ev_eat(ev, "-") == 1) { v = v - pp_ev_mul(ev); }
        else { return v; }
    }
    return v;
}
int64 pp_ev_shift(PPEval* ev) {
    int64 v = pp_ev_add(ev);
    while (1 == 1) {
        if (pp_ev_eat(ev, "<<") == 1) { v = (int64)((uint64)v << (uint64)(pp_ev_add(ev) & 63)); }
        else if (pp_ev_eat(ev, ">>") == 1) { v = v >> (pp_ev_add(ev) & 63); }
        else { return v; }
    }
    return v;
}
int64 pp_b2i(bool b) { if (b) { return 1; } return 0; }
int64 pp_ev_rel(PPEval* ev) {
    int64 v = pp_ev_shift(ev);
    while (1 == 1) {
        if (pp_ev_eat(ev, "<") == 1) { v = pp_b2i(v < pp_ev_shift(ev)); }
        else if (pp_ev_eat(ev, ">") == 1) { v = pp_b2i(v > pp_ev_shift(ev)); }
        else if (pp_ev_eat(ev, "<=") == 1) { v = pp_b2i(v <= pp_ev_shift(ev)); }
        else if (pp_ev_eat(ev, ">=") == 1) { v = pp_b2i(v >= pp_ev_shift(ev)); }
        else { return v; }
    }
    return v;
}
int64 pp_ev_eq(PPEval* ev) {
    int64 v = pp_ev_rel(ev);
    while (1 == 1) {
        if (pp_ev_eat(ev, "==") == 1) { v = pp_b2i(v == pp_ev_rel(ev)); }
        else if (pp_ev_eat(ev, "!=") == 1) { v = pp_b2i(v != pp_ev_rel(ev)); }
        else { return v; }
    }
    return v;
}
int64 pp_ev_band(PPEval* ev) {
    int64 v = pp_ev_eq(ev);
    while (pp_ev_eat(ev, "&") == 1) { v = v & pp_ev_eq(ev); }
    return v;
}
int64 pp_ev_bxor(PPEval* ev) {
    int64 v = pp_ev_band(ev);
    while (pp_ev_eat(ev, "^") == 1) { v = v ^ pp_ev_band(ev); }
    return v;
}
int64 pp_ev_bor(PPEval* ev) {
    int64 v = pp_ev_bxor(ev);
    while (pp_ev_eat(ev, "|") == 1) { v = v | pp_ev_bxor(ev); }
    return v;
}
int64 pp_ev_land(PPEval* ev) {
    int64 v = pp_ev_bor(ev);
    while (pp_ev_eat(ev, "&&") == 1) { int64 r = pp_ev_bor(ev); v = pp_b2i(v != 0 && r != 0); }
    return v;
}
int64 pp_ev_lor(PPEval* ev) {
    int64 v = pp_ev_land(ev);
    while (pp_ev_eat(ev, "||") == 1) { int64 r = pp_ev_land(ev); v = pp_b2i(v != 0 || r != 0); }
    return v;
}
int64 pp_ev_ternary(PPEval* ev) {
    int64 c = pp_ev_lor(ev);
    if (pp_ev_eat(ev, "?") == 0) { return c; }
    int64 a = pp_ev_ternary(ev);
    if (pp_ev_eat(ev, ":") == 0) { pp_ev_fail(ev, "expected ':' in '?:'"); return 0; }
    int64 b = pp_ev_ternary(ev);
    if (c != 0) { return a; }
    return b;
}

// Split an (already macro-expanded) #if expression into tokens (mirrors ppExprTokens).
void pp_ev_tokens(PPEval* ev, string e) {
    int n = pp_clen(e);
    int i = 0;
    string ops1 = "()!~-+*/%<>&^|?:";
    while (i < n) {
        int c = (int)e[i];
        if (c == 32 || c == 9) { i = i + 1; continue; }
        if (c == 47 && i + 1 < n && (int)e[i + 1] == 47) { return; }
        if (c == 47 && i + 1 < n && (int)e[i + 1] == 42) {
            int j = i + 2;
            while (j + 1 < n && ((int)e[j] != 42 || (int)e[j + 1] != 47)) { j = j + 1; }
            if (j + 1 < n) { i = j + 2; } else { i = n; }
            continue;
        }
        if (pp_is_alnum(c) == 1) {
            int j = i;
            while (j < n && pp_is_alnum((int)e[j]) == 1) { j = j + 1; }
            List_push<string>(&ev.toks, pp_sub(e, i, j - i)); i = j; continue;
        }
        if (c == 39) {
            int j = i + 1;
            while (j < n && (int)e[j] != 39) { if ((int)e[j] == 92) { j = j + 1; } j = j + 1; }
            int end = j + 1;
            if (end > n) { end = n; }
            List_push<string>(&ev.toks, pp_sub(e, i, end - i)); i = j + 1; continue;
        }
        if (i + 1 < n) {
            int d = (int)e[i + 1];
            if ((c == 124 && d == 124) || (c == 38 && d == 38) || (c == 61 && d == 61) || (c == 33 && d == 61)
                || (c == 60 && d == 61) || (c == 62 && d == 61) || (c == 60 && d == 60) || (c == 62 && d == 62)) {
                List_push<string>(&ev.toks, pp_sub(e, i, 2)); i = i + 2; continue;
            }
        }
        int k = 0;
        int found = 0;
        while (ops1[k] != 0) { if ((int)ops1[k] == c) { found = 1; } k = k + 1; }
        if (found == 1) { List_push<string>(&ev.toks, pp_sub(e, i, 1)); i = i + 1; continue; }
        pp_ev_fail(ev, pp_cat(pp_cat("unexpected character '", pp_sub(e, i, 1)), "'"));
        return;
    }
}

// Replace `defined X` / `defined(X)` with 1/0, macro-expand, then evaluate. Returns 1
// and sets *value on success; 0 with *err set on a malformed expression.
int pp_eval_if(string expr, List<PPMacro>* tbl, *int64 value, *string err) {
    String pre;
    String_init(&pre, pp_clen(expr) + 16);
    int n = pp_clen(expr);
    int i = 0;
    while (i < n) {
        int c = (int)expr[i];
        if (pp_is_alpha(c) == 1) {
            int j = i;
            while (j < n && pp_is_alnum((int)expr[j]) == 1) { j = j + 1; }
            string id = pp_sub(expr, i, j - i);
            if (pp_eq(id, "defined") == 0) { String_append(&pre, id); i = j; continue; }
            int k = j;
            while (k < n && pp_is_sp((int)expr[k]) == 1) { k = k + 1; }
            int paren = 0;
            if (k < n && (int)expr[k] == 40) { paren = 1; k = k + 1; while (k < n && pp_is_sp((int)expr[k]) == 1) { k = k + 1; } }
            int m = k;
            while (m < n && pp_is_alnum((int)expr[m]) == 1) { m = m + 1; }
            if (m == k) { err[0] = "expected a macro name after 'defined'"; return 0; }
            string name = pp_sub(expr, k, m - k);
            if (paren == 1) {
                while (m < n && pp_is_sp((int)expr[m]) == 1) { m = m + 1; }
                if (m >= n || (int)expr[m] != 41) { err[0] = pp_cat(pp_cat("expected ')' after 'defined(", name), "'"); return 0; }
                m = m + 1;
            }
            if (pp_defined(tbl, name) == 1) { String_append(&pre, " 1 "); } else { String_append(&pre, " 0 "); }
            i = m; continue;
        }
        if (c == 39) {
            int j = i + 1;
            while (j < n && (int)expr[j] != 39) { if ((int)expr[j] == 92) { j = j + 1; } j = j + 1; }
            int e = j + 1;
            if (e > n) { e = n; }
            String_append(&pre, pp_sub(expr, i, e - i)); i = e; continue;
        }
        String_push(&pre, (char)c); i = i + 1;
    }
    List<string> expanding;
    List_init<string>(&expanding, 4);
    int b0 = 0;
    string expanded = pp_expand((string)String_cstr(&pre), tbl, &expanding, &b0);
    let ev: PPEval;
    List_init<string>(&ev.toks, 8);
    ev.pos = 0;
    ev.err = "";
    pp_ev_tokens(&ev, expanded);
    if (ev.err[0] != 0) { err[0] = pp_cat(ev.err, " in #if expression"); return 0; }
    if (List_len<string>(&ev.toks) == 0) { err[0] = "#if with no expression"; return 0; }
    int64 v = pp_ev_ternary(&ev);
    if (ev.err[0] != 0) { err[0] = pp_cat(ev.err, " in #if expression"); return 0; }
    if (ev.pos != List_len<string>(&ev.toks)) {
        err[0] = pp_cat(pp_cat("unexpected '", List_get<string>(&ev.toks, ev.pos)), "' in #if expression");
        return 0;
    }
    value[0] = v;
    return 1;
}

// Does a macro body use `#` / `##` outside a string/char literal (mirrors ppBodyHasHash)?
int pp_body_has_hash(string body) {
    int n = pp_clen(body);
    int i = 0;
    while (i < n) {
        int c = (int)body[i];
        if (c == 34 || c == 39) {
            int q = c; i = i + 1;
            while (i < n && (int)body[i] != q) { if ((int)body[i] == 92) { i = i + 1; } i = i + 1; }
            i = i + 1; continue;
        }
        if (c == 35) { return 1; }
        i = i + 1;
    }
    return 0;
}

// Evaluate an #if/#elif condition; a malformed one is reported and counts as false.
int pp_cond_value(string rest, List<PPMacro>* tbl, string file, int line, int col, *int had_err) {
    let v: int64 = 0;
    let err: string = "";
    if (pp_eval_if(rest, tbl, &v, &err) == 0) { pp_error(file, line, col, err, had_err); return 0; }
    if (v != 0) { return 1; }
    return 0;
}

// Drop a trailing '\r' (CRLF input) from a line being read.
void pp_strip_cr(String* s) {
    if (s.len > 0 && (int)s.data[s.len - 1] == 13) { pp_pop(s); }
}

// The architecture macro of the host this compiler was built for (mirrors the C++
// seedPredefinedMacros default).
string pp_host_arch() {
    string a = "";
#ifdef __aarch64__
    a = "__aarch64__";
#endif
#ifdef __x86_64__
    a = "__x86_64__";
#endif
    return a;
}

// Preprocess `src` (length `len`) into a returned NUL-terminated string. `filename`
// becomes __FILE__ (quoted) and labels diagnostics. Sets `*had_err` to 1 after
// reporting any directive error (an active #error, a bad #if, an unbalanced
// conditional, an unknown directive).
string pp_run(string src, int len, string filename, *int had_err) {
    had_err[0] = 0;
    List<PPMacro> tbl;
    List_init<PPMacro>(&tbl, 16);

    // Predefined __FILE__ = "<filename>" (an ordinary object-like macro).
    String fb;
    String_init(&fb, pp_clen(filename) + 2);
    String_push(&fb, (char)34);
    String_append(&fb, filename);
    String_push(&fb, (char)34);
    PPMacro fm;
    fm.name = "__FILE__"; fm.is_function = 0; List_init<string>(&fm.params, 1);
    fm.body = (string)String_cstr(&fb);
    pp_define(&tbl, fm);

    // Host OS macro (e.g. __APPLE__/__linux__), so platform `#ifdef`s in the stdlib pick
    // the right branch (set by every driver; the C++ seeds it in every mode).
    if (g_pp_os != null) { if (g_pp_os[0] != 0) {
        PPMacro om; om.name = g_pp_os; om.is_function = 0; List_init<string>(&om.params, 1); om.body = "1";
        pp_define(&tbl, om);
    } }
    if (g_pp_arch == null) { g_pp_arch = pp_host_arch(); }   // unset: the host's, like the C++
    if (g_pp_arch != null) { if (g_pp_arch[0] != 0) {
        PPMacro am; am.name = g_pp_arch; am.is_function = 0; List_init<string>(&am.params, 1); am.body = "1";
        pp_define(&tbl, am);
    } }

    int pdi = 0;
    while (pdi < List_len<string>(&g_pp_predef)) {
        PPMacro xm; xm.name = List_get<string>(&g_pp_predef, pdi); xm.is_function = 0;
        List_init<string>(&xm.params, 1); xm.body = "1";
        pp_define(&tbl, xm);
        pdi = pdi + 1;
    }

    List<PPCond> stack;
    List_init<PPCond>(&stack, 8);

    String out;
    String_init(&out, len + 16);
    int first = 1;
    int i = 0;
    int cur_line = 0;
    int in_block = 0;                                // a /* */ comment is open at line start

    while (i < len) {
        // Read one physical line [start, i) excluding '\n' (getline semantics).
        String line;
        String_init(&line, 64);
        while (i < len && (int)src[i] != 10) { String_push(&line, (char)src[i]); i = i + 1; }
        if (i < len) { i = i + 1; }                  // consume the '\n'
        pp_strip_cr(&line);                          // CRLF input: drop the '\r'
        cur_line = cur_line + 1;
        int line_no = cur_line;

        // Line splicing: a real trailing '\' joins the next physical line. Each
        // continuation becomes a trailing blank line so later line numbers hold.
        int extra = 0;
        while (String_len(&line) > 0
               && (int)String_char_at(&line, String_len(&line) - 1) == 92
               && pp_bs_continues((string)String_cstr(&line)) == 1) {
            pp_pop(&line);                           // drop the '\'
            if (i >= len) { break; }                 // no continuation line (getline fail)
            while (i < len && (int)src[i] != 10) { String_push(&line, (char)src[i]); i = i + 1; }
            if (i < len) { i = i + 1; }
            pp_strip_cr(&line);
            extra = extra + 1;
            cur_line = cur_line + 1;
        }

        if (first == 0) { String_push(&out, (char)10); }
        first = 0;

        string ls = (string)String_cstr(&line);
        int ln = String_len(&line);
        int active = pp_active(&stack);

        // Leading non-space char.
        int h = 0;
        while (h < ln && pp_is_sp((int)ls[h]) == 1) { h = h + 1; }
        int handled = 0;

        // A `#!` first line is a shebang (`#!/usr/bin/env eskiuc run`), not a directive.
        int shebang = 0;
        if (line_no == 1 && ln >= 2 && (int)ls[0] == 35 && (int)ls[1] == 33) { shebang = 1; }
        if (in_block == 0 && h < ln && (int)ls[h] == 35) {   // '#'
            handled = 1;
            int col = h + 1;
            int p = h + 1;
            while (p < ln && pp_is_sp((int)ls[p]) == 1) { p = p + 1; }
            int ks = p;
            while (p < ln && pp_is_alnum((int)ls[p]) == 1) { p = p + 1; }
            string kw = pp_sub(ls, ks, p - ks);
            string rest = pp_trim(pp_sub(ls, p, ln - p));
            string operand = pp_first_word(rest, 0, pp_clen(rest));

            if (pp_eq(kw, "define") == 1) {
                if (active == 1) {
                    int rn = pp_clen(rest);
                    int q = 0;
                    while (q < rn && pp_is_alnum((int)rest[q]) == 1) { q = q + 1; }
                    string name = pp_sub(rest, 0, q);
                    PPMacro mac;
                    mac.name = name; mac.is_function = 0; List_init<string>(&mac.params, 2); mac.body = "";
                    if (q < rn && (int)rest[q] == 40) {           // function-like
                        mac.is_function = 1;
                        int r = q + 1;
                        String cur;
                        String_init(&cur, 16);
                        int done = 0;
                        while (r < rn && done == 0) {
                            int d = (int)rest[r];
                            if (d == 41) { r = r + 1; done = 1; }       // ')' → consume + stop
                            else if (d == 44) {
                                string t = pp_trim((string)String_cstr(&cur));
                                if (pp_clen(t) > 0) { List_push<string>(&mac.params, t); }
                                String_clear(&cur);
                                r = r + 1;
                            } else { String_push(&cur, (char)d); r = r + 1; }
                        }
                        string t = pp_trim((string)String_cstr(&cur));
                        if (pp_clen(t) > 0) { List_push<string>(&mac.params, t); }
                        if (r < rn) { mac.body = pp_trim(pp_sub(rest, r, rn - r)); }
                        else { mac.body = ""; }
                    } else {
                        if (q < rn) { mac.body = pp_trim(pp_sub(rest, q, rn - q)); }
                        else { mac.body = ""; }
                    }
                    if (pp_clen(name) == 0) { pp_error(filename, line_no, col, "expected a macro name after #define", had_err); }
                    else if (pp_body_has_hash(mac.body) == 1) {
                        pp_error(filename, line_no, col, pp_cat(pp_cat("macro '", name),
                            "': '#' stringification and '##' token pasting are not supported"), had_err);
                    }
                    else { pp_define(&tbl, mac); }
                }
            } else if (pp_eq(kw, "undef") == 1) {
                if (active == 1) { pp_undef(&tbl, operand); }
            } else if (pp_eq(kw, "ifdef") == 1 || pp_eq(kw, "ifndef") == 1) {
                int on = 0;
                if (active == 1) {
                    if (pp_clen(operand) == 0) { pp_error(filename, line_no, col, pp_cat("expected a macro name after #", kw), had_err); }
                    int want = pp_eq(kw, "ifdef");
                    if (pp_defined(&tbl, operand) == want) { on = 1; }
                }
                PPCond cnd; cnd.parent = active; cnd.branch = on; cnd.taken = on; cnd.saw_else = 0;
                cnd.line = line_no; cnd.col = col;
                List_push<PPCond>(&stack, cnd);
            } else if (pp_eq(kw, "if") == 1) {
                int on = 0;
                if (active == 1) { on = pp_cond_value(rest, &tbl, filename, line_no, col, had_err); }
                PPCond cnd; cnd.parent = active; cnd.branch = on; cnd.taken = on; cnd.saw_else = 0;
                cnd.line = line_no; cnd.col = col;
                List_push<PPCond>(&stack, cnd);
            } else if (pp_eq(kw, "elif") == 1) {
                int sn = List_len<PPCond>(&stack);
                if (sn == 0) { pp_error(filename, line_no, col, "#elif without #if", had_err); }
                else {
                    PPCond cc = List_get<PPCond>(&stack, sn - 1);
                    if (cc.saw_else == 1) { pp_error(filename, line_no, col, "#elif after #else", had_err); }
                    else {
                        int on = 0;
                        if (cc.parent == 1 && cc.taken == 0) { on = pp_cond_value(rest, &tbl, filename, line_no, col, had_err); }
                        cc.branch = on;
                        if (on == 1) { cc.taken = 1; }
                        List_set<PPCond>(&stack, sn - 1, cc);
                    }
                }
            } else if (pp_eq(kw, "else") == 1) {
                int sn = List_len<PPCond>(&stack);
                if (sn == 0) { pp_error(filename, line_no, col, "#else without #if", had_err); }
                else {
                    PPCond cc = List_get<PPCond>(&stack, sn - 1);
                    if (cc.saw_else == 1) { pp_error(filename, line_no, col, "#else after #else", had_err); }
                    else {
                        if (cc.taken == 0) { cc.branch = 1; } else { cc.branch = 0; }
                        cc.taken = 1;
                        cc.saw_else = 1;
                        List_set<PPCond>(&stack, sn - 1, cc);
                    }
                }
            } else if (pp_eq(kw, "endif") == 1) {
                int sn = List_len<PPCond>(&stack);
                if (sn == 0) { pp_error(filename, line_no, col, "#endif without #if", had_err); }
                else { List_remove<PPCond>(&stack, sn - 1); }
            } else if (pp_eq(kw, "pragma") == 1) {
                if (active == 1) { String_append(&out, pp_trim(pp_sub(ls, h, ln - h))); }
            } else if (pp_eq(kw, "error") == 1) {
                if (active == 1) { pp_error(filename, line_no, col, pp_cat("#error ", rest), had_err); }
            } else if (pp_eq(kw, "include") == 1) {
                if (active == 1) {
                    pp_error(filename, line_no, col, "#include is not supported; use `import \"file.esk\";` or `import <module>;` instead", had_err);
                }
            } else if (pp_clen(kw) == 0 && (pp_clen(rest) == 0 || shebang == 1)) {
                // `#` alone is the null directive; a `#!` first line is a shebang.
            } else if (active == 1) {
                string what = kw;
                if (pp_clen(kw) == 0) { what = rest; }
                pp_error(filename, line_no, col, pp_cat(pp_cat("unknown preprocessor directive '#", what), "'"), had_err);
            }
        }

        if (handled == 0 && active == 1) {
            // Refresh __LINE__ for this logical line, then expand.
            String nb;
            String_init(&nb, 12);
            String_from_int(&nb, line_no);
            PPMacro lm;
            lm.name = "__LINE__"; lm.is_function = 0; List_init<string>(&lm.params, 1);
            lm.body = (string)String_cstr(&nb);
            pp_define(&tbl, lm);

            List<string> expanding;
            List_init<string>(&expanding, 4);
            String_append(&out, pp_expand(ls, &tbl, &expanding, &in_block));
        } else {
            in_block = pp_ends_in_block(ls, in_block);
        }

        int e = 0;
        while (e < extra) { String_push(&out, (char)10); e = e + 1; }
    }
    int si = 0;
    while (si < List_len<PPCond>(&stack)) {
        PPCond oc = List_get<PPCond>(&stack, si);
        pp_error(filename, oc.line, oc.col, "unterminated conditional directive (missing #endif)", had_err);
        si = si + 1;
    }

    return (string)String_cstr(&out);
}
