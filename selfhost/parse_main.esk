// Driver: `eskiuc run selfhost/parse_main.esk FILE` (or compiled) — parse FILE and
// print its AST in the C++ `--test-parser` format (just the dump, from "Program"
// down). The parity harness strips the C++ banner and raw-diffs the two.

import <io>;
import <fs>;
import "preprocessor.esk";
import "parser.esk";
import "bigstack.esk";

int parse_main(int argc, string* argv) {
    if (argc < 2) {
        printf("usage: parse_main <file.esk>\n");
        return 1;
    }
    let n: int64 = 0;
    *uint8 raw = fs_read_all(argv[1], &n);
    if (raw == null) {
        printf("error: cannot read %s\n", argv[1]);
        return 1;
    }
    // Preprocess the top-level file first so the parser sees the same token stream
    // the C++ `--test-parser` does: it preprocesses like a real build (host OS macro,
    // __FILE__ = the path).
#ifdef __APPLE__
    g_pp_os = "__APPLE__";
#else
    g_pp_os = "__linux__";
#endif
    let pperr: int = 0;
    string pp = pp_run((string)raw, (int)n, argv[1], &pperr);
    *uint8 src = (*uint8)pp;
    int plen = 0;
    while (src[plen] != 0) { plen = plen + 1; }

    parser_session_init();
    register_file(argv[1]);
    let p: Parser;
    g_lex_file = argv[1];
    p_init(&p, src, plen);
    p.basedir = str_dir(argv[1]);          // relative imports resolve from here
    *Program prog = parse_program(&p);
    print_program(prog);
    return 0;
}

// Run the driver on a thread with a large stack, so deeply nested input reaches the
// parser's nesting limit instead of overflowing the stack (see bigstack.esk).
void main_body() { big_rc = parse_main(big_argc, big_argv); }
int main(int argc, string* argv) {
    big_argc = argc;
    big_argv = argv;
    run_on_big_stack(main_body);
    return big_rc;
}
