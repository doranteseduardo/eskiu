// main.esk — QR decoder entry point.
//
// Orchestrates the three pipeline stages, collects timing, and writes output.
// All pipeline logic lives in pipeline.esk; this file handles I/O only.

import "pipeline.esk";

string IMAGE_PATH = "/Users/dorantes/Documents/Eduardo/ine-qr-analysis/IMG_8372.HEIC";
string OUT_JSON   = "/tmp/qr_decoded.json";
string OUT_WEBP   = "/tmp/qr_decoded.webp";

int write_file(string path, *uint8 data, int len) {
    *void fp = fopen(path, "wb");
    if (fp == null) return 0;
    fwrite(data, 1, len, fp);
    fclose(fp);
    return 1;
}

void print_timing(PipelineTiming* t) {
    printf("\n  QR extraction : %6.1f ms\n", t.qr_ms);
    printf("  Crypto        : %6.1f ms\n",   t.crypto_ms);
    printf("  Output decode : %6.1f ms\n",   t.decode_ms);
    printf("  ─────────────────────────\n");
    printf("  Total         : %6.1f ms\n",   t.total_ms);
}

int main() {
    printf("qr-decoder v0.1  (Eskiu)\n");
    printf("========================\n\n");

    let timing: PipelineTiming;
    int64 t_start = clock();
    int64 t0      = clock();

    // ── Stage 1: QR extraction ────────────────────────────────────────────
    let qr: QRPair;
    let r1: Result<int, string> = stage_extract(IMAGE_PATH, &qr);
    timing.qr_ms = ticks_to_ms(clock() - t0);

    if (r1.ok == 0) {
        printf("error: stage 1: %s\n", r1.error);
        return 1;
    }
    printf("[1/3] QR extracted        (%3.0f ms)\n", timing.qr_ms);

    // ── Stage 2: crypto pipeline ──────────────────────────────────────────
    t0 = clock();
    let plain: *uint8 = null;
    int64 plain_len   = 0;
    let r2: Result<int, string> = stage_crypto(&qr, &plain, &plain_len);
    timing.crypto_ms = ticks_to_ms(clock() - t0);

    if (r2.ok == 0) {
        printf("error: stage 2: %s\n", r2.error);
        return 1;
    }
    printf("[2/3] Crypto complete      (%3.0f ms, %d bytes)\n",
           timing.crypto_ms, plain_len);

    // ── Stage 3: output decode  (stage_decode takes ownership of plain) ───
    t0 = clock();
    let json: *char   = null;
    int64 json_len    = 0;
    let webp: *uint8  = null;
    int64 webp_len    = 0;
    let r3: Result<int, string> = stage_decode(plain, plain_len,
                                                &json, &json_len,
                                                &webp, &webp_len);
    timing.decode_ms = ticks_to_ms(clock() - t0);

    if (r3.ok == 0) {
        printf("error: stage 3: %s\n", r3.error);
        return 1;
    }
    printf("[3/3] Decoded              (%3.0f ms, json=%lld webp=%lld)\n",
           timing.decode_ms, json_len, webp_len);

    timing.total_ms = ticks_to_ms(clock() - t_start);
    printf("\nTiming breakdown:");
    print_timing(&timing);

    // ── Output ────────────────────────────────────────────────────────────
    if (json != null) {
        printf("\n%s\n", json);
        write_file(OUT_JSON, json, json_len);
        printf("\nJSON  → %s\n", OUT_JSON);
    }
    if (webp != null) {
        write_file(OUT_WEBP, webp, (int)webp_len);
        printf("WebP  → %s  (%lld bytes)\n", OUT_WEBP, webp_len);
    }

    if (json != null) free(json);
    if (webp != null) free(webp);

    return 0;
}
