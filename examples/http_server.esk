// http_server.esk — a concurrent HTTP/1.1 server using the <http> stdlib.
//
//   eskiuc examples/http_server.esk -o http_server && ./http_server
//   # then: curl http://127.0.0.1:8080/  or  curl http://127.0.0.1:8080/ping
//
// The request is parsed for you; the handler just fills in the response. A pool
// of worker threads serves connections concurrently (<http> sits on <net> +
// <threading>).

import <http>;

extern int printf(string fmt, ...);

// One handler, called once per request. Route on the parsed path.
void handle(HttpRequest* req, HttpResponse* res) {
    HttpResponse_header(res, "Content-Type", "text/plain");
    HttpResponse_header(res, "Connection", "close");
    if (String_eq_cstr(&req.path, "/ping") == 1) {
        HttpResponse_set_body(res, "pong\n");
    } else {
        HttpResponse_body_append(res, "Hello from an HTTP server written in Eskiu.\n");
        HttpResponse_body_append(res, "You asked for: ");
        HttpResponse_body_append(res, String_cstr(&req.path));
        HttpResponse_body_append(res, "\n");
    }
}

int main() {
    printf("Eskiu HTTP server listening on http://127.0.0.1:8080 (4 workers)\n");
    http_serve(8080, 4, handle);   // blocks, serving across 4 threads
    return 0;
}
