// files.esk: walk a directory tree, glob for source files, and count lines,
// then build and clean up a scratch directory with the <fs> stdlib.
//
//   eskiuc examples/files.esk -o files && ./files stdlib

import <fs>;
import <io>;

int main(int argc, string* argv) {
    const string root = argc > 1 ? argv[1] : ".";

    // Every entry under root, depth first and sorted; links are not followed.
    int dirs = 0;
    int files = 0;
    let fp: *int = &files;
    let dp: *int = &dirs;
    if (fs_walk(root, void(string path, bool is_dir) {
        if (is_dir) {
            *dp = *dp + 1;
        } else {
            *fp = *fp + 1;
        }
    }) != 0) {
        let err: String;
        err.init(32);
        fs_last_error(&err);
        printf("cannot walk %s: %s\n", root, err.data);
        err.free();
        return 1;
    }
    printf("%s: %d directories, %d files\n", root, dirs, files);

    // The .esk files anywhere below root, with their line counts.
    let pattern: String;
    pattern.init(32);
    pattern.append(root);
    pattern.append("/**/*.esk");
    let found: List<String>;
    List_init<String>(&found, 16);
    const int n = fs_glob(pattern.cstr(), &found);
    int64 total = 0;
    for (i in 0..n) {
        string path = List_get<String>(&found, i).data;
        let lines: List<String>;
        List_init<String>(&lines, 64);
        if (fs_read_lines(path, &lines) == 0) {
            total += (int64)lines.size;
            if (i < 5) {
                printf("  %5d  %s\n", lines.size, path);
            }
        }
        fs_list_free(&lines);
    }
    if (n > 5) {
        printf("  ... and %d more\n", n - 5);
    }
    printf("%d .esk files, %lld lines\n", n, total);
    fs_list_free(&found);
    pattern.free();

    // A scratch directory: create, fill, inspect, remove.
    let tmp: String;
    tmp.init(64);
    if (fs_temp_dir("files_example_", &tmp) != 0) {
        return 1;
    }
    let path: String;
    path.init(64);
    path.append(tmp.cstr());
    path.append("/notes/today");
    fs_mkdir_p(path.cstr());
    path.append("/todo.txt");
    fs_write_text(path.cstr(), "write the report\n");
    fs_append_text(path.cstr(), "call the bank\n");
    let st: FileStat;
    fs_stat(path.cstr(), &st);
    printf("scratch file: %lld bytes\n", st.size);
    fs_remove_all(tmp.cstr());
    printf("scratch removed: %d\n", fs_exists(tmp.cstr()) == 0 ? 1 : 0);
    path.free();
    tmp.free();
    return 0;
}
