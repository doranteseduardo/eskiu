// process_spawn.esk: the fork example without fork(), on every platform.
//
//   eskiuc examples/process_spawn.esk -o process_spawn && ./process_spawn
//
// The child is this same program started again with an extra argument, so the
// "child" branch is chosen by argv instead of by fork()'s return value.
// process_spawn flushes stdout before starting a child that writes to it, so
// "before spawn" is printed first without an explicit fflush.
import <io>;
import <process>;
import <list>;

int main(int argc, string* argv) {
    if (argc > 1 && strcmp(argv[1], "--child") == 0) {
        println("in the child");
        return 0;
    }

    println("before spawn");
    let args: List<string>;  List_init<string>(&args, 2);
    defer List_free<string>(&args);
    args.push(argv[0]);
    args.push("--child");

    let opts: ProcessOptions;        // every field starts at zero
    opts.inherit_stdout = true;      // the child writes to our stdout
    let p: Process;
    if (process_spawn(&args, &opts, &p) != 0) {
        let why: String;  String_init(&why, 64);
        process_last_error(&why);
        println_err(why.cstr());
        return 1;
    }
    println("in the parent");
    int code = Process_wait(&p);     // like waitpid: reaps the child, returns its exit code
    Process_free(&p);
    return code;
}
