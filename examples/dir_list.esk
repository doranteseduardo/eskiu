// dir_list.esk: a small `ls`-like command-line tool built on <args>, <term>,
// <log> and <time>.
//
//   eskiuc examples/dir_list.esk -o dir_list
//   ./dir_list --help
//   ./dir_list -l stdlib examples          # sizes and modification times
//   ./dir_list -a --min-size 4096 .         # hidden files too, at least 4 KiB
//   LOG_LEVEL=debug ./dir_list -v .         # progress messages on stderr
//   NO_COLOR=1 ./dir_list .                 # no colors (also when piped)
//
// Directories print in bold blue, files over 1 MiB in yellow. Exit code 2 for a
// usage error, 1 when a directory cannot be read.

import <args>;
import <term>;
import <log>;
import <fs>;
import <path>;

// "12.3K"-style size into `out`.
void human_size(int64 n, String* out) {
    if (n < 1024) { str_format(out, "%lldB", n); return; }
    const string[4] units = {"K", "M", "G", "T"};
    double v = (double)n / 1024.0;
    int u = 0;
    while (v >= 1024.0 && u < 3) { v = v / 1024.0; u++; }
    str_format(out, "%.1f%s", v, units[u]);
}

int list_dir(ArgParser* p, string dir) {
    let names: List<String>;  List_init<String>(&names, 32);
    defer fs_list_free(&names);
    if (fs_list_dir(dir, &names) != 0) {
        let err: String;  err.init(64);
        fs_last_error(&err);
        log_error("cannot read %s: %s", dir, err.cstr());
        err.free();
        return 1;
    }
    log_debug("%s: %d entries", dir, names.size);
    const bool all = ArgParser_get_flag(p, "all") == 1;
    const bool long_fmt = ArgParser_get_flag(p, "long") == 1;
    const int64 min_size = (int64)ArgParser_get_int(p, "min-size");
    let path: String;  path.init(64);
    let line: String;  line.init(128);
    let cell: String;  cell.init(32);
    int shown = 0;
    for (i in 0..names.size) {
        *String name = &names.data[i];
        if (!all && name.data[0] == '.') { continue; }
        path_join(&path, dir, name.cstr());
        let st: FileStat;
        if (fs_lstat(path.cstr(), &st) != 0) { log_warn("cannot stat %s", path.cstr()); continue; }
        if (!st.is_dir && st.size < min_size) { continue; }
        line.clear();
        if (long_fmt) {
            human_size(st.size, &cell);
            cell.pad_left(8, ' ');
            line.concat(&cell);
            line.append("  ");
            time_format(st.mtime, "%Y-%m-%d %H:%M", TIME_LOCAL, &cell);
            line.concat(&cell);
            line.append("  ");
        }
        int64 style = TERM_PLAIN;
        if (st.is_dir) { style = TERM_BOLD | TERM_BLUE; }
        else if (st.is_symlink) { style = TERM_CYAN; }
        else if (st.size > 1048576) { style = TERM_YELLOW; }
        term_style(&line, name.cstr(), style);
        if (st.is_dir) { line.push('/'); }
        println(line.cstr());
        shown++;
    }
    log_debug("%s: %d shown", dir, shown);
    path.free();
    line.free();
    cell.free();
    return 0;
}

int main(int argc, string* argv) {
    let p: ArgParser;
    ArgParser_init(&p, "dir_list", "List the entries of each directory (default: the current one).");
    defer ArgParser_free(&p);
    ArgParser_flag(&p, "-a", "--all", "include entries starting with '.'");
    ArgParser_flag(&p, "-l", "--long", "show sizes and modification times");
    ArgParser_flag(&p, "-v", "--verbose", "log progress to stderr");
    ArgParser_option_int(&p, "-m", "--min-size", "BYTES", 0, "skip files smaller than BYTES");
    ArgParser_argument(&p, "dirs", "directories to list", ARGS_MANY);
    ArgParser_parse_or_exit(&p, argc, argv);

    if (ArgParser_get_flag(&p, "verbose") == 1) { log_set_level(LOG_DEBUG); }
    let sw: Stopwatch;
    sw.start();
    int rc = 0;
    const int n = ArgParser_count(&p, "dirs");
    if (n == 0) { rc = list_dir(&p, "."); }
    for (i in 0..n) {
        if (n > 1) {
            if (i > 0) { println(""); }
            let head: String;  head.init(32);
            term_style(&head, ArgParser_get_at(&p, "dirs", i), TERM_UNDERLINE);
            head.push(':');
            println(head.cstr());
            head.free();
        }
        if (list_dir(&p, ArgParser_get_at(&p, "dirs", i)) != 0) { rc = 1; }
    }
    let took: String;  took.init(16);
    duration_format(sw.elapsed_ms(), &took);
    log_debug("done in %s", took.cstr());
    took.free();
    return rc;
}
