// generics.esk — templates in Eskiu: the generic List<T>, a template function
// with inference, and a multi-parameter template struct.
//
//   eskiuc examples/generics.esk -o generics && ./generics

import <list>;

extern int printf(string fmt, ...);

// A two-parameter template struct.
struct Pair<A, B> { A first; B second; }

// A template function — instantiated per concrete type, inferred from the args.
T max<T>(T a, T b) {
    if (a > b) { return a; }
    return b;
}

int main() {
    // List<T> with automatic resizing.
    let nums: List<int>;  List_init<int>(&nums, 2);
    int i = 0;
    while (i < 6) { List_push<int>(&nums, i * i); i = i + 1; }
    printf("squares:");
    i = 0;
    while (i < List_len<int>(&nums)) { printf(" %d", List_get<int>(&nums, i)); i = i + 1; }
    printf("\n");
    List_free<int>(&nums);

    // The same template function over int and double (two monomorphizations).
    printf("max(3,9)=%d  max(2.5,1.5)=%.1f\n", max(3, 9), max(2.5, 1.5));

    // A template struct instance.
    let p: Pair<int, int>;  p.first = 10;  p.second = 20;
    printf("pair=(%d, %d)\n", p.first, p.second);
    return 0;
}
