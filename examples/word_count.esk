// word_count.esk: List, Map and Set helpers on a word-frequency count.
//
//   eskiuc examples/word_count.esk -o word_count && ./word_count
//
// Splits text into words, counts them in a Map<int>, ranks them with
// List_sort_by, filters and maps lists with lambdas, and tracks distinct word
// lengths in a Set<int>.

import <string>;
import <map>;
import <sort>;
extern int printf(string fmt, ...);

struct Entry { string word; int count; }

// Most frequent first; ties alphabetically.
int by_count(*Entry a, *Entry b) {
    if (a.count != b.count) { return b.count - a.count; }
    int i = 0;
    while (a.word[i] != 0 && a.word[i] == b.word[i]) { i++; }
    return (int)a.word[i] - (int)b.word[i];
}

int main() {
    let text: String;
    text.from("The quick brown fox jumps over the lazy dog. The dog sleeps, the fox runs.");
    defer text.free();
    text.lower();
    text.replace_all(".", "");
    text.replace_all(",", "");

    let words: List<String>;  List_init<String>(&words, 16);
    text.split_str(" ", &words);
    defer String_split_free(&words);

    // Count each word. The map keeps its own copy of every key.
    let counts: Map<int>;  Map_init<int>(&counts, 16);
    defer Map_free<int>(&counts);
    for (i in 0..words.len()) {
        let w: String = words.get(i);
        int created = 0;
        *int slot = Map_at<int>(&counts, w.cstr(), &created);
        slot[0] = slot[0] + 1;
    }
    printf("%d words, %d distinct\n", words.len(), counts.len());

    // Collect (word, count) pairs and rank them.
    let keys: List<string>;  List_init<string>(&keys, 16);
    defer List_free<string>(&keys);
    counts.keys(&keys);
    *Map<int> cm = &counts;
    let ranked: List<Entry>;  List_init<Entry>(&ranked, 16);
    defer List_free<Entry>(&ranked);
    keys.map(Entry(string k) { return Entry{k, Map_get_or<int>(cm, k, 0)}; }, &ranked);
    ranked.sort_by(by_count);
    for (i in 0..3) {
        printf("  %-6s %d\n", ranked.get(i).word, ranked.get(i).count);
    }

    // Words seen more than once, joined.
    let repeated: List<Entry>;  List_init<Entry>(&repeated, 8);
    defer List_free<Entry>(&repeated);
    ranked.filter(bool(Entry e) { return e.count > 1; }, &repeated);
    let names: List<string>;  List_init<string>(&names, 8);
    defer List_free<string>(&names);
    repeated.map(string(Entry e) { return e.word; }, &names);
    let line: String;  line.init(32);
    defer line.free();
    names.join(", ", &line);
    printf("repeated: %s\n", line.cstr());

    int total = ranked.reduce(0, int(int acc, Entry e) { return acc + e.count; });
    printf("total: %d, all short: %d\n", total, keys.all(bool(string k) { return strlen(k) < 8; }));

    // Distinct word lengths.
    let lengths: Set<int>;  Set_init<int>(&lengths, 8, int_hash, int_eq);
    defer lengths.free();
    for (i in 0..words.len()) { lengths.add((int)words.get(i).len); }
    printf("distinct lengths: %d (has 5: %d, has 9: %d)\n", lengths.len(), lengths.has(5), lengths.has(9));

    counts.remove("the");
    printf("after removing 'the': %d distinct, the=%d\n", counts.len(), counts.get_or("the", 0));
    return 0;
}
