// hpack.esk — HPACK (RFC 7541), HTTP/2 header compression.
//
// HTTP/2 carries header fields in a compressed block per HEADERS frame. HPACK
// combines (a) a static table of 61 common header fields, (b) a per-connection
// dynamic table the peers grow as they go, and (c) a compact wire coding:
// prefix integers (§5.1), length-prefixed string literals (§5.2, optionally
// Huffman-coded), and the field representations of §6 (indexed; literal with /
// without / never indexing; dynamic-table size update).
//
// The decoder maintains the dynamic table and handles every §6 representation;
// the encoder is stateless (it emits an indexed field for a static-table match,
// otherwise a literal, choosing the shorter of raw and Huffman). The Huffman
// code table (Appendix B) lives in hpack_huffman.esk, generated from the RFC.

import <mem>;
import <hpack_huffman>;    // hpack_huff_code(i) / hpack_huff_len(i) — RFC Appendix B

// ── §5.1 Integer representation ──────────────────────────────────────────────
// An integer with an N-bit prefix. The high (8-N) bits of the first byte carry
// `flags` (the representation's opcode bits).

// Encode `value` (>= 0) with an N-bit prefix into buf[off..); returns new off.
int hpack_encode_int(*uint8 buf, int off, int n, int flags, int64 value) {
    const int maxp = (1 << n) - 1;
    if (value < maxp) {
        buf[off] = (uint8)(flags | (int)value);
        return off + 1;
    }
    buf[off++] = (uint8)(flags | maxp);
    // The remainder goes out 7 bits at a time, low bits first; the high bit of
    // each byte says another one follows.
    for (value -= maxp; value >= 128; value >>= 7) {
        buf[off++] = (uint8)((int)(value & 127) | 128);
    }
    buf[off] = (uint8)(int)value;
    return off + 1;
}

// Decode an N-bit-prefix integer at buf[off], reading no byte at or past `end`;
// writes the next offset to *next. Returns -1 on a truncated integer, more than
// 5 continuation bytes, or a value above 2^31 - 1 (no field needs more).
int64 hpack_decode_int_at(*uint8 buf, int off, int end, int n, int* next) {
    if (off >= end) { return -1; }
    const int maxp = (1 << n) - 1;
    int64 v = (int)buf[off++] & maxp;
    if (v < maxp) { *next = off; return v; }
    int64 m = 0;
    int b = 0;
    int cont = 0;
    do {
        if (off >= end || cont >= 5) { return -1; }
        b = (int)buf[off++];
        v += (int64)(b & 127) << m;
        m += 7;
        cont++;
    } while ((b & 128) != 0);
    if (v > 2147483647) { return -1; }
    *next = off;
    return v;
}

// hpack_decode_int_at without an end bound (the continuation cap still applies).
int64 hpack_decode_int(*uint8 buf, int off, int n, int* next) {
    return hpack_decode_int_at(buf, off, 2147483647, n, next);
}

// ── §5.2 String literal (raw; Huffman variants below) ───────────────────────

// Encode `slen` bytes at `s` as a raw (H=0) string literal; returns new off.
int hpack_encode_str(*uint8 buf, int off, *uint8 s, int slen) {
    off = hpack_encode_int(buf, off, 7, 0, slen);   // H = 0
    for (i in 0..slen) { buf[off + i] = s[i]; }
    return off + slen;
}

// ── §5.2 Huffman coding (RFC 7541 Appendix B) ────────────────────────────────
// Decoding walks a binary trie built from the 257-symbol code table; encoding
// packs each symbol's MSB-aligned code. The table itself is generated from the
// RFC text (stdlib/hpack_huffman.esk) — never hand-transcribed.

struct HpackStr { *uint8 ptr; int len; }

// A Huffman decoding trie: child0/child1 are node indices (-1 = none), sym is
// the decoded symbol at a leaf (-1 = internal node). Node 0 is the root.
struct HpackHuff {
    *int child0;  *int child1;  *int sym;  int nodes;
}

void HpackHuff_build(HpackHuff* h) {
    const int cap = 8192;
    h.child0 = alloc<int>(cap);  h.child1 = alloc<int>(cap);  h.sym = alloc<int>(cap);
    for (i in 0..cap) { h.child0[i] = -1; h.child1[i] = -1; h.sym[i] = -1; }
    h.nodes = 1;                                  // root
    for (s in 0..257) {
        // Walk the symbol's code from its most significant bit, adding nodes as needed.
        const int64 code = hpack_huff_code(s);
        int node = 0;
        for (int b = hpack_huff_len(s) - 1; b >= 0; b--) {
            *int kids = ((code >> b) & 1) == 0 ? h.child0 : h.child1;
            if (kids[node] < 0) { kids[node] = h.nodes++; }
            node = kids[node];
        }
        h.sym[node] = s;
    }
}

void HpackHuff_free(HpackHuff* h) {
    free(h.child0);  free(h.child1);  free(h.sym);
}

// Decode `srclen` Huffman bytes at `src` into `dst` (capacity `dstcap`). Returns
// the decoded length, or -1 on an invalid code, an EOS symbol, overflow, or
// invalid padding (trailing bits must be the EOS prefix — all ones — and < 8).
int hpack_huff_decode(HpackHuff* h, *uint8 src, int srclen, *uint8 dst, int dstcap) {
    int node = 0;  int outlen = 0;
    int since = 0;  bool allones = true;         // bits since the last completed symbol
    for (i in 0..srclen) {
        const int byte = (int)src[i];
        for (int b = 7; b >= 0; b--) {
            since++;
            if (((byte >> b) & 1) == 0) { allones = false; node = h.child0[node]; } else { node = h.child1[node]; }
            if (node < 0) { return -1; }
            const int sym = h.sym[node];
            if (sym >= 0) {
                if (sym == 256) { return -1; }    // EOS must not appear in the data
                if (outlen >= dstcap) { return -1; }
                dst[outlen++] = (uint8)sym;
                node = 0;  since = 0;  allones = true;
            }
        }
    }
    if (node != 0 && (since > 7 || !allones)) { return -1; }   // leftover bits = padding
    return outlen;
}

// Number of bytes the Huffman encoding of `src` would occupy.
int hpack_huff_encoded_len(*uint8 src, int srclen) {
    int64 bits = 0;
    for (i in 0..srclen) { bits += hpack_huff_len((int)src[i]); }
    return (int)((bits + 7) / 8);
}

// Huffman-encode `src` into dst[off..); returns new off. Trailing bits are
// padded with the EOS prefix (all ones), per §5.2.
int hpack_huff_encode(*uint8 dst, int off, *uint8 src, int srclen) {
    int64 acc = 0;  int bits = 0;
    for (i in 0..srclen) {
        const int sym = (int)src[i];
        acc = (acc << hpack_huff_len(sym)) | hpack_huff_code(sym);
        bits += hpack_huff_len(sym);
        while (bits >= 8) {
            bits -= 8;
            dst[off++] = (uint8)((acc >> bits) & 255);
        }
    }
    if (bits > 0) {
        const int pad = 8 - bits;
        acc = (acc << pad) | (((int64)1 << pad) - 1);
        dst[off++] = (uint8)(acc & 255);
    }
    return off;
}

// Encode a string literal, choosing the smaller of raw and Huffman (a valid
// choice either way, and what real encoders do): the H bit signals which.
int hpack_emit_str(*uint8 buf, int off, *uint8 s, int slen) {
    const int hlen = hpack_huff_encoded_len(s, slen);
    if (hlen < slen) {
        off = hpack_encode_int(buf, off, 7, 128, hlen);          // H = 1
        return hpack_huff_encode(buf, off, s, slen);
    }
    return hpack_encode_str(buf, off, s, slen);                  // H = 0
}

// ── Appendix A: static table (indices 1..61) ─────────────────────────────────
string hpack_static_name(int i) {
    switch (i) {
        case 1: return ":authority";
        case 2: case 3: return ":method";
        case 4: case 5: return ":path";
        case 6: case 7: return ":scheme";
        case 8: case 9: case 10: case 11: case 12: case 13: case 14: return ":status";
        case 15: return "accept-charset";
        case 16: return "accept-encoding";
        case 17: return "accept-language";
        case 18: return "accept-ranges";
        case 19: return "accept";
        case 20: return "access-control-allow-origin";
        case 21: return "age";
        case 22: return "allow";
        case 23: return "authorization";
        case 24: return "cache-control";
        case 25: return "content-disposition";
        case 26: return "content-encoding";
        case 27: return "content-language";
        case 28: return "content-length";
        case 29: return "content-location";
        case 30: return "content-range";
        case 31: return "content-type";
        case 32: return "cookie";
        case 33: return "date";
        case 34: return "etag";
        case 35: return "expect";
        case 36: return "expires";
        case 37: return "from";
        case 38: return "host";
        case 39: return "if-match";
        case 40: return "if-modified-since";
        case 41: return "if-none-match";
        case 42: return "if-range";
        case 43: return "if-unmodified-since";
        case 44: return "last-modified";
        case 45: return "link";
        case 46: return "location";
        case 47: return "max-forwards";
        case 48: return "proxy-authenticate";
        case 49: return "proxy-authorization";
        case 50: return "range";
        case 51: return "referer";
        case 52: return "refresh";
        case 53: return "retry-after";
        case 54: return "server";
        case 55: return "set-cookie";
        case 56: return "strict-transport-security";
        case 57: return "transfer-encoding";
        case 58: return "user-agent";
        case 59: return "vary";
        case 60: return "via";
        case 61: return "www-authenticate";
    }
    return "";
}

string hpack_static_value(int i) {
    switch (i) {
        case 2: return "GET";
        case 3: return "POST";
        case 4: return "/";
        case 5: return "/index.html";
        case 6: return "http";
        case 7: return "https";
        case 8: return "200";
        case 9: return "204";
        case 10: return "206";
        case 11: return "304";
        case 12: return "400";
        case 13: return "404";
        case 14: return "500";
        case 16: return "gzip, deflate";
    }
    return "";
}

// ── Dynamic table + decoder ──────────────────────────────────────────────────

// One decoded header field. name/value point at storage owned by the static
// table, the dynamic table, or the input block. They stay valid until the next
// hpack_decode on the same decoder (entries evicted mid-block are freed then).
struct HpackHeader {
    *uint8 name;  int nlen;
    *uint8 value; int vlen;
}

// A dynamic-table entry (a heap-owned copy of one inserted field).
struct HpackEntry {
    *uint8 name;  int nlen;
    *uint8 value; int vlen;
    int    size;   // RFC entry size = nlen + vlen + 32
}

// HPACK decoder state: the dynamic table (newest entry at index 0), the Huffman
// decode trie, and a per-block scratch arena that Huffman-decoded strings live
// in (header pointers point into it or directly into the input block).
struct HpackDecoder {
    *HpackEntry dyn;
    int   dyn_count;
    int   dyn_cap;
    int64 max_size;     // SETTINGS_HEADER_TABLE_SIZE
    int64 cur_size;
    HpackHuff huff;
    *uint8 scratch;
    int   scratch_cap;
    int   scratch_used;
    int64 limit;        // the SETTINGS_HEADER_TABLE_SIZE bound on any §6.3 size update
    **uint8 grave;      // evicted entry strings, freed at the next hpack_decode (see hpack_evict)
    int   grave_count;
    int   grave_cap;
}

void HpackDecoder_init(HpackDecoder* d, int64 max_size) {
    const int cap = (int)(max_size / 32) + 1;    // min entry size is 32 bytes
    d.dyn = alloc<HpackEntry>(cap);
    d.dyn_count = 0;
    d.dyn_cap = cap;
    d.max_size = max_size;
    d.limit = max_size;
    d.grave = null;
    d.grave_count = 0;
    d.grave_cap = 0;
    d.cur_size = 0;
    HpackHuff_build(&d.huff);
    d.scratch_cap = 16384;
    d.scratch = alloc<uint8>(d.scratch_cap);
    d.scratch_used = 0;
}

void HpackDecoder_free(HpackDecoder* d) {
    for (i in 0..d.dyn_count) {
        free(d.dyn[i].name);
        free(d.dyn[i].value);
    }
    free(d.dyn);
    hpack_grave_clear(d);
    free(d.grave);
    d.grave_cap = 0;
    d.huff.free();
    free(d.scratch);
    d.dyn_count = 0;
}

// Read a (possibly Huffman-coded) string literal at buf[off], which must end at
// or before `end`. On success fills `out` (pointing into buf for raw strings, or
// the scratch arena for Huffman) and returns the next offset; returns -1 on error.
int hpack_read_str(HpackDecoder* d, *uint8 buf, int off, int end, HpackStr* out) {
    if (off >= end) { return -1; }
    const bool huff = ((int)buf[off] & 128) != 0;
    int nx = 0;
    const int64 len = hpack_decode_int_at(buf, off, end, 7, &nx);
    if (len < 0 || nx + len > end) { return -1; }
    if (!huff) {
        out.ptr = buf + nx;  out.len = (int)len;
        return nx + (int)len;
    }
    *uint8 dst = d.scratch + d.scratch_used;
    const int dn = hpack_huff_decode(&d.huff, buf + nx, (int)len, dst, d.scratch_cap - d.scratch_used);
    if (dn < 0) { return -1; }
    out.ptr = dst;  out.len = dn;
    d.scratch_used += dn;
    return nx + (int)len;
}

// Park an evicted entry's string until the next block: headers already decoded
// from this block may still point at it (their lifetime is the whole decode).
void hpack_grave_push(HpackDecoder* d, *uint8 p) {
    if (d.grave_count >= d.grave_cap) {
        const int ncap = d.grave_cap * 2 < 16 ? 16 : d.grave_cap * 2;
        **uint8 grown = alloc<*uint8>(ncap);
        for (i in 0..d.grave_count) { grown[i] = d.grave[i]; }
        free(d.grave);
        d.grave = grown;
        d.grave_cap = ncap;
    }
    d.grave[d.grave_count++] = p;
}

void hpack_grave_clear(HpackDecoder* d) {
    for (i in 0..d.grave_count) { free(d.grave[i]); }
    d.grave_count = 0;
}

// Evict the oldest entries until `need` more bytes fit (or the table is empty).
void hpack_evict(HpackDecoder* d, int64 need) {
    while (d.cur_size + need > d.max_size && d.dyn_count > 0) {
        const int last = --d.dyn_count;
        d.cur_size -= d.dyn[last].size;
        hpack_grave_push(d, d.dyn[last].name);
        hpack_grave_push(d, d.dyn[last].value);
    }
}

// Insert a copy of (name, value) at the front of the dynamic table (§4.4).
// The copies are taken before evicting: `name` may point into an entry that this
// insert evicts (a literal whose name index refers to the dynamic table, §4.4).
void hpack_dyn_insert(HpackDecoder* d, *uint8 name, int nlen, *uint8 value, int vlen) {
    const int64 esize = nlen + vlen + 32;
    *uint8 nc = alloc<uint8>(nlen);  memcpy(nc, name, nlen);
    *uint8 vc = alloc<uint8>(vlen);  memcpy(vc, value, vlen);
    hpack_evict(d, esize);
    if (esize > d.max_size) {                 // larger than the whole table: table left empty
        free(nc);  free(vc);
        return;
    }
    for (int i = d.dyn_count; i > 0; i--) { d.dyn[i] = d.dyn[i - 1]; }
    d.dyn[0].name = nc;  d.dyn[0].nlen = nlen;
    d.dyn[0].value = vc; d.dyn[0].vlen = vlen;
    d.dyn[0].size = nlen + vlen + 32;
    d.dyn_count++;
    d.cur_size += esize;
}

// Set a new dynamic-table max size (§6.3 dynamic table size update); evicts.
// Raising it past the size the entry array was allocated for grows the array
// (so the table can always hold max_size / 32 entries, the minimum entry size).
void hpack_set_max(HpackDecoder* d, int64 newmax) {
    const int need = (int)(newmax / 32) + 1;
    if (need > d.dyn_cap) {
        *HpackEntry grown = alloc<HpackEntry>(need);
        for (i in 0..d.dyn_count) { grown[i] = d.dyn[i]; }
        free(d.dyn);
        d.dyn = grown;
        d.dyn_cap = need;
    }
    if (newmax > d.limit) { d.limit = newmax; }
    d.max_size = newmax;
    hpack_evict(d, 0);
}

// Resolve table index `idx` (1-based) into `h`. Returns 0 ok, -1 if out of range.
int hpack_resolve(HpackDecoder* d, int idx, HpackHeader* h) {
    if (idx >= 1 && idx <= 61) {
        const string nm = hpack_static_name(idx);
        const string vl = hpack_static_value(idx);
        h.name = (*uint8)nm;  h.nlen = strlen(nm);
        h.value = (*uint8)vl; h.vlen = strlen(vl);
        return 0;
    }
    const int pos = idx - 62;                    // 0 = most recently inserted
    if (pos < 0 || pos >= d.dyn_count) { return -1; }
    h.name = d.dyn[pos].name;  h.nlen = d.dyn[pos].nlen;
    h.value = d.dyn[pos].value; h.vlen = d.dyn[pos].vlen;
    return 0;
}

// Decode one literal representation (the prefix byte at buf[off] selects the
// name-index prefix width and whether to index). Fills `h`; returns the next
// offset, or -1 on error.
int hpack_decode_literal(HpackDecoder* d, *uint8 buf, int off, int end, int prefixBits,
                         HpackHeader* h, int doIndex) {
    int nx = 0;
    const int64 nameIdx = hpack_decode_int_at(buf, off, end, prefixBits, &nx);
    if (nameIdx < 0) { return -1; }
    off = nx;
    if ((int)nameIdx != 0) {
        let nh: HpackHeader;
        if (hpack_resolve(d, (int)nameIdx, &nh) != 0) { return -1; }
        h.name = nh.name;  h.nlen = nh.nlen;
    } else {
        let ns: HpackStr;
        off = hpack_read_str(d, buf, off, end, &ns);
        if (off < 0) { return -1; }
        h.name = ns.ptr;  h.nlen = ns.len;
    }
    let vs: HpackStr;
    off = hpack_read_str(d, buf, off, end, &vs);
    if (off < 0) { return -1; }
    h.value = vs.ptr;  h.vlen = vs.len;
    if (doIndex != 0) { hpack_dyn_insert(d, h.name, h.nlen, h.value, h.vlen); }
    return off;
}

// Make the Huffman scratch arena big enough for any block of `len` bytes: the
// shortest code is 5 bits, so the decoded strings total at most len * 8 / 5
// bytes. (The previous block's headers are dead by now, so the old arena can go.)
void hpack_scratch_fit(HpackDecoder* d, int len) {
    const int64 need = (int64)len * 8 / 5 + 8;
    if (need <= d.scratch_cap) { return; }
    free(d.scratch);
    d.scratch = alloc<uint8>(need);
    d.scratch_cap = (int)need;
}

// Decode a complete header block (`len` bytes at `buf`) into out[0..max).
// Returns the header count, -1 on a malformed block (a COMPRESSION_ERROR:
// the dynamic table may be out of sync, so the connection cannot continue), or
// -2 if the block is well-formed but holds more than `max` fields. On -2 the
// whole block was still decoded, so the dynamic table stays in sync; out[] holds
// the first `max` fields and the caller should reject just that header list.
// A dynamic table size update is only valid at the start of a block, before
// any field (RFC 7541 §4.2); one after a field is a COMPRESSION_ERROR.
int hpack_decode(HpackDecoder* d, *uint8 buf, int len, HpackHeader* out, int max) {
    d.scratch_used = 0;                  // reset the per-block arena for Huffman strings
    hpack_grave_clear(d);                // the previous block's evicted strings are no longer referenced
    hpack_scratch_fit(d, len);
    let spill: HpackHeader;              // where fields past `max` are decoded (and dropped)
    int off = 0;  int count = 0;  int fields = 0;
    while (off < len) {
        HpackHeader* h = count < max ? &out[count] : &spill;
        const int b = (int)buf[off];
        if ((b & 128) != 0) {                            // §6.1 indexed
            int nx = 0;
            const int64 idx = hpack_decode_int_at(buf, off, len, 7, &nx);
            if (idx < 0) { return -1; }
            off = nx;
            if (hpack_resolve(d, (int)idx, h) != 0) { return -1; }
            fields++;
        } else if ((b & 64) != 0) {                      // §6.2.1 literal, incremental indexing
            off = hpack_decode_literal(d, buf, off, len, 6, h, 1);
            if (off < 0) { return -1; }
            fields++;
        } else if ((b & 32) != 0) {                      // §6.3 dynamic table size update
            if (fields > 0) { return -1; }              // after a field: COMPRESSION_ERROR (§4.2)
            int nx = 0;
            const int64 newmax = hpack_decode_int_at(buf, off, len, 5, &nx);
            if (newmax < 0) { return -1; }
            off = nx;
            if (newmax > d.limit) { return -1; }        // above SETTINGS_HEADER_TABLE_SIZE: COMPRESSION_ERROR
            hpack_set_max(d, newmax);
        } else {                                         // §6.2.2 / §6.2.3 without / never indexed
            off = hpack_decode_literal(d, buf, off, len, 4, h, 0);
            if (off < 0) { return -1; }
            fields++;
        }
        count = fields < max ? fields : max;
    }
    return fields > max ? -2 : fields;
}

// ── Encoder (stateless; raw strings) ─────────────────────────────────────────
// A correct, deterministic encoder: emit an indexed field when (name, value)
// matches the static table; else a "literal without indexing" reusing a static
// name index when the name matches; else a fully literal field. It never grows
// the dynamic table (so it needs no state and the output is reproducible).

int hpack_bytes_eq(*uint8 a, int alen, *uint8 b, int blen) {
    return (alen == blen && memcmp(a, b, alen) == 0) ? 1 : 0;
}

// Static index of an exact (name, value) match, or 0.
int hpack_static_find(*uint8 name, int nlen, *uint8 value, int vlen) {
    for (i in 1..62) {
        const string nm = hpack_static_name(i);
        const string vl = hpack_static_value(i);
        if (hpack_bytes_eq(name, nlen, (*uint8)nm, strlen(nm)) != 0 &&
            hpack_bytes_eq(value, vlen, (*uint8)vl, strlen(vl)) != 0) { return i; }
    }
    return 0;
}

// Static index whose name matches, or 0.
int hpack_static_find_name(*uint8 name, int nlen) {
    for (i in 1..62) {
        const string nm = hpack_static_name(i);
        if (hpack_bytes_eq(name, nlen, (*uint8)nm, strlen(nm)) != 0) { return i; }
    }
    return 0;
}

// Encode one header field into buf[off..); returns new off.
int hpack_encode_header(*uint8 buf, int off, *uint8 name, int nlen, *uint8 value, int vlen) {
    const int full = hpack_static_find(name, nlen, value, vlen);
    if (full != 0) {                                  // §6.1 indexed
        return hpack_encode_int(buf, off, 7, 128, full);
    }
    const int ni = hpack_static_find_name(name, nlen); // §6.2.2 without indexing (flags 0x00)
    if (ni != 0) {
        off = hpack_encode_int(buf, off, 4, 0, ni);
        return hpack_emit_str(buf, off, value, vlen);
    }
    off = hpack_encode_int(buf, off, 4, 0, 0);        // name index 0 -> literal name
    off = hpack_emit_str(buf, off, name, nlen);
    return hpack_emit_str(buf, off, value, vlen);
}

// ── Deprecated names (kept so 0.9.1 code compiles; removed in a later release) ──
// deprecated: use HpackHuff_build
void hpack_huff_build(HpackHuff* h) { HpackHuff_build(h); }
// deprecated: use HpackHuff_free
void hpack_huff_free(HpackHuff* h) { HpackHuff_free(h); }
// deprecated: use HpackDecoder_init
void hpack_decoder_init(HpackDecoder* d, int64 max_size) { HpackDecoder_init(d, max_size); }
// deprecated: use HpackDecoder_free
void hpack_decoder_free(HpackDecoder* d) { HpackDecoder_free(d); }
