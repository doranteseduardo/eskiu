// String — mutable string with owned buffer
// Requires: stdlib/mem.esk for memcpy/strlen

extern int strlen(string s);
extern *void memcpy(*void dst, *void src, int n);

struct String {
    *char data;
    int   len;
    int   cap;
}

void String_init(String* self, int initial_cap) {
    self.data = alloc(char, initial_cap);
    self.len  = 0;
    self.cap  = initial_cap;
    self.data[0] = 0;
}

void String_from(String* self, string s) {
    int n = strlen(s);
    self.data = alloc(char, n + 1);
    memcpy(self.data, s, n + 1);
    self.len = n;
    self.cap = n + 1;
}

*char String_cstr(String* self) {
    return self.data;
}

int String_len(String* self) {
    return self.len;
}

void String_free(String* self) {
    free(self.data);
    self.len = 0;
    self.cap = 0;
}

void String_append(String* self, string s) {
    int slen   = strlen(s);
    int newlen = self.len + slen;
    if (newlen >= self.cap) {
        int newcap = newlen * 2 + 1;
        let newbuf: *char = alloc(char, newcap);
        memcpy(newbuf, self.data, self.len);
        free(self.data);
        self.data = newbuf;
        self.cap  = newcap;
    }
    memcpy(self.data + self.len, s, slen + 1);
    self.len = newlen;
}

void String_concat(String* self, String* other) {
    String_append(self, other.data);
}

// Append a single character, growing the buffer if needed and keeping the
// trailing NUL so the buffer stays a valid C string.
void String_push(String* self, char c) {
    if (self.len + 1 >= self.cap) {
        int newcap = self.cap * 2 + 2;
        let newbuf: *char = alloc(char, newcap);
        memcpy(newbuf, self.data, self.len);
        free(self.data);
        self.data = newbuf;
        self.cap  = newcap;
    }
    self.data[self.len] = c;
    self.len = self.len + 1;
    self.data[self.len] = 0;
}

// Read the i-th character (no bounds check).
char String_char_at(String* self, int i) {
    return self.data[i];
}

// Overwrite the i-th character in place (no bounds check, no length change).
void String_set(String* self, int i, char c) {
    self.data[i] = c;
}

// Reset to the empty string, keeping the allocated buffer.
void String_clear(String* self) {
    self.len = 0;
    self.data[0] = 0;
}

// First index of c, or -1 if absent.
int String_index_of(String* self, char c) {
    int i = 0;
    while (i < self.len) {
        if (self.data[i] == c) { return i; }
        i = i + 1;
    }
    return -1;
}

// 1 if the two Strings hold the same bytes, else 0.
int String_eq(String* self, String* other) {
    if (self.len != other.len) { return 0; }
    int i = 0;
    while (i < self.len) {
        if (self.data[i] != other.data[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// 1 if this String equals the C string s, else 0.
int String_eq_cstr(String* self, string s) {
    int n = strlen(s);
    if (self.len != n) { return 0; }
    int i = 0;
    while (i < n) {
        if (self.data[i] != s[i]) { return 0; }
        i = i + 1;
    }
    return 1;
}

// Reverse the characters in place.
void String_reverse(String* self) {
    int i = 0;
    int j = self.len - 1;
    while (i < j) {
        char t = self.data[i];
        self.data[i] = self.data[j];
        self.data[j] = t;
        i = i + 1;
        j = j - 1;
    }
}

// Copy up to `count` characters starting at `start` from self into out.
// out must already be initialised; it is cleared first.
void String_substring(String* self, String* out, int start, int count) {
    String_clear(out);
    int i = 0;
    while (i < count) {
        if (start + i >= self.len) { return; }
        String_push(out, self.data[start + i]);
        i = i + 1;
    }
}

// Render an integer (with optional minus sign) into self.
void String_from_int(String* self, int n) {
    String_clear(self);
    if (n == 0) {
        String_push(self, '0');
        return;
    }
    int v   = n;
    int neg = 0;
    if (v < 0) {
        neg = 1;
        v = -v;
    }
    while (v > 0) {
        String_push(self, (char)((int)'0' + (v % 10)));
        v = v / 10;
    }
    if (neg == 1) { String_push(self, '-'); }
    String_reverse(self);
}

// Parse a leading (optionally signed) decimal integer; stops at the first
// non-digit. Returns 0 for an empty or non-numeric string.
int String_to_int(String* self) {
    int result = 0;
    int i = 0;
    int neg = 0;
    int done = 0;
    if (self.len > 0 && self.data[0] == '-') {
        neg = 1;
        i = 1;
    }
    while (i < self.len && done == 0) {
        char c = self.data[i];
        if (c < '0' || c > '9') {
            done = 1;
        } else {
            result = result * 10 + ((int)c - (int)'0');
            i = i + 1;
        }
    }
    if (neg == 1) { return -result; }
    return result;
}
