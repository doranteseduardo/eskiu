// future.esk — the async runtime's Future<T> (see docs/dev/async-design.md).
//
// This is the locked compiler↔generated-code contract. A coroutine compiles to a
// state machine that talks to a Future<T> through the protocols below; for now
// (the de-risk gate) the state machines are written by hand.
//
// Future<T> layout is FIXED: `value` is LAST so the first three fields sit at the
// same offsets for every T, which lets cancellation and the executor view any
// future through the type-erased FutureHdr.
//
//   state: 0 PENDING, 1 WAITING, 2 READY, 3 CANCELLED   (atomic; §3 handshake)
//   waker:   completion path — resume the awaiter (set by the awaiter)
//   on_drop: cancel path — release own resources + cascade (set by the producer)

import <mem>;
import <atomic>;

// Type-erased view of the first three fields — same offsets for any Future<T>.
struct FutureHdr {
    int        state;
    fn()->void waker;
    fn()->void on_drop;
}

struct Future<T> {
    int        state;
    fn()->void waker;
    fn()->void on_drop;
    T          value;
}

// State constants (Eskiu has no const-in-expression yet; these are the contract).
//   PENDING=0  WAITING=1  READY=2  CANCELLED=3

// A freshly allocated, pending future. waker/on_drop are set later by the
// awaiter / producer. state starts PENDING (a plain store — not yet shared).
Future<T>* future_new<T>() {
    Future<T>* f = alloc<Future<T>>(1);
    f.state = 0;
    // waker/on_drop default to no-ops (null env) so free_future/future_drop can
    // always free_closure them safely, even if no one sets them.
    f.waker   = void() {};
    f.on_drop = void() {};
    return f;
}

// Awaiter side. Register `resume` and try to park (PENDING -> WAITING).
// Returns 0 if parked (the producer will call `resume` on completion), or 1 if
// the future was already READY — the caller should read `value` and not suspend.
int future_poll<T>(Future<T>* f, escaping fn()->void resume) {
    f.waker = resume;
    if (atomic_cas(&f.state, 0, 1)) {   // PENDING -> WAITING: parked
        return 0;
    }
    return 1;                            // already READY: take value inline
}

// Producer side. Publish the value, then win the right to complete by moving
// PENDING/WAITING -> READY. `value` is written before the publishing CAS
// (release) so a reader observing READY sees it. If the future is already
// terminal (READY or CANCELLED — e.g. a `select` loser was dropped, or a
// concurrent cancel won), completing is a no-op. Wake the awaiter iff it had
// parked (state was WAITING).
void future_complete<T>(Future<T>* f, T v) {
    f.value = v;
    if (atomic_cas(&f.state, 0, 2)) { return; }   // PENDING -> READY (awaiter not parked yet)
    if (atomic_cas(&f.state, 1, 2)) { f.waker(); } // WAITING -> READY: wake the awaiter
    // else: already terminal -> ignore (drop/cancel won the race)
}

// Fire-and-forget a future: drive it to completion, then free it. Use for a
// detached async task (no one awaits its result). The caller must still run the
// event loop so the task's leaf futures can complete. Leak-free: the completion
// waker frees the future *and* its own heap env (it saves its own fat pointer,
// frees the future, then free_closures the saved copy as its last act).
// Type-erased: call as spawn((FutureHdr*)f). Non-template so the reap
// closure's capture of `f` is analyzed (template bodies skip capture analysis).
// All operations are type-agnostic (header fields + free), so no T is needed.
void spawn(FutureHdr* f) {
    let reap: fn()->void = void() {
        let self: fn()->void = f.waker;       // this closure (f.waker == this)
        free_closure(f.on_drop);  free((*void)f);   // == free_future, type-agnostic
        free_closure(self);                   // free this closure's env (last act)
    };
    f.waker = reap;
    if (atomic_cas(&f.state, 0, 1)) { return; }      // PENDING -> WAITING: parked
    // Already terminal (READY): the waker never fires — free it and the future now.
    free_closure(reap);
    free_closure(f.on_drop);  free((*void)f);
}

// select2: complete with the index (0 or 1) of whichever of `a`/`b` finishes
// first; the loser is dropped (deregistered + freed). Type-erased, so it works
// for futures of any value type — the awaiter reads the winner's typed value and
// frees the winner (the loser is already gone). Ownership: select2 takes neither
// future; on resolution the loser is freed here, and the CALLER frees the winner
// after reading it. Leak-free via the self-free waker technique.
//
//   int w = await select2((FutureHdr*)rd, (FutureHdr*)timer);
//   if (w == 0) { use rd.value;  free_future<int>(rd); }
//   else        {                free_future<int>(timer); /* read timer if needed */ }
Future<int>* select2(FutureHdr* a, FutureHdr* b) {
    Future<int>* sel = future_new<int>();
    let onA: fn()->void = void() {
        let self: fn()->void = a.waker;
        future_drop(b);                  // loser: deregister + free (frees onB env too)
        future_complete<int>(sel, 0);    // resumes the awaiter (reads a.value, frees a)
        free_closure(self);              // free onA env (last act)
    };
    let onB: fn()->void = void() {
        let self: fn()->void = b.waker;
        future_drop(a);
        future_complete<int>(sel, 1);
        free_closure(self);
    };
    a.waker = onA;
    if (atomic_cas(&a.state, 0, 1) == false) {   // a already READY -> a wins
        free_closure(onA);                       // onA never fires (a won't be future_drop'd)
        free_closure(onB);                       // onB was created but never armed
        future_drop(b);                          // drop the loser (frees b's waker/on_drop/struct)
        future_complete<int>(sel, 0);
        return sel;
    }
    b.waker = onB;
    if (atomic_cas(&b.state, 0, 1) == false) {   // b already READY -> b wins
        free_closure(onB);                       // onB never fires
        future_drop(a);                          // a was armed (WAITING) -> future_drop frees onA
        future_complete<int>(sel, 1);
        return sel;
    }
    return sel;                                  // both parked: first to complete wins
}

// join2: complete (with 2) once BOTH `a` and `b` have finished. Type-erased; the
// awaiter then reads both futures' typed values and frees both. Leak-free: a
// shared heap counter tracks completions (freed by the second completer), and
// each waker self-frees its env.
//
//   await join2((FutureHdr*)x, (FutureHdr*)y);
//   int sum = x.value + y.value;  free_future<int>(x);  free_future<int>(y);
Future<int>* join2(FutureHdr* a, FutureHdr* b) {
    Future<int>* j = future_new<int>();
    *int cnt = alloc<int>(1);
    *cnt = 0;
    let onA: fn()->void = void() {
        let self: fn()->void = a.waker;
        *cnt = *cnt + 1;
        if (*cnt == 2) { free((*void)cnt); future_complete<int>(j, 2); }
        free_closure(self);
    };
    let onB: fn()->void = void() {
        let self: fn()->void = b.waker;
        *cnt = *cnt + 1;
        if (*cnt == 2) { free((*void)cnt); future_complete<int>(j, 2); }
        free_closure(self);
    };
    a.waker = onA;
    if (atomic_cas(&a.state, 0, 1) == false) { *cnt = *cnt + 1; free_closure(onA); }  // a already done
    b.waker = onB;
    if (atomic_cas(&b.state, 0, 1) == false) { *cnt = *cnt + 1; free_closure(onB); }  // b already done
    if (*cnt == 2) { free((*void)cnt); future_complete<int>(j, 2); }                   // both already done
    return j;
}

// Free a future's memory. The single owner (the awaiter, after reading value, or
// future_drop on cancel) calls this exactly once.
void free_future<T>(Future<T>* f) {
    free_closure(f.on_drop);   // release the producer's on_drop env
    free((*void)f);            // (== free the embedded frame for a coroutine future)
}

// Cancel/drop, type-erased. Swap to CANCELLED; if it was already READY the
// producer is done and we only free, otherwise on_drop releases external
// resources (loop registration), cascades, and frees.
void future_drop(FutureHdr* f) {
    int old = atomic_swap(&f.state, 3);  // -> CANCELLED
    if (old != 2) {                      // not already READY: release resources + cascade
        f.on_drop();                     // (must NOT free f — future_drop owns the free)
    }
    free_closure(f.waker);               // a parked awaiter's resume will never fire now
    free_closure(f.on_drop);             // free the on_drop env (it has returned)
    free((*void)f);
}
