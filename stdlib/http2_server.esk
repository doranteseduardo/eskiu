// http2_server.esk — HTTP/2 (h2c, cleartext) server over the async event loop.
//
// The protocol lives in H2Server, a transport-agnostic connection engine (see
// "Server connection engine" below): streams are multiplexed, a completed
// request (a HEADERS block, optionally followed by DATA) is HPACK-decoded into
// <http>'s HttpRequest, passed to the user handler, and the HttpResponse is
// encoded back as a HEADERS frame plus the body in flow-controlled,
// MAX_FRAME_SIZE-bounded DATA frames. This file's async h2c server and both
// TLS servers in <tls> are thin read/write loops around it. The
// handler interface matches the HTTP/1.1 <http_async> server, so the same
// handlers serve both. For h2 over TLS, see <tls>.
//
//   void hello(HttpRequest* req, HttpResponse* res) {
//       HttpResponse_set_body(res, "hi\n");
//   }
//   int fd = net_tcp_listen(8080);
//   EventLoop* lp = el_new(256);
//   Future<uint8>* f = http2_serve_async(lp, fd, hello, 1000);

import <mem>;
import <future>;
import <eventloop>;
import <net_async>;
import <net>;
import <channel>;
import <http2>;
import <hpack>;
import <http>;
import <string>;

extern int memcmp(*void a, *void b, int64 n);
extern int64 strlen(string s);

// True if a decoded header's name equals the cstring `name`.
int h2_name_eq(HpackHeader* h, string name) {
    const int n = strlen(name);
    if (h.nlen != n) { return 0; }
    return memcmp((*void)h.name, (*void)name, n) == 0;
}

// Set a String to the `n` bytes at `p`.
void h2_str_set_bytes(String* s, *uint8 p, int64 n) {
    s.clear();
    for (int64 i = 0; i < n; i++) { s.push((char)p[i]); }
}

// Populate an HttpRequest from decoded HPACK headers: the :method / :path
// pseudo-headers map to the request fields; ordinary headers are appended to the
// header block as "name: value\n" (pseudo-headers — names starting with ':' —
// are not). The version is reported as HTTP/2.0.
void h2_fill_request(HttpRequest* req, HpackHeader* hs, int64 n) {
    req.version.from("HTTP/2.0");
    for (int64 i = 0; i < n; i++) {
        if (h2_name_eq(&hs[i], ":method") != 0) {
            h2_str_set_bytes(&req.method, hs[i].value, hs[i].vlen);
        } else if (h2_name_eq(&hs[i], ":path") != 0) {
            h2_str_set_bytes(&req.path, hs[i].value, hs[i].vlen);
        } else if (hs[i].nlen > 0 && hs[i].name[0] != ':') {
            for (int64 j = 0; j < hs[i].nlen; j++) { req.headers.push((char)hs[i].name[j]); }
            req.headers.append(": ");
            for (int64 j = 0; j < hs[i].vlen; j++) { req.headers.push((char)hs[i].value[j]); }
            req.headers.push('\n');
        }
    }
}

// HPACK-encode the handler's response headers (the "Key: Value\r\n" block) into
// `block` at *off, lowercasing each key (HTTP/2 requires lowercase names).
void h2_encode_resp_headers(*uint8 block, int* off, HttpResponse* res) {
    *char data = res.headers.cstr();
    const int len = res.headers.len();
    int i = 0;
    while (i < len) {
        const int ks = i;
        while (i < len && data[i] != ':') { i++; }
        const int ke = i;
        if (i < len) { i++; }
        while (i < len && data[i] == ' ') { i++; }
        const int vs = i;
        while (i < len && data[i] != '\r') { i++; }
        const int ve = i;
        if (i + 1 < len && data[i] == '\r' && data[i + 1] == '\n') { i += 2; }
        else { i = len; }
        const int klen = ke - ks;
        if (klen > 0) {
            *uint8 key = alloc<uint8>(klen);
            for (j in 0..klen) {
                int c = (int)data[ks + j];
                if (c >= 'A' && c <= 'Z') { c += 32; }              // to lowercase
                key[j] = (uint8)c;
            }
            *off = hpack_encode_header(block, *off, key, klen, (*uint8)(data + vs), ve - vs);
            free((*void)key);
        }
    }
}

// Upper bound on the HPACK block for a response: `:status`, `content-length`,
// then each handler header, whose literal costs at most its raw bytes plus a
// representation byte and two 5-byte length prefixes.
int h2_header_block_bound(HttpResponse* res) {
    const int len = res.headers.len();
    *char data = res.headers.cstr();
    int lines = 1;
    for (i in 0..len) {
        if (data[i] == '\n') { lines++; }
    }
    return len + 16 * lines + 64;
}

// Upper bound on the bytes h2_build_headers writes: the block split into
// MAX_FRAME_SIZE fragments, each with a 9-byte frame header.
int h2_headers_bufsize(HttpResponse* res) {
    const int bound = h2_header_block_bound(res);
    return bound + H2_FRAME_HEADER_LEN * (bound / 16384 + 1);
}

// Build the response header block (`:status`, `content-length`, then the
// handler's headers) into `out` as a HEADERS frame, followed by CONTINUATION
// frames when the block exceeds the default MAX_FRAME_SIZE (§6.10); the last
// fragment carries END_HEADERS, and END_STREAM is never set (a body follows).
// `out` must hold h2_headers_bufsize(res) bytes. Returns the byte count.
int h2_build_headers(*uint8 out, int stream_id, HttpResponse* res) {
    *uint8 block = alloc<uint8>(h2_header_block_bound(res));
    int off = 0;

    let st: String;  st.init(8);  st.from_int(res.status);
    off = hpack_encode_header(block, off, (*uint8)":status", 7,
                              (*uint8)st.cstr(), st.len());
    st.free();

    let cl: String;  cl.init(16);  cl.from_int(res.body.len());
    off = hpack_encode_header(block, off, (*uint8)"content-length", 14,
                              (*uint8)cl.cstr(), cl.len());
    cl.free();

    h2_encode_resp_headers(block, &off, res);
    const int first = off > 16384 ? 16384 : off;
    int n = h2_write_headers(out, stream_id, block, first, 0, first == off ? 1 : 0);
    int done = first;
    while (done < off) {
        const int part = off - done > 16384 ? 16384 : off - done;
        const int last = done + part == off ? 1 : 0;
        n += h2_write_continuation(out + n, stream_id, block + done, part, last);
        done += part;
    }
    free((*void)block);
    return n;
}

// Build a complete response on `stream_id` into `out` (must be large enough):
// the HEADERS frame followed by the body as MAX_FRAME_SIZE-bounded DATA frames
// (last carries END_STREAM). Returns the total byte count. Transport-agnostic;
// the blocking TLS server uses this. The async server uses h2_respond_async,
// which adds flow control.
int h2_build_response(*uint8 out, int stream_id, HttpResponse* res) {
    int total = h2_build_headers(out, stream_id, res);

    // Body as DATA frames, each no larger than the default SETTINGS_MAX_FRAME_SIZE
    // (16384) — a single frame may not exceed it. Only the final frame carries
    // END_STREAM; an empty body still sends one empty END_STREAM frame.
    const int blen = res.body.len();
    *uint8 body = (*uint8)res.body.cstr();
    int sent = 0;
    do {
        const int n = blen - sent > 16384 ? 16384 : blen - sent;
        const int last = sent + n >= blen ? 1 : 0;
        total += h2_write_data(out + total, stream_id, body + sent, n, last);
        sent += n;
    } while (sent < blen);
    return total;
}

// Upper bound on the encoded size of a response: the header frames + body + a
// 9-byte frame header per DATA chunk + slack. Callers size their buffer with this.
int h2_response_bufsize(HttpResponse* res) {
    const int blen = res.body.len();
    const int chunks = blen / 16384 + 2;
    return h2_headers_bufsize(res) + blen + 9 * chunks + 64;
}

// Encode and send a response on `stream_id` over the connection's socket.
void h2_send_response(H2Conn* conn, int stream_id, HttpResponse* res) {
    *uint8 out = alloc<uint8>(h2_response_bufsize(res));
    const int n = h2_build_response(out, stream_id, res);
    net_send(conn.fd, (*void)out, n);
    free((*void)out);
}

// ── Server connection engine (transport-agnostic) ───────────────────────────
//
// H2Server is the whole server side of one connection with no I/O of its own:
// the transport reads a frame and hands it to H2Server_step, then writes out
// whatever the engine queued in `out` (s.out[0..s.outlen), then set outlen = 0).
// The h2c server below and both TLS servers in <tls> are thin loops around it,
// so every transport gets the same protocol handling:
//   - receive flow control: DATA spends the stream and connection receive
//     windows, and WINDOW_UPDATE frames give the credit back as data is taken
//     in, so a request body of any size keeps flowing (§6.9);
//   - PADDED DATA / HEADERS are unpadded, and a header block split over
//     CONTINUATION frames is reassembled before it is decoded (§6.10);
//   - responses are queued and sent as the peer's windows allow; while a
//     response waits for window, frames keep being read, so a new request is
//     decoded (HPACK stays in order) and answered instead of dropped;
//   - WINDOW_UPDATE credits only the stream it names, and window overflow past
//     2^31 - 1, bad SETTINGS values, and other protocol violations get the
//     GOAWAY or RST_STREAM that RFC 9113 prescribes;
//   - a header list longer than H2_MAX_HEADERS fields is answered with 431,
//     and one without :method / :path with 400, without calling the handler.

const int H2_MAX_HEADERS   = 64;          // header fields decoded per request
const int H2_MAX_STREAMS   = 128;         // concurrent streams (advertised)
const int H2_MAX_BLOCK     = 262144;      // largest header block buffered (HEADERS + CONTINUATION)
const int H2_RECV_WINDOW   = 65535;       // our receive window (the protocol default)

// Stream slot states.
const int H2S_FREE       = 0;
const int H2S_RECEIVING  = 1;             // request headers in, body still arriving
const int H2S_READY      = 2;             // request complete, handler not run yet
const int H2S_RESPONDING = 3;             // response queued, body being sent

struct H2Slot {
    int   id;
    int   state;
    int   seq;              // arrival order: ready requests are answered first come, first served
    int   bad;              // non-zero: answer with this status and skip the handler
    int64 recv_window;      // bytes the peer may still send on this stream
    int64 recv_unacked;     // bytes taken in but not yet credited back
    int64 send_window;      // bytes we may still send on this stream
    int64 sent;             // response body bytes sent
    HttpRequest  req;       // live in RECEIVING / READY
    HttpResponse res;       // live in RESPONDING
}

struct H2Server {
    H2Conn conn;            // fd, both sides' SETTINGS, last stream id
    HpackDecoder dec;
    *HpackHeader harr;
    *H2Slot slots;
    int    seq;
    int64  send_window;     // connection-level windows (64-bit: overflow is detected, not wrapped)
    int64  recv_window;
    int64  recv_unacked;
    *uint8 hb;              // header block being assembled
    int    hblen;
    int    hbcap;
    int    hb_sid;          // its stream, while CONTINUATION frames are expected (else 0)
    int    hb_end_stream;
    int    got_settings;    // the peer's first frame must be SETTINGS (§3.4)
    int    peer_goaway;     // the peer sent GOAWAY: finish what is open, then close
    int    closing;         // we sent GOAWAY: flush and close
    *uint8 out;             // queued output for the transport
    int64  outlen;
    int64  outcap;
}

// Room for `n` more output bytes; returns where they go (the caller advances outlen).
*uint8 H2Server_reserve(H2Server* s, int64 n) {
    if (s.outlen + n > s.outcap) {
        int64 nc = s.outcap * 2;
        while (nc < s.outlen + n) { nc = nc * 2; }
        *uint8 nb = alloc<uint8>(nc);
        if (s.outlen > 0) { memcpy((*void)nb, (*void)s.out, s.outlen); }
        free((*void)s.out);
        s.out = nb;
        s.outcap = nc;
    }
    return s.out + s.outlen;
}

// Set up the engine for connection `fd` (after the client preface was read) and
// queue our SETTINGS frame.
void H2Server_init(H2Server* s, int fd) {
    H2Conn_init(&s.conn, fd);
    s.conn.local.enable_push = 0;                     // a server MUST NOT set ENABLE_PUSH=1 (§6.5.2)
    s.conn.local.max_concurrent_streams = H2_MAX_STREAMS;
    s.dec.init(4096);
    s.harr = alloc<HpackHeader>(H2_MAX_HEADERS);
    s.slots = alloc<H2Slot>(H2_MAX_STREAMS);          // zeroed: every slot free
    s.seq = 0;
    s.send_window = 65535;
    s.recv_window = H2_RECV_WINDOW;
    s.recv_unacked = 0;
    s.hbcap = 16384;
    s.hb = alloc<uint8>(s.hbcap);
    s.hblen = 0;  s.hb_sid = 0;  s.hb_end_stream = 0;
    s.got_settings = 0;  s.peer_goaway = 0;  s.closing = 0;
    s.outcap = 4096;
    s.out = alloc<uint8>(s.outcap);
    s.outlen = 0;
    *uint8 b = H2Server_reserve(s, 64);
    s.outlen += h2_write_settings(b, &s.conn.local);
}

void H2Server_slot_release(H2Slot* sl) {
    if (sl.state == H2S_RECEIVING || sl.state == H2S_READY) { sl.req.free(); }
    if (sl.state == H2S_RESPONDING) { sl.res.free(); }
    sl.state = H2S_FREE;
}

void H2Server_free(H2Server* s) {
    for (i in 0..H2_MAX_STREAMS) { H2Server_slot_release(&s.slots[i]); }
    free((*void)s.slots);
    free((*void)s.harr);
    free((*void)s.hb);
    free((*void)s.out);
    s.dec.free();
}

// Queue a GOAWAY with `code` (a connection error) and stop taking frames.
void H2Server_goaway(H2Server* s, int code) {
    if (s.closing != 0) { return; }
    *uint8 b = H2Server_reserve(s, 17);
    s.outlen += h2_write_goaway(b, s.conn.last_stream_id, code, null, 0);
    s.closing = 1;
}

void H2Server_rst(H2Server* s, int sid, int code) {
    *uint8 b = H2Server_reserve(s, 13);
    s.outlen += h2_write_rst_stream(b, sid, code);
}

void H2Server_window_update(H2Server* s, int sid, int64 inc) {
    *uint8 b = H2Server_reserve(s, 13);
    s.outlen += h2_write_window_update(b, sid, (int)inc);
}

// The slot holding stream `sid`, or -1.
int H2Server_find(H2Server* s, int sid) {
    for (i in 0..H2_MAX_STREAMS) {
        if (s.slots[i].state != H2S_FREE && s.slots[i].id == sid) { return i; }
    }
    return -1;
}

// 1 once the transport should stop: we sent GOAWAY, or the peer did and every
// stream it opened has been answered.
int H2Server_done(H2Server* s) {
    if (s.closing != 0) { return 1; }
    if (s.peer_goaway == 0) { return 0; }
    for (i in 0..H2_MAX_STREAMS) {
        if (s.slots[i].state != H2S_FREE) { return 0; }
    }
    return 1;
}

// Send queued response bodies as far as the windows allow (MAX_FRAME_SIZE-bounded
// DATA frames; the last carries END_STREAM, and an empty body is one empty
// END_STREAM frame). A finished stream frees its slot.
void H2Server_pump(H2Server* s) {
    bool progress = true;
    while (progress) {
        progress = false;
        for (i in 0..H2_MAX_STREAMS) {
            H2Slot* sl = &s.slots[i];
            if (sl.state != H2S_RESPONDING) { continue; }
            const int64 blen = sl.res.body.len;
            int64 n = blen - sl.sent;
            if (n > 16384) { n = 16384; }
            if (n > sl.send_window) { n = sl.send_window; }
            if (n > s.send_window) { n = s.send_window; }
            if (n <= 0 && sl.sent < blen) { continue; }            // waiting for window
            if (n < 0) { n = 0; }
            const int last = sl.sent + n >= blen ? 1 : 0;
            *uint8 b = H2Server_reserve(s, n + 9);
            s.outlen += h2_write_data(b, sl.id, (*uint8)sl.res.body.data + sl.sent, (int)n, last);
            sl.sent += n;
            sl.send_window -= n;
            s.send_window -= n;
            if (last != 0) { H2Server_slot_release(sl); }
            else { progress = true; }
        }
    }
}

// Run the handler for the ready request in slot `i` (or answer its `bad` status)
// and queue the response.
void H2Server_respond(H2Server* s, int i, escaping fn(HttpRequest*, HttpResponse*)->void handler) {
    H2Slot* sl = &s.slots[i];
    if (sl.bad != 0) {
        sl.res.init(sl.bad);
    } else {
        sl.res.init(200);
        handler(&sl.req, &sl.res);
    }
    sl.req.free();
    sl.state = H2S_RESPONDING;
    sl.sent = 0;
    *uint8 b = H2Server_reserve(s, h2_headers_bufsize(&sl.res));
    s.outlen += h2_build_headers(b, sl.id, &sl.res);
}

// A complete header block for stream `sid` is in s.hb: decode it (always, in
// order, so the HPACK table stays in sync) and open or finish the stream.
void H2Server_headers_done(H2Server* s, int sid, int end_stream) {
    s.hb_sid = 0;
    const int nh = hpack_decode(&s.dec, s.hb, s.hblen, s.harr, H2_MAX_HEADERS);
    if (nh == -1) { H2Server_goaway(s, H2_COMPRESSION_ERROR); return; }
    const int at = H2Server_find(s, sid);
    if (at >= 0) {
        // Trailers on an open request: they must end the stream.
        if (s.slots[at].state != H2S_RECEIVING) { H2Server_goaway(s, H2_STREAM_CLOSED); return; }
        if (end_stream == 0) {
            H2Server_rst(s, sid, H2_PROTOCOL_ERROR);
            H2Server_slot_release(&s.slots[at]);
            return;
        }
        s.slots[at].state = H2S_READY;
        return;
    }
    if (sid <= s.conn.last_stream_id) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }   // a closed stream
    s.conn.last_stream_id = sid;
    if (s.peer_goaway != 0) { H2Server_rst(s, sid, H2_REFUSED_STREAM); return; }
    int free_i = -1;
    for (i in 0..H2_MAX_STREAMS) {
        if (s.slots[i].state == H2S_FREE) { free_i = i; break; }
    }
    if (free_i < 0) { H2Server_rst(s, sid, H2_REFUSED_STREAM); return; }
    H2Slot* sl = &s.slots[free_i];
    sl.id = sid;
    sl.seq = s.seq++;
    sl.bad = 0;
    sl.recv_window = H2_RECV_WINDOW;
    sl.recv_unacked = 0;
    sl.send_window = s.conn.remote.initial_window_size;
    sl.sent = 0;
    sl.req.init();
    if (nh == -2) {
        sl.bad = 431;                                  // Request Header Fields Too Large
    } else {
        h2_fill_request(&sl.req, s.harr, nh);
        if (sl.req.method.len == 0 || sl.req.path.len == 0) { sl.bad = 400; }   // malformed (§8.3.1)
    }
    sl.state = end_stream != 0 ? H2S_READY : H2S_RECEIVING;
}

// Append a header-block fragment; 0 ok, -1 if the block grew past H2_MAX_BLOCK.
int H2Server_hb_append(H2Server* s, *uint8 p, int n) {
    if (s.hblen + n > H2_MAX_BLOCK) { return -1; }
    if (s.hblen + n > s.hbcap) {
        int nc = s.hbcap * 2;
        while (nc < s.hblen + n) { nc = nc * 2; }
        *uint8 nb = alloc<uint8>(nc);
        memcpy((*void)nb, (*void)s.hb, s.hblen);
        free((*void)s.hb);
        s.hb = nb;
        s.hbcap = nc;
    }
    memcpy((*void)(s.hb + s.hblen), (*void)p, n);
    s.hblen += n;
    return 0;
}

void H2Server_on_data(H2Server* s, H2Frame* h, *uint8 p) {
    if (h.stream_id == 0) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
    const int len = h.length;
    // The whole payload, padding included, counts against flow control (§6.9.1).
    if (len > s.recv_window) { H2Server_goaway(s, H2_FLOW_CONTROL_ERROR); return; }
    int off = 0;  int pad = 0;
    if ((h.flags & H2_FLAG_PADDED) != 0) {
        if (len < 1) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
        pad = (int)p[0];  off = 1;
        if (pad >= len) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }   // §6.1
    }
    s.recv_window -= len;
    s.recv_unacked += len;
    if (s.recv_unacked >= H2_RECV_WINDOW / 2) {
        H2Server_window_update(s, 0, s.recv_unacked);
        s.recv_window += s.recv_unacked;
        s.recv_unacked = 0;
    }
    const int at = H2Server_find(s, h.stream_id);
    if (at < 0 || s.slots[at].state != H2S_RECEIVING) {
        if (at < 0 && h.stream_id > s.conn.last_stream_id) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }   // idle stream
        H2Server_rst(s, h.stream_id, H2_STREAM_CLOSED);
        return;
    }
    H2Slot* sl = &s.slots[at];
    if (len > sl.recv_window) {
        H2Server_rst(s, sl.id, H2_FLOW_CONTROL_ERROR);
        H2Server_slot_release(sl);
        return;
    }
    sl.recv_window -= len;
    if (sl.bad == 0) {
        for (k in off..len - pad) { sl.req.body.push((char)p[k]); }
    }
    if ((h.flags & H2_FLAG_END_STREAM) != 0) {
        sl.state = H2S_READY;                          // no more credit needed on this stream
        return;
    }
    sl.recv_unacked += len;
    if (sl.recv_unacked >= H2_RECV_WINDOW / 2) {
        H2Server_window_update(s, sl.id, sl.recv_unacked);
        sl.recv_window += sl.recv_unacked;
        sl.recv_unacked = 0;
    }
}

void H2Server_on_headers(H2Server* s, H2Frame* h, *uint8 p) {
    const int sid = h.stream_id;
    if (sid == 0 || (sid & 1) == 0) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }   // client streams are odd
    int off = 0;  int pad = 0;
    if ((h.flags & H2_FLAG_PADDED) != 0) {
        if (h.length < 1) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
        pad = (int)p[0];  off = 1;
    }
    if ((h.flags & H2_FLAG_PRIORITY) != 0) { off += 5; }
    if (off + pad > h.length) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }   // §6.2
    s.hblen = 0;
    if (H2Server_hb_append(s, p + off, h.length - off - pad) != 0) { H2Server_goaway(s, H2_ENHANCE_YOUR_CALM); return; }
    s.hb_end_stream = (h.flags & H2_FLAG_END_STREAM) != 0 ? 1 : 0;
    if ((h.flags & H2_FLAG_END_HEADERS) != 0) { H2Server_headers_done(s, sid, s.hb_end_stream); }
    else { s.hb_sid = sid; }
}

void H2Server_on_settings(H2Server* s, H2Frame* h, *uint8 p) {
    if (h.stream_id != 0) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
    if ((h.flags & H2_FLAG_ACK) != 0) {
        if (h.length != 0) { H2Server_goaway(s, H2_FRAME_SIZE_ERROR); }
        return;
    }
    const int err = h2_settings_error(p, h.length);
    if (err != 0) { H2Server_goaway(s, err); return; }
    const int64 old_iw = s.conn.remote.initial_window_size;
    h2_apply_settings(&s.conn.remote, p, h.length);
    // A new INITIAL_WINDOW_SIZE shifts every open stream's send window by the
    // difference (§6.9.2); one pushed past 2^31 - 1 is a FLOW_CONTROL_ERROR.
    const int64 delta = s.conn.remote.initial_window_size - old_iw;
    for (i in 0..H2_MAX_STREAMS) {
        if (s.slots[i].state == H2S_FREE) { continue; }
        s.slots[i].send_window += delta;
        if (s.slots[i].send_window > H2_MAX_WINDOW) { H2Server_goaway(s, H2_FLOW_CONTROL_ERROR); return; }
    }
    *uint8 b = H2Server_reserve(s, 9);
    s.outlen += h2_write_settings_ack(b);
    s.got_settings = 1;
}

void H2Server_on_window_update(H2Server* s, H2Frame* h, *uint8 p) {
    if (h.length != 4) { H2Server_goaway(s, H2_FRAME_SIZE_ERROR); return; }
    const int64 inc = (int64)h2_read_window_update(p);
    if (h.stream_id == 0) {
        if (inc == 0) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
        if (s.send_window + inc > H2_MAX_WINDOW) { H2Server_goaway(s, H2_FLOW_CONTROL_ERROR); return; }
        s.send_window += inc;
        return;
    }
    const int at = H2Server_find(s, h.stream_id);
    if (at < 0) {
        if (h.stream_id > s.conn.last_stream_id) { H2Server_goaway(s, H2_PROTOCOL_ERROR); }   // idle stream
        return;                                        // a closed stream: allowed, ignored
    }
    H2Slot* sl = &s.slots[at];
    if (inc == 0 || sl.send_window + inc > H2_MAX_WINDOW) {
        H2Server_rst(s, sl.id, inc == 0 ? H2_PROTOCOL_ERROR : H2_FLOW_CONTROL_ERROR);
        H2Server_slot_release(sl);
        return;
    }
    sl.send_window += inc;
}

// Process one received frame (header `h`, payload `p` of h.length bytes).
void H2Server_on_frame(H2Server* s, H2Frame* h, *uint8 p) {
    if (s.closing != 0) { return; }
    if (s.got_settings == 0 && (h.type != H2_SETTINGS || (h.flags & H2_FLAG_ACK) != 0)) {
        H2Server_goaway(s, H2_PROTOCOL_ERROR);
        return;
    }
    if (s.hb_sid != 0) {                               // mid header block: only its CONTINUATION
        if (h.type != H2_CONTINUATION || h.stream_id != s.hb_sid) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
        if (H2Server_hb_append(s, p, h.length) != 0) { H2Server_goaway(s, H2_ENHANCE_YOUR_CALM); return; }
        if ((h.flags & H2_FLAG_END_HEADERS) != 0) { H2Server_headers_done(s, s.hb_sid, s.hb_end_stream); }
        return;
    }
    if (h.type == H2_DATA) { H2Server_on_data(s, h, p); }
    else if (h.type == H2_HEADERS) { H2Server_on_headers(s, h, p); }
    else if (h.type == H2_PRIORITY) {
        if (h.stream_id == 0) { H2Server_goaway(s, H2_PROTOCOL_ERROR); }
        else if (h.length != 5) { H2Server_rst(s, h.stream_id, H2_FRAME_SIZE_ERROR); }
    } else if (h.type == H2_RST_STREAM) {
        if (h.stream_id == 0) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
        if (h.length != 4) { H2Server_goaway(s, H2_FRAME_SIZE_ERROR); return; }
        const int at = H2Server_find(s, h.stream_id);
        if (at >= 0) { H2Server_slot_release(&s.slots[at]); }
    } else if (h.type == H2_SETTINGS) { H2Server_on_settings(s, h, p); }
    else if (h.type == H2_PUSH_PROMISE || h.type == H2_CONTINUATION) { H2Server_goaway(s, H2_PROTOCOL_ERROR); }
    else if (h.type == H2_PING) {
        if (h.stream_id != 0) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
        if (h.length != 8) { H2Server_goaway(s, H2_FRAME_SIZE_ERROR); return; }
        if ((h.flags & H2_FLAG_ACK) == 0) {
            *uint8 b = H2Server_reserve(s, 17);
            s.outlen += h2_write_ping(b, p, 1);
        }
    } else if (h.type == H2_GOAWAY) {
        if (h.stream_id != 0) { H2Server_goaway(s, H2_PROTOCOL_ERROR); return; }
        s.peer_goaway = 1;
    } else if (h.type == H2_WINDOW_UPDATE) { H2Server_on_window_update(s, h, p); }
    // Unknown frame types are ignored (§4.1).
}

// Process one frame, answer every request it completed (oldest first), and
// queue whatever response data the windows now allow. The transport then
// writes s.out[0..s.outlen) and resets outlen.
void H2Server_step(H2Server* s, H2Frame* h, *uint8 p, escaping fn(HttpRequest*, HttpResponse*)->void handler) {
    H2Server_on_frame(s, h, p);
    if (s.closing != 0) { return; }
    while (true) {
        int pick = -1;
        for (i in 0..H2_MAX_STREAMS) {
            if (s.slots[i].state == H2S_READY && (pick < 0 || s.slots[i].seq < s.slots[pick].seq)) { pick = i; }
        }
        if (pick < 0) { break; }
        H2Server_respond(s, pick, handler);
    }
    H2Server_pump(s);
}

// Drive one connection: the client preface, then frames through the H2Server
// engine until either side ends the connection (GOAWAY) or the peer closes.
async void http2_serve_conn_async(EventLoop* lp, int fd,
                                  escaping fn(HttpRequest*, HttpResponse*)->void handler,
                                  Chan<int>* done) {
    net_set_nonblocking(fd);                          // never block the loop thread
    *uint8 pf = alloc<uint8>(24);
    int pn = await h2_read_full_async(lp, fd, pf, 24);
    bool good = pn == 24 && h2_is_preface(pf) != 0;
    free((*void)pf);
    if (good) {
        H2Server* s = alloc<H2Server>(1);
        H2Server_init(s, fd);
        int FBCAP = 16384 + H2_FRAME_HEADER_LEN;       // a full MAX_FRAME_SIZE payload + header
        *uint8 fb = alloc<uint8>(FBCAP);
        int running = 1;
        while (running != 0) {
            if (s.outlen > 0) {
                int w = await net_write_async(lp, fd, s.out, s.outlen);
                s.outlen = 0;
                if (w < 0) { running = 0; }
            }
            if (running != 0 && H2Server_done(s) != 0) { running = 0; }
            if (running != 0) {
                let hdr: H2Frame;
                int plen = await h2_read_frame_async(lp, fd, fb, FBCAP, &hdr);
                if (plen == -2) { H2Server_goaway(s, H2_FRAME_SIZE_ERROR); }   // over MAX_FRAME_SIZE
                else if (plen < 0) { running = 0; }
                else { H2Server_step(s, &hdr, fb + H2_FRAME_HEADER_LEN, handler); }
            }
        }
        free((*void)fb);
        H2Server_free(s);
        free((*void)s);
    }
    net_close(fd);
    Chan_send<int>(done, 1);
}

// Accept and serve `max_conns` connections concurrently (each detached), then
// wait for all to finish — mirroring <http_async>'s http_serve_async.
async void http2_serve_async(EventLoop* lp, int listen_fd,
                             escaping fn(HttpRequest*, HttpResponse*)->void handler,
                             int max_conns) {
    Chan<int>* done = chan_new<int>(max_conns);
    for (int accepted = 0; accepted < max_conns; accepted++) {
        int c = await net_accept_retry_async(lp, listen_fd);   // a failed accept is retried, never served
        spawn(http2_serve_conn_async(lp, c, handler, done));
    }
    for (int finished = 0; finished < max_conns; finished++) {
        int sig = await Chan_recv(done);
    }
    Chan_free<int>(done);
}
