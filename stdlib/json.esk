// json.esk — a complete JSON module: a builder (writer) and a parser (reader).
//
// Builder — `Json` accumulates text; separators are inserted automatically:
//   let j: Json;  Json_init(&j);
//   Json_obj_begin(&j);
//     Json_key(&j, "name"); Json_str(&j, "Eskiu");
//     Json_key(&j, "year"); Json_int(&j, 2026);
//   Json_obj_end(&j);
//   printf("%s\n", Json_cstr(&j));    // {"name":"Eskiu","year":2026}
//   Json_free(&j);
//
// Parser — `json_parse` returns a `*JsonValue` tree (null on error):
//   *JsonValue v = json_parse(text);
//   *JsonValue name = JsonValue_get(v, "name");   // object lookup
//   printf("%s\n", JsonValue_as_cstr(name));
//   JsonValue_free(v);

import <string>;

extern double atof(string s);

// ── Builder ──────────────────────────────────────────────────────────────────

struct Json {
    String buf;
}

void Json_init(Json* self)  { self.buf.init(64); }
void Json_free(Json* self)  { self.buf.free(); }
*char Json_cstr(Json* self) { return self.buf.cstr(); }

// Insert a separating comma unless the last byte is an opener or a key colon.
void Json_sep(Json* self) {
    const int64 n = self.buf.len;
    if (n == 0) { return; }
    const char last = self.buf.data[n - 1];
    if (last == '{' || last == '[' || last == ':' || last == ',') { return; }
    self.buf.push(',');
}

// Append a JSON string literal: `"` and backslash are escaped, and every
// control byte below 0x20 becomes \n \t \r \b \f or \u00XX (RFC 8259 §7).
void Json_raw_str(Json* self, string s) {
    String* out = &self.buf;
    out.push('"');
    for (int i = 0; s[i] != 0; i++) {
        const char c = s[i];
        const int u = (int)(uint8)c;
        if (c == '"' || c == '\\') { out.push('\\'); out.push(c); }
        else if (c == '\n') { out.append("\\n"); }
        else if (c == '\t') { out.append("\\t"); }
        else if (c == '\r') { out.append("\\r"); }
        else if (u == 8)    { out.append("\\b"); }
        else if (c == '\f') { out.append("\\f"); }
        else if (u < 32) {
            out.append("\\u00");
            out.push("0123456789abcdef"[u >> 4]);
            out.push("0123456789abcdef"[u & 15]);
        }
        else { out.push(c); }
    }
    out.push('"');
}

void Json_obj_begin(Json* self) { Json_sep(self); self.buf.push('{'); }
void Json_obj_end(Json* self)   { self.buf.push('}'); }
void Json_arr_begin(Json* self) { Json_sep(self); self.buf.push('['); }
void Json_arr_end(Json* self)   { self.buf.push(']'); }

// Object key: emits "key": — the following value attaches without a comma.
void Json_key(Json* self, string k) {
    Json_sep(self);
    Json_raw_str(self, k);
    self.buf.push(':');
}

void Json_str(Json* self, string v) { Json_sep(self); Json_raw_str(self, v); }

// Append the full int64 (no truncation to 32 bits; INT64_MIN included).
void Json_int(Json* self, int64 v) {
    Json_sep(self);
    String* out = &self.buf;
    uint64 mag = (uint64)v;
    if (v < 0) { out.push('-'); mag = (uint64)0 - (uint64)v; }
    // Collect the digits least significant first, then emit them in reverse.
    let digits: char[20];
    int n = 0;
    do {
        digits[n++] = (char)('0' + (int)(mag % 10));
        mag /= 10;
    } while (mag > 0);
    while (n > 0) { out.push(digits[--n]); }
}

void Json_bool(Json* self, int b) {
    Json_sep(self);
    self.buf.append(b != 0 ? "true" : "false");
}

void Json_null(Json* self) { Json_sep(self); self.buf.append("null"); }

// ── Parsed value tree ────────────────────────────────────────────────────────

enum JsonKind { JNull, JBool, JNumber, JString, JArray, JObject }

// A node uses first-child / next-sibling links, so arrays and objects need no
// generic containers. Object members carry their `key`; everything else leaves
// it empty. `str`/`key` own their buffers (data == null when unused).
struct JsonValue {
    int        kind;
    double     num;       // JNumber
    int        boolean;   // JBool
    String     str;       // JString value
    String     key;       // set when this node is an object member
    *JsonValue child;     // first array element / object member
    *JsonValue next;      // next sibling
}

// alloc zero-fills, so num is 0, boolean is 0, and str/key/child/next are null.
*JsonValue JsonValue_new(int kind) {
    *JsonValue v = alloc<JsonValue>(1);
    v.kind = kind;
    return v;
}

// Free a value tree (safe on null). Fully iterative, so neither a long array
// nor deep nesting recurses: a node's children are spliced into the work list
// in front of its siblings before the node is freed (each child chain is walked
// once to find its tail, so the whole free is linear).
void JsonValue_free(JsonValue* v) {
    while (v != null) {
        if (v.child != null) {
            *JsonValue last = v.child;
            while (last.next != null) { last = last.next; }
            last.next = v.next;
            v.next = v.child;
            v.child = null;
        }
        *JsonValue nx = v.next;
        if (v.str.data != null) { v.str.free(); }
        if (v.key.data != null) { v.key.free(); }
        free(v);
        v = nx;
    }
}

int JsonValue_kind(JsonValue* v) { return v.kind; }

// Number of array elements / object members.
int JsonValue_len(JsonValue* v) {
    int n = 0;
    for (*JsonValue c = v.child; c != null; c = c.next) { n++; }
    return n;
}

// The i-th array element (or object member), or null if out of range.
*JsonValue JsonValue_at(JsonValue* v, int i) {
    int j = 0;
    for (*JsonValue c = v.child; c != null; c = c.next) {
        if (j == i) { return c; }
        j++;
    }
    return null;
}

// The object member whose key equals `key`, or null.
*JsonValue JsonValue_get(JsonValue* v, string key) {
    for (*JsonValue c = v.child; c != null; c = c.next) {
        if (c.key.data != null && c.key.eq_cstr(key) == 1) { return c; }
    }
    return null;
}

int64  JsonValue_as_int(JsonValue* v)    { return (int64)v.num; }
double JsonValue_as_double(JsonValue* v) { return v.num; }
int    JsonValue_as_bool(JsonValue* v)   { return v.boolean; }
*char  JsonValue_as_cstr(JsonValue* v)   { return v.str.cstr(); }

// ── Parser (recursive descent) ───────────────────────────────────────────────
// Strict RFC 8259: exact literals, the number grammar, the full escape set with
// \uXXXX decoded to UTF-8 (surrogate pairs combined), no raw control bytes in a
// string, and nothing but whitespace after the top-level value. Every read
// stops at the terminating NUL, so malformed input never reads past `src`.

struct JParser {
    string src;
    int    pos;
    int    err;     // 0 = ok, 1 = malformed
    int    depth;   // arrays/objects currently open
}

// Nesting limit: deeper input is rejected (json_parse returns null) instead of
// recursing until the stack overflows. 512 matches common parsers.
const int JSON_MAX_DEPTH = 512;

void JParser_ws(JParser* self) {
    while (true) {
        const char c = self.src[self.pos];
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') { return; }
        self.pos++;
    }
}

// Value of one hex digit, or -1.
int JParser_hex(char c) {
    if (c >= '0' && c <= '9') { return (int)c - '0'; }
    if (c >= 'a' && c <= 'f') { return (int)c - 'a' + 10; }
    if (c >= 'A' && c <= 'F') { return (int)c - 'A' + 10; }
    return -1;
}

// Read the 4 hex digits of a \u escape (cursor on the first digit); -1 if bad.
int JParser_u4(JParser* self) {
    int v = 0;
    for (int i = 0; i < 4; i++) {
        const int h = JParser_hex(self.src[self.pos]);
        if (h < 0) { return -1; }
        v = v * 16 + h;
        self.pos++;
    }
    return v;
}

// Append code point `cp` (<= 0x10FFFF) as UTF-8.
void JParser_utf8(String* out, int cp) {
    if (cp < 128) { out.push((char)cp); }
    else if (cp < 2048) {
        out.push((char)(192 | (cp >> 6)));
        out.push((char)(128 | (cp & 63)));
    } else if (cp < 65536) {
        out.push((char)(224 | (cp >> 12)));
        out.push((char)(128 | ((cp >> 6) & 63)));
        out.push((char)(128 | (cp & 63)));
    } else {
        out.push((char)(240 | (cp >> 18)));
        out.push((char)(128 | ((cp >> 12) & 63)));
        out.push((char)(128 | ((cp >> 6) & 63)));
        out.push((char)(128 | (cp & 63)));
    }
}

// Read a quoted string (cursor must be on the opening quote) into `out`,
// decoding every JSON escape.
void JParser_read_string(JParser* self, String* out) {
    self.pos++;   // skip opening quote
    while (true) {
        const int c = (int)(uint8)self.src[self.pos];
        if (c == 0)   { self.err = 1; return; }       // unterminated
        if (c == '"') { self.pos++; return; }         // closing quote
        if (c < 32)   { self.err = 1; return; }       // raw control byte
        if (c != '\\') {
            out.push((char)c);
            self.pos++;
            continue;
        }
        // A backslash escape.
        self.pos++;
        const char e = self.src[self.pos];
        if (e == 0) { self.err = 1; return; }
        self.pos++;
        switch (e) {
            case '"':  out.push('"'); break;
            case '\\': out.push('\\'); break;
            case '/':  out.push('/'); break;
            case 'b':  out.push((char)8); break;
            case 'f':  out.push('\f'); break;
            case 'n':  out.push('\n'); break;
            case 'r':  out.push('\r'); break;
            case 't':  out.push('\t'); break;
            case 'u': {                                // \uXXXX
                int cp = JParser_u4(self);
                if (cp < 0 || (cp >= 56320 && cp <= 57343)) { self.err = 1; return; }  // bad / lone low surrogate
                if (cp >= 55296 && cp <= 56319) {      // high surrogate: a \uDC00-\uDFFF must follow
                    if (self.src[self.pos] != '\\' || self.src[self.pos + 1] != 'u') { self.err = 1; return; }
                    self.pos += 2;
                    const int lo = JParser_u4(self);
                    if (lo < 56320 || lo > 57343) { self.err = 1; return; }
                    cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                }
                JParser_utf8(out, cp);
            } break;
            default: self.err = 1; return;             // not a JSON escape
        }
    }
}

int JParser_is_digit(char c) {
    return (c >= '0' && c <= '9') ? 1 : 0;
}

// Read a number per the JSON grammar: -? (0 | [1-9][0-9]*) (.[0-9]+)? ([eE][+-]?[0-9]+)?
double JParser_read_number(JParser* self) {
    const int start = self.pos;
    if (self.src[self.pos] == '-') { self.pos++; }
    if (self.src[self.pos] == '0') { self.pos++; }
    else if (JParser_is_digit(self.src[self.pos]) == 1) {
        while (JParser_is_digit(self.src[self.pos]) == 1) { self.pos++; }
    } else { self.err = 1; return 0.0; }
    if (self.src[self.pos] == '.') {
        self.pos++;
        if (JParser_is_digit(self.src[self.pos]) == 0) { self.err = 1; return 0.0; }
        while (JParser_is_digit(self.src[self.pos]) == 1) { self.pos++; }
    }
    if (self.src[self.pos] == 'e' || self.src[self.pos] == 'E') {
        self.pos++;
        if (self.src[self.pos] == '+' || self.src[self.pos] == '-') { self.pos++; }
        if (JParser_is_digit(self.src[self.pos]) == 0) { self.err = 1; return 0.0; }
        while (JParser_is_digit(self.src[self.pos]) == 1) { self.pos++; }
    }
    // atof needs a NUL-terminated copy of just the number's text.
    let text: String;
    text.init(self.pos - start + 1);
    defer text.free();
    for (i in start..self.pos) { text.push(self.src[i]); }
    return atof((string)text.cstr());
}

// Consume the exact literal `word` (true / false / null); sets err otherwise.
void JParser_word(JParser* self, string word) {
    for (int i = 0; word[i] != 0; i++) {
        if (self.src[self.pos] != word[i]) { self.err = 1; return; }
        self.pos++;
    }
}

*JsonValue JParser_value(JParser* self);   // forward (mutual recursion)

// On error the partial container is returned with everything parsed so far
// linked in, so json_parse frees the whole tree.
*JsonValue JParser_array(JParser* self) {
    *JsonValue arr = JsonValue_new(JArray);
    self.pos++;   // skip [
    JParser_ws(self);
    if (self.src[self.pos] == ']') { self.pos++; return arr; }
    *JsonValue tail = null;
    while (true) {
        *JsonValue elem = JParser_value(self);
        if (elem != null) {
            if (arr.child == null) { arr.child = elem; } else { tail.next = elem; }
            tail = elem;
        }
        if (self.err == 1) { return arr; }
        JParser_ws(self);
        const char c = self.src[self.pos];
        if (c == ',') { self.pos++; }
        else if (c == ']') { self.pos++; return arr; }
        else { self.err = 1; return arr; }
    }
    return arr;
}

*JsonValue JParser_object(JParser* self) {
    *JsonValue obj = JsonValue_new(JObject);
    self.pos++;   // skip {
    JParser_ws(self);
    if (self.src[self.pos] == '}') { self.pos++; return obj; }
    *JsonValue tail = null;
    while (true) {
        JParser_ws(self);
        if (self.src[self.pos] != '"') { self.err = 1; return obj; }   // expect a key
        let k: String;
        k.init(8);
        JParser_read_string(self, &k);
        if (self.err == 1) { k.free(); return obj; }
        JParser_ws(self);
        if (self.src[self.pos] != ':') { self.err = 1; k.free(); return obj; }
        self.pos++;
        *JsonValue val = JParser_value(self);
        if (val == null) { k.free(); return obj; }
        val.key = k;   // move the key in
        if (obj.child == null) { obj.child = val; } else { tail.next = val; }
        tail = val;
        if (self.err == 1) { return obj; }
        JParser_ws(self);
        const char c = self.src[self.pos];
        if (c == ',') { self.pos++; }
        else if (c == '}') { self.pos++; return obj; }
        else { self.err = 1; return obj; }
    }
    return obj;
}

*JsonValue JParser_value(JParser* self) {
    JParser_ws(self);
    const char c = self.src[self.pos];
    if (c == '{' || c == '[') {
        if (self.depth >= JSON_MAX_DEPTH) { self.err = 1; return null; }
        self.depth++;
        *JsonValue r = c == '{' ? JParser_object(self) : JParser_array(self);
        self.depth--;
        return r;
    }
    if (c == '"') {
        *JsonValue v = JsonValue_new(JString);
        v.str.init(8);
        JParser_read_string(self, &v.str);
        return v;
    }
    if (c == 't') {
        *JsonValue v = JsonValue_new(JBool);
        v.boolean = 1;
        JParser_word(self, "true");
        return v;
    }
    if (c == 'f') {
        *JsonValue v = JsonValue_new(JBool);
        JParser_word(self, "false");
        return v;
    }
    if (c == 'n') {
        *JsonValue v = JsonValue_new(JNull);
        JParser_word(self, "null");
        return v;
    }
    if (c == '-' || JParser_is_digit(c) == 1) {
        *JsonValue v = JsonValue_new(JNumber);
        v.num = JParser_read_number(self);
        return v;
    }
    self.err = 1;
    return null;
}

// Parse `src` into a value tree. Returns null on malformed input (any partial
// tree is freed first). Free the result with JsonValue_free.
*JsonValue json_parse(string src) {
    let p: JParser;
    p.src = src;
    p.pos = 0;
    p.err = 0;
    p.depth = 0;
    *JsonValue v = JParser_value(&p);
    if (p.err == 0) {
        JParser_ws(&p);
        if (p.src[p.pos] != 0) { p.err = 1; }        // trailing garbage after the value
    }
    if (p.err == 1) {
        JsonValue_free(v);
        return null;
    }
    return v;
}
