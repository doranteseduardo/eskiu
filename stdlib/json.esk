// json.esk — a complete JSON module: a builder (writer) and a parser (reader).
//
// Builder — `Json` accumulates text; separators are inserted automatically:
//   let j: Json;  Json_init(&j);
//   Json_obj_begin(&j);
//     Json_key(&j, "name"); Json_str(&j, "Eskiu");
//     Json_key(&j, "year"); Json_int(&j, 2026);
//   Json_obj_end(&j);
//   printf("%s\n", Json_cstr(&j));    // {"name":"Eskiu","year":2026}
//   Json_free(&j);
//
// Parser — `json_parse` returns a `*JsonValue` tree (null on error):
//   *JsonValue v = json_parse(text);
//   *JsonValue name = JsonValue_get(v, "name");   // object lookup
//   printf("%s\n", JsonValue_as_cstr(name));
//   JsonValue_free(v);

import <string>;

extern double atof(string s);

// ── Builder ──────────────────────────────────────────────────────────────────

struct Json {
    String buf;
}

void Json_init(Json* self)  { String_init(&self.buf, 64); }
void Json_free(Json* self)  { String_free(&self.buf); }
*char Json_cstr(Json* self) { return String_cstr(&self.buf); }

// Insert a separating comma unless the last byte is an opener or a key colon.
void Json_sep(Json* self) {
    int n = self.buf.len;
    if (n == 0) { return; }
    char last = self.buf.data[n - 1];
    if (last == 123 || last == 91 || last == 58 || last == 44) { return; } // { [ : ,
    String_push(&self.buf, ',');
}

// Append a JSON string literal: `"` and backslash are escaped, and every
// control byte below 0x20 becomes \n \t \r \b \f or \u00XX (RFC 8259 §7).
void Json_raw_str(Json* self, string s) {
    String_push(&self.buf, '"');
    let i: int = 0;
    while (s[i] != 0) {
        char c = s[i];
        int u = (int)(uint8)c;
        if (c == 34 || c == 92) { String_push(&self.buf, '\\'); String_push(&self.buf, c); }  // " or backslash
        else if (u == 10) { String_append(&self.buf, "\\n"); }
        else if (u == 9)  { String_append(&self.buf, "\\t"); }
        else if (u == 13) { String_append(&self.buf, "\\r"); }
        else if (u == 8)  { String_append(&self.buf, "\\b"); }
        else if (u == 12) { String_append(&self.buf, "\\f"); }
        else if (u < 32) {
            String_append(&self.buf, "\\u00");
            String_push(&self.buf, "0123456789abcdef"[u >> 4]);
            String_push(&self.buf, "0123456789abcdef"[u & 15]);
        }
        else { String_push(&self.buf, c); }
        i = i + 1;
    }
    String_push(&self.buf, '"');
}

void Json_obj_begin(Json* self) { Json_sep(self); String_push(&self.buf, '{'); }
void Json_obj_end(Json* self)   { String_push(&self.buf, '}'); }
void Json_arr_begin(Json* self) { Json_sep(self); String_push(&self.buf, '['); }
void Json_arr_end(Json* self)   { String_push(&self.buf, ']'); }

// Object key: emits "key": — the following value attaches without a comma.
void Json_key(Json* self, string k) {
    Json_sep(self);
    Json_raw_str(self, k);
    String_push(&self.buf, ':');
}

void Json_str(Json* self, string v) { Json_sep(self); Json_raw_str(self, v); }

// Append the full int64 (no truncation to 32 bits; INT64_MIN included).
void Json_int(Json* self, int64 v) {
    Json_sep(self);
    uint64 mag = (uint64)v;
    if (v < (int64)0) { String_push(&self.buf, '-'); mag = (uint64)0 - (uint64)v; }
    let digits: char[20];
    int n = 0;
    if (mag == (uint64)0) { digits[0] = '0'; n = 1; }
    while (mag > (uint64)0) {
        digits[n] = (char)(48 + (int)(mag % (uint64)10));
        mag = mag / (uint64)10;
        n = n + 1;
    }
    while (n > 0) { n = n - 1; String_push(&self.buf, digits[n]); }
}

void Json_bool(Json* self, int b) {
    Json_sep(self);
    if (b != 0) { String_append(&self.buf, "true"); }
    else        { String_append(&self.buf, "false"); }
}

void Json_null(Json* self) { Json_sep(self); String_append(&self.buf, "null"); }

// ── Parsed value tree ────────────────────────────────────────────────────────

enum JsonKind { JNull, JBool, JNumber, JString, JArray, JObject }

// A node uses first-child / next-sibling links, so arrays and objects need no
// generic containers. Object members carry their `key`; everything else leaves
// it empty. `str`/`key` own their buffers (data == null when unused).
struct JsonValue {
    int        kind;
    double     num;       // JNumber
    int        boolean;   // JBool
    String     str;       // JString value
    String     key;       // set when this node is an object member
    *JsonValue child;     // first array element / object member
    *JsonValue next;      // next sibling
}

*JsonValue JsonValue_new(int kind) {
    *JsonValue v = alloc<JsonValue>(1);
    v.kind = kind;
    v.num = 0.0;
    v.boolean = 0;
    v.str.data = (*char)0; v.str.len = 0; v.str.cap = 0;
    v.key.data = (*char)0; v.key.len = 0; v.key.cap = 0;
    v.child = (*JsonValue)0;
    v.next  = (*JsonValue)0;
    return v;
}

// Free a value tree (safe on null). Siblings are walked iteratively, so a long
// array does not recurse once per element.
void JsonValue_free(JsonValue* v) {
    while (v != null) {
        *JsonValue nx = v.next;
        JsonValue_free(v.child);
        if (v.str.data != null) { String_free(&v.str); }
        if (v.key.data != null) { String_free(&v.key); }
        free((*void)v);
        v = nx;
    }
}

int JsonValue_kind(JsonValue* v) { return v.kind; }

// Number of array elements / object members.
int JsonValue_len(JsonValue* v) {
    int n = 0;
    *JsonValue c = v.child;
    while (c != null) { n = n + 1; c = c.next; }
    return n;
}

// The i-th array element (or object member), or null if out of range.
*JsonValue JsonValue_at(JsonValue* v, int i) {
    *JsonValue c = v.child;
    int j = 0;
    while (c != null) {
        if (j == i) { return c; }
        j = j + 1;
        c = c.next;
    }
    return (*JsonValue)0;
}

// The object member whose key equals `key`, or null.
*JsonValue JsonValue_get(JsonValue* v, string key) {
    *JsonValue c = v.child;
    while (c != null) {
        if (c.key.data != null && String_eq_cstr(&c.key, key) == 1) { return c; }
        c = c.next;
    }
    return (*JsonValue)0;
}

int64  JsonValue_as_int(JsonValue* v)    { return (int64)v.num; }
double JsonValue_as_double(JsonValue* v) { return v.num; }
int    JsonValue_as_bool(JsonValue* v)   { return v.boolean; }
*char  JsonValue_as_cstr(JsonValue* v)   { return String_cstr(&v.str); }

// ── Parser (recursive descent) ───────────────────────────────────────────────
// Strict RFC 8259: exact literals, the number grammar, the full escape set with
// \uXXXX decoded to UTF-8 (surrogate pairs combined), no raw control bytes in a
// string, and nothing but whitespace after the top-level value. Every read
// stops at the terminating NUL, so malformed input never reads past `src`.

struct JParser {
    string src;
    int    pos;
    int    err;   // 0 = ok, 1 = malformed
}

void JParser_ws(JParser* self) {
    while (1) {
        char c = self.src[self.pos];
        if (c == 32 || c == 9 || c == 10 || c == 13) { self.pos = self.pos + 1; }
        else { return; }
    }
}

// Value of one hex digit, or -1.
int JParser_hex(char c) {
    if (c >= 48 && c <= 57)  { return (int)c - 48; }
    if (c >= 97 && c <= 102) { return (int)c - 87; }
    if (c >= 65 && c <= 70)  { return (int)c - 55; }
    return -1;
}

// Read the 4 hex digits of a \u escape (cursor on the first digit); -1 if bad.
int JParser_u4(JParser* self) {
    int v = 0;
    int i = 0;
    while (i < 4) {
        int h = JParser_hex(self.src[self.pos]);
        if (h < 0) { return -1; }
        v = v * 16 + h;
        self.pos = self.pos + 1;
        i = i + 1;
    }
    return v;
}

// Append code point `cp` (<= 0x10FFFF) as UTF-8.
void JParser_utf8(String* out, int cp) {
    if (cp < 128) { String_push(out, (char)cp); }
    else if (cp < 2048) {
        String_push(out, (char)(192 | (cp >> 6)));
        String_push(out, (char)(128 | (cp & 63)));
    } else if (cp < 65536) {
        String_push(out, (char)(224 | (cp >> 12)));
        String_push(out, (char)(128 | ((cp >> 6) & 63)));
        String_push(out, (char)(128 | (cp & 63)));
    } else {
        String_push(out, (char)(240 | (cp >> 18)));
        String_push(out, (char)(128 | ((cp >> 12) & 63)));
        String_push(out, (char)(128 | ((cp >> 6) & 63)));
        String_push(out, (char)(128 | (cp & 63)));
    }
}

// Read a quoted string (cursor must be on the opening quote) into `out`,
// decoding every JSON escape.
void JParser_read_string(JParser* self, String* out) {
    self.pos = self.pos + 1;   // skip opening quote
    while (1) {
        int c = (int)(uint8)self.src[self.pos];
        if (c == 0)  { self.err = 1; return; }     // unterminated
        if (c == 34) { self.pos = self.pos + 1; return; }   // closing quote
        if (c < 32)  { self.err = 1; return; }     // raw control byte
        if (c == 92) {                              // backslash escape
            self.pos = self.pos + 1;
            char e = self.src[self.pos];
            if (e == 0) { self.err = 1; return; }
            self.pos = self.pos + 1;
            if      (e == 34)  { String_push(out, '"'); }
            else if (e == 92)  { String_push(out, '\\'); }
            else if (e == 47)  { String_push(out, '/'); }
            else if (e == 98)  { String_push(out, (char)8); }
            else if (e == 102) { String_push(out, '\f'); }
            else if (e == 110) { String_push(out, '\n'); }
            else if (e == 114) { String_push(out, '\r'); }
            else if (e == 116) { String_push(out, '\t'); }
            else if (e == 117) {                    // \uXXXX
                int cp = JParser_u4(self);
                if (cp < 0 || (cp >= 56320 && cp <= 57343)) { self.err = 1; return; }  // bad / lone low surrogate
                if (cp >= 55296 && cp <= 56319) {   // high surrogate: a \uDC00-\uDFFF must follow
                    if (self.src[self.pos] != 92 || self.src[self.pos + 1] != 117) { self.err = 1; return; }
                    self.pos = self.pos + 2;
                    int lo = JParser_u4(self);
                    if (lo < 56320 || lo > 57343) { self.err = 1; return; }
                    cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                }
                JParser_utf8(out, cp);
            }
            else { self.err = 1; return; }          // not a JSON escape
        } else {
            String_push(out, (char)c);
            self.pos = self.pos + 1;
        }
    }
}

int JParser_is_digit(char c) {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

// Read a number per the JSON grammar: -? (0 | [1-9][0-9]*) (.[0-9]+)? ([eE][+-]?[0-9]+)?
double JParser_read_number(JParser* self) {
    int start = self.pos;
    if (self.src[self.pos] == 45) { self.pos = self.pos + 1; }
    if (self.src[self.pos] == 48) { self.pos = self.pos + 1; }
    else if (JParser_is_digit(self.src[self.pos]) == 1) {
        while (JParser_is_digit(self.src[self.pos]) == 1) { self.pos = self.pos + 1; }
    } else { self.err = 1; return 0.0; }
    if (self.src[self.pos] == 46) {
        self.pos = self.pos + 1;
        if (JParser_is_digit(self.src[self.pos]) == 0) { self.err = 1; return 0.0; }
        while (JParser_is_digit(self.src[self.pos]) == 1) { self.pos = self.pos + 1; }
    }
    if (self.src[self.pos] == 101 || self.src[self.pos] == 69) {
        self.pos = self.pos + 1;
        if (self.src[self.pos] == 43 || self.src[self.pos] == 45) { self.pos = self.pos + 1; }
        if (JParser_is_digit(self.src[self.pos]) == 0) { self.err = 1; return 0.0; }
        while (JParser_is_digit(self.src[self.pos]) == 1) { self.pos = self.pos + 1; }
    }
    let text: String;  String_init(&text, (int64)(self.pos - start + 1));
    int i = start;
    while (i < self.pos) { String_push(&text, self.src[i]); i = i + 1; }
    double d = atof((string)String_cstr(&text));
    String_free(&text);
    return d;
}

// Consume the exact literal `word` (true / false / null); sets err otherwise.
void JParser_word(JParser* self, string word) {
    int i = 0;
    while (word[i] != 0) {
        if (self.src[self.pos] != word[i]) { self.err = 1; return; }
        self.pos = self.pos + 1;
        i = i + 1;
    }
}

*JsonValue JParser_value(JParser* self);   // forward (mutual recursion)

// On error the partial container is returned with everything parsed so far
// linked in, so json_parse frees the whole tree.
*JsonValue JParser_array(JParser* self) {
    *JsonValue arr = JsonValue_new(JArray);
    self.pos = self.pos + 1;   // skip [
    JParser_ws(self);
    if (self.src[self.pos] == 93) { self.pos = self.pos + 1; return arr; }  // ]
    *JsonValue tail = (*JsonValue)0;
    while (1) {
        *JsonValue elem = JParser_value(self);
        if (elem != null) {
            if (arr.child == null) { arr.child = elem; } else { tail.next = elem; }
            tail = elem;
        }
        if (self.err == 1) { return arr; }
        JParser_ws(self);
        char c = self.src[self.pos];
        if (c == 44) { self.pos = self.pos + 1; }            // ,
        else if (c == 93) { self.pos = self.pos + 1; return arr; }  // ]
        else { self.err = 1; return arr; }
    }
    return arr;
}

*JsonValue JParser_object(JParser* self) {
    *JsonValue obj = JsonValue_new(JObject);
    self.pos = self.pos + 1;   // skip {
    JParser_ws(self);
    if (self.src[self.pos] == 125) { self.pos = self.pos + 1; return obj; }  // }
    *JsonValue tail = (*JsonValue)0;
    while (1) {
        JParser_ws(self);
        if (self.src[self.pos] != 34) { self.err = 1; return obj; }   // expect "
        let k: String;  String_init(&k, 8);
        JParser_read_string(self, &k);
        if (self.err == 1) { String_free(&k); return obj; }
        JParser_ws(self);
        if (self.src[self.pos] != 58) { self.err = 1; String_free(&k); return obj; }  // :
        self.pos = self.pos + 1;
        *JsonValue val = JParser_value(self);
        if (val == null) { String_free(&k); return obj; }
        val.key.data = k.data;  val.key.len = k.len;  val.key.cap = k.cap;  // move key in
        if (obj.child == null) { obj.child = val; } else { tail.next = val; }
        tail = val;
        if (self.err == 1) { return obj; }
        JParser_ws(self);
        char c = self.src[self.pos];
        if (c == 44) { self.pos = self.pos + 1; }            // ,
        else if (c == 125) { self.pos = self.pos + 1; return obj; }  // }
        else { self.err = 1; return obj; }
    }
    return obj;
}

*JsonValue JParser_value(JParser* self) {
    JParser_ws(self);
    char c = self.src[self.pos];
    if (c == 123) { return JParser_object(self); }   // {
    if (c == 91)  { return JParser_array(self); }    // [
    if (c == 34) {                                   // "
        *JsonValue v = JsonValue_new(JString);
        String_init(&v.str, 8);
        JParser_read_string(self, &v.str);
        return v;
    }
    if (c == 116) {   // true
        *JsonValue v = JsonValue_new(JBool); v.boolean = 1;
        JParser_word(self, "true");
        return v;
    }
    if (c == 102) {   // false
        *JsonValue v = JsonValue_new(JBool); v.boolean = 0;
        JParser_word(self, "false");
        return v;
    }
    if (c == 110) {   // null
        *JsonValue v = JsonValue_new(JNull);
        JParser_word(self, "null");
        return v;
    }
    if (c == 45 || (c >= 48 && c <= 57)) {           // - or digit
        *JsonValue v = JsonValue_new(JNumber);
        v.num = JParser_read_number(self);
        return v;
    }
    self.err = 1;
    return (*JsonValue)0;
}

// Parse `src` into a value tree. Returns null on malformed input (any partial
// tree is freed first). Free the result with JsonValue_free.
*JsonValue json_parse(string src) {
    let p: JParser;
    p.src = src;
    p.pos = 0;
    p.err = 0;
    *JsonValue v = JParser_value(&p);
    if (p.err == 0) {
        JParser_ws(&p);
        if (p.src[p.pos] != 0) { p.err = 1; }        // trailing garbage after the value
    }
    if (p.err == 1) {
        JsonValue_free(v);
        return (*JsonValue)0;
    }
    return v;
}
