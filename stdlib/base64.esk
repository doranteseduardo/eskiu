// base64.esk — standard Base64 (RFC 4648) encode/decode over byte buffers.
//
//   import <base64>;
//   *uint8 out = alloc<uint8>(base64_encoded_len(n) + 1);
//   int m = base64_encode(src, n, out);   // out[m] is left as a NUL terminator
//
// The caller owns the buffers. Use the *_len helpers to size them.

// 6-bit value of a Base64 character, or -1 if it is not a Base64 digit.
int base64_value(uint8 c) {
    if (c >= 'A' && c <= 'Z') { return (int)c - 'A'; }        // 0..25
    if (c >= 'a' && c <= 'z') { return (int)c - 'a' + 26; }   // 26..51
    if (c >= '0' && c <= '9') { return (int)c - '0' + 52; }   // 52..61
    if (c == '+') { return 62; }
    if (c == '/') { return 63; }
    return -1;
}

// The 'digit'-th Base64 character.
uint8 base64_digit(int v) {
    if (v < 26) { return (uint8)('A' + v); }
    if (v < 52) { return (uint8)('a' + v - 26); }
    if (v < 62) { return (uint8)('0' + v - 52); }
    return v == 62 ? '+' : '/';
}

// Encoded length (without the NUL) for `n` input bytes.
int base64_encoded_len(int n) {
    return ((n + 2) / 3) * 4;
}

// Worst-case decoded length for `n` input characters.
int base64_decoded_len(int n) {
    return (n / 4) * 3 + 3;
}

// Encode `n` bytes from src into out. Returns the number of characters written
// (out is also NUL-terminated at that index). out must hold
// base64_encoded_len(n) + 1 bytes.
int base64_encode(*uint8 src, int n, *uint8 out) {
    int i = 0;
    int o = 0;
    for (; i + 2 < n; i += 3) {
        const int b0 = (int)src[i];
        const int b1 = (int)src[i + 1];
        const int b2 = (int)src[i + 2];
        out[o]     = base64_digit(b0 >> 2);
        out[o + 1] = base64_digit(((b0 & 3) << 4) | (b1 >> 4));
        out[o + 2] = base64_digit(((b1 & 15) << 2) | (b2 >> 6));
        out[o + 3] = base64_digit(b2 & 63);
        o += 4;
    }
    const int rem = n - i;
    if (rem > 0) {
        // One or two bytes left: emit their digits, then '=' up to a full group.
        const int b0 = (int)src[i];
        const int b1 = rem == 2 ? (int)src[i + 1] : 0;
        out[o]     = base64_digit(b0 >> 2);
        out[o + 1] = base64_digit(((b0 & 3) << 4) | (b1 >> 4));
        out[o + 2] = rem == 2 ? base64_digit((b1 & 15) << 2) : '=';
        out[o + 3] = '=';
        o += 4;
    }
    out[o] = 0;
    return o;
}

// Decode `n` characters from src into out. Returns the number of bytes written,
// or -1 on malformed input: a non-Base64 character, '=' anywhere but the end
// (or more than two), a padded input that is not whole 4-character groups, or
// a length that cannot come from any byte string (one character left over, the
// sign of a truncated input). Unpadded input is accepted. Whitespace is ignored.
// out must hold base64_decoded_len(n) bytes.
int base64_decode(*uint8 src, int n, *uint8 out) {
    int acc  = 0;   // bit accumulator
    int bits = 0;   // bits currently in acc
    int o    = 0;
    int data = 0;   // Base64 digits seen
    int pad  = 0;   // '=' seen (only trailing padding is valid)
    for (i in 0..n) {
        const uint8 c = src[i];
        if (c == ' ' || c == '\n' || c == '\r' || c == '\t') { continue; }
        if (c == '=') { pad++; continue; }
        if (pad > 0) { return -1; }                                 // data after padding
        const int v = base64_value(c);
        if (v < 0) { return -1; }
        data++;
        acc  = ((acc << 6) | v) & 16777215;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            out[o++] = (uint8)((acc >> bits) & 255);
        }
    }
    if (data % 4 == 1) { return -1; }                               // truncated: a lone 6-bit digit
    if (pad > 2) { return -1; }
    if (pad > 0 && (data + pad) % 4 != 0) { return -1; }            // padding must complete the group
    return o;
}
