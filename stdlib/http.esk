// http.esk — a small HTTP/1.1 stack: request parser, response builder, and a
// threaded worker pool, built on <net> + <threading>.
//
//   import <http>;
//   void hello(HttpRequest* req, HttpResponse* res) {
//       HttpResponse_header(res, "Content-Type", "text/plain");
//       HttpResponse_set_body(res, "Hello from Eskiu\n");
//   }
//   int main() { http_serve(8080, 4, hello); return 0; }   // 4 worker threads

import <mem>;
import <string>;
import <net>;
import <threading>;
import <bytes>;

// ── Request (parsed) ─────────────────────────────────────────────────────────

struct HttpRequest {
    String method;    // "GET"
    String path;      // "/index.html"
    String version;   // "HTTP/1.1"
    String headers;   // raw block, one "Key: Value" per line (\n-separated)
    String body;
}

void HttpRequest_init(HttpRequest* self) {
    self.method.init(8);
    self.path.init(32);
    self.version.init(16);
    self.headers.init(128);
    self.body.init(64);
}

void HttpRequest_free(HttpRequest* self) {
    self.method.free();
    self.path.free();
    self.version.free();
    self.headers.free();
    self.body.free();
}

// 1 if buf[pos..pos+2) is a CRLF within the first `len` bytes.
int _http_crlf_at(*uint8 buf, int pos, int len) {
    return (pos + 1 < len && buf[pos] == '\r' && buf[pos + 1] == '\n') ? 1 : 0;
}

// 1 if `c` is a CR or LF byte (a line break may only appear as CRLF).
int _http_is_crlf_byte(uint8 c) {
    return (c == '\r' || c == '\n') ? 1 : 0;
}

// 1 if `c` is a token character (RFC 9110 §5.6.2 tchar): a header name or a
// method is one or more of these.
int _http_is_tchar(uint8 c) {
    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) { return 1; }
    switch (c) {
        case '!': case '#': case '$': case '%': case '&': case '\'': case '*': case '+':
        case '-': case '.': case '^': case '_': case '`': case '|': case '~':
            return 1;
    }
    return 0;
}

// The HTTP-version in b[from..to) ("HTTP/" DIGIT "." DIGIT, RFC 9112 §2.3) as
// major * 10 + minor, or -1 if it is not one.
int _http_parse_version(*uint8 b, int from, int to) {
    if (to - from != 8) { return -1; }
    if (b[from] != 'H' || b[from + 1] != 'T' || b[from + 2] != 'T' || b[from + 3] != 'P' || b[from + 4] != '/') { return -1; }
    const uint8 ma = b[from + 5];
    const uint8 mi = b[from + 7];
    if (ma < '0' || ma > '9' || b[from + 6] != '.' || mi < '0' || mi > '9') { return -1; }
    return ((int)ma - '0') * 10 + ((int)mi - '0');
}

// 1 if every line of a "Key: Value\n" block is a field line: a token name
// directly followed by ':'. Whitespace before the colon (RFC 9112 §5.1) and a
// line starting with SP/HTAB, an obsolete line fold (§5.2), are rejected.
int _http_headers_valid(String* headers) {
    const int64 n = headers.len;
    int64 i = 0;
    while (i < n) {
        int64 j = i;
        while (j < n && _http_is_tchar((uint8)headers.data[j]) == 1) { j++; }
        if (j == i || j >= n || headers.data[j] != ':') { return 0; }
        while (i < n && headers.data[i] != '\n') { i++; }
        i++;
    }
    return 1;
}

// Number of header lines named `name` (case-insensitive) in a "Key: Value\n" block.
int _http_header_count(String* headers, string name) {
    const int64 n = headers.len;
    int64 i = 0;
    int count = 0;
    while (i < n) {
        int64 j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || http_lc(headers.data[i + j]) != http_lc(name[j])) { matched = false; break; }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') { count++; }
        while (i < n && headers.data[i] != '\n') { i++; }
        i++;
    }
    return count;
}

// Transfer-Encoding of a request (RFC 9112 §6.1, §6.3): 0 if there is none, 1
// if it is exactly "chunked" (the only coding supported), 400 if chunked is not
// the final coding or appears twice (the length cannot be determined), 501 for
// any other coding. Every Transfer-Encoding line and list member counts.
int _http_transfer_encoding(String* headers) {
    const string name = "transfer-encoding";
    const int64 n = headers.len;
    int64 i = 0;
    int codings = 0;
    int chunked = 0;
    bool last_chunked = false;
    bool other = false;
    bool present = false;
    while (i < n) {
        int64 j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || http_lc(headers.data[i + j]) != http_lc(name[j])) { matched = false; break; }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            present = true;
            int64 k = i + j + 1;
            while (true) {
                let item: String;  item.init(16);
                while (k < n && (headers.data[k] == ' ' || headers.data[k] == '\t')) { k++; }
                for (; k < n && headers.data[k] != ',' && headers.data[k] != '\n'; k++) { item.push(http_lc(headers.data[k])); }
                http_trim_ows_tail(&item);
                if (item.len > 0) {
                    codings++;
                    last_chunked = String_eq_cstr(&item, "chunked") == 1;
                    if (last_chunked) { chunked++; } else { other = true; }
                }
                item.free();
                if (k >= n || headers.data[k] != ',') { break; }
                k++;
            }
        }
        while (i < n && headers.data[i] != '\n') { i++; }
        i++;
    }
    if (!present) { return 0; }
    if (codings == 0 || chunked > 1 || !last_chunked) { return 400; }
    if (other) { return 501; }
    return 1;
}

// Checks shared by both request parsers once the head is split into lines:
// the version (1.x, else 505), field-line syntax, a single Host (required in
// HTTP/1.1, RFC 9112 §3.2), and the framing headers. Returns 0 if the request
// has a Content-Length body or none, 1 if its body is chunked, or an error
// status (400 / 501 / 505).
int _http_check_head(String* headers, int version) {
    if (version / 10 != 1) { return 505; }
    if (_http_headers_valid(headers) == 0) { return 400; }
    const int hosts = _http_header_count(headers, "host");
    if (hosts > 1 || (hosts == 0 && version >= 11)) { return 400; }
    const int te = _http_transfer_encoding(headers);
    if (te == 0) { return 0; }
    // Transfer-Encoding with Content-Length is a smuggling vector (§6.3), and an
    // HTTP/1.0 message with Transfer-Encoding has faulty framing (§6.1).
    if (_http_header_count(headers, "content-length") > 0 || version < 11) { return 400; }
    return te;
}

int _http_hex_digit(uint8 c) {
    if (c >= '0' && c <= '9') { return (int)c - '0'; }
    if (c >= 'a' && c <= 'f') { return (int)c - 'a' + 10; }
    if (c >= 'A' && c <= 'F') { return (int)c - 'A' + 10; }
    return -1;
}

// Growable binary output of the chunked decoder (start zeroed; free `data`).
struct HttpChunkOut {
    *uint8 data;
    int64  len;
    int64  cap;
}

// Decode the complete chunks of a chunked body (RFC 9112 §7.1) in b[*pos..n),
// appending their data to `out` (at most `max` bytes in total). *pos advances
// past each complete chunk, so a caller that receives more input calls again
// with the same state. Returns 1 once the last chunk and the trailer section
// (discarded) are consumed, with *pos just past the body; 0 if more input is
// needed; -1 if the body is malformed; -2 if it exceeds `max`.
int http_chunked_step(*uint8 b, int64 n, *int64 pos, HttpChunkOut* out, int64 max) {
    int64 p = *pos;
    while (true) {
        int64 size = 0;
        int64 q = p;
        while (q < n && _http_hex_digit(b[q]) >= 0) {
            const int64 d = _http_hex_digit(b[q]);
            if (size > (9223372036854775807 - d) / 16) { return -1; }
            size = size * 16 + d;
            q++;
        }
        if (q >= n) { return 0; }
        if (q == p) { return -1; }
        // chunk-ext: BWS ";" ... up to the line end (extensions are ignored).
        int64 e = q;
        while (e < n && (b[e] == ' ' || b[e] == '\t')) { e++; }
        if (e >= n) { return 0; }
        if (b[e] == ';') {
            while (e < n && _http_is_crlf_byte(b[e]) == 0) { e++; }
            q = e;
        }
        if (q + 1 >= n) { return 0; }
        if (b[q] != '\r' || b[q + 1] != '\n') { return -1; }
        q += 2;
        if (size == 0) { p = q; break; }
        if (size > max - out.len) { return -2; }
        if (n - q < size + 2) {
            if (n - q > size && b[q + size] != '\r') { return -1; }
            return 0;
        }
        if (b[q + size] != '\r' || b[q + size + 1] != '\n') { return -1; }
        if (out.len + size > out.cap) {
            int64 nc = out.cap < 256 ? 256 : out.cap;
            while (nc < out.len + size) { nc *= 2; }
            *uint8 nd = alloc<uint8>(nc);
            if (out.len > 0) { memcpy(nd, out.data, out.len); }
            if (out.data != null) { free(out.data); }
            out.data = nd;
            out.cap = nc;
        }
        memcpy(out.data + out.len, b + q, size);
        out.len += size;
        p = q + size + 2;
        *pos = p;
    }
    // Trailer section: field lines up to a blank line.
    while (true) {
        if (p + 1 >= n) { return 0; }
        if (b[p] == '\r') {
            if (b[p + 1] != '\n') { return -1; }
            *pos = p + 2;
            return 1;
        }
        int64 q = p;
        while (q < n && _http_is_tchar(b[q]) == 1) { q++; }
        if (q >= n) { return 0; }
        if (q == p || b[q] != ':') { return -1; }
        while (q < n && _http_is_crlf_byte(b[q]) == 0) { q++; }
        if (q + 1 >= n) { return 0; }
        if (b[q] != '\r' || b[q + 1] != '\n') { return -1; }
        p = q + 2;
    }
    return -1;
}

// Parse a raw request from `buf` (len bytes). Returns 1 on success, 0 if the
// request is malformed or not acceptable: a method that is not a token, an
// empty path, a request line not ended by CRLF or without a valid
// HTTP-version, a bare CR or LF inside a header line (RFC 9112 §2.2: a line
// break is CRLF, and a lone LF must not start a new header line, which would
// let a client smuggle a header past a proxy that reads the line differently),
// a malformed field line (whitespace before the colon, an obsolete line fold),
// a missing or repeated Host in HTTP/1.1, or conflicting framing headers
// (Transfer-Encoding with Content-Length, a coding other than chunked). A
// chunked body is decoded; it must be complete in `buf`.
int HttpRequest_parse(HttpRequest* self, *uint8 buf, int len) {
    int pos = 0;
    for (; pos < len && _http_is_tchar(buf[pos]) == 1; pos++) { self.method.push((char)buf[pos]); }
    if (pos >= len || buf[pos] != ' ' || self.method.len == 0) { return 0; }
    pos++;
    for (; pos < len && buf[pos] != ' ' && _http_is_crlf_byte(buf[pos]) == 0; pos++) { self.path.push((char)buf[pos]); }
    if (pos >= len || buf[pos] != ' ' || self.path.len == 0) { return 0; }
    pos++;
    const int vstart = pos;
    for (; pos < len && _http_is_crlf_byte(buf[pos]) == 0; pos++) { self.version.push((char)buf[pos]); }
    const int version = _http_parse_version(buf, vstart, pos);
    if (version < 0) { return 0; }
    if (_http_crlf_at(buf, pos, len) == 0) { return 0; }
    pos += 2;

    // Header lines until the blank line; store as "Key: Value\n".
    while (pos < len) {
        if (_http_crlf_at(buf, pos, len) == 1) { pos += 2; break; }
        for (; pos < len && _http_is_crlf_byte(buf[pos]) == 0; pos++) { self.headers.push((char)buf[pos]); }
        self.headers.push('\n');
        if (pos >= len) { break; }                             // request cut short
        if (_http_crlf_at(buf, pos, len) == 0) { return 0; }   // a bare CR or LF
        pos += 2;
    }
    const int framing = _http_check_head(&self.headers, version);
    if (framing > 1) { return 0; }
    if (framing == 1) {
        let out: HttpChunkOut;
        out.data = null;  out.len = 0;  out.cap = 0;
        int64 bpos = pos;
        const int st = http_chunked_step(buf, len, &bpos, &out, len);
        if (st == 1) { for (i in 0..out.len) { self.body.push((char)out.data[i]); } }
        if (out.data != null) { free(out.data); }
        return st == 1 ? 1 : 0;
    }
    // Remaining bytes are the body.
    for (; pos < len; pos++) { self.body.push((char)buf[pos]); }
    return 1;
}

// Drop trailing optional whitespace (SP / HTAB, plus a stray CR) from a header
// value just copied into `out` (RFC 9110 §5.5: OWS around a field value is not
// part of it).
void http_trim_ows_tail(String* out) {
    while (out.len > 0) {
        const char c = out.data[out.len - 1];
        if (c != ' ' && c != '\t' && c != '\r') { return; }
        out.data[--out.len] = 0;
    }
}

char http_lc(char c) {
    return (c >= 'A' && c <= 'Z') ? (char)((int)c + 32) : c;
}

// Find header `name` (case-insensitive) in a "Key: Value\n" block and copy its
// value into `out` (cleared first) without surrounding whitespace. 1 = hit.
int _http_header_lookup(String* headers, string name, String* out) {
    out.clear();
    const int n = headers.len;
    int i = 0;
    while (i < n) {
        // Compare the line's key against `name`.
        int j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || http_lc(headers.data[i + j]) != http_lc(name[j])) { matched = false; break; }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            int k = i + j + 1;
            while (k < n && (headers.data[k] == ' ' || headers.data[k] == '\t')) { k++; }   // leading OWS
            for (; k < n && headers.data[k] != '\n'; k++) { out.push(headers.data[k]); }
            http_trim_ows_tail(out);
            return 1;
        }
        // Skip to the start of the next line.
        while (i < n && headers.data[i] != '\n') { i++; }
        i++;
    }
    return 0;
}

// Look up a header by name (case-insensitive). On success copies the value into
// `out` (cleared first), without surrounding whitespace, and returns 1;
// otherwise returns 0.
int HttpRequest_header(HttpRequest* self, string name, String* out) {
    return _http_header_lookup(&self.headers, name, out);
}

// ── Response (builder) ───────────────────────────────────────────────────────

struct HttpResponse {
    int    status;
    String headers;   // accumulated "Key: Value\r\n"
    String body;
}

void HttpResponse_init(HttpResponse* self, int status) {
    self.status = status;
    self.headers.init(128);
    self.body.init(128);
}

void HttpResponse_free(HttpResponse* self) {
    self.headers.free();
    self.body.free();
}

void HttpResponse_header(HttpResponse* self, string key, string val) {
    self.headers.append(key);
    self.headers.append(": ");
    self.headers.append(val);
    self.headers.append("\r\n");
}

void HttpResponse_set_body(HttpResponse* self, string s) {
    self.body.clear();
    self.body.append(s);
}

void HttpResponse_body_append(HttpResponse* self, string s) {
    self.body.append(s);
}

// Reason phrase for the common status codes; any other code gets the generic
// phrase of its class ("" outside 100..599).
string http_reason(int s) {
    switch (s) {
        case 200: return "OK";
        case 201: return "Created";
        case 204: return "No Content";
        case 206: return "Partial Content";
        case 301: return "Moved Permanently";
        case 302: return "Found";
        case 304: return "Not Modified";
        case 400: return "Bad Request";
        case 401: return "Unauthorized";
        case 403: return "Forbidden";
        case 404: return "Not Found";
        case 405: return "Method Not Allowed";
        case 409: return "Conflict";
        case 413: return "Payload Too Large";
        case 422: return "Unprocessable Entity";
        case 429: return "Too Many Requests";
        case 500: return "Internal Server Error";
        case 502: return "Bad Gateway";
        case 503: return "Service Unavailable";
        case 504: return "Gateway Timeout";
    }
    if (s >= 100 && s < 200) { return "Informational"; }
    if (s >= 200 && s < 300) { return "Success"; }
    if (s >= 300 && s < 400) { return "Redirection"; }
    if (s >= 400 && s < 500) { return "Client Error"; }
    if (s >= 500 && s < 600) { return "Server Error"; }
    return "";
}

// Append `v` in decimal to `out`. Takes int64 so a Content-Length above 2 GiB is
// written in full (String_from_int is int-only).
void _http_append_int(String* out, int64 v) {
    if (v < 0) { out.push('-'); }
    char[20] digits;
    int n = 0;
    uint64 u = v < 0 ? (uint64)0 - (uint64)v : (uint64)v;
    do {
        digits[n++] = (char)('0' + (int)(u % 10));
        u /= 10;
    } while (u != 0);
    while (n > 0) { out.push(digits[--n]); }
}

// Serialize the full HTTP/1.1 response (status line, headers, auto
// Content-Length, blank line, body) into `out`.
void HttpResponse_render(HttpResponse* self, String* out) {
    out.append("HTTP/1.1 ");
    _http_append_int(out, self.status);
    out.push(' ');
    out.append(http_reason(self.status));
    out.append("\r\n");
    out.append(self.headers.cstr());
    out.append("Content-Length: ");
    _http_append_int(out, self.body.len);
    out.append("\r\n\r\n");
    // All body.len bytes: the body may hold a NUL, which cstr() would cut at.
    for (i in 0..self.body.len) { out.push(self.body.data[i]); }
}

// ── Worker pool ──────────────────────────────────────────────────────────────

// A handler reads the request and fills the response.
//
// Accept-and-serve loop for one worker. Each connection is read, parsed, handed
// to `handler`, and answered. Runs forever.
void http_worker_loop(int fd, fn(HttpRequest*, HttpResponse*)->void handler) {
    *uint8 buf = alloc<uint8>(8192);
    defer free(buf);
    while (true) {
        const int c = net_accept(fd);
        if (c < 0) { continue; }
        const int64 n = net_recv(c, buf, 8192);
        if (n <= 0) { net_close(c); continue; }

        let req: HttpRequest;  req.init();
        let res: HttpResponse;  res.init(200);
        if (req.parse(buf, (int)n) == 1) { handler(&req, &res); }
        else { res.status = 400; }                  // malformed: the handler never sees it

        let out: String;  out.init(256);
        res.render(&out);
        net_send(c, out.cstr(), out.len);
        net_close(c);

        out.free();
        res.free();
        req.free();
    }
}

// Listen on `port` and serve with `nworkers` threads (the calling thread is one
// of them, so it blocks here). Returns immediately only if the bind fails.
void http_serve(int port, int nworkers, escaping fn(HttpRequest*, HttpResponse*)->void handler) {
    const int fd = net_tcp_listen((uint16)port);
    if (fd < 0) { return; }
    // Each worker's closure is written in the call, so its thread owns (and frees) it.
    for (int spawned = 1; spawned < nworkers; spawned++)
        thread_create(void() { http_worker_loop(fd, handler); });
    http_worker_loop(fd, handler);
}

// ── Binary-safe request (full body) ────────────────────────────────────────────
//
// HttpRequest above does a single 8 KB recv and stores the body as a String
// (signed char) — fine for small text requests, but it truncates large bodies
// and corrupts binary ones. HttpReq instead reads the *complete* request,
// looping recv until Content-Length bytes arrive, into a binary-safe `*uint8`
// body. Use it for uploads (images, arbitrary bytes).
//
//   let r: HttpReq;  HttpReq_init(&r);
//   int st = http_recv(fd, &r, 25 * 1024 * 1024);   // 0 ok, or an HTTP error code
//   // ... route on r.method / r.path, read r.body[0..r.body_len) ...
//   http_reply(fd, 200, "application/json", "", &someStringBody);
//   HttpReq_free(&r);

struct HttpReq {
    String method;
    String path;
    String headers;    // "Key: Value\n" lines (CRLF normalised to \n)
    *uint8 body;        // heap, binary-safe (NOT a String)
    int64  body_len;
}

void HttpReq_init(HttpReq* self) {
    self.method.init(8);
    self.path.init(32);
    self.headers.init(256);
    self.body     = null;
    self.body_len = 0;
}

void HttpReq_free(HttpReq* self) {
    self.method.free();
    self.path.free();
    self.headers.free();
    if (self.body != null) { free(self.body); self.body = null; }
}

// The request body as a non-owning, binary-safe Bytes view (no copy).
Bytes HttpReq_body(HttpReq* self) {
    let v: Bytes;
    v.data = self.body;
    v.len  = self.body_len;
    v.cap  = 0;
    return v;
}

// Index just past the "\r\n\r\n" header terminator in b[0..n), or -1.
int http_idx_header_end(*uint8 b, int n) {
    for (int i = 0; i + 3 < n; i++) {
        if (b[i] == '\r' && b[i + 1] == '\n' && b[i + 2] == '\r' && b[i + 3] == '\n') { return i + 4; }
    }
    return -1;
}

*uint8 http_buf_grow(*uint8 old, int used, int newcap) {
    *uint8 nb = alloc<uint8>(newcap);
    if (used > 0) { memcpy(nb, old, used); }
    free(old);
    return nb;
}

// Parse request line + headers from buf[0..hend) into r (`hend` is just past
// the blank line), storing the HTTP-version as major * 10 + minor in *version.
// Returns 1, or 0 if the head is malformed: a method that is not a token, an
// empty path, a missing or invalid HTTP-version, a line break that is not CRLF
// (a bare LF must not start a new header line, RFC 9112 §2.2), or a line that
// is not a field line (whitespace before the colon, an obsolete line fold).
int _http_parse_head_v(HttpReq* r, *uint8 buf, int hend, *int version) {
    int pos = 0;
    for (; pos < hend && _http_is_tchar(buf[pos]) == 1; pos++) { r.method.push((char)buf[pos]); }
    if (pos >= hend || buf[pos] != ' ' || r.method.len == 0) { return 0; }
    pos++;
    for (; pos < hend && buf[pos] != ' ' && _http_is_crlf_byte(buf[pos]) == 0; pos++) { r.path.push((char)buf[pos]); }
    if (pos >= hend || buf[pos] != ' ' || r.path.len == 0) { return 0; }
    pos++;
    const int vstart = pos;
    while (pos < hend && _http_is_crlf_byte(buf[pos]) == 0) { pos++; }
    *version = _http_parse_version(buf, vstart, pos);
    if (*version < 0) { return 0; }
    if (_http_crlf_at(buf, pos, hend) == 0) { return 0; }
    pos += 2;
    while (pos < hend && _http_crlf_at(buf, pos, hend) == 0) {
        for (; pos < hend && _http_is_crlf_byte(buf[pos]) == 0; pos++) { r.headers.push((char)buf[pos]); }
        r.headers.push('\n');
        if (_http_crlf_at(buf, pos, hend) == 0) { return 0; }   // a bare CR or LF
        pos += 2;
    }
    return _http_headers_valid(&r.headers);
}

// Parse request line + headers from buf[0..hend) into r; 1, or 0 if the head
// is malformed (see _http_parse_head_v).
int http_parse_head(HttpReq* r, *uint8 buf, int hend) {
    int version = 0;
    return _http_parse_head_v(r, buf, hend, &version);
}

// Case-insensitive header lookup; copies the value (without surrounding
// whitespace) into `out`. 1 = hit.
int HttpReq_header(HttpReq* r, string name, String* out) {
    return _http_header_lookup(&r.headers, name, out);
}

// Parse a Content-Length style value (1*DIGIT). Returns -1 if it is empty, has
// a non-digit, or does not fit in an int64 (it used to wrap: 2^64 read as 0).
int64 http_str_to_i64(String* s) {
    if (s.len == 0) { return -1; }
    int64 v = 0;
    for (i in 0..s.len) {
        const char c = s.data[i];
        if (c < '0' || c > '9') { return -1; }
        const int64 d = (int)c - '0';
        if (v > (9223372036854775807 - d) / 10) { return -1; }
        v = v * 10 + d;
    }
    return v;
}

// The request's Content-Length: -2 if there is none, -1 if it is invalid, else
// the length. Every Content-Length line counts, and a line may carry a
// comma-separated list; all the values must be the same number (RFC 9112 §6.3:
// differing lengths are unrecoverable, a request-smuggling vector).
int64 http_content_length(String* headers) {
    const string name = "content-length";
    int64 found = -2;
    const int64 n = headers.len;
    int64 i = 0;
    while (i < n) {
        int64 j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || http_lc(headers.data[i + j]) != http_lc(name[j])) { matched = false; break; }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            int64 k = i + j + 1;
            while (true) {
                let item: String;  item.init(16);
                while (k < n && (headers.data[k] == ' ' || headers.data[k] == '\t')) { k++; }
                for (; k < n && headers.data[k] != ',' && headers.data[k] != '\n'; k++) { item.push(headers.data[k]); }
                http_trim_ows_tail(&item);
                const int64 v = http_str_to_i64(&item);
                item.free();
                if (v < 0 || (found >= 0 && v != found)) { return -1; }
                found = v;
                if (k >= n || headers.data[k] != ',') { break; }
                k++;
            }
        }
        while (i < n && headers.data[i] != '\n') { i++; }
        i++;
    }
    return found;
}

// Read the rest of a chunked body: `have` bytes of it already arrived at
// `head`. Decodes into r.body; 0 on success, 400 if it is malformed or cut
// short, 413 if it decodes to more than `max_body` bytes.
int _http_recv_chunked(int fd, HttpReq* r, int64 max_body, *uint8 head, int have) {
    int64 cap = 8192;
    while (cap < (int64)have) { cap *= 2; }
    *uint8 raw = alloc<uint8>(cap);
    int64 n = have;
    if (have > 0) { memcpy(raw, head, have); }
    int64 pos = 0;
    let out: HttpChunkOut;
    out.data = null;  out.len = 0;  out.cap = 0;
    int status = 0;
    while (true) {
        const int st = http_chunked_step(raw, n, &pos, &out, max_body);
        if (st == 1) { break; }
        if (st < 0) { status = st == -2 ? 413 : 400; break; }
        // Drop the chunks already decoded; what is left is one partial chunk.
        if (pos > 0) { memmove(raw, raw + pos, n - pos); n -= pos; pos = 0; }
        if (n >= cap) {
            if (cap > max_body + 65536) { status = 413; break; }
            *uint8 nr = alloc<uint8>(cap * 2);
            memcpy(nr, raw, n);
            free(raw);
            raw = nr;
            cap *= 2;
        }
        const int64 got = net_recv(fd, raw + n, cap - n);
        if (got <= 0) { status = 400; break; }   // closed early: a truncated body
        n += got;
    }
    free(raw);
    if (status != 0 || out.len == 0) {
        if (out.data != null) { free(out.data); }
        r.body = null;  r.body_len = 0;
        return status;
    }
    r.body     = out.data;
    r.body_len = out.len;
    return 0;
}

// Read a complete request from `fd`. Returns 0 on success, or an HTTP error
// status on failure: 400 malformed (including a missing Host in HTTP/1.1,
// Transfer-Encoding together with Content-Length, whitespace before a header
// colon, an obsolete line fold), 413 too large, 501 a transfer coding other than
// chunked, 505 an HTTP major version other than 1. A chunked body is decoded
// (trailers are discarded). A peer that closes before the whole body arrives
// gets 400 (never a short body reported as success).
int http_recv(int fd, HttpReq* r, int64 max_body) {
    int cap = 8192;
    *uint8 buf = alloc<uint8>(cap);
    defer free(buf);
    int n = 0;
    int hend = -1;
    while (hend < 0) {
        if (n >= cap) { cap *= 2; buf = http_buf_grow(buf, n, cap); }
        const int64 got = net_recv(fd, buf + n, cap - n);
        if (got <= 0) { return 400; }
        n += (int)got;
        hend = http_idx_header_end(buf, n);
        if (hend < 0 && n > 65536) { return 400; }
    }
    int version = 0;
    if (_http_parse_head_v(r, buf, hend, &version) == 0) { return 400; }
    const int framing = _http_check_head(&r.headers, version);
    if (framing > 1) { return framing; }
    if (framing == 1) { return _http_recv_chunked(fd, r, max_body, buf + hend, n - hend); }

    int64 clen = http_content_length(&r.headers);
    if (clen == -1) { return 400; }           // malformed / overflowing / conflicting Content-Length
    if (clen < 0) { clen = 0; }               // none: no body
    if (clen > max_body) { return 413; }

    const int have = n - hend;
    if (clen <= 0) { r.body = null; r.body_len = 0; return 0; }

    // The header read may already hold the start of the body; the rest follows.
    *uint8 body = alloc<uint8>(clen);
    const int64 copy0 = (int64)have > clen ? clen : (int64)have;   // clamp in int64: clen may exceed INT_MAX
    if (copy0 > 0) { memcpy(body, buf + hend, copy0); }

    int64 bgot = copy0;
    while (bgot < clen) {
        const int64 got = net_recv(fd, body + bgot, clen - bgot);
        if (got <= 0) { free(body); return 400; }       // closed early: a truncated body
        bgot += got;
    }
    r.body     = body;
    r.body_len = bgot;
    return 0;
}

// Send a full HTTP/1.1 response. `extra` is pre-formatted "K: V\r\n" lines (may
// be empty). `body` is sent verbatim (its String length is honoured, so it may
// hold bytes a NUL would otherwise cut short). A null `body` sends an empty body.
void http_reply(int fd, int status, string ctype, string extra, String* body) {
    const int64 blen = body == null ? 0 : body.len;
    let out: String;
    out.init(blen + 256);
    defer out.free();
    out.append("HTTP/1.1 ");
    _http_append_int(&out, status);
    out.push(' ');
    out.append(http_reason(status));
    out.append("\r\nContent-Type: ");
    out.append(ctype);
    out.append("\r\n");
    out.append(extra);
    out.append("Content-Length: ");
    _http_append_int(&out, blen);
    out.append("\r\nConnection: close\r\n\r\n");
    net_send(fd, out.cstr(), out.len);
    if (blen > 0) { net_send(fd, body.data, blen); }
}

// Append `s` to `out` as the body of a JSON string: `"` and backslash escaped,
// control bytes as \n \r \t or \u00XX.
void http_json_escape(String* out, string s) {
    for (int i = 0; s[i] != 0; i++) {
        const char c = s[i];
        const int u = (int)(uint8)c;
        if (c == '"' || c == '\\') { out.push('\\'); out.push(c); }
        else if (c == '\n') { out.append("\\n"); }
        else if (c == '\r') { out.append("\\r"); }
        else if (c == '\t') { out.append("\\t"); }
        else if (u < 32) {
            out.append("\\u00");
            out.push("0123456789abcdef"[u >> 4]);
            out.push("0123456789abcdef"[u & 15]);
        }
        else { out.push(c); }
    }
}

// Convenience: reply with a small JSON error {"error":"..."} (msg is escaped).
void http_reply_error(int fd, int status, string extra, string msg) {
    let b: String;
    b.init(64);
    defer b.free();
    b.append("{\"error\":\"");
    http_json_escape(&b, msg);
    b.append("\"}");
    http_reply(fd, status, "application/json", extra, &b);
}
