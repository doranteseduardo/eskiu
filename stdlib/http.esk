// http.esk — a small HTTP/1.1 stack: request parser, response builder, and a
// threaded worker pool, built on <net> + <threading>.
//
//   import <http>;
//   void hello(HttpRequest* req, HttpResponse* res) {
//       HttpResponse_header(res, "Content-Type", "text/plain");
//       HttpResponse_set_body(res, "Hello from Eskiu\n");
//   }
//   int main() { http_serve(8080, 4, hello); return 0; }   // 4 worker threads

import <mem>;
import <string>;
import <net>;
import <threading>;
import <bytes>;

// ── Request (parsed) ─────────────────────────────────────────────────────────

struct HttpRequest {
    String method;    // "GET"
    String path;      // "/index.html"
    String version;   // "HTTP/1.1"
    String headers;   // raw block, one "Key: Value" per line (\n-separated)
    String body;
}

void HttpRequest_init(HttpRequest* self) {
    self.method.init(8);
    self.path.init(32);
    self.version.init(16);
    self.headers.init(128);
    self.body.init(64);
}

void HttpRequest_free(HttpRequest* self) {
    self.method.free();
    self.path.free();
    self.version.free();
    self.headers.free();
    self.body.free();
}

// 1 if buf[pos..pos+2) is a CRLF within the first `len` bytes.
int _http_crlf_at(*uint8 buf, int pos, int len) {
    return (pos + 1 < len && buf[pos] == '\r' && buf[pos + 1] == '\n') ? 1 : 0;
}

// 1 if `c` is a CR or LF byte (a line break may only appear as CRLF).
int _http_is_crlf_byte(uint8 c) {
    return (c == '\r' || c == '\n') ? 1 : 0;
}

// Parse a raw request from `buf` (len bytes). Returns 1 on success, 0 if the
// request is malformed: an empty method or path, a request line not ended by
// CRLF, or a bare CR or LF inside a header line (RFC 9112 §2.2: a line break is
// CRLF, and a lone LF must not start a new header line, which would let a
// client smuggle a header past a proxy that reads the line differently).
int HttpRequest_parse(HttpRequest* self, *uint8 buf, int len) {
    int pos = 0;
    for (; pos < len && buf[pos] != ' ' && _http_is_crlf_byte(buf[pos]) == 0; pos++) { self.method.push((char)buf[pos]); }
    if (pos >= len || buf[pos] != ' ' || self.method.len == 0) { return 0; }
    pos++;
    for (; pos < len && buf[pos] != ' ' && _http_is_crlf_byte(buf[pos]) == 0; pos++) { self.path.push((char)buf[pos]); }
    if (pos >= len || buf[pos] != ' ' || self.path.len == 0) { return 0; }
    pos++;
    for (; pos < len && _http_is_crlf_byte(buf[pos]) == 0; pos++) { self.version.push((char)buf[pos]); }
    if (_http_crlf_at(buf, pos, len) == 0) { return 0; }
    pos += 2;

    // Header lines until the blank line; store as "Key: Value\n".
    while (pos < len) {
        if (_http_crlf_at(buf, pos, len) == 1) { pos += 2; break; }
        for (; pos < len && _http_is_crlf_byte(buf[pos]) == 0; pos++) { self.headers.push((char)buf[pos]); }
        self.headers.push('\n');
        if (pos >= len) { break; }                             // request cut short
        if (_http_crlf_at(buf, pos, len) == 0) { return 0; }   // a bare CR or LF
        pos += 2;
    }
    // Remaining bytes are the body.
    for (; pos < len; pos++) { self.body.push((char)buf[pos]); }
    return 1;
}

// Drop trailing optional whitespace (SP / HTAB, plus a stray CR) from a header
// value just copied into `out` (RFC 9110 §5.5: OWS around a field value is not
// part of it).
void http_trim_ows_tail(String* out) {
    while (out.len > 0) {
        const char c = out.data[out.len - 1];
        if (c != ' ' && c != '\t' && c != '\r') { return; }
        out.data[--out.len] = 0;
    }
}

char http_lc(char c) {
    return (c >= 'A' && c <= 'Z') ? (char)((int)c + 32) : c;
}

// Find header `name` (case-insensitive) in a "Key: Value\n" block and copy its
// value into `out` (cleared first) without surrounding whitespace. 1 = hit.
int _http_header_lookup(String* headers, string name, String* out) {
    out.clear();
    const int n = headers.len;
    int i = 0;
    while (i < n) {
        // Compare the line's key against `name`.
        int j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || http_lc(headers.data[i + j]) != http_lc(name[j])) { matched = false; break; }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            int k = i + j + 1;
            while (k < n && (headers.data[k] == ' ' || headers.data[k] == '\t')) { k++; }   // leading OWS
            for (; k < n && headers.data[k] != '\n'; k++) { out.push(headers.data[k]); }
            http_trim_ows_tail(out);
            return 1;
        }
        // Skip to the start of the next line.
        while (i < n && headers.data[i] != '\n') { i++; }
        i++;
    }
    return 0;
}

// Look up a header by name (case-insensitive). On success copies the value into
// `out` (cleared first), without surrounding whitespace, and returns 1;
// otherwise returns 0.
int HttpRequest_header(HttpRequest* self, string name, String* out) {
    return _http_header_lookup(&self.headers, name, out);
}

// ── Response (builder) ───────────────────────────────────────────────────────

struct HttpResponse {
    int    status;
    String headers;   // accumulated "Key: Value\r\n"
    String body;
}

void HttpResponse_init(HttpResponse* self, int status) {
    self.status = status;
    self.headers.init(128);
    self.body.init(128);
}

void HttpResponse_free(HttpResponse* self) {
    self.headers.free();
    self.body.free();
}

void HttpResponse_header(HttpResponse* self, string key, string val) {
    self.headers.append(key);
    self.headers.append(": ");
    self.headers.append(val);
    self.headers.append("\r\n");
}

void HttpResponse_set_body(HttpResponse* self, string s) {
    self.body.clear();
    self.body.append(s);
}

void HttpResponse_body_append(HttpResponse* self, string s) {
    self.body.append(s);
}

// Reason phrase for the common status codes; any other code gets the generic
// phrase of its class ("" outside 100..599).
string http_reason(int s) {
    switch (s) {
        case 200: return "OK";
        case 201: return "Created";
        case 204: return "No Content";
        case 206: return "Partial Content";
        case 301: return "Moved Permanently";
        case 302: return "Found";
        case 304: return "Not Modified";
        case 400: return "Bad Request";
        case 401: return "Unauthorized";
        case 403: return "Forbidden";
        case 404: return "Not Found";
        case 405: return "Method Not Allowed";
        case 409: return "Conflict";
        case 413: return "Payload Too Large";
        case 422: return "Unprocessable Entity";
        case 429: return "Too Many Requests";
        case 500: return "Internal Server Error";
        case 502: return "Bad Gateway";
        case 503: return "Service Unavailable";
        case 504: return "Gateway Timeout";
    }
    if (s >= 100 && s < 200) { return "Informational"; }
    if (s >= 200 && s < 300) { return "Success"; }
    if (s >= 300 && s < 400) { return "Redirection"; }
    if (s >= 400 && s < 500) { return "Client Error"; }
    if (s >= 500 && s < 600) { return "Server Error"; }
    return "";
}

// Append `v` in decimal to `out`. Takes int64 so a Content-Length above 2 GiB is
// written in full (String_from_int is int-only).
void _http_append_int(String* out, int64 v) {
    if (v < 0) { out.push('-'); }
    char[20] digits;
    int n = 0;
    uint64 u = v < 0 ? (uint64)0 - (uint64)v : (uint64)v;
    do {
        digits[n++] = (char)('0' + (int)(u % 10));
        u /= 10;
    } while (u != 0);
    while (n > 0) { out.push(digits[--n]); }
}

// Serialize the full HTTP/1.1 response (status line, headers, auto
// Content-Length, blank line, body) into `out`.
void HttpResponse_render(HttpResponse* self, String* out) {
    out.append("HTTP/1.1 ");
    _http_append_int(out, self.status);
    out.push(' ');
    out.append(http_reason(self.status));
    out.append("\r\n");
    out.append(self.headers.cstr());
    out.append("Content-Length: ");
    _http_append_int(out, self.body.len);
    out.append("\r\n\r\n");
    // All body.len bytes: the body may hold a NUL, which cstr() would cut at.
    for (i in 0..self.body.len) { out.push(self.body.data[i]); }
}

// ── Worker pool ──────────────────────────────────────────────────────────────

// A handler reads the request and fills the response.
//
// Accept-and-serve loop for one worker. Each connection is read, parsed, handed
// to `handler`, and answered. Runs forever.
void http_worker_loop(int fd, fn(HttpRequest*, HttpResponse*)->void handler) {
    *uint8 buf = alloc<uint8>(8192);
    defer free(buf);
    while (true) {
        const int c = net_accept(fd);
        if (c < 0) { continue; }
        const int64 n = net_recv(c, buf, 8192);
        if (n <= 0) { net_close(c); continue; }

        let req: HttpRequest;  req.init();
        let res: HttpResponse;  res.init(200);
        if (req.parse(buf, (int)n) == 1) { handler(&req, &res); }
        else { res.status = 400; }                  // malformed: the handler never sees it

        let out: String;  out.init(256);
        res.render(&out);
        net_send(c, out.cstr(), out.len);
        net_close(c);

        out.free();
        res.free();
        req.free();
    }
}

// Listen on `port` and serve with `nworkers` threads (the calling thread is one
// of them, so it blocks here). Returns immediately only if the bind fails.
void http_serve(int port, int nworkers, escaping fn(HttpRequest*, HttpResponse*)->void handler) {
    const int fd = net_tcp_listen((uint16)port);
    if (fd < 0) { return; }
    // Each worker's closure is written in the call, so its thread owns (and frees) it.
    for (int spawned = 1; spawned < nworkers; spawned++)
        thread_create(void() { http_worker_loop(fd, handler); });
    http_worker_loop(fd, handler);
}

// ── Binary-safe request (full body) ────────────────────────────────────────────
//
// HttpRequest above does a single 8 KB recv and stores the body as a String
// (signed char) — fine for small text requests, but it truncates large bodies
// and corrupts binary ones. HttpReq instead reads the *complete* request,
// looping recv until Content-Length bytes arrive, into a binary-safe `*uint8`
// body. Use it for uploads (images, arbitrary bytes).
//
//   let r: HttpReq;  HttpReq_init(&r);
//   int st = http_recv(fd, &r, 25 * 1024 * 1024);   // 0 ok, or an HTTP error code
//   // ... route on r.method / r.path, read r.body[0..r.body_len) ...
//   http_reply(fd, 200, "application/json", "", &someStringBody);
//   HttpReq_free(&r);

struct HttpReq {
    String method;
    String path;
    String headers;    // "Key: Value\n" lines (CRLF normalised to \n)
    *uint8 body;        // heap, binary-safe (NOT a String)
    int64  body_len;
}

void HttpReq_init(HttpReq* self) {
    self.method.init(8);
    self.path.init(32);
    self.headers.init(256);
    self.body     = null;
    self.body_len = 0;
}

void HttpReq_free(HttpReq* self) {
    self.method.free();
    self.path.free();
    self.headers.free();
    if (self.body != null) { free(self.body); self.body = null; }
}

// The request body as a non-owning, binary-safe Bytes view (no copy).
Bytes HttpReq_body(HttpReq* self) {
    let v: Bytes;
    v.data = self.body;
    v.len  = self.body_len;
    v.cap  = 0;
    return v;
}

// Index just past the "\r\n\r\n" header terminator in b[0..n), or -1.
int http_idx_header_end(*uint8 b, int n) {
    for (int i = 0; i + 3 < n; i++) {
        if (b[i] == '\r' && b[i + 1] == '\n' && b[i + 2] == '\r' && b[i + 3] == '\n') { return i + 4; }
    }
    return -1;
}

*uint8 http_buf_grow(*uint8 old, int used, int newcap) {
    *uint8 nb = alloc<uint8>(newcap);
    if (used > 0) { memcpy(nb, old, used); }
    free(old);
    return nb;
}

// Parse request line + headers from buf[0..hend) into r (`hend` is just past
// the blank line). Returns 1, or 0 if the head is malformed: an empty method or
// path, or a line break that is not CRLF (a bare LF must not start a new header
// line, RFC 9112 §2.2).
int http_parse_head(HttpReq* r, *uint8 buf, int hend) {
    int pos = 0;
    for (; pos < hend && buf[pos] != ' ' && _http_is_crlf_byte(buf[pos]) == 0; pos++) { r.method.push((char)buf[pos]); }
    if (pos >= hend || buf[pos] != ' ' || r.method.len == 0) { return 0; }
    pos++;
    for (; pos < hend && buf[pos] != ' ' && _http_is_crlf_byte(buf[pos]) == 0; pos++) { r.path.push((char)buf[pos]); }
    if (r.path.len == 0) { return 0; }
    while (pos < hend && _http_is_crlf_byte(buf[pos]) == 0) { pos++; }   // the version
    if (_http_crlf_at(buf, pos, hend) == 0) { return 0; }
    pos += 2;
    while (pos < hend && _http_crlf_at(buf, pos, hend) == 0) {
        for (; pos < hend && _http_is_crlf_byte(buf[pos]) == 0; pos++) { r.headers.push((char)buf[pos]); }
        r.headers.push('\n');
        if (_http_crlf_at(buf, pos, hend) == 0) { return 0; }   // a bare CR or LF
        pos += 2;
    }
    return 1;
}

// Case-insensitive header lookup; copies the value (without surrounding
// whitespace) into `out`. 1 = hit.
int HttpReq_header(HttpReq* r, string name, String* out) {
    return _http_header_lookup(&r.headers, name, out);
}

// Parse a Content-Length style value (1*DIGIT). Returns -1 if it is empty, has
// a non-digit, or does not fit in an int64 (it used to wrap: 2^64 read as 0).
int64 http_str_to_i64(String* s) {
    if (s.len == 0) { return -1; }
    int64 v = 0;
    for (i in 0..s.len) {
        const char c = s.data[i];
        if (c < '0' || c > '9') { return -1; }
        const int64 d = (int)c - '0';
        if (v > (9223372036854775807 - d) / 10) { return -1; }
        v = v * 10 + d;
    }
    return v;
}

// The request's Content-Length: -2 if there is none, -1 if it is invalid, else
// the length. Every Content-Length line counts, and a line may carry a
// comma-separated list; all the values must be the same number (RFC 9112 §6.3:
// differing lengths are unrecoverable, a request-smuggling vector).
int64 http_content_length(String* headers) {
    const string name = "content-length";
    int64 found = -2;
    const int64 n = headers.len;
    int64 i = 0;
    while (i < n) {
        int64 j = 0;
        bool matched = true;
        for (; name[j] != 0; j++) {
            if (i + j >= n || http_lc(headers.data[i + j]) != http_lc(name[j])) { matched = false; break; }
        }
        if (matched && i + j < n && headers.data[i + j] == ':') {
            int64 k = i + j + 1;
            while (true) {
                let item: String;  item.init(16);
                while (k < n && (headers.data[k] == ' ' || headers.data[k] == '\t')) { k++; }
                for (; k < n && headers.data[k] != ',' && headers.data[k] != '\n'; k++) { item.push(headers.data[k]); }
                http_trim_ows_tail(&item);
                const int64 v = http_str_to_i64(&item);
                item.free();
                if (v < 0 || (found >= 0 && v != found)) { return -1; }
                found = v;
                if (k >= n || headers.data[k] != ',') { break; }
                k++;
            }
        }
        while (i < n && headers.data[i] != '\n') { i++; }
        i++;
    }
    return found;
}

// Read a complete request from `fd`. Returns 0 on success, or an HTTP error
// status (400 malformed / 413 too large) on failure. A peer that closes before
// the whole Content-Length body arrives gets 400 (never a short body reported
// as success).
int http_recv(int fd, HttpReq* r, int64 max_body) {
    int cap = 8192;
    *uint8 buf = alloc<uint8>(cap);
    defer free(buf);
    int n = 0;
    int hend = -1;
    while (hend < 0) {
        if (n >= cap) { cap *= 2; buf = http_buf_grow(buf, n, cap); }
        const int64 got = net_recv(fd, buf + n, cap - n);
        if (got <= 0) { return 400; }
        n += (int)got;
        hend = http_idx_header_end(buf, n);
        if (hend < 0 && n > 65536) { return 400; }
    }
    if (http_parse_head(r, buf, hend) == 0) { return 400; }

    int64 clen = http_content_length(&r.headers);
    if (clen == -1) { return 400; }           // malformed / overflowing / conflicting Content-Length
    if (clen < 0) { clen = 0; }               // none: no body
    if (clen > max_body) { return 413; }

    const int have = n - hend;
    if (clen <= 0) { r.body = null; r.body_len = 0; return 0; }

    // The header read may already hold the start of the body; the rest follows.
    *uint8 body = alloc<uint8>(clen);
    const int64 copy0 = (int64)have > clen ? clen : (int64)have;   // clamp in int64: clen may exceed INT_MAX
    if (copy0 > 0) { memcpy(body, buf + hend, copy0); }

    int64 bgot = copy0;
    while (bgot < clen) {
        const int64 got = net_recv(fd, body + bgot, clen - bgot);
        if (got <= 0) { free(body); return 400; }       // closed early: a truncated body
        bgot += got;
    }
    r.body     = body;
    r.body_len = bgot;
    return 0;
}

// Send a full HTTP/1.1 response. `extra` is pre-formatted "K: V\r\n" lines (may
// be empty). `body` is sent verbatim (its String length is honoured, so it may
// hold bytes a NUL would otherwise cut short).
void http_reply(int fd, int status, string ctype, string extra, String* body) {
    let out: String;
    out.init(body.len + 256);
    defer out.free();
    out.append("HTTP/1.1 ");
    _http_append_int(&out, status);
    out.push(' ');
    out.append(http_reason(status));
    out.append("\r\nContent-Type: ");
    out.append(ctype);
    out.append("\r\n");
    out.append(extra);
    out.append("Content-Length: ");
    _http_append_int(&out, body.len);
    out.append("\r\nConnection: close\r\n\r\n");
    net_send(fd, out.cstr(), out.len);
    if (body.len > 0) { net_send(fd, body.data, body.len); }
}

// Append `s` to `out` as the body of a JSON string: `"` and backslash escaped,
// control bytes as \n \r \t or \u00XX.
void http_json_escape(String* out, string s) {
    for (int i = 0; s[i] != 0; i++) {
        const char c = s[i];
        const int u = (int)(uint8)c;
        if (c == '"' || c == '\\') { out.push('\\'); out.push(c); }
        else if (c == '\n') { out.append("\\n"); }
        else if (c == '\r') { out.append("\\r"); }
        else if (c == '\t') { out.append("\\t"); }
        else if (u < 32) {
            out.append("\\u00");
            out.push("0123456789abcdef"[u >> 4]);
            out.push("0123456789abcdef"[u & 15]);
        }
        else { out.push(c); }
    }
}

// Convenience: reply with a small JSON error {"error":"..."} (msg is escaped).
void http_reply_error(int fd, int status, string extra, string msg) {
    let b: String;
    b.init(64);
    defer b.free();
    b.append("{\"error\":\"");
    http_json_escape(&b, msg);
    b.append("\"}");
    http_reply(fd, status, "application/json", extra, &b);
}
