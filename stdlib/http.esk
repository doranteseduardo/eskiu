// http.esk — a small HTTP/1.1 stack: request parser, response builder, and a
// threaded worker pool, built on <net> + <threading>.
//
//   import <http>;
//   void hello(HttpRequest* req, HttpResponse* res) {
//       HttpResponse_header(res, "Content-Type", "text/plain");
//       HttpResponse_set_body(res, "Hello from Eskiu\n");
//   }
//   int main() { http_serve(8080, 4, hello); return 0; }   // 4 worker threads

import <mem>;
import <string>;
import <net>;
import <threading>;
import <bytes>;

// ── Request (parsed) ─────────────────────────────────────────────────────────

struct HttpRequest {
    String method;    // "GET"
    String path;      // "/index.html"
    String version;   // "HTTP/1.1"
    String headers;   // raw block, one "Key: Value" per line (\n-separated)
    String body;
}

void HttpRequest_init(HttpRequest* self) {
    String_init(&self.method, 8);
    String_init(&self.path, 32);
    String_init(&self.version, 16);
    String_init(&self.headers, 128);
    String_init(&self.body, 64);
}

void HttpRequest_free(HttpRequest* self) {
    String_free(&self.method);
    String_free(&self.path);
    String_free(&self.version);
    String_free(&self.headers);
    String_free(&self.body);
}

// Parse a raw request from `buf` (len bytes). Returns 1 on success, 0 if the
// request line is malformed.
int HttpRequest_parse(HttpRequest* self, *uint8 buf, int len) {
    int pos = 0;
    while (pos < len && buf[pos] != 32 && buf[pos] != 13) {
        String_push(&self.method, (char)buf[pos]); pos = pos + 1;
    }
    if (pos >= len || buf[pos] != 32) { return 0; }
    pos = pos + 1;
    while (pos < len && buf[pos] != 32) {
        String_push(&self.path, (char)buf[pos]); pos = pos + 1;
    }
    if (pos >= len) { return 0; }
    pos = pos + 1;
    while (pos < len && buf[pos] != 13) {
        String_push(&self.version, (char)buf[pos]); pos = pos + 1;
    }
    if (pos + 1 < len && buf[pos] == 13 && buf[pos + 1] == 10) { pos = pos + 2; }
    else { return 0; }

    // Header lines until the blank line; store as "Key: Value\n".
    while (pos < len) {
        if (pos + 1 < len && buf[pos] == 13 && buf[pos + 1] == 10) { pos = pos + 2; break; }
        while (pos < len && buf[pos] != 13) {
            String_push(&self.headers, (char)buf[pos]); pos = pos + 1;
        }
        String_push(&self.headers, '\n');
        if (pos + 1 < len && buf[pos] == 13 && buf[pos + 1] == 10) { pos = pos + 2; }
        else { break; }
    }
    // Remaining bytes are the body.
    while (pos < len) { String_push(&self.body, (char)buf[pos]); pos = pos + 1; }
    return 1;
}

// Look up a header by name (case-insensitive). On success copies the value into
// `out` (cleared first) and returns 1; otherwise returns 0.
int HttpRequest_header(HttpRequest* self, string name, String* out) {
    String_clear(out);
    int n = (int)self.headers.len;
    int i = 0;
    while (i < n) {
        int j = 0;
        int matched = 1;
        while (name[j] != 0) {
            if (i + j >= n) { matched = 0; }
            if (matched == 1) {
                char a = self.headers.data[i + j];
                char b = name[j];
                if (a >= 65 && a <= 90) { a = (char)((int)a + 32); }
                if (b >= 65 && b <= 90) { b = (char)((int)b + 32); }
                if (a != b) { matched = 0; }
            }
            j = j + 1;
        }
        if (matched == 1 && i + j < n && self.headers.data[i + j] == 58) {  // ':'
            int k = i + j + 1;
            while (k < n && self.headers.data[k] == 32) { k = k + 1; }       // skip spaces
            while (k < n && self.headers.data[k] != 10) {
                String_push(out, self.headers.data[k]); k = k + 1;
            }
            return 1;
        }
        while (i < n && self.headers.data[i] != 10) { i = i + 1; }
        i = i + 1;
    }
    return 0;
}

// ── Response (builder) ───────────────────────────────────────────────────────

struct HttpResponse {
    int    status;
    String headers;   // accumulated "Key: Value\r\n"
    String body;
}

void HttpResponse_init(HttpResponse* self, int status) {
    self.status = status;
    String_init(&self.headers, 128);
    String_init(&self.body, 128);
}

void HttpResponse_free(HttpResponse* self) {
    String_free(&self.headers);
    String_free(&self.body);
}

void HttpResponse_header(HttpResponse* self, string key, string val) {
    String_append(&self.headers, key);
    String_append(&self.headers, ": ");
    String_append(&self.headers, val);
    String_append(&self.headers, "\r\n");
}

void HttpResponse_set_body(HttpResponse* self, string s) {
    String_clear(&self.body);
    String_append(&self.body, s);
}

void HttpResponse_body_append(HttpResponse* self, string s) {
    String_append(&self.body, s);
}

// Reason phrase for the common status codes.
string http_reason(int s) {
    if (s == 200) { return "OK"; }
    if (s == 201) { return "Created"; }
    if (s == 204) { return "No Content"; }
    if (s == 301) { return "Moved Permanently"; }
    if (s == 302) { return "Found"; }
    if (s == 400) { return "Bad Request"; }
    if (s == 401) { return "Unauthorized"; }
    if (s == 403) { return "Forbidden"; }
    if (s == 404) { return "Not Found"; }
    if (s == 405) { return "Method Not Allowed"; }
    if (s == 413) { return "Payload Too Large"; }
    if (s == 422) { return "Unprocessable Entity"; }
    if (s == 429) { return "Too Many Requests"; }
    if (s == 500) { return "Internal Server Error"; }
    if (s == 503) { return "Service Unavailable"; }
    return "OK";
}

// Serialize the full HTTP/1.1 response (status line, headers, auto
// Content-Length, blank line, body) into `out`.
void HttpResponse_render(HttpResponse* self, String* out) {
    String_append(out, "HTTP/1.1 ");
    let st: String;  String_init(&st, 8);
    String_from_int(&st, self.status);
    String_append(out, String_cstr(&st));
    String_free(&st);
    String_push(out, ' ');
    String_append(out, http_reason(self.status));
    String_append(out, "\r\n");
    String_append(out, String_cstr(&self.headers));
    String_append(out, "Content-Length: ");
    let cl: String;  String_init(&cl, 16);
    String_from_int(&cl, (int)self.body.len);
    String_append(out, String_cstr(&cl));
    String_free(&cl);
    String_append(out, "\r\n\r\n");
    String_append(out, String_cstr(&self.body));
}

// ── Worker pool ──────────────────────────────────────────────────────────────

// A handler reads the request and fills the response.
//
// Accept-and-serve loop for one worker. Each connection is read, parsed, handed
// to `handler`, and answered. Runs forever.
void http_worker_loop(int fd, fn(HttpRequest*, HttpResponse*)->void handler) {
    *uint8 buf = alloc<uint8>(8192);
    while (1) {
        int c = net_accept(fd);
        if (c < 0) { continue; }
        int64 n = net_recv(c, (*void)buf, 8192);
        if (n <= 0) { net_close(c); continue; }

        let req: HttpRequest;  HttpRequest_init(&req);
        HttpRequest_parse(&req, buf, (int)n);
        let res: HttpResponse;  HttpResponse_init(&res, 200);
        handler(&req, &res);

        let out: String;  String_init(&out, 256);
        HttpResponse_render(&res, &out);
        net_send(c, (*void)String_cstr(&out), out.len);
        net_close(c);

        String_free(&out);
        HttpResponse_free(&res);
        HttpRequest_free(&req);
    }
    free(buf);
}

// Listen on `port` and serve with `nworkers` threads (the calling thread is one
// of them, so it blocks here). Returns immediately only if the bind fails.
void http_serve(int port, int nworkers, escaping fn(HttpRequest*, HttpResponse*)->void handler) {
    int fd = net_tcp_listen((uint16)port);
    if (fd < 0) { return; }
    int spawned = 1;
    while (spawned < nworkers) {
        let w: fn()->void = void() { http_worker_loop(fd, handler); };
        thread_create(w);
        spawned = spawned + 1;
    }
    http_worker_loop(fd, handler);
}

// ── Binary-safe request (full body) ────────────────────────────────────────────
//
// HttpRequest above does a single 8 KB recv and stores the body as a String
// (signed char) — fine for small text requests, but it truncates large bodies
// and corrupts binary ones. HttpReq instead reads the *complete* request,
// looping recv until Content-Length bytes arrive, into a binary-safe `*uint8`
// body. Use it for uploads (images, arbitrary bytes).
//
//   let r: HttpReq;  HttpReq_init(&r);
//   int st = http_recv(fd, &r, 25 * 1024 * 1024);   // 0 ok, or an HTTP error code
//   // ... route on r.method / r.path, read r.body[0..r.body_len) ...
//   http_reply(fd, 200, "application/json", "", &someStringBody);
//   HttpReq_free(&r);

struct HttpReq {
    String method;
    String path;
    String headers;    // "Key: Value\n" lines (CRLF normalised to \n)
    *uint8 body;        // heap, binary-safe (NOT a String)
    int64  body_len;
}

void HttpReq_init(HttpReq* self) {
    String_init(&self.method, 8);
    String_init(&self.path, 32);
    String_init(&self.headers, 256);
    self.body     = null;
    self.body_len = 0;
}

void HttpReq_free(HttpReq* self) {
    String_free(&self.method);
    String_free(&self.path);
    String_free(&self.headers);
    if (self.body != null) { free(self.body); self.body = null; }
}

// The request body as a non-owning, binary-safe Bytes view (no copy).
Bytes HttpReq_body(HttpReq* self) {
    let v: Bytes;
    v.data = self.body;
    v.len  = self.body_len;
    v.cap  = 0;
    return v;
}

// Index just past the "\r\n\r\n" header terminator in b[0..n), or -1.
int http_idx_header_end(*uint8 b, int n) {
    int i = 0;
    while (i + 3 < n) {
        if (b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10) { return i + 4; }
        i = i + 1;
    }
    return -1;
}

*uint8 http_buf_grow(*uint8 old, int used, int newcap) {
    *uint8 nb = alloc<uint8>(newcap);
    if (used > 0) { memcpy((*void)nb, (*void)old, used); }
    free(old);
    return nb;
}

char http_lc(char c) {
    if (c >= 65 && c <= 90) { return (char)((int)c + 32); }
    return c;
}

// Parse request line + headers from buf[0..hend) into r.
void http_parse_head(HttpReq* r, *uint8 buf, int hend) {
    int pos = 0;
    while (pos < hend && buf[pos] != 32 && buf[pos] != 13) { String_push(&r.method, (char)buf[pos]); pos = pos + 1; }
    if (pos < hend && buf[pos] == 32) { pos = pos + 1; }
    while (pos < hend && buf[pos] != 32 && buf[pos] != 13) { String_push(&r.path, (char)buf[pos]); pos = pos + 1; }
    while (pos < hend && buf[pos] != 10) { pos = pos + 1; }
    if (pos < hend) { pos = pos + 1; }
    while (pos < hend) {
        if (buf[pos] == 13 || buf[pos] == 10) { break; }
        while (pos < hend && buf[pos] != 13 && buf[pos] != 10) { String_push(&r.headers, (char)buf[pos]); pos = pos + 1; }
        String_push(&r.headers, '\n');
        if (pos < hend && buf[pos] == 13) { pos = pos + 1; }
        if (pos < hend && buf[pos] == 10) { pos = pos + 1; }
    }
}

// Case-insensitive header lookup; copies the value into `out`. 1 = hit.
int HttpReq_header(HttpReq* r, string name, String* out) {
    String_clear(out);
    int n = (int)r.headers.len;
    int i = 0;
    while (i < n) {
        int j = 0;
        int matched = 1;
        while (name[j] != 0) {
            if (i + j >= n) { matched = 0; }
            if (matched == 1 && http_lc(r.headers.data[i + j]) != http_lc(name[j])) { matched = 0; }
            j = j + 1;
        }
        if (matched == 1 && i + j < n && r.headers.data[i + j] == 58) {
            int k = i + j + 1;
            while (k < n && r.headers.data[k] == 32) { k = k + 1; }
            while (k < n && r.headers.data[k] != 10) { String_push(out, r.headers.data[k]); k = k + 1; }
            return 1;
        }
        while (i < n && r.headers.data[i] != 10) { i = i + 1; }
        i = i + 1;
    }
    return 0;
}

int64 http_str_to_i64(String* s) {
    int64 v = 0;
    int i = 0;
    while (i < s.len) {
        char c = s.data[i];
        if (c < 48 || c > 57) { break; }
        v = v * 10 + (int64)((int)c - 48);
        i = i + 1;
    }
    return v;
}

// Read a complete request from `fd`. Returns 0 on success, or an HTTP error
// status (400 malformed / 413 too large) on failure.
int http_recv(int fd, HttpReq* r, int64 max_body) {
    int cap = 8192;
    *uint8 buf = alloc<uint8>(cap);
    int n = 0;
    int hend = -1;
    while (hend < 0) {
        if (n >= cap) { cap = cap * 2; buf = http_buf_grow(buf, n, cap); }
        int64 got = net_recv(fd, (*void)(buf + n), cap - n);
        if (got <= 0) { free(buf); return 400; }
        n = n + (int)got;
        hend = http_idx_header_end(buf, n);
        if (hend < 0 && n > 65536) { free(buf); return 400; }
    }
    http_parse_head(r, buf, hend);

    let cl: String;  String_init(&cl, 16);
    int64 clen = 0;
    if (HttpReq_header(r, "content-length", &cl) == 1) { clen = http_str_to_i64(&cl); }
    String_free(&cl);
    if (clen > max_body) { free(buf); return 413; }

    int have = n - hend;
    if (clen <= 0) { r.body = null; r.body_len = 0; free(buf); return 0; }

    *uint8 body = alloc<uint8>(clen);
    int copy0 = have;
    if (copy0 > (int)clen) { copy0 = (int)clen; }
    if (copy0 > 0) { memcpy((*void)body, (*void)(buf + hend), copy0); }
    free(buf);

    int64 bgot = copy0;
    while (bgot < clen) {
        int64 got = net_recv(fd, (*void)(body + bgot), clen - bgot);
        if (got <= 0) { break; }
        bgot = bgot + got;
    }
    r.body     = body;
    r.body_len = bgot;
    return 0;
}

// Send a full HTTP/1.1 response. `extra` is pre-formatted "K: V\r\n" lines (may
// be empty). `body` is sent verbatim (its String length is honoured, so it may
// hold bytes a NUL would otherwise cut short).
void http_reply(int fd, int status, string ctype, string extra, String* body) {
    let out: String;  String_init(&out, body.len + 256);
    String_append(&out, "HTTP/1.1 ");
    let st: String;  String_init(&st, 8);  String_from_int(&st, status);
    String_append(&out, String_cstr(&st));  String_free(&st);
    String_push(&out, ' ');
    String_append(&out, http_reason(status));
    String_append(&out, "\r\nContent-Type: ");  String_append(&out, ctype);  String_append(&out, "\r\n");
    String_append(&out, extra);
    String_append(&out, "Content-Length: ");
    let cln: String;  String_init(&cln, 16);  String_from_int(&cln, (int)body.len);
    String_append(&out, String_cstr(&cln));  String_free(&cln);
    String_append(&out, "\r\nConnection: close\r\n\r\n");
    net_send(fd, (*void)String_cstr(&out), out.len);
    if (body.len > 0) { net_send(fd, (*void)body.data, body.len); }
    String_free(&out);
}

// Convenience: reply with a small JSON error {"error":"..."}.
void http_reply_error(int fd, int status, string extra, string msg) {
    let b: String;  String_init(&b, 64);
    String_append(&b, "{\"error\":\"");  String_append(&b, msg);  String_append(&b, "\"}");
    http_reply(fd, status, "application/json", extra, &b);
    String_free(&b);
}
