// either.esk — the standard sum types: Option<T> and Either<A,B>.
//
// Built on generic algebraic enums + match. Construct with explicit type args
// (`Some<int>(5)`, `None<int>()`, `Left<int,string>(x)`), inspect with the helpers
// here or with `match` directly:
//
//   Option<int> o = Some<int>(5);
//   if (Option_is_some<int>(&o)) { int v = Option_unwrap_or<int>(&o, 0); }
//   match o { Some(v) -> ...; None -> ...; }

enum Option<T> {
    None,
    Some(T),
}

enum Either<A, B> {
    Left(A),
    Right(B),
}

// ── Option helpers ──────────────────────────────────────────────────────────
bool Option_is_some<T>(Option<T>* o) {
    match *o {
        Some(v) -> return true;
        None    -> return false;
    }
}

bool Option_is_none<T>(Option<T>* o) {
    match *o {
        Some(v) -> return false;
        None    -> return true;
    }
}

// Return the contained value, or `dflt` if None.
T Option_unwrap_or<T>(Option<T>* o, T dflt) {
    match *o {
        Some(v) -> return v;
        None    -> return dflt;
    }
}

// ── Either helpers ──────────────────────────────────────────────────────────
bool Either_is_left<A, B>(Either<A, B>* e) {
    match *e {
        Left(a)  -> return true;
        Right(b) -> return false;
    }
}

// ── Deprecated names (kept so 0.10.0 code compiles; removed in a later release) ──
// Deprecated (0.10.1): use Option_is_some.
bool opt_is_some<T>(Option<T>* o) { return Option_is_some<T>(o); }
// Deprecated (0.10.1): use Option_is_none.
bool opt_is_none<T>(Option<T>* o) { return Option_is_none<T>(o); }
// Deprecated (0.10.1): use Option_unwrap_or.
T opt_unwrap_or<T>(Option<T>* o, T dflt) { return Option_unwrap_or<T>(o, dflt); }
// Deprecated (0.10.1): use Either_is_left.
bool either_is_left<A, B>(Either<A, B>* e) { return Either_is_left<A, B>(e); }
