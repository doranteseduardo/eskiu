// alloc.esk — a toolkit of explicit allocators over memory YOU own.
//
// This is the Zig model, not a global `malloc` replacement: each allocator
// sub-allocates from a buffer you hand it (pure pointer arithmetic — this file
// has no externs and calls nothing), plugging into `alloc_with(&a, T, count)` via
// `*void <T>_alloc(<T>* self, int64 n)`. They give you arena / pool / first-fit
// strategies and are the building blocks for a freestanding heap.
//
// Where the backing buffer comes from is YOUR choice, and that decides the libc
// story — the allocators are libc-agnostic either way:
//   * a static array     — zero libc, zero syscalls, fixed size
//   * `<sysheap>` (mmap)  — OS pages, no libc `malloc` (Zig page_allocator style)
//   * `alloc<uint8>(n)`   — one upfront libc `calloc` (fine for hosted code)
//   * a fixed region      — under `--freestanding` (see `kernel/alloc.esk`)
//
// Note: the default `alloc<T>` in `<mem>` is still libc `calloc` in hosted mode;
// these allocators don't change that — they're for when you manage a region.
//
//   uint8[4096] backing;                 // a static buffer — no malloc at all
//   let a: Bump;  Bump_init(&a, &backing[0], 4096);
//   *int xs = alloc_with(&a, int, 16);

// Round n up to the next multiple of 8 (alignment for any scalar/pointer).
int64 alloc_align8(int64 n) {
    return ((n + 7) / 8) * 8;
}

// ── Bump: monotonic; individual frees are no-ops, reset frees everything ──────
struct Bump {
    *uint8 buf;
    int64  cap;
    int64  off;
}
void Bump_init(Bump* self, *uint8 buf, int64 cap) {
    self.buf = buf; self.cap = cap; self.off = 0;
}
*void Bump_alloc(Bump* self, int64 n) {
    const int64 start = alloc_align8(self.off);
    if (n < 0 || start > self.cap || n > self.cap - start) { return null; }   // no `start + n` wrap
    self.off = start + n;
    return (*void)(self.buf + start);
}
void Bump_reset(Bump* self) { self.off = 0; }

// ── Arena: a bump with checkpoint/restore (save an offset, free back to it) ──
struct Arena {
    *uint8 buf;
    int64  cap;
    int64  off;
}
void Arena_init(Arena* self, *uint8 buf, int64 cap) {
    self.buf = buf; self.cap = cap; self.off = 0;
}
*void Arena_alloc(Arena* self, int64 n) {
    const int64 start = alloc_align8(self.off);
    if (n < 0 || start > self.cap || n > self.cap - start) { return null; }   // no `start + n` wrap
    self.off = start + n;
    return (*void)(self.buf + start);
}
int64 Arena_save(Arena* self) { return self.off; }
void  Arena_restore(Arena* self, int64 marker) { self.off = marker; }
void  Arena_reset(Arena* self) { self.off = 0; }

// ── Pool: fixed-size blocks with a free list threaded through free blocks ────
struct PoolNode { *PoolNode next; }
struct Pool {
    *uint8     buf;
    int64      cap;
    int64      blockSize;
    *PoolNode  freeHead;
    int64      highWater;
}
void Pool_init(Pool* self, *uint8 buf, int64 cap, int64 blockSize) {
    const int64 bs = alloc_align8(blockSize);
    self.buf = buf; self.cap = cap; self.blockSize = bs < 8 ? 8 : bs;
    self.freeHead = null; self.highWater = 0;
}
*void Pool_alloc(Pool* self, int64 n) {
    if (n < 0 || n > self.blockSize) { return null; }
    if (self.freeHead != null) {             // reuse a freed block
        *PoolNode node = self.freeHead;
        self.freeHead = node.next;
        return (*void)node;
    }
    if (self.blockSize > self.cap - self.highWater) { return null; }
    *void p = (*void)(self.buf + self.highWater);
    self.highWater += self.blockSize;
    return p;
}
void Pool_free(Pool* self, *void p) {
    *PoolNode node = (*PoolNode)p;
    node.next = self.freeHead;
    self.freeHead = node;
}

// ── First-fit general-purpose (after Thompson's original) ────────────────────
// Each region is [FFNode header][payload]. Free regions are linked through the
// header's `next`; used regions keep their size in the header. Alloc does a
// first-fit search and splits a large region. The free list is kept in address
// order, so free merges the region with an adjacent free neighbour on either
// side (coalescing): freeing everything restores one region, and the heap does
// not fragment permanently.
struct FFNode {
    int64    size;   // payload bytes available in this region
    *FFNode  next;   // next free region (used regions: ignored)
}
// The region header's size, sizeof(FFNode) on every target: payload offsets
// and split/merge arithmetic are all in terms of it.
const int64 _FF_HDR = 16;

struct FirstFit {
    *uint8    buf;
    int64     cap;
    *FFNode   freeHead;
}
// A buffer too small for one region header (cap < 16) holds nothing: the free
// list starts empty, so every alloc returns null and nothing is written to `buf`.
void FirstFit_init(FirstFit* self, *uint8 buf, int64 cap) {
    self.buf = buf; self.cap = cap;
    if (cap < _FF_HDR) { self.freeHead = null; return; }
    *FFNode head = (*FFNode)buf;
    head.size = cap - _FF_HDR;
    head.next = null;
    self.freeHead = head;
}
*void FirstFit_alloc(FirstFit* self, int64 n) {
    // No region is larger than the buffer, so a bigger (or negative) request can
    // never fit; rejecting it first also keeps alloc_align8(n) from wrapping.
    if (n < 0 || n > self.cap) { return null; }
    const int64 want = alloc_align8(n);
    *FFNode prev = null;
    *FFNode cur  = self.freeHead;
    while (cur != null) {
        if (cur.size >= want) {
            // Split if the leftover can hold a header plus a little payload.
            if (cur.size >= want + _FF_HDR + 8) {
                *FFNode rest = (*FFNode)((*uint8)cur + _FF_HDR + want);
                rest.size = cur.size - want - _FF_HDR;
                rest.next = cur.next;
                cur.size  = want;
                if (prev == null) { self.freeHead = rest; }
                else              { prev.next = rest; }
            } else {
                // Use the whole region; unlink it.
                if (prev == null) { self.freeHead = cur.next; }
                else              { prev.next = cur.next; }
            }
            return (*void)((*uint8)cur + _FF_HDR);
        }
        prev = cur;
        cur  = cur.next;
    }
    return null;                 // out of memory
}
void FirstFit_free(FirstFit* self, *void p) {
    if (p == null) { return; }       // free(null) is a no-op
    *FFNode hdr = (*FFNode)((*uint8)p - _FF_HDR);
    const int64 at = (int64)hdr;
    *FFNode prev = null;
    *FFNode cur  = self.freeHead;
    while (cur != null && (int64)cur < at) { prev = cur; cur = cur.next; }
    hdr.next = cur;
    if (prev == null) { self.freeHead = hdr; } else { prev.next = hdr; }
    // Merge with the following region when it starts right after this one.
    if (cur != null && at + _FF_HDR + hdr.size == (int64)cur) {
        hdr.size += _FF_HDR + cur.size;
        hdr.next = cur.next;
    }
    // Merge into the preceding region when this one starts right after it.
    if (prev != null && (int64)prev + _FF_HDR + prev.size == at) {
        prev.size += _FF_HDR + hdr.size;
        prev.next = hdr.next;
    }
}
