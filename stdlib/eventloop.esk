// eventloop.esk — a general-purpose readiness reactor.
//
// A single thread watches many file descriptors and dispatches a callback when
// one becomes readable, via kqueue (macOS) or epoll (Linux). This is the shared
// foundation for async I/O, the HTTP stack, and (later) the UI framework — it
// dispatches readiness, not just sockets.
//
//   void on_accept(EventLoop* lp, int fd) {
//       int c = net_accept(fd);
//       el_add_read(lp, c, on_data);     // register the new connection
//   }
//   int main() {
//       EventLoop* lp = el_new(256);
//       el_add_read(lp, listen_fd, on_accept);
//       el_run(lp);                       // blocks, dispatching callbacks
//   }

import <mem>;
import <time>;

// A read-ready callback receives the loop (so it can register/remove fds or
// stop) and the fd that became readable.
struct EvHandler {
    fn(EventLoop*, int)->void on_read;   // the callback (read- or write-readiness)
    int active;
    // Bumped on every (re-)registration. el_run uses it to tell whether the
    // callback it just invoked is still the installed one: a one-shot read loop
    // on a single fd re-arms that fd *from inside the callback* (via resume), so
    // `active` is back to 1 by the time el_run checks — `gen` is not.
    int gen;
    int isWrite;   // 0 = waiting for readable, 1 = waiting for writable
}

// A one-shot timer: fire `on_fire` once the monotonic clock reaches `deadline`.
struct EvTimer {
    int64       deadline;   // monotonic ms (time_monotonic_ms)
    fn()->void  on_fire;
    int         active;
}

struct EventLoop {
    int        backend;   // kqueue / epoll descriptor
    int        running;
    *EvHandler slots;     // indexed by fd
    int        cap;
    *EvTimer   timers;    // timer slots [0, tcap)
    int        tcap;
}

// ── Platform backend ─────────────────────────────────────────────────────────
#ifdef __APPLE__

extern int kqueue();
extern int kevent(int kq, *void changelist, int nchanges,
                  *void eventlist, int nevents, *void timeout);

// struct kevent (macOS, 64-bit): natural layout, 32 bytes.
struct EvNative {
    uint64 ident;
    int16  filter;
    uint16 flags;
    uint32 fflags;
    int64  data;
    *void  udata;
}

int _el_backend_new() { return kqueue(); }

// One kevent change: filter (-1 = EVFILT_READ, -2 = EVFILT_WRITE), flag
// (1 = EV_ADD, 2 = EV_DELETE).
void _el_kev(int kq, int fd, int filter, int flag) {
    let ev: EvNative;
    ev.ident  = (uint64)fd;
    ev.filter = (int16)filter;
    ev.flags  = (uint16)flag;
    ev.fflags = 0;  ev.data = 0;  ev.udata = (*void)0;
    kevent(kq, (*void)&ev, 1, (*void)0, 0, (*void)0);
}

// Set fd's interest: mode 0 = none, 1 = readable, 2 = writable. kqueue filters
// are independent, so we add the wanted one and delete the other (ENOENT on a
// not-registered filter is harmless). `wasActive` is unused here (epoll needs it).
void _el_ctl(int kq, int fd, int mode, int wasActive) {
    if (mode == 0) { _el_kev(kq, fd, -1, 2); _el_kev(kq, fd, -2, 2); return; }
    if (mode == 2) { _el_kev(kq, fd, -2, 1); _el_kev(kq, fd, -1, 2); }   // want write
    else           { _el_kev(kq, fd, -1, 1); _el_kev(kq, fd, -2, 2); }   // want read
}

// struct timespec (64-bit macOS): { time_t tv_sec; long tv_nsec; } = 16 bytes.
struct EvTimespec { int64 tv_sec; int64 tv_nsec; }

// Wait for readiness (or until `timeout_ms`, -1 = forever); fill fds[0..) with
// ready descriptors, return the count (0 on timeout).
int _el_wait(int kq, *EvNative evs, *int fds, int max, int64 timeout_ms) {
    let ts: EvTimespec;
    *void tsp = (*void)0;                 // NULL timeout = wait forever
    if (timeout_ms >= (int64)0) {
        ts.tv_sec  = timeout_ms / (int64)1000;
        ts.tv_nsec = (timeout_ms % (int64)1000) * (int64)1000000;
        tsp = (*void)&ts;
    }
    int n = kevent(kq, (*void)0, 0, (*void)evs, max, tsp);
    int i = 0;
    while (i < n) { fds[i] = (int)evs[i].ident; i = i + 1; }
    return n;
}

#else  // Linux: epoll

extern int epoll_create1(int flags);
extern int epoll_ctl(int epfd, int op, int fd, *void ev);
extern int epoll_wait(int epfd, *void events, int maxevents, int timeout);

// struct epoll_event is packed on x86-64: { u32 events; u64 data; } = 12 bytes.
packed struct EvNative {
    uint32 events;
    uint64 data;
}

int _el_backend_new() { return epoll_create1(0); }

// Set fd's interest: mode 0 = none (DEL), 1 = readable (EPOLLIN), 2 = writable
// (EPOLLOUT). epoll keeps one entry per fd, so switching read<->write is a MOD
// (the fd was already registered) and the first registration is an ADD.
void _el_ctl(int ep, int fd, int mode, int wasActive) {
    if (mode == 0) { epoll_ctl(ep, 2, fd, (*void)0); return; }   // EPOLL_CTL_DEL
    let ev: EvNative;
    ev.events = 1;  if (mode == 2) { ev.events = 4; }            // EPOLLIN=1, EPOLLOUT=4
    ev.data   = (uint64)fd;
    int op = 1;  if (wasActive != 0) { op = 3; }                 // ADD=1, MOD=3 (EPOLL_CTL_MOD)
    epoll_ctl(ep, op, fd, (*void)&ev);
}

int _el_wait(int ep, *EvNative evs, *int fds, int max, int64 timeout_ms) {
    int n = epoll_wait(ep, (*void)evs, max, (int)timeout_ms);   // -1 = forever
    int i = 0;
    while (i < n) { fds[i] = (int)evs[i].data; i = i + 1; }
    return n;
}

#endif

// ── Public API ───────────────────────────────────────────────────────────────

// Create a loop that can track fds in [0, max_fds).
EventLoop* el_new(int max_fds) {
    EventLoop* lp = alloc<EventLoop>(1);
    lp.backend = _el_backend_new();
    lp.running = 0;
    lp.cap     = max_fds;
    lp.slots   = alloc<EvHandler>(max_fds);
    int i = 0;
    // `alloc` does not zero: initialize EVERY field, including the `on_read`
    // closure. Dispatch is guarded by `active`, but leaving `on_read` as heap
    // garbage means any stray read invokes a garbage function pointer (a SIGILL
    // on Linux, where fresh allocations aren't zero as they happen to be on macOS).
    while (i < max_fds) {
        lp.slots[i].active  = 0;
        lp.slots[i].gen     = 0;
        lp.slots[i].isWrite = 0;
        lp.slots[i].on_read = void(EventLoop* e, int fd) {};
        i = i + 1;
    }
    lp.tcap    = max_fds;
    lp.timers  = alloc<EvTimer>(max_fds);
    int t = 0;
    while (t < max_fds) { lp.timers[t].active = 0; t = t + 1; }
    return lp;
}

// Register a one-shot timer firing at monotonic `deadline` (ms). Returns a timer
// id (slot index) or -1 if full. `el_run` fires it once, then frees `on_fire`.
int el_add_timer(EventLoop* lp, int64 deadline, escaping fn()->void on_fire) {
    int t = 0;
    while (t < lp.tcap) {
        if (lp.timers[t].active == 0) {
            lp.timers[t].deadline = deadline;
            lp.timers[t].on_fire  = on_fire;
            lp.timers[t].active   = 1;
            return t;
        }
        t = t + 1;
    }
    return -1;
}

// Cancel a pending timer and free its env. Safe to call after it has fired
// (no-op then). Use from outside the timer's own on_fire.
void el_del_timer(EventLoop* lp, int id) {
    if (id < 0 || id >= lp.tcap) { return; }
    if (lp.timers[id].active != 0) {
        free_closure(lp.timers[id].on_fire);
        lp.timers[id].active = 0;
    }
}

// Register `fd` for read-readiness; `cb` fires each time it is readable.
void el_add_read(EventLoop* lp, int fd, escaping fn(EventLoop*, int)->void cb) {
    if (fd < 0 || fd >= lp.cap) { return; }
    int was = lp.slots[fd].active;
    lp.slots[fd].on_read = cb;
    lp.slots[fd].active  = 1;
    lp.slots[fd].isWrite = 0;
    lp.slots[fd].gen     = lp.slots[fd].gen + 1;   // new registration identity
    _el_ctl(lp.backend, fd, 1, was);
}

// Register `fd` for write-readiness; `cb` fires once it is writable. Used by the
// async write path and the non-blocking TLS pump. A fd waits for read OR write
// at a time; this replaces any prior read interest on the fd.
void el_add_write(EventLoop* lp, int fd, escaping fn(EventLoop*, int)->void cb) {
    if (fd < 0 || fd >= lp.cap) { return; }
    int was = lp.slots[fd].active;
    lp.slots[fd].on_read = cb;
    lp.slots[fd].active  = 1;
    lp.slots[fd].isWrite = 1;
    lp.slots[fd].gen     = lp.slots[fd].gen + 1;
    _el_ctl(lp.backend, fd, 2, was);
}

// Stop watching `fd`. (Does not free the callback env — on the normal path the
// callback is still running when it calls this; el_run frees the env on return.)
void el_del(EventLoop* lp, int fd) {
    if (fd < 0 || fd >= lp.cap) { return; }
    lp.slots[fd].active = 0;
    _el_ctl(lp.backend, fd, 0, 1);
}

// Deregister `fd` and free its callback's heap env. For deregistering from
// OUTSIDE the callback (e.g. cancelling a pending one-shot whose callback never
// fired) — never call this from within `fd`'s own callback (use el_del there).
void el_del_free(EventLoop* lp, int fd) {
    if (fd < 0 || fd >= lp.cap) { return; }
    if (lp.slots[fd].active != 0) { free_closure(lp.slots[fd].on_read); }
    el_del(lp, fd);
}

// Ask the loop to return from el_run after the current batch.
void el_stop(EventLoop* lp) { lp.running = 0; }

// Run until el_stop is called: wait for readiness and dispatch callbacks.
void el_run(EventLoop* lp) {
    int max = 64;
    *EvNative evs = alloc<EvNative>(max);
    *int      fds = alloc<int>(max);
    lp.running = 1;
    while (lp.running != 0) {
        // Block only until the nearest timer deadline (forever if none), so the
        // loop wakes in time to fire timers even with no fd activity.
        int64 now = time_monotonic_ms();
        int64 timeout = (int64)0 - (int64)1;            // -1 = wait forever
        int t = 0;
        while (t < lp.tcap) {
            if (lp.timers[t].active != 0) {
                int64 d = lp.timers[t].deadline - now;
                if (d < (int64)0) { d = (int64)0; }
                if (timeout < (int64)0) { timeout = d; }
                else if (d < timeout) { timeout = d; }
            }
            t = t + 1;
        }
        int n = _el_wait(lp.backend, evs, fds, max, timeout);
        int i = 0;
        while (i < n) {
            int fd = fds[i];
            if (fd >= 0 && fd < lp.cap && lp.slots[fd].active != 0) {
                let cb: fn(EventLoop*, int)->void = lp.slots[fd].on_read;
                int g = lp.slots[fd].gen;
                cb(lp, fd);
                // Free `cb`'s heap env once it is no longer the installed
                // registration: either it deregistered (active -> 0) or it re-armed
                // the same fd with a *new* closure during its own run (gen bumped).
                // A still-installed persistent callback (same gen, active) is left.
                if (lp.slots[fd].active == 0 || lp.slots[fd].gen != g) { free_closure(cb); }
            }
            i = i + 1;
        }
        // Fire expired timers. Deactivate before firing so on_fire (-> resume) can
        // reuse the slot; free the snapshot env afterwards (one-shot, now spent).
        now = time_monotonic_ms();
        t = 0;
        while (t < lp.tcap) {
            if (lp.timers[t].active != 0 && lp.timers[t].deadline <= now) {
                let fire: fn()->void = lp.timers[t].on_fire;
                lp.timers[t].active = 0;
                fire();
                free_closure(fire);
            }
            t = t + 1;
        }
    }
    free((*void)evs);  free((*void)fds);
}

void el_free(EventLoop* lp) {
    // Release any still-armed timer envs (e.g. the loop stopped with timers pending).
    int t = 0;
    while (t < lp.tcap) {
        if (lp.timers[t].active != 0) { free_closure(lp.timers[t].on_fire); }
        t = t + 1;
    }
    free((*void)lp.timers);
    free((*void)lp.slots);
    free((*void)lp);
}
