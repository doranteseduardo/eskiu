// env.esk — environment variables.
//
//   import <env>;
//   string home = env_get("HOME");          // null if unset
//   int port    = env_get_int("PORT", 8080); // parsed, or the fallback
//
// CLI arguments come straight from `int main(int argc, string* argv)`; this
// module covers the process environment.

extern string getenv(string name);
extern int    atoi(string s);

// The value of an environment variable, or null if it is not set.
string env_get(string name) {
    return getenv(name);
}

// 1 if the variable is set, else 0.
int env_has(string name) {
    if (getenv(name) != null) { return 1; }
    return 0;
}

// The variable's value, or `fallback` if it is not set.
string env_get_or(string name, string fallback) {
    let v: string = getenv(name);
    if (v == null) { return fallback; }
    return v;
}

// The variable parsed as an integer, or `fallback` if unset or non-numeric.
// (atoi yields 0 for non-numeric input, so an explicit unset check comes first.)
int env_get_int(string name, int fallback) {
    let v: string = getenv(name);
    if (v == null) { return fallback; }
    return atoi(v);
}
