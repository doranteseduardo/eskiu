// regex.esk: a small regular-expression engine.
//
//   import <regex>;
//   if (regex_match("\\d+-\\d+", "12-34") == 1) { ... }      // search, 1/0
//
//   Regex re = regex_compile("(\\w+)@(\\w+)");
//   let m: Match;
//   if (Regex_search(&re, "a@b", &m) == 1) {
//       String u; String_init(&u, 8);
//       Match_group(&m, "a@b", 1, &u);        // "a"  (group 1)
//       // ... use u ...
//       String_free(&u);
//   }
//   Match_free(&m);
//   Regex_free(&re);
//
// Supported syntax: literals, `.` (any byte but newline), character classes
// `[a-z]` / `[^...]`, the shorthands `\d \w \s` (and `\D \W \S` outside a class),
// the escapes `\n \t \r \f \v \0`, quantifiers `* + ? {m} {m,} {m,n}` (counts up to
// 1000, as in RE2; append `?` for the lazy form), alternation `|`, capturing
// groups `( )`, and the anchors `^` (start of text) and `$` (end of text).
//
// The matcher is a Thompson NFA run as a Pike VM: it explores all paths in
// lockstep, so matching is linear in the input length with no catastrophic
// backtracking (no ReDoS). It reports capture groups for the leftmost match,
// preferring greedy quantifiers unless they are marked lazy.

import <mem>;
import <string>;

// ---- limits (fixed, so no reallocation during compile) --------------------
#define RE_MAX_INST  4096
#define RE_MAX_RANGE 1024
#define RE_MAX_CLASS 256
#define RE_MAX_NODES 4096
#define RE_MAX_DEPTH 512
#define RE_MAX_REPEAT 1000

// ---- instruction opcodes --------------------------------------------------
#define OP_CHAR  1
#define OP_ANY   2
#define OP_CLASS 3
#define OP_MATCH 4
#define OP_JMP   5
#define OP_SPLIT 6
#define OP_SAVE  7
#define OP_BOL   8
#define OP_EOL   9

// ---- AST node kinds -------------------------------------------------------
#define N_EMPTY  0
#define N_LIT    1
#define N_ANY    2
#define N_CLASS  3
#define N_CONCAT 4
#define N_ALT    5
#define N_GROUP  6
#define N_REPEAT 7
#define N_BOL    8
#define N_EOL    9

struct Inst {
    int op;
    int a;      // char / class id / save slot / jump target x
    int b;      // second jump target (SPLIT)
}

struct Range {
    int lo;
    int hi;
}

struct ClassInfo {
    int start;      // index into the ranges array
    int count;
    int negate;
}

struct Node {
    int kind;
    int ch;         // N_LIT
    int cls;        // N_CLASS
    int grp;        // N_GROUP capture index (1-based)
    int rmin;       // N_REPEAT
    int rmax;       // N_REPEAT (-1 = unbounded)
    int greedy;
    Node* left;     // child / left operand
    Node* right;    // right operand (concat, alt)
}

struct Regex {
    *Inst      inst;
    int        ninst;
    *ClassInfo classes;
    int        nclass;
    *Range     ranges;
    int        nrange;
    int        ngroup;      // number of capturing groups (group 0 is the whole match)
    int        ok;
    string     err;         // null when ok
}

struct ReComp {
    string pat;
    int    len;
    int    pos;
    int    ngroup;
    string err;
    Regex* re;
    *Node  nodes;
    int    nnode;
    int    depth;   // groups currently open (the parser recurses once per group)
}

struct Match {
    int  ok;
    int  ngroup;
    int  start;     // group 0 start (== cap[0])
    int  end;       // group 0 end   (== cap[1])
    *int cap;       // 2*(ngroup+1) ints: [start,end] per group, -1 if unset
}

struct Thread {
    int  pc;
    *int caps;
}

struct Vm {
    Regex*   prog;
    string   text;
    int      len;
    int      ncap;
    *int     visited;       // ninst ints, holds the generation each pc was last added under
    *Thread  la;
    *Thread  lb;
    int      nA;
    int      nB;
    // Capture storage: thread slot i of list A owns capsA[i*ncap .. (i+1)*ncap),
    // likewise for B. Enqueueing a thread copies its captures into its slot, so
    // the storage is recycled every step: O(threads * ncap) for the whole search.
    *int     capsA;
    *int     capsB;
}

// =========================== parsing =======================================

int re_peek(ReComp* c) {
    return c.pos >= c.len ? -1 : (int)((uint8)c.pat[c.pos]);
}

int re_peek_at(ReComp* c, int off) {
    const int p = c.pos + off;
    return p >= c.len ? -1 : (int)((uint8)c.pat[p]);
}

Node* re_node(ReComp* c, int kind) {
    if (c.nnode >= RE_MAX_NODES) {
        if (c.err == null) { c.err = "regex pattern too complex"; }
        return &c.nodes[0];
    }
    Node* n = &c.nodes[c.nnode++];
    n.kind = kind;
    n.ch = 0;
    n.cls = 0;
    n.grp = 0;
    n.rmin = 0;
    n.rmax = 0;
    n.greedy = 1;
    n.left = null;
    n.right = null;
    return n;
}

// Add a class to the current program; returns its id. Fill ranges after.
int re_class_begin(ReComp* c, int negate) {
    Regex* re = c.re;
    if (re.nclass >= RE_MAX_CLASS) {
        if (c.err == null) { c.err = "too many character classes"; }
        return 0;
    }
    const int id = re.nclass++;
    re.classes[id].start = re.nrange;
    re.classes[id].count = 0;
    re.classes[id].negate = negate;
    return id;
}

void re_range(ReComp* c, int id, int lo, int hi) {
    Regex* re = c.re;
    if (re.nrange >= RE_MAX_RANGE) {
        if (c.err == null) { c.err = "too many class ranges"; }
        return;
    }
    re.ranges[re.nrange].lo = lo;
    re.ranges[re.nrange].hi = hi;
    re.nrange++;
    re.classes[id].count++;
}

// Add the ranges for a \d \w \s shorthand to class `id`.
void re_shorthand(ReComp* c, int id, int kind) {
    if (kind == 'd') {
        re_range(c, id, '0', '9');
    } else if (kind == 'w') {
        re_range(c, id, '0', '9');
        re_range(c, id, 'A', 'Z');
        re_range(c, id, 'a', 'z');
        re_range(c, id, '_', '_');
    } else if (kind == 's') {
        re_range(c, id, '\t', '\r');           // \t \n \v \f \r
        re_range(c, id, ' ', ' ');
    }
}

// Decode a backslash escape to its literal byte (\n, \t, ...); default is the
// character itself (so \. is '.', \\ is '\').
int re_escape_char(int e) {
    switch (e) {
        case 'n': return '\n';
        case 't': return '\t';
        case 'r': return '\r';
        case 'f': return '\f';
        case 'v': return '\v';
        case '0': return 0;
        default:  return e;
    }
}

// [ ... ] returns a N_CLASS node.
Node* re_parse_class(ReComp* c) {
    c.pos++;   // consume '['
    int negate = 0;
    if (re_peek(c) == '^') { c.pos++; negate = 1; }
    const int id = re_class_begin(c, negate);

    // A ']' right after '[' or '[^' is a literal member (POSIX), not the end.
    bool first = true;
    while (re_peek(c) != ']' || first) {
        first = false;
        if (re_peek(c) == -1) {
            if (c.err == null) { c.err = "unterminated character class"; }
            return re_node(c, N_CLASS);
        }
        int lo;
        if (re_peek(c) == '\\') {
            c.pos++;
            const int e = re_peek(c);
            c.pos++;
            if (e == 'd' || e == 'w' || e == 's') {
                re_shorthand(c, id, e);
                continue;
            }
            lo = re_escape_char(e);
        } else {
            lo = re_peek(c);
            c.pos++;
        }
        // range 'a-z'?  ('-' not immediately before the closing ']')
        if (re_peek(c) == '-' && re_peek_at(c, 1) != ']' && re_peek_at(c, 1) != -1) {
            c.pos++;   // consume '-'
            int hi;
            if (re_peek(c) == '\\') {
                c.pos++;
                const int e2 = re_peek(c);
                c.pos++;
                hi = re_escape_char(e2);
            } else {
                hi = re_peek(c);
                c.pos++;
            }
            re_range(c, id, lo, hi);
        } else {
            re_range(c, id, lo, lo);
        }
    }
    c.pos++;   // consume ']'
    Node* n = re_node(c, N_CLASS);
    n.cls = id;
    return n;
}

// A backslash escape as an atom: \d \w \s \D \W \S become classes, the rest a literal.
Node* re_parse_escape(ReComp* c) {
    c.pos++;   // consume '\'
    const int e = re_peek(c);
    if (e == -1) {
        if (c.err == null) { c.err = "trailing backslash"; }
        return re_node(c, N_EMPTY);
    }
    c.pos++;
    const bool lower = e == 'd' || e == 'w' || e == 's';
    if (lower || e == 'D' || e == 'W' || e == 'S') {
        // An uppercase shorthand is the negated class of its lowercase kind.
        const int id = re_class_begin(c, lower ? 0 : 1);
        re_shorthand(c, id, lower ? e : e + 32);
        Node* n = re_node(c, N_CLASS);
        n.cls = id;
        return n;
    }
    Node* n = re_node(c, N_LIT);
    n.ch = re_escape_char(e);
    return n;
}

Node* re_parse_alt(ReComp* c);

Node* re_parse_atom(ReComp* c) {
    const int pk = re_peek(c);
    if (pk == '(') {
        // Nesting is bounded so a pattern of many '(' fails cleanly instead of
        // recursing until the stack overflows.
        if (c.depth >= RE_MAX_DEPTH) {
            if (c.err == null) { c.err = "regex nesting too deep"; }
            return re_node(c, N_EMPTY);
        }
        c.pos++;
        const int g = ++c.ngroup;
        c.depth++;
        Node* inner = re_parse_alt(c);
        c.depth--;
        if (re_peek(c) != ')') {
            if (c.err == null) { c.err = "missing )"; }
            return re_node(c, N_EMPTY);
        }
        c.pos++;
        Node* n = re_node(c, N_GROUP);
        n.grp = g;
        n.left = inner;
        return n;
    }
    if (pk == '[') { return re_parse_class(c); }
    if (pk == '.') { c.pos++; return re_node(c, N_ANY); }
    if (pk == '^') { c.pos++; return re_node(c, N_BOL); }
    if (pk == '$') { c.pos++; return re_node(c, N_EOL); }
    if (pk == '\\') { return re_parse_escape(c); }
    if (pk == '*' || pk == '+' || pk == '?' || pk == '{') {
        if (c.err == null) { c.err = "nothing to repeat"; }
        return re_node(c, N_EMPTY);
    }
    if (pk == -1) {
        if (c.err == null) { c.err = "unexpected end of pattern"; }
        return re_node(c, N_EMPTY);
    }
    // ordinary literal
    c.pos++;
    Node* n = re_node(c, N_LIT);
    n.ch = pk;
    return n;
}

// Read a repeat count: -1 when there are no digits, -2 when it exceeds
// RE_MAX_REPEAT (the value is clamped while reading, so it cannot wrap).
int re_read_int(ReComp* c) {
    const int start = c.pos;
    int v = 0;
    while (re_peek(c) >= '0' && re_peek(c) <= '9') {
        if (v <= RE_MAX_REPEAT) { v = v * 10 + (re_peek(c) - '0'); }
        c.pos++;
    }
    if (c.pos == start) { return -1; }
    return v > RE_MAX_REPEAT ? -2 : v;
}

Node* re_parse_repeat(ReComp* c) {
    Node* a = re_parse_atom(c);
    if (c.err != null) { return a; }
    const int pk = re_peek(c);
    int rmin = 0;
    int rmax = 0;
    if (pk == '*') { c.pos++; rmin = 0; rmax = -1; }
    else if (pk == '+') { c.pos++; rmin = 1; rmax = -1; }
    else if (pk == '?') { c.pos++; rmin = 0; rmax = 1; }
    else if (pk == '{') {
        c.pos++;
        const int m1 = re_read_int(c);
        if (m1 == -2) {
            if (c.err == null) { c.err = "invalid repeat count"; }
            return a;
        }
        if (m1 < 0) {
            if (c.err == null) { c.err = "invalid {n,m}"; }
            return a;
        }
        rmin = m1;
        if (re_peek(c) == ',') {
            c.pos++;
            if (re_peek(c) == '}') { rmax = -1; }
            else {
                const int m2 = re_read_int(c);
                if (m2 == -2) {
                    if (c.err == null) { c.err = "invalid repeat count"; }
                    return a;
                }
                if (m2 < 0) {
                    if (c.err == null) { c.err = "invalid {n,m}"; }
                    return a;
                }
                rmax = m2;
            }
        } else {
            rmax = rmin;
        }
        if (re_peek(c) != '}') {
            if (c.err == null) { c.err = "expected }"; }
            return a;
        }
        if (rmax != -1 && rmax < rmin) {
            if (c.err == null) { c.err = "invalid {n,m}: max below min"; }
            return a;
        }
        c.pos++;
    } else {
        return a;                     // not followed by a quantifier
    }
    int greedy = 1;
    if (re_peek(c) == '?') { c.pos++; greedy = 0; }
    Node* n = re_node(c, N_REPEAT);
    n.left = a;
    n.rmin = rmin;
    n.rmax = rmax;
    n.greedy = greedy;
    return n;
}

Node* re_parse_concat(ReComp* c) {
    Node* left = null;
    while (c.err == null) {
        const int pk = re_peek(c);
        if (pk == -1 || pk == '|' || pk == ')') { break; }
        Node* atom = re_parse_repeat(c);
        if (left == null) { left = atom; }
        else {
            Node* n = re_node(c, N_CONCAT);
            n.left = left;
            n.right = atom;
            left = n;
        }
    }
    return left == null ? re_node(c, N_EMPTY) : left;
}

Node* re_parse_alt(ReComp* c) {
    Node* left = re_parse_concat(c);
    while (re_peek(c) == '|' && c.err == null) {
        c.pos++;
        Node* right = re_parse_concat(c);
        Node* n = re_node(c, N_ALT);
        n.left = left;
        n.right = right;
        left = n;
    }
    return left;
}

// =========================== compilation ===================================

int re_emit(ReComp* c, int op, int a, int b) {
    if (c.err != null) { return 0; }
    Regex* re = c.re;
    if (re.ninst >= RE_MAX_INST) {
        c.err = "regex program too large";
        return 0;
    }
    const int idx = re.ninst++;
    re.inst[idx].op = op;
    re.inst[idx].a = a;
    re.inst[idx].b = b;
    return idx;
}

void re_compile_node(ReComp* c, Node* n);

// Can `n` match the empty string?
bool re_nullable(Node* n) {
    if (n == null) { return true; }
    switch (n.kind) {
        case N_LIT: return false;
        case N_ANY: return false;
        case N_CLASS: return false;
        case N_CONCAT: return re_nullable(n.left) && re_nullable(n.right);
        case N_ALT: return re_nullable(n.left) || re_nullable(n.right);
        case N_GROUP: return re_nullable(n.left);
        case N_REPEAT: return n.rmin == 0 || re_nullable(n.left);
        default: return true;
    }
}

void re_compile_repeat(ReComp* c, Node* n) {
    const int rmin = n.rmin;
    const int rmax = n.rmax;
    const bool greedy = n.greedy == 1;
    Node* child = n.left;

    // Unbounded repeats follow RE2: x{n,} is n-1 copies of x then x+, and x*
    // is a loop, or (x+)? when x can match empty (the loop form would reach
    // its already-visited split after an empty iteration and drop that path).
    const int copies = rmax == -1 && rmin > 0 ? rmin - 1 : rmin;
    for (int i = 0; i < copies && c.err == null; i++) {
        re_compile_node(c, child);
    }
    if (c.err != null) { return; }

    if (rmax == -1 && (rmin > 0 || re_nullable(child))) {
        // x+:     body: child; l: split(body, end); end:
        // (x+)?:  q: split(body, end); then x+
        int q = -1;
        if (rmin == 0) { q = re_emit(c, OP_SPLIT, 0, 0); }
        const int body = c.re.ninst;
        re_compile_node(c, child);
        const int l = re_emit(c, OP_SPLIT, 0, 0);
        const int end = c.re.ninst;
        if (c.err != null) { return; }
        if (greedy) { c.re.inst[l].a = body; c.re.inst[l].b = end; }
        else { c.re.inst[l].a = end; c.re.inst[l].b = body; }
        if (q >= 0) {
            if (greedy) { c.re.inst[q].a = body; c.re.inst[q].b = end; }
            else { c.re.inst[q].a = end; c.re.inst[q].b = body; }
        }
        return;
    }
    if (rmax == -1) {
        // x*: L: split(body,end); body: child; jmp L; end:
        const int lsplit = re_emit(c, OP_SPLIT, 0, 0);
        const int body = c.re.ninst;
        re_compile_node(c, child);
        re_emit(c, OP_JMP, lsplit, 0);
        const int end = c.re.ninst;
        if (greedy) { c.re.inst[lsplit].a = body; c.re.inst[lsplit].b = end; }
        else { c.re.inst[lsplit].a = end; c.re.inst[lsplit].b = body; }
        return;
    }

    // Each optional copy: split(body, end); body: child. All splits exit to end.
    const int reps = rmax - rmin;
    if (reps <= 0) { return; }
    if (reps > RE_MAX_INST) { c.err = "regex program too large"; return; }
    *int splits = alloc<int>(reps);
    defer free(splits);
    for (int i = 0; i < reps && c.err == null; i++) {
        const int s = re_emit(c, OP_SPLIT, 0, 0);
        splits[i] = s;
        const int body = c.re.ninst;
        re_compile_node(c, child);
        if (greedy) { c.re.inst[s].a = body; }
        else { c.re.inst[s].b = body; }
    }
    const int end = c.re.ninst;
    for (i in 0..reps) {
        const int s = splits[i];
        if (greedy) { c.re.inst[s].b = end; }
        else { c.re.inst[s].a = end; }
    }
}

void re_compile_node(ReComp* c, Node* n) {
    if (n == null || c.err != null) { return; }
    switch (n.kind) {
        case N_LIT:    re_emit(c, OP_CHAR, n.ch, 0); break;
        case N_ANY:    re_emit(c, OP_ANY, 0, 0); break;
        case N_CLASS:  re_emit(c, OP_CLASS, n.cls, 0); break;
        case N_BOL:    re_emit(c, OP_BOL, 0, 0); break;
        case N_EOL:    re_emit(c, OP_EOL, 0, 0); break;
        case N_CONCAT: re_compile_node(c, n.left); re_compile_node(c, n.right); break;
        case N_GROUP:
            re_emit(c, OP_SAVE, 2 * n.grp, 0);
            re_compile_node(c, n.left);
            re_emit(c, OP_SAVE, 2 * n.grp + 1, 0);
            break;
        case N_ALT: {
            // split(a, b); a: left; jmp end; b: right; end:
            const int s = re_emit(c, OP_SPLIT, 0, 0);
            const int a = c.re.ninst;
            re_compile_node(c, n.left);
            const int j = re_emit(c, OP_JMP, 0, 0);
            const int b = c.re.ninst;
            re_compile_node(c, n.right);
            const int end = c.re.ninst;
            c.re.inst[s].a = a;
            c.re.inst[s].b = b;
            c.re.inst[j].a = end;
        } break;
        case N_REPEAT: re_compile_repeat(c, n); break;
        default: break;                // N_EMPTY emits nothing
    }
}

// Compile a pattern. Check the returned Regex.ok before matching; on failure
// Regex.err holds the reason. Free with Regex_free either way.
Regex regex_compile(string pattern) {
    let re: Regex;
    re.inst = alloc<Inst>(RE_MAX_INST);
    re.ninst = 0;
    re.classes = alloc<ClassInfo>(RE_MAX_CLASS);
    re.nclass = 0;
    re.ranges = alloc<Range>(RE_MAX_RANGE);
    re.nrange = 0;
    re.ngroup = 0;
    re.ok = 0;
    re.err = null;

    let c: ReComp;
    c.pat = pattern;
    c.len = (int)strlen(pattern);
    c.pos = 0;
    c.ngroup = 0;
    c.err = null;
    c.re = &re;
    c.nodes = alloc<Node>(RE_MAX_NODES);
    c.nnode = 0;
    c.depth = 0;
    defer free(c.nodes);

    Node* ast = re_parse_alt(&c);
    if (c.err == null && c.pos != c.len) { c.err = "unexpected trailing characters"; }
    if (c.err != null) {
        re.err = c.err;
        return re;
    }
    re.ngroup = c.ngroup;

    re_emit(&c, OP_SAVE, 0, 0);
    re_compile_node(&c, ast);
    re_emit(&c, OP_SAVE, 1, 0);
    re_emit(&c, OP_MATCH, 0, 0);

    if (c.err != null) { re.err = c.err; return re; }
    re.ok = 1;
    return re;
}

void Regex_free(Regex* re) {
    free(re.inst);
    free(re.classes);
    free(re.ranges);
    re.inst = null;
    re.classes = null;
    re.ranges = null;
}

// =========================== matching (Pike VM) ============================

int re_in_class(Regex* re, int id, int ch) {
    const ClassInfo ci = re.classes[id];
    bool found = false;
    for (i in ci.start..ci.start + ci.count) {
        if (ch >= re.ranges[i].lo && ch <= re.ranges[i].hi) { found = true; break; }
    }
    return found != (ci.negate == 1) ? 1 : 0;
}

// Copy `src` into the capture slot of thread `slot` in list `which`.
*int re_slotcaps(Vm* vm, int which, int slot, *int src) {
    *int dst = which == 0 ? &vm.capsA[slot * vm.ncap] : &vm.capsB[slot * vm.ncap];
    for (i in 0..vm.ncap) { dst[i] = src[i]; }
    return dst;
}

// Epsilon-closure add of pc (and its reachable pcs) into list `which`. `caps` is
// a working array: SAVE writes it in place and restores it on the way back, and
// only a thread that is enqueued gets its own copy.
void re_addthread(Vm* vm, int which, int gen, int pc, *int caps, int sp) {
    if (vm.visited[pc] == gen) { return; }
    vm.visited[pc] = gen;
    Inst* ins = &vm.prog.inst[pc];
    switch (ins.op) {
        case OP_JMP:
            re_addthread(vm, which, gen, ins.a, caps, sp);
            break;
        case OP_SPLIT:
            re_addthread(vm, which, gen, ins.a, caps, sp);
            re_addthread(vm, which, gen, ins.b, caps, sp);
            break;
        case OP_SAVE: {
            const int old = caps[ins.a];
            caps[ins.a] = sp;
            re_addthread(vm, which, gen, pc + 1, caps, sp);
            caps[ins.a] = old;
        } break;
        case OP_BOL:
            if (sp == 0) { re_addthread(vm, which, gen, pc + 1, caps, sp); }
            break;
        case OP_EOL:
            if (sp == vm.len) { re_addthread(vm, which, gen, pc + 1, caps, sp); }
            break;
        default:
            // CHAR / ANY / CLASS / MATCH: a thread that consumes (or accepts)
            if (which == 0) {
                vm.la[vm.nA].pc = pc;
                vm.la[vm.nA].caps = re_slotcaps(vm, 0, vm.nA, caps);
                vm.nA++;
            } else {
                vm.lb[vm.nB].pc = pc;
                vm.lb[vm.nB].caps = re_slotcaps(vm, 1, vm.nB, caps);
                vm.nB++;
            }
    }
}

// Search `text` for the leftmost match of `re`. On success fills `m` and
// returns 1; otherwise returns 0. `m` must be freed with Match_free.
int Regex_search(Regex* re, string text, Match* m) {
    m.ok = 0;
    m.ngroup = re.ngroup;
    m.start = -1;
    m.end = -1;
    m.cap = null;
    if (re.ok == 0) { return 0; }

    let vm: Vm;
    vm.prog = re;
    vm.text = text;
    vm.len = (int)strlen(text);
    vm.ncap = 2 * (re.ngroup + 1);
    const int ninst = re.ninst;
    vm.visited = alloc<int>(ninst);
    defer free(vm.visited);
    for (i in 0..ninst) { vm.visited[i] = -1; }
    vm.la = alloc<Thread>(ninst + 2);
    vm.lb = alloc<Thread>(ninst + 2);
    defer free(vm.la);
    defer free(vm.lb);
    vm.nA = 0;
    vm.nB = 0;
    // Each list holds at most one thread per instruction (visited dedups a pc per
    // generation), so ninst + 2 capture slots per list always suffice.
    const int64 slots = (int64)(ninst + 2) * vm.ncap;
    vm.capsA = alloc<int>(slots);
    vm.capsB = alloc<int>(slots);
    defer free(vm.capsA);
    defer free(vm.capsB);

    *int emptycaps = alloc<int>(vm.ncap);
    *int workcaps = alloc<int>(vm.ncap);
    *int bestcaps = alloc<int>(vm.ncap);
    defer free(emptycaps);
    defer free(workcaps);
    defer free(bestcaps);
    for (i in 0..vm.ncap) { emptycaps[i] = -1; }

    bool matched = false;
    int cur = 0;
    int glob = 1;
    int curgen = glob;

    for (int sp = 0; sp <= vm.len; sp++) {
        // Until a match is found, start a new thread at every position.
        if (!matched) {
            for (w in 0..vm.ncap) { workcaps[w] = emptycaps[w]; }
            re_addthread(&vm, cur, curgen, 0, workcaps, sp);
        }
        const int cn = cur == 0 ? vm.nA : vm.nB;
        if (cn == 0 && matched) { break; }
        const int oth = 1 - cur;
        const int nextgen = ++glob;
        if (oth == 0) { vm.nA = 0; } else { vm.nB = 0; }

        for (ci in 0..cn) {
            const int tpc = cur == 0 ? vm.la[ci].pc : vm.lb[ci].pc;
            *int tcaps = cur == 0 ? vm.la[ci].caps : vm.lb[ci].caps;
            Inst* ins = &re.inst[tpc];
            const int op = ins.op;
            if (op == OP_MATCH) {
                for (j in 0..vm.ncap) { bestcaps[j] = tcaps[j]; }
                matched = true;
                break;                          // cut lower-priority threads
            }
            if (sp >= vm.len) { continue; }
            const int ch = (int)((uint8)text[sp]);
            bool step = false;
            if (op == OP_CHAR)       { step = ch == ins.a; }
            else if (op == OP_ANY)   { step = ch != '\n'; }
            else if (op == OP_CLASS) { step = re_in_class(re, ins.a, ch) == 1; }
            if (step) { re_addthread(&vm, oth, nextgen, tpc + 1, tcaps, sp + 1); }
        }
        cur = oth;
        curgen = nextgen;
    }

    if (matched) {
        m.ok = 1;
        m.cap = alloc<int>(vm.ncap);
        for (j in 0..vm.ncap) { m.cap[j] = bestcaps[j]; }
        m.start = m.cap[0];
        m.end = m.cap[1];
    }
    return m.ok;
}

void Match_free(Match* m) {
    if (m.cap != null) { free(m.cap); m.cap = null; }
}

// Append capture group `i` (0 = whole match) of the last search into `out`,
// which must already be String_init'd. Does nothing if the group is unset.
void Match_group(Match* m, string text, int i, String* out) {
    if (m.ok == 0) { return; }
    if (i < 0 || i > m.ngroup) { return; }
    const int s = m.cap[2 * i];
    const int e = m.cap[2 * i + 1];
    if (s < 0 || e < 0 || e < s) { return; }
    for (k in s..e) { out.push(text[k]); }
}

// Convenience: does `pattern` match anywhere in `text`? Returns 1/0. Compiles
// and frees internally, so for repeated use prefer regex_compile + Regex_search.
int regex_match(string pattern, string text) {
    Regex re = regex_compile(pattern);
    if (re.ok == 0) { Regex_free(&re); return 0; }
    let m: Match;
    const int r = Regex_search(&re, text, &m);
    Match_free(&m);
    Regex_free(&re);
    return r;
}

// ── Deprecated names (kept so 0.9.1 code compiles; removed in a later release) ──
// deprecated: use Regex_search
int regex_search(Regex* re, string text, Match* m) { return Regex_search(re, text, m); }
// deprecated: use Regex_free
void regex_free(Regex* re) { Regex_free(re); }
// deprecated: use Match_group
void match_group(Match* m, string text, int i, String* out) { Match_group(m, text, i, out); }
// deprecated: use Match_free
void match_free(Match* m) { Match_free(m); }
