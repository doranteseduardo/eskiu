// Pure ASCII character classification — freestanding-safe (no libc ctype).
// Comparisons only. is_space replaces <string>'s deprecated String_is_space.
// Takes `int` to mirror the C++ <cctype> domain and avoid char/uint8 width
// surprises at call sites.

// isspace: space, \t, \n, \v, \f, \r  (matches std::isspace for the C locale)
int is_space(int c) {
    return (c == ' ' || c == '\t' || c == '\n' || c == '\v' || c == '\f' || c == '\r') ? 1 : 0;
}

int is_digit(int c) {
    return (c >= '0' && c <= '9') ? 1 : 0;
}

int is_hex(int c) {
    if (c >= '0' && c <= '9') { return 1; }
    if (c >= 'a' && c <= 'f') { return 1; }
    if (c >= 'A' && c <= 'F') { return 1; }
    return 0;
}

int is_alpha(int c) {
    return ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) ? 1 : 0;
}

int is_alnum(int c) {
    return (is_digit(c) == 1 || is_alpha(c) == 1) ? 1 : 0;
}

int is_ident_start(int c) {
    return (is_alpha(c) == 1 || c == '_') ? 1 : 0;
}

int is_ident_cont(int c) {
    return (is_alnum(c) == 1 || c == '_') ? 1 : 0;
}
