// time.esk: wall-clock and monotonic time, sleep, and the UTC civil calendar.
//
//   import <time>;
//   int64 t0 = time_monotonic_ms();
//   sleep_ms(50);
//   int64 dt = time_monotonic_ms() - t0;   // ~50

// The calendar helpers at the bottom build ISO 8601 strings, so <time> pulls in
// <string>; the clock functions above have no such dependency.
import <string>;

// POSIX timespec. On 64-bit macOS and Linux both fields are 64-bit.
#ifdef _WIN32
// Windows (kernel32). It has no `clock_gettime`/`nanosleep`, and its `struct timespec`'s
// `tv_nsec` is a 32-bit `long` (LLP64) that would not match a 64-bit field, so use the Win32
// clocks directly. FILETIME is 100ns ticks since 1601-01-01; the offset to the Unix epoch
// (1970) is 116444736000000000 of them.
extern int64 GetTickCount64();
extern void  Sleep(int ms);
extern void  GetSystemTimeAsFileTime(*int64 ft);

int64 time_now_ms() {
    let ft: int64 = 0;  GetSystemTimeAsFileTime(&ft);
    return (ft - 116444736000000000) / 10000;      // 100ns -> ms
}
int64 time_now_s() {
    let ft: int64 = 0;  GetSystemTimeAsFileTime(&ft);
    return (ft - 116444736000000000) / 10000000;   // 100ns -> s
}
int64 time_monotonic_ms() { return GetTickCount64(); }   // ms since boot, monotonic
void  sleep_ms(int64 ms)  { Sleep((int)ms); }
#else
struct timespec {
    int64 tv_sec;
    int64 tv_nsec;
}

extern int clock_gettime(int clk_id, timespec* tp);
extern int nanosleep(timespec* req, timespec* rem);

// CLOCK_REALTIME is 0 on both platforms; CLOCK_MONOTONIC differs.
#ifdef __APPLE__
#define CLOCK_MONO 6
#else
#define CLOCK_MONO 1
#endif

// Milliseconds since the Unix epoch (wall clock; can jump if the clock is set).
int64 time_now_ms() {
    let ts: timespec;
    clock_gettime(0, &ts);
    return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

// Seconds since the Unix epoch.
int64 time_now_s() {
    let ts: timespec;
    clock_gettime(0, &ts);
    return ts.tv_sec;
}

// Milliseconds from an arbitrary monotonic origin — never goes backwards.
// Use this for measuring durations, not time_now_ms.
int64 time_monotonic_ms() {
    let ts: timespec;
    clock_gettime(CLOCK_MONO, &ts);
    return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

// Sleep for the given number of milliseconds.
void sleep_ms(int64 ms) {
    let req: timespec;
    req.tv_sec  = ms / 1000;
    req.tv_nsec = (ms % 1000) * 1000000;
    nanosleep(&req, null);
}
#endif

// ── Civil calendar (UTC) ────────────────────────────────────────────────────
//
//   import <time>; import <string>;
//   let dt: DateTime; time_to_utc(time_now_s(), &dt);
//   let s: String; String_init(&s, 24);
//   DateTime_format_iso(&dt, &s);        // "2026-07-13T18:30:00Z"
//
// Conversions use Howard Hinnant's days<->civil algorithm, which is exact for
// the proleptic Gregorian calendar for every year that fits DateTime.year (an
// int, about +/-2.1 billion years). UTC only; there is no timezone or
// leap-second handling.

struct DateTime {
    int year;
    int month;      // 1..12
    int day;        // 1..31
    int hour;       // 0..23
    int min;        // 0..59
    int sec;        // 0..59
    int wday;       // 0=Sunday .. 6=Saturday
    int yday;       // 0..365, days since Jan 1
}

// Days since the Unix epoch for a civil (y, m, d). Inverse of the split below.
// Integer division truncates toward zero, so negative values are biased first
// to round the era down.
int64 time_days_from_civil(int64 y, int m, int d) {
    if (m <= 2) { y--; }
    const int64 era = (y >= 0 ? y : y - 399) / 400;
    const int64 yoe = y - era * 400;
    const int64 mp = m > 2 ? m - 3 : m + 9;
    const int64 doy = (153 * mp + 2) / 5 + d - 1;
    const int64 doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

// Split an epoch-seconds timestamp (UTC) into its calendar fields.
void time_to_utc(int64 t, DateTime* dt) {
    int64 days = t / 86400;
    int64 secs = t % 86400;
    if (secs < 0) { secs += 86400; days--; }
    dt.hour = (int)(secs / 3600);
    dt.min = (int)((secs % 3600) / 60);
    dt.sec = (int)(secs % 60);

    int64 wd = (days % 7 + 4) % 7;          // 1970-01-01 was a Thursday
    if (wd < 0) { wd += 7; }
    dt.wday = (int)wd;

    const int64 z = days + 719468;
    const int64 era = (z >= 0 ? z : z - 146096) / 146097;
    const int64 doe = z - era * 146097;
    const int64 yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    const int64 y = yoe + era * 400;
    const int64 doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    const int64 mp = (5 * doy + 2) / 153;
    dt.day = (int)(doy - (153 * mp + 2) / 5 + 1);
    dt.month = (int)(mp < 10 ? mp + 3 : mp - 9);
    dt.year = (int)(dt.month <= 2 ? y + 1 : y);

    dt.yday = (int)(days - time_days_from_civil(dt.year, 1, 1));
}

// The epoch-seconds timestamp (UTC) for a DateTime's y/m/d/h/m/s fields.
int64 DateTime_to_epoch(DateTime* dt) {
    const int64 days = time_days_from_civil(dt.year, dt.month, dt.day);
    return days * 86400 + dt.hour * 3600 + dt.min * 60 + dt.sec;
}

// Append `v` as `width` zero-padded decimal digits to `out` (helper). A
// negative value gets its sign first, then the padded magnitude ("-0001").
void time_pad(String* out, int v, int width) {
    let tmp: String;
    tmp.init(8);
    defer tmp.free();
    int64 mag = v;
    if (mag < 0) { out.push('-'); mag = -mag; }
    // Collect the digits least significant first, then flip them.
    do {
        tmp.push((char)('0' + (int)(mag % 10)));
        mag /= 10;
    } while (mag > 0);
    tmp.reverse();
    for (int64 pad = width - tmp.len; pad > 0; pad--) { out.push('0'); }
    out.concat(&tmp);
}

// Append the ISO 8601 UTC form "YYYY-MM-DDTHH:MM:SSZ" to `out`. A year before
// 0 uses the expanded sign form ("-0001-..."); a year past 9999 uses more digits.
void DateTime_format_iso(DateTime* dt, String* out) {
    time_pad(out, dt.year, 4);
    out.push('-');
    time_pad(out, dt.month, 2);
    out.push('-');
    time_pad(out, dt.day, 2);
    out.push('T');
    time_pad(out, dt.hour, 2);
    out.push(':');
    time_pad(out, dt.min, 2);
    out.push(':');
    time_pad(out, dt.sec, 2);
    out.push('Z');
}

// ── Deprecated names (kept so 0.9.1 code compiles; removed in a later release) ──
// deprecated: use DateTime_to_epoch
int64 time_from_utc(DateTime* dt) { return DateTime_to_epoch(dt); }
// deprecated: use DateTime_format_iso
void time_format_iso(DateTime* dt, String* out) { DateTime_format_iso(dt, out); }
