// hash.esk: SHA-256, SHA-1, MD5, HMAC-SHA256 and hex, in pure Eskiu (no OpenSSL).
//
//   let hex: String;  hex.init(65);
//   hash_sha256_str("abc", &hex);              // ba7816bf8f01cfea...
//
//   let h: Sha256;  h.init();             // streaming
//   h.update(buf, n);  h.update_str("more");
//   let digest: uint8[32];  h.final(&digest[0]);
//
//   hash_hmac_sha256_str("key", "message", &hex);
//   if (hash_equal(&mac[0], &expected[0], 32) == 1) { ... }   // constant time
//
// Each algorithm has a streaming type (`Sha256`, `Sha1`, `Md5`, `HmacSha256`:
// init, update, update_str, final, final_hex) and one-shot functions over bytes
// (`hash_sha256(data, n, out)` writes the raw digest, `hash_sha256_hex(data, n, out)` the
// lowercase hex) and over a C string (`hash_sha256_str(s, out)`, hex). Raw digests are
// SHA256_SIZE (32), SHA1_SIZE (20) and MD5_SIZE (16) bytes, written to a buffer
// the caller provides. A hex result goes into a caller-initialised String,
// cleared first. After `final` a streaming value must be `init`ed again before
// reuse. SHA-1 and MD5 are broken for collision resistance: use them only to
// match existing checksums, and SHA-256 or HMAC-SHA256 for anything new.

import <string>;

const int SHA256_SIZE = 32;
const int SHA1_SIZE = 20;
const int MD5_SIZE = 16;

// ── Hex ──────────────────────────────────────────────────────────────────────

// Lowercase hex of `n` bytes at `data` into `out` (cleared first).
void hash_hex_encode(*uint8 data, int64 n, String* out) {
    out.clear();
    String_reserve(out, n * 2 + 1);
    for (int64 i = 0; i < n; i++) {
        const int b = (int)data[i];
        out.push("0123456789abcdef"[b >> 4]);
        out.push("0123456789abcdef"[b & 15]);
    }
}

int _hex_digit(char c) {
    if (c >= '0' && c <= '9') {
        return (int)c - '0';
    }
    if (c >= 'a' && c <= 'f') {
        return (int)c - 'a' + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return (int)c - 'A' + 10;
    }
    return -1;
}

// Decode the hex text `s` (either case, no separators) into `out`, which has
// room for `cap` bytes. Returns the number of bytes written, or -1 when `s` has
// an odd length, a non-hex character, or decodes to more than `cap` bytes
// (nothing useful is left in `out` then).
int64 hash_hex_decode(string s, *uint8 out, int64 cap) {
    const int64 n = strlen(s);
    if (n % 2 != 0 || n / 2 > cap) {
        return -1;
    }
    for (int64 i = 0; i < n; i += 2) {
        const int hi = _hex_digit(s[i]);
        const int lo = _hex_digit(s[i + 1]);
        if (hi < 0 || lo < 0) {
            return -1;
        }
        out[i / 2] = (uint8)(hi * 16 + lo);
    }
    return n / 2;
}

// 1 if the `n` bytes at `a` and `b` are equal, else 0. The time taken depends
// only on `n`, not on where the bytes differ, so it is safe for comparing MACs
// and password hashes.
int hash_equal(*uint8 a, *uint8 b, int64 n) {
    uint8 diff = 0;
    for (int64 i = 0; i < n; i++) {
        diff = diff | (a[i] ^ b[i]);
    }
    return diff == 0 ? 1 : 0;
}

// hash_equal over two C strings (such as hex digests). Strings of different
// lengths are unequal; the length itself is not hidden.
int hash_equal_str(string a, string b) {
    const int64 n = strlen(a);
    if (strlen(b) != n) {
        return 0;
    }
    return hash_equal((*uint8)a, (*uint8)b, n);
}

uint32 _rotr32(uint32 x, int n) {
    return (x >> n) | (x << (32 - n));
}

uint32 _rotl32(uint32 x, int n) {
    return (x << n) | (x >> (32 - n));
}

uint32 _be32(*uint8 p) {
    return ((uint32)p[0] << 24) | ((uint32)p[1] << 16) | ((uint32)p[2] << 8) | (uint32)p[3];
}

uint32 _le32(*uint8 p) {
    return ((uint32)p[3] << 24) | ((uint32)p[2] << 16) | ((uint32)p[1] << 8) | (uint32)p[0];
}

void _put_be32(*uint8 p, uint32 v) {
    p[0] = (uint8)(v >> 24);
    p[1] = (uint8)(v >> 16);
    p[2] = (uint8)(v >> 8);
    p[3] = (uint8)v;
}

void _put_le32(*uint8 p, uint32 v) {
    p[0] = (uint8)v;
    p[1] = (uint8)(v >> 8);
    p[2] = (uint8)(v >> 16);
    p[3] = (uint8)(v >> 24);
}

// ── SHA-256 (FIPS 180-4) ─────────────────────────────────────────────────────

const uint32[64] _SHA256_K = {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
};

struct Sha256 {
    uint32[8] h;
    uint8[64] buf;
    int64 buflen;   // bytes waiting in buf
    uint64 total;    // bytes hashed so far
}

void Sha256_init(Sha256* self) {
    self.h[0] = 0x6a09e667;
    self.h[1] = 0xbb67ae85;
    self.h[2] = 0x3c6ef372;
    self.h[3] = 0xa54ff53a;
    self.h[4] = 0x510e527f;
    self.h[5] = 0x9b05688c;
    self.h[6] = 0x1f83d9ab;
    self.h[7] = 0x5be0cd19;
    self.buflen = 0;
    self.total = 0;
}

void _sha256_block(Sha256* self, *uint8 p) {
    let w: uint32[64];
    for (int i = 0; i < 16; i++) {
        w[i] = _be32(p + i * 4);
    }
    for (int i = 16; i < 64; i++) {
        const uint32 s0 = _rotr32(w[i - 15], 7) ^ _rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3);
        const uint32 s1 = _rotr32(w[i - 2], 17) ^ _rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    uint32 a = self.h[0];
    uint32 b = self.h[1];
    uint32 c = self.h[2];
    uint32 d = self.h[3];
    uint32 e = self.h[4];
    uint32 f = self.h[5];
    uint32 g = self.h[6];
    uint32 h = self.h[7];
    for (int i = 0; i < 64; i++) {
        const uint32 s1 = _rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25);
        const uint32 ch = (e & f) ^ (~e & g);
        const uint32 t1 = h + s1 + ch + _SHA256_K[i] + w[i];
        const uint32 s0 = _rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22);
        const uint32 mj = (a & b) ^ (a & c) ^ (b & c);
        const uint32 t2 = s0 + mj;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }
    self.h[0] += a;
    self.h[1] += b;
    self.h[2] += c;
    self.h[3] += d;
    self.h[4] += e;
    self.h[5] += f;
    self.h[6] += g;
    self.h[7] += h;
}

void Sha256_update(Sha256* self, *uint8 data, int64 n) {
    self.total += (uint64)n;
    int64 i = 0;
    while (i < n) {
        if (self.buflen == 0 && n - i >= 64) {
            _sha256_block(self, data + i);
            i += 64;
            continue;
        }
        self.buf[self.buflen] = data[i];
        self.buflen++;
        i++;
        if (self.buflen == 64) {
            _sha256_block(self, &self.buf[0]);
            self.buflen = 0;
        }
    }
}

void Sha256_update_str(Sha256* self, string s) {
    Sha256_update(self, (*uint8)s, strlen(s));
}

// Finish and write the 32-byte digest to `out`.
void Sha256_final(Sha256* self, *uint8 out) {
    const uint64 bits = self.total * 8;
    let pad: uint8[72];
    int64 np = 64 - self.buflen;
    if (np < 9) {
        np += 64;
    }
    for (int64 i = 0; i < np; i++) {
        pad[i] = 0;
    }
    pad[0] = 0x80;
    for (int k = 0; k < 8; k++) {
        pad[np - 1 - k] = (uint8)(bits >> (k * 8));
    }
    Sha256_update(self, &pad[0], np);
    for (int i = 0; i < 8; i++) {
        _put_be32(out + i * 4, self.h[i]);
    }
}

void Sha256_final_hex(Sha256* self, String* out) {
    let d: uint8[32];
    Sha256_final(self, &d[0]);
    hash_hex_encode(&d[0], 32, out);
}

void hash_sha256(*uint8 data, int64 n, *uint8 out) {
    let h: Sha256;
    Sha256_init(&h);
    Sha256_update(&h, data, n);
    Sha256_final(&h, out);
}

void hash_sha256_hex(*uint8 data, int64 n, String* out) {
    let h: Sha256;
    Sha256_init(&h);
    Sha256_update(&h, data, n);
    Sha256_final_hex(&h, out);
}

void hash_sha256_str(string s, String* out) {
    hash_sha256_hex((*uint8)s, strlen(s), out);
}

// ── SHA-1 (FIPS 180-4) ───────────────────────────────────────────────────────

struct Sha1 {
    uint32[5] h;
    uint8[64] buf;
    int64 buflen;
    uint64 total;
}

void Sha1_init(Sha1* self) {
    self.h[0] = 0x67452301;
    self.h[1] = 0xefcdab89;
    self.h[2] = 0x98badcfe;
    self.h[3] = 0x10325476;
    self.h[4] = 0xc3d2e1f0;
    self.buflen = 0;
    self.total = 0;
}

void _sha1_block(Sha1* self, *uint8 p) {
    let w: uint32[80];
    for (int i = 0; i < 16; i++) {
        w[i] = _be32(p + i * 4);
    }
    for (int i = 16; i < 80; i++) {
        w[i] = _rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
    }
    uint32 a = self.h[0];
    uint32 b = self.h[1];
    uint32 c = self.h[2];
    uint32 d = self.h[3];
    uint32 e = self.h[4];
    for (int i = 0; i < 80; i++) {
        uint32 f = 0;
        uint32 k = 0;
        if (i < 20) {
            f = (b & c) | (~b & d);
            k = 0x5a827999;
        }
        else if (i < 40) {
            f = b ^ c ^ d;
            k = 0x6ed9eba1;
        }
        else if (i < 60) {
            f = (b & c) | (b & d) | (c & d);
            k = 0x8f1bbcdc;
        }
        else {
            f = b ^ c ^ d;
            k = 0xca62c1d6;
        }
        const uint32 t = _rotl32(a, 5) + f + e + k + w[i];
        e = d;
        d = c;
        c = _rotl32(b, 30);
        b = a;
        a = t;
    }
    self.h[0] += a;
    self.h[1] += b;
    self.h[2] += c;
    self.h[3] += d;
    self.h[4] += e;
}

void Sha1_update(Sha1* self, *uint8 data, int64 n) {
    self.total += (uint64)n;
    int64 i = 0;
    while (i < n) {
        if (self.buflen == 0 && n - i >= 64) {
            _sha1_block(self, data + i);
            i += 64;
            continue;
        }
        self.buf[self.buflen] = data[i];
        self.buflen++;
        i++;
        if (self.buflen == 64) {
            _sha1_block(self, &self.buf[0]);
            self.buflen = 0;
        }
    }
}

void Sha1_update_str(Sha1* self, string s) {
    Sha1_update(self, (*uint8)s, strlen(s));
}

// Finish and write the 20-byte digest to `out`.
void Sha1_final(Sha1* self, *uint8 out) {
    const uint64 bits = self.total * 8;
    let pad: uint8[72];
    int64 np = 64 - self.buflen;
    if (np < 9) {
        np += 64;
    }
    for (int64 i = 0; i < np; i++) {
        pad[i] = 0;
    }
    pad[0] = 0x80;
    for (int k = 0; k < 8; k++) {
        pad[np - 1 - k] = (uint8)(bits >> (k * 8));
    }
    Sha1_update(self, &pad[0], np);
    for (int i = 0; i < 5; i++) {
        _put_be32(out + i * 4, self.h[i]);
    }
}

void Sha1_final_hex(Sha1* self, String* out) {
    let d: uint8[20];
    Sha1_final(self, &d[0]);
    hash_hex_encode(&d[0], 20, out);
}

void hash_sha1(*uint8 data, int64 n, *uint8 out) {
    let h: Sha1;
    Sha1_init(&h);
    Sha1_update(&h, data, n);
    Sha1_final(&h, out);
}

void hash_sha1_hex(*uint8 data, int64 n, String* out) {
    let h: Sha1;
    Sha1_init(&h);
    Sha1_update(&h, data, n);
    Sha1_final_hex(&h, out);
}

void hash_sha1_str(string s, String* out) {
    hash_sha1_hex((*uint8)s, strlen(s), out);
}

// ── MD5 (RFC 1321) ───────────────────────────────────────────────────────────

const uint32[64] _MD5_K = {
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
};

const int[16] _MD5_S = { 7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21 };

struct Md5 {
    uint32[4] h;
    uint8[64] buf;
    int64 buflen;
    uint64 total;
}

void Md5_init(Md5* self) {
    self.h[0] = 0x67452301;
    self.h[1] = 0xefcdab89;
    self.h[2] = 0x98badcfe;
    self.h[3] = 0x10325476;
    self.buflen = 0;
    self.total = 0;
}

void _md5_block(Md5* self, *uint8 p) {
    let m: uint32[16];
    for (int i = 0; i < 16; i++) {
        m[i] = _le32(p + i * 4);
    }
    uint32 a = self.h[0];
    uint32 b = self.h[1];
    uint32 c = self.h[2];
    uint32 d = self.h[3];
    for (int i = 0; i < 64; i++) {
        uint32 f = 0;
        int g = 0;
        if (i < 16) {
            f = (b & c) | (~b & d);
            g = i;
        }
        else if (i < 32) {
            f = (d & b) | (~d & c);
            g = (5 * i + 1) % 16;
        }
        else if (i < 48) {
            f = b ^ c ^ d;
            g = (3 * i + 5) % 16;
        }
        else {
            f = c ^ (b | ~d);
            g = (7 * i) % 16;
        }
        f = f + a + _MD5_K[i] + m[g];
        a = d;
        d = c;
        c = b;
        b = b + _rotl32(f, _MD5_S[(i / 16) * 4 + i % 4]);
    }
    self.h[0] += a;
    self.h[1] += b;
    self.h[2] += c;
    self.h[3] += d;
}

void Md5_update(Md5* self, *uint8 data, int64 n) {
    self.total += (uint64)n;
    int64 i = 0;
    while (i < n) {
        if (self.buflen == 0 && n - i >= 64) {
            _md5_block(self, data + i);
            i += 64;
            continue;
        }
        self.buf[self.buflen] = data[i];
        self.buflen++;
        i++;
        if (self.buflen == 64) {
            _md5_block(self, &self.buf[0]);
            self.buflen = 0;
        }
    }
}

void Md5_update_str(Md5* self, string s) {
    Md5_update(self, (*uint8)s, strlen(s));
}

// Finish and write the 16-byte digest to `out`.
void Md5_final(Md5* self, *uint8 out) {
    const uint64 bits = self.total * 8;
    let pad: uint8[72];
    int64 np = 64 - self.buflen;
    if (np < 9) {
        np += 64;
    }
    for (int64 i = 0; i < np; i++) {
        pad[i] = 0;
    }
    pad[0] = 0x80;
    for (int k = 0; k < 8; k++) {   // little-endian length
        pad[np - 8 + k] = (uint8)(bits >> (k * 8));
    }
    Md5_update(self, &pad[0], np);
    for (int i = 0; i < 4; i++) {
        _put_le32(out + i * 4, self.h[i]);
    }
}

void Md5_final_hex(Md5* self, String* out) {
    let d: uint8[16];
    Md5_final(self, &d[0]);
    hash_hex_encode(&d[0], 16, out);
}

void hash_md5(*uint8 data, int64 n, *uint8 out) {
    let h: Md5;
    Md5_init(&h);
    Md5_update(&h, data, n);
    Md5_final(&h, out);
}

void hash_md5_hex(*uint8 data, int64 n, String* out) {
    let h: Md5;
    Md5_init(&h);
    Md5_update(&h, data, n);
    Md5_final_hex(&h, out);
}

void hash_md5_str(string s, String* out) {
    hash_md5_hex((*uint8)s, strlen(s), out);
}

// ── HMAC-SHA256 (RFC 2104, RFC 4231) ─────────────────────────────────────────

struct HmacSha256 {
    Sha256 inner;
    uint8[64] okey;   // key XOR opad, for the outer hash
}

// Start a MAC under the `klen`-byte key (a key longer than 64 bytes is hashed
// first, as the RFC says).
void HmacSha256_init(HmacSha256* self, *uint8 key, int64 klen) {
    let k: uint8[64];
    for (int i = 0; i < 64; i++) {
        k[i] = 0;
    }
    if (klen > 64) {
        hash_sha256(key, klen, &k[0]);
    }
    else {
        for (int64 i = 0; i < klen; i++) {
            k[i] = key[i];
        }
    }
    let ikey: uint8[64];
    for (int i = 0; i < 64; i++) {
        ikey[i] = k[i] ^ 0x36;
        self.okey[i] = k[i] ^ 0x5c;
    }
    Sha256_init(&self.inner);
    Sha256_update(&self.inner, &ikey[0], 64);
}

void HmacSha256_update(HmacSha256* self, *uint8 data, int64 n) {
    Sha256_update(&self.inner, data, n);
}

void HmacSha256_update_str(HmacSha256* self, string s) {
    Sha256_update(&self.inner, (*uint8)s, strlen(s));
}

// Finish and write the 32-byte MAC to `out`.
void HmacSha256_final(HmacSha256* self, *uint8 out) {
    let ih: uint8[32];
    Sha256_final(&self.inner, &ih[0]);
    let o: Sha256;
    Sha256_init(&o);
    Sha256_update(&o, &self.okey[0], 64);
    Sha256_update(&o, &ih[0], 32);
    Sha256_final(&o, out);
}

void HmacSha256_final_hex(HmacSha256* self, String* out) {
    let d: uint8[32];
    HmacSha256_final(self, &d[0]);
    hash_hex_encode(&d[0], 32, out);
}

void hash_hmac_sha256(*uint8 key, int64 klen, *uint8 data, int64 n, *uint8 out) {
    let m: HmacSha256;
    HmacSha256_init(&m, key, klen);
    HmacSha256_update(&m, data, n);
    HmacSha256_final(&m, out);
}

// Hex HMAC-SHA256 of the C string `msg` under the C string `key`.
void hash_hmac_sha256_str(string key, string msg, String* out) {
    let m: HmacSha256;
    HmacSha256_init(&m, (*uint8)key, strlen(key));
    HmacSha256_update(&m, (*uint8)msg, strlen(msg));
    HmacSha256_final_hex(&m, out);
}
