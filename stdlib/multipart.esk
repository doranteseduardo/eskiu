// multipart.esk — extract a named part from a multipart/form-data body.
//
// Operates on the raw binary body (*uint8 + len), never a String, so file
// bytes survive intact. Pairs with <http>'s HttpReq (binary body).
//
//   let bd: String;  String_init(&bd, 64);
//   if (multipart_boundary(&contentType, &bd) == 1) {
//       *uint8 part;  int64 plen;
//       if (multipart_part(req.body, req.body_len, &bd, "photo", &part, &plen) == 1) {
//           // `part` points into req.body (no copy); plen bytes
//       }
//   }

import <mem>;
import <string>;

extern *void memmem(*void hay, int64 hlen, *void needle, int64 nlen);
extern int64   strlen(string s);

// Offset of `needle` within hay[from..hlen), or -1.
int64 mp_find(*uint8 hay, int64 hlen, int64 from, *uint8 needle, int64 nlen) {
    if (from < 0 || from >= hlen) { return -1; }
    *void p = memmem((*void)(hay + from), hlen - from, (*void)needle, nlen);
    return p == null ? -1 : (int64)((*uint8)p - hay);
}

// Parse the boundary token from a Content-Type value
// ("multipart/form-data; boundary=----abc"). Strips optional quotes. 1 = ok.
int multipart_boundary(String* ctype, String* out) {
    out.clear();
    const string key = "boundary=";
    const int n = ctype.len;
    const int klen = strlen(key);
    for (int i = 0; i + klen <= n; i++) {
        bool hit = true;
        for (int j = 0; hit && j < klen; j++) {
            if (ctype.data[i + j] != key[j]) { hit = false; }
        }
        if (!hit) { continue; }
        int k = i + klen;
        if (k < n && ctype.data[k] == '"') { k++; }
        for (; k < n; k++) {
            const char c = ctype.data[k];
            if (c == '"' || c == ';' || c == ' ' || c == '\r') { break; }
            out.push(c);
        }
        return out.len > 0 ? 1 : 0;
    }
    return 0;
}

// Locate the form-data part with `name="<name>"`. On success returns 1 and sets
// *out_ptr / *out_len to a slice INTO `body` (no copy). 0 if absent.
int multipart_part(*uint8 body, int64 blen, String* boundary, string name,
                   **uint8 out_ptr, *int64 out_len) {
    const int bl = boundary.len;
    const int dlen = bl + 2;
    *uint8 delim = alloc<uint8>(dlen);
    defer free(delim);
    delim[0] = '-';  delim[1] = '-';
    for (i in 0..bl) { delim[2 + i] = (uint8)boundary.data[i]; }

    // Build the "name=\"<name>\"" needle.
    const int nlen = strlen(name);
    const int needle_len = nlen + 7;                 // name="" → 6 chars + the name
    *uint8 needle = alloc<uint8>(needle_len);
    defer free(needle);
    const string pre = "name=\"";
    for (p in 0..6) { needle[p] = (uint8)pre[p]; }
    for (q in 0..nlen) { needle[6 + q] = (uint8)name[q]; }
    needle[6 + nlen] = '"';                          // closing quote

    const string crlf2 = "\r\n\r\n";

    int64 pos = mp_find(body, blen, 0, delim, dlen);
    while (pos >= 0) {
        const int64 part_start = pos + dlen;
        const int64 next = mp_find(body, blen, part_start, delim, dlen);
        if (next < 0) { break; }
        const int64 he = mp_find(body, next, part_start, (*uint8)crlf2, 4);
        if (he >= 0) {
            // The needle must be the `name` parameter itself: preceded by ';' or
            // whitespace, so `filename="photo"` does not match name "photo".
            bool named = false;
            int64 nh = mp_find(body, he, part_start, needle, needle_len);
            while (nh >= 0 && !named) {
                if (nh > part_start) {
                    const uint8 pc = body[nh - 1];
                    named = pc == ';' || pc == ' ' || pc == '\t';
                }
                if (!named) { nh = mp_find(body, he, nh + 1, needle, needle_len); }
            }
            const int64 cstart = he + 4;
            const int64 cend   = next - 2;
            if (named && cend >= cstart) {
                out_ptr[0] = body + cstart;
                out_len[0] = cend - cstart;
                return 1;
            }
        }
        pos = next;
    }
    return 0;
}
