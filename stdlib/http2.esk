// http2.esk — HTTP/2 (RFC 7540) over the async event loop.
//
// Status: STAGE 1 — the frame layer. HTTP/2 is a binary, multiplexed protocol;
// every exchange is a sequence of frames sharing one connection. This module
// encodes/decodes the 9-byte frame header and defines the frame-type and flag
// constants. Later stages build on it: SETTINGS handshake, HPACK header
// (de)compression, stream multiplexing + flow control, and TLS/ALPN. See
// docs/dev/http2-design.md for the roadmap.
//
// Frame header (RFC 7540 §4.1), 9 bytes, big-endian:
//   [ Length (24) | Type (8) | Flags (8) | R(1) | Stream Id (31) ]

import <mem>;
import <future>;
import <eventloop>;
import <net_async>;
import <net>;

// Frame types (§6).
const int H2_DATA          = 0;
const int H2_HEADERS       = 1;
const int H2_PRIORITY      = 2;
const int H2_RST_STREAM    = 3;
const int H2_SETTINGS      = 4;
const int H2_PUSH_PROMISE  = 5;
const int H2_PING          = 6;
const int H2_GOAWAY        = 7;
const int H2_WINDOW_UPDATE = 8;
const int H2_CONTINUATION  = 9;

// Frame flags (§6) — shared bit positions across frame types.
const int H2_FLAG_END_STREAM  = 1;     // 0x1 on DATA / HEADERS
const int H2_FLAG_ACK         = 1;     // 0x1 on SETTINGS / PING
const int H2_FLAG_END_HEADERS = 4;     // 0x4 on HEADERS / CONTINUATION
const int H2_FLAG_PADDED      = 8;     // 0x8
const int H2_FLAG_PRIORITY    = 32;    // 0x20 on HEADERS

const int H2_FRAME_HEADER_LEN = 9;

// The client connection preface that opens every HTTP/2 connection (§3.5):
// "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" (24 bytes), followed by a SETTINGS frame.
string h2_preface() { return "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"; }

// A decoded frame header (the payload follows in the stream).
struct H2Frame {
    int length;        // payload length (0 .. 2^24-1)
    int type;          // H2_* frame type
    int flags;
    int stream_id;     // 31-bit; 0 = connection control
}

// Write the 9-byte frame header into `buf` (must hold >= 9 bytes), big-endian.
void h2_write_header(*uint8 buf, H2Frame* f) {
    buf[0] = (uint8)((f.length >> 16) & 255);
    buf[1] = (uint8)((f.length >> 8) & 255);
    buf[2] = (uint8)(f.length & 255);
    buf[3] = (uint8)(f.type & 255);
    buf[4] = (uint8)(f.flags & 255);
    buf[5] = (uint8)((f.stream_id >> 24) & 127);   // top bit reserved (R), kept 0
    buf[6] = (uint8)((f.stream_id >> 16) & 255);
    buf[7] = (uint8)((f.stream_id >> 8) & 255);
    buf[8] = (uint8)(f.stream_id & 255);
}

// Parse a 9-byte frame header from `buf` into `f`.
void h2_read_header(*uint8 buf, H2Frame* f) {
    f.length    = ((int)buf[0] << 16) | ((int)buf[1] << 8) | (int)buf[2];
    f.type      = (int)buf[3];
    f.flags     = (int)buf[4];
    f.stream_id = (((int)buf[5] & 127) << 24) | ((int)buf[6] << 16) |
                  ((int)buf[7] << 8) | (int)buf[8];
}

// Write a full frame (9-byte header + `len` payload bytes already at `buf+9`)
// — fills the header in place. Returns the total frame size (9 + len).
int h2_frame_finish(*uint8 buf, int type, int flags, int stream_id, int len) {
    let f: H2Frame;
    f.length = len; f.type = type; f.flags = flags; f.stream_id = stream_id;
    h2_write_header(buf, &f);
    return H2_FRAME_HEADER_LEN + len;
}

// ── Stage 2: connection lifecycle (SETTINGS, PING, GOAWAY) ───────────────────
//
// HTTP/2 opens with the client preface ("PRI * HTTP/2.0…" + a SETTINGS frame);
// both peers exchange SETTINGS and ACK them. PING/PONG keeps a connection live
// and measures RTT; GOAWAY initiates an orderly shutdown naming the last stream
// the sender will process. All connection-control frames use stream id 0.

// SETTINGS parameters (§6.5.2).
const int H2_SETTINGS_HEADER_TABLE_SIZE      = 1;
const int H2_SETTINGS_ENABLE_PUSH            = 2;
const int H2_SETTINGS_MAX_CONCURRENT_STREAMS = 3;
const int H2_SETTINGS_INITIAL_WINDOW_SIZE    = 4;
const int H2_SETTINGS_MAX_FRAME_SIZE         = 5;
const int H2_SETTINGS_MAX_HEADER_LIST_SIZE   = 6;

// Error codes (§7), used by RST_STREAM and GOAWAY.
const int H2_NO_ERROR            = 0;
const int H2_PROTOCOL_ERROR      = 1;
const int H2_INTERNAL_ERROR      = 2;
const int H2_FLOW_CONTROL_ERROR  = 3;
const int H2_SETTINGS_TIMEOUT    = 4;
const int H2_STREAM_CLOSED       = 5;
const int H2_FRAME_SIZE_ERROR    = 6;
const int H2_REFUSED_STREAM      = 7;
const int H2_CANCEL              = 8;
const int H2_COMPRESSION_ERROR   = 9;
const int H2_CONNECT_ERROR       = 10;
const int H2_ENHANCE_YOUR_CALM   = 11;
const int H2_INADEQUATE_SECURITY = 12;
const int H2_HTTP_1_1_REQUIRED   = 13;

// A peer's SETTINGS, as the six standard parameters. Values are 32-bit unsigned
// on the wire, so they are held as int64 to stay exact (a window or table size
// may exceed the signed-int range). `enable_push` is a 0/1 boolean.
struct H2Settings {
    int64 header_table_size;
    int   enable_push;
    int64 max_concurrent_streams;
    int64 initial_window_size;
    int64 max_frame_size;
    int64 max_header_list_size;
}

// RFC 7540 §6.5.2 defaults. `max_concurrent_streams` / `max_header_list_size`
// are "unlimited" by default; we model that as -1 (advertise no explicit limit).
void h2_settings_defaults(H2Settings* s) {
    s.header_table_size      = (int64)4096;
    s.enable_push            = 1;
    s.max_concurrent_streams = (int64)(-1);
    s.initial_window_size    = (int64)65535;
    s.max_frame_size         = (int64)16384;
    s.max_header_list_size   = (int64)(-1);
}

// Write a big-endian 32-bit value at buf[off..off+4).
void h2_put_u32(*uint8 buf, int off, int64 v) {
    buf[off]     = (uint8)((v >> 24) & (int64)255);
    buf[off + 1] = (uint8)((v >> 16) & (int64)255);
    buf[off + 2] = (uint8)((v >> 8)  & (int64)255);
    buf[off + 3] = (uint8)(v & (int64)255);
}

// Read a big-endian 32-bit value (as a non-negative int64) from buf[off..off+4).
int64 h2_get_u32(*uint8 buf, int off) {
    return ((int64)buf[off] << 24) | ((int64)buf[off + 1] << 16) |
           ((int64)buf[off + 2] << 8) | (int64)buf[off + 3];
}

// Append one SETTINGS entry (id:16, value:32) at `buf+off`; returns off + 6.
int h2_put_setting(*uint8 buf, int off, int id, int64 value) {
    buf[off]     = (uint8)((id >> 8) & 255);
    buf[off + 1] = (uint8)(id & 255);
    h2_put_u32(buf, off + 2, value);            // value at off+2 .. off+6
    return off + 6;
}

// Build a SETTINGS frame from `s` into `buf` (>= 45 bytes). A parameter set to
// -1 ("unlimited") is omitted. Returns the total frame size.
int h2_write_settings(*uint8 buf, H2Settings* s) {
    int p = H2_FRAME_HEADER_LEN;                 // payload starts after the header
    p = h2_put_setting(buf, p, H2_SETTINGS_HEADER_TABLE_SIZE,   s.header_table_size);
    p = h2_put_setting(buf, p, H2_SETTINGS_ENABLE_PUSH,        (int64)s.enable_push);
    if (s.max_concurrent_streams >= (int64)0)
        p = h2_put_setting(buf, p, H2_SETTINGS_MAX_CONCURRENT_STREAMS, s.max_concurrent_streams);
    p = h2_put_setting(buf, p, H2_SETTINGS_INITIAL_WINDOW_SIZE, s.initial_window_size);
    p = h2_put_setting(buf, p, H2_SETTINGS_MAX_FRAME_SIZE,      s.max_frame_size);
    if (s.max_header_list_size >= (int64)0)
        p = h2_put_setting(buf, p, H2_SETTINGS_MAX_HEADER_LIST_SIZE, s.max_header_list_size);
    int len = p - H2_FRAME_HEADER_LEN;
    return h2_frame_finish(buf, H2_SETTINGS, 0, 0, len);
}

// Build an empty SETTINGS frame with the ACK flag (acknowledges the peer's
// SETTINGS). Returns 9.
int h2_write_settings_ack(*uint8 buf) {
    return h2_frame_finish(buf, H2_SETTINGS, H2_FLAG_ACK, 0, 0);
}

// Apply a received SETTINGS payload (`len` bytes, must be a multiple of 6) to
// `s`, updating only the parameters present. Returns 0 on success, -1 if the
// payload length is not a multiple of 6 (a FRAME_SIZE_ERROR).
int h2_apply_settings(H2Settings* s, *uint8 payload, int len) {
    if (len % 6 != 0) { return -1; }
    int i = 0;
    while (i < len) {
        int   id = ((int)payload[i] << 8) | (int)payload[i + 1];
        int64 v  = h2_get_u32(payload, i + 2);
        if (id == H2_SETTINGS_HEADER_TABLE_SIZE)      { s.header_table_size = v; }
        else if (id == H2_SETTINGS_ENABLE_PUSH)        { s.enable_push = (int)v; }
        else if (id == H2_SETTINGS_MAX_CONCURRENT_STREAMS) { s.max_concurrent_streams = v; }
        else if (id == H2_SETTINGS_INITIAL_WINDOW_SIZE) { s.initial_window_size = v; }
        else if (id == H2_SETTINGS_MAX_FRAME_SIZE)     { s.max_frame_size = v; }
        else if (id == H2_SETTINGS_MAX_HEADER_LIST_SIZE) { s.max_header_list_size = v; }
        // Unknown settings are ignored (§6.5).
        i = i + 6;
    }
    return 0;
}

// Build a PING frame carrying the 8-byte opaque value at `opaque`. `ack` marks
// it a PONG (response to a received PING). Returns 17 (9 + 8).
int h2_write_ping(*uint8 buf, *uint8 opaque, int ack) {
    int i = 0;
    while (i < 8) { buf[H2_FRAME_HEADER_LEN + i] = opaque[i]; i = i + 1; }
    int flags = 0; if (ack != 0) { flags = H2_FLAG_ACK; }
    return h2_frame_finish(buf, H2_PING, flags, 0, 8);
}

// Build a GOAWAY frame: last processed stream id, an error code, and optional
// debug data (`debug_len` bytes at `debug`, may be 0/null). Returns the size.
int h2_write_goaway(*uint8 buf, int last_stream_id, int error_code,
                    *uint8 debug, int debug_len) {
    int p = H2_FRAME_HEADER_LEN;
    h2_put_u32(buf, p, (int64)(last_stream_id & 2147483647));   // R bit kept 0
    h2_put_u32(buf, p + 4, (int64)error_code);
    int i = 0;
    while (i < debug_len) { buf[p + 8 + i] = debug[i]; i = i + 1; }
    return h2_frame_finish(buf, H2_GOAWAY, 0, 0, 8 + debug_len);
}

// Parse a GOAWAY payload (`len` >= 8) into last_stream_id + error_code (debug
// data, if any, is left in the buffer). Returns 0 on success, -1 if too short.
int h2_read_goaway(*uint8 payload, int len, int* last_stream_id, int* error_code) {
    if (len < 8) { return -1; }
    *last_stream_id = (int)(h2_get_u32(payload, 0) & (int64)2147483647);
    *error_code     = (int)h2_get_u32(payload, 4);
    return 0;
}

// Connection state, shared by later stages (streams/flow control build on this).
struct H2Conn {
    int fd;                 // the (non-blocking) socket
    H2Settings local;       // settings we advertised
    H2Settings remote;      // peer's settings (defaults until their SETTINGS arrives)
    int last_stream_id;     // highest stream id seen (for GOAWAY)
    int goaway_sent;        // 1 once we've sent GOAWAY
    int send_window;        // connection-level flow-control window we may send into
    int recv_window;        // connection-level window the peer may send into
}

// Initialize a connection's state with default settings on both sides.
void h2_conn_init(H2Conn* c, int fd) {
    c.fd = fd;
    h2_settings_defaults(&c.local);
    h2_settings_defaults(&c.remote);
    c.last_stream_id = 0;
    c.goaway_sent = 0;
    c.send_window = 65535;
    c.recv_window = 65535;
}

// ── Stage 4: streams & flow control ──────────────────────────────────────────
//
// One HTTP/2 connection multiplexes many request/response *streams*, each with
// its own state machine (§5.1) and flow-control window (§6.9). A server stream
// goes idle → open (HEADERS) → half-closed-remote (the request's END_STREAM) →
// closed (the response's END_STREAM); RST_STREAM closes it abruptly. Flow
// control is credit-based: DATA spends both the stream and connection send
// windows, and WINDOW_UPDATE replenishes them.

// Stream states (§5.1). The RESERVED states are omitted — server push is not
// implemented (we advertise SETTINGS_ENABLE_PUSH = 0).
const int H2_STREAM_IDLE               = 0;
const int H2_STREAM_OPEN               = 1;
const int H2_STREAM_HALF_CLOSED_LOCAL  = 2;
const int H2_STREAM_HALF_CLOSED_REMOTE = 3;
const int H2_STREAM_CLOSED             = 4;

struct H2Stream {
    int id;
    int state;
    int send_window;    // bytes we may still send on this stream
    int recv_window;    // bytes the peer may still send us on this stream
}

void h2_stream_init(H2Stream* s, int id, int init_send, int init_recv) {
    s.id = id;
    s.state = H2_STREAM_IDLE;
    s.send_window = init_send;
    s.recv_window = init_recv;
}

// Advance the stream state on *receiving* a frame (server perspective).
void h2_stream_on_recv(H2Stream* s, int type, int flags) {
    if (type == H2_RST_STREAM) { s.state = H2_STREAM_CLOSED; return; }
    int end = (flags & H2_FLAG_END_STREAM) != 0;
    if (type == H2_HEADERS) {
        if (s.state == H2_STREAM_IDLE) {
            if (end != 0) { s.state = H2_STREAM_HALF_CLOSED_REMOTE; } else { s.state = H2_STREAM_OPEN; }
        } else if (end != 0 && s.state == H2_STREAM_OPEN) {
            s.state = H2_STREAM_HALF_CLOSED_REMOTE;
        }
        return;
    }
    if (type == H2_DATA && end != 0) {
        if (s.state == H2_STREAM_OPEN) { s.state = H2_STREAM_HALF_CLOSED_REMOTE; }
        else if (s.state == H2_STREAM_HALF_CLOSED_LOCAL) { s.state = H2_STREAM_CLOSED; }
    }
}

// Advance the stream state on *sending* a frame.
void h2_stream_on_send(H2Stream* s, int type, int flags) {
    if (type == H2_RST_STREAM) { s.state = H2_STREAM_CLOSED; return; }
    int end = (flags & H2_FLAG_END_STREAM) != 0;
    if (type == H2_HEADERS) {
        if (s.state == H2_STREAM_IDLE) {
            if (end != 0) { s.state = H2_STREAM_HALF_CLOSED_LOCAL; } else { s.state = H2_STREAM_OPEN; }
        } else if (end != 0 && s.state == H2_STREAM_OPEN) {
            s.state = H2_STREAM_HALF_CLOSED_LOCAL;
        } else if (end != 0 && s.state == H2_STREAM_HALF_CLOSED_REMOTE) {
            s.state = H2_STREAM_CLOSED;
        }
        return;
    }
    if (type == H2_DATA && end != 0) {
        if (s.state == H2_STREAM_OPEN) { s.state = H2_STREAM_HALF_CLOSED_LOCAL; }
        else if (s.state == H2_STREAM_HALF_CLOSED_REMOTE) { s.state = H2_STREAM_CLOSED; }
    }
}

// Flow control (§6.9). DATA spends both windows; WINDOW_UPDATE replenishes.
int  h2_can_send(H2Conn* c, H2Stream* s, int len) {
    return (s.send_window >= len) && (c.send_window >= len);
}
void h2_account_sent(H2Conn* c, H2Stream* s, int len) {
    s.send_window = s.send_window - len;
    c.send_window = c.send_window - len;
}
void h2_account_recv(H2Conn* c, H2Stream* s, int len) {
    s.recv_window = s.recv_window - len;
    c.recv_window = c.recv_window - len;
}
// Apply a received WINDOW_UPDATE: stream-level if `s` is non-null, else connection.
void h2_grant_window(H2Conn* c, H2Stream* s, int increment) {
    if (s != (H2Stream*)0) { s.send_window = s.send_window + increment; }
    else { c.send_window = c.send_window + increment; }
}

// ── Stream frame codecs ──────────────────────────────────────────────────────

// WINDOW_UPDATE (§6.9): a 31-bit increment. stream_id 0 = connection-level.
int h2_write_window_update(*uint8 buf, int stream_id, int increment) {
    h2_put_u32(buf, H2_FRAME_HEADER_LEN, (int64)(increment & 2147483647));
    return h2_frame_finish(buf, H2_WINDOW_UPDATE, 0, stream_id, 4);
}
int h2_read_window_update(*uint8 payload) {
    return (int)(h2_get_u32(payload, 0) & (int64)2147483647);
}

// RST_STREAM (§6.4): abruptly close a stream with an error code.
int h2_write_rst_stream(*uint8 buf, int stream_id, int error_code) {
    h2_put_u32(buf, H2_FRAME_HEADER_LEN, (int64)error_code);
    return h2_frame_finish(buf, H2_RST_STREAM, 0, stream_id, 4);
}

// HEADERS (§6.2): an (already HPACK-encoded) header block. No padding/priority.
int h2_write_headers(*uint8 buf, int stream_id, *uint8 block, int len,
                     int end_stream, int end_headers) {
    int i = 0;
    while (i < len) { buf[H2_FRAME_HEADER_LEN + i] = block[i]; i = i + 1; }
    int flags = 0;
    if (end_stream != 0)  { flags = flags | H2_FLAG_END_STREAM; }
    if (end_headers != 0) { flags = flags | H2_FLAG_END_HEADERS; }
    return h2_frame_finish(buf, H2_HEADERS, flags, stream_id, len);
}

// DATA (§6.1): a body chunk. No padding.
int h2_write_data(*uint8 buf, int stream_id, *uint8 data, int len, int end_stream) {
    int i = 0;
    while (i < len) { buf[H2_FRAME_HEADER_LEN + i] = data[i]; i = i + 1; }
    int flags = 0;
    if (end_stream != 0) { flags = H2_FLAG_END_STREAM; }
    return h2_frame_finish(buf, H2_DATA, flags, stream_id, len);
}

// ── Async connection I/O over <eventloop> ────────────────────────────────────
// Frames can arrive split across reads, so reads loop until the exact byte count
// is satisfied. These are the await-able building blocks the server loop uses.

// Read exactly `n` bytes into `buf`, awaiting readability as needed. Returns the
// number actually read; a result < n means the peer closed (EOF) or errored.
async int h2_read_full_async(EventLoop* lp, int fd, *uint8 buf, int n) {
    int got = 0;
    while (got < n) {
        int r = await net_read_async(lp, fd, buf + got, (int64)(n - got));
        if (r <= 0) { return got; }
        got = got + r;
    }
    return got;
}

// Read one whole frame: the 9-byte header (parsed into `hdr`) followed by its
// payload into `buf` (capacity `bufcap`). Returns the payload length, or
// -1 on EOF/short read, -2 if the payload exceeds the buffer.
async int h2_read_frame_async(EventLoop* lp, int fd, *uint8 buf, int bufcap, H2Frame* hdr) {
    int h = await h2_read_full_async(lp, fd, buf, H2_FRAME_HEADER_LEN);
    if (h < H2_FRAME_HEADER_LEN) { return -1; }
    h2_read_header(buf, hdr);
    if (hdr.length > bufcap - H2_FRAME_HEADER_LEN) { return -2; }
    if (hdr.length > 0) {
        int p = await h2_read_full_async(lp, fd, buf + H2_FRAME_HEADER_LEN, hdr.length);
        if (p < hdr.length) { return -1; }
    }
    return hdr.length;
}

// Read a complete header block — a HEADERS frame plus any CONTINUATION frames
// up to END_HEADERS (§6.10) — into `buf`, with the payloads concatenated. On
// return `hdr` is the HEADERS frame header and `*stream_id` its stream; the
// assembled block is `*blen` bytes at `buf + H2_FRAME_HEADER_LEN`. Returns 0 on
// success, negative on EOF / a non-HEADERS or non-CONTINUATION frame / overflow.
async int h2_read_header_block_async(EventLoop* lp, int fd, *uint8 buf, int bufcap,
                                     H2Frame* hdr, int* stream_id, int* blen) {
    int plen = await h2_read_frame_async(lp, fd, buf, bufcap, hdr);
    if (plen < 0 || hdr.type != H2_HEADERS) { return -1; }
    *stream_id = hdr.stream_id;
    int total = plen;
    int flags = hdr.flags;
    // Append each CONTINUATION's payload right after the block so far. We read a
    // 9-byte header into the slot just past the block, then overwrite it with the
    // payload — leaving the assembled block contiguous from buf+9.
    while ((flags & H2_FLAG_END_HEADERS) == 0) {
        int hpos = H2_FRAME_HEADER_LEN + total;
        if (hpos + H2_FRAME_HEADER_LEN > bufcap) { return -2; }
        int h = await h2_read_full_async(lp, fd, buf + hpos, H2_FRAME_HEADER_LEN);
        if (h < H2_FRAME_HEADER_LEN) { return -1; }
        let cf: H2Frame;  h2_read_header(buf + hpos, &cf);
        if (cf.type != H2_CONTINUATION) { return -1; }
        if (hpos + cf.length > bufcap) { return -2; }
        int p = await h2_read_full_async(lp, fd, buf + hpos, cf.length);   // overwrite the header
        if (p < cf.length) { return -1; }
        total = total + cf.length;
        flags = cf.flags;
    }
    *blen = total;
    return 0;
}

// True if the 24 bytes at `buf` are the HTTP/2 client connection preface.
int h2_is_preface(*uint8 buf) {
    string p = h2_preface();
    return memcmp((*void)buf, (*void)p, 24) == 0;
}

// Server-side opening handshake on an accepted connection `c` (already
// `h2_conn_init`'d): read and validate the 24-byte client preface, read the
// client's SETTINGS and apply it to `c.remote`, then send our SETTINGS followed
// by an ACK of theirs. Returns 0 on success, negative on a protocol error.
async int h2_server_handshake_async(EventLoop* lp, H2Conn* c) {
    *uint8 pf = alloc<uint8>(24);
    int pn = await h2_read_full_async(lp, c.fd, pf, 24);
    int good = 0; if (pn == 24) { good = h2_is_preface(pf); }
    free((*void)pf);
    if (good == 0) { return -1; }

    *uint8 fb = alloc<uint8>(4096);
    let hdr: H2Frame;
    int plen = await h2_read_frame_async(lp, c.fd, fb, 4096, &hdr);
    if (plen < 0 || hdr.type != H2_SETTINGS) { free((*void)fb); return -2; }
    h2_apply_settings(&c.remote, fb + H2_FRAME_HEADER_LEN, hdr.length);

    int sn = h2_write_settings(fb, &c.local);          // advertise ours
    net_send(c.fd, (*void)fb, (int64)sn);
    int an = h2_write_settings_ack(fb);                // ACK theirs
    net_send(c.fd, (*void)fb, (int64)an);
    free((*void)fb);
    return 0;
}

// Reply to a received PING (echo its 8-byte payload with the ACK flag set).
void h2_send_pong(int fd, *uint8 ping_payload) {
    *uint8 b = alloc<uint8>(17);
    int n = h2_write_ping(b, ping_payload, 1);
    net_send(fd, (*void)b, (int64)n);
    free((*void)b);
}

// Send a GOAWAY naming the last stream we processed, then mark the connection.
void h2_send_goaway(H2Conn* c, int error_code) {
    *uint8 b = alloc<uint8>(32);
    int n = h2_write_goaway(b, c.last_stream_id, error_code, (*uint8)0, 0);
    net_send(c.fd, (*void)b, (int64)n);
    free((*void)b);
    c.goaway_sent = 1;
}
